namespace Auto.DIR

open Real Set

/-- $L_\beta$. -/
noncomputable def L (β x : ℝ) : ℝ := x * (log₂ x⁻¹) ^ β

/-- $Q_\beta$. -/
noncomputable def Q (β x : ℝ) : ℝ :=
  2 / 3 * x * (1 - x) * (2 ^ (β + 2) - 3 + 4 * (3 - 2 ^ (β + 1)) * x)

/-- $b_\beta$ ([DIR], (2.3)). -/
noncomputable def b (β x : ℝ) : ℝ :=
  if x ≤ 4⁻¹ then L β x else if x ≤ 2⁻¹ then Q β x else J x

end Auto.DIR

namespace Auto.DIR

open Real Set MeasureTheory Filter Topology

/-- $\varphi$. -/
noncomputable def φ (t : ℝ) : ℝ := (2 * π) ^ (-(2⁻¹ : ℝ)) * exp (-t ^ 2 / 2)

/-- $\Phi$. -/
noncomputable def Φ (t : ℝ) : ℝ := ∫ s in Iic t, φ s

/-- $I$. -/
noncomputable def I (x : ℝ) : ℝ := if 0 < x ∧ x < 1 then φ (Function.invFun Φ x) else 0

