import Isoperim.DIR.«4_Computer_Assisted_Proofs».«4_3_Source_Code_aux»

/-!
# A verified interval checker for closed real expressions

This file was automatically generated by Claude.

A small verified interval evaluator ("M2") for the numerical side conditions of the
computer-assisted proofs of [DIR]. A closed real expression is written as a term `e : Ex`; its
real meaning is `denote e : ℝ`. The evaluator `eval P e : Option (ℚ × ℚ)` computes, by exact
rational arithmetic with outward rounding to the denominator $2^{d}$ (`P.prec = d`), an enclosure
of `denote e`, or fails (`none`). It is written with structural recursion only, so that it can
be run by the kernel: an inequality `c < denote e` is proved by

`check_sound P hw e c (by decide +kernel)`,

i.e. by one kernel evaluation of the Boolean `check P e c` and the soundness theorem
`eval_sound`. Here `hw : w₀ ∈ Icc (P.wl : ℝ) P.wu` is an enclosure of the constant $w_0$ of (3.4),
used by the nodes involving $J$.

Nodes:
* rational constants, `+`, `-`, `*`, `/`, negation, natural powers, `min`, `max`, `abs`, and a
  certified branch `ite_lt` (`if a < b then t else f`; a branch is taken only if the comparison
  is decided by the enclosures);
* `J x sl su` ($J(x)$, $x\in[\frac12,1]$ rational), `JwHalf w sl su` ($J_w(\frac12)$), with
  witnesses $s_l,s_u\ge0$ as in `J_ge_cert`/`J_le_cert`: the evaluator checks the conditions
  $\Phi(-\sqrt2 s_l)\le\min(t,1-t)$ and $\Phi(-\sqrt2 s_u)\ge\min(t_u,1-t_l)$ (with
  $t=(1-x)/w$) by series bounds and returns $[w_l T(s_l^2)/\overline{\sqrt\pi},\,
  w_u T(s_u^2)/\underline{\sqrt\pi}]$ (Taylor bounds $T$ of $e^{-s^2}$);
* `DJ x zl zu` ($\sqrt2\,\Phi^{-1}((1-x)/w_0)$, i.e. $J'(x)$): witnesses $z_l,z_u$ of any sign
  with $\Phi(\sqrt2z_l)\le(1-x)/w_u$ and $(1-x)/w_l\le\Phi(\sqrt2z_u)$, giving $[2z_l,2z_u]$;
* `Jx0` ($J(x_0)=w_0/\sqrt\pi$);
* `rpow e r` ($X^r$ for $X>0$, $r\in\mathbb Q$), by $X^r=\exp(r\log X)$, the series of
  $\log(1-x)$ (after range reduction by powers of $2$; $\log2$ from the same series) and of
  $\exp$ (with range reduction by squaring).
-/

namespace Auto.DIR.Checker

open Real Set Auto.DIR

/-! ### Exact rational helpers -/

/-- The Taylor polynomial $\sum_{k<N}(-v)^k/k!$ of $e^{-v}$, in `ℚ` (see `expNegTaylor`). -/
def eNq : ℕ → ℚ → ℚ
  | 0, _ => 0
  | k + 1, v => eNq k v + (-v) ^ k / k.factorial

/-- The series $\sum_{k<N}(-1)^ks^{2k+1}/(k!(2k+1))$, in `ℚ` (see `gaussIntTaylor`). -/
def gIq : ℕ → ℚ → ℚ
  | 0, _ => 0
  | k + 1, s => gIq k s + (-1) ^ k * s ^ (2 * k + 1) / (k.factorial * (2 * k + 1))

/-- The partial sum $\sum_{i<n}x^{i+1}/(i+1)$ of the series of $-\log(1-x)$. -/
def logSum (x : ℚ) : ℕ → ℚ
  | 0 => 0
  | n + 1 => logSum x n + x ^ (n + 1) / (n + 1)

/-- The partial sum $\sum_{m<n}z^m/m!$ of the series of $e^z$. -/
def expSum (z : ℚ) : ℕ → ℚ
  | 0 => 0
  | n + 1 => expSum z n + z ^ n / n.factorial

/-- Rounding down to the denominator $2^d$: $\lfloor q2^d\rfloor/2^d$. -/
def rdn (d : ℕ) (q : ℚ) : ℚ := (⌊q * 2 ^ d⌋ : ℚ) / 2 ^ d

/-- Rounding up to the denominator $2^d$: $\lceil q2^d\rceil/2^d$. -/
def rup (d : ℕ) (q : ℚ) : ℚ := (⌈q * 2 ^ d⌉ : ℚ) / 2 ^ d

/-- $q\cdot2^k$ for $k\in\mathbb Z$. -/
def mul2pow (q : ℚ) : ℤ → ℚ
  | .ofNat n => q * 2 ^ n
  | .negSucc n => q / 2 ^ (n + 1)

/-- Iterated squaring with rounding `f` after each step ($j$ steps). -/
def sqIter (f : ℚ → ℚ) : ℕ → ℚ → ℚ
  | 0, a => a
  | j + 1, a => sqIter f j (f (a * a))

/-- `eNq` is `expNegTaylor`. -/
theorem eNq_cast (N : ℕ) (v : ℚ) : ((eNq N v : ℚ) : ℝ) = expNegTaylor N v := by
  induction N with
  | zero => simp [eNq, expNegTaylor]
  | succ k ih =>
    rw [show expNegTaylor (k + 1) (v : ℝ) = expNegTaylor k v + (-(v : ℝ)) ^ k / k.factorial
      by simp [expNegTaylor, Finset.sum_range_succ], ← ih]
    simp [eNq]

/-- `gIq` is `gaussIntTaylor`. -/
theorem gIq_cast (N : ℕ) (s : ℚ) : ((gIq N s : ℚ) : ℝ) = gaussIntTaylor N s := by
  induction N with
  | zero => simp [gIq, gaussIntTaylor]
  | succ k ih =>
    rw [show gaussIntTaylor (k + 1) (s : ℝ) = gaussIntTaylor k s +
        (-1) ^ k * (s : ℝ) ^ (2 * k + 1) / ((k.factorial : ℝ) * (2 * k + 1))
      by simp [gaussIntTaylor, Finset.sum_range_succ], ← ih]
    simp [gIq]

/-- Cast of `logSum` to a `Finset` sum. -/
theorem logSum_cast (x : ℚ) (n : ℕ) :
    ((logSum x n : ℚ) : ℝ) = ∑ i ∈ Finset.range n, (x : ℝ) ^ (i + 1) / (i + 1) := by
  induction n with
  | zero => simp [logSum]
  | succ k ih => rw [Finset.sum_range_succ, ← ih]; simp [logSum]

/-- Cast of `expSum` to a `Finset` sum. -/
theorem expSum_cast (z : ℚ) (n : ℕ) :
    ((expSum z n : ℚ) : ℝ) = ∑ m ∈ Finset.range n, (z : ℝ) ^ m / m.factorial := by
  induction n with
  | zero => simp [expSum]
  | succ k ih => rw [Finset.sum_range_succ, ← ih]; simp [expSum]

/-- Rounding down does not increase. -/
theorem rdn_le (d : ℕ) (q : ℚ) : rdn d q ≤ q := by
  unfold rdn
  rw [div_le_iff₀ (by positivity)]
  exact Int.floor_le _

/-- Rounding up does not decrease. -/
theorem le_rup (d : ℕ) (q : ℚ) : q ≤ rup d q := by
  unfold rup
  rw [le_div_iff₀ (by positivity)]
  exact Int.le_ceil _

/-- Rounding down preserves nonnegativity. -/
theorem rdn_nonneg (d : ℕ) {q : ℚ} (hq : 0 ≤ q) : 0 ≤ rdn d q := by
  unfold rdn
  exact div_nonneg (Int.cast_nonneg_iff.2 (Int.floor_nonneg.2 (by positivity))) (by positivity)

/-- Real form of `rdn_le`. -/
theorem rdn_le_real (d : ℕ) {q : ℚ} {x : ℝ} (h : (q : ℝ) ≤ x) : (rdn d q : ℝ) ≤ x :=
  le_trans (by exact_mod_cast rdn_le d q) h

/-- Real form of `le_rup`. -/
theorem le_rup_real (d : ℕ) {q : ℚ} {x : ℝ} (h : x ≤ q) : x ≤ (rup d q : ℝ) :=
  h.trans (by exact_mod_cast le_rup d q)

/-- `mul2pow q k` is $q\cdot2^k$. -/
theorem mul2pow_cast (q : ℚ) (k : ℤ) : ((mul2pow q k : ℚ) : ℝ) = q * (2 : ℝ) ^ k := by
  cases k with
  | ofNat n => simp [mul2pow]
  | negSucc n => simp [mul2pow, zpow_negSucc, div_eq_mul_inv]

/-! ### Interval arithmetic -/

/-- $x\in[I_1,I_2]$ (real enclosure by a rational interval). -/
def Mem (I : ℚ × ℚ) (x : ℝ) : Prop := (I.1 : ℝ) ≤ x ∧ x ≤ I.2

/-- Outward rounding of an interval to the denominator $2^d$. -/
def ivRound (d : ℕ) (I : ℚ × ℚ) : ℚ × ℚ := (rdn d I.1, rup d I.2)

/-- Interval sum. -/
def ivAdd (I J : ℚ × ℚ) : ℚ × ℚ := (I.1 + J.1, I.2 + J.2)

/-- Interval negation. -/
def ivNeg (I : ℚ × ℚ) : ℚ × ℚ := (-I.2, -I.1)

/-- Interval difference. -/
def ivSub (I J : ℚ × ℚ) : ℚ × ℚ := (I.1 - J.2, I.2 - J.1)

/-- Interval product (minimum and maximum of the four corner products). -/
def ivMul (I J : ℚ × ℚ) : ℚ × ℚ :=
  (min (min (I.1 * J.1) (I.1 * J.2)) (min (I.2 * J.1) (I.2 * J.2)),
    max (max (I.1 * J.1) (I.1 * J.2)) (max (I.2 * J.1) (I.2 * J.2)))

/-- Interval minimum. -/
def ivMin (I J : ℚ × ℚ) : ℚ × ℚ := (min I.1 J.1, min I.2 J.2)

/-- Interval maximum. -/
def ivMax (I J : ℚ × ℚ) : ℚ × ℚ := (max I.1 J.1, max I.2 J.2)

/-- Interval absolute value. -/
def ivAbs (I : ℚ × ℚ) : ℚ × ℚ :=
  if 0 ≤ I.1 then I else if I.2 ≤ 0 then (-I.2, -I.1) else (0, max (-I.1) I.2)

/-- Interval natural power by repeated multiplication. -/
def ivPowMul (I : ℚ × ℚ) : ℕ → ℚ × ℚ
  | 0 => (1, 1)
  | n + 1 => ivMul (ivPowMul I n) I

/-- Interval natural power (exact for nonnegative intervals). -/
def ivPow (I : ℚ × ℚ) (n : ℕ) : ℚ × ℚ :=
  if 0 ≤ I.1 then (I.1 ^ n, I.2 ^ n) else ivPowMul I n

/-- Soundness of outward rounding. -/
theorem mem_ivRound (d : ℕ) {I : ℚ × ℚ} {x : ℝ} (h : Mem I x) : Mem (ivRound d I) x :=
  ⟨rdn_le_real d h.1, le_rup_real d h.2⟩

/-- Soundness of the interval sum. -/
theorem mem_ivAdd {I J : ℚ × ℚ} {x y : ℝ} (hx : Mem I x) (hy : Mem J y) :
    Mem (ivAdd I J) (x + y) := by
  simp only [Mem, ivAdd, Rat.cast_add] at *
  constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

/-- Soundness of the interval negation. -/
theorem mem_ivNeg {I : ℚ × ℚ} {x : ℝ} (hx : Mem I x) : Mem (ivNeg I) (-x) := by
  simp only [Mem, ivNeg, Rat.cast_neg] at *
  constructor <;> linarith [hx.1, hx.2]

/-- Soundness of the interval difference. -/
theorem mem_ivSub {I J : ℚ × ℚ} {x y : ℝ} (hx : Mem I x) (hy : Mem J y) :
    Mem (ivSub I J) (x - y) := by
  simp only [Mem, ivSub, Rat.cast_sub] at *
  constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

/-- Corner bounds for a product of two real intervals. -/
theorem mul_mem_corners {a1 a2 b1 b2 x y : ℝ} (hx : a1 ≤ x ∧ x ≤ a2) (hy : b1 ≤ y ∧ y ≤ b2) :
    min (min (a1 * b1) (a1 * b2)) (min (a2 * b1) (a2 * b2)) ≤ x * y ∧
      x * y ≤ max (max (a1 * b1) (a1 * b2)) (max (a2 * b1) (a2 * b2)) := by
  obtain ⟨hx1, hx2⟩ := hx
  obtain ⟨hy1, hy2⟩ := hy
  have hl : ∀ a : ℝ, min (a * b1) (a * b2) ≤ a * y := fun a ↦ by
    rcases le_total 0 a with h | h
    · exact min_le_of_left_le (mul_le_mul_of_nonneg_left hy1 h)
    · exact min_le_of_right_le (mul_le_mul_of_nonpos_left hy2 h)
  have hu : ∀ a : ℝ, a * y ≤ max (a * b1) (a * b2) := fun a ↦ by
    rcases le_total 0 a with h | h
    · exact le_max_of_le_right (mul_le_mul_of_nonneg_left hy2 h)
    · exact le_max_of_le_left (mul_le_mul_of_nonpos_left hy1 h)
  have hl' : min (a1 * y) (a2 * y) ≤ x * y := by
    rcases le_total 0 y with h | h
    · exact min_le_of_left_le (mul_le_mul_of_nonneg_right hx1 h)
    · exact min_le_of_right_le (mul_le_mul_of_nonpos_right hx2 h)
  have hu' : x * y ≤ max (a1 * y) (a2 * y) := by
    rcases le_total 0 y with h | h
    · exact le_max_of_le_right (mul_le_mul_of_nonneg_right hx2 h)
    · exact le_max_of_le_left (mul_le_mul_of_nonpos_right hx1 h)
  exact ⟨(min_le_min (hl a1) (hl a2)).trans hl', hu'.trans (max_le_max (hu a1) (hu a2))⟩

/-- Soundness of the interval product. -/
theorem mem_ivMul {I J : ℚ × ℚ} {x y : ℝ} (hx : Mem I x) (hy : Mem J y) :
    Mem (ivMul I J) (x * y) := by
  simp only [Mem, ivMul, Rat.cast_min, Rat.cast_max, Rat.cast_mul] at *
  exact mul_mem_corners hx hy

/-- Soundness of the interval minimum. -/
theorem mem_ivMin {I J : ℚ × ℚ} {x y : ℝ} (hx : Mem I x) (hy : Mem J y) :
    Mem (ivMin I J) (min x y) := by
  simp only [Mem, ivMin, Rat.cast_min] at *
  exact ⟨min_le_min hx.1 hy.1, min_le_min hx.2 hy.2⟩

/-- Soundness of the interval maximum. -/
theorem mem_ivMax {I J : ℚ × ℚ} {x y : ℝ} (hx : Mem I x) (hy : Mem J y) :
    Mem (ivMax I J) (max x y) := by
  simp only [Mem, ivMax, Rat.cast_max] at *
  exact ⟨max_le_max hx.1 hy.1, max_le_max hx.2 hy.2⟩

/-- Soundness of the interval absolute value. -/
theorem mem_ivAbs {I : ℚ × ℚ} {x : ℝ} (hx : Mem I x) : Mem (ivAbs I) |x| := by
  obtain ⟨h1, h2⟩ := hx
  unfold ivAbs
  split_ifs with ha hb
  · have : (0 : ℝ) ≤ I.1 := by exact_mod_cast ha
    exact ⟨by rw [abs_of_nonneg (by linarith)]; exact h1,
      by rw [abs_of_nonneg (by linarith)]; exact h2⟩
  · have : (I.2 : ℝ) ≤ 0 := by exact_mod_cast hb
    simp only [Mem, Rat.cast_neg]
    rw [abs_of_nonpos (by linarith)]
    exact ⟨by linarith, by linarith⟩
  · simp only [Mem, Rat.cast_zero, Rat.cast_max, Rat.cast_neg]
    refine ⟨abs_nonneg x, ?_⟩
    rcases abs_cases x with ⟨h, -⟩ | ⟨h, -⟩ <;> rw [h]
    · exact le_max_of_le_right h2
    · exact le_max_of_le_left (by linarith)

/-- Soundness of the interval power by repeated multiplication. -/
theorem mem_ivPowMul {I : ℚ × ℚ} {x : ℝ} (hx : Mem I x) (n : ℕ) : Mem (ivPowMul I n) (x ^ n) := by
  induction n with
  | zero => simp [ivPowMul, Mem]
  | succ n ih => rw [pow_succ]; exact mem_ivMul ih hx

/-- Soundness of the interval power. -/
theorem mem_ivPow {I : ℚ × ℚ} {x : ℝ} (hx : Mem I x) (n : ℕ) : Mem (ivPow I n) (x ^ n) := by
  unfold ivPow
  split_ifs with h
  · have h0 : (0 : ℝ) ≤ I.1 := by exact_mod_cast h
    simp only [Mem, Rat.cast_pow]
    exact ⟨pow_le_pow_left₀ h0 hx.1 n, pow_le_pow_left₀ (h0.trans hx.1) hx.2 n⟩
  · exact mem_ivPowMul hx n

/-- Interval inverse, defined if the interval does not contain $0$. -/
def ivInv (I : ℚ × ℚ) : Option (ℚ × ℚ) :=
  if 0 < I.1 ∨ I.2 < 0 then some (I.2⁻¹, I.1⁻¹) else none

/-- Soundness of the interval inverse. -/
theorem mem_ivInv {I J : ℚ × ℚ} {x : ℝ} (hx : Mem I x) (h : ivInv I = some J) :
    Mem J x⁻¹ := by
  unfold ivInv at h
  split_ifs at h with hc
  cases h
  obtain ⟨h1, h2⟩ := hx
  simp only [Mem, Rat.cast_inv]
  rcases hc with hc | hc
  · have : (0 : ℝ) < I.1 := by exact_mod_cast hc
    exact ⟨inv_anti₀ (by linarith) h2, inv_anti₀ this h1⟩
  · have : (I.2 : ℝ) < 0 := by exact_mod_cast hc
    have hx0 : x < 0 := by linarith
    exact ⟨(inv_le_inv_of_neg this hx0).2 h2,
      (inv_le_inv_of_neg hx0 (by linarith : (I.1 : ℝ) < 0)).2 h1⟩

/-! ### Parameters and the Gaussian functions -/

/-- Parameters of the evaluator: an enclosure $[w_l,w_u]\ni w_0$, the degrees of the series
(`gaussIntTaylor` of degree $2m_I+1$, $2m_I+2$; `expNegTaylor` of degree $2m_E+1$, $2m_E+2$;
`nLog` terms of the series of $\log(1-x)$, $|x|\le\frac13$; `nExp` terms of the series of
$e^z$, $|z|\le1$) and the rounding precision $2^{-\mathrm{prec}}$. -/
structure Params where
  /-- Lower end of the enclosure of $w_0$. -/
  wl : ℚ
  /-- Upper end of the enclosure of $w_0$. -/
  wu : ℚ
  /-- Degree parameter for `gaussIntTaylor`. -/
  mI : ℕ := 20
  /-- Degree parameter for `expNegTaylor`. -/
  mE : ℕ := 20
  /-- Number of terms of the series of $\log(1-x)$. -/
  nLog : ℕ := 40
  /-- Number of terms of the series of $e^z$. -/
  nExp : ℕ := 24
  /-- Rounding precision: results are rounded outward to the denominator $2^{\mathrm{prec}}$. -/
  prec : ℕ := 64

/-- A rational lower bound for $\sqrt\pi=1.77245385090551602729\ldots$. -/
def sqrtPiLo : ℚ := 1.772453850905516027

/-- A rational upper bound for $\sqrt\pi$. -/
def sqrtPiHi : ℚ := 1.772453850905516028

/-- $0<\underline{\sqrt\pi}$. -/
theorem sqrtPiLo_pos : (0 : ℝ) < sqrtPiLo := by norm_num [sqrtPiLo]

/-- $\underline{\sqrt\pi}<\sqrt\pi$ (from `Real.pi_gt_d20`). -/
theorem sqrtPiLo_lt : (sqrtPiLo : ℝ) < √π := by
  rw [show ((sqrtPiLo : ℚ) : ℝ) = 1.772453850905516027 by norm_num [sqrtPiLo],
    Real.lt_sqrt (by norm_num)]
  norm_num
  linarith [pi_gt_d20]

/-- $\sqrt\pi<\overline{\sqrt\pi}$ (from `Real.pi_lt_d20`). -/
theorem sqrt_pi_lt_hi : √π < sqrtPiHi := by
  rw [show ((sqrtPiHi : ℚ) : ℝ) = 1.772453850905516028 by norm_num [sqrtPiHi],
    Real.sqrt_lt' (by norm_num)]
  norm_num
  linarith [pi_lt_d20]

/-- Upper bound for $\Phi(-\sqrt2s)$, $s\ge0$: $\frac12-S_{2m+2}(s)/\overline{\sqrt\pi}$. -/
def phiNegHi (P : Params) (s : ℚ) : ℚ := 2⁻¹ - gIq (2 * P.mI + 2) s / sqrtPiHi

/-- Lower bound for $\Phi(-\sqrt2s)$, $s\ge0$: $\frac12-S_{2m+1}(s)/\underline{\sqrt\pi}$. -/
def phiNegLo (P : Params) (s : ℚ) : ℚ := 2⁻¹ - gIq (2 * P.mI + 1) s / sqrtPiLo

/-- $\Phi(-\sqrt2s)\le$ `phiNegHi P s` for $s\ge0$. -/
theorem gCDF_le_phiNegHi (P : Params) {s : ℚ} (hs : 0 ≤ s) :
    gCDF (-(√2 * s)) ≤ phiNegHi P s := by
  have hs' : (0 : ℝ) ≤ s := by exact_mod_cast hs
  have := gCDF_neg_sqrt_two_mul_le hs' (gaussIntTaylor_le_integral P.mI hs') sqrt_pi_lt_hi.le
  simpa [phiNegHi, gIq_cast] using this

/-- `phiNegLo P s` $\le\Phi(-\sqrt2s)$ for $s\ge0$. -/
theorem phiNegLo_le_gCDF (P : Params) {s : ℚ} (hs : 0 ≤ s) :
    (phiNegLo P s : ℝ) ≤ gCDF (-(√2 * s)) := by
  have hs' : (0 : ℝ) ≤ s := by exact_mod_cast hs
  have := le_gCDF_neg_sqrt_two_mul hs' (integral_le_gaussIntTaylor P.mI hs') sqrtPiLo_pos
    sqrtPiLo_lt.le
  simpa [phiNegLo, gIq_cast] using this

/-- Lower bound for $\Phi(\sqrt2\sigma)$, $\sigma\in\mathbb Q$. -/
def phiLo (P : Params) (σ : ℚ) : ℚ := if σ < 0 then phiNegLo P (-σ) else 1 - phiNegHi P σ

/-- Upper bound for $\Phi(\sqrt2\sigma)$, $\sigma\in\mathbb Q$. -/
def phiHi (P : Params) (σ : ℚ) : ℚ := if σ < 0 then phiNegHi P (-σ) else 1 - phiNegLo P σ

/-- `phiLo P σ` $\le\Phi(\sqrt2\sigma)$. -/
theorem phiLo_le_gCDF (P : Params) (σ : ℚ) : (phiLo P σ : ℝ) ≤ gCDF (√2 * σ) := by
  unfold phiLo
  split_ifs with h
  · have := phiNegLo_le_gCDF P (s := -σ) (by linarith)
    simpa using this
  · have := gCDF_le_phiNegHi P (s := σ) (by linarith)
    rw [gCDF_neg] at this
    push_cast
    linarith

/-- $\Phi(\sqrt2\sigma)\le$ `phiHi P σ`. -/
theorem gCDF_le_phiHi (P : Params) (σ : ℚ) : gCDF (√2 * σ) ≤ phiHi P σ := by
  unfold phiHi
  split_ifs with h
  · have := gCDF_le_phiNegHi P (s := -σ) (by linarith)
    simpa using this
  · have := phiNegLo_le_gCDF P (s := σ) (by linarith)
    rw [gCDF_neg] at this
    push_cast
    linarith

/-- Enclosure of $J_w(x)$ for $w\in[w_l,w_u]$ from witnesses $s_l,s_u\ge0$ (see
`gJw_ge_of_gCDF_le`, `gJw_le_of_le_gCDF`). -/
def gJwIv (P : Params) (wl wu x sl su : ℚ) : Option (ℚ × ℚ) :=
  if 0 < wl ∧ 0 ≤ sl ∧ 0 ≤ su ∧ phiNegHi P sl ≤ (1 - x) / wu ∧
      phiNegHi P sl ≤ 1 - (1 - x) / wl ∧
      ((1 - x) / wl ≤ phiNegLo P su ∨ 1 - (1 - x) / wu ≤ phiNegLo P su) then
    some (rdn P.prec (wl * eNq (2 * P.mE + 2) (sl ^ 2) / sqrtPiHi),
      rup P.prec (wu * eNq (2 * P.mE + 1) (su ^ 2) / sqrtPiLo))
  else none

/-- Soundness of `gJwIv`. -/
theorem gJwIv_sound (P : Params) {wl wu x sl su : ℚ} {I : ℚ × ℚ}
    (h : gJwIv P wl wu x sl su = some I) {w : ℝ} (hw : w ∈ Icc (wl : ℝ) wu) :
    Mem I (gJw w x) := by
  unfold gJwIv at h
  split_ifs at h with hc
  cases h
  obtain ⟨hwl, hsl, hsu, h1, h2, h3⟩ := hc
  have hwl' : (0 : ℝ) < wl := by exact_mod_cast hwl
  have hsl' : (0 : ℝ) ≤ sl := by exact_mod_cast hsl
  have hsu' : (0 : ℝ) ≤ su := by exact_mod_cast hsu
  have hx : (x : ℝ) ∈ Icc (x : ℝ) x := ⟨le_rfl, le_rfl⟩
  refine ⟨rdn_le_real _ ?_, le_rup_real _ ?_⟩
  · have h1' : ((phiNegHi P sl : ℚ) : ℝ) ≤ (1 - x) / wu := by exact_mod_cast h1
    have h2' : ((phiNegHi P sl : ℚ) : ℝ) ≤ 1 - (1 - x) / wl := by exact_mod_cast h2
    have hΦ := gCDF_le_phiNegHi P hsl
    refine le_trans ?_ (gJw_ge_of_gCDF_le hwl' hsl' (hΦ.trans h1') (hΦ.trans h2') hw hx)
    push_cast
    rw [eNq_cast, mul_div_assoc, mul_div_assoc]
    push_cast
    exact mul_le_mul_of_nonneg_left (div_le_div_of_le_of_le
      (expNegTaylor_le_exp_neg _ (sq_nonneg _)) (exp_pos _).le (sqrt_pos.2 pi_pos)
      sqrt_pi_lt_hi.le) hwl'.le
  · have hΦ := phiNegLo_le_gCDF P hsu
    have h3' : ((1 - x) / wl : ℝ) ≤ ((phiNegLo P su : ℚ) : ℝ) ∨
        1 - (1 - x) / wu ≤ ((phiNegLo P su : ℚ) : ℝ) := by
      rcases h3 with h3 | h3
      · left; exact_mod_cast h3
      · right; exact_mod_cast h3
    refine (gJw_le_of_le_gCDF hwl' hsu' (h3'.imp (·.trans hΦ) (·.trans hΦ)) hw hx).trans ?_
    have hwu : (0 : ℝ) ≤ wu := hwl'.le.trans (hw.1.trans hw.2)
    have hE := exp_neg_le_expNegTaylor P.mE (sq_nonneg (su : ℝ))
    push_cast
    rw [eNq_cast, mul_div_assoc, mul_div_assoc]
    push_cast
    exact mul_le_mul_of_nonneg_left (div_le_div_of_le_of_le hE ((exp_pos _).le.trans hE)
      sqrtPiLo_pos sqrtPiLo_lt.le) hwu

/-- $J(x_0)=w_0/\sqrt\pi$. -/
theorem J_x₀_eq : J x₀ = w₀ / √π := by
  obtain ⟨h1, h2⟩ := w₀_mem_fine
  have hw0 : 0 < w₀ := by linarith
  rw [J_eq_gJw ⟨by rw [x₀]; linarith, by rw [x₀]; linarith⟩, gJw, x₀,
    show w₀⁻¹ * (1 - (1 - w₀ / 2)) = 2⁻¹ by field_simp; ring, gProf_half, gConst_eq,
    sqrt_two_mul_pi]
  have : (0 : ℝ) < √2 := by positivity
  have : (0 : ℝ) < √π := sqrt_pos.2 pi_pos
  field_simp

/-- The real meaning of the node `DJ`: $J'(x)=\sqrt2\,\Phi^{-1}((1-x)/w_0)$ on $(\frac12,1)$. -/
theorem hasDerivAt_J {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) :
    HasDerivAt J (√2 * gInv ((1 - x) / w₀)) x := by
  obtain ⟨h1, h2⟩ := w₀_mem_fine
  have hw0 : 0 < w₀ := by linarith
  have h := hasDerivAt_gJw hw0 (x := x) ⟨by linarith [hx.1], hx.2⟩
  rw [← div_eq_inv_mul] at h
  refine h.congr_of_eventuallyEq ?_
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy
  exact J_eq_gJw ⟨hy.1.le, hy.2.le⟩

/-! ### Logarithm and exponential -/

/-- $\log(1-x)\in[-S_n(x)-R,-S_n(x)+R]$ with $S_n(x)=\sum_{i<n}x^{i+1}/(i+1)$,
$R=|x|^{n+1}/(1-|x|)$, for rational $|x|<1$. -/
theorem log_one_sub_mem (x : ℚ) (n : ℕ) (hx : |x| < 1) :
    Mem (-logSum x n - |x| ^ (n + 1) / (1 - |x|), -logSum x n + |x| ^ (n + 1) / (1 - |x|))
      (log (1 - x)) := by
  have hx' : abs (x : ℝ) < 1 := by exact_mod_cast hx
  have h := abs_le.1 (abs_log_sub_add_sum_range_le hx' n)
  rw [← logSum_cast] at h
  simp only [Mem]
  push_cast
  constructor <;> linarith [h.1, h.2]

/-- A rational lower bound for $\log2$ ($\lfloor2^{64}\log2\rfloor/2^{64}$). -/
def ln2Lo : ℚ := 12786308645202655659 / 18446744073709551616

/-- A rational upper bound for $\log2$ ($\lceil2^{64}\log2\rceil/2^{64}$). -/
def ln2Hi : ℚ := 12786308645202655660 / 18446744073709551616

/-- The rational inequalities certifying `ln2Lo`, `ln2Hi` (series of $\log(1-\frac12)$ with $70$
terms). -/
theorem ln2_check :
    ln2Lo ≤ logSum 2⁻¹ 70 - abs (2⁻¹ : ℚ) ^ 71 / (1 - abs (2⁻¹ : ℚ)) ∧
      logSum 2⁻¹ 70 + abs (2⁻¹ : ℚ) ^ 71 / (1 - abs (2⁻¹ : ℚ)) ≤ ln2Hi := by
  decide +kernel

/-- $\log2\in[$`ln2Lo`$,$`ln2Hi`$]$. -/
theorem ln2_mem : Mem (ln2Lo, ln2Hi) (log 2) := by
  have h := log_one_sub_mem 2⁻¹ 70 (by norm_num)
  have hl : log (1 - ((2⁻¹ : ℚ) : ℝ)) = -log 2 := by
    rw [show 1 - ((2⁻¹ : ℚ) : ℝ) = 2⁻¹ by norm_num, Real.log_inv]
  rw [hl] at h
  obtain ⟨c1, c2⟩ := ln2_check
  have c1' :
      (ln2Lo : ℝ) ≤ ((logSum 2⁻¹ 70 - abs (2⁻¹ : ℚ) ^ 71 / (1 - abs (2⁻¹ : ℚ)) : ℚ) : ℝ) := by
    exact_mod_cast c1
  have c2' : ((logSum 2⁻¹ 70 + abs (2⁻¹ : ℚ) ^ 71 / (1 - abs (2⁻¹ : ℚ)) : ℚ) : ℝ) ≤ ln2Hi := by
    exact_mod_cast c2
  simp only [Mem] at h ⊢
  push_cast at h c1' c2' ⊢
  constructor <;> linarith [h.1, h.2]

/-- A binary exponent $k$ with $q/2^k$ close to $1$ (in $[\frac23,\frac43]$ for $q>0$). -/
def logK (q : ℚ) : ℤ :=
  let k : ℤ := (Nat.log2 q.num.natAbs : ℤ) - Nat.log2 q.den
  let m := mul2pow q (-k)
  if 4 / 3 < m then k + 1 else if m < 2 / 3 then k - 1 else k

/-- The reduced argument $x=1-q2^{-k}$, $k=$ `logK q`, so that $\log q=\log(1-x)+k\log2$. -/
def logX (q : ℚ) : ℚ := 1 - mul2pow q (-logK q)

/-- The remainder bound $|x|^{n+1}/(1-|x|)$ of the series of $\log(1-x)$. -/
def logR (x : ℚ) (n : ℕ) : ℚ := abs x ^ (n + 1) / (1 - abs x)

/-- Enclosure of $\log q$, $q>0$ rational: $\log q=\log m+k\log2$ with $m=q2^{-k}$. -/
def logIv (P : Params) (q : ℚ) : Option (ℚ × ℚ) :=
  if 0 < q ∧ abs (logX q) < 1 then
    some (rdn P.prec (-logSum (logX q) P.nLog - logR (logX q) P.nLog +
        (if 0 ≤ logK q then (logK q : ℚ) * ln2Lo else (logK q : ℚ) * ln2Hi)),
      rup P.prec (-logSum (logX q) P.nLog + logR (logX q) P.nLog +
        (if 0 ≤ logK q then (logK q : ℚ) * ln2Hi else (logK q : ℚ) * ln2Lo)))
  else none

/-- Soundness of `logIv`. -/
theorem logIv_sound (P : Params) {q : ℚ} {I : ℚ × ℚ} (h : logIv P q = some I) :
    0 < q ∧ Mem I (log q) := by
  unfold logIv at h
  by_cases hc : 0 < q ∧ abs (logX q) < 1
  swap
  · rw [ite_eq_right hc] at h; cases h
  rw [ite_eq_left hc] at h
  cases h
  obtain ⟨hq, hx⟩ := hc
  unfold logX at hx ⊢
  unfold logR
  refine ⟨hq, ?_⟩
  set k := logK q
  set m := mul2pow q (-k) with hm
  have hq' : (0 : ℝ) < q := by exact_mod_cast hq
  have hmc : ((m : ℚ) : ℝ) = q * (2 : ℝ) ^ (-k) := mul2pow_cast q (-k)
  have hm0 : (0 : ℝ) < m := by rw [hmc]; positivity
  have hqm : (q : ℝ) = m * (2 : ℝ) ^ k := by
    rw [hmc, mul_assoc, ← zpow_add₀ two_ne_zero, neg_add_cancel, zpow_zero, mul_one]
  have hlog : log q = log (1 - ((1 - m : ℚ) : ℝ)) + k * log 2 := by
    rw [hqm, Real.log_mul hm0.ne' (by positivity), Real.log_zpow]
    push_cast; ring_nf
  have hL := log_one_sub_mem (1 - m) P.nLog hx
  have h2 := ln2_mem
  simp only [Mem] at hL h2
  have hk : ((if 0 ≤ k then (k : ℚ) * ln2Lo else (k : ℚ) * ln2Hi : ℚ) : ℝ) ≤ k * log 2 ∧
      k * log 2 ≤ ((if 0 ≤ k then (k : ℚ) * ln2Hi else (k : ℚ) * ln2Lo : ℚ) : ℝ) := by
    split_ifs with hk0
    · have : (0 : ℝ) ≤ k := by exact_mod_cast hk0
      push_cast
      exact ⟨mul_le_mul_of_nonneg_left h2.1 this, mul_le_mul_of_nonneg_left h2.2 this⟩
    · have : (k : ℝ) ≤ 0 := by exact_mod_cast (not_le.1 hk0).le
      push_cast
      exact ⟨mul_le_mul_of_nonpos_left h2.2 this, mul_le_mul_of_nonpos_left h2.1 this⟩
  refine ⟨rdn_le_real _ ?_, le_rup_real _ ?_⟩
  · rw [hlog]; push_cast at hL hk ⊢; linarith [hL.1, hk.1]
  · rw [hlog]; push_cast at hL hk ⊢; linarith [hL.2, hk.2]

/-- Squaring with downward rounding preserves lower bounds for $e^t$:
$0\le a\le e^t\Rightarrow\mathrm{sqIter}(a)\le e^{2^jt}$. -/
theorem sqIter_rdn_le (d j : ℕ) : ∀ (a : ℚ) (t : ℝ), 0 ≤ a → (a : ℝ) ≤ exp t →
    (sqIter (rdn d) j a : ℝ) ≤ exp (2 ^ j * t) := by
  induction j with
  | zero => intro a t _ h; simpa [sqIter] using h
  | succ j ih =>
    intro a t ha h
    have ha' : (0 : ℝ) ≤ a := by exact_mod_cast ha
    have h2 : ((rdn d (a * a) : ℚ) : ℝ) ≤ exp (2 * t) := by
      refine rdn_le_real d ?_
      rw [show 2 * t = t + t by ring, Real.exp_add]
      push_cast
      exact mul_le_mul h h ha' (exp_pos _).le
    have := ih (rdn d (a * a)) (2 * t) (rdn_nonneg d (mul_nonneg ha ha)) h2
    rw [sqIter]
    convert this using 2
    ring

/-- Squaring with upward rounding preserves upper bounds for $e^t$. -/
theorem le_sqIter_rup (d j : ℕ) : ∀ (a : ℚ) (t : ℝ), exp t ≤ a →
    exp (2 ^ j * t) ≤ (sqIter (rup d) j a : ℝ) := by
  induction j with
  | zero => intro a t h; simpa [sqIter] using h
  | succ j ih =>
    intro a t h
    have h2 : exp (2 * t) ≤ ((rup d (a * a) : ℚ) : ℝ) := by
      refine le_rup_real d ?_
      rw [show 2 * t = t + t by ring, Real.exp_add]
      push_cast
      exact mul_le_mul h h (exp_pos _).le ((exp_pos _).le.trans h)
    have := ih (rup d (a * a)) (2 * t) h2
    rw [sqIter]
    convert this using 2
    ring

/-- Number of halvings used for $e^y$: $2^j>\lceil|y|\rceil$. -/
def expJ (y : ℚ) : ℕ := Nat.log2 ⌈|y|⌉.toNat + 1

/-- Enclosure of $e^y$, $y$ rational: $z=y/2^j$, $e^z$ from the Taylor series with the remainder
bound of `Real.exp_bound`, then $j$ squarings. -/
def expIv (P : Params) (y : ℚ) : Option (ℚ × ℚ) :=
  if |y / 2 ^ expJ y| ≤ 1 ∧ 0 < P.nExp then
    some (sqIter (rdn P.prec) (expJ y) (max 0 (rdn P.prec (expSum (y / 2 ^ expJ y) P.nExp -
        |y / 2 ^ expJ y| ^ P.nExp * ((P.nExp + 1) / (P.nExp.factorial * P.nExp))))),
      sqIter (rup P.prec) (expJ y) (rup P.prec (expSum (y / 2 ^ expJ y) P.nExp +
        |y / 2 ^ expJ y| ^ P.nExp * ((P.nExp + 1) / (P.nExp.factorial * P.nExp)))))
  else none

/-- Soundness of `expIv`. -/
theorem expIv_sound (P : Params) {y : ℚ} {I : ℚ × ℚ} (h : expIv P y = some I) :
    Mem I (exp y) := by
  unfold expIv at h
  split_ifs at h with hc
  cases h
  obtain ⟨hz, hn⟩ := hc
  set j := expJ y
  set z : ℚ := y / 2 ^ j with hzdef
  have hz' : abs (z : ℝ) ≤ 1 := by exact_mod_cast hz
  have hB := abs_le.1 (Real.exp_bound hz' hn)
  rw [← expSum_cast] at hB
  have hy : (y : ℝ) = 2 ^ j * (z : ℝ) := by
    rw [hzdef]; push_cast; field_simp
  rw [hy]
  constructor
  · refine sqIter_rdn_le _ _ _ _ (le_max_left _ _) ?_
    rcases le_total (rdn P.prec (expSum z P.nExp -
        |z| ^ P.nExp * ((P.nExp + 1) / (P.nExp.factorial * P.nExp)))) 0 with h0 | h0
    · rw [max_eq_left h0]; push_cast; exact (exp_pos _).le
    · rw [max_eq_right h0]
      refine rdn_le_real _ ?_
      push_cast
      have : ((P.nExp.succ : ℕ) : ℝ) = P.nExp + 1 := by push_cast; ring
      rw [this] at hB
      linarith [hB.1]
  · refine le_sqIter_rup _ _ _ _ (le_rup_real _ ?_)
    push_cast
    have : ((P.nExp.succ : ℕ) : ℝ) = P.nExp + 1 := by push_cast; ring
    rw [this] at hB
    linarith [hB.2]

/-- Enclosure of $X^r$ for $X$ in a positive rational interval, $r\in\mathbb Q$:
$X^r=\exp(r\log X)$. -/
def rpowIv (P : Params) (I : ℚ × ℚ) (r : ℚ) : Option (ℚ × ℚ) :=
  match logIv P I.1, logIv P I.2 with
  | some (la, _), some (_, ub) =>
    match expIv P (rdn P.prec (ivMul (la, ub) (r, r)).1),
      expIv P (rup P.prec (ivMul (la, ub) (r, r)).2) with
    | some (lo, _), some (_, hi) => some (lo, hi)
    | _, _ => none
  | _, _ => none

/-- Soundness of `rpowIv`. -/
theorem rpowIv_sound (P : Params) {I J : ℚ × ℚ} {r : ℚ} {x : ℝ} (hx : Mem I x)
    (h : rpowIv P I r = some J) : Mem J (x ^ (r : ℝ)) := by
  unfold rpowIv at h
  rcases ha : logIv P I.1 with _ | ⟨la, la'⟩ <;> rw [ha] at h
  · simp at h
  rcases hb : logIv P I.2 with _ | ⟨ub', ub⟩ <;> rw [hb] at h
  · simp at h
  obtain ⟨hq1, hLa⟩ := logIv_sound P ha
  obtain ⟨hq2, hLb⟩ := logIv_sound P hb
  have hI1 : (0 : ℝ) < I.1 := by exact_mod_cast hq1
  have hx0 : 0 < x := hI1.trans_le hx.1
  have hlogx : Mem (la, ub) (log x) :=
    ⟨hLa.1.trans (Real.log_le_log hI1 hx.1),
      (Real.log_le_log hx0 hx.2).trans hLb.2⟩
  have hy := mem_ivMul hlogx (show Mem (r, r) (r : ℝ) from ⟨le_rfl, le_rfl⟩)
  simp only at h
  rcases he1 : expIv P (rdn P.prec (ivMul (la, ub) (r, r)).1) with _ | ⟨lo, lo'⟩ <;>
    rw [he1] at h
  · simp at h
  rcases he2 : expIv P (rup P.prec (ivMul (la, ub) (r, r)).2) with _ | ⟨hi', hi⟩ <;>
    rw [he2] at h
  · simp at h
  simp only [Option.some.injEq] at h
  subst h
  rw [Real.rpow_def_of_pos hx0]
  exact ⟨(expIv_sound P he1).1.trans (Real.exp_le_exp.2 (rdn_le_real _ hy.1)),
    (Real.exp_le_exp.2 (le_rup_real _ hy.2)).trans (expIv_sound P he2).2⟩

/-! ### Expressions, evaluator and soundness -/

/-- Closed real expressions. -/
inductive Ex where
  /-- A rational constant. -/
  | const (q : ℚ)
  /-- Sum. -/
  | add (a b : Ex)
  /-- Difference. -/
  | sub (a b : Ex)
  /-- Product. -/
  | mul (a b : Ex)
  /-- Quotient (evaluated only if the enclosure of the denominator excludes $0$). -/
  | div (a b : Ex)
  /-- Negation. -/
  | neg (a : Ex)
  /-- Natural power. -/
  | npow (a : Ex) (n : ℕ)
  /-- Minimum. -/
  | min (a b : Ex)
  /-- Maximum. -/
  | max (a b : Ex)
  /-- Absolute value. -/
  | abs (a : Ex)
  /-- `if a < b then t else f` (a branch is taken only if the comparison is certified). -/
  | ite_lt (a b t f : Ex)
  /-- $J(x)$ for rational $x\in[\frac12,1]$, with witnesses $s_l,s_u\ge0$ for the lower and
  upper bound. -/
  | J (x sl su : ℚ)
  /-- $\sqrt2\,\Phi^{-1}((1-x)/w_0)$ ($=J'(x)$), with witnesses $z_l,z_u$:
  $\Phi(\sqrt2z_l)\le(1-x)/w_u$, $(1-x)/w_l\le\Phi(\sqrt2z_u)$; enclosure $[2z_l,2z_u]$. -/
  | DJ (x zl zu : ℚ)
  /-- $J(x_0)$ ($=w_0/\sqrt\pi$). -/
  | Jx0
  /-- $J_w(\frac12)$ for rational $w>0$, with witnesses $s_l,s_u\ge0$. -/
  | JwHalf (w sl su : ℚ)
  /-- Real power $X^r$ (`Real.rpow`), evaluated only if the enclosure of $X$ is positive. -/
  | rpow (a : Ex) (r : ℚ)

/-- The real meaning of an expression. -/
noncomputable def denote : Ex → ℝ
  | .const q => q
  | .add a b => denote a + denote b
  | .sub a b => denote a - denote b
  | .mul a b => denote a * denote b
  | .div a b => denote a / denote b
  | .neg a => -denote a
  | .npow a n => denote a ^ n
  | .min a b => Min.min (denote a) (denote b)
  | .max a b => Max.max (denote a) (denote b)
  | .abs a => |denote a|
  | .ite_lt a b t f => if denote a < denote b then denote t else denote f
  | .J x _ _ => Auto.DIR.J x
  | .DJ x _ _ => √2 * gInv ((1 - x) / w₀)
  | .Jx0 => Auto.DIR.J x₀
  | .JwHalf w _ _ => gJw w 2⁻¹
  | .rpow a r => denote a ^ (r : ℝ)

/-- Apply a unary interval operation (with rounding). -/
def lift1 (P : Params) (f : ℚ × ℚ → ℚ × ℚ) : Option (ℚ × ℚ) → Option (ℚ × ℚ)
  | some I => some (ivRound P.prec (f I))
  | none => none

/-- Apply a binary interval operation (with rounding). -/
def lift2 (P : Params) (f : ℚ × ℚ → ℚ × ℚ → ℚ × ℚ) :
    Option (ℚ × ℚ) → Option (ℚ × ℚ) → Option (ℚ × ℚ)
  | some I, some J => some (ivRound P.prec (f I J))
  | _, _ => none

/-- Interval quotient. -/
def ivDivO (P : Params) : Option (ℚ × ℚ) → Option (ℚ × ℚ) → Option (ℚ × ℚ)
  | some I, some J =>
    match ivInv J with
    | some K => some (ivRound P.prec (ivMul I K))
    | none => none
  | _, _ => none

/-- Certified branch. -/
def iteO (A B T F : Option (ℚ × ℚ)) : Option (ℚ × ℚ) :=
  match A, B with
  | some I, some J => if I.2 < J.1 then T else if J.2 ≤ I.1 then F else none
  | _, _ => none

/-- Enclosure of $\sqrt2\,\Phi^{-1}((1-x)/w_0)$ from witnesses $z_l,z_u$. -/
def DJIv (P : Params) (x zl zu : ℚ) : Option (ℚ × ℚ) :=
  if 0 < P.wl ∧ 0 < 1 - x ∧ (1 - x) / P.wl < 1 ∧ phiHi P zl ≤ (1 - x) / P.wu ∧
      (1 - x) / P.wl ≤ phiLo P zu then some (2 * zl, 2 * zu)
  else none

/-- Enclosure of $X^r$ from an optional enclosure of $X$. -/
def rpowO (P : Params) (r : ℚ) : Option (ℚ × ℚ) → Option (ℚ × ℚ)
  | some I => if 0 < I.1 then rpowIv P I r else none
  | none => none

/-- The interval evaluator. -/
def eval (P : Params) : Ex → Option (ℚ × ℚ)
  | .const q => some (q, q)
  | .add a b => lift2 P ivAdd (eval P a) (eval P b)
  | .sub a b => lift2 P ivSub (eval P a) (eval P b)
  | .mul a b => lift2 P ivMul (eval P a) (eval P b)
  | .div a b => ivDivO P (eval P a) (eval P b)
  | .neg a => lift1 P ivNeg (eval P a)
  | .npow a n => lift1 P (fun I ↦ ivPow I n) (eval P a)
  | .min a b => lift2 P ivMin (eval P a) (eval P b)
  | .max a b => lift2 P ivMax (eval P a) (eval P b)
  | .abs a => lift1 P ivAbs (eval P a)
  | .ite_lt a b t f => iteO (eval P a) (eval P b) (eval P t) (eval P f)
  | .J x sl su => if 2⁻¹ ≤ x ∧ x ≤ 1 then gJwIv P P.wl P.wu x sl su else none
  | .DJ x zl zu => DJIv P x zl zu
  | .Jx0 => if 0 < P.wl then some (rdn P.prec (P.wl / sqrtPiHi), rup P.prec (P.wu / sqrtPiLo))
      else none
  | .JwHalf w sl su => gJwIv P w w 2⁻¹ sl su
  | .rpow a r => rpowO P r (eval P a)

/-- Soundness of an optional enclosure. -/
def OMem (o : Option (ℚ × ℚ)) (x : ℝ) : Prop := ∀ I, o = some I → Mem I x

/-- Soundness of `lift1`. -/
theorem lift1_sound (P : Params) {f : ℚ × ℚ → ℚ × ℚ} {g : ℝ → ℝ}
    (hf : ∀ I x, Mem I x → Mem (f I) (g x)) {o : Option (ℚ × ℚ)} {x : ℝ} (h : OMem o x) :
    OMem (lift1 P f o) (g x) := by
  intro I hI
  cases o with
  | none => cases hI
  | some K =>
    cases hI
    exact mem_ivRound _ (hf K x (h K rfl))

/-- Soundness of `lift2`. -/
theorem lift2_sound (P : Params) {f : ℚ × ℚ → ℚ × ℚ → ℚ × ℚ} {g : ℝ → ℝ → ℝ}
    (hf : ∀ I J x y, Mem I x → Mem J y → Mem (f I J) (g x y)) {o o' : Option (ℚ × ℚ)}
    {x y : ℝ} (h : OMem o x) (h' : OMem o' y) : OMem (lift2 P f o o') (g x y) := by
  intro I hI
  cases o with
  | none => cases hI
  | some K =>
    cases o' with
    | none => cases hI
    | some K' =>
      cases hI
      exact mem_ivRound _ (hf K K' x y (h K rfl) (h' K' rfl))

/-- Soundness of `ivDivO`. -/
theorem ivDivO_sound (P : Params) {o o' : Option (ℚ × ℚ)} {x y : ℝ} (h : OMem o x)
    (h' : OMem o' y) : OMem (ivDivO P o o') (x / y) := by
  intro I hI
  cases o with
  | none => cases hI
  | some K =>
    cases o' with
    | none => cases hI
    | some K' =>
      simp only [ivDivO] at hI
      rcases hK : ivInv K' with _ | L <;> rw [hK] at hI
      · cases hI
      cases hI
      rw [div_eq_mul_inv]
      exact mem_ivRound _ (mem_ivMul (h K rfl) (mem_ivInv (h' K' rfl) hK))

/-- Soundness of `iteO` (certified branch). -/
theorem iteO_sound {A B T F : Option (ℚ × ℚ)} {a b t f : ℝ} (hA : OMem A a) (hB : OMem B b)
    (hT : OMem T t) (hF : OMem F f) : OMem (iteO A B T F) (if a < b then t else f) := by
  intro I hI
  cases A with
  | none => cases hI
  | some K =>
    cases B with
    | none => cases hI
    | some K' =>
      have ha := hA K rfl
      have hb := hB K' rfl
      simp only [iteO] at hI
      split_ifs at hI with h1 h2
      · have : (K.2 : ℝ) < K'.1 := by exact_mod_cast h1
        rw [ite_eq_left (by linarith [ha.2, hb.1])]
        exact hT I hI
      · have : (K'.2 : ℝ) ≤ K.1 := by exact_mod_cast h2
        rw [ite_eq_right (by linarith [ha.1, hb.2])]
        exact hF I hI

/-- Soundness of `DJIv`. -/
theorem DJIv_sound (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) {x zl zu : ℚ} :
    OMem (DJIv P x zl zu) (√2 * gInv ((1 - x) / w₀)) := by
  intro I hI
  unfold DJIv at hI
  split_ifs at hI with hc
  cases hI
  obtain ⟨hwl, hx1, hxw, h1, h2⟩ := hc
  have hwl' : (0 : ℝ) < P.wl := by exact_mod_cast hwl
  have hw0 : (0 : ℝ) < w₀ := hwl'.trans_le hw.1
  have hx1' : (0 : ℝ) < 1 - x := by exact_mod_cast hx1
  have hxw' : (1 - x : ℝ) / P.wl < 1 := by exact_mod_cast hxw
  have h1' : ((phiHi P zl : ℚ) : ℝ) ≤ (1 - x) / P.wu := by exact_mod_cast h1
  have h2' : (1 - x : ℝ) / P.wl ≤ ((phiLo P zu : ℚ) : ℝ) := by exact_mod_cast h2
  have ht1 : (1 - x : ℝ) / P.wu ≤ (1 - x) / w₀ := div_le_div_of_nonneg_left hx1'.le hw0 hw.2
  have ht2 : (1 - x : ℝ) / w₀ ≤ (1 - x) / P.wl := div_le_div_of_nonneg_left hx1'.le hwl' hw.1
  have ht : (1 - x : ℝ) / w₀ ∈ Ioo 0 1 := ⟨by positivity, ht2.trans_lt hxw'⟩
  have hs2 : (0 : ℝ) < √2 := by positivity
  have h22 : √2 * √2 = (2 : ℝ) := Real.mul_self_sqrt (by norm_num)
  constructor
  · have : √2 * zl ≤ gInv ((1 - x) / w₀) :=
      (le_gInv_iff ht).2 (((gCDF_le_phiHi P zl).trans h1').trans ht1)
    have := mul_le_mul_of_nonneg_left this hs2.le
    rw [← mul_assoc, h22] at this
    push_cast
    exact this
  · have : gInv ((1 - x) / w₀) ≤ √2 * zu :=
      (gInv_le_iff ht).2 ((ht2.trans h2').trans (phiLo_le_gCDF P zu))
    have := mul_le_mul_of_nonneg_left this hs2.le
    rw [← mul_assoc, h22] at this
    push_cast
    exact this

/-- Soundness of `rpowO`. -/
theorem rpowO_sound (P : Params) (r : ℚ) {o : Option (ℚ × ℚ)} {x : ℝ} (h : OMem o x) :
    OMem (rpowO P r o) (x ^ (r : ℝ)) := by
  intro I hI
  cases o with
  | none => cases hI
  | some K =>
    simp only [rpowO] at hI
    split_ifs at hI
    exact rpowIv_sound P (h K rfl) hI

/-- **Soundness of the evaluator.** If `eval P e = some (l, u)` and $w_0\in[w_l,w_u]$, then
$l\le$ `denote e` $\le u$. -/
theorem eval_sound (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) (e : Ex) (l u : ℚ)
    (h : eval P e = some (l, u)) : (l : ℝ) ≤ denote e ∧ denote e ≤ u := by
  suffices H : ∀ e, OMem (eval P e) (denote e) from H e (l, u) h
  intro e
  induction e with
  | const q => intro I hI; cases hI; exact ⟨le_rfl, le_rfl⟩
  | add a b ha hb => exact lift2_sound P (fun _ _ _ _ ↦ mem_ivAdd) ha hb
  | sub a b ha hb => exact lift2_sound P (fun _ _ _ _ ↦ mem_ivSub) ha hb
  | mul a b ha hb => exact lift2_sound P (fun _ _ _ _ ↦ mem_ivMul) ha hb
  | div a b ha hb => exact ivDivO_sound P ha hb
  | neg a ha => exact lift1_sound P (fun _ _ ↦ mem_ivNeg) ha
  | npow a n ha => exact lift1_sound P (g := fun x ↦ x ^ n) (fun _ _ hx ↦ mem_ivPow hx n) ha
  | min a b ha hb => exact lift2_sound P (fun _ _ _ _ ↦ mem_ivMin) ha hb
  | max a b ha hb => exact lift2_sound P (fun _ _ _ _ ↦ mem_ivMax) ha hb
  | abs a ha => exact lift1_sound P (fun _ _ ↦ mem_ivAbs) ha
  | ite_lt a b t f ha hb ht hf => exact iteO_sound ha hb ht hf
  | J x sl su =>
    intro I hI
    simp only [eval] at hI
    split_ifs at hI with hx
    have hx1 : (2⁻¹ : ℝ) ≤ x := by
      have h := (Rat.cast_le (K := ℝ)).2 hx.1
      simpa using h
    have hx2 : (x : ℝ) ≤ 1 := by exact_mod_cast hx.2
    simp only [denote]
    rw [J_eq_gJw ⟨hx1, hx2⟩]
    exact gJwIv_sound P hI hw
  | DJ x zl zu => exact DJIv_sound P hw
  | Jx0 =>
    intro I hI
    simp only [eval] at hI
    split_ifs at hI with hwl
    cases hI
    have hwl' : (0 : ℝ) < P.wl := by exact_mod_cast hwl
    have hw0 : (0 : ℝ) < w₀ := hwl'.trans_le hw.1
    have hp : 0 < √π := sqrt_pos.2 pi_pos
    simp only [denote, J_x₀_eq]
    refine ⟨rdn_le_real _ ?_, le_rup_real _ ?_⟩
    · push_cast
      exact div_le_div₀ hw0.le hw.1 hp sqrt_pi_lt_hi.le
    · push_cast
      exact div_le_div₀ (hwl'.le.trans (hw.1.trans hw.2)) hw.2 sqrtPiLo_pos sqrtPiLo_lt.le
  | JwHalf w sl su =>
    intro I hI
    have := gJwIv_sound P hI (w := w) ⟨le_rfl, le_rfl⟩
    simpa [denote] using this
  | rpow a r ha => exact rpowO_sound P r ha

/-- Boolean check of a strict lower bound: `true` only if the evaluator certifies
$c<$ `denote e`. -/
def check (P : Params) (e : Ex) (c : ℚ) : Bool :=
  match eval P e with
  | some (l, _) => decide (c < l)
  | none => false

/-- Boolean check of a strict upper bound: `true` only if the evaluator certifies
`denote e` $<c$. -/
def checkUpper (P : Params) (e : Ex) (c : ℚ) : Bool :=
  match eval P e with
  | some (_, u) => decide (u < c)
  | none => false

/-- Boolean check of an enclosure: `true` only if the evaluator certifies
$a\le$ `denote e` $\le b$. -/
def checkMem (P : Params) (e : Ex) (a b : ℚ) : Bool :=
  match eval P e with
  | some (l, u) => decide (a ≤ l ∧ u ≤ b)
  | none => false

/-- Soundness of `check`: `check P e c = true` implies $c<$ `denote e`. -/
theorem check_sound (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) (e : Ex) (c : ℚ)
    (h : check P e c = true) : (c : ℝ) < denote e := by
  unfold check at h
  rcases he : eval P e with _ | ⟨l, u⟩ <;> rw [he] at h
  · cases h
  have hc : (c : ℝ) < l := by exact_mod_cast of_decide_eq_true h
  exact hc.trans_le (eval_sound P hw e l u he).1

/-- Soundness of `checkUpper`: `checkUpper P e c = true` implies `denote e` $<c$. -/
theorem checkUpper_sound (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) (e : Ex) (c : ℚ)
    (h : checkUpper P e c = true) : denote e < c := by
  unfold checkUpper at h
  rcases he : eval P e with _ | ⟨l, u⟩ <;> rw [he] at h
  · cases h
  have hc : (u : ℝ) < c := by exact_mod_cast of_decide_eq_true h
  exact (eval_sound P hw e l u he).2.trans_lt hc

/-- Soundness of `checkMem`: `checkMem P e a b = true` implies $a\le$ `denote e` $\le b$. -/
theorem checkMem_sound (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) (e : Ex) (a b : ℚ)
    (h : checkMem P e a b = true) : (a : ℝ) ≤ denote e ∧ denote e ≤ b := by
  unfold checkMem at h
  rcases he : eval P e with _ | ⟨l, u⟩ <;> rw [he] at h
  · cases h
  obtain ⟨h1, h2⟩ := of_decide_eq_true h
  have h1' : (a : ℝ) ≤ l := by exact_mod_cast h1
  have h2' : (u : ℝ) ≤ b := by exact_mod_cast h2
  have := eval_sound P hw e l u he
  exact ⟨h1'.trans this.1, this.2.trans h2'⟩

end Auto.DIR.Checker
