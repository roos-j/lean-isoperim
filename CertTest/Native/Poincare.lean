/-! ### Case II: $x\in[\frac1{64},\frac14]$ -/

/-- **(7.3)** (🚗) ([DIR], proof of Proposition 7.1, Case II). Running
$\textsc{Partition}_1(\underline{g_{P,2}},[\frac1{64},\frac14])$ shows that
$$G_{P,\beta}(x)>10^{-4}$$
for all $x\in[\frac1{64},\frac14]$ and $\beta\in[\frac12,\beta_0]$. -/
theorem eqn_7_3 (β : ℝ) (hβ : β ∈ Icc 2⁻¹ β₀) (x : ℝ) (hx : x ∈ Icc (64⁻¹ : ℝ) 4⁻¹) :
    G_P β x > 1e-4 := by
  have h2 : (2 : ℝ) ^ (-(2 * β₀)) ≥ 0.4992 := by
    rw [Real.rpow_def_of_pos (by norm_num)]
    have := Cert73.cert_two
    unfold β₀
    convert this using 2
    ring
  have hG := Auto.DIR.CertTest.G_P_formula_ge β x hβ hx h2
  have hb := Cert73.cover x hx
  rw [Real.log_inv] at hG
  unfold G_P
  norm_num at hb ⊢
  linarith

end Case_II

