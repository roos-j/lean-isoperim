/-- Lower bound for $J(1-x)$ from a certified value of the Gaussian integral (chord bound). -/
theorem J_ge_box (s c e x : ℝ) (hs : 0 ≤ s) (hc : 0 ≤ c)
    (hint : c ≤ ∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2))) (hexp : e ≤ Real.exp (-s ^ 2))
    (hhi0 : 0 < 2⁻¹ - c / 1.7725) (hx0 : 0 ≤ x) (hx : x ≤ 4⁻¹) (he : 0 ≤ e) :
    J (1 - x) ≥ 1.2657 * (e / 2.5067 * min 1 (x / 0.896 / (2⁻¹ - c / 1.7725))) := by
  have hhi : 2⁻¹ - c / 1.7725 ≤ 2⁻¹ := by linarith [div_nonneg hc (by norm_num : (0:ℝ) ≤ 1.7725)]
  have hv := gProf_ge_of_gCDF_le s _ e hs hhi0 hhi (gCDF_neg_le s c hc hint) hexp
  have hch := gProf_ge_chord _ _ (x / 0.896) hhi0 hhi hv (div_nonneg hx0 (by norm_num)) (by
    rw [div_le_iff₀ (by norm_num)]; linarith)
  have hJ := J_one_sub_ge_gProf x hx0 hx
  have hs2 : (1.2657 : ℝ) ≤ √2 * 0.895 := by
    have : (1.41421 : ℝ) ≤ √2 := Real.le_sqrt_of_sq_le (by norm_num)
    linarith
  have hm : 0 ≤ e / 2.5067 * min 1 (x / 0.896 / (2⁻¹ - c / 1.7725)) :=
    mul_nonneg (by positivity) (le_min zero_le_one
      (div_nonneg (div_nonneg hx0 (by norm_num)) hhi0.le))
  have hg : 0 ≤ gProf (x / 0.896) := le_trans hm hch
  nlinarith

