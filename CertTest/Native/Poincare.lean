theorem G_P_symm (β : ℝ) (hβ : β ∈ Icc 2⁻¹ β₀) :
    (∀ x, G_P β x = G_P β (1 - x)) ∧ G_P β 0 = 0 ∧ G_P β 2⁻¹ = 0 ∧ G_P β 1 = 0 := by
  sorry

