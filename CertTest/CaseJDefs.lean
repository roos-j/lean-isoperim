import CertTest.CheckerTest

/-!
# [DIR] Case J: the paper's tight lower bounds as checker expressions

This file was automatically generated by Claude.

Timing test (branch `cert-test`). The tight lower bounds $\underline{g_{J,1}}$,
$\underline{g_{J,2}}$ of
[DIR] §6.1 (as implemented in the paper's `verification/dir.py`) are defined as real numbers
depending on the rational corners of a rectangle; `eJ1`, `eJ2` build checker expressions with
variables, and `denote_eJ1`, `denote_eJ2` show (once, for all arguments) that they denote these
real numbers when the variables take the values `env1`, `env2` ($J$, $J'$ at the points of the
rectangle, $J(x_0)$, powers $h^r$). The values are certified once per point in a table
(`CaseJTable.lean`, `Cert.ofJ`, ...) and shared by all rectangles; a rectangle is then certified
by one `decide +kernel` (see `CaseJTest*.lean`).

The case distinctions $\overline x<x_0$, $\underline x>x_0$ of the paper are written as
$J'(\overline x)>0$, $J'(\underline x)<0$ (equivalent since $J'$ is strictly decreasing with
$J'(x_0)=0$).
-/

namespace Auto.DIR.Checker.CaseJ

open Auto.DIR Auto.DIR.Checker Set Real

/-- $\underline{g_{J,2}}(\underline x,\overline x,\underline y,\overline y)
=(\underline y-\overline x)^2+J(\overline y)^2-(2J(\frac{\underline x+\underline y}2)-J(\underline x))^2$. -/
noncomputable def gJ2lo (xm xM ym yM : ℚ) : ℝ :=
  ((ym - xM : ℚ) : ℝ) ^ 2 + J (yM : ℚ) ^ 2 - (2 * J ((xm + ym) / 2 : ℚ) - J (xm : ℚ)) ^ 2

/-- The values of the variables of `eJ2`: $J(\overline y)$, $J(p)$, $J(\underline x)$ with
$p=\frac{\underline x+\underline y}2$. -/
noncomputable def env2 (xm yM p : ℚ) : ℕ → ℝ := envOf [J (yM : ℝ), J (p : ℝ), J (xm : ℝ)]

/-- Checker expression for `gJ2lo` (variables as in `env2`). -/
def eJ2 (xM ym : ℚ) : Ex :=
  .sub (.add (.npow (.const (ym - xM)) 2) (.npow (.var 0) 2))
    (.npow (.sub (.mul (.const 2) (.var 1)) (.var 2)) 2)

/-- `eJ2` denotes `gJ2lo` in the environment `env2`. -/
theorem denote_eJ2 (xm xM ym yM p : ℚ) (hp : (xm + ym) / 2 = p) :
    denote (env2 xm yM p) (eJ2 xM ym) = gJ2lo xm xM ym yM := by
  subst hp
  simp [eJ2, gJ2lo, denote, env2, envOf]

/-- Lower bound for $J$ on $[a,b]$: $\min(J(a),J(b))$. -/
noncomputable def Jmr (a b : ℚ) : ℝ := min (J a) (J b)
/-- Upper bound for $J$ on $[a,b]$ (paper's `JM`). -/
noncomputable def JMr (a b : ℚ) : ℝ :=
  if (0 : ℝ) < DJr b then J b else if DJr a < 0 then J a else J x₀
/-- Upper bound for $|J'|$ on $[a,b]$: $\max(|J'(a)|,|J'(b)|)$. -/
noncomputable def aMr (a b : ℚ) : ℝ := max |DJr a| |DJr b|
/-- Lower bound for $|J'|$ on $[a,b]$ (paper's `absDJm`). -/
noncomputable def amr (a b : ℚ) : ℝ :=
  if (0 : ℝ) < DJr b then DJr b else if DJr a < 0 then -DJr a else 0

/-- $\underline{g_{J,1,\beta,c}}(\underline x,\overline x,\underline h,\overline h)$ of [DIR]
§6.1.1 (as in `verification/dir.py`, `g_J_1`). -/
noncomputable def gJ1lo (xm xM hm hM b c : ℚ) : ℝ :=
  (b : ℝ) * (c : ℝ) ^ ((1 - 1 / b : ℚ) : ℝ) * JMr (xm + hm) (xM + hM) ^ ((1 - 1 / b : ℚ) : ℝ)
  - 2⁻¹ * b * (1 - b) * (c : ℝ) ^ ((1 - 2 / b : ℚ) : ℝ) *
      Jmr (xm + hm) (xM + hM) ^ ((1 - 2 / b : ℚ) : ℝ) * (hM : ℝ) ^ ((1 / b : ℚ) : ℝ)
  - c / 2 * (Jmr xm xM)⁻¹ * (hM : ℝ) ^ ((2 - 1 / b : ℚ) : ℝ)
  + (if (0 : ℝ) < DJr xM then
      c / 4 * DJr xM * (J xM ^ 2)⁻¹ * (hm : ℝ) ^ ((3 - 1 / b : ℚ) : ℝ)
        + c / 32 * DJr xM * (7 + 3 * DJr xM ^ 2) * (J xM ^ 4)⁻¹ * (hm : ℝ) ^ ((5 - 1 / b : ℚ) : ℝ)
    else
      -(c / 4 * aMr xm xM * (Jmr xm xM ^ 2)⁻¹ * (hM : ℝ) ^ ((3 - 1 / b : ℚ) : ℝ))
        - c / 32 * aMr xm xM * (7 + 3 * aMr xm xM ^ 2) * (Jmr xm xM ^ 4)⁻¹ *
          (hM : ℝ) ^ ((5 - 1 / b : ℚ) : ℝ))
  - 7 * c / 48 * (1 + aMr xm xM ^ 2) * (Jmr xm xM ^ 3)⁻¹ * (hM : ℝ) ^ ((4 - 1 / b : ℚ) : ℝ)
  - c / 90 * (7 + 23 * aMr xm (xM + hM) ^ 2 + 6 * aMr xm (xM + hM) ^ 4) *
      (Jmr xm (xM + hM) ^ 5)⁻¹ * (hM : ℝ) ^ ((6 - 1 / b : ℚ) : ℝ)
  + c / 2880 * (7 + 23 * amr xm (xM + hM / 2) ^ 2 + 6 * amr xm (xM + hM / 2) ^ 4) *
      (JMr xm (xM + hM / 2) ^ 5)⁻¹ * (hm : ℝ) ^ ((6 - 1 / b : ℚ) : ℝ)

/-- The values of the variables of `eJ1` for the rectangle
$[\underline x,\overline x]\times[\underline h,\overline h]$, with $p_3=\underline x+\underline h$,
$p_4=\overline x+\overline h$, $p_5=\overline x+\overline h/2$:
`0`–`4` $J$ at $\underline x,\overline x,p_3,p_4,p_5$; `5`–`9` $J'$ at the same points; `10`
$J(x_0)$; `11`–`19` $\overline h^{1/b}$, $\overline h^{2-1/b}$, $\underline h^{3-1/b}$,
$\underline h^{5-1/b}$, $\overline h^{3-1/b}$, $\overline h^{5-1/b}$, $\overline h^{4-1/b}$,
$\overline h^{6-1/b}$, $\underline h^{6-1/b}$. -/
noncomputable def env1 (xm xM hm hM b p3 p4 p5 : ℚ) : ℕ → ℝ :=
  envOf [J (xm : ℝ), J (xM : ℝ), J (p3 : ℝ), J (p4 : ℝ), J (p5 : ℝ),
    DJr (xm : ℝ), DJr (xM : ℝ), DJr (p3 : ℝ), DJr (p4 : ℝ), DJr (p5 : ℝ), J x₀,
    (hM : ℝ) ^ ((1 / b : ℚ) : ℝ), (hM : ℝ) ^ ((2 - 1 / b : ℚ) : ℝ),
    (hm : ℝ) ^ ((3 - 1 / b : ℚ) : ℝ), (hm : ℝ) ^ ((5 - 1 / b : ℚ) : ℝ),
    (hM : ℝ) ^ ((3 - 1 / b : ℚ) : ℝ), (hM : ℝ) ^ ((5 - 1 / b : ℚ) : ℝ),
    (hM : ℝ) ^ ((4 - 1 / b : ℚ) : ℝ), (hM : ℝ) ^ ((6 - 1 / b : ℚ) : ℝ),
    (hm : ℝ) ^ ((6 - 1 / b : ℚ) : ℝ)]

/-- Checker expression for `gJ1lo` (variables as in `env1`; it depends only on $b$, $c$). -/
def eJ1 (b c : ℚ) : Ex :=
  let Jxm := Ex.var 0
  let JxM := Ex.var 1
  let J3 := Ex.var 2
  let J4 := Ex.var 3
  let J5 := Ex.var 4
  let Dxm := Ex.var 5
  let DxM := Ex.var 6
  let D3 := Ex.var 7
  let D4 := Ex.var 8
  let D5 := Ex.var 9
  let Jx₀ := Ex.var 10
  let JM := fun (Ja Da Jb Db : Ex) ↦
    Ex.ite_lt (.const 0) Db Jb (.ite_lt Da (.const 0) Ja Jx₀)
  let am := fun (Da Db : Ex) ↦
    Ex.ite_lt (.const 0) Db Db (.ite_lt Da (.const 0) (.neg Da) (.const 0))
  let aM := fun (Da Db : Ex) ↦ Ex.max (.abs Da) (.abs Db)
  let inv := fun (e : Ex) ↦ Ex.div (.const 1) e
  let t1 := Ex.mul (.mul (.const b) (.rpow (.const c) (1 - 1 / b)))
    (.rpow (JM J3 D3 J4 D4) (1 - 1 / b))
  let t2 := Ex.mul (.mul (.mul (.const (2⁻¹ * b * (1 - b))) (.rpow (.const c) (1 - 2 / b)))
    (.rpow (.min J3 J4) (1 - 2 / b))) (.var 11)
  let t3 := Ex.mul (.mul (.const (c / 2)) (inv (.min Jxm JxM))) (.var 12)
  let t4 := Ex.ite_lt (.const 0) DxM
    (.add (.mul (.mul (.mul (.const (c / 4)) DxM) (inv (.npow JxM 2))) (.var 13))
      (.mul (.mul (.mul (.mul (.const (c / 32)) DxM)
          (.add (.const 7) (.mul (.const 3) (.npow DxM 2))))
          (inv (.npow JxM 4))) (.var 14)))
    (.sub (.neg (.mul (.mul (.mul (.const (c / 4)) (aM Dxm DxM))
          (inv (.npow (.min Jxm JxM) 2))) (.var 15)))
      (.mul (.mul (.mul (.mul (.const (c / 32)) (aM Dxm DxM))
          (.add (.const 7) (.mul (.const 3) (.npow (aM Dxm DxM) 2))))
          (inv (.npow (.min Jxm JxM) 4))) (.var 16)))
  let t5 := Ex.mul (.mul (.mul (.const (7 * c / 48))
      (.add (.const 1) (.npow (aM Dxm DxM) 2))) (inv (.npow (.min Jxm JxM) 3))) (.var 17)
  let t6 := Ex.mul (.mul (.mul (.const (c / 90))
      (.add (.add (.const 7) (.mul (.const 23) (.npow (aM Dxm D4) 2)))
        (.mul (.const 6) (.npow (aM Dxm D4) 4))))
      (inv (.npow (.min Jxm J4) 5))) (.var 18)
  let t7 := Ex.mul (.mul (.mul (.const (c / 2880))
      (.add (.add (.const 7) (.mul (.const 23) (.npow (am Dxm D5) 2)))
        (.mul (.const 6) (.npow (am Dxm D5) 4))))
      (inv (.npow (JM Jxm Dxm J5 D5) 5))) (.var 19)
  .add (.sub (.sub (.add (.sub (.sub t1 t2) t3) t4) t5) t6) t7

/-- `eJ1` denotes `gJ1lo` in the environment `env1`. -/
theorem denote_eJ1 (xm xM hm hM b c p3 p4 p5 : ℚ) (h3 : xm + hm = p3) (h4 : xM + hM = p4)
    (h5 : xM + hM / 2 = p5) :
    denote (env1 xm xM hm hM b p3 p4 p5) (eJ1 b c) = gJ1lo xm xM hm hM b c := by
  subst h3 h4 h5
  simp only [eJ1, gJ1lo, denote, env1, envOf, JMr, Jmr, aMr, amr]
  simp only [List.getD_cons_succ, List.getD_cons_zero]
  push_cast
  ring_nf

end Auto.DIR.Checker.CaseJ
