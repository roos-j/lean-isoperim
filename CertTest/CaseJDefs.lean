import CertTest.CheckerTest

/-!
# [DIR] Case J: the paper's tight lower bounds as checker expressions

This file was automatically generated by Claude.

Timing test (branch `cert-test`). The tight lower bounds $\underline{g_{J,1}}$, $\underline{g_{J,2}}$ of
[DIR] §6.1 (as implemented in the paper's `verification/dir.py`) are defined as real numbers
depending on the rational corners of a rectangle; `eJ1`, `eJ2` build checker expressions, and
`denote_eJ1`, `denote_eJ2` show (once, for all arguments) that they denote these real numbers.
A rectangle is then certified by one `decide +kernel` (see `CaseJTest*.lean`).

The case distinctions $\overline x<x_0$, $\underline x>x_0$ of the paper are written as
$J'(\overline x)>0$, $J'(\underline x)<0$ (equivalent since $J'$ is strictly decreasing with
$J'(x_0)=0$). Witness arguments are ignored by the real meaning.
-/

namespace Auto.DIR.Checker.CaseJ

open Auto.DIR Auto.DIR.Checker Set Real

/-- $J'(x)=\sqrt2\,\Phi^{-1}((1-x)/w_0)$. -/
noncomputable def DJr (x : ℝ) : ℝ := √2 * gInv ((1 - x) / w₀)

/-- $J$ with the exact value $J(1)=0$ built in (the witness check needs $x<1$). -/
def Jn (x sl su : ℚ) : Ex := if x = 1 then .const 0 else .J x sl su

theorem denote_Jn (x sl su : ℚ) : denote (Jn x sl su) = J x := by
  unfold Jn; split_ifs with h
  · subst h; simp [denote, J_eq_gJw (x := 1) ⟨by norm_num, le_rfl⟩, gJw_one]
  · rfl

/-- A power $h^r$ of a rational $h\ge0$ ($0^r=0$ for $r\ne0$ is handled exactly). -/
def pw (h r : ℚ) : Ex := if h = 0 then .const 0 else .rpow (.const h) r

theorem denote_pw (h r : ℚ) (hr : r ≠ 0) : denote (pw h r) = (h : ℝ) ^ (r : ℝ) := by
  unfold pw; split_ifs with hh
  · subst hh; simp [denote, Real.zero_rpow (show (r : ℝ) ≠ 0 by exact_mod_cast hr)]
  · rfl

/-- $\underline{g_{J,2}}(\underline x,\overline x,\underline y,\overline y)
=(\underline y-\overline x)^2+J(\overline y)^2-(2J(\frac{\underline x+\underline y}2)-J(\underline x))^2$. -/
noncomputable def gJ2lo (xm xM ym yM : ℚ) : ℝ :=
  ((ym - xM : ℚ) : ℝ) ^ 2 + J (yM : ℚ) ^ 2 - (2 * J ((xm + ym) / 2 : ℚ) - J (xm : ℚ)) ^ 2

/-- Checker expression for `gJ2lo` (witnesses for $J$ at $\overline y$, $\frac{\underline x+
\underline y}2$, $\underline x$). -/
def eJ2 (xm xM ym yM a1 a2 b1 b2 c1 c2 : ℚ) : Ex :=
  .sub (.add (.npow (.const (ym - xM)) 2) (.npow (Jn yM a1 a2) 2))
    (.npow (.sub (.mul (.const 2) (Jn ((xm + ym) / 2) b1 b2)) (Jn xm c1 c2)) 2)

theorem denote_eJ2 (xm xM ym yM a1 a2 b1 b2 c1 c2 : ℚ) :
    denote (eJ2 xm xM ym yM a1 a2 b1 b2 c1 c2) = gJ2lo xm xM ym yM := by
  simp [eJ2, gJ2lo, denote, denote_Jn]

/-- Lower bound for $J$ on $[a,b]$: $\min(J(a),J(b))$. -/
noncomputable def Jmr (a b : ℚ) : ℝ := min (J a) (J b)
/-- Upper bound for $J$ on $[a,b]$ (paper's `JM`). -/
noncomputable def JMr (a b : ℚ) : ℝ :=
  if (0 : ℝ) < DJr b then J b else if DJr a < 0 then J a else J x₀
/-- Upper bound for $|J'|$ on $[a,b]$: $\max(|J'(a)|,|J'(b)|)$. -/
noncomputable def aMr (a b : ℚ) : ℝ := max |DJr a| |DJr b|
/-- Lower bound for $|J'|$ on $[a,b]$ (paper's `absDJm`). -/
noncomputable def amr (a b : ℚ) : ℝ :=
  if (0 : ℝ) < DJr b then DJr b else if DJr a < 0 then -DJr a else 0

/-- $\underline{g_{J,1,\beta,c}}(\underline x,\overline x,\underline h,\overline h)$ of [DIR]
§6.1.1 (as in `verification/dir.py`, `g_J_1`). -/
noncomputable def gJ1lo (xm xM hm hM b c : ℚ) : ℝ :=
  (b : ℝ) * (c : ℝ) ^ ((1 - 1 / b : ℚ) : ℝ) * JMr (xm + hm) (xM + hM) ^ ((1 - 1 / b : ℚ) : ℝ)
  - 2⁻¹ * b * (1 - b) * (c : ℝ) ^ ((1 - 2 / b : ℚ) : ℝ) *
      Jmr (xm + hm) (xM + hM) ^ ((1 - 2 / b : ℚ) : ℝ) * (hM : ℝ) ^ ((1 / b : ℚ) : ℝ)
  - c / 2 * (Jmr xm xM)⁻¹ * (hM : ℝ) ^ ((2 - 1 / b : ℚ) : ℝ)
  + (if (0 : ℝ) < DJr xM then
      c / 4 * DJr xM * (J xM ^ 2)⁻¹ * (hm : ℝ) ^ ((3 - 1 / b : ℚ) : ℝ)
        + c / 32 * DJr xM * (7 + 3 * DJr xM ^ 2) * (J xM ^ 4)⁻¹ * (hm : ℝ) ^ ((5 - 1 / b : ℚ) : ℝ)
    else
      -(c / 4 * aMr xm xM * (Jmr xm xM ^ 2)⁻¹ * (hM : ℝ) ^ ((3 - 1 / b : ℚ) : ℝ))
        - c / 32 * aMr xm xM * (7 + 3 * aMr xm xM ^ 2) * (Jmr xm xM ^ 4)⁻¹ *
          (hM : ℝ) ^ ((5 - 1 / b : ℚ) : ℝ))
  - 7 * c / 48 * (1 + aMr xm xM ^ 2) * (Jmr xm xM ^ 3)⁻¹ * (hM : ℝ) ^ ((4 - 1 / b : ℚ) : ℝ)
  - c / 90 * (7 + 23 * aMr xm (xM + hM) ^ 2 + 6 * aMr xm (xM + hM) ^ 4) *
      (Jmr xm (xM + hM) ^ 5)⁻¹ * (hM : ℝ) ^ ((6 - 1 / b : ℚ) : ℝ)
  + c / 2880 * (7 + 23 * amr xm (xM + hM / 2) ^ 2 + 6 * amr xm (xM + hM / 2) ^ 4) *
      (JMr xm (xM + hM / 2) ^ 5)⁻¹ * (hm : ℝ) ^ ((6 - 1 / b : ℚ) : ℝ)

/-- Witnesses for one rectangle of (6.3): $J$ at $\underline x$, $\overline x$, $\underline x+
\underline h$, $\overline x+\overline h$, $\overline x+\overline h/2$; $J'$ at $\underline x$,
$\overline x$, $\underline x+\underline h$, $\overline x+\overline h$, $\overline x+\overline h/2$. -/
structure W1 where
  j1 : ℚ × ℚ
  j2 : ℚ × ℚ
  j3 : ℚ × ℚ
  j4 : ℚ × ℚ
  j5 : ℚ × ℚ
  d1 : ℚ × ℚ
  d2 : ℚ × ℚ
  d3 : ℚ × ℚ
  d4 : ℚ × ℚ
  d5 : ℚ × ℚ

/-- Checker expression for `gJ1lo`. -/
def eJ1 (xm xM hm hM b c : ℚ) (W : W1) : Ex :=
  let Jx := fun (x : ℚ) (w : ℚ × ℚ) ↦ Jn x w.1 w.2
  let D := fun (x : ℚ) (w : ℚ × ℚ) ↦ Ex.DJ x w.1 w.2
  let Jm := fun (a : ℚ) (wa : ℚ × ℚ) (b' : ℚ) (wb : ℚ × ℚ) ↦ Ex.min (Jx a wa) (Jx b' wb)
  let JM := fun (a : ℚ) (wa da : ℚ × ℚ) (b' : ℚ) (wb db : ℚ × ℚ) ↦
    Ex.ite_lt (.const 0) (D b' db) (Jx b' wb) (.ite_lt (D a da) (.const 0) (Jx a wa) .Jx0)
  let aM := fun (a : ℚ) (da : ℚ × ℚ) (b' : ℚ) (db : ℚ × ℚ) ↦ Ex.max (.abs (D a da)) (.abs (D b' db))
  let am := fun (a : ℚ) (da : ℚ × ℚ) (b' : ℚ) (db : ℚ × ℚ) ↦
    Ex.ite_lt (.const 0) (D b' db) (D b' db) (.ite_lt (D a da) (.const 0) (.neg (D a da)) (.const 0))
  let inv := fun (e : Ex) ↦ Ex.div (.const 1) e
  let t1 := Ex.mul (.mul (.const b) (.rpow (.const c) (1 - 1 / b)))
    (.rpow (JM (xm + hm) W.j3 W.d3 (xM + hM) W.j4 W.d4) (1 - 1 / b))
  let t2 := Ex.mul (.mul (.mul (.const (2⁻¹ * b * (1 - b))) (.rpow (.const c) (1 - 2 / b)))
    (.rpow (Jm (xm + hm) W.j3 (xM + hM) W.j4) (1 - 2 / b))) (pw hM (1 / b))
  let t3 := Ex.mul (.mul (.const (c / 2)) (inv (Jm xm W.j1 xM W.j2))) (pw hM (2 - 1 / b))
  let t4 := Ex.ite_lt (.const 0) (D xM W.d2)
    (.add (.mul (.mul (.mul (.const (c / 4)) (D xM W.d2)) (inv (.npow (Jx xM W.j2) 2)))
        (pw hm (3 - 1 / b)))
      (.mul (.mul (.mul (.mul (.const (c / 32)) (D xM W.d2))
          (.add (.const 7) (.mul (.const 3) (.npow (D xM W.d2) 2))))
          (inv (.npow (Jx xM W.j2) 4))) (pw hm (5 - 1 / b))))
    (.sub (.neg (.mul (.mul (.mul (.const (c / 4)) (aM xm W.d1 xM W.d2))
          (inv (.npow (Jm xm W.j1 xM W.j2) 2))) (pw hM (3 - 1 / b))))
      (.mul (.mul (.mul (.mul (.const (c / 32)) (aM xm W.d1 xM W.d2))
          (.add (.const 7) (.mul (.const 3) (.npow (aM xm W.d1 xM W.d2) 2))))
          (inv (.npow (Jm xm W.j1 xM W.j2) 4))) (pw hM (5 - 1 / b))))
  let t5 := Ex.mul (.mul (.mul (.const (7 * c / 48))
      (.add (.const 1) (.npow (aM xm W.d1 xM W.d2) 2))) (inv (.npow (Jm xm W.j1 xM W.j2) 3)))
    (pw hM (4 - 1 / b))
  let t6 := Ex.mul (.mul (.mul (.const (c / 90))
      (.add (.add (.const 7) (.mul (.const 23) (.npow (aM xm W.d1 (xM + hM) W.d4) 2)))
        (.mul (.const 6) (.npow (aM xm W.d1 (xM + hM) W.d4) 4))))
      (inv (.npow (Jm xm W.j1 (xM + hM) W.j4) 5))) (pw hM (6 - 1 / b))
  let t7 := Ex.mul (.mul (.mul (.const (c / 2880))
      (.add (.add (.const 7) (.mul (.const 23) (.npow (am xm W.d1 (xM + hM / 2) W.d5) 2)))
        (.mul (.const 6) (.npow (am xm W.d1 (xM + hM / 2) W.d5) 4))))
      (inv (.npow (JM xm W.j1 W.d1 (xM + hM / 2) W.j5 W.d5) 5))) (pw hm (6 - 1 / b))
  .add (.sub (.sub (.add (.sub (.sub t1 t2) t3) t4) t5) t6) t7

theorem denote_eJ1 (xm xM hm hM b c : ℚ) (W : W1) (hb1 : 1 / b ≠ 0) (h2 : 2 - 1 / b ≠ 0)
    (h3 : 3 - 1 / b ≠ 0) (h4 : 4 - 1 / b ≠ 0) (h5 : 5 - 1 / b ≠ 0) (h6 : 6 - 1 / b ≠ 0) :
    denote (eJ1 xm xM hm hM b c W) = gJ1lo xm xM hm hM b c := by
  simp only [eJ1, gJ1lo, denote, denote_Jn, denote_pw _ _ hb1, denote_pw _ _ h2, denote_pw _ _ h3,
    denote_pw _ _ h4, denote_pw _ _ h5, denote_pw _ _ h6, JMr, Jmr, aMr, amr, DJr]
  push_cast
  ring_nf

end Auto.DIR.Checker.CaseJ
