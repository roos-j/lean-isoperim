/-- $\Phi(z)=\frac12\bigl(1+\operatorname{erf}(z/\sqrt2)\bigr)$, with LeanCert's
$\operatorname{erf}(x)=\frac2{\sqrt\pi}\int_0^xe^{-t^2}\,dt$. -/
theorem gCDF_eq_erf (z : ℝ) : gCDF z = (1 + LeanCert.Core.Real.erf (z / √2)) / 2 := by
  have h2 : (√2 : ℝ) ≠ 0 := by positivity
  have hsub : (∫ s in (0 : ℝ)..z, exp (-(s / √2) ^ 2)) =
      √2 * ∫ t in (0 : ℝ)..z / √2, exp (-t ^ 2) := by
    rw [intervalIntegral.integral_comp_div (fun t ↦ exp (-t ^ 2)) h2, zero_div, smul_eq_mul]
  have hdens : (fun s ↦ gDens s) = fun s ↦ (2 * π) ^ (-(2⁻¹ : ℝ)) * exp (-(s / √2) ^ 2) := by
    funext s
    rw [gDens, div_pow, sq_sqrt (by norm_num : (0 : ℝ) ≤ 2), neg_div]
  rw [gCDF_eq, gCDF_zero, hdens, intervalIntegral.integral_const_mul, hsub, LeanCert.Core.Real.erf,
    gConst_eq, sqrt_mul (by norm_num : (0 : ℝ) ≤ 2)]
  have hp : 0 < √π := sqrt_pos.2 pi_pos
  field_simp

/-- $J(1-x)=\sqrt2\,w_0\,I(x/w_0)$ for $x\in[0,\frac12]$, by (3.4). -/
theorem J_one_sub_eq (x : ℝ) (hx0 : 0 ≤ x) (hx : x ≤ 2⁻¹) :
    J (1 - x) = √2 * w₀ * gProf (w₀⁻¹ * x) := by
  rw [eqn_3_4 (1 - x) ⟨by linarith, by linarith⟩]
  show √2 * w₀ * gProf (w₀⁻¹ * (1 - (1 - x))) = _
  rw [sub_sub_cancel]

/-- $J(1-x)\ge0$ for $x\in[0,\frac12]$. -/
theorem J_one_sub_nonneg (x : ℝ) (hx0 : 0 ≤ x) (hx : x ≤ 2⁻¹) : 0 ≤ J (1 - x) := by
  rw [J_one_sub_eq x hx0 hx]
  have := w₀_mem.1
  have := gProf_nonneg (w₀⁻¹ * x)
  positivity

/-- Lower bound for $J(1-x)$: if $0<a\le x\le\frac14$ and
$\operatorname{erf}(s)\le 2a/0.896-1$, then $J(1-x)\ge0.895\,e^{-s^2}/\sqrt\pi$.

**Unused hypothesis.** The originally intended statement also assumes $s\le0$; this is not
needed for the claim (it follows from the bound on $\operatorname{erf}(s)$) and is omitted. -/
theorem J_one_sub_ge (a x s : ℝ) (ha : 0 < a) (hax : a ≤ x) (hx : x ≤ 4⁻¹)
    (herf : LeanCert.Core.Real.erf s ≤ 2 * (a / 0.896) - 1) :
    J (1 - x) ≥ 0.895 * (Real.exp (-s ^ 2) / √π) := by
  obtain ⟨hw1, hw2⟩ := w₀_mem
  have hw0 : 0 < w₀ := by linarith
  rw [J_one_sub_eq x (by linarith) (by linarith)]
  set c : ℝ := a / 0.896 with hc
  have hc0 : 0 < c := by positivity
  have hc1 : c < 2⁻¹ := by rw [hc, div_lt_iff₀ (by norm_num)]; linarith
  have hcI : c ∈ Ioo (0 : ℝ) 1 := ⟨hc0, by linarith⟩
  have hy1 : c ≤ w₀⁻¹ * x := by
    rw [hc, ← div_eq_inv_mul, div_le_div_iff₀ (by norm_num) hw0]; nlinarith
  have hy2 : w₀⁻¹ * x ≤ 2⁻¹ := by
    rw [← div_eq_inv_mul, div_le_iff₀ hw0]; linarith
  have hmono : gProf c ≤ gProf (w₀⁻¹ * x) :=
    gProf_strictMonoOn.monotoneOn ⟨hc0.le, hc1.le⟩ ⟨hc0.le.trans hy1, hy2⟩ hy1
  -- $\sqrt2 s\le\Phi^{-1}(c)\le0$
  have hle : √2 * s ≤ gInv c := by
    rw [le_gInv_iff hcI, gCDF_eq_erf,
      mul_div_cancel_left₀ _ (by positivity : (√2 : ℝ) ≠ 0)]
    linarith
  have hneg : gInv c < 0 := gInv_neg ⟨hc0, hc1⟩
  have hdens : gDens (√2 * s) ≤ gDens (gInv c) := by
    rw [← gDens_neg (√2 * s), ← gDens_neg (gInv c)]
    exact gDens_antitoneOn (by simp only [mem_Ici]; linarith)
      (by simp only [mem_Ici]; nlinarith [sqrt_nonneg 2]) (by linarith)
  have hval : gDens (√2 * s) = Real.exp (-s ^ 2) / (√2 * √π) := by
    rw [gDens, gConst_eq, sqrt_mul (by norm_num : (0 : ℝ) ≤ 2), mul_pow,
      sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
    field_simp
  rw [gProf_of_mem hcI] at hmono
  have hp : 0 < √π := sqrt_pos.2 pi_pos
  have h2 : 0 < √2 := by positivity
  have hE : 0 < Real.exp (-s ^ 2) := exp_pos _
  have key : 0.895 * (Real.exp (-s ^ 2) / √π) = √2 * 0.895 * gDens (√2 * s) := by
    rw [hval]; field_simp
  rw [key]
  have := gDens_pos (√2 * s)
  have h3 : gDens (√2 * s) ≤ gProf (w₀⁻¹ * x) := hdens.trans hmono
  gcongr

/-- $\sqrt{\log 2}\le1/1.2011$ (from $\log2<0.6931471808$). -/
theorem sqrt_log_two_le : √(Real.log 2) ≤ 1 / 1.2011 := by
  rw [show (1 / 1.2011 : ℝ) = √((1 / 1.2011) ^ 2) from (sqrt_sq (by norm_num)).symm]
  exact sqrt_le_sqrt (by linarith [log_two_lt_d9])

/-- $L_\beta(x)\ge 1.2011\,x\sqrt{\log x^{-1}}$ for $\beta\ge\frac12$, $x\in(0,\frac12]$. -/
theorem L_ge (β x : ℝ) (hβ : 2⁻¹ ≤ β) (hx0 : 0 < x) (hx : x ≤ 2⁻¹) :
    L β x ≥ 1.2011 * (x * √(Real.log x⁻¹)) := by
  have hl := sqrt_log_two_le
  have hl2 : 0 < Real.log 2 := log_pos (by norm_num)
  have hs2 : 0 < √(Real.log 2) := sqrt_pos.2 hl2
  have hlog : 1 ≤ logb 2 x⁻¹ := by
    rw [le_logb_iff_rpow_le (by norm_num) (by positivity), rpow_one, le_inv_comm₀ (by norm_num) hx0]
    linarith
  have h1 : logb 2 x⁻¹ ^ (2⁻¹ : ℝ) ≤ logb 2 x⁻¹ ^ β := rpow_le_rpow_of_exponent_le hlog hβ
  have h2 : logb 2 x⁻¹ ^ (2⁻¹ : ℝ) = √(Real.log x⁻¹) / √(Real.log 2) := by
    rw [show (2⁻¹ : ℝ) = 1 / 2 by norm_num, ← sqrt_eq_rpow, logb, sqrt_div' _ hl2.le]
  have h3 : 1.2011 ≤ 1 / √(Real.log 2) := by
    rw [le_div_iff₀ hs2]; rw [le_div_iff₀ (by norm_num)] at hl; linarith
  have hsx : 0 ≤ √(Real.log x⁻¹) := sqrt_nonneg _
  rw [L, ge_iff_le, mul_comm (1.2011 : ℝ), mul_assoc]
  refine mul_le_mul_of_nonneg_left ?_ hx0.le
  calc √(Real.log x⁻¹) * 1.2011 ≤ √(Real.log x⁻¹) * (1 / √(Real.log 2)) :=
        mul_le_mul_of_nonneg_left h3 hsx
    _ = logb 2 x⁻¹ ^ (2⁻¹ : ℝ) := by rw [h2]; ring
    _ ≤ _ := h1

/-- Lower bound for the expression
$2^{-2\beta}(b_\beta(x)+b_\beta(1-x))-x^{2\beta}(1-x)-x(1-x)^{2\beta}$ for
$\beta\in[\frac12,\beta_0]$, $x\in[\frac1{64},\frac14]$, given the numerical fact
$2^{-2\beta_0}\ge0.4992$. -/
theorem G_P_formula_ge (β x : ℝ) (hβ : β ∈ Icc 2⁻¹ β₀) (hx : x ∈ Icc (64⁻¹ : ℝ) 4⁻¹)
    (h2 : (2 : ℝ) ^ (-(2 * β₀)) ≥ 0.4992) :
    2 ^ (-(2 * β)) * (b β x + b β (1 - x)) - x ^ (2 * β) * (1 - x) - x * (1 - x) ^ (2 * β) ≥
      0.4992 * (1.2011 * (x * √(Real.log x⁻¹)) + J (1 - x)) - 2 * x * (1 - x) := by
  obtain ⟨hβ1, hβ2⟩ := hβ
  obtain ⟨hx1, hx2⟩ := hx
  have hx0 : 0 < x := by linarith
  have hbx : b β x = L β x := by rw [b, ite_eq_left hx2]
  have hb1 : b β (1 - x) = J (1 - x) := by
    rw [b, ite_eq_right (by linarith), ite_eq_right (by linarith)]
  rw [hbx, hb1]
  have hL := L_ge β x hβ1 hx0 (by linarith)
  have hJ := J_one_sub_nonneg x hx0.le (by linarith)
  have hsx : 0 ≤ √(Real.log x⁻¹) := sqrt_nonneg _
  have hp : (2 : ℝ) ^ (-(2 * β₀)) ≤ 2 ^ (-(2 * β)) :=
    rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
  have hxp : x ^ (2 * β) ≤ x := by
    simpa using rpow_le_rpow_of_exponent_ge hx0 (by linarith) (by linarith : (1 : ℝ) ≤ 2 * β)
  have hyp : (1 - x) ^ (2 * β) ≤ 1 - x := by
    simpa using rpow_le_rpow_of_exponent_ge (by linarith : (0 : ℝ) < 1 - x) (by linarith)
      (by linarith : (1 : ℝ) ≤ 2 * β)
  have hS : 1.2011 * (x * √(Real.log x⁻¹)) + J (1 - x) ≤ L β x + J (1 - x) := by linarith
  have hS0 : 0 ≤ 1.2011 * (x * √(Real.log x⁻¹)) + J (1 - x) := by positivity
  have hA : 0.4992 * (1.2011 * (x * √(Real.log x⁻¹)) + J (1 - x)) ≤
      2 ^ (-(2 * β)) * (L β x + J (1 - x)) :=
    mul_le_mul (h2.trans hp) hS hS0 (by positivity)
  have hB : x ^ (2 * β) * (1 - x) ≤ x * (1 - x) :=
    mul_le_mul_of_nonneg_right hxp (by linarith)
  have hC : x * (1 - x) ^ (2 * β) ≤ x * (1 - x) := mul_le_mul_of_nonneg_left hyp hx0.le
  linarith

/-- $\varphi(\sqrt2\,s)=e^{-s^2}/(\sqrt2\sqrt\pi)$. -/
theorem gDens_sqrt_two_mul (s : ℝ) : gDens (√2 * s) = Real.exp (-s ^ 2) / (√2 * √π) := by
  rw [gDens, gConst_eq, sqrt_mul (by norm_num : (0 : ℝ) ≤ 2), mul_pow,
    sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
  field_simp

/-- $\int_0^{-s}e^{-t^2}\,dt=-\int_0^se^{-t^2}\,dt$. -/
theorem integral_exp_neg_sq_neg (s : ℝ) :
    ∫ u in (0 : ℝ)..-s, Real.exp (-(u ^ 2)) = -∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2)) := by
  have h := intervalIntegral.integral_comp_neg (a := 0) (b := s) (fun u ↦ Real.exp (-(u ^ 2)))
  simp only [neg_sq, neg_zero] at h
  rw [h, intervalIntegral.integral_symm]

/-- If $0\le c\le\int_0^se^{-u^2}\,du$, then $\Phi(-\sqrt2\,s)\le\frac12-c/1.7725$. -/
theorem gCDF_neg_le (s c : ℝ) (hc : 0 ≤ c)
    (hint : c ≤ ∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2))) :
    gCDF (-(√2 * s)) ≤ 2⁻¹ - c / 1.7725 := by
  have h2 : (√2 : ℝ) ≠ 0 := by positivity
  rw [gCDF_eq_erf, neg_div, mul_div_cancel_left₀ _ h2, LeanCert.Core.Real.erf,
    integral_exp_neg_sq_neg]
  have hp : 0 < √π := sqrt_pos.2 pi_pos
  have hp2 : √π ≤ 1.7725 := by
    rw [show (1.7725 : ℝ) = √(1.7725 ^ 2) from (sqrt_sq (by norm_num)).symm]
    exact sqrt_le_sqrt (by linarith [pi_lt_d4])
  have h3 : c / 1.7725 ≤ c / √π := div_le_div_of_nonneg_left hc hp hp2
  have h4 : c / √π ≤ (∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2))) / √π :=
    div_le_div_of_nonneg_right hint hp.le
  have h5 : (1 + 2 / √π * -∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2))) / 2 =
      2⁻¹ - (∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2))) / √π := by
    field_simp; ring
  rw [h5]
  linarith

/-- If $\Phi(-\sqrt2\,s)\le h\in(0,\frac12]$, $s\ge0$ and $e\le e^{-s^2}$, then
$I(h)\ge e/2.5067$. -/
theorem gProf_ge_of_gCDF_le (s hi e : ℝ) (hs : 0 ≤ s) (hhi0 : 0 < hi) (hhi : hi ≤ 2⁻¹)
    (hΦ : gCDF (-(√2 * s)) ≤ hi) (he : e ≤ Real.exp (-s ^ 2)) : gProf hi ≥ e / 2.5067 := by
  have hI : hi ∈ Ioo (0 : ℝ) 1 := ⟨hhi0, by linarith⟩
  rw [gProf_of_mem hI]
  have hle : -(√2 * s) ≤ gInv hi := (le_gInv_iff hI).2 hΦ
  have hle0 : gInv hi ≤ 0 := (gInv_le_iff hI).2 (by rw [gCDF_zero]; exact hhi)
  have h2s : 0 ≤ √2 * s := by positivity
  have hdens : gDens (√2 * s) ≤ gDens (gInv hi) := by
    rw [← gDens_neg (gInv hi)]
    exact gDens_antitoneOn (by simp only [mem_Ici]; linarith) (by simp only [mem_Ici]; linarith)
      (by linarith)
  rw [gDens_sqrt_two_mul] at hdens
  have hp : 0 < √2 * √π := by positivity
  have hp2 : √2 * √π ≤ 2.5067 := by
    rw [← sqrt_mul (by norm_num),
      show (2.5067 : ℝ) = √(2.5067 ^ 2) from (sqrt_sq (by norm_num)).symm]
    exact sqrt_le_sqrt (by linarith [pi_lt_d4])
  have hE : 0 < Real.exp (-s ^ 2) := exp_pos _
  have h3 : e / 2.5067 ≤ Real.exp (-s ^ 2) / 2.5067 :=
    div_le_div_of_nonneg_right he (by norm_num)
  have h4 : Real.exp (-s ^ 2) / 2.5067 ≤ Real.exp (-s ^ 2) / (√2 * √π) :=
    div_le_div_of_nonneg_left hE.le hp hp2
  rw [ge_iff_le]
  linarith

/-- Chord bound: if $0<h\le\frac12$, $v\le I(h)$ and $t\in[0,\frac12]$, then
$I(t)\ge v\min(1,t/h)$ (concavity of $I$ with $I(0)=0$, and monotonicity on $[0,\frac12]$). -/
theorem gProf_ge_chord (hi v t : ℝ) (hhi0 : 0 < hi) (hhi : hi ≤ 2⁻¹) (hv : v ≤ gProf hi)
    (ht0 : 0 ≤ t) (ht : t ≤ 2⁻¹) : gProf t ≥ v * min 1 (t / hi) := by
  rcases le_total t hi with hth | hth
  · have hm : min 1 (t / hi) = t / hi := min_eq_right ((div_le_one hhi0).2 hth)
    rw [hm]
    have hl0 : 0 ≤ t / hi := div_nonneg ht0 hhi0.le
    have hc := strictConcaveOn_gProf.concaveOn.2 (show (0 : ℝ) ∈ Icc 0 1 by simp)
      (show hi ∈ Icc (0 : ℝ) 1 from ⟨hhi0.le, by linarith⟩)
      (show 0 ≤ 1 - t / hi by linarith [(div_le_one hhi0).2 hth]) hl0
      (show 1 - t / hi + t / hi = 1 by ring)
    simp only [smul_eq_mul, mul_zero, zero_add, gProf_zero] at hc
    rw [div_mul_cancel₀ t hhi0.ne'] at hc
    rw [ge_iff_le, mul_comm]
    exact (mul_le_mul_of_nonneg_left hv hl0).trans hc
  · have hm : min 1 (t / hi) = 1 := min_eq_left ((one_le_div hhi0).2 hth)
    rw [hm, mul_one]
    exact hv.trans (gProf_strictMonoOn.monotoneOn ⟨hhi0.le, hhi⟩ ⟨ht0, ht⟩ hth)

/-- $J(1-x)\ge\sqrt2\cdot0.895\cdot I(x/0.896)$ for $x\in[0,\frac14]$. -/
theorem J_one_sub_ge_gProf (x : ℝ) (hx0 : 0 ≤ x) (hx : x ≤ 4⁻¹) :
    J (1 - x) ≥ √2 * 0.895 * gProf (x / 0.896) := by
  obtain ⟨hw1, hw2⟩ := w₀_mem
  have hw0 : 0 < w₀ := by linarith
  rw [J_one_sub_eq x hx0 (by linarith)]
  have hy1 : x / 0.896 ≤ w₀⁻¹ * x := by
    rw [← div_eq_inv_mul]; exact div_le_div_of_nonneg_left hx0 hw0 hw2
  have hy2 : w₀⁻¹ * x ≤ 2⁻¹ := by
    rw [← div_eq_inv_mul, div_le_iff₀ hw0]; linarith
  have hmono : gProf (x / 0.896) ≤ gProf (w₀⁻¹ * x) :=
    gProf_strictMonoOn.monotoneOn ⟨by positivity, hy1.trans hy2⟩
      ⟨(by positivity : (0 : ℝ) ≤ x / 0.896).trans hy1, hy2⟩ hy1
  have := gProf_nonneg (x / 0.896)
  rw [ge_iff_le]
  gcongr

/-- If $f'\ge0$ on $[0,\infty)$, then $f(0)\le f(v)$ for $v\ge0$. -/
theorem le_of_hasDerivAt_nonneg {f f' : ℝ → ℝ} (hf : ∀ x, HasDerivAt f (f' x) x)
    (hf' : ∀ x, 0 ≤ x → 0 ≤ f' x) (v : ℝ) (hv : 0 ≤ v) : f 0 ≤ f v := by
  have hm : MonotoneOn f (Ici 0) := by
    refine monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ici 0)
      (fun x _ ↦ (hf x).continuousAt.continuousWithinAt) (fun x _ ↦ (hf x).hasDerivWithinAt)
      fun x hx ↦ hf' x ?_
    rw [interior_Ici] at hx
    exact le_of_lt hx
  exact hm (mem_Ici.2 le_rfl) (mem_Ici.2 hv) hv

/-- $1-v+\frac{v^2}2-\frac{v^3}6\le e^{-v}$ for $v\ge0$. -/
theorem exp_neg_ge_cubic (v : ℝ) (hv : 0 ≤ v) : 1 - v + v ^ 2 / 2 - v ^ 3 / 6 ≤ Real.exp (-v) := by
  have hE : ∀ x : ℝ, HasDerivAt (fun x ↦ Real.exp (-x)) (-Real.exp (-x)) x := fun x ↦ by
    simpa using (hasDerivAt_neg x).exp
  have h2 : ∀ x : ℝ, 0 ≤ x → 0 ≤ 1 - x + x ^ 2 / 2 - Real.exp (-x) := by
    intro x hx
    have := le_of_hasDerivAt_nonneg (f := fun x ↦ 1 - x + x ^ 2 / 2 - Real.exp (-x))
      (f' := fun x ↦ -1 + x + Real.exp (-x)) (fun x ↦ by
        have := (((hasDerivAt_id x).const_sub 1).add ((hasDerivAt_pow 2 x).div_const 2)).sub
          (hE x)
        exact this.congr_deriv (by norm_num))
      (fun x _ ↦ by linarith [add_one_le_exp (-x)]) x hx
    simpa using this
  have := le_of_hasDerivAt_nonneg
    (f := fun x ↦ Real.exp (-x) - (1 - x + x ^ 2 / 2 - x ^ 3 / 6))
    (f' := fun x ↦ 1 - x + x ^ 2 / 2 - Real.exp (-x)) (fun x ↦ by
      have := (hE x).sub ((((hasDerivAt_id x).const_sub 1).add
        ((hasDerivAt_pow 2 x).div_const 2)).sub ((hasDerivAt_pow 3 x).div_const 6))
      exact this.congr_deriv (by norm_num; ring)) h2 v hv
  simp at this
  linarith

/-- $\int_0^se^{-u^2}\,du\ge s-\frac{s^3}3+\frac{s^5}{10}-\frac{s^7}{42}$ for $s\ge0$. -/
theorem integral_exp_neg_sq_ge (s : ℝ) (hs : 0 ≤ s) :
    s - s ^ 3 / 3 + s ^ 5 / 10 - s ^ 7 / 42 ≤ ∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2)) := by
  have hF : ∀ x ∈ uIcc (0 : ℝ) s, HasDerivAt (fun u : ℝ ↦ u - u ^ 3 / 3 + u ^ 5 / 10 - u ^ 7 / 42)
      (1 - x ^ 2 + (x ^ 2) ^ 2 / 2 - (x ^ 2) ^ 3 / 6) x := fun x _ ↦ by
    have := (((hasDerivAt_id x).sub ((hasDerivAt_pow 3 x).div_const 3)).add
      ((hasDerivAt_pow 5 x).div_const 10)).sub ((hasDerivAt_pow 7 x).div_const 42)
    exact this.congr_deriv (by norm_num; ring)
  have hcont : Continuous fun x : ℝ ↦ 1 - x ^ 2 + (x ^ 2) ^ 2 / 2 - (x ^ 2) ^ 3 / 6 := by
    fun_prop
  rw [show s - s ^ 3 / 3 + s ^ 5 / 10 - s ^ 7 / 42 =
      ∫ u in (0 : ℝ)..s, (1 - u ^ 2 + (u ^ 2) ^ 2 / 2 - (u ^ 2) ^ 3 / 6) by
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hF (hcont.intervalIntegrable _ _)]
    ring]
  exact intervalIntegral.integral_mono_on hs (hcont.intervalIntegrable _ _)
    ((continuous_exp.comp (by fun_prop)).intervalIntegrable _ _)
    fun u _ ↦ exp_neg_ge_cubic (u ^ 2) (sq_nonneg u)

/-! ### Alternating Taylor bounds for $e^{-v}$ and $\int_0^se^{-u^2}\,du$ -/

/-- The Taylor polynomial $T_n(v)=\sum_{k<n}(-v)^k/k!$ of $e^{-v}$. -/
noncomputable def expNegTaylor (n : ℕ) (v : ℝ) : ℝ :=
  ∑ k ∈ Finset.range n, (-v) ^ k / (k.factorial : ℝ)

/-- $T_{n+1}'=-T_n$. -/
theorem hasDerivAt_expNegTaylor (n : ℕ) (v : ℝ) :
    HasDerivAt (expNegTaylor (n + 1)) (-expNegTaylor n v) v := by
  induction n with
  | zero =>
    have h : expNegTaylor (0 + 1) = fun _ ↦ 1 := by funext x; simp [expNegTaylor]
    rw [h]
    exact (hasDerivAt_const v (1 : ℝ)).congr_deriv (by simp [expNegTaylor])
  | succ n ih =>
    have h : expNegTaylor (n + 1 + 1) =
        fun x ↦ expNegTaylor (n + 1) x + (-x) ^ (n + 1) / ((n + 1).factorial : ℝ) := by
      funext x; simp [expNegTaylor, Finset.sum_range_succ _ (n + 1)]
    rw [h]
    refine (ih.add (((hasDerivAt_neg v).pow (n + 1)).div_const _)).congr_deriv ?_
    simp only [expNegTaylor, Finset.sum_range_succ, Nat.factorial_succ, Nat.cast_mul,
      Nat.add_sub_cancel]
    have : (n.factorial : ℝ) ≠ 0 := by positivity
    field_simp
    ring

/-- $(-1)^n\bigl(e^{-v}-T_n(v)\bigr)\ge0$ for $v\ge0$ (alternating Taylor bounds). -/
theorem expNegTaylor_alt (n : ℕ) (v : ℝ) (hv : 0 ≤ v) :
    0 ≤ (-1) ^ n * (Real.exp (-v) - expNegTaylor n v) := by
  induction n generalizing v with
  | zero => simp [expNegTaylor, (exp_pos _).le]
  | succ n ih =>
    have hE : ∀ x : ℝ, HasDerivAt (fun x ↦ Real.exp (-x)) (-Real.exp (-x)) x := fun x ↦ by
      simpa using (hasDerivAt_neg x).exp
    have h := le_of_hasDerivAt_nonneg
      (f := fun x ↦ (-1) ^ (n + 1) * (Real.exp (-x) - expNegTaylor (n + 1) x))
      (f' := fun x ↦ (-1) ^ n * (Real.exp (-x) - expNegTaylor n x))
      (fun x ↦ (((hE x).sub (hasDerivAt_expNegTaylor n x)).const_mul _).congr_deriv
        (by ring)) ih v hv
    have h0 : expNegTaylor (n + 1) 0 = 1 := by
      simp [expNegTaylor, Finset.sum_range_succ']
    simpa [h0] using h

/-- Lower Taylor bound: $\sum_{k<2m+2}(-v)^k/k!\le e^{-v}$ for $v\ge0$. -/
theorem exp_neg_ge_taylor (m : ℕ) (v : ℝ) (hv : 0 ≤ v) :
    ∑ k ∈ Finset.range (2 * m + 2), (-v) ^ k / (k.factorial : ℝ) ≤ Real.exp (-v) := by
  have h := expNegTaylor_alt (2 * m + 2) v hv
  rw [Even.neg_one_pow ⟨m + 1, by ring⟩, one_mul, sub_nonneg] at h
  exact h

/-- Upper Taylor bound: $e^{-v}\le\sum_{k<2m+1}(-v)^k/k!$ for $v\ge0$. -/
theorem exp_neg_le_taylor (m : ℕ) (v : ℝ) (hv : 0 ≤ v) :
    Real.exp (-v) ≤ ∑ k ∈ Finset.range (2 * m + 1), (-v) ^ k / (k.factorial : ℝ) := by
  have h := expNegTaylor_alt (2 * m + 1) v hv
  rw [Odd.neg_one_pow ⟨m, rfl⟩, neg_one_mul, neg_nonneg, sub_nonpos] at h
  exact h

/-- $\int_0^sT_N(u^2)\,du=\sum_{k<N}(-1)^ks^{2k+1}/(k!\,(2k+1))$. -/
theorem integral_expNegTaylor_sq (N : ℕ) (s : ℝ) :
    ∫ u in (0 : ℝ)..s, expNegTaylor N (u ^ 2) =
      ∑ k ∈ Finset.range N, (-1) ^ k * s ^ (2 * k + 1) / ((k.factorial : ℝ) * (2 * k + 1)) := by
  have hF : ∀ x ∈ uIcc (0 : ℝ) s, HasDerivAt
      (fun u : ℝ ↦ ∑ k ∈ Finset.range N,
        (-1) ^ k * u ^ (2 * k + 1) / ((k.factorial : ℝ) * (2 * k + 1)))
      (expNegTaylor N (x ^ 2)) x := fun x _ ↦ by
    unfold expNegTaylor
    refine (HasDerivAt.fun_sum fun k _ ↦
      ((hasDerivAt_pow (2 * k + 1) x).const_mul ((-1 : ℝ) ^ k)).div_const
        ((k.factorial : ℝ) * (2 * k + 1))).congr_deriv (Finset.sum_congr rfl fun k _ ↦ ?_)
    have h1 : (k.factorial : ℝ) ≠ 0 := by positivity
    have h2 : (2 * k + 1 : ℝ) ≠ 0 := by positivity
    rw [neg_pow (x ^ 2), ← pow_mul, Nat.add_sub_cancel]
    field_simp
    push_cast
    ring
  have hcont : Continuous fun u : ℝ ↦ expNegTaylor N (u ^ 2) := by
    unfold expNegTaylor; fun_prop
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hF (hcont.intervalIntegrable _ _)]
  simp

/-- Lower series bound:
$\sum_{k<2m+2}(-1)^ks^{2k+1}/(k!\,(2k+1))\le\int_0^se^{-u^2}\,du$ for $s\ge0$. -/
theorem integral_exp_neg_sq_ge_taylor (m : ℕ) (s : ℝ) (hs : 0 ≤ s) :
    ∑ k ∈ Finset.range (2 * m + 2), (-1) ^ k * s ^ (2 * k + 1) / ((k.factorial : ℝ) * (2 * k + 1))
      ≤ ∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2)) := by
  rw [← integral_expNegTaylor_sq]
  exact intervalIntegral.integral_mono_on hs
    ((by unfold expNegTaylor; fun_prop : Continuous fun u : ℝ ↦
      expNegTaylor (2 * m + 2) (u ^ 2)).intervalIntegrable _ _)
    ((continuous_exp.comp (by fun_prop)).intervalIntegrable _ _)
    fun u _ ↦ exp_neg_ge_taylor m (u ^ 2) (sq_nonneg u)

/-- Upper series bound:
$\int_0^se^{-u^2}\,du\le\sum_{k<2m+1}(-1)^ks^{2k+1}/(k!\,(2k+1))$ for $s\ge0$. -/
theorem integral_exp_neg_sq_le_taylor (m : ℕ) (s : ℝ) (hs : 0 ≤ s) :
    ∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2)) ≤
      ∑ k ∈ Finset.range (2 * m + 1), (-1) ^ k * s ^ (2 * k + 1) /
        ((k.factorial : ℝ) * (2 * k + 1)) := by
  rw [← integral_expNegTaylor_sq]
  exact intervalIntegral.integral_mono_on hs
    ((continuous_exp.comp (by fun_prop)).intervalIntegrable _ _)
    ((by unfold expNegTaylor; fun_prop : Continuous fun u : ℝ ↦
      expNegTaylor (2 * m + 1) (u ^ 2)).intervalIntegrable _ _)
    fun u _ ↦ exp_neg_le_taylor m (u ^ 2) (sq_nonneg u)

/-! ### Partition₁ ([DIR], §4.1) -/

/-- Covering by consecutive pieces: if a property holds on each $[p_i,p_{i+1}]$, $i\le n$, then
it holds on $[p_0,p_{n+1}]$. -/
theorem partition_cover_aux (p : ℕ → ℝ) (P : ℝ → Prop) (n : ℕ)
    (h : ∀ i ≤ n, ∀ x ∈ Icc (p i) (p (i + 1)), P x) : ∀ x ∈ Icc (p 0) (p (n + 1)), P x := by
  induction n with
  | zero => exact h 0 le_rfl
  | succ n ih =>
    intro x hx
    by_cases hxn : x ≤ p (n + 1)
    · exact ih (fun i hi ↦ h i (by omega)) x ⟨hx.1, hxn⟩
    · exact h (n + 1) le_rfl x ⟨(not_le.1 hxn).le, hx.2⟩

/-- Covering by consecutive pieces: if a property holds on each $[p_i,p_{i+1}]$, $i<n$, $n>0$,
then it holds on $[p_0,p_n]$. (No monotonicity of $p$ is needed.) -/
theorem partition_cover (p : ℕ → ℝ) (P : ℝ → Prop) (n : ℕ) (hn : 0 < n)
    (h : ∀ i < n, ∀ x ∈ Icc (p i) (p (i + 1)), P x) : ∀ x ∈ Icc (p 0) (p n), P x := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  exact partition_cover_aux p P m fun i hi ↦ h i (by omega)

/-- Soundness of Partition₁ ([DIR], §4.1): let $p_0,\dots,p_n$ ($n>0$) be a partition and $g$ a
lower bound function, i.e. $g(p_i,p_{i+1})\le F(x)$ for $x\in[p_i,p_{i+1}]$. If
$g(p_i,p_{i+1})>0$ for all $i<n$, then $F>0$ on $[p_0,p_n]$. -/
theorem partition_one (g : ℝ → ℝ → ℝ) (F : ℝ → ℝ) (p : ℕ → ℝ) (n : ℕ) (hn : 0 < n)
    (hg : ∀ i < n, 0 < g (p i) (p (i + 1)))
    (hF : ∀ i < n, ∀ x ∈ Icc (p i) (p (i + 1)), g (p i) (p (i + 1)) ≤ F x) :
    ∀ x ∈ Icc (p 0) (p n), 0 < F x :=
  partition_cover p (fun x ↦ 0 < F x) n hn fun i hi x hx ↦ (hg i hi).trans_le (hF i hi x hx)

/-! ### The paper's lower bound $g_{P,2}$ for (7.3) -/

/-- The lower bound function of [DIR], §7, Case II (proof of (7.3)):
$g_{P,2}(\underline x,\overline x)=2^{-2\beta_0}\bigl(L_{1/2}(\underline x)+J(1-\underline x)\bigr)
-2\overline x(1-\underline x)$. -/
noncomputable def g_P_2_lo (xl xu : ℝ) : ℝ :=
  2 ^ (-(2 * β₀)) * (L 2⁻¹ xl + J (1 - xl)) - 2 * xu * (1 - xl)

/-- $L_{1/2}(x)=\sqrt{-x^2\log x/\log2}$ for $x>0$. -/
theorem L_half_eq (x : ℝ) (hx : 0 < x) :
    L 2⁻¹ x = √(-(x ^ 2 * Real.log x) / Real.log 2) := by
  rw [L, show (2⁻¹ : ℝ) = 1 / 2 by norm_num, ← sqrt_eq_rpow, logb, Real.log_inv,
    show -(x ^ 2 * Real.log x) / Real.log 2 = x ^ 2 * (-Real.log x / Real.log 2) by ring,
    sqrt_mul (sq_nonneg x), sqrt_sq hx.le]

/-- $L_{1/2}$ is monotone on $(0,\frac14]$ ($x^2\log(1/x)$ is increasing for $x<e^{-1/2}$). -/
theorem L_half_monotoneOn : MonotoneOn (L 2⁻¹) (Ioc 0 4⁻¹) := by
  have hd : ∀ x : ℝ, x ≠ 0 → HasDerivAt (fun x : ℝ ↦ -(x ^ 2 * Real.log x))
      (-((2 : ℕ) * x ^ (2 - 1) * Real.log x + x ^ 2 * x⁻¹)) x := fun x hx ↦
    ((hasDerivAt_pow 2 x).mul (hasDerivAt_log hx)).neg
  have hl4 : Real.log 4⁻¹ ≤ -2⁻¹ := by
    rw [Real.log_inv, show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]
    linarith [log_two_gt_d9]
  have hg : MonotoneOn (fun x : ℝ ↦ -(x ^ 2 * Real.log x)) (Ioc 0 4⁻¹) := by
    refine monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ioc 0 4⁻¹)
      (f' := fun x ↦ -((2 : ℕ) * x ^ (2 - 1) * Real.log x + x ^ 2 * x⁻¹))
      (fun x hx ↦ (hd x hx.1.ne').continuousAt.continuousWithinAt)
      (fun x hx ↦ ?_) (fun x hx ↦ ?_)
    · rw [interior_Ioc] at hx
      exact (hd x hx.1.ne').hasDerivWithinAt
    · rw [interior_Ioc] at hx
      have hx0 := hx.1
      have hlx : Real.log x ≤ -2⁻¹ := (Real.log_le_log hx0 hx.2.le).trans hl4
      have : x ^ 2 * x⁻¹ = x := by field_simp
      rw [this]
      push_cast
      nlinarith
  intro x hx y hy hxy
  have hl2 : 0 < Real.log 2 := log_pos (by norm_num)
  rw [L_half_eq x hx.1, L_half_eq y hy.1]
  exact sqrt_le_sqrt (div_le_div_of_nonneg_right (hg hx hy hxy) hl2.le)

/-- $x\mapsto J(1-x)$ is monotone on $[0,\frac14]$. -/
theorem J_one_sub_mono (x y : ℝ) (hx0 : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 4⁻¹) :
    J (1 - x) ≤ J (1 - y) := by
  obtain ⟨hw1, hw2⟩ := w₀_mem
  have hw0 : 0 < w₀ := by linarith
  rw [J_one_sub_eq x hx0 (by linarith), J_one_sub_eq y (by linarith) (by linarith)]
  have hy2 : w₀⁻¹ * y ≤ 2⁻¹ := by
    rw [← div_eq_inv_mul, div_le_iff₀ hw0]; linarith
  have hwi : 0 ≤ w₀⁻¹ := inv_nonneg.2 hw0.le
  have hxy' : w₀⁻¹ * x ≤ w₀⁻¹ * y := mul_le_mul_of_nonneg_left hxy hwi
  have := gProf_strictMonoOn.monotoneOn ⟨mul_nonneg hwi hx0, hxy'.trans hy2⟩
    ⟨mul_nonneg hwi (hx0.trans hxy), hy2⟩ hxy'
  gcongr

/-- [DIR], §7, Case II: $g_{P,2}(\underline x,\overline x)$ is a lower bound for
$G_{P,\beta}(x)=2^{-2\beta}(b_\beta(x)+b_\beta(1-x))-x^{2\beta}(1-x)-x(1-x)^{2\beta}$ for
$x\in[\underline x,\overline x]\subseteq[\frac1{64},\frac14]$ and $\beta\in[\frac12,\beta_0]$. -/
theorem G_P_formula_ge_g_P_2_lo (β xl xu x : ℝ) (hβ : β ∈ Icc 2⁻¹ β₀) (hxl : 64⁻¹ ≤ xl)
    (hx : x ∈ Icc xl xu) (hxu : xu ≤ 4⁻¹) :
    2 ^ (-(2 * β)) * (b β x + b β (1 - x)) - x ^ (2 * β) * (1 - x) - x * (1 - x) ^ (2 * β) ≥
      g_P_2_lo xl xu := by
  obtain ⟨hβ1, hβ2⟩ := hβ
  obtain ⟨hx1, hx2⟩ := hx
  have hxl0 : 0 < xl := by linarith
  have hx0 : 0 < x := by linarith
  have hx4 : x ≤ 4⁻¹ := hx2.trans hxu
  have hbx : b β x = L β x := by rw [b, ite_eq_left hx4]
  have hb1 : b β (1 - x) = J (1 - x) := by
    rw [b, ite_eq_right (by linarith), ite_eq_right (by linarith)]
  rw [hbx, hb1, g_P_2_lo]
  have hlog : 1 ≤ logb 2 x⁻¹ := by
    rw [le_logb_iff_rpow_le (by norm_num) (by positivity), rpow_one,
      le_inv_comm₀ (by norm_num) hx0]
    linarith
  have hLβ : L 2⁻¹ x ≤ L β x :=
    mul_le_mul_of_nonneg_left (rpow_le_rpow_of_exponent_le hlog hβ1) hx0.le
  have hLx : L 2⁻¹ xl ≤ L 2⁻¹ x := L_half_monotoneOn ⟨hxl0, by linarith⟩ ⟨hx0, hx4⟩ hx1
  have hL0 : 0 ≤ L 2⁻¹ xl := by rw [L_half_eq xl hxl0]; exact sqrt_nonneg _
  have hJ : J (1 - xl) ≤ J (1 - x) := J_one_sub_mono xl x hxl0.le hx1 hx4
  have hJ0 := J_one_sub_nonneg xl hxl0.le (by linarith)
  have hp : (2 : ℝ) ^ (-(2 * β₀)) ≤ 2 ^ (-(2 * β)) :=
    rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
  have hxp : x ^ (2 * β) ≤ x := by
    simpa using rpow_le_rpow_of_exponent_ge hx0 (by linarith) (by linarith : (1 : ℝ) ≤ 2 * β)
  have hyp : (1 - x) ^ (2 * β) ≤ 1 - x := by
    simpa using rpow_le_rpow_of_exponent_ge (by linarith : (0 : ℝ) < 1 - x) (by linarith)
      (by linarith : (1 : ℝ) ≤ 2 * β)
  have hS : L 2⁻¹ xl + J (1 - xl) ≤ L β x + J (1 - x) := by linarith
  have hS0 : 0 ≤ L 2⁻¹ xl + J (1 - xl) := by positivity
  have hA : 2 ^ (-(2 * β₀)) * (L 2⁻¹ xl + J (1 - xl)) ≤ 2 ^ (-(2 * β)) * (L β x + J (1 - x)) :=
    mul_le_mul hp hS hS0 (by positivity)
  have hB : x ^ (2 * β) * (1 - x) ≤ x * (1 - x) :=
    mul_le_mul_of_nonneg_right hxp (by linarith)
  have hC : x * (1 - x) ^ (2 * β) ≤ x * (1 - x) := mul_le_mul_of_nonneg_left hyp hx0.le
  have hD : x * (1 - x) ≤ xu * (1 - xl) :=
    mul_le_mul hx2 (by linarith) (by linarith) (by linarith)
  linarith

/-! ### Pointwise lower bound for $J(1-a)$ with a $w_0$ enclosure -/

/-- $\Phi(-\sqrt2\,s)=\frac12-\frac1{\sqrt\pi}\int_0^se^{-u^2}\,du$. -/
theorem gCDF_neg_eq (s : ℝ) :
    gCDF (-(√2 * s)) = 2⁻¹ - (∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2))) / √π := by
  have h2 : (√2 : ℝ) ≠ 0 := by positivity
  rw [gCDF_eq_erf, neg_div, mul_div_cancel_left₀ _ h2, LeanCert.Core.Real.erf,
    integral_exp_neg_sq_neg]
  field_simp
  ring

/-- $\Phi(\sqrt2\,s)=\frac12+\frac1{\sqrt\pi}\int_0^se^{-u^2}\,du$. -/
theorem gCDF_sqrt_two_mul (s : ℝ) :
    gCDF (√2 * s) = 2⁻¹ + (∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2))) / √π := by
  have h2 : (√2 : ℝ) ≠ 0 := by positivity
  rw [gCDF_eq_erf, mul_div_cancel_left₀ _ h2, LeanCert.Core.Real.erf]
  field_simp

/-- $\varphi(\sqrt2\,s)=e^{-s^2}/\sqrt{2\pi}$. -/
theorem gDens_sqrt_two_mul' (s : ℝ) : gDens (√2 * s) = Real.exp (-s ^ 2) / √(2 * π) := by
  rw [gDens_eq, mul_pow, sq_sqrt (by norm_num : (0 : ℝ) ≤ 2),
    show -(2 * s ^ 2) / 2 = -s ^ 2 by ring]

/-- Pointwise lower bound for $J(1-a)$, given an enclosure $w_0\in[w_l,w_u]$: if $s\ge0$,
$0\le c\le\int_0^se^{-u^2}\,du$, $e\le e^{-s^2}$, $\sqrt\pi\le r_1$, $\sqrt{2\pi}\le r_2$,
$a/w_l\le\frac12$ and $\frac12-c/r_1\le a/w_u$, then $J(1-a)\ge\sqrt2\,w_l\,e/r_2$.
(Via $J(1-a)=\sqrt2\,w_0\,I(a/w_0)$, $I(a/w_0)\ge I(a/w_u)$ and
$\Phi(-\sqrt2 s)\le a/w_u$, so $I(a/w_u)\ge\varphi(\sqrt2s)=e^{-s^2}/\sqrt{2\pi}$.) -/
theorem J_one_sub_ge_point (wl wu a s c e r1 r2 : ℝ) (hw : w₀ ∈ Icc wl wu) (hwl : 0 < wl)
    (ha : 0 < a) (haw : a / wl ≤ 2⁻¹) (hs : 0 ≤ s)
    (hc : c ≤ ∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2))) (hc0 : 0 ≤ c)
    (he : e ≤ Real.exp (-s ^ 2)) (hr1 : √π ≤ r1) (hr2 : √(2 * π) ≤ r2)
    (hΦ : 2⁻¹ - c / r1 ≤ a / wu) : J (1 - a) ≥ √2 * wl * (e / r2) := by
  obtain ⟨hw1, hw2⟩ := hw
  have hw0 : 0 < w₀ := hwl.trans_le hw1
  have hwu : 0 < wu := hw0.trans_le hw2
  have hawl : a ≤ 2⁻¹ * wl := by rwa [div_le_iff₀ hwl] at haw
  rw [J_one_sub_eq a ha.le (by linarith [w₀_mem.2])]
  have hy1 : a / wu ≤ w₀⁻¹ * a := by
    rw [← div_eq_inv_mul]; exact div_le_div_of_nonneg_left ha.le hw0 hw2
  have hy2 : w₀⁻¹ * a ≤ 2⁻¹ := by
    rw [← div_eq_inv_mul]; exact (div_le_div_of_nonneg_left ha.le hwl hw1).trans haw
  have hh0 : 0 < a / wu := div_pos ha hwu
  have hI : a / wu ∈ Ioo (0 : ℝ) 1 := ⟨hh0, by linarith⟩
  have hmono : gProf (a / wu) ≤ gProf (w₀⁻¹ * a) :=
    gProf_strictMonoOn.monotoneOn ⟨hh0.le, hy1.trans hy2⟩ ⟨hh0.le.trans hy1, hy2⟩ hy1
  have hp : 0 < √π := sqrt_pos.2 pi_pos
  have hΦ' : gCDF (-(√2 * s)) ≤ a / wu := by
    rw [gCDF_neg_eq]
    have h1 : c / r1 ≤ c / √π := div_le_div_of_nonneg_left hc0 hp hr1
    have h2 : c / √π ≤ (∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2))) / √π :=
      div_le_div_of_nonneg_right hc hp.le
    linarith
  have hle : -(√2 * s) ≤ gInv (a / wu) := (le_gInv_iff hI).2 hΦ'
  have hle0 : gInv (a / wu) ≤ 0 := (gInv_le_iff hI).2 (by rw [gCDF_zero]; linarith)
  have h2s : 0 ≤ √2 * s := by positivity
  have hdens : gDens (√2 * s) ≤ gProf (a / wu) := by
    rw [gProf_of_mem hI, ← gDens_neg (gInv (a / wu))]
    exact gDens_antitoneOn (by simp only [mem_Ici]; linarith) (by simp only [mem_Ici]; linarith)
      (by linarith)
  rw [gDens_sqrt_two_mul'] at hdens
  have hq : 0 < √(2 * π) := sqrt_pos.2 (by positivity)
  have hr20 : 0 < r2 := hq.trans_le hr2
  have hE := exp_pos (-s ^ 2)
  have h3 : e / r2 ≤ Real.exp (-s ^ 2) / r2 := div_le_div_of_nonneg_right he hr20.le
  have h4 : Real.exp (-s ^ 2) / r2 ≤ Real.exp (-s ^ 2) / √(2 * π) :=
    div_le_div_of_nonneg_left hE.le hq hr2
  have hG : e / r2 ≤ gProf (w₀⁻¹ * a) := by linarith
  have hG0 : 0 ≤ gProf (w₀⁻¹ * a) := gProf_nonneg _
  rw [ge_iff_le]
  calc √2 * wl * (e / r2) ≤ √2 * wl * gProf (w₀⁻¹ * a) :=
        mul_le_mul_of_nonneg_left hG (by positivity)
    _ ≤ √2 * w₀ * gProf (w₀⁻¹ * a) := by gcongr

/-! ### A finer enclosure of $w_0$ -/

/-- Upper bound for $J_w(\frac12)$: if $w>\frac12$, $s\ge0$ and $\Phi(\sqrt2 s)\le\frac1{2w}$,
then $J_w(\frac12)\le w\,e^{-s^2}/\sqrt\pi$. -/
theorem gJw_half_le_of (w s : ℝ) (hw : 2⁻¹ < w) (hs : 0 ≤ s)
    (hcdf : gCDF (√2 * s) ≤ w⁻¹ * (1 - 2⁻¹)) : gJw w 2⁻¹ ≤ w * Real.exp (-s ^ 2) / √π := by
  have hw0 : 0 < w := by linarith
  have huI : w⁻¹ * (1 - 2⁻¹) ∈ Ioo (0 : ℝ) 1 := by
    refine ⟨by positivity, ?_⟩
    rw [← div_eq_inv_mul, div_lt_one hw0]; linarith
  have hle : √2 * s ≤ gInv (w⁻¹ * (1 - 2⁻¹)) := (le_gInv_iff huI).2 hcdf
  have h2s : 0 ≤ √2 * s := by positivity
  have hd : gDens (gInv (w⁻¹ * (1 - 2⁻¹))) ≤ gDens (√2 * s) :=
    gDens_antitoneOn (mem_Ici.2 h2s) (mem_Ici.2 (h2s.trans hle)) hle
  rw [← gProf_of_mem huI, gDens_sqrt_two_mul] at hd
  unfold gJw
  have h2 : (0 : ℝ) < √2 := by positivity
  calc √2 * w * gProf (w⁻¹ * (1 - 2⁻¹)) ≤ √2 * w * (Real.exp (-s ^ 2) / (√2 * √π)) := by
        gcongr
    _ = w * Real.exp (-s ^ 2) / √π := by field_simp

/-- Lower bound for $J_w(\frac12)$: if $\frac12<w<1$ and $\frac1{2w}\le\Phi(\sqrt2 s)$,
then $w\,e^{-s^2}/\sqrt\pi\le J_w(\frac12)$. -/
theorem le_gJw_half_of (w s : ℝ) (hw : 2⁻¹ < w) (hw1 : w < 1)
    (hcdf : w⁻¹ * (1 - 2⁻¹) ≤ gCDF (√2 * s)) : w * Real.exp (-s ^ 2) / √π ≤ gJw w 2⁻¹ := by
  have hw0 : 0 < w := by linarith
  have huI : w⁻¹ * (1 - 2⁻¹) ∈ Ioo (2⁻¹ : ℝ) 1 := by
    rw [← div_eq_inv_mul]
    constructor
    · rw [lt_div_iff₀ hw0]; nlinarith
    · rw [div_lt_one hw0]; linarith
  have huI' : w⁻¹ * (1 - 2⁻¹) ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [huI.1], huI.2⟩
  have hle : gInv (w⁻¹ * (1 - 2⁻¹)) ≤ √2 * s := (gInv_le_iff huI').2 hcdf
  have h0 : 0 ≤ gInv (w⁻¹ * (1 - 2⁻¹)) := (gInv_pos huI).le
  have hd : gDens (√2 * s) ≤ gDens (gInv (w⁻¹ * (1 - 2⁻¹))) :=
    gDens_antitoneOn (mem_Ici.2 h0) (mem_Ici.2 (h0.trans hle)) hle
  rw [← gProf_of_mem huI', gDens_sqrt_two_mul] at hd
  unfold gJw
  have h2 : (0 : ℝ) < √2 := by positivity
  calc w * Real.exp (-s ^ 2) / √π = √2 * w * (Real.exp (-s ^ 2) / (√2 * √π)) := by
        field_simp
    _ ≤ √2 * w * gProf (w⁻¹ * (1 - 2⁻¹)) := by gcongr

/-- Numerical bounds $1.772453<\sqrt\pi<1.772454$. -/
theorem sqrt_pi_bounds : 1.772453 < √π ∧ √π < 1.772454 := by
  constructor
  · rw [Real.lt_sqrt (by norm_num)]; nlinarith [pi_gt_d6]
  · rw [Real.sqrt_lt' (by norm_num)]; nlinarith [pi_lt_d6]

/-- Numerical bound: $J_{0.8957}(\frac12)\le\frac12$ (with $s=0.10356$). -/
theorem gJw_8957_le : gJw 0.8957 2⁻¹ ≤ 2⁻¹ := by
  obtain ⟨hp1, -⟩ := sqrt_pi_bounds
  have hp : 0 < √π := by linarith
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = 0.10356 := ⟨_, rfl⟩
  have hs0 : 0 ≤ s := by rw [hs]; norm_num
  have hI := integral_exp_neg_sq_le_taylor 1 s hs0
  have hE := exp_neg_le_taylor 1 (s ^ 2) (sq_nonneg s)
  set Iu := ∑ k ∈ Finset.range (2 * 1 + 1),
    (-1) ^ k * s ^ (2 * k + 1) / ((k.factorial : ℝ) * (2 * k + 1)) with hIu
  set Eu := ∑ k ∈ Finset.range (2 * 1 + 1), (-(s ^ 2)) ^ k / (k.factorial : ℝ) with hEu
  have hIu0 : 0 ≤ Iu := by rw [hIu, hs]; norm_num [Finset.sum_range_succ, Nat.factorial]
  have hn1 : (2⁻¹ : ℝ) + Iu / 1.772453 ≤ (0.8957 : ℝ)⁻¹ * (1 - 2⁻¹) := by
    rw [hIu, hs]; norm_num [Finset.sum_range_succ, Nat.factorial]
  have hn2 : (0.8957 : ℝ) * Eu / 1.772453 ≤ 2⁻¹ := by
    rw [hEu, hs]; norm_num [Finset.sum_range_succ, Nat.factorial]
  have hcdf : gCDF (√2 * s) ≤ (0.8957 : ℝ)⁻¹ * (1 - 2⁻¹) := by
    rw [gCDF_sqrt_two_mul]
    have h1 : (∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2))) / √π ≤ Iu / √π :=
      div_le_div_of_nonneg_right hI hp.le
    have h2 : Iu / √π ≤ Iu / 1.772453 := div_le_div_of_nonneg_left hIu0 (by norm_num) hp1.le
    linarith
  have hJ := gJw_half_le_of 0.8957 s (by norm_num) hs0 hcdf
  have hEu0 : 0 ≤ Eu := (exp_pos _).le.trans hE
  have h1 : (0.8957 : ℝ) * Real.exp (-s ^ 2) / √π ≤ 0.8957 * Eu / √π := by gcongr
  have h2 : (0.8957 : ℝ) * Eu / √π ≤ 0.8957 * Eu / 1.772453 :=
    div_le_div_of_nonneg_left (by positivity) (by norm_num) hp1.le
  linarith

/-- Numerical bound: $\frac12\le J_{0.8958}(\frac12)$ (with $s=0.10346$). -/
theorem gJw_8958_ge : 2⁻¹ ≤ gJw 0.8958 2⁻¹ := by
  obtain ⟨-, hp2⟩ := sqrt_pi_bounds
  have hp : 0 < √π := sqrt_pos.2 pi_pos
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = 0.10346 := ⟨_, rfl⟩
  have hs0 : 0 ≤ s := by rw [hs]; norm_num
  have hI := integral_exp_neg_sq_ge_taylor 1 s hs0
  have hE := exp_neg_ge_taylor 1 (s ^ 2) (sq_nonneg s)
  set Il := ∑ k ∈ Finset.range (2 * 1 + 2),
    (-1) ^ k * s ^ (2 * k + 1) / ((k.factorial : ℝ) * (2 * k + 1)) with hIl
  set El := ∑ k ∈ Finset.range (2 * 1 + 2), (-(s ^ 2)) ^ k / (k.factorial : ℝ) with hEl
  have hIl0 : 0 ≤ Il := by rw [hIl, hs]; norm_num [Finset.sum_range_succ, Nat.factorial]
  have hEl0 : 0 ≤ El := by rw [hEl, hs]; norm_num [Finset.sum_range_succ, Nat.factorial]
  have hn1 : (0.8958 : ℝ)⁻¹ * (1 - 2⁻¹) ≤ 2⁻¹ + Il / 1.772454 := by
    rw [hIl, hs]; norm_num [Finset.sum_range_succ, Nat.factorial]
  have hn2 : (2⁻¹ : ℝ) ≤ 0.8958 * El / 1.772454 := by
    rw [hEl, hs]; norm_num [Finset.sum_range_succ, Nat.factorial]
  have hcdf : (0.8958 : ℝ)⁻¹ * (1 - 2⁻¹) ≤ gCDF (√2 * s) := by
    rw [gCDF_sqrt_two_mul]
    have h1 : Il / √π ≤ (∫ u in (0 : ℝ)..s, Real.exp (-(u ^ 2))) / √π :=
      div_le_div_of_nonneg_right hI hp.le
    have h2 : Il / 1.772454 ≤ Il / √π := div_le_div_of_nonneg_left hIl0 hp hp2.le
    linarith
  have hJ := le_gJw_half_of 0.8958 s (by norm_num) (by norm_num) hcdf
  have h1 : (0.8958 : ℝ) * El / √π ≤ 0.8958 * Real.exp (-s ^ 2) / √π := by gcongr
  have h2 : (0.8958 : ℝ) * El / 1.772454 ≤ 0.8958 * El / √π :=
    div_le_div_of_nonneg_left (by positivity) hp hp2.le
  linarith

/-- [DIR], §3: the finer enclosure $w_0\in[0.8957,0.8958]$ (same argument as `w₀_mem`:
$w\mapsto J_w(\frac12)$ is strictly increasing, with numerical bounds at the endpoints). -/
theorem w₀_mem_fine : w₀ ∈ Icc (0.8957 : ℝ) 0.8958 := by
