  rw [deriv_L_eq hx, L1f, show (-1 : ℝ) + 2⁻¹ = -2⁻¹ by norm_num, rpow_neg hl.le,
    rpow_neg hu.le, hs, hs, sqrt_mul hl.le]
  have : 0 < √(log 2) := sqrt_pos.2 hl
  have : 0 < √(log x⁻¹) := sqrt_pos.2 hu
  field_simp
  ring

