/-- The paper's tight lower bound $\underline{h_{LJQ,2}}(\underline y,\overline y)$ of
$G_{LJQ}(\frac1{16},y)$ ([DIRX], §3.3), with $L(\frac1{16})=\frac18$. -/
noncomputable def h37lo (yl yu : ℝ) : ℝ :=
  yl - 16⁻¹ + (√2 - 1) * min (JX yl) (JX yu) + 8⁻¹ - 2 * Q 2⁻¹ (32⁻¹ + yu / 2)

/-- `h37lo` as an expression (environment `[cJhalf, cSqrt2, J_{w_1}(y_l), J_{w_1}(y_u)]`). -/
def ex37 (yl yu : ℚ) : Ex :=
  .sub (.add (.const (yl - 1 / 16 + 1 / 8)) (.mul (.sub (.var 1) (.const 1)) (.min (exJ 2) (exJ 3))))
    (.mul (.const 2) (exQh (1 / 32 + yu / 2)))

/-- `ex37` denotes `h37lo`. -/
theorem denote_ex37 (jl ju : JwPt) (yl yu : ℚ) (hl : jl.y = yl) (hu : ju.y = yu) :
    denote (Cert.val [cJhalf, cSqrt2, jl.cert, ju.cert]) (ex37 yl yu) = h37lo yl yu := by
  subst hl hu
  have h0 : Cert.val [cJhalf, cSqrt2, jl.cert, ju.cert] 0 = gJw w₁ 2⁻¹ := rfl
  have h1 : Cert.val [cJhalf, cSqrt2, jl.cert, ju.cert] 1 = √2 := rfl
  have h2 : Cert.val [cJhalf, cSqrt2, jl.cert, ju.cert] 2 = gJw w₁ jl.y := rfl
  have h3 : Cert.val [cJhalf, cSqrt2, jl.cert, ju.cert] 3 = gJw w₁ ju.y := rfl
  simp only [ex37, denote, denote_exJ h0 h2, denote_exJ h0 h3, denote_exQh h1, h37lo, h1]
  push_cast; ring_nf

/-- An interval certificate of (3.7). -/
theorem box37 (jl ju : JwPt) (yl yu : ℚ) (hl : jl.y = yl) (hu : ju.y = yu)
    (h : check P11 (Cert.env [cJhalf, cSqrt2, jl.cert, ju.cert]) (ex37 yl yu) (1 / 10000) = true) :
    (1 / 10000 : ℝ) < h37lo yl yu := by
  have := check_sound P11 hw11 _ _ _ h
  rw [denote_ex37 jl ju yl yu hl hu] at this
  norm_num at this ⊢; exact this

/-- $L(\frac1{16})=\frac18$. -/
theorem L_half_sixteenth : L 2⁻¹ 16⁻¹ = 8⁻¹ := by
  rw [Auto.DIR.L, inv_inv, show (16 : ℝ) = 2 ^ (4 : ℝ) by norm_num, logb_rpow two_pos (by norm_num),
    show (4 : ℝ) = 2 ^ (2 : ℝ) by norm_num, ← rpow_mul (by norm_num)]
  norm_num

/-- The lower bound property of `h37lo` (monotonicity of $Q$, concavity of $\mathrm J$). -/
theorem h37lo_le {yl yu y : ℝ} (hyl : 2⁻¹ ≤ yl) (hyu : yu ≤ 3 / 4) (hy : y ∈ Icc yl yu) :
    h37lo yl yu ≤ y - 16⁻¹ + (√2 - 1) * JX y + L 2⁻¹ 16⁻¹ - 2 * Q 2⁻¹ ((16⁻¹ + y) / 2) := by
  have hβ := mem_Ico_of_caseQ (Or.inl rfl : (2⁻¹ : ℝ) = 2⁻¹ ∨ (2⁻¹ : ℝ) = β₀)
  have hJ := JX_concave.1.min_le_of_mem_Icc (⟨hyl, by linarith [hy.1, hy.2]⟩ : yl ∈ Icc (2⁻¹ : ℝ) 1)
    (⟨by linarith [hy.1, hy.2], by linarith⟩ : yu ∈ Icc (2⁻¹ : ℝ) 1) hy
  have hQ := Q_monotoneOn hβ (⟨by linarith [hy.1], by linarith [hy.2]⟩ :
    (16⁻¹ + y) / 2 ∈ Icc (0 : ℝ) 2⁻¹) (⟨by linarith [hy.1, hy.2], by linarith⟩ :
    32⁻¹ + yu / 2 ∈ Icc (0 : ℝ) 2⁻¹) (by linarith [hy.2])
  have hs : 0 ≤ √2 - 1 := by linarith [sqrt_two_mem.1]
  rw [h37lo, L_half_sixteenth]
  nlinarith [mul_le_mul_of_nonneg_left hJ hs, hy.1]

