namespace Auto.DIRX

open Auto.DIR

open Real Set

local notation "J" => JX

local notation "γ" => γX

/-- $G_1[B](x,y)=\sqrt{(y-x)^2+B(y)^2}+B(x)-2B(\frac{x+y}2)$ for $\beta=\frac12$. -/
theorem G₁_half_eq (B : ℝ → ℝ) (x y : ℝ) :
    Auto.DIR.G₁ 2⁻¹ B x y = √((y - x) ^ 2 + B y ^ 2) + B x - 2 * B ((x + y) / 2) := by
  have hs : ∀ a : ℝ, a ^ (2⁻¹ : ℝ) = √a := fun a ↦ by rw [sqrt_eq_rpow]; norm_num
  simp only [Auto.DIR.G₁, inv_inv, rpow_two, hs]

/-- $B_{w_1}=Q$ on $[\frac14,\frac12]$. -/
theorem BX_eq_Q {t : ℝ} (ht : t ∈ Icc (4⁻¹ : ℝ) 2⁻¹) : BX w₁ t = Q 2⁻¹ t := by
  have hβ := mem_Ico_of_caseQ (Or.inl rfl : (2⁻¹ : ℝ) = 2⁻¹ ∨ (2⁻¹ : ℝ) = β₀)
  rw [BX_eq_max w₁ t ⟨by linarith [ht.1], ht.2⟩]
  exact max_eq_right ((lemma_5_9 2⁻¹ ⟨hβ.1, hβ.2.le⟩).2 t ht)

/-- $R\le\sqrt A$ if $R\le0$ or $R^2\le A$ (and $A\ge0$). -/
theorem le_sqrt_of_sq {A R : ℝ} (h : R ≤ 0 ∨ R ^ 2 ≤ A) : R ≤ √A := by
  rcases le_total R 0 with hR | hR
  · exact hR.trans (sqrt_nonneg _)
  · rcases h with h | h
    · exact (le_antisymm h hR) ▸ sqrt_nonneg _
    · exact (Real.le_sqrt hR (le_trans (sq_nonneg R) h)).2 h

/-! ### Monotonicity facts for $\underline{h_{QJQ,1}}$ -/

/-- $Q_{1/2}'$ is antitone on $[0,\infty)$: $Q'(a)\le Q'(b)$ for $0\le b\le a$. -/
theorem deriv_Q_half_anti {a b : ℝ} (hb : 0 ≤ b) (hab : b ≤ a) :
    deriv (Q 2⁻¹) a ≤ deriv (Q 2⁻¹) b := by
  rw [deriv_Q_eq, Q1f_eq_affine, Q1f_eq_affine, two_rpow_half]
  have hs := sqrt_two_mem
  have k : (20 - 16 * √2) + (a + b) * (16 * √2 - 24) ≤ 0 := by
    nlinarith [hs.1, mul_nonneg (add_nonneg hb (hb.trans hab)) (by linarith [hs.2] : 0 ≤ 24 - 16 * √2)]
  have e : (-2 + 20 * a - 24 * a ^ 2 + (8 / 3 - 16 * a + 16 * a ^ 2) * √2) -
      (-2 + 20 * b - 24 * b ^ 2 + (8 / 3 - 16 * b + 16 * b ^ 2) * √2) =
      (a - b) * ((20 - 16 * √2) + (a + b) * (16 * √2 - 24)) := by ring
  nlinarith [mul_nonpos_of_nonneg_of_nonpos (sub_nonneg.2 hab) k]

/-- $Q_{1/2}'\ge0$ on $[0,\frac{65}{128}]$ (concavity of $Q'$ and the endpoint values). -/
theorem deriv_Q_half_nonneg {a : ℝ} (ha : a ∈ Icc (0 : ℝ) (65 / 128)) : 0 ≤ deriv (Q 2⁻¹) a := by
  have hs := sqrt_two_mem
  have hc := concaveOn_quadratic (a := -2 + 8 / 3 * √2) (b := 20 - 16 * √2) (c := 24 - 16 * √2)
    (by linarith [hs.2]) (convex_Icc (0 : ℝ) (65 / 128))
  have h := hc.min_le_of_mem_Icc (left_mem_Icc.2 (by norm_num)) (right_mem_Icc.2 (by norm_num)) ha
  have e : deriv (Q 2⁻¹) a = -2 + 8 / 3 * √2 + (20 - 16 * √2) * a - (24 - 16 * √2) * a ^ 2 := by
    rw [deriv_Q_eq, Q1f_eq_affine, two_rpow_half]; ring
  rw [e]
  refine le_trans (le_min ?_ ?_) h <;> norm_num <;> nlinarith [hs.1, hs.2]

/-- $Q_{1/2}\ge0$ on $[0,1]$. -/
theorem Q_half_nonneg {a : ℝ} (ha : a ∈ Icc (0 : ℝ) 1) : 0 ≤ Q 2⁻¹ a := by
  rw [Q_eq_affine, two_rpow_half]
  have hs := sqrt_two_mem
  have : 0 ≤ -3 + 12 * a + (4 - 8 * a) * √2 := by
    have e : -3 + 12 * a + (4 - 8 * a) * √2 = (1 - a) * (-3 + 4 * √2) + a * (9 - 4 * √2) := by ring
    rw [e]
    exact add_nonneg (mul_nonneg (by linarith [ha.2]) (by linarith [hs.1]))
      (mul_nonneg ha.1 (by linarith [hs.2]))
  have := mul_nonneg (mul_nonneg ha.1 (sub_nonneg.2 ha.2)) this
  nlinarith

/-- $Q_{1/2}$ is monotone on $[0,\frac{65}{128}]$. -/
theorem Q_half_monotoneOn : MonotoneOn (Q 2⁻¹) (Icc 0 (65 / 128)) :=
  monotoneOn_of_deriv_nonneg (convex_Icc _ _) (continuous_Q _).continuousOn
    (fun x _ ↦ (hasDerivAt_Q _ x).differentiableAt.differentiableWithinAt)
    fun _ hx ↦ deriv_Q_half_nonneg (interior_subset hx)

/-- For fixed $y$, $x\mapsto2Q(\frac{x+y}2)-Q(x)$ is antitone on $[0,y]$. -/
theorem two_Q_sub_Q_anti_x (y : ℝ) :
    AntitoneOn (fun x ↦ 2 * Q 2⁻¹ ((x + y) / 2) - Q 2⁻¹ x) (Icc 0 y) := by
  have hd : ∀ x, HasDerivAt (fun x ↦ 2 * Q 2⁻¹ ((x + y) / 2) - Q 2⁻¹ x)
      (deriv (Q 2⁻¹) ((x + y) / 2) - deriv (Q 2⁻¹) x) x := fun x ↦ by
    have h1 := (hasDerivAt_Q 2⁻¹ ((x + y) / 2)).comp x (((hasDerivAt_id' x).add_const y).div_const 2)
    have h2 := hasDerivAt_Q 2⁻¹ x
    rw [deriv_Q_eq]
    exact ((h1.const_mul 2).sub h2).congr_deriv (by ring)
  refine antitoneOn_of_deriv_nonpos (convex_Icc _ _)
    (fun x _ ↦ (hd x).continuousAt.continuousWithinAt)
    (fun x _ ↦ (hd x).differentiableAt.differentiableWithinAt)
    fun x hx ↦ ?_
  rw [interior_Icc] at hx
  rw [(hd x).deriv]
  linarith [deriv_Q_half_anti hx.1.le (show x ≤ (x + y) / 2 by linarith [hx.2])]

/-- $\mathrm J\cdot\mathrm J'$ is antitone on $[\frac12,\frac34]$ ([DIRX], §3.5:
$(\mathrm J\mathrm J')'=(\mathrm J')^2-\gamma$, $(\mathrm J')^2$ convex, endpoint values). -/
theorem JX_mul_deriv_anti : AntitoneOn (fun t ↦ J t * deriv J t) (Icc 2⁻¹ (3 / 4)) := by
  have hw := one_sub_w₁_lt_half
  have hsub : ∀ t ∈ Icc (2⁻¹ : ℝ) (3 / 4), t ∈ Ioo (1 - w₁) 1 := fun t ht ↦
    ⟨by linarith [ht.1], by linarith [ht.2]⟩
  have hd : ∀ t ∈ Icc (2⁻¹ : ℝ) (3 / 4), HasDerivAt (fun t ↦ J t * deriv J t)
      (deriv J t ^ 2 - γ) t := fun t ht ↦ by
    obtain ⟨d1, d2⟩ := JX_diff (hsub t ht)
    have := d1.hasDerivAt.mul d2.hasDerivAt
    convert this using 1
    have := JX_mul_deriv2 t (hsub t ht)
    linear_combination -this
  obtain ⟨g1, g2⟩ := gJw_w₁_half_fine
  have hg : (0 : ℝ) < gJw w₁ 2⁻¹ := by linarith
  have hs : (0 : ℝ) < √2 := by positivity
  have hγ := γX_mem
  -- endpoint values of $(\mathrm J')^2$
  have e1 : deriv J 2⁻¹ ^ 2 ≤ 1 := by
    rw [deriv_JX_half_eq, gInv_16_29_eq]
    obtain ⟨h1, h2⟩ := gInv_13_29
    rw [div_pow, div_le_one (by positivity), mul_pow, sq_sqrt (by norm_num)]
    nlinarith [sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]
  have e2 : deriv J (3 / 4) ^ 2 ≤ 1 := by
    rw [deriv_JX_eq (hsub _ ⟨by norm_num, le_rfl⟩)]
    have hm := gInv_mem_of_phi (t := ((8 / 29 : ℚ) : ℝ)) ⟨by norm_num, by norm_num⟩
      (sl := 45 / 100) (su := 0) (by norm_num) le_rfl
      (by exact_mod_cast (by decide +kernel : Checker.phiNegHi Checker.P0 (45 / 100) ≤ 8 / 29))
      (by exact_mod_cast (by decide +kernel : (8 / 29 : ℚ) ≤ Checker.phiNegLo Checker.P0 0))
    have e : w₁⁻¹ * (1 - 3 / 4) = ((8 / 29 : ℚ) : ℝ) := by norm_num [w₁]
    rw [e, div_pow, div_le_one (by positivity), mul_pow, sq_sqrt (by norm_num)]
    push_cast at hm
    nlinarith [sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]
  refine antitoneOn_of_deriv_nonpos (convex_Icc _ _)
    (fun t ht ↦ (hd t ht).continuousAt.continuousWithinAt)
    (fun t ht ↦ (hd t (interior_subset ht)).differentiableAt.differentiableWithinAt)
    fun t ht ↦ ?_
  have ht' := interior_subset ht
  rw [(hd t ht').deriv]
  have := convexOn_sq_deriv_JX.le_on_segment (hsub _ ⟨le_rfl, by norm_num⟩)
    (hsub _ ⟨by norm_num, le_rfl⟩) (by rw [segment_eq_Icc (by norm_num)]; exact ht')
  linarith [hγ.1, le_max_iff.1 this |>.elim (fun h ↦ h.trans e1) (fun h ↦ h.trans e2)]

/-- The tight lower bound $\underline{h_{QJQ,1}}$ ([DIRX], §3.5) with its lower bound property on
$[\frac14,\frac12]\times[\frac12,\frac{33}{64}]$. -/
noncomputable def hQJQ1lo (xl xu yl yu : ℝ) : ℝ :=
  yl - xu + J yu * deriv J yu - (2 * Q 2⁻¹ ((xl + yu) / 2) - Q 2⁻¹ xl) * deriv (Q 2⁻¹) ((xl + yl) / 2)

/-- Lower bound property of `hQJQ1lo`. -/
theorem hQJQ1lo_le {xl xu yl yu x y : ℝ} (hxl : 4⁻¹ ≤ xl) (hxu : xu ≤ 2⁻¹) (hyl : 2⁻¹ ≤ yl)
    (hyu : yu ≤ 33 / 64) (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    hQJQ1lo xl xu yl yu ≤
      y - x + J y * deriv J y - (2 * Q 2⁻¹ ((x + y) / 2) - Q 2⁻¹ x) * deriv (Q 2⁻¹) ((x + y) / 2) := by
  obtain ⟨hx1, hx2⟩ := hx
  obtain ⟨hy1, hy2⟩ := hy
  have hJ := JX_mul_deriv_anti ⟨hyl.trans hy1, by linarith⟩
    ⟨by linarith, by linarith⟩ hy2
  -- $A=2Q(\frac{x+y}2)-Q(x)$: $0\le A\le\overline A$
  have hA1 := two_Q_sub_Q_anti_x y
    ⟨by linarith, by linarith⟩ ⟨by linarith, by linarith⟩
    hx1
  beta_reduce at hA1
  have hA2 := Q_half_monotoneOn (⟨by linarith, by linarith⟩ :
      (xl + y) / 2 ∈ Icc (0 : ℝ) (65 / 128))
    (⟨by linarith, by linarith⟩ : (xl + yu) / 2 ∈ Icc (0 : ℝ) (65 / 128))
    (by linarith)
  have hA3 := Q_half_monotoneOn (⟨by linarith, by linarith⟩ : x ∈ Icc (0 : ℝ) (65 / 128))
    (⟨by linarith, by linarith⟩ : (x + y) / 2 ∈ Icc (0 : ℝ) (65 / 128))
    (by linarith)
  have hA4 := Q_half_nonneg (⟨by linarith, by linarith⟩ :
    (x + y) / 2 ∈ Icc (0 : ℝ) 1)
  -- $0\le Q'(\frac{x+y}2)\le Q'(\frac{x_l+y_l}2)$
  have hQ1 := deriv_Q_half_nonneg (⟨by linarith, by linarith⟩ :
    (x + y) / 2 ∈ Icc (0 : ℝ) (65 / 128))
  have hQ2 := deriv_Q_half_anti (a := (x + y) / 2) (b := (xl + yl) / 2) (by linarith)
    (by linarith)
  have hA0 : 0 ≤ 2 * Q 2⁻¹ ((x + y) / 2) - Q 2⁻¹ x := by linarith
  have hAu : 2 * Q 2⁻¹ ((x + y) / 2) - Q 2⁻¹ x ≤ 2 * Q 2⁻¹ ((xl + yu) / 2) - Q 2⁻¹ xl := by
    linarith
  have := mul_le_mul hAu hQ2 hQ1 (hA0.trans hAu)
  rw [hQJQ1lo]
  linarith


/-! ### The corrected tight lower bound for (3.12) -/

/-- Tangent bound of the cubic $Q=Q_{1/2}$: $Q(m)\le Q(a)+Q'(a)(m-a)$ if $m+2a\ge0$ (namely
$Q(a)+Q'(a)(m-a)-Q(m)=\frac23(m-a)^2((12\sqrt2-15)+(12-8\sqrt2)(m+2a))$). -/
theorem Q_half_tangent {a m : ℝ} (h : 0 ≤ m + 2 * a) :
    Q 2⁻¹ m ≤ Q 2⁻¹ a + deriv (Q 2⁻¹) a * (m - a) := by
  rw [deriv_Q_eq, Q1f_eq_affine, Q_eq_affine, Q_eq_affine, two_rpow_half]
  have hs := sqrt_two_mem
  have k : 0 ≤ (12 * √2 - 15) + (12 - 8 * √2) * (m + 2 * a) :=
    add_nonneg (by linarith [hs.1]) (mul_nonneg (by linarith [hs.2]) h)
  nlinarith [mul_nonneg (sq_nonneg (m - a)) k]

/-- $Q$ is concave on $[0,\infty)$. -/
theorem Q_half_concaveOn : ConcaveOn ℝ (Ici 0) (Q 2⁻¹) := by
  have hd : deriv (Q 2⁻¹) = Q1f 2⁻¹ := deriv_Q_eq _
  refine concaveOn_of_deriv2_nonpos' (convex_Ici 0)
    (fun x _ ↦ (hasDerivAt_Q _ x).differentiableAt.differentiableWithinAt)
    (fun x _ ↦ by rw [hd]; exact (hasDerivAt_Q1f _ x).differentiableAt.differentiableWithinAt)
    fun x hx ↦ ?_
  simp only [Function.iterate_succ, Function.iterate_zero, Function.comp_apply, Function.id_def,
    hd, (hasDerivAt_Q1f _ x).deriv, Q2f_eq_affine, two_rpow_half]
  have hs := sqrt_two_mem
  have hx : (0 : ℝ) ≤ x := hx
  nlinarith [hs.1, mul_nonneg hx (by linarith [hs.2] : (0 : ℝ) ≤ 48 - 32 * √2)]

/-- Upper bound of $Q$ on $[m_l,m_u]$, $m_l\ge0$, from the tangents at $m_l$ and $m_u$. -/
noncomputable def Qmx (ml mu : ℝ) : ℝ :=
  min (Q 2⁻¹ ml + max (deriv (Q 2⁻¹) ml * (mu - ml)) 0)
    (Q 2⁻¹ mu + max (deriv (Q 2⁻¹) mu * (ml - mu)) 0)

/-- `Qmx` bounds $Q$ on $[m_l,m_u]$. -/
theorem Q_le_Qmx {ml mu m : ℝ} (hml : 0 ≤ ml) (hm : m ∈ Icc ml mu) : Q 2⁻¹ m ≤ Qmx ml mu := by
  have t1 := Q_half_tangent (a := ml) (m := m) (by linarith [hm.1])
  have t2 := Q_half_tangent (a := mu) (m := m) (by linarith [hm.1, hm.2])
  refine le_min (t1.trans (add_le_add le_rfl ?_)) (t2.trans (add_le_add le_rfl ?_))
  · rcases le_total 0 (deriv (Q 2⁻¹) ml) with h | h
    · exact le_max_of_le_left (mul_le_mul_of_nonneg_left (by linarith [hm.2]) h)
    · exact le_max_of_le_right (mul_nonpos_of_nonpos_of_nonneg h (by linarith [hm.1]))
  · rcases le_total 0 (deriv (Q 2⁻¹) mu) with h | h
    · exact le_max_of_le_right (mul_nonpos_of_nonneg_of_nonpos h (by linarith [hm.2]))
    · exact le_max_of_le_left (mul_le_mul_of_nonpos_left (by linarith [hm.1]) h)

/-- The corrected tight lower bound $\underline{h_{QJQ,2}}$ of the left-hand side of (3.9) on
$[\frac14,\frac12]\times[\frac{33}{64},\frac34]$: as in the paper, but with the upper bound
`Qmx` of $Q$ on $[\frac{x_l+y_l}2,\frac{x_l+y_u}2]$ in place of $Q(\frac{x_l+y_u}2)$ ($Q$ is not
monotone there). -/
noncomputable def hQJQ2lo (xl xu yl yu : ℝ) : ℝ :=
  (yl - xu) ^ 2 + min (J yl) (J yu) ^ 2 - (2 * Qmx ((xl + yl) / 2) ((xl + yu) / 2) - Q 2⁻¹ xl) ^ 2

/-- Lower bound property of `hQJQ2lo`. -/
theorem hQJQ2lo_le {xl xu yl yu x y : ℝ} (hxl : 4⁻¹ ≤ xl) (hxu : xu ≤ 2⁻¹) (hyl : 33 / 64 ≤ yl)
    (hyu : yu ≤ 3 / 4) (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    hQJQ2lo xl xu yl yu ≤ (y - x) ^ 2 + J y ^ 2 - (2 * Q 2⁻¹ ((x + y) / 2) - Q 2⁻¹ x) ^ 2 := by
  obtain ⟨hx1, hx2⟩ := hx
  obtain ⟨hy1, hy2⟩ := hy
  have hs := sqrt_two_mem
  -- $(y-x)^2\ge(y_l-x_u)^2$
  have h1 : (yl - xu) ^ 2 ≤ (y - x) ^ 2 := pow_le_pow_left₀ (by linarith) (by linarith) 2
  -- $\mathrm J(y)^2\ge\min(\mathrm J(y_l),\mathrm J(y_u))^2$
  have hJ := JX_concave.1.min_le_of_mem_Icc (⟨by linarith, by linarith⟩ : yl ∈ Icc (2⁻¹ : ℝ) 1)
    (⟨by linarith, by linarith⟩ : yu ∈ Icc (2⁻¹ : ℝ) 1) ⟨hy1, hy2⟩
  have hJ0 : 0 ≤ min (J yl) (J yu) :=
    le_min (JX_concave.2 _ ⟨by linarith, by linarith⟩) (JX_concave.2 _ ⟨by linarith, by linarith⟩)
  have h2 : min (J yl) (J yu) ^ 2 ≤ J y ^ 2 := pow_le_pow_left₀ hJ0 hJ 2
  -- $0\le A=2Q(\frac{x+y}2)-Q(x)\le2\,\mathrm{Qmx}-Q(x_l)$
  have hA1 := two_Q_sub_Q_anti_x y ⟨by linarith, by linarith⟩ ⟨by linarith, by linarith⟩ hx1
  beta_reduce at hA1
  have hA2 := Q_le_Qmx (ml := (xl + yl) / 2) (mu := (xl + yu) / 2) (m := (xl + y) / 2)
    (by linarith) ⟨by linarith, by linarith⟩
  have hc := Q_half_concaveOn.min_le_of_mem_Icc (x := 4⁻¹) (y := 5 / 8) (z := (x + y) / 2)
    (by norm_num) (by norm_num) ⟨by linarith, by linarith⟩
  have hq1 : Q 2⁻¹ 4⁻¹ = √2 / 4 := Q_half_values.1
  have hq2 : √2 / 4 ≤ Q 2⁻¹ (5 / 8) := by
    rw [Q_eq_affine, two_rpow_half]; norm_num; linarith [hs.2]
  have hq3 : Q 2⁻¹ x ≤ 2⁻¹ := by
    have := Q_monotoneOn (mem_Ico_of_caseQ (Or.inl rfl)) (⟨by linarith, by linarith⟩ :
      x ∈ Icc (0 : ℝ) 2⁻¹) ⟨by norm_num, le_rfl⟩ (by linarith)
    rwa [Q_half_values.2.2] at this
  have hA0 : 0 ≤ 2 * Q 2⁻¹ ((x + y) / 2) - Q 2⁻¹ x := by
    have : √2 / 4 ≤ min (Q 2⁻¹ 4⁻¹) (Q 2⁻¹ (5 / 8)) := le_min hq1.ge hq2
    linarith [hs.1]
  have hAu : 2 * Q 2⁻¹ ((x + y) / 2) - Q 2⁻¹ x ≤
      2 * Qmx ((xl + yl) / 2) ((xl + yu) / 2) - Q 2⁻¹ xl := by linarith
  have h3 := pow_le_pow_left₀ hA0 hAu 2
  rw [hQJQ2lo]
  linarith

end Auto.DIRX

/-! ## [DIRX] §3: certified values for the computer-assisted claims

Auxiliary file shared by the certificates of the computer-assisted (🚗) claims of [DIRX] §3:
certified values at rational points, each recording its point, converted to entries
`Checker.Cert` of the environment of the verified interval checker:

* `JwPt`: $J_{w_1}(y)$ (`Checker.gJwIv`); then $\mathrm J(y)=J_{w_1}(y)/(2J_{w_1}(\frac12))$;
* `GiPt`: $\Phi^{-1}(t)/\sqrt2$ (`Checker.phiNegLo`, `Checker.phiNegHi`); then
  $\mathrm J'(y)=(\Phi^{-1}(\frac{1-y}{w_1})/\sqrt2)/J_{w_1}(\frac12)$;
* `LPt`: $L(x)=x\sqrt{\log_2(1/x)}$ (`Checker.logIv` and [DIR] `L_ge_of_le_logb`,
  `L_le_of_logb_le`);
* the constants $J_{w_1}(\frac12)$ (`cJhalf`) and $\sqrt2$ (`cSqrt2`).
-/

namespace Auto.DIRX

open Auto.DIR

open Real Set Checker

/-! ### Values of $J_{w_1}$ -/

/-- A certified enclosure of $J_{w_1}(y)$ at a rational point $y$. -/
structure JwPt where
  /-- The point. -/
  y : ℚ
  /-- Lower end. -/
  l : ℚ
  /-- Upper end. -/
  u : ℚ
  /-- The enclosure. -/
  h : gJw w₁ y ∈ Icc (l : ℝ) u

/-- A `JwPt` from one evaluation of the checker (witnesses $s_l,s_u$). -/
noncomputable def JwPt.mk' (y l u sl su : ℚ) (h : jw1Check y l u sl su = true) : JwPt :=
  ⟨y, l, u, gJw_w₁_mem h⟩

/-- The exact value $J_{w_1}(1)=0$. -/
noncomputable def JwPt.one : JwPt := ⟨1, 0, 0, by simp [gJw_one]⟩

/-- The environment entry of a `JwPt`. -/
noncomputable def JwPt.cert (p : JwPt) : Cert := ⟨p.l, p.u, gJw w₁ p.y, p.h⟩

/-- The certified constant $J_{w_1}(\frac12)$. -/
noncomputable def cJhalf : Cert :=
  ⟨506993328774 / 10 ^ 12, 506993330775 / 10 ^ 12, gJw w₁ 2⁻¹, by
    have := gJw_w₁_mem (y := 1 / 2) (a := 506993328774 / 10 ^ 12) (b := 506993330775 / 10 ^ 12)
      (sl := 919370219377073 / 10 ^ 16) (su := 57460638709817 / 625000000000000)
      (by decide +kernel)
    push_cast at this ⊢
    rwa [show (1 / 2 : ℝ) = 2⁻¹ by norm_num] at this⟩

/-- The certified constant $\sqrt2$. -/
noncomputable def cSqrt2 : Cert :=
  ⟨1.41421356, 1.41421357, √2, ⟨by rw [le_sqrt (by norm_num) (by norm_num)]; norm_num,
    by rw [sqrt_le_left (by norm_num)]; norm_num⟩⟩

/-! ### Values of $\Phi^{-1}/\sqrt2$ -/

/-- A certified enclosure of $\Phi^{-1}(t)/\sqrt2$ at a rational point $t$. -/
structure GiPt where
  /-- The point. -/
  t : ℚ
  /-- Lower end. -/
  l : ℚ
  /-- Upper end. -/
  u : ℚ
  /-- The enclosure. -/
  h : gInv t / √2 ∈ Icc (l : ℝ) u

/-- Boolean check of $\Phi(-\sqrt2s_l)\le t\le\Phi(-\sqrt2s_u)$ (via `phiNegHi`, `phiNegLo`). -/
def giCheck (t sl su : ℚ) : Bool :=
  decide (0 ≤ sl ∧ 0 ≤ su ∧ 0 < t ∧ t < 1 ∧ phiNegHi P0 sl ≤ t ∧ t ≤ phiNegLo P0 su)

/-- Soundness of `giCheck`: $\Phi^{-1}(t)/\sqrt2\in[-s_l,-s_u]$. -/
theorem gInv_div_mem {t sl su : ℚ} (h : giCheck t sl su = true) :
    gInv t / √2 ∈ Icc (-(sl : ℝ)) (-su) := by
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := of_decide_eq_true h
  have hm := gInv_mem_of_phi (t := (t : ℝ)) ⟨by exact_mod_cast h3, by exact_mod_cast h4⟩
    h1 h2 (by exact_mod_cast h5) (by exact_mod_cast h6)
  have hs : 0 < √2 := by positivity
  constructor
  · rw [le_div_iff₀ hs]; linarith [hm.1]
  · rw [div_le_iff₀ hs]; linarith [hm.2]

/-- A `GiPt` for $t<\frac12$ (witnesses $s_l\ge s\ge s_u$ with $\Phi^{-1}(t)=-\sqrt2s$). -/
noncomputable def GiPt.lo (t sl su : ℚ) (h : giCheck t sl su = true) : GiPt :=
  ⟨t, -sl, -su, by push_cast; exact gInv_div_mem h⟩

/-- A `GiPt` for $t>\frac12$, via $\Phi^{-1}(t)=-\Phi^{-1}(1-t)$. -/
noncomputable def GiPt.hi (t sl su : ℚ) (h : giCheck (1 - t) sl su = true) : GiPt :=
  ⟨t, su, sl, by
    have hm := gInv_div_mem h
    obtain ⟨-, -, h3, h4, -, -⟩ := of_decide_eq_true h
    have ht : (t : ℝ) ∈ Ioo 0 1 := by
      constructor
      · have : (t : ℚ) < 1 := by linarith
        have : (0 : ℚ) < t := by linarith
        exact_mod_cast this
      · have : (0 : ℚ) < 1 - t := h3
        have : t < (1 : ℚ) := by linarith
        exact_mod_cast this
    have e : gInv (t : ℝ) = -gInv (((1 - t : ℚ)) : ℝ) := by
      push_cast; rw [show (t : ℝ) = 1 - (1 - t) by ring, gInv_one_sub (by
        constructor <;> linarith [ht.1, ht.2]), sub_sub_cancel]
    rw [e, neg_div]
    exact ⟨by linarith [hm.2], by linarith [hm.1]⟩⟩

/-- The exact value $\Phi^{-1}(\frac12)/\sqrt2=0$. -/
noncomputable def GiPt.half : GiPt :=
  ⟨1 / 2, 0, 0, by rw [show ((1 / 2 : ℚ) : ℝ) = 2⁻¹ by norm_num, gInv_half]; simp⟩

/-- The environment entry of a `GiPt`. -/
noncomputable def GiPt.cert (p : GiPt) : Cert := ⟨p.l, p.u, gInv p.t / √2, p.h⟩

/-! ### Values of $L$ -/

/-- A certified enclosure of $L(x)=L_{1/2}(x)$ at a rational point $x$. -/
structure LPt where
  /-- The point. -/
  x : ℚ
  /-- Lower end. -/
  l : ℚ
  /-- Upper end. -/
  u : ℚ
  /-- The enclosure. -/
  h : L 2⁻¹ x ∈ Icc (l : ℝ) u

/-- Boolean check for an `LPt`: $\log\frac1x\in[a,b]$ (checker), and $c^2\log2\le a$,
$\log2\le a$, $b\le C^2\log2$ with $\log2\in[0.6931471803,0.6931471808]$. -/
def lCheck (x a b c C : ℚ) : Bool :=
  logCheck x⁻¹ a b && decide (0 < x ∧ x ≤ 1 / 2 ∧ c ^ 2 * (6931471808 / 10 ^ 10) ≤ a ∧
    6931471808 / 10 ^ 10 ≤ a ∧ b ≤ C ^ 2 * (6931471803 / 10 ^ 10) ∧ 0 ≤ C)

/-- Soundness of `lCheck`: $L(x)\in[xc,xC]$. -/
theorem L_mem_of_check {x a b c C : ℚ} (h : lCheck x a b c C = true) :
    L 2⁻¹ x ∈ Icc ((x * c : ℚ) : ℝ) (x * C : ℚ) := by
  simp only [lCheck, Bool.and_eq_true] at h
  obtain ⟨h1, h2⟩ := h
  obtain ⟨hx0, hx1, hc, ha1, hb, hC⟩ := of_decide_eq_true h2
  have hlog := log_mem_of_check h1
  have hl1 := log_two_gt_d9
  have hl2 := log_two_lt_d9
  have hl : 0 < log 2 := by linarith
  have hx0' : (0 : ℝ) < x := by exact_mod_cast hx0
  have hlb : log₂ (x : ℝ)⁻¹ = log ((x⁻¹ : ℚ) : ℝ) / log 2 := by rw [logb]; push_cast; rfl
  have hc' : ((c : ℝ)) ^ 2 * 0.6931471808 ≤ a := by
    have : ((c : ℝ)) ^ 2 * ((6931471808 / 10 ^ 10 : ℚ) : ℝ) ≤ a := by exact_mod_cast hc
    norm_num at this ⊢; linarith
  have ha1' : (0.6931471808 : ℝ) ≤ a := by
    have : ((6931471808 / 10 ^ 10 : ℚ) : ℝ) ≤ a := by exact_mod_cast ha1
    norm_num at this ⊢; linarith
  have hb' : (b : ℝ) ≤ C ^ 2 * 0.6931471803 := by
    have : (b : ℝ) ≤ (C : ℝ) ^ 2 * ((6931471803 / 10 ^ 10 : ℚ) : ℝ) := by exact_mod_cast hb
    norm_num at this ⊢; linarith
  have hlo : (a : ℝ) / 0.6931471808 ≤ log₂ (x : ℝ)⁻¹ := by
    rw [hlb]; exact div_le_div₀ (by linarith [hlog.1, ha1']) hlog.1 hl (by linarith)
  have hhi : log₂ (x : ℝ)⁻¹ ≤ (b : ℝ) / 0.6931471803 := by
    rw [hlb]
    exact div_le_div₀ (by linarith [hlog.1, hlog.2, ha1']) hlog.2 (by norm_num) (by linarith)
  push_cast
  constructor
  · exact L_ge_of_le_logb (by norm_num) hx0' (by rw [le_div_iff₀ (by norm_num)]; linarith) hlo
      (by rw [le_div_iff₀ (by norm_num)]; linarith)
  · have := L_le_of_logb_le (β := 2⁻¹) (βu := 2⁻¹) le_rfl le_rfl (by norm_num) hx0'
      (by have h := (Rat.cast_le (K := ℝ)).2 hx1
          push_cast at h; linarith) hhi (show (0 : ℝ) ≤ (C : ℝ) by exact_mod_cast hC)
      (by rw [div_le_iff₀ (by norm_num)]; linarith)
    simpa using this

/-- An `LPt` from a successful `lCheck`. -/
noncomputable def LPt.mk' (x a b c C : ℚ) (h : lCheck x a b c C = true) : LPt :=
  ⟨x, x * c, x * C, L_mem_of_check h⟩

/-- The environment entry of an `LPt`. -/
noncomputable def LPt.cert (p : LPt) : Cert := ⟨p.l, p.u, L 2⁻¹ p.x, p.h⟩

/-! ### Expressions -/

/-- $\mathrm J(y)$ from the entry $J_{w_1}(y)$ (variable $i$) and $J_{w_1}(\frac12)$ (variable $0$). -/
def exJ (i : ℕ) : Ex := .div (.var i) (.mul (.const 2) (.var 0))

/-- $Q(z)=Q_{1/2}(z)$ for rational $z$ in terms of $\sqrt2$ (variable $1$). -/
def exQh (z : ℚ) : Ex :=
  .add (.const (2 / 3 * z * (1 - z) * (-3 + 12 * z)))
    (.mul (.const (2 / 3 * z * (1 - z) * (4 - 8 * z))) (.var 1))

/-- $Q'(z)$ for rational $z$ in terms of $\sqrt2$ (variable $1$). -/
def exQ1h (z : ℚ) : Ex :=
  .add (.const (-2 + 20 * z - 24 * z ^ 2)) (.mul (.const (8 / 3 - 16 * z + 16 * z ^ 2)) (.var 1))

/-- The standard environment variables: $0\mapsto J_{w_1}(\frac12)$, $1\mapsto\sqrt2$. -/
theorem val_std (cs : List Cert) :
    Cert.val (cJhalf :: cSqrt2 :: cs) 0 = gJw w₁ 2⁻¹ ∧ Cert.val (cJhalf :: cSqrt2 :: cs) 1 = √2 :=
  ⟨rfl, rfl⟩

/-- `exJ` denotes $\mathrm J$. -/
theorem denote_exJ {ρ : ℕ → ℝ} {i : ℕ} {y : ℝ} (h0 : ρ 0 = gJw w₁ 2⁻¹) (hi : ρ i = gJw w₁ y) :
    denote ρ (exJ i) = JX y := by
  simp only [exJ, denote, h0, hi, JX_eq_div]; push_cast; rfl

/-- `exQh` denotes $Q_{1/2}$. -/
theorem denote_exQh {ρ : ℕ → ℝ} (h1 : ρ 1 = √2) (z : ℚ) : denote ρ (exQh z) = Q 2⁻¹ z := by
  simp only [exQh, denote, h1]; rw [Q_eq_affine, two_rpow_half]; push_cast; ring

/-- `exQ1h` denotes $Q_{1/2}'$. -/
theorem denote_exQ1h {ρ : ℕ → ℝ} (h1 : ρ 1 = √2) (z : ℚ) :
    denote ρ (exQ1h z) = deriv (Q 2⁻¹) z := by
  simp only [exQ1h, denote, h1]; rw [deriv_Q_eq, Q1f_eq_affine, two_rpow_half]; push_cast; ring


/-- $\mathrm J'(y)$ from the entry $\Phi^{-1}(\frac{1-y}{w_1})/\sqrt2$ (variable $i$) and
$J_{w_1}(\frac12)$ (variable $0$). -/
def exDJ (i : ℕ) : Ex := .div (.var i) (.var 0)

/-- `exDJ` denotes $\mathrm J'$. -/
theorem denote_exDJ {ρ : ℕ → ℝ} {i : ℕ} {y t : ℝ} (hy : y ∈ Ioo (1 - w₁) 1)
    (ht : t = w₁⁻¹ * (1 - y)) (h0 : ρ 0 = gJw w₁ 2⁻¹) (hi : ρ i = gInv t / √2) :
    denote ρ (exDJ i) = deriv JX y := by
  simp only [exDJ, denote, h0, hi, deriv_JX_eq hy, ht]
  rw [div_div, mul_comm (√2)]

end Auto.DIRX

/-! ## [DIRX] §3.3 Case LJQ, Case I: the tight lower bound of (3.3)

Auxiliary lemmas for `3_3_Case_LJQ.lean`: $L=L_{1/2}$ is monotone on $[0,\frac14]$, and the tight
lower bound $\underline{h_{LJQ,1}}$ of $G[B_{w_1}]$ on $[\frac1{16},\frac14]\times[\frac12,\frac34]$
([DIRX], §3.3, Case I) with its lower bound property.
-/

namespace Auto.DIRX

open Auto.DIR

open Real Set

local notation "J" => JX

/-- $L=L_{1/2}$ is monotone on $[0,\frac14]$ ($L'(x)=(\log\frac1x-\frac12)/\sqrt{\log2\log\frac1x}
\ge0$ for $x\le e^{-1/2}$). -/
theorem L_half_monotoneOn : MonotoneOn (L 2⁻¹) (Icc 0 4⁻¹) := by
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _)
    ((continuousOn_L (β := 2⁻¹) (by norm_num) (by norm_num)).mono fun t ht ↦
      ⟨ht.1, by linarith [ht.2]⟩) (fun t ht ↦ ?_) fun t ht ↦ ?_ <;> rw [interior_Icc] at ht
  · exact (hasDerivAt_L ⟨ht.1, by linarith [ht.2]⟩).differentiableAt.differentiableWithinAt
  · rw [deriv_L_half_eq ⟨ht.1, by linarith [ht.2]⟩]
    have h4 : (4 : ℝ) ≤ t⁻¹ := by
      rw [le_inv_comm₀ (by norm_num) ht.1]; linarith [ht.2]
    have hl : 2⁻¹ ≤ log t⁻¹ := by
      have := log_le_log (by norm_num) h4
      have h2 : (2⁻¹ : ℝ) ≤ log 4 := by
        rw [show (4 : ℝ) = 2 ^ 2 by norm_num, log_pow]; push_cast
        linarith [log_two_gt_d9]
      linarith
    exact div_nonneg (by linarith) (sqrt_nonneg _)

/-- The tight lower bound $\underline{h_{LJQ,1}}$ ([DIRX], §3.3, Case I) of $G[B_{w_1}]$. -/
noncomputable def hLJQ1lo (xl xu yl yu : ℝ) : ℝ :=
  max (√((yl - xu) ^ 2 + min (J yl) (J yu) ^ 2)) (yl - xu + (√2 - 1) * min (J yl) (J yu)) +
    L 2⁻¹ xl - 2 * Q 2⁻¹ ((xu + yu) / 2)

/-- Lower bound property of `hLJQ1lo` on $[\frac1{16},\frac14]\times[\frac12,\frac34]$. -/
theorem hLJQ1lo_le {xl xu yl yu x y : ℝ} (hxl : 16⁻¹ ≤ xl) (hxu : xu ≤ 4⁻¹) (hyl : 2⁻¹ ≤ yl)
    (hyu : yu ≤ 3 / 4) (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    hLJQ1lo xl xu yl yu ≤ Auto.DIR.G 2⁻¹ (BX w₁) x y := by
  obtain ⟨hx1, hx2⟩ := hx
  obtain ⟨hy1, hy2⟩ := hy
  have hBx : BX w₁ x = L 2⁻¹ x := by simp only [BX, show x ≤ 4⁻¹ by linarith, ↓reduceIte]
  have hBy : BX w₁ y = J y := BX_eq_JX ⟨by linarith, by linarith⟩
  have hBm : BX w₁ ((x + y) / 2) = Q 2⁻¹ ((x + y) / 2) := BX_eq_Q ⟨by linarith, by linarith⟩
  -- $\mathrm J(y)\ge\underline{\mathrm J}\ge0$
  have hJ := JX_concave.1.min_le_of_mem_Icc (⟨by linarith, by linarith⟩ : yl ∈ Icc (2⁻¹ : ℝ) 1)
    (⟨by linarith, by linarith⟩ : yu ∈ Icc (2⁻¹ : ℝ) 1) ⟨hy1, hy2⟩
  have hJ0 : 0 ≤ min (J yl) (J yu) :=
    le_min (JX_concave.2 _ ⟨by linarith, by linarith⟩) (JX_concave.2 _ ⟨by linarith, by linarith⟩)
  -- $L(x)\ge L(x_l)$, $Q(\frac{x+y}2)\le Q(\frac{x_u+y_u}2)$
  have hL := L_half_monotoneOn (⟨by linarith, by linarith⟩ : xl ∈ Icc (0 : ℝ) 4⁻¹)
    ⟨by linarith, by linarith⟩ hx1
  have hQ := Q_monotoneOn (mem_Ico_of_caseQ (Or.inl rfl))
    (⟨by linarith, by linarith⟩ : (x + y) / 2 ∈ Icc (0 : ℝ) 2⁻¹)
    (⟨by linarith, by linarith⟩ : (xu + yu) / 2 ∈ Icc (0 : ℝ) 2⁻¹) (by linarith)
  have hs : 0 ≤ √2 - 1 := by linarith [sqrt_two_mem.1]
  -- the two branches
  have h1 : √((yl - xu) ^ 2 + min (J yl) (J yu) ^ 2) ≤ √((y - x) ^ 2 + J y ^ 2) :=
    Real.sqrt_le_sqrt (add_le_add (pow_le_pow_left₀ (by linarith) (by linarith) 2)
      (pow_le_pow_left₀ hJ0 hJ 2))
  have h2 : yl - xu + (√2 - 1) * min (J yl) (J yu) ≤ y - x + (√2 - 1) * J y := by
    nlinarith [mul_le_mul_of_nonneg_left hJ hs]
  rw [Auto.DIR.G, G₁_half_eq, Auto.DIR.G₂, hBx, hBy, hBm, two_rpow_half, hLJQ1lo]
  rcases le_total (√((yl - xu) ^ 2 + min (J yl) (J yu) ^ 2))
    (yl - xu + (√2 - 1) * min (J yl) (J yu)) with h | h
  · rw [max_eq_right h]
    exact le_max_of_le_right (by linarith)
  · rw [max_eq_left h]
    exact le_max_of_le_left (by linarith)

/-- $R<\sqrt A$ if $A-\max(R,0)^2>0$. -/
theorem lt_sqrt_of_sub_max' {A R : ℝ} (h : 0 < A - max R 0 ^ 2) : R < √A := by
  rcases le_total R 0 with hR | hR
  · rw [max_eq_right hR] at h
    exact hR.trans_lt (Real.sqrt_pos.2 (by linarith))
  · rw [max_eq_left hR] at h
    exact (Real.lt_sqrt hR).2 (by linarith)

/-- $R<\max(\sqrt A,B)$ if $\max(A-\max(R,0)^2,B-R)>0$. -/
theorem lt_max_sqrt_of {A B R : ℝ} (h : 0 < max (A - max R 0 ^ 2) (B - R)) : R < max (√A) B := by
  rcases lt_max_iff.1 h with h | h
  · exact (lt_sqrt_of_sub_max' h).trans_le (le_max_left _ _)
  · exact (by linarith : R < B).trans_le (le_max_right _ _)

end Auto.DIRX

/-! ## [DIRX] §3.3, (3.7): certificates

Computer-assisted proof of (3.7): $G_{LJQ}(\frac1{16},y)>10^{-4}$ on $[\frac12,\frac34]$, with the paper's partition `h_LJQ_2` (29 intervals). Generated by a script outside the repository.
-/

namespace Auto.DIRX

