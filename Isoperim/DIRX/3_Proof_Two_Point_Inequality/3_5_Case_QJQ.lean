    linarith
  have h1 := hmono ⟨le_rfl, by norm_num⟩ hy hy.1
  have h0 := eqn_3_9_half x hx
  have hJ : J 2⁻¹ = 2⁻¹ := (JXw_half_one w₁ ⟨by norm_num [w₁], by norm_num [w₁]⟩).1
