/-! ### Enclosures of $\mathrm J$ and $|\mathrm J'|$ -/

/-- $x_1=\frac{35}{64}$. -/
theorem x₁_eq : x₁ = 35 / 64 := by norm_num [x₁, w₁]

/-- $[\frac14,1]\subseteq[1-w_1,1]$ and $(\frac14,1)\subseteq(1-w_1,1)$. -/
theorem quarter_mem {t : ℝ} (ht : t ∈ Icc (4⁻¹ : ℝ) 1) : t ∈ Icc (1 - w₁) 1 :=
  ⟨by norm_num [w₁] at ht ⊢; linarith [ht.1], ht.2⟩

/-- $\mathrm J$ is concave on $[\frac14,1]$ ($\mathrm J''<0$). -/
theorem JX_concaveOn_quarter : ConcaveOn ℝ (Icc 4⁻¹ 1) J := by
  have hsub : ∀ t ∈ Ioo (4⁻¹ : ℝ) 1, t ∈ Ioo (1 - w₁) 1 := fun t ht ↦
    ⟨by norm_num [w₁] at ht ⊢; linarith [ht.1], ht.2⟩
  refine concaveOn_of_deriv2_nonpos (convex_Icc _ _)
    (JX_contDiff.2.mono fun t ht ↦ quarter_mem ht) (fun t ht ↦ ?_) (fun t ht ↦ ?_) fun t ht ↦ ?_ <;>
    rw [interior_Icc] at ht
  · exact (JX_diff (hsub t ht)).1.differentiableWithinAt
  · exact (JX_diff (hsub t ht)).2.differentiableWithinAt
  · exact (deriv_JX.2.1 t (hsub t ht)).le

/-- $\mathrm J\ge0$ on $[\frac14,1]$. -/
theorem JX_nonneg_quarter {t : ℝ} (ht : t ∈ Icc (4⁻¹ : ℝ) 1) : 0 ≤ J t := by
  rcases eq_or_lt_of_le ht.2 with h | h
  · rw [h]; exact JX_concave.2 1 ⟨by norm_num, le_rfl⟩
  · exact (JX_pos ⟨by norm_num [w₁]; linarith [ht.1], h⟩).le

/-- $\mathrm J$ is monotone on $[\frac14,x_1]$. -/
theorem JX_monotoneOn_quarter : MonotoneOn J (Icc 4⁻¹ x₁) := by
  have hx := x₁_eq
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _)
    (JX_contDiff.2.mono fun t ht ↦ quarter_mem ⟨ht.1, by rw [hx] at ht; linarith [ht.2]⟩)
    (fun t ht ↦ ?_) fun t ht ↦ ?_ <;> rw [interior_Icc] at ht
  · exact (JX_diff ⟨by norm_num [w₁] at ht ⊢; linarith [ht.1], by rw [hx] at ht; linarith [ht.2]⟩
      ).1.differentiableWithinAt
  · exact deriv_JX_nonneg ⟨by norm_num [w₁] at ht ⊢; linarith [ht.1], ht.2.le⟩

/-- The point where the upper enclosure $\overline{\mathrm J}(m_l,m_u)$ is evaluated:
$m_u$ if $m_u<x_1$, $m_l$ if $m_l>x_1$, $x_1=\frac{35}{64}$ otherwise. -/
noncomputable def JhpR (ml mu : ℝ) : ℝ :=
  if mu < 35 / 64 then mu else if 35 / 64 < ml then ml else 35 / 64

/-- `JhpR` for rational arguments (computable, for the certificates). -/
def Jhp (ml mu : ℚ) : ℚ := if mu < 35 / 64 then mu else if 35 / 64 < ml then ml else 35 / 64

/-- `Jhp` is `JhpR` on rationals. -/
theorem Jhp_cast (ml mu : ℚ) : ((Jhp ml mu : ℚ) : ℝ) = JhpR ml mu := by
  have e1 : ((mu : ℝ) < 35 / 64) ↔ mu < 35 / 64 := by
    rw [← Rat.cast_lt (K := ℝ)]; push_cast; rfl
  have e2 : ((35 / 64 : ℝ) < ml) ↔ 35 / 64 < ml := by
    rw [← Rat.cast_lt (K := ℝ)]; push_cast; rfl
  by_cases h1 : mu < 35 / 64 <;> by_cases h2 : 35 / 64 < ml <;>
    simp [Jhp, JhpR, h1, h2, e1, e2]

/-- $\overline{\mathrm J}(m_l,m_u)=\mathrm J(\mathrm{JhpR}(m_l,m_u))$ is an upper bound of
$\mathrm J$ on $[m_l,m_u]\subseteq[\frac14,1]$. -/
theorem JX_le_JhpR {ml mu : ℝ} (hl : 4⁻¹ ≤ ml) (hu : mu ≤ 1) {m : ℝ} (hm : m ∈ Icc ml mu) :
    J m ≤ J (JhpR ml mu) := by
  have hx := x₁_eq
  obtain ⟨hmo, han⟩ := JX_mono
  unfold JhpR
  split_ifs with h1 h2
  · exact JX_monotoneOn_quarter ⟨by linarith [hm.1], by rw [hx]; linarith [hm.2]⟩
      ⟨by linarith [hm.1, hm.2], by rw [hx]; linarith⟩ hm.2
  · exact han ⟨by rw [hx]; linarith, by linarith [hm.1, hm.2]⟩
      ⟨by rw [hx]; linarith [hm.1], by linarith [hm.2]⟩ hm.1
  · rw [← hx]
    rcases le_total m x₁ with h | h
    · exact JX_monotoneOn_quarter ⟨by linarith [hm.1], h⟩ ⟨by rw [hx]; norm_num, le_rfl⟩ h
    · exact han ⟨le_rfl, by rw [hx]; norm_num⟩ ⟨h, by linarith [hm.2]⟩ h

/-- $\overline{|\mathrm J'|}(m_l,m_u)=\max(|\mathrm J'(m_l)|,|\mathrm J'(m_u)|)$ bounds $|\mathrm J'|$
on $[m_l,m_u]\subseteq(1-w_1,1)$ ($\mathrm J'$ is decreasing). -/
theorem abs_deriv_JX_le {ml mu m : ℝ} (hl : 1 - w₁ < ml) (hu : mu < 1) (hm : m ∈ Icc ml mu) :
    |deriv J m| ≤ max (|deriv J ml|) (|deriv J mu|) := by
  have hanti := deriv_JX.2.2.antitoneOn
  have h1 := hanti ⟨hl, by linarith [hm.1, hm.2]⟩ ⟨by linarith [hm.1], by linarith [hm.2]⟩ hm.1
  have h2 := hanti ⟨by linarith [hm.1], by linarith [hm.2]⟩ ⟨by linarith [hm.1, hm.2], hu⟩ hm.2
  rw [abs_le]
  constructor
  · linarith [le_max_right |deriv J ml| |deriv J mu|, neg_abs_le (deriv J mu)]
  · linarith [le_max_left |deriv J ml| |deriv J mu|, le_abs_self (deriv J ml)]

