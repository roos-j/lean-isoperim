/-! ### §3.6.1 Near diagonal: $3/8\le x\le1/2$, $1/2\le y\le5/8$, $x+y\ge1$ -/

section Near_Diagonal

/-
Here we show that for $\frac38\le x\le \frac12\le y\le \frac58$,
$G_1[B_w](x,y)\ge 0$.
-/

/-- [DIRX], §3.6.1: for $\frac38\le x\le\frac12\le y\le\frac58$ (and $x+y\ge1$, the standing
assumption of Case $QJ$), $G_1[B_w](x,y)\ge0$ (with $w=w_1$).

**Discrepancy with the paper.** The sentence states the claim for
$\frac38\le x\le\frac12\le y\le\frac58$ without the condition $x+y\ge1$ (which appears in the
heading of §3.6.1 and of Case $QJ$). The proof via $g_{QJ}$ uses
$B_w(\frac{x+y}2)=\mathrm{J}(\frac{x+y}2)$, which requires $\frac{x+y}2\ge\frac12$; for
$x+y<1$ one has $B_w(\frac{x+y}2)=Q(\frac{x+y}2)$ and these points belong to Case $QJQ$
(§3.5). The Lean statement adds the hypothesis `hxy : 1 ≤ x + y`, matching the heading; this is
all that is needed for `caseQJ`. -/
theorem caseQJ_near (x y : ℝ) (hx : x ∈ Icc (3 / 8 : ℝ) (1 / 2))
    (hy : y ∈ Icc (1 / 2 : ℝ) (5 / 8)) (hxy : 1 ≤ x + y) : G₁ (B_{w₁}) x y ≥ 0 := by
  sorry

/-
This will follow from positivity of an equivalent expression
\[ g_{QJ}(x,y)=(y-x)^{2} + {\mathrm{J}}(y)^2- (2 {\mathrm{J}}(\tfrac{x+y}{2})-Q(x))^2. \]
-/

/-- $g_{QJ}(x,y)=(y-x)^2+\mathrm{J}(y)^2-(2\mathrm{J}(\frac{x+y}2)-Q(x))^2$ ([DIRX], §3.6.1).
Written `g_QJ x y`. -/
noncomputable def g_QJX (x y : ℝ) : ℝ := (y - x) ^ 2 + J y ^ 2 - (2 * J ((x + y) / 2) - Q x) ^ 2

local notation "g_QJ" => g_QJX

/-- [DIRX], §3.6.1: positivity of $g_{QJ}(x,y)$ implies $G_1[B_{w_1}](x,y)\ge0$ (for
$\frac14\le x\le\frac12\le y\le1$, $x+y\ge1$). -/
theorem G₁_of_g_QJ (x y : ℝ) (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2)) (hy : y ∈ Icc (1 / 2 : ℝ) 1)
    (hxy : 1 ≤ x + y) (h : g_QJ x y ≥ 0) : G₁ (B_{w₁}) x y ≥ 0 := by
  sorry

/-
Note
that
$g_{QJ}(\tfrac12, y)\ge 0$
for all $y\in [\tfrac12,\tfrac58]$.
Indeed, this is equivalent to showing $G_1[{\mathrm{J}}](\frac12,y)\ge 0$ for these values, which
already follows from Section \ref{sec:caseJ} [§3.1].
-/

/-- [DIRX], §3.6.1: $g_{QJ}(\frac12,y)\ge0$ is equivalent to $G_1[\mathrm{J}](\frac12,y)\ge0$
(for $y\in[\frac12,\frac58]$). -/
theorem g_QJ_half_iff (y : ℝ) (hy : y ∈ Icc (1 / 2 : ℝ) (5 / 8)) :
    g_QJ (1 / 2) y ≥ 0 ↔ G₁ J (1 / 2) y ≥ 0 := by
  sorry

/-- [DIRX], §3.6.1: $g_{QJ}(\frac12,y)\ge0$ for all $y\in[\frac12,\frac58]$ (this already follows
from §3.1, (3.1)). -/
theorem g_QJ_half (y : ℝ) (hy : y ∈ Icc (1 / 2 : ℝ) (5 / 8)) : g_QJ (1 / 2) y ≥ 0 := by
  sorry

/-
Thus, to finish the proof of this case it remains to show that $\partial_x g_{QJ}$ is negative, or
equivalently, the positivity of
\[ -\tfrac{1}{2}\partial_x g_{QJ}(x,y) = y-x+(2{\mathrm{J}}(\tfrac{x+y}{2})-Q(x))
({\mathrm{J}}'(\tfrac{x+y}{2})-Q'(x)).\]
-/

/-- The expression $y-x+(2\mathrm{J}(\frac{x+y}2)-Q(x))(\mathrm{J}'(\frac{x+y}2)-Q'(x))$, which
equals $-\frac12\partial_xg_{QJ}(x,y)$ ([DIRX], §3.6.1; its tight lower bound is denoted
$\underline{h_{QJ,1}}$ in the paper). -/
noncomputable def h_QJ₁ (x y : ℝ) : ℝ :=
  y - x + (2 * J ((x + y) / 2) - Q x) * (deriv J ((x + y) / 2) - deriv Q x)

/-- [DIRX], §3.6.1: $-\frac12\partial_xg_{QJ}(x,y)=y-x+(2\mathrm{J}(\frac{x+y}2)-Q(x))
(\mathrm{J}'(\frac{x+y}2)-Q'(x))$ (for $(x,y)\in[\frac14,\frac12]\times[\frac12,\frac58]$). -/
theorem g_QJ_deriv (x y : ℝ) (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2))
    (hy : y ∈ Icc (1 / 2 : ℝ) (5 / 8)) :
    -(1 / 2) * deriv (fun t ↦ g_QJ t y) x = h_QJ₁ x y := by
  sorry

/-- [DIRX], §3.6.1: if $\partial_xg_{QJ}<0$ on $[\frac38,\frac12]\times[\frac12,\frac58]$, then
$g_{QJ}(x,y)\ge g_{QJ}(\frac12,y)\ge0$ there, which finishes the proof of this case. -/
theorem g_QJ_nonneg (x y : ℝ) (hx : x ∈ Icc (3 / 8 : ℝ) (1 / 2))
    (hy : y ∈ Icc (1 / 2 : ℝ) (5 / 8)) : g_QJ x y ≥ g_QJ (1 / 2) y ∧ g_QJ x y ≥ 0 := by
  sorry

/-
Recalling Lemma \ref{lem:Q} [2.4] and the enclosures for ${\mathrm{J}}, |{\mathrm{J}}'|$ (see
\eqref{eqn:J_intencl} [(2.7)] and the subsequent displays), a tight lower bound of this expression
can be given by
\[ \underline{h_{QJ,1}}(\underline{x},\overline{x},\underline{y},\overline{y})
=\underline{y}-\overline{x}+(2\underline{{\mathrm{J}}}(\tfrac{\underline{x}+\underline{y}}2,
\tfrac{\overline{x}+\overline{y}}2)-Q(\overline{x})) {\mathrm{J}}'(\tfrac{\overline{x}+
\overline{y}}2)\mathbf{1}_{(\overline{x}+\overline{y})/2<x_1}
\]
\[ - (2\overline{{\mathrm{J}}}(\tfrac{\underline{x}+\underline{y}}2,\tfrac{\overline{x}+
\overline{y}}2)-Q(\underline{x})) \overline{|{\mathrm{J}}'|}(\tfrac{\underline{x}+
\underline{y}}2,\tfrac{\overline{x}+\overline{y}}2)\mathbf{1}_{\text{not}\;(\overline{x}+
\overline{y})/2<x_1}
- (2\overline{{\mathrm{J}}}(\tfrac{\underline{x}+\underline{y}}2,\tfrac{\overline{x}+
\overline{y}}2)-Q(\underline{x}))Q'(\underline{x}). \]
-/

open Classical in
/-- The tight lower bound ([DIRX], §3.6.1), with $\underline c=\frac{\underline x+\underline y}2$,
$\overline c=\frac{\overline x+\overline y}2$:
$$\underline{h_{QJ,1}}(\underline x,\overline x,\underline y,\overline y)
=\underline y-\overline x+(2\underline{\mathrm{J}}(\underline c,\overline c)-Q(\overline x))
\mathrm{J}'(\overline c)\mathbf{1}_{\overline c<x_1}
-(2\overline{\mathrm{J}}(\underline c,\overline c)-Q(\underline x))
\overline{|\mathrm{J}'|}(\underline c,\overline c)\mathbf{1}_{\text{not }\overline c<x_1}
-(2\overline{\mathrm{J}}(\underline c,\overline c)-Q(\underline x))Q'(\underline x).$$ -/
noncomputable def h_QJ₁_lo (xl xu yl yu : ℝ) : ℝ :=
  yl - xu +
    (2 * JX_lo ((xl + yl) / 2) ((xu + yu) / 2) - Q xu) * deriv J ((xu + yu) / 2) *
      (if (xu + yu) / 2 < x₁ then 1 else 0) -
    (2 * JX_hi ((xl + yl) / 2) ((xu + yu) / 2) - Q xl) *
      absDJX_hi ((xl + yl) / 2) ((xu + yu) / 2) * (if ¬ (xu + yu) / 2 < x₁ then 1 else 0) -
    (2 * JX_hi ((xl + yl) / 2) ((xu + yu) / 2) - Q xl) * deriv Q xl

/-- [DIRX], §3.6.1: $\underline{h_{QJ,1}}$ is a tight lower bound of
$-\frac12\partial_xg_{QJ}$ (i.e. of `h_QJ₁`) on $[\frac14,\frac12]\times[\frac12,\frac58]$.

(On this rectangle $c=\frac{x+y}2$ ranges over $[\frac38,\frac9{16}]$, partly below $\frac12$,
whereas the monotonicity of $\mathrm{J}$, $\mathrm{J}'$ and the enclosures (2.7) are stated in
§2.2 for arguments in $[\frac12,1]$ (`Auto.DIRX.JX_mono`, `Auto.DIRX.eqn_2_7`,
`Auto.DIRX.absDJX_encl`). They remain valid on $[1-w_1,1)\supset[\frac38,1)$, since
$\mathrm{J}''=-\gamma/\mathrm{J}<0$ there and $\mathrm{J}'(x_1)=0$; the same remark applies to
$\underline{h_{QJ,2}}$ below, where $c\in[\frac7{16},\frac34]$. A randomized Python check of the
lower-bound property found no violation.) -/
theorem h_QJ₁_lo_tight :
    IsTightLowerBound₂ h_QJ₁ h_QJ₁_lo (1 / 4) (1 / 2) (1 / 2) (5 / 8) := by
  sorry

/-
Dyadic partitioning yields
-/

/-- **(3.13)** ([DIRX], §3.6.1) (🚗). Dyadic partitioning yields
$$-\tfrac12\partial_xg_{QJ}>10^{-5}\quad\text{on}\quad
[\tfrac14,\tfrac12]\times[\tfrac12,\tfrac58].$$
-/
theorem eqn_3_13 (x y : ℝ) (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2))
    (hy : y ∈ Icc (1 / 2 : ℝ) (5 / 8)) :
    -(1 / 2) * deriv (fun t ↦ g_QJ t y) x > (10 : ℝ) ^ (-5 : ℤ) := by
  sorry

end Near_Diagonal

/-! ### §3.6.2 Far from diagonal: $\frac14\le x\le\frac12$, $\frac58\le y\le1$, $x+y\ge1$ -/

section Far_From_Diagonal

/-
It suffices to show that for all $x\in [\frac14, \frac12]$ and $y\in[\frac58,1]$,
-/

/-- $h_{QJ,2}(x,y)=\sqrt{(y-x)^2+\mathrm{J}(y)^2}+Q(x)-2\mathrm{J}(\frac{x+y}2)$ ([DIRX], (3.14)).
-/
noncomputable def h_QJ₂ (x y : ℝ) : ℝ := √((y - x) ^ 2 + J y ^ 2) + Q x - 2 * J ((x + y) / 2)

/-- [DIRX], §3.6.2: for $x\in[\frac14,\frac12]$, $y\in[\frac58,1]$ and $x+y\ge1$ (the standing
assumption of Case $QJ$; it is not implied by the other two conditions, e.g.
$(x,y)=(\frac14,\frac58)$), $G_1[B_{w_1}](x,y)=h_{QJ,2}(x,y)$, so it suffices to show (3.14). -/
theorem G₁_BX_eq_h_QJ₂ (x y : ℝ) (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2))
    (hy : y ∈ Icc (5 / 8 : ℝ) 1) (hxy : 1 ≤ x + y) : G₁ (B_{w₁}) x y = h_QJ₂ x y := by
  sorry

/-- **(3.14)** ([DIRX], §3.6.2) (🚗). For all $x\in[\frac14,\frac12]$ and $y\in[\frac58,1]$,
$$h_{QJ,2}(x,y)=\sqrt{(y-x)^2+\mathrm{J}(y)^2}+Q(x)-2\mathrm{J}(\tfrac{x+y}2)>10^{-7}.$$ -/
theorem eqn_3_14 (x y : ℝ) (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2))
    (hy : y ∈ Icc (5 / 8 : ℝ) 1) : h_QJ₂ x y > (10 : ℝ) ^ (-7 : ℤ) := by
  sorry

/-
This follows by dyadic partitioning using the tight lower bound
\[ \underline{h_{QJ,2}}(\underline{x},\overline{x},\underline{y},\overline{y}) =
\sqrt{(\underline{y}-\overline{x})^2 + {\mathrm{J}}(\overline{y})^2} + Q(\underline{x})-
2\overline{{\mathrm{J}}}(\tfrac{\underline{x}+\underline{y}}{2},\tfrac{\overline{x}+
\overline{y}}{2}). \]
-/

/-- The tight lower bound ([DIRX], §3.6.2)
$$\underline{h_{QJ,2}}(\underline x,\overline x,\underline y,\overline y)
=\sqrt{(\underline y-\overline x)^2+\mathrm{J}(\overline y)^2}+Q(\underline x)
-2\overline{\mathrm{J}}(\tfrac{\underline x+\underline y}2,\tfrac{\overline x+\overline y}2).$$ -/
noncomputable def h_QJ₂_lo (xl xu yl yu : ℝ) : ℝ :=
  √((yl - xu) ^ 2 + J yu ^ 2) + Q xl - 2 * JX_hi ((xl + yl) / 2) ((xu + yu) / 2)

/-- [DIRX], §3.6.2: $\underline{h_{QJ,2}}$ is a tight lower bound of $h_{QJ,2}$ on
$[\frac14,\frac12]\times[\frac58,1]$. -/
theorem h_QJ₂_lo_tight :
    IsTightLowerBound₂ h_QJ₂ h_QJ₂_lo (1 / 4) (1 / 2) (5 / 8) 1 := by
  sorry

end Far_From_Diagonal

end Auto.DIRX
