/-- $1-w_1<\frac12$. -/
theorem one_sub_w₁_lt_half : 1 - w₁ < 2⁻¹ := by norm_num [w₁]

/-- $x_1\in(\frac12,1)$. -/
theorem x₁_mem : x₁ ∈ Ioo (2⁻¹ : ℝ) 1 := by constructor <;> norm_num [x₁, w₁]

/-- $\gamma>0$. -/
theorem γX_pos : 0 < γ := by linarith [γX_mem.1]

/-- $\mathrm J>0$ on $(1-w_1,1)$. -/
theorem JX_pos {t : ℝ} (ht : t ∈ Ioo (1 - w₁) 1) : 0 < J t := by
  rw [JX_eq]; exact mul_pos κX_pos (gJw_pos w₁_pos ht)

/-- $\mathrm J$ and $\mathrm J'$ are differentiable on $(1-w_1,1)$. -/
theorem JX_diff {t : ℝ} (ht : t ∈ Ioo (1 - w₁) 1) :
    DifferentiableAt ℝ J t ∧ DifferentiableAt ℝ (deriv J) t :=
  contDiffOn_two_differentiableAt isOpen_Ioo (contDiffOn_two_of_infty JX_contDiff.1) ht

/-- $\mathrm J''=-\gamma/\mathrm J$ on $(1-w_1,1)$. -/
theorem deriv2_JX {t : ℝ} (ht : t ∈ Ioo (1 - w₁) 1) : deriv (deriv J) t = -γ / J t := by
  have h := JX_mul_deriv2 t ht
  have hp := (JX_pos ht).ne'
  field_simp
  linarith

/-- $(\mathrm J')^2$ is convex on $(1-w_1,1)$ ([DIR], Lemma 3.2, applied to
$\mathrm J/\sqrt\gamma$, which solves $I\cdot I''=-1$). -/
theorem convexOn_sq_deriv_JX : ConvexOn ℝ (Ioo (1 - w₁) 1) (fun t ↦ deriv J t ^ 2) := by
  have hγ := γX_pos
  have hs : 0 < √γ := sqrt_pos.2 hγ
  have hs2 : √γ ^ 2 = γ := sq_sqrt hγ.le
  set I' : ℝ → ℝ := fun x ↦ J x / √γ with hI'
  have hd1 : deriv I' = fun x ↦ deriv J x / √γ := funext fun x ↦ deriv_div_const _
  have hd2 : deriv (deriv I') = fun x ↦ deriv (deriv J) x / √γ := by
    rw [hd1]; exact funext fun x ↦ deriv_div_const _
  have h := (lemma_3_2 I' (1 - w₁) 1 ((contDiffOn_two_of_infty JX_contDiff.1).div_const _)
    (fun x hx ↦ div_nonneg (JX_pos hx).le hs.le) fun x hx ↦ by
      rw [hd2]
      simp only [hI']
      have := JX_mul_deriv2 x hx
      field_simp
      rw [hs2]; linarith).2
  have e : (fun t ↦ deriv J t ^ 2) = fun t ↦ γ • (deriv I' t ^ 2) := by
    funext t; rw [hd1, smul_eq_mul, div_pow, hs2]; field_simp
  rw [e]
  exact h.smul hγ.le

/-- $\mathrm J'\le0$ on $[x_1,1)$. -/
theorem deriv_JX_nonpos {t : ℝ} (ht : t ∈ Ico x₁ 1) : deriv J t ≤ 0 := by
  obtain ⟨h0, -, hanti⟩ := deriv_JX
  have hx₁ : x₁ ∈ Ioo (1 - w₁) 1 := ⟨one_sub_w₁_lt_half.trans x₁_mem.1, x₁_mem.2⟩
  rcases eq_or_lt_of_le ht.1 with h | h
  · rw [← h, h0]
  · exact (hanti hx₁ ⟨by linarith [hx₁.1], ht.2⟩ h).le.trans_eq h0

/-- $\mathrm J'\ge0$ on $(1-w_1,x_1]$. -/
theorem deriv_JX_nonneg {t : ℝ} (ht : t ∈ Ioc (1 - w₁) x₁) : 0 ≤ deriv J t := by
  obtain ⟨h0, -, hanti⟩ := deriv_JX
  have hx₁ : x₁ ∈ Ioo (1 - w₁) 1 := ⟨one_sub_w₁_lt_half.trans x₁_mem.1, x₁_mem.2⟩
  rcases eq_or_lt_of_le ht.2 with h | h
  · rw [h, h0]
  · exact h0.symm.le.trans (hanti ⟨ht.1, by linarith [x₁_mem.2]⟩ hx₁ h).le

/-- $B_{w_1}=\mathrm J$ on $[\frac12,1]$. -/
theorem BX_eq_JX {t : ℝ} (ht : t ∈ Icc (2⁻¹ : ℝ) 1) : BX w₁ t = J t := by
  unfold BX
  split_ifs with h1 h2
  · linarith [ht.1]
  · have e : t = 2⁻¹ := le_antisymm h2 ht.1
    rw [e, show JX 2⁻¹ = 2⁻¹ from (JXw_half_one w₁ ⟨by norm_num [w₁], by norm_num [w₁]⟩).1,
      Q_eq_affine]
    ring
  · rfl

/-- $\kappa=(2J_{w_1}(\frac12))^{-1}$. -/
theorem κX_eq : κX = (2 * gJw w₁ 2⁻¹)⁻¹ := by
  have hI : I = gProf := rfl
  rw [κX, gJw, ← hI, show w₁⁻¹ * (1 - 2⁻¹) = (2 * w₁)⁻¹ by
    have := w₁_pos; field_simp; norm_num]
  ring

/-- $J_{w_1}(\frac12)\in[0.50699,0.506997]$ (one evaluation of the verified interval checker). -/
theorem gJw_w₁_half_fine : gJw w₁ 2⁻¹ ∈ Icc (0.50699 : ℝ) 0.506997 := by
  have := Checker.checkMem_sound Checker.P0 Checker.hw0 []
    (.JwHalf (29 / 32) 0.0919370219368073 0.0919370219366073) 0.50699 0.506997
    (by decide +kernel)
  simp only [Checker.denote] at this
  rw [show w₁ = ((29 / 32 : ℚ) : ℝ) by norm_num [w₁]]
  norm_num at this ⊢
  exact this

/-- $\Phi^{-1}(\frac{16}{29})\in[0.1291,0.1312]$. -/
theorem gInv_16_29 : gInv (16 / 29) ∈ Icc (0.1291 : ℝ) 0.1312 := by
  obtain ⟨hs1, hs2⟩ := sqrt_two_pi_bounds
  have hs0 : 0 < √(2 * π) := by linarith
  have hu : (16 / 29 : ℝ) ∈ Ioo 0 1 := by constructor <;> norm_num
  constructor
  · rw [le_gInv_iff hu]
    have := gCDF_le 0.1291 (by norm_num)
    have h2 : (0.1291 : ℝ) / √(2 * π) < 0.0516 := by rw [div_lt_iff₀ hs0]; nlinarith
    linarith
  · rw [gInv_le_iff hu]
    have := le_gCDF 0.1312 (by norm_num)
    have h2 : (0.0518 : ℝ) < (0.1312 - 0.1312 ^ 3 / 6) / √(2 * π) := by
      rw [lt_div_iff₀ hs0]; nlinarith
    linarith

/-- $\mathrm J(x_1)=\frac{w_1}{2J_{w_1}(\frac12)\sqrt\pi}$. -/
theorem JX_x₁_eq : J x₁ = w₁ / (2 * gJw w₁ 2⁻¹ * √π) := by
  have hg : 0 < gJw w₁ 2⁻¹ := gJw_pos w₁_pos ⟨one_sub_w₁_lt_half, by norm_num⟩
  have hsp : 0 < √π := sqrt_pos.2 pi_pos
  have hs2 : 0 < √2 := by positivity
  have e : gJw w₁ x₁ = √2 * w₁ * gProf 2⁻¹ := by
    unfold gJw; congr 2; rw [x₁]; have := w₁_pos; field_simp; ring
  rw [JX_eq, κX_eq, e, gProf_half, rpow_neg (by positivity),
    show (2 * π) ^ (2⁻¹ : ℝ) = √2 * √π by rw [← sqrt_mul (by norm_num), sqrt_eq_rpow]; norm_num]
  field_simp

/-- $\mathrm J'(\frac12)=\frac{\Phi^{-1}(\frac{16}{29})}{\sqrt2\,J_{w_1}(\frac12)}$. -/
theorem deriv_JX_half_eq : deriv J 2⁻¹ = gInv (16 / 29) / (√2 * gJw w₁ 2⁻¹) := by
  have hx : (2⁻¹ : ℝ) ∈ Ioo (1 - w₁) 1 := ⟨one_sub_w₁_lt_half, by norm_num⟩
  have hg : 0 < gJw w₁ 2⁻¹ := gJw_pos w₁_pos hx
  have hd : HasDerivAt J (κX * (√2 * gInv (w₁⁻¹ * (1 - 2⁻¹)))) 2⁻¹ := by
    have := (hasDerivAt_gJw w₁_pos hx).const_mul κX
    exact this.congr_of_eventuallyEq (Filter.Eventually.of_forall fun t ↦ JX_eq t)
  rw [hd.deriv, κX_eq, show w₁⁻¹ * (1 - 2⁻¹) = 16 / 29 by norm_num [w₁]]
  have hs : 0 < √2 := by positivity
  field_simp
  rw [sq_sqrt (by norm_num)]

/-! ### The derivatives of $F_c$ -/

/-- $F_c'(v)$ explicitly. -/
noncomputable def FXd (c v : ℝ) : ℝ :=
  2 * J (c + v) * deriv J (c + v) + 2 * J (c - v) * deriv J (c - v) + 8 * v -
    4 * J c * deriv J (c - v)

/-- $F_c''(v)$ explicitly (using $\mathrm J\cdot\mathrm J''=-\gamma$). -/
noncomputable def FXdd (c v : ℝ) : ℝ :=
  2 * (deriv J (c + v) ^ 2 - deriv J (c - v) ^ 2) + 8 - 4 * γ * (J c / J (c - v))

/-- $F_c'=$ `FXd c` where $c\pm v\in(1-w_1,1)$. -/
theorem hasDerivAt_FXl {c v : ℝ} (h1 : c + v ∈ Ioo (1 - w₁) 1) (h2 : c - v ∈ Ioo (1 - w₁) 1) :
    HasDerivAt (fun u ↦ J (c + u) ^ 2 - J (c - u) ^ 2 + 4 * u ^ 2 - 4 * J c ^ 2 +
      4 * J c * J (c - u)) (FXd c v) v := by
  have d1 := (JX_diff h1).1.hasDerivAt.comp v ((hasDerivAt_id' v).const_add c)
  have d2 := (JX_diff h2).1.hasDerivAt.comp v ((hasDerivAt_id' v).const_sub c)
  have H := ((((d1.pow 2).sub (d2.pow 2)).add ((hasDerivAt_pow 2 v).const_mul 4)).sub_const
    (4 * J c ^ 2)).add (d2.const_mul (4 * J c))
  refine H.congr_deriv ?_
  simp only [FXd, Function.comp_apply]
  push_cast; ring

/-- $(F_c')'=$ `FXdd c` where $c\pm v\in(1-w_1,1)$. -/
theorem hasDerivAt_FXd {c v : ℝ} (h1 : c + v ∈ Ioo (1 - w₁) 1) (h2 : c - v ∈ Ioo (1 - w₁) 1) :
    HasDerivAt (FXd c) (FXdd c v) v := by
  have j1 := (JX_diff h1).1.hasDerivAt.comp v ((hasDerivAt_id' v).const_add c)
  have j2 := (JX_diff h2).1.hasDerivAt.comp v ((hasDerivAt_id' v).const_sub c)
  have k1 := (JX_diff h1).2.hasDerivAt.comp v ((hasDerivAt_id' v).const_add c)
  have k2 := (JX_diff h2).2.hasDerivAt.comp v ((hasDerivAt_id' v).const_sub c)
  have H := (((((j1.const_mul 2).mul k1).add ((j2.const_mul 2).mul k2)).add
    ((hasDerivAt_id' v).const_mul 8)).sub (k2.const_mul (4 * J c)))
  refine H.congr_deriv ?_
  simp only [FXdd, Function.comp_apply]
  rw [deriv2_JX h1, deriv2_JX h2]
  have p1 := (JX_pos h1).ne'
  have p2 := (JX_pos h2).ne'
  field_simp
  ring

