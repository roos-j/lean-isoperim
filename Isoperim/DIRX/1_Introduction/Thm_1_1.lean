/-! ### §1 Introduction -/

/-- **Theorem 1.1** ([DIRX]). For all $A\subset\{0,1\}^n$ with $|A|\le\frac12$,
$$\mathbf{E}\sqrt{h_A}\ge|A|\sqrt{\log_2(1/|A|)}. \tag{1.1}$$ -/
theorem thm_1_1 (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) (hA : ｜A｜ ≤ 1 / 2) :
    𝐄 (fun x ↦ √(h_{A} x)) ≥ ｜A｜ * √(log₂ (1 / ｜A｜)) := by
  sorry

/-- [DIRX], §1, after Theorem 1.1: (1.1) is an equality when $A$ is a subcube (with
$|A|\le\frac12$). -/
theorem eqn_1_1_eq_subcube (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) (hA : ｜A｜ ≤ 1 / 2)
    (hsub : IsSubcube A) :
    𝐄 (fun x ↦ √(h_{A} x)) = ｜A｜ * √(log₂ (1 / ｜A｜)) := by
  sorry

/-- [DIRX], §1, after Theorem 1.1: there is no dimension-free lower bound for
$\mathbf{E}h_A^\beta$ when $\beta<\frac12$ (Hamming ball examples): for $0<\beta<\frac12$, the
infimum of $\mathbf{E}h_A^\beta$ over all $n\ge1$ and $A\subset\{0,1\}^n$ with $|A|=\frac12$
is $0$ (compare `Auto.DIR.no_dimension_free_bound`). The paper says "for any $\beta<\frac12$";
the hypothesis $0<\beta$ is implicit (only positive exponents are meaningful there; for
$\beta=0$ the statement fails, as $h_A^0=1$ with Lean's convention `0 ^ 0 = 1`). -/
theorem no_dimension_free_bound (β : ℝ) (hβ₀ : 0 < β) (hβ : β < 1 / 2) :
    sInf {v : ℝ | ∃ n : ℕ, 1 ≤ n ∧ ∃ A : Set ({0,1}^n), ｜A｜ = 1 / 2 ∧ v = 𝐄 h_{A} ^ β} = 0 := by
  sorry

/-- [DIRX], §1 (cited from Talagrand [Tal93]): for all $A\subset\{0,1\}^n$,
$\mathbf{E}\sqrt{h_A}\ge\sqrt2|A|(1-|A|)$. -/
theorem talagrand (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) :
    𝐄 (fun x ↦ √(h_{A} x)) ≥ √2 * ｜A｜ * (1 - ｜A｜) := by
  sorry

/-- [DIRX], §1 (cited from Bobkov–Götze [BG99]): Talagrand's bound was improved to
$\mathbf{E}\sqrt{h_A}\ge\sqrt3|A|(1-|A|)$. (The paper does not state the improved bound; the
precise form is taken from [DIR], §1.1, `Auto.DIR.bobkov_goetze`.)

**Discrepancy with the paper.** [DIRX] only says that Talagrand's bound
$\mathbf{E}\sqrt{h_A}\ge\sqrt2|A|(1-|A|)$ "was later improved by Bobkov–Götze [BG99], as a
consequence of more general results", without stating the improved inequality, so there is no
precise claim to formalize. The Lean statement fills in the form recorded in [DIR], §1.1
($\mathbf{E}\sqrt{h_A}\ge\sqrt3|A|(1-|A|)$, `Auto.DIR.bobkov_goetze`); it is a cited result, not
a claim proved in [DIRX]. -/
theorem bobkov_goetze (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) :
    𝐄 (fun x ↦ √(h_{A} x)) ≥ √3 * ｜A｜ * (1 - ｜A｜) := by
  sorry

/-- [DIRX], §1, after Theorem 1.1: sharp lower bounds for $\mathbf{E}h_A^\beta$ for all
$\beta\ge\frac12$ follow from (1.1) and Hölder's inequality ([DIR], Lemma 5.1,
`Auto.DIR.lemma_5_1`): for $|A|\le\frac12$,
$\mathbf{E}h_A^\beta\ge|A|(\log_2(1/|A|))^\beta$. -/
theorem eqn_1_1_rpow (n : ℕ) (hn : 1 ≤ n) (β : ℝ) (hβ : 1 / 2 ≤ β) (A : Set ({0,1}^n))
    (hA : ｜A｜ ≤ 1 / 2) :
    𝐄 h_{A} ^ β ≥ ｜A｜ * (log₂ (1 / ｜A｜)) ^ β := by
  sorry

/-- [DIRX], §1 (cited from [KP20], [BIM23]): for $\beta\ge\log_2(3/2)$ and $|A|\le\frac12$,
$\mathbf{E}h_A^\beta\ge|A|(\log_2(1/|A|))^\beta$. -/
theorem kahn_park_bim (n : ℕ) (hn : 1 ≤ n) (β : ℝ) (hβ : log₂ (3 / 2) ≤ β)
    (A : Set ({0,1}^n)) (hA : ｜A｜ ≤ 1 / 2) :
    𝐄 h_{A} ^ β ≥ ｜A｜ * (log₂ (1 / ｜A｜)) ^ β := by
  sorry

/-- [DIRX], §1: $\log_2(3/2)\approx0.585$ (to three decimals). -/
theorem logb_three_halves_approx : |log₂ (3 / 2) - 0.585| < 0.0005 := by
  sorry

/-- [DIRX], §1 (Harper's classical isoperimetric inequality [Har66, Ber67, Hart76]): the case
$\beta=1$, $\mathbf{E}h_A\ge|A|\log_2(1/|A|)$ for $|A|\le\frac12$. -/
theorem harper (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) (hA : ｜A｜ ≤ 1 / 2) :
    𝐄 h_{A} ≥ ｜A｜ * log₂ (1 / ｜A｜) := by
  sorry

/-- The vertex boundary $\partial A$ of $A\subset\{0,1\}^n$ ([DIRX], §1, after (1.2)): the
support of $h_A$, i.e. the set of $x\in A$ having a neighbor outside $A$. Written `∂A`. -/
def vtxBdry {n : ℕ} (A : Set ({0,1}^n)) : Set ({0,1}^n) := {x | h_{A} x ≠ 0}

/-- The vertex boundary $\partial A$ (`Auto.DIRX.vtxBdry`); local to this file. -/
local notation "∂" A:max => vtxBdry A

/-- **(1.2)** ([DIRX], §1). By the Cauchy–Schwarz inequality, (1.1) implies the following sharp
strengthening of the classical isoperimetric inequality: for $|A|\le\frac12$,
$$\mathbf{E}h_A\ge\frac{|A|}{|\partial A|}|A|\log_2(1/|A|),$$
where $\partial A$ is the support of $h_A$, i.e. the vertex boundary of $A$. (If
$|\partial A|=0$ then, as $|A|\le\frac12$, $A=\emptyset$ and both sides vanish; Lean's convention
$x/0=0$ is harmless.)
-/
theorem eqn_1_2 (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) (hA : ｜A｜ ≤ 1 / 2) :
    𝐄 h_{A} ≥ ｜A｜ / ｜∂A｜ * (｜A｜ * log₂ (1 / ｜A｜)) := by
  sorry

/-- [DIRX], §1, after (1.2): (1.2) is an equality if $A$ is a subcube. -/
theorem eqn_1_2_eq_subcube (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) (hA : ｜A｜ ≤ 1 / 2)
    (hsub : IsSubcube A) :
    𝐄 h_{A} = ｜A｜ / ｜∂A｜ * (｜A｜ * log₂ (1 / ｜A｜)) := by
  sorry

/-- [DIRX], §1, after (1.2): the factor satisfies $\frac{|A|}{|\partial A|}\ge1$ (for nonempty
$A$ with $|A|\le\frac12$), so (1.2) improves on the classical isoperimetric inequality. -/
theorem dens_div_vtxBdry_ge_one (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n))
    (hA : ｜A｜ ≤ 1 / 2) (hne : A.Nonempty) : ｜A｜ / ｜∂A｜ ≥ 1 := by
  sorry

/-- [DIRX], §1, after (1.2): (1.2) fails when the factor is replaced by
$(\frac{|A|}{|\partial A|})^\gamma$ for any $\gamma>1$ (Hamming ball examples). -/
theorem eqn_1_2_fails (γ : ℝ) (hγ : 1 < γ) :
    ∃ (n : ℕ) (A : Set ({0,1}^n)), 1 ≤ n ∧ ｜A｜ ≤ 1 / 2 ∧
      𝐄 h_{A} < (｜A｜ / ｜∂A｜) ^ γ * (｜A｜ * log₂ (1 / ｜A｜)) := by
  sorry

/-- [DIRX], §1 (cited from [BIM23, Cor. 1.2]): for $|A|\le\frac12$,
$\mathbf{E}h_A\ge(\frac{|A|}{|\partial A|})^\gamma|A|\log_2(1/|A|)$ with
$\gamma=\frac1{\log_2(3/2)}-1$. -/
theorem bim_cor_1_2 (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) (hA : ｜A｜ ≤ 1 / 2) :
    𝐄 h_{A} ≥ (｜A｜ / ｜∂A｜) ^ (1 / log₂ (3 / 2) - 1) * (｜A｜ * log₂ (1 / ｜A｜)) := by
  sorry

/-- [DIRX], §1: $\frac1{\log_2(3/2)}-1\approx0.709$ (in fact $=0.7095\ldots$). -/
theorem bim_exponent_approx : |(1 / log₂ (3 / 2) - 1) - 0.709| < 0.001 := by
