module

public import Isoperim.DIR.«1_Introduction».Definitions

/-!
# [DIRX] 1 Introduction: definitions

This file was automatically generated by Claude.

The definitions of [DIRX] 1 Introduction (and the elementary facts about them that the
other files need), collected in one file so that the theorem files of this section can import
the files containing their proofs without creating import cycles. The order is that of the
paper.

## Notation

From `Thm_1_1.lean`:
* `∂A` : the vertex boundary $\partial A$ of $A$, i.e. the support of $h_A$. This is a
  `local notation` (only active in this file): a global notation `∂ A` would clash with Mathlib's
  scoped shadow notation `∂ 𝒜` (`open scoped FinsetFamily`) in every file importing this one.

From `Thm_1_3.lean`:
* `s f x` : the sensitivity $s_f(x)$ of $f$ at $x$;
* `probZ p z` : $\mathbf{P}(Z=z)$ for a random vector $Z$ in $\{0,1\}^n$ with i.i.d.
  Bernoulli($p$) coordinates.
-/

@[expose] public section

namespace Auto.DIRX

open Auto.DIR

open Real Set

open Classical in
/-- The sensitivity $s_f(x)$ of $f$ at $x$ ([DIRX], §1, after (1.4) and §5): the number of
single-bit flips of $x$ that change the value of $f(x)$, i.e. the number of indices $j$ with
$f(x\oplus e_j)\ne f(x)$. Written `s f x`. -/
noncomputable def s {n : ℕ} (f : ({0,1}^n) → ℝ) (x : {0,1}^n) : ℝ :=
  (Finset.univ.filter fun j ↦ f (x + e j) ≠ f x).card

/-- [DIRX], §1, after (1.4): for $f=\mathbf{1}_A$, $s_f(x)=h_A(x)+h_{A^c}(x)$. -/
theorem sensitivity_indicator (n : ℕ) (A : Set ({0,1}^n)) (x : {0,1}^n) :
    s (𝟏 A) x = h A x + h Aᶜ x := by
  classical
  by_cases hx : x ∈ A
  · have h0 : h Aᶜ x = 0 := by simp [h, hx]
    rw [h0, add_zero]
    simp only [s, h, hx, ite_true]
    refine congrArg (fun t : Finset (Fin n) ↦ ((t.card : ℕ) : ℝ))
      (Finset.filter_congr fun j _ ↦ ?_)
    by_cases hj : x + e j ∈ A <;> simp [ind, hj, hx]
  · have h0 : h A x = 0 := by simp [h, hx]
    rw [h0, zero_add]
    have hx' : x ∈ Aᶜ := hx
    simp only [s, h, hx', ite_true, Finset.card_filter]
    push_cast
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    by_cases hj : x + e j ∈ A <;> simp [ind, hj, hx]

/-- [DIRX], §1, after (1.4): $h_A$ and $h_{A^c}$ have disjoint support. -/
theorem hA_mul_hA_compl (n : ℕ) (A : Set ({0,1}^n)) (x : {0,1}^n) :
    h A x * h Aᶜ x = 0 := by
  by_cases hx : x ∈ A <;> simp [h, hx]

/-- [DIRX], §1, after (1.4): since $h_A$ and $h_{A^c}$ have disjoint support,
$\sqrt{s_f}=\sqrt{h_A}+\sqrt{h_{A^c}}$ for $f=\mathbf{1}_A$. -/
theorem sqrt_sensitivity_indicator (n : ℕ) (A : Set ({0,1}^n)) (x : {0,1}^n) :
    √(s (𝟏 A) x) = √(h A x) + √(h Aᶜ x) := by
  rw [sensitivity_indicator]
  by_cases hx : x ∈ A
  · have h0 : h Aᶜ x = 0 := by simp [h, hx]
    simp [h0]
  · have h0 : h A x = 0 := by simp [h, hx]
    simp [h0]

end Auto.DIRX
