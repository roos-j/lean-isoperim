      1 - 2⁻¹ * (log (log x⁻¹) / log x⁻¹) - log (2 * √π) / log x⁻¹ := by ring
  rw [e]
  exact h

/-- [DIRX], proof of (2.6): thus, for $x\in(0,\frac1{64}]$,
