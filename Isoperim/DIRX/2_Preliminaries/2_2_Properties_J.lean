  have hx0 := hx.1
  have hy : x / w₁ ∈ Ioc (0 : ℝ) 5⁻¹ :=
    ⟨div_pos hx0 hw0, by rw [div_le_iff₀ hw0, hw]; linarith [hx.2]⟩
  have hL := I_lower (x / w₁) hy
  rw [inv_div] at hL
  have hK : 0 ≤ (I ((2 * w₁)⁻¹))⁻¹ := inv_nonneg.2 (gProf_nonneg _)
  have hJ : J (1 - x) = 2⁻¹ * (I ((2 * w₁)⁻¹))⁻¹ * I (x / w₁) := by
    show 2⁻¹ * (I ((2 * w₁)⁻¹))⁻¹ * I ((1 - (1 - x)) / w₁) = _
    rw [sub_sub_cancel]
