/-- $B_w\ge0$ on $[0,1]$: $L\ge0$, $Q\ge0$ on $[0,\frac12]$ ([DIR] Lemma 5.8) and
$\mathrm{J}_w\ge0$ ($I\ge0$). -/
theorem BX_nonneg (w : ℝ) {x : ℝ} (hx : x ∈ Icc (0 : ℝ) 1) : 0 ≤ BX w x := by
  have hβ : (2⁻¹ : ℝ) ∈ Ico (2⁻¹ : ℝ) (log₂ (3 / 2)) :=
    ⟨le_rfl, by linarith [logb_three_halves_ge]⟩
  have hI : I = gProf := rfl
  unfold BX
  split_ifs with h1 h2
  · exact L_nonneg hx
  · exact (lemma_5_8 x ⟨hx.1, h2⟩ 2⁻¹ hβ).1.1
  · unfold JXw
    rw [hI]
    exact mul_nonneg (mul_nonneg (by norm_num) (inv_nonneg.2 (gProf_nonneg _))) (gProf_nonneg _)

/-- $B_w(0)=0$. -/
theorem BX_zero (w : ℝ) : BX w 0 = 0 := by
  rw [BX, ite_eq_left (by norm_num), L_zero]

/-- $B_w(1)=0$ for $w\in(\frac12,1]$. -/
theorem BX_one (w : ℝ) (hw : w ∈ Ioc (2⁻¹ : ℝ) 1) : BX w 1 = 0 := by
  rw [BX, ite_eq_right (by norm_num), ite_eq_right (by norm_num)]
  exact (JXw_half_one w hw).2

end Auto.DIRX
