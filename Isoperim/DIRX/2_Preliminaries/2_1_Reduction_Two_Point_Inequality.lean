/-!
# [DIRX] §2 Preliminaries, §2.1 Reduction to a two-point inequality

This file was automatically generated by Claude.

Source [DIRX]: P. Durcik, P. Ivanisvili, J. Roos, X. Xie, *Sharp isoperimetric inequalities on the
Hamming cube II: The critical exponent*, arXiv:2602.20462v1.

This file covers §2.1: the two-point functionals (2.1), the Kahn–Park reduction, the functions
$L$, $Q$, $I$, $\mathrm{J}_w$, the Bellman function $B_w$ (2.2), the parameter $w_1$ (2.3), the
main two-point inequality (2.4), the isoperimetric inequality (2.5) and Remarks 2.1, 2.2.

The Gaussian isoperimetric profile `I` is reused from [DIR] (`Auto.DIR.I`, §3 of [DIR]).

## Notation introduced here

The Lean names of the [DIRX] objects carry an `X` suffix to avoid clashes with the corresponding
(different) objects of [DIR]; they are displayed via the following `local notation`, which is
declared in every [DIRX] file using them:

* `G₁ B x y`, `G₂ B x y`, `G B x y` : $G_1[B](x,y)$, $G_2[B](x,y)$, $G[B](x,y)$ of (2.1)
  (Lean names `G₁X`, `G₂X`, `GX`);
* `L x`, `Q x` : $L(x)=x\sqrt{\log_2(1/x)}$ and the cubic $Q(x)$ (Lean names `LX`, `QX`);
* `J_{w} x` : $\mathrm{J}_w(x)$ (Lean name `JXw`);
* `B_{w} x` : $B_w(x)$ of (2.2) (Lean name `BX`);
* `w₁` : $w_1=\frac{29}{32}$ of (2.3);
* `J x` : $\mathrm{J}(x)=\mathrm{J}_{w_1}(x)$ (Lean name `JX`);
* `wStar` : the optimal value $w_*$ of Remark 2.1.
-/

@[expose] public section

namespace Auto.DIRX

open Auto.DIR

open Real Set

/-! ### §2.1 Reduction to a two-point inequality -/

/-
For $0\le x\le y\le 1$ and $B:[0,1]\to [0,\infty)$ let
-/

/-- **(2.1)** ([DIRX], §2.1). For $0\le x\le y\le1$ and $B:[0,1]\to[0,\infty)$,
$$G_1[B](x,y)=\sqrt{(y-x)^2+B(y)^2}+B(x)-2B(\tfrac{x+y}2).$$
Written `G₁ B x y`. -/
noncomputable def G₁X (B : ℝ → ℝ) (x y : ℝ) : ℝ :=
  √((y - x) ^ 2 + B y ^ 2) + B x - 2 * B ((x + y) / 2)

local notation "G₁" => G₁X

/-- ([DIRX], §2.1, display after (2.1)).
$$G_2[B](x,y)=y-x+(\sqrt2-1)B(y)+B(x)-2B(\tfrac{x+y}2).$$ Written `G₂ B x y`. -/
noncomputable def G₂X (B : ℝ → ℝ) (x y : ℝ) : ℝ :=
  y - x + (√2 - 1) * B y + B x - 2 * B ((x + y) / 2)

local notation "G₂" => G₂X

/-- ([DIRX], §2.1, after (2.1)). $G=\max(G_1,G_2)$. Written `G B x y`. -/
noncomputable def GX (B : ℝ → ℝ) (x y : ℝ) : ℝ := max (G₁ B x y) (G₂ B x y)

local notation "G" => GX

/-
Kahn and Park \cite{KP20} proved that if $B$ satisfies $B(0)=B(1)=0$ and the two-point inequality
\[G[B](x,y)\ge 0\]
holds for all $0\le x\le y\le 1$, then $\mathbf{E} \sqrt{h_A}\ge B(|A|)$
for all $A\subset \{0,1\}^n$ and $n\ge 1$.
-/

/-- [DIRX], §2.1 (cited from Kahn–Park [KP20]; this is the case $\beta=\frac12$ of
`Auto.DIR.prop_2_1`). If $B:[0,1]\to[0,\infty)$ satisfies $B(0)=B(1)=0$ and the two-point
inequality $G[B](x,y)\ge0$ holds for all $0\le x\le y\le1$, then
$\mathbf{E}\sqrt{h_A}\ge B(|A|)$ for all $A\subset\{0,1\}^n$ and $n\ge1$. -/
theorem kahn_park (B : ℝ → ℝ) (hB : ∀ x ∈ Icc (0 : ℝ) 1, 0 ≤ B x) (hB0 : B 0 = 0)
    (hB1 : B 1 = 0) (htwo : ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G B x y ≥ 0)
    (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) :
    𝐄 (fun x ↦ √(h_{A} x)) ≥ B ｜A｜ := by
  sorry

/-
This reduces the proof of Theorem \ref{thm:mainisoperim} [1.1] to finding a Bellman function $B$
and verifying the two-point inequality.
We use the following refinement of the Bellman function used in \cite{DIR24}.
For $x\in (0,1]$ define
\[ L(x) = x \sqrt{\log_2(1/x)} \]
and $L(0)=0$.
-/

/-- $L(x)=x\sqrt{\log_2(1/x)}$ for $x\in(0,1]$ and $L(0)=0$ ([DIRX], §2.1). The value $L(0)=0$
holds by definition since $0\cdot a=0$ in Lean. Written `L x`. -/
noncomputable def LX (x : ℝ) : ℝ := x * √(log₂ (1 / x))

local notation "L" => LX

/-- The cubic $Q(x)=\frac23x(1-x)(2^{5/2}-3+4(3-2^{3/2})x)$ ([DIRX], §2.1). Written `Q x`. -/
noncomputable def QX (x : ℝ) : ℝ :=
  2 / 3 * x * (1 - x) * (2 ^ (5 / 2 : ℝ) - 3 + 4 * (3 - 2 ^ (3 / 2 : ℝ)) * x)

local notation "Q" => QX

/-- [DIRX], §2.1: $Q$ is the unique cubic interpolating polynomial such that $Q(0)=Q(1)=0$,
$Q(\frac12)=\frac12$ and $Q(\frac14)=2^{-3/2}$, i.e.
$Q(x)=\frac23x(1-x)(2^{5/2}-3+4(3-2^{3/2})x)$: $Q$ is a polynomial of degree $\le3$ with these
four values, and every polynomial of degree $\le3$ with these four values equals $Q$. -/
theorem QX_spec :
    (∃ p : Polynomial ℝ, p.natDegree ≤ 3 ∧ ∀ x, p.eval x = Q x) ∧
      Q 0 = 0 ∧ Q 1 = 0 ∧ Q (1 / 2) = 1 / 2 ∧ Q (1 / 4) = 2 ^ (-3 / 2 : ℝ) ∧
      ∀ p : Polynomial ℝ, p.natDegree ≤ 3 → p.eval 0 = 0 → p.eval 1 = 0 →
        p.eval (1 / 2) = 1 / 2 → p.eval (1 / 4) = 2 ^ (-3 / 2 : ℝ) → ∀ x, p.eval x = Q x := by
  sorry

/-
The idea of using the polynomial $Q$ goes back to Beltran--Ivanisvili--Madrid \cite{BIM23}.
Let $I(x)$ denote the Gaussian isoperimetric profile, i.e. the unique function on $[0,1]$ such that
$I(0)=I(1)=0, I\cdot I''=-1$.
-/

/-- [DIRX], §2.1: the Gaussian isoperimetric profile $I$ (`Auto.DIR.I` of [DIR], §3) is the unique
function on $[0,1]$ such that $I(0)=I(1)=0$, $I\cdot I''=-1$ (among non-negative functions that
are continuous on $[0,1]$ and twice continuously differentiable on $(0,1)$; non-negativity is
implicit in the paper since $-I$ satisfies the same conditions). This is
`Auto.DIR.I_characterization`. -/
theorem I_characterization :
    (I 0 = 0 ∧ I 1 = 0 ∧ ∀ x ∈ Ioo (0 : ℝ) 1, I x * deriv (deriv I) x = -1) ∧
    ∀ g : ℝ → ℝ, ContinuousOn g (Icc 0 1) → ContDiffOn ℝ 2 g (Ioo 0 1) →
      (∀ x ∈ Icc (0 : ℝ) 1, 0 ≤ g x) → g 0 = 0 → g 1 = 0 →
      (∀ x ∈ Ioo (0 : ℝ) 1, g x * deriv (deriv g) x = -1) → EqOn g I (Icc 0 1) := by
  sorry

/-
For a parameter $w\in (\frac12,1]$ let
\[ {\mathrm{J}}_w(x) = \tfrac12 I(\tfrac1{2w})^{-1} I(\tfrac{1-x}{w}). \]
-/

/-- $\mathrm{J}_w(x)=\frac12I(\frac1{2w})^{-1}I(\frac{1-x}w)$ for a parameter $w\in(\frac12,1]$
([DIRX], §2.1). It is meaningful for $x\in[1-w,1]$ (outside this range `I` takes the junk value
$0$). Written `J_{w} x`. -/
noncomputable def JXw (w x : ℝ) : ℝ := 1 / 2 * (I (1 / (2 * w)))⁻¹ * I ((1 - x) / w)

local notation "J_{" w "}" => JXw w

/-- [DIRX], §2.1: $\mathrm{J}_w(\frac12)=\frac12$ and $\mathrm{J}_w(1)=0$ for $w\in(\frac12,1]$. -/
theorem JXw_half_one (w : ℝ) (hw : w ∈ Ioc (1 / 2 : ℝ) 1) :
    J_{w} (1 / 2) = 1 / 2 ∧ J_{w} 1 = 0 := by
  sorry

/-
Note that ${\mathrm{J}}_w(\frac12)=\frac12$ and ${\mathrm{J}}_w(1)=0$.
Then define
-/

/-- **(2.2)** ([DIRX], §2.1). The Bellman function
$$B_w(x)=\begin{cases}L(x)&x\in[0,\frac14],\\ Q(x)&x\in[\frac14,\frac12],\\
\mathrm{J}_w(x)&x\in[\frac12,1].\end{cases}$$
Only the values on $[0,1]$ are meaningful. Written `B_{w} x`. -/
noncomputable def BX (w x : ℝ) : ℝ :=
  if x ≤ 1 / 4 then L x else if x ≤ 1 / 2 then Q x else J_{w} x

local notation "B_{" w "}" => BX w

/-
For some motivation on the choice of such functions, see \cite[\S 2]{DIR24}.
In the following we shall fix
-/

/-- **(2.3)** ([DIRX], §2.1). The parameter $w=w_1=\frac{29}{32}$. -/
noncomputable def w₁ : ℝ := 29 / 32

/-- The function $\mathrm{J}=\mathrm{J}_{w_1}$ ([DIRX], §2.1, after (2.3)). Written `J x`. -/
noncomputable def JX : ℝ → ℝ := J_{w₁}

local notation "J" => JX

/-
and write ${\mathrm{J}}={\mathrm{J}}_{w_1}$.
Note that since $B_w(x)\ge L(x)$ for $x\in [0,\frac12]$ (see \cite[Lemma 5.9 (2)]{DIR24}), in order
to prove Theorem \ref{thm:mainisoperim} [1.1] it suffices to prove that there exists $w$ such that
-/

/-- [DIRX], §2.1 (cited from [DIR], Lemma 5.9 (2), `Auto.DIR.lemma_5_9`): $B_w(x)\ge L(x)$ for
$x\in[0,\frac12]$. -/
theorem BX_ge_LX (w x : ℝ) (hx : x ∈ Icc (0 : ℝ) (1 / 2)) : B_{w} x ≥ L x := by
  sorry

/-- [DIRX], §2.1: in order to prove Theorem 1.1 it suffices to prove that there exists $w$ such
that (2.4) holds for all $0\le x\le y\le1$ (by the Kahn–Park reduction and
$B_w\ge L$ on $[0,\frac12]$). -/
theorem thm_1_1_of_eqn_2_4
    (h : ∃ w ∈ Ioc (1 / 2 : ℝ) 1, ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G (B_{w}) x y ≥ 0)
    (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) (hA : ｜A｜ ≤ 1 / 2) :
    𝐄 (fun x ↦ √(h_{A} x)) ≥ ｜A｜ * √(log₂ (1 / ｜A｜)) := by
  sorry

/-- **(2.4)** ([DIRX], §2.1; proved in §3 for $w=w_1$). For all $0\le x\le y\le1$,
$$G[B_w](x,y)\ge0$$ with $w=w_1$. -/
theorem eqn_2_4 (x y : ℝ) (hx : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 1) :
    G (B_{w₁}) x y ≥ 0 := by
  sorry

/-
for all $0\le x\le y\le 1$.
As a consequence of this argument we obtain the isoperimetric inequality
-/

/-- **(2.5)** ([DIRX], §2.1). The isoperimetric inequality
$$\mathbf{E}\sqrt{h_A}\ge B_{w_1}(|A|),$$
valid for all $A\subset\{0,1\}^n$. -/
theorem eqn_2_5 (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) :
    𝐄 (fun x ↦ √(h_{A} x)) ≥ B_{w₁} ｜A｜ := by
  sorry

/-
valid for all $A\subset \{0,1\}^n$.
-/

/-! ### Remark 2.1 -/

/-- **Remark 2.1** ([DIRX]). The result remains valid for an interval of values $w$: there is a
non-degenerate interval $[a,b]$ such that (2.4) holds for all $w\in[a,b]$. -/
theorem rem_2_1 :
    ∃ a b : ℝ, a < b ∧ Icc a b ⊆ Ioc (1 / 2) 1 ∧
      ∀ w ∈ Icc a b, ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G (B_{w}) x y ≥ 0 := by
  sorry

/-- The optimal (smallest) value $w_*$ of $w$ for which (2.4) holds ([DIRX], Remark 2.1):
$w_*=\inf\{w\in(\frac12,1] : G[B_w](x,y)\ge0\text{ for all }0\le x\le y\le1\}$. -/
noncomputable def wStar : ℝ :=
  sInf {w : ℝ | w ∈ Ioc (1 / 2 : ℝ) 1 ∧ ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G (B_{w}) x y ≥ 0}

/-
\begin{rem}[Remark 2.1, continued]
It could be interesting to further investigate the optimal (smallest) value $w_*$ of $w$, but we
will not pursue this here. Numerical evidence suggests that $w_*\in [0.897, 0.898]$.
\end{rem}
(Numerical evidence only; not stated as a theorem.)
-/

/-! ### Remark 2.2 -/

/-
\begin{rem}[Remark 2.2]
It is also interesting to ask what the sharp behavior of $\mathbf{E}\sqrt{h_A}$ is as $|A|\to 1-$.
While our new isoperimetric inequality \eqref{eqn:isoperim2} [(2.5)] improves on the
corresponding inequality proved in \cite[(2.7)]{DIR24} for all values of $|A|\le \frac12$, this
changes when $|A|>\frac12$.
-/

/-- **Remark 2.2** ([DIRX]), first claim: (2.5) improves on [DIR, (2.7)]
($\mathcal{B}_{\frac12}\ge0.997\cdot b_{\frac12}$, `Auto.DIR.cor_2_5`) for all values
$|A|\le\frac12$: $B_{w_1}(x)>0.997\,b_{\frac12}(x)$ for $x\in(0,\frac12]$ (`b` is
$b_\beta$ of [DIR], (2.3)). -/
theorem rem_2_2_improves (x : ℝ) (hx : x ∈ Ioc (0 : ℝ) (1 / 2)) :
    B_{w₁} x > 0.997 * b (1 / 2) x := by
  sorry

/-
Specifically, for $|A|$ near $1$, the inequality \cite[(2.7)]{DIR24} is slightly stronger than
\eqref{eqn:isoperim2} [(2.5)].
-/

/-- **Remark 2.2** ([DIRX]): for $|A|$ near $1$, [DIR, (2.7)] is slightly stronger than (2.5):
there is $\delta>0$ with $0.997\,b_{\frac12}(x)>B_{w_1}(x)$ for $x\in(1-\delta,1)$. -/
theorem rem_2_2_near_one :
    ∃ δ > 0, ∀ x ∈ Ioo (1 - δ) 1, 0.997 * b (1 / 2) x > B_{w₁} x := by
  sorry

/-
Similarly, for all values of $|A|>\frac12$, the inequality \cite[(2.6)]{DIR24}, which gives sharp
lower bounds for $\mathbf{E}h_A^\beta$ when $\beta\ge \beta_0=0.50057$, is stronger than the
estimate $\mathbf{E} h_A^\beta\ge {\mathrm{J}}(|A|)$ that follows from \eqref{eqn:isoperim2}
[(2.5)].
-/

/-- **Remark 2.2** ([DIRX]): the estimate $\mathbf{E}h_A^\beta\ge\mathrm{J}(|A|)$ for
$\beta\ge\frac12$ and $|A|\ge\frac12$ follows from (2.5). -/
theorem rem_2_2_rpow_ge_J (n : ℕ) (hn : 1 ≤ n) (β : ℝ) (hβ : 1 / 2 ≤ β) (A : Set ({0,1}^n))
    (hA : ｜A｜ ≥ 1 / 2) :
    𝐄 h_{A} ^ β ≥ J ｜A｜ := by
  sorry

/-- **Remark 2.2** ([DIRX]): for all values $x=|A|>\frac12$, [DIR, (2.6)]
($\mathcal{B}_{\beta_0}\ge b_{\beta_0}$, where $b_{\beta_0}(x)$ is the function $J$ of [DIR] for
$x\ge\frac12$) is stronger than the estimate $\mathbf{E}h_A^\beta\ge\mathrm{J}(|A|)$:
$b_{\beta_0}(x)>\mathrm{J}(x)$ for $x\in(\frac12,1)$. -/
theorem rem_2_2_stronger (x : ℝ) (hx : x ∈ Ioo (1 / 2 : ℝ) 1) : b β₀ x > J x := by
  sorry


/-
This is consistent with the fact that ``Case $J$'' in \cite[\S 6]{DIR24} is more difficult to
handle than Case $J$ in the present paper (see \S \ref{sec:caseJ} [§3.1]). For $\beta\ge\beta_0$
and $|A|>\frac12$, the best known lower bound is that given in \cite[Thm. 1.6]{DIR24}, which
further improves on \cite[(2.6)]{DIR24} as $|A|\to 1-$.
\end{rem}
(\cite[Thm. 1.6]{DIR24} is Theorem 1.7 of the revised version of [DIR], `Auto.DIR.thm_1_7`; see
the discrepancy paragraph of `Auto.DIRX.rem_2_2_thm_1_7_improves` below.)
-/

/-- **Remark 2.2** ([DIRX]), last claim: for $\beta\ge\beta_0$ and $|A|>\frac12$ the best known
lower bound is that of [DIR, Theorem 1.7] (cited as "[DIR24, Thm. 1.6]"),
$\mathbf{E}h_A^{\beta_0}\ge\max(J(|A|),(1-|A|)(\log_2(1/(1-|A|)))^{\beta_0})$
(`Auto.DIR.thm_1_7`, stated there for $\beta=\beta_0$), which further improves on [DIR, (2.6)]
($\mathcal{B}_{\beta_0}\ge b_{\beta_0}$) as $|A|\to1-$: there is $\delta>0$ with
$(1-x)(\log_2(1/(1-x)))^{\beta_0}>b_{\beta_0}(x)$ for $x\in(1-\delta,1)$ (by [DIR], (2.9) this can
only happen for $x>1-10^{-10^{380}}$). The comparison "best known" itself is not a
mathematical claim and is not formalized.

**Discrepancy with the paper.** [DIRX] cites "[DIR24, Thm. 1.6]". This is the theorem number of
the first arXiv version of [DIR]; in the revised version [DIR] (arXiv:2407.12674v2, formalized
here) the inequality $\mathbf{E}h_A^\beta\ge\max(J(|A|),(1-|A|)(\log_2(1/(1-|A|)))^\beta)$ is
Theorem 1.7 (`Auto.DIR.thm_1_7`), while Theorem 1.6 of v2 is a different statement (the bound
(1.4) of [DIR] for $\mathbf{E}\sqrt{h_A}$, `Auto.DIR.thm_1_6`). The Lean
statement refers to v2's Theorem 1.7. -/
theorem rem_2_2_thm_1_7_improves :
    ∃ δ > 0, ∀ x ∈ Ioo (1 - δ) 1, (1 - x) * (log₂ (1 / (1 - x))) ^ β₀ > b β₀ x := by
  sorry

end Auto.DIRX
