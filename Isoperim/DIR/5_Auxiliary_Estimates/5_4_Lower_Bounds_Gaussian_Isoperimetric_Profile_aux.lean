    Tendsto (fun s : ℝ ↦ exp (-s ^ 2 / 2)) atBot (𝓝 0) := by
  refine tendsto_exp_atBot.comp (tendsto_atBot_mono' atBot ?_ tendsto_id)
  filter_upwards [eventually_le_atBot (-2 : ℝ)] with s hs
