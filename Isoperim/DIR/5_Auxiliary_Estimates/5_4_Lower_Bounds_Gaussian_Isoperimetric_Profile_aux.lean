theorem exp_neg_ge_cubic {v : ℝ} (hv : 0 ≤ v) : 1 - v + v ^ 2 / 2 - v ^ 3 / 6 ≤ exp (-v) := by
  have h := expNegTaylor_le_exp_neg 1 hv
  simp only [expNegTaylor, Finset.sum_range_succ, Finset.sum_range_zero] at h
  norm_num [Nat.factorial] at h
  linarith

