/-- $s\mapsto e^{-s^2/2}$ is integrable. -/
theorem integrable_exp_neg_sq_half : Integrable (fun s : ℝ ↦ exp (-s ^ 2 / 2)) := by
  have := integrable_exp_neg_mul_sq (b := 2⁻¹) (by norm_num)
