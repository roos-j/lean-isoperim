    have h3 : -(-1 : ℝ) ^ 2 / 2 = -2⁻¹ := by norm_num
    rw [h3]
    nlinarith
  obtain ⟨t, ht, hte⟩ := intermediate_value_Icc hab hc ⟨ha, hb⟩
  exact ⟨t, by linarith [ht.2], hte⟩

/-- $\log(2\pi^{1/2})\ge\frac12$. -/
theorem half_le_log_two_mul_sqrt_pi : 2⁻¹ ≤ log (2 * π ^ (2⁻¹ : ℝ)) := by
