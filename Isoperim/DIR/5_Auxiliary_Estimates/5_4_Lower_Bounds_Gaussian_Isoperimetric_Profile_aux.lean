/-- [DIR], proof of Proposition 5.11: integration by parts. -/
theorem integral_Iic_exp_ibp (t : ℝ) (ht : t < 0) :
    ∫ s in Iic t, exp (-s ^ 2 / 2) = -t⁻¹ * exp (-t ^ 2 / 2) - ∫ s in Iic t, s ^ (-2 : ℤ) *
        exp (-s ^ 2 / 2) := by
  have hF : ∀ s ∈ Iio t, HasDerivAt (fun s : ℝ ↦ -s⁻¹ * exp (-s ^ 2 / 2))
      (exp (-s ^ 2 / 2) + s ^ (-2 : ℤ) * exp (-s ^ 2 / 2)) s := by
    intro s hs
    have hs0 : s ≠ 0 := by simp at hs; linarith
    have h1 : HasDerivAt (fun s : ℝ ↦ -s⁻¹) ((s ^ 2)⁻¹) s := by
      simpa using (hasDerivAt_inv hs0).fun_neg
    have h3 : HasDerivAt (fun s : ℝ ↦ -s ^ 2 / 2) (-s) s := by
      have := (hasDerivAt_pow 2 s).const_mul (-1 / 2 : ℝ)
      convert this using 1
      · ext y; ring
      · push_cast; ring
    have h2 : HasDerivAt (fun s : ℝ ↦ exp (-s ^ 2 / 2)) (exp (-s ^ 2 / 2) * (-s)) s :=
      h3.exp
    convert h1.mul h2 using 1
    simp only [zpow_neg, zpow_two]
    field_simp
    ring
  have hint := (integrable_exp_neg_sq_half.integrableOn (s := Iic t)).add
    (integrableOn_zpow_mul_exp ht)
  have hlim : Tendsto (fun s : ℝ ↦ -s⁻¹ * exp (-s ^ 2 / 2)) atBot (𝓝 0) := by
    have := (tendsto_inv_atBot_zero.neg).mul tendsto_exp_neg_sq_half_atBot
    simpa using this
  have hcont : ContinuousWithinAt (fun s : ℝ ↦ -s⁻¹ * exp (-s ^ 2 / 2)) (Iic t) t := by
    refine ContinuousAt.continuousWithinAt ?_
    exact ((continuousAt_inv₀ ht.ne).neg).mul (by fun_prop)
  have h := integral_Iic_of_hasDerivAt_of_tendsto hcont hF hint hlim
  rw [integral_add integrable_exp_neg_sq_half.integrableOn (integrableOn_zpow_mul_exp ht)] at h
  linarith

/-- $\exp(1.6)<5$, i.e. $\log5>1.6$. -/
theorem log_five_gt : (1.6 : ℝ) < log 5 := by
  rw [lt_log_iff_exp_lt (by norm_num)]
  have h8 : exp (1.6 : ℝ) ^ 5 = exp 1 ^ 8 := by
    rw [← exp_nat_mul, ← exp_nat_mul]; norm_num
  have he := exp_one_lt_d9
  have h1 : exp 1 ^ 8 < (2.7182818286 : ℝ) ^ 8 := by gcongr
  have h2 : exp (1.6 : ℝ) ^ 5 < 5 ^ 5 := by
    rw [h8]; linarith [h1, show (2.7182818286 : ℝ) ^ 8 < 5 ^ 5 by norm_num]
  exact lt_of_pow_lt_pow_left₀ 5 (by norm_num) h2

