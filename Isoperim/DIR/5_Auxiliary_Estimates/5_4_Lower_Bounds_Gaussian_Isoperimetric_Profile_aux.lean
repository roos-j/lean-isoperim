    rw [← exp_nat_mul, ← exp_add]; norm_num
  have he := exp_one_gt_d9
  have h1 : (2.7182818283 : ℝ) ^ 3 < exp 1 ^ 3 := by gcongr
  have h2 := quadratic_le_exp_of_nonneg (x := (0.2 : ℝ)) (by norm_num)
  rw [h]
  have h3 : (0 : ℝ) < exp 1 ^ 3 := by positivity
  nlinarith

/-- For $y\ge1.6$: $\frac{\log(2\pi^{1/2})}{y}+\frac12\frac{\log y}{y}<1$ (the bound
$\varepsilon<1$ in the proof of Proposition 5.11). -/
theorem eps_lt_one_of_ge {y : ℝ} (hy : 1.6 ≤ y) :
    log (2 * π ^ (2⁻¹ : ℝ)) / y + 2⁻¹ * (log y / y) < 1 := by
  have hy0 : 0 < y := by linarith
  have hπ : π ^ (2⁻¹ : ℝ) = √π := by rw [sqrt_eq_rpow, one_div]
  rw [hπ]
  have hkey : log (2 * √π) + 2⁻¹ * log y < y := by
    have heq : log (2 * √π) + 2⁻¹ * log y = log (2 * √π * √y) := by
      rw [log_mul (x := 2 * √π) (y := √y) (by positivity) (by positivity), log_sqrt hy0.le]
      ring
    rw [heq, log_lt_iff_lt_exp (by positivity)]
    refine lt_of_pow_lt_pow_left₀ 2 (exp_pos y).le ?_
    have hl : (2 * √π * √y) ^ 2 = 4 * π * y := by
      rw [mul_pow, mul_pow, sq_sqrt pi_pos.le, sq_sqrt hy0.le]; ring
    have hr : exp y ^ 2 = exp 3.2 * exp (2 * y - 3.2) := by
      rw [← exp_nat_mul, ← exp_add]; norm_num
    rw [hl, hr]
    have h1 := add_one_le_exp (2 * y - 3.2)
    have h2 := exp_three_two_gt
    have h3 := pi_lt_d2
    nlinarith
  have : log (2 * √π) / y + 2⁻¹ * (log y / y) = (log (2 * √π) + 2⁻¹ * log y) / y := by
    ring
  rw [this, div_lt_one hy0]
  exact hkey

