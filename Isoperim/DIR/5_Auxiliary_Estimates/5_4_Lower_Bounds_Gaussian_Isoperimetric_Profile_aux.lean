  simp only
  congr 1
  ring

/-- For $t<0$, $s\mapsto s^{-2}e^{-s^2/2}$ is integrable on $(-\infty,t]$. -/
theorem integrableOn_zpow_mul_exp {t : ℝ} (ht : t < 0) :
    IntegrableOn (fun s : ℝ ↦ s ^ (-2 : ℤ) * exp (-s ^ 2 / 2)) (Iic t) := by
  refine Integrable.mono' (integrable_exp_neg_sq_half.integrableOn.const_mul (t ^ (-2 : ℤ)))
    ?_ ?_
  · refine ContinuousOn.aestronglyMeasurable ?_ measurableSet_Iic
    refine ContinuousOn.mul ?_ (by fun_prop)
    exact continuousOn_id.zpow₀ _ fun s hs ↦ Or.inl (by simp at hs ⊢; linarith)
  · refine ae_restrict_of_forall_mem measurableSet_Iic fun s hs ↦ ?_
    simp only [mem_Iic] at hs
    have hs0 : s < 0 := hs.trans_lt ht
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (exp_pos _)]
    refine mul_le_mul_of_nonneg_right ?_ (exp_pos _).le
    simp only [zpow_neg, zpow_two]
    rw [abs_inv, abs_mul]
    rw [abs_of_neg hs0]
    exact inv_anti₀ (mul_pos_of_neg_of_neg ht ht) (by nlinarith)

