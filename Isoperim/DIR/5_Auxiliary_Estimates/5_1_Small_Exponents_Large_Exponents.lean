/-! ### §5.1 Small exponents versus large exponents -/

/-- **Lemma 5.1** ([DIR]). If $\mathbf{E}h_A^\beta\ge B(|A|)>0$ holds for some $\beta>0$, then for
all $\tilde\beta\ge\beta$,
$$\mathbf{E}h_A^{\tilde\beta}\ge B(|A|)^{\frac{\tilde\beta}\beta}|A|^{-\frac{\tilde\beta}\beta+1}.$$
In particular, if (1.1) holds for $\beta_0$, then it holds for all $\beta\ge\beta_0$. -/
theorem lemma_5_1 :
    (∀ (n : ℕ) (A : Set ({0,1}^n)) (B : ℝ → ℝ) (β : ℝ), 0 < β →
      𝐄 h_{A} ^ β ≥ B ｜A｜ → B ｜A｜ > 0 →
      ∀ β' : ℝ, β ≤ β' → 𝐄 h_{A} ^ β' ≥ B ｜A｜ ^ (β' / β) * ｜A｜ ^ (-(β' / β) + 1)) ∧
    ((∀ (n : ℕ), 1 ≤ n → ∀ A : Set ({0,1}^n), ｜A｜ ≤ 1 / 2 →
        𝐄 h_{A} ^ β₀ ≥ ｜A｜ * (log₂ (1 / ｜A｜)) ^ β₀) →
      ∀ β : ℝ, β₀ ≤ β → ∀ (n : ℕ), 1 ≤ n → ∀ A : Set ({0,1}^n), ｜A｜ ≤ 1 / 2 →
        𝐄 h_{A} ^ β ≥ ｜A｜ * (log₂ (1 / ｜A｜)) ^ β) := by
  sorry

