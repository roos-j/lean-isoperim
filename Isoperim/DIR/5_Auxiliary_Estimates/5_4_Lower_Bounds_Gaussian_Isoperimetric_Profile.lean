section Proof_Proposition_5_11
/-- [DIR], proof of Proposition 5.11: let $t<0$. Integration by parts shows
$\int_{-\infty}^te^{-s^2/2}\,ds=-t^{-1}e^{-t^2/2}-\int_{-\infty}^ts^{-2}e^{-s^2/2}\,ds$. -/
theorem prop_5_11_ibp (t : ℝ) (ht : t < 0) :
    ∫ s in Iic t, exp (-s ^ 2 / 2) = -t⁻¹ * exp (-t ^ 2 / 2) - ∫ s in Iic t, s ^ (-2 : ℤ) *
        exp (-s ^ 2 / 2) :=
  integral_Iic_exp_ibp t ht

/-- [DIR], proof of Proposition 5.11: thus
$\Phi(t)=|t|^{-1}\varphi(t)-\int_{-\infty}^ts^{-2}\varphi(s)\,ds\le|t|^{-1}\varphi(t)$. -/
theorem prop_5_11_Phi_le (t : ℝ) (ht : t < 0) :
    Φ t = |t|⁻¹ * φ t - ∫ s in Iic t, s ^ (-2 : ℤ) * φ s ∧
      |t|⁻¹ * φ t - ∫ s in Iic t, s ^ (-2 : ℤ) * φ s ≤ |t|⁻¹ * φ t := by
  have hnn : 0 ≤ ∫ s in Iic t, s ^ (-2 : ℤ) * φ s :=
    setIntegral_nonneg measurableSet_Iic fun s _ ↦
      mul_nonneg (by simp only [zpow_neg, zpow_two]; exact inv_nonneg.2 (mul_self_nonneg s))
        (by unfold φ; positivity)
  refine ⟨?_, by linarith⟩
  have h1 : Φ t = (2 * π) ^ (-(2⁻¹ : ℝ)) * ∫ s in Iic t, exp (-s ^ 2 / 2) :=
    integral_const_mul _ _
  have h2 : ∫ s in Iic t, s ^ (-2 : ℤ) * φ s =
      (2 * π) ^ (-(2⁻¹ : ℝ)) * ∫ s in Iic t, s ^ (-2 : ℤ) * exp (-s ^ 2 / 2) := by
    rw [← integral_const_mul]
    congr 1
    ext s
    simp only [φ]
    ring
  rw [h1, h2, prop_5_11_ibp t ht, abs_of_neg ht]
  simp only [φ]
  ring

/-- [DIR], proof of Proposition 5.11: $I=\varphi\circ\Phi^{-1}$ is an increasing function on
$[0,\frac12]$; applying it on both sides, $\varphi(t)\le I(|t|^{-1}\varphi(t))$, at least as long
as $x=|t|^{-1}\varphi(t)\le\frac12$. This means $I(x)\ge x\cdot|t|$. -/
theorem prop_5_11_apply_I (t : ℝ) (ht : t < 0) (hx : |t|⁻¹ * φ t ≤ 2⁻¹) :
    MonotoneOn I (Icc 0 2⁻¹) ∧ φ t ≤ I (|t|⁻¹ * φ t) ∧
      I (|t|⁻¹ * φ t) ≥ |t|⁻¹ * φ t * |t| := by
  have hI : I = gProf := rfl
  have hΦ : Φ = gCDF := rfl
  have hφ : φ = gDens := rfl
  have hmono : MonotoneOn I (Icc 0 2⁻¹) := hI ▸ gProf_strictMonoOn.monotoneOn
  have hle := prop_5_11_Phi_le t ht
  have hΦle : Φ t ≤ |t|⁻¹ * φ t := hle.1 ▸ hle.2
  have hΦpos : 0 < Φ t := (gCDF_mem_Ioo t).1
  have h1 : φ t ≤ I (|t|⁻¹ * φ t) := by
    have := hmono ⟨hΦpos.le, hΦle.trans hx⟩ ⟨hΦpos.le.trans hΦle, hx⟩ hΦle
    have h2 : I (Φ t) = φ t := by rw [hI, hΦ, hφ]; exact gProf_gCDF t
    rwa [h2] at this
  refine ⟨hmono, h1, ?_⟩
  have ht0 : |t| ≠ 0 := abs_ne_zero.2 ht.ne
  have h3 : |t|⁻¹ * φ t * |t| = φ t := by field_simp
  rw [h3]
  exact h1

/-- [DIR], proof of Proposition 5.11: rewriting $x|t|=(2\pi)^{-1/2}e^{-t^2/2}$ (with
$x=|t|^{-1}\varphi(t)$), we have $|t|=\sqrt2\sqrt{\log(1/x)-\log((2\pi)^{1/2}|t|)}$ (the expression
under the square root is positive because it equals $t^2/2$). -/
theorem prop_5_11_t_formula (t : ℝ) (ht : t < 0) :
    |t|⁻¹ * φ t * |t| = (2 * π) ^ (-(2⁻¹ : ℝ)) * exp (-t ^ 2 / 2) ∧
    log ((|t|⁻¹ * φ t)⁻¹) - log ((2 * π) ^ (2⁻¹ : ℝ) * |t|) = t ^ 2 / 2 ∧
    |t| = √2 * √(log ((|t|⁻¹ * φ t)⁻¹) - log ((2 * π) ^ (2⁻¹ : ℝ) * |t|)) := by
  have ht0 : |t| ≠ 0 := abs_ne_zero.2 ht.ne
  have hpos : 0 < |t| := abs_pos.2 ht.ne
  have h1 : |t|⁻¹ * φ t * |t| = (2 * π) ^ (-(2⁻¹ : ℝ)) * exp (-t ^ 2 / 2) := by
    rw [inv_mul_eq_div, div_mul_cancel₀ _ ht0]; rfl
  have hA : (|t|⁻¹ * φ t)⁻¹ = ((2 * π) ^ (2⁻¹ : ℝ) * |t|) * exp (t ^ 2 / 2) := by
    simp only [φ]
    rw [rpow_neg (by positivity), mul_inv, mul_inv, inv_inv, inv_inv, ← exp_neg]
    ring_nf
  have h2 : log ((|t|⁻¹ * φ t)⁻¹) - log ((2 * π) ^ (2⁻¹ : ℝ) * |t|) = t ^ 2 / 2 := by
    rw [hA, log_mul (by positivity) (exp_pos _).ne', log_exp]
    ring
  refine ⟨h1, h2, ?_⟩
  rw [h2, ← sqrt_mul (by norm_num), show 2 * (t ^ 2 / 2) = t ^ 2 by ring, sqrt_sq_eq_abs]

/-- [DIR], proof of Proposition 5.11: the assumption $x\le\frac12$ implies $|t|>0.64$, which also
means $(2\pi)^{1/2}|t|>1$, and thus $|t|\le\sqrt2\sqrt{\log(1/x)}$. -/
theorem prop_5_11_t_bounds (t : ℝ) (ht : t < 0) (hx : |t|⁻¹ * φ t ≤ 2⁻¹) :
    |t| > 0.64 ∧ (2 * π) ^ (2⁻¹ : ℝ) * |t| > 1 ∧ |t| ≤ √2 * √(log ((|t|⁻¹ * φ t)⁻¹)) := by
  have hpos : 0 < |t| := abs_pos.2 ht.ne
  have hsq : (2 * π) ^ (2⁻¹ : ℝ) = √(2 * π) := by rw [sqrt_eq_rpow, one_div]
  have hb := sqrt_two_pi_bounds
  have h1 : |t| > 0.64 := by
    by_contra hc
    replace hc := not_lt.1 hc
    have he : exp (-(0.2048 : ℝ)) ≤ exp (-t ^ 2 / 2) := by
      rw [exp_le_exp]
      have : t ^ 2 = |t| ^ 2 := (sq_abs t).symm
      nlinarith
    have hc3 := exp_neg_ge_cubic (v := 0.2048) (by norm_num)
    have hg := gConst_gt
    have hφ : 0.3989 * 0.8147 ≤ φ t := by
      simp only [φ]
      have : (0.8147 : ℝ) ≤ exp (-t ^ 2 / 2) := by nlinarith
      nlinarith [exp_pos (-t ^ 2 / 2)]
    have : |t|⁻¹ * φ t ≥ φ t / 0.64 := by
      rw [inv_mul_eq_div]
      exact div_le_div_of_nonneg_left (by unfold φ; positivity) hpos hc
    have : φ t / 0.64 > 2⁻¹ := by rw [gt_iff_lt, lt_div_iff₀ (by norm_num)]; nlinarith
    linarith
  have h2 : (2 * π) ^ (2⁻¹ : ℝ) * |t| > 1 := by rw [hsq]; nlinarith
  refine ⟨h1, h2, ?_⟩
  have hf := (prop_5_11_t_formula t ht).2.2
  have hA : 0 < log ((2 * π) ^ (2⁻¹ : ℝ) * |t|) := log_pos h2
  calc |t| = _ := hf
    _ ≤ _ := by gcongr; linarith

/-- [DIR], proof of Proposition 5.11: this, in turn, implies
$\log((2\pi)^{1/2}|t|)\le\log(2\pi^{1/2}\sqrt{\log(1/x)})=\log(2\pi^{1/2})+\frac12\log\log(1/x)$. -/
theorem prop_5_11_log_bound (t : ℝ) (ht : t < 0) (hx : |t|⁻¹ * φ t ≤ 2⁻¹) :
    log ((2 * π) ^ (2⁻¹ : ℝ) * |t|) ≤
        log (2 * π ^ (2⁻¹ : ℝ) * √(log ((|t|⁻¹ * φ t)⁻¹))) ∧
      log (2 * π ^ (2⁻¹ : ℝ) * √(log ((|t|⁻¹ * φ t)⁻¹))) =
        log (2 * π ^ (2⁻¹ : ℝ)) + 2⁻¹ * log (log ((|t|⁻¹ * φ t)⁻¹)) := by
  obtain ⟨-, h2, h3⟩ := prop_5_11_t_bounds t ht hx
  have hsq : (2 * π) ^ (2⁻¹ : ℝ) = √2 * √π := by
    rw [← sqrt_mul (by norm_num), sqrt_eq_rpow, one_div]
  have hsq' : π ^ (2⁻¹ : ℝ) = √π := by rw [sqrt_eq_rpow, one_div]
  have hx0 : 0 < |t|⁻¹ * φ t := by
    have := abs_pos.2 ht.ne; unfold φ; positivity
  have hL : 0 < log ((|t|⁻¹ * φ t)⁻¹) := by
    apply log_pos
    rw [one_lt_inv₀ hx0]; linarith
  constructor
  · refine log_le_log (by linarith) ?_
    rw [hsq, hsq']
    have h22 : √2 * √2 = 2 := mul_self_sqrt (by norm_num)
    calc √2 * √π * |t| ≤ √2 * √π * (√2 * √(log ((|t|⁻¹ * φ t)⁻¹))) := by gcongr
      _ = _ := by linear_combination (√π * √(log ((|t|⁻¹ * φ t)⁻¹))) * h22
  · rw [log_mul (by positivity) (sqrt_pos.2 hL).ne', log_sqrt hL.le]
    ring

/-- [DIR], proof of Proposition 5.11: we can write $\sqrt2\sqrt{\log(1/x)}\sqrt{1-\varepsilon}=|t|$,
where $\varepsilon=(\log(1/x))^{-1}\log((2\pi)^{1/2}|t|)$ satisfies
$\varepsilon\le\frac{\log(2\pi^{1/2})}{\log(1/x)}+\frac12\frac{\log\log(1/x)}{\log(1/x)}$. -/
theorem prop_5_11_eps (t : ℝ) (ht : t < 0) (hx : |t|⁻¹ * φ t ≤ 2⁻¹) :
    √2 * √(log ((|t|⁻¹ * φ t)⁻¹)) *
        √(1 - (log ((|t|⁻¹ * φ t)⁻¹))⁻¹ * log ((2 * π) ^ (2⁻¹ : ℝ) * |t|)) = |t| ∧
    (log ((|t|⁻¹ * φ t)⁻¹))⁻¹ * log ((2 * π) ^ (2⁻¹ : ℝ) * |t|) ≤
      log (2 * π ^ (2⁻¹ : ℝ)) / log ((|t|⁻¹ * φ t)⁻¹) +
        2⁻¹ * (log (log ((|t|⁻¹ * φ t)⁻¹)) / log ((|t|⁻¹ * φ t)⁻¹)) := by
  have hx0 : 0 < |t|⁻¹ * φ t := by
    have := abs_pos.2 ht.ne; unfold φ; positivity
  have hL : 0 < log ((|t|⁻¹ * φ t)⁻¹) := by
    apply log_pos
    rw [one_lt_inv₀ hx0]; linarith
  obtain ⟨hb1, hb2⟩ := prop_5_11_log_bound t ht hx
  constructor
  · rw [mul_assoc, ← sqrt_mul hL.le, mul_sub, mul_one, ← mul_assoc, mul_inv_cancel₀ hL.ne',
      one_mul]
    exact (prop_5_11_t_formula t ht).2.2.symm
  · have h := hb1.trans hb2.le
    rw [inv_mul_eq_div]
    have : log (2 * π ^ (2⁻¹ : ℝ)) / log ((|t|⁻¹ * φ t)⁻¹) +
        2⁻¹ * (log (log ((|t|⁻¹ * φ t)⁻¹)) / log ((|t|⁻¹ * φ t)⁻¹)) =
        (log (2 * π ^ (2⁻¹ : ℝ)) + 2⁻¹ * log (log ((|t|⁻¹ * φ t)⁻¹))) /
          log ((|t|⁻¹ * φ t)⁻¹) := by ring
    rw [this]
    exact div_le_div_of_nonneg_right h hL.le

/-- The bound
$\varepsilon(x)=\frac{\log(2\pi^{1/2})}{\log(1/x)}+\frac12\frac{\log\log(1/x)}{\log(1/x)}$
for the relative error in Proposition 5.11 ([DIR], proof of Proposition 5.11). -/
noncomputable def εI (x : ℝ) : ℝ :=
  log (2 * π ^ (2⁻¹ : ℝ)) / log x⁻¹ + 2⁻¹ * (log (log x⁻¹) / log x⁻¹)

/-- [DIR], proof of Proposition 5.11: the bound for $\varepsilon$ tends to $0$ as $x\to0^+$; in
particular $\varepsilon<1$ if $x\le\frac15$. -/
theorem prop_5_11_eps_small :
    Tendsto εI (𝓝[>] 0) (𝓝 0) ∧ ∀ x ∈ Ioc (0 : ℝ) 5⁻¹, εI x < 1 := by
  constructor
  · have hL : Tendsto (fun x : ℝ ↦ log x⁻¹) (𝓝[>] 0) atTop :=
      tendsto_log_atTop.comp tendsto_inv_nhdsGT_zero
    have h1 : Tendsto (fun y : ℝ ↦ log (2 * π ^ (2⁻¹ : ℝ)) / y) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop tendsto_id
    have h2 : Tendsto (fun y : ℝ ↦ log y / y) atTop (𝓝 0) := by
      simpa using tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero
    have := (h1.add (h2.const_mul 2⁻¹)).comp hL
    rw [show (0 : ℝ) + 2⁻¹ * 0 = 0 by norm_num] at this
    exact this
  · intro x hx
    have hx0 := hx.1
    have h5 : (5 : ℝ) ≤ x⁻¹ := by rw [le_inv_comm₀ (by norm_num) hx0]; exact hx.2
    have hy : (1.6 : ℝ) ≤ log x⁻¹ := (log_five_gt.le).trans (log_le_log (by norm_num) h5)
    exact eps_lt_one_of_ge hy

/-- [DIR], proof of Proposition 5.11: thus
$I(x)\ge\sqrt2\cdot x\sqrt{\log(1/x)}\sqrt{1-\varepsilon}$, and using $\sqrt{1-\varepsilon}\ge
1-\varepsilon$ (since $\varepsilon\le1$) the claim follows. (The inequality also needs
$\varepsilon\ge0$, which holds here since $(2\pi)^{1/2}|t|>1$; it fails for $\varepsilon<0$.) -/
theorem prop_5_11_final (ε : ℝ) (hε₀ : 0 ≤ ε) (hε : ε ≤ 1) : √(1 - ε) ≥ 1 - ε := by
  rw [ge_iff_le, le_sqrt (by linarith) (by linarith)]
  nlinarith

end Proof_Proposition_5_11

/-- **Proposition 5.11** ([DIR]). For all $0<x\le\frac15$:
$$I(x)\ge\sqrt2\cdot x\sqrt{\log(1/x)}\Big(1-\frac12\frac{\log\log(1/x)}{\log(1/x)}
-\frac{\log(2\pi^{1/2})}{\log(1/x)}\Big).$$ -/
theorem prop_5_11 (x : ℝ) (hx : x ∈ Ioc (0 : ℝ) 5⁻¹) :
    I x ≥ √2 * x * √(log x⁻¹) *
      (1 - 2⁻¹ * (log (log x⁻¹) / log x⁻¹) - log (2 *
          π ^ (2⁻¹ : ℝ)) / log x⁻¹) := by
  obtain ⟨t, ht, hte⟩ := exists_neg_abs_inv_mul_gDens x hx
  have hte' : |t|⁻¹ * φ t = x := hte
  subst hte'
  have hεs := prop_5_11_eps_small.2 _ hx
  have hx2 : |t|⁻¹ * φ t ≤ 2⁻¹ := hx.2.trans (by norm_num)
  obtain ⟨-, h2, -⟩ := prop_5_11_t_bounds t ht hx2
  obtain ⟨he1, he2⟩ := prop_5_11_eps t ht hx2
  obtain ⟨-, -, hI⟩ := prop_5_11_apply_I t ht hx2
  have hx0 : 0 < |t|⁻¹ * φ t := hx.1
  set x := |t|⁻¹ * φ t with hxdef
  set L := log x⁻¹ with hLdef
  set A := log ((2 * π) ^ (2⁻¹ : ℝ) * |t|) with hAdef
  have hA : 0 < A := log_pos h2
  have hL : 0 < L := by
    apply log_pos
    rw [one_lt_inv₀ hx0]; linarith
  have hε0 : 0 ≤ L⁻¹ * A := by positivity
  have hε1 : L⁻¹ * A ≤ εI x := by
    simp only [εI]; exact he2
  have hsq := prop_5_11_final (L⁻¹ * A) hε0 (by linarith)
  have hR : 1 - 2⁻¹ * (log L / L) - log (2 * π ^ (2⁻¹ : ℝ)) / L = 1 - εI x := by
    simp only [εI]; ring
  rw [hR]
  have hpos : 0 ≤ √2 * x * √L := by positivity
  calc I x ≥ x * |t| := hI
    _ = √2 * x * √L * √(1 - L⁻¹ * A) := by rw [← he1]; ring
    _ ≥ √2 * x * √L * (1 - L⁻¹ * A) := by gcongr
    _ ≥ √2 * x * √L * (1 - εI x) := by gcongr

/-- [DIR], §5.4, after Corollary 5.12: from (3.4), $J(1-x)=\sqrt2w_0I(xw_0^{-1})$ (for
$0\le x\le\frac12$), and $w_0\in[0.895,0.896]$. -/
theorem J_one_sub (x : ℝ) (hx : x ∈ Icc (0 : ℝ) 2⁻¹) : J (1 - x) = √2 * w₀ * I (x *
    w₀⁻¹) := by
  rw [eqn_3_4 (1 - x) ⟨by linarith [hx.2], by linarith [hx.1]⟩, Jw]
  congr 2
  ring

/-- The quantity
$\varepsilon=\frac12\frac{\log\log(w_0/x)}{\log(w_0/x)}+\frac{\log(2\pi^{1/2})}{\log(w_0/x)}$
([DIR], §5.4, after (5.10)). -/
noncomputable def εJ (x : ℝ) : ℝ :=
  2⁻¹ * (log (log (w₀ / x)) / log (w₀ / x)) + log (2 * π ^ (2⁻¹ : ℝ)) / log (w₀ / x)

/-- **(5.10)** ([DIR], §5.4). Thus
$$J(1-x)\ge2x\sqrt{\log(w_0/x)}(1-\varepsilon),$$
where $\varepsilon=\frac12\frac{\log\log(w_0/x)}{\log(w_0/x)}+\frac{\log(2\pi^{1/2})}{\log(w_0/x)}$
(for $0<x\le\frac{w_0}5$, where Proposition 5.11 applies). -/
theorem eqn_5_10 (x : ℝ) (hx : x ∈ Ioc 0 (w₀ / 5)) : J (1 - x) ≥ 2 * x * √(log (w₀ / x)) *
    (1 - εJ x) := by
  have hw := w₀_mem
  have hw0 : 0 < w₀ := by linarith [hw.1]
  have hx0 := hx.1
  have hy : x * w₀⁻¹ ∈ Ioc (0 : ℝ) 5⁻¹ := by
    refine ⟨by positivity, ?_⟩
    rw [← div_eq_mul_inv, div_le_iff₀ hw0]; linarith [hx.2]
  have hP := prop_5_11 _ hy
  have hinv : (x * w₀⁻¹)⁻¹ = w₀ / x := by field_simp
  rw [hinv] at hP
  rw [J_one_sub x ⟨hx0.le, by linarith [hx.2, hw.2]⟩]
  have h22 : √2 * √2 = 2 := mul_self_sqrt (by norm_num)
  have hR : 1 - 2⁻¹ * (log (log (w₀ / x)) / log (w₀ / x)) - log (2 * π ^ (2⁻¹ : ℝ)) /
      log (w₀ / x) = 1 - εJ x := by simp only [εJ]; ring
  rw [hR] at hP
  calc √2 * w₀ * I (x * w₀⁻¹)
      ≥ √2 * w₀ * (√2 * (x * w₀⁻¹) * √(log (w₀ / x)) * (1 - εJ x)) := by gcongr
    _ = 2 * x * √(log (w₀ / x)) * (1 - εJ x) := by
        rw [show √2 * w₀ * (√2 * (x * w₀⁻¹) * √(log (w₀ / x)) * (1 - εJ x)) =
          (√2 * √2) * (w₀ * w₀⁻¹) * x * √(log (w₀ / x)) * (1 - εJ x) by ring, h22,
          mul_inv_cancel₀ hw0.ne']
        ring

/-- [DIR], §5.4: finally, if $x\le\frac1{64}$, then $2(1-\varepsilon)>1$ (by evaluating this
decreasing function at $x=\frac1{64}$). -/
theorem two_one_sub_εJ :
    AntitoneOn (fun x ↦ 2 * (1 - εJ x)) (Ioc 0 64⁻¹) ∧ ∀ x ∈ Ioc (0 : ℝ) 64⁻¹, 2 * (1 -
        εJ x) > 1 := by
  have hw := w₀_mem
  have hw0 : 0 < w₀ := by linarith [hw.1]
  have hεJ : ∀ x, εJ x = (2⁻¹ * log (log (w₀ / x)) + log (2 * π ^ (2⁻¹ : ℝ))) /
      log (w₀ / x) := fun x ↦ by simp only [εJ]; ring
  have hexp : ∀ x ∈ Ioc (0 : ℝ) 64⁻¹, 57 ≤ exp (log (w₀ / x)) := by
    intro x hx
    rw [exp_log (div_pos hw0 hx.1), le_div_iff₀ hx.1]
    linarith [hx.2, hw.1]
  have hu1 : ∀ x ∈ Ioc (0 : ℝ) 64⁻¹, 1 ≤ log (w₀ / x) := by
    intro x hx
    have := hexp x hx
    by_contra h
    have h' : exp (log (w₀ / x)) < exp 1 := exp_lt_exp.2 (not_le.1 h)
    linarith [exp_one_lt_d9]
  constructor
  · intro a ha b hb hab
    simp only
    have h := eps_antitone_aux half_le_log_two_mul_sqrt_pi (hu1 b hb)
      (log_le_log (div_pos hw0 hb.1) (div_le_div_of_nonneg_left hw0.le ha.1 hab))
    rw [hεJ a, hεJ b]
    linarith
  · intro x hx
    have := eps_lt_half_aux (hexp x hx)
    rw [hεJ x]
    linarith

/-- **Corollary 5.12** ([DIR]). For $0<x\le\frac1{64}$,
$$J(1-x)\ge x\sqrt{\log(w_0/x)},$$
where we recall that $w_0\in(0,1)$ is the unique value such that $J_{w_0}(\frac12)=\frac12$. -/
theorem cor_5_12 (x : ℝ) (hx : x ∈ Ioc (0 : ℝ) 64⁻¹) : J (1 - x) ≥ x * √(log (w₀ / x)) := by
  have hw := w₀_mem
  have h := eqn_5_10 x ⟨hx.1, by linarith [hx.2, hw.1]⟩
  have h2 := two_one_sub_εJ.2 x hx
  have hpos : 0 ≤ x * √(log (w₀ / x)) := mul_nonneg hx.1.le (sqrt_nonneg _)
  calc J (1 - x) ≥ 2 * x * √(log (w₀ / x)) * (1 - εJ x) := h
    _ = x * √(log (w₀ / x)) * (2 * (1 - εJ x)) := by ring
    _ ≥ x * √(log (w₀ / x)) * 1 := by gcongr
    _ = x * √(log (w₀ / x)) := mul_one _

section Proof_Lemma_5_13
/-- **(5.11)** (🚗) ([DIR], proof of Lemma 5.13). Running
$\textsc{Partition}_1(\underline{g_{JL,\beta_0}},[\frac12,\frac{2047}{2048}])$ shows
$$-\partial_x^2[J(x)-L_\beta(1-x)]>0.08$$
for $x\in[\frac12,\frac{2047}{2048}]$ (with $\beta=\beta_0$; $J$ is differentiated as $J_{w_0}$,
see the module docstring, so that the value at $x=\frac12$ is the one-sided derivative). -/
theorem eqn_5_11 (x : ℝ) (hx : x ∈ Icc (2⁻¹ : ℝ) (2047 / 2048)) :
    -deriv (deriv (fun t ↦ Jw w₀ t - L β₀ (1 - t))) x > 0.08 := by
  have hw := Checker.w₀_mem_11
  rw [neg_deriv2_JL β₀ ⟨by linarith [hx.1, hw.1], by linarith [hx.2]⟩]
  have hfl : ∀ xl xu : ℝ, ((1 / 2 : ℚ) : ℝ) ≤ xl → xu ≤ ((2047 / 2048 : ℚ) : ℝ) →
      ∀ y ∈ Icc xl xu, gJLlo xl xu ≤ 2 / Jw w₀ y + L2f β₀ (1 - y) := by
    intro xl xu h1 h2 y hy
    push_cast at h1 h2
    exact gJLlo_le (by linarith) h2 hy
  have h := bp_pos_of_breakpoints (fun y ↦ 2 / Jw w₀ y + L2f β₀ (1 - y)) gJLlo 0.08 jlPoints
    (1 / 2) (2047 / 2048) (by decide +kernel) rfl rfl (by decide) hfl jl_boxes x
    (by push_cast; exact ⟨by linarith [hx.1], hx.2⟩)
  exact h

/-- [DIR], proof of Lemma 5.13: so $J(x)-L_{\beta_0}(1-x)$ is a strictly concave function on
$[\frac12,\frac{2047}{2048}]$ and it suffices to evaluate it at $x=\frac12$, where the value is
zero, and at $x=\frac{2047}{2048}$, where the value is $>10^{-4}$. -/
theorem lemma_5_13_case_1 :
    StrictConcaveOn ℝ (Icc 2⁻¹ (2047 / 2048)) (fun x ↦ J x - L β₀ (1 - x)) ∧
    J 2⁻¹ - L β₀ (1 - 2⁻¹) = 0 ∧ J (2047 / 2048) - L β₀ (1 - 2047 / 2048) > 1e-4 := by
  have hw := Checker.w₀_mem_11
  have hw0 : 0 < w₀ := by linarith [hw.1]
  have hβ : β₀ = 0.50057 := rfl
  refine ⟨?_, ?_, ?_⟩
  · have hg : StrictConcaveOn ℝ (Icc 2⁻¹ (2047 / 2048)) (fun t ↦ Jw w₀ t - L β₀ (1 - t)) := by
      apply strictConcaveOn_of_deriv2_neg (convex_Icc _ _)
      · refine ContinuousOn.sub ((continuousOn_gJw hw0).mono fun y hy ↦
          ⟨by linarith [hy.1, hw.1], by linarith [hy.2]⟩) ?_
        refine (continuousOn_L (by rw [hβ]; norm_num) (by rw [hβ]; norm_num)).comp
          (continuousOn_const.sub continuousOn_id) fun y hy ↦ ⟨by linarith [hy.2], by
            linarith [hy.1]⟩
      · intro y hy
        rw [interior_Icc] at hy
        have := eqn_5_11 y ⟨hy.1.le, hy.2.le⟩
        simp only [Function.iterate_succ, Function.iterate_zero, Function.comp_apply,
          Function.id_def]
        linarith
    refine ⟨hg.1, fun x hx y hy hxy a b ha hb hab ↦ ?_⟩
    have h := hg.2 hx hy hxy ha hb hab
    have hm : a • x + b • y ∈ Icc (2⁻¹ : ℝ) (2047 / 2048) := hg.1 hx hy ha.le hb.le hab
    have e : ∀ z ∈ Icc (2⁻¹ : ℝ) (2047 / 2048), J z = Jw w₀ z := fun z hz ↦
      eqn_3_4 z ⟨hz.1, by linarith [hz.2]⟩
    simp only at h ⊢
    rw [e x hx, e y hy, e _ hm]
    exact h
  · rw [(J_half_eq_L_half β₀).1, (J_half_eq_L_half β₀).2]; ring
  · have h := Checker.check_sound Checker.P11 Checker.hw11 []
      (.sub (.J (2047 / 2048) 2.3095187723179676 2.3095187723157558)
        (.mul (.const (1 / 2048)) (.rpow (.const 11) (50057 / 100000)))) (1 / 10000)
      (by decide +kernel)
    simp only [Checker.denote] at h
    have e1 : (((50057 / 100000 : ℚ)) : ℝ) = β₀ := by rw [hβ]; norm_num
    rw [e1] at h
    have hL : L β₀ (1 - 2047 / 2048) = 1 / 2048 * (11 : ℝ) ^ β₀ := by
      rw [L, show (1 : ℝ) - 2047 / 2048 = 1 / 2048 by norm_num,
        show ((1 : ℝ) / 2048)⁻¹ = 2 ^ (11 : ℕ) by norm_num, logb_pow, logb_self_eq_one one_lt_two]
      norm_num
    rw [hL]
    push_cast at h
    linarith

/-- [DIR], proof of Lemma 5.13: setting $s=1-x<\frac1{2048}$, (5.10) implies
$J(x)=J(1-s)\ge2s(1-\varepsilon)\sqrt{\log(w_0/s)}$ with
$\varepsilon=\frac12\frac{\log\log(w_0/s)}{\log(w_0/s)}+\frac{\log(2\pi^{1/2})}{\log(w_0/s)}$; thus
$$J(x)-L_\beta(1-x)\ge s\Big(2(1-\varepsilon)\sqrt{\log(w_0/s)}-(\log2)^{-\beta_0}
(\log(1/s))^{\beta_0}\Big).$$ -/
theorem lemma_5_13_case_2 (s : ℝ) (hs : s ∈ Ioo 0 2048⁻¹) :
    J (1 - s) ≥ 2 * s * (1 - εJ s) * √(log (w₀ / s)) ∧
    J (1 - s) - L β₀ s ≥
      s * (2 * (1 - εJ s) * √(log (w₀ / s)) - (log 2) ^ (-β₀) * (log s⁻¹) ^ β₀) := by
  have hw := w₀_mem
  have h := eqn_5_10 s ⟨hs.1, by linarith [hs.2, hw.1]⟩
  have h1 : J (1 - s) ≥ 2 * s * (1 - εJ s) * √(log (w₀ / s)) := by linarith
  refine ⟨h1, ?_⟩
  have hL : L β₀ s = s * ((log 2) ^ (-β₀) * (log s⁻¹) ^ β₀) := by
    have hl : 0 ≤ log s⁻¹ := by
      rw [log_inv]; linarith [log_nonpos hs.1.le (by linarith [hs.2] : s ≤ 1)]
    rw [L, logb, div_rpow hl (log_pos one_lt_two).le, rpow_neg (log_pos one_lt_two).le]
    ring
  rw [hL]
  linarith

/-- [DIR], proof of Lemma 5.13: let $u=\log(w_0/s)$. If $s\in(10^{-10^{380}},\frac1{2048})$, then
$u\in(7,10^{381})$. -/
theorem lemma_5_13_u_range (s : ℝ) (hs : s ∈ Ioo ((10 : ℝ) ^ (-(10 : ℝ) ^ 380)) 2048⁻¹) :
    log (w₀ / s) ∈ Ioo 7 ((10 : ℝ) ^ 381) := by
  have hw := w₀_mem
  have hw0 : 0 < w₀ := by linarith [hw.1]
  have hs0 : 0 < s := lt_trans (by positivity) hs.1
  constructor
  · rw [lt_log_iff_exp_lt (div_pos hw0 hs0), lt_div_iff₀ hs0]
    have he : exp 7 < 1100 := by
      have h := exp_one_lt_d9
      have : exp 7 = exp 1 ^ 7 := by rw [← exp_nat_mul]; norm_num
      rw [this]
      calc exp 1 ^ 7 < 2.7182818286 ^ 7 := by gcongr
        _ < 1100 := by norm_num
    have : exp 7 * s < 1100 * 2048⁻¹ := by
      calc exp 7 * s < 1100 * s := by gcongr
        _ < 1100 * 2048⁻¹ := by gcongr; exact hs.2
    linarith [hw.1]
  · have h1 : log (w₀ / s) ≤ -log s := by
      rw [log_div hw0.ne' hs0.ne']
      linarith [log_nonpos hw0.le (by linarith [hw.2] : w₀ ≤ 1)]
    have h2 : -log s < (10 : ℝ) ^ 380 * log 10 := by
      have := log_lt_log (by positivity) hs.1
      rw [log_rpow (by norm_num), neg_mul] at this
      exact neg_lt.mp this
    have h3 : log 10 < 10 := by
      have := log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 10); linarith
    have h4 : (10 : ℝ) ^ 380 * log 10 ≤ (10 : ℝ) ^ 381 := by
      rw [show (10 : ℝ) ^ 381 = 10 ^ 380 * 10 from pow_succ _ _]
      exact mul_le_mul_of_nonneg_left h3.le (by positivity)
    exact (h1.trans_lt h2).trans_le h4

/-- [DIR], proof of Lemma 5.13: here we have used $\log(1/s)=u+\log(w_0^{-1})$ and
$(u+v)^{\beta_0}\le u^{\beta_0}+v^{\beta_0}$ (for $u,v\ge0$). -/
theorem lemma_5_13_used (s : ℝ) (hs : 0 < s) (u v : ℝ) (hu : 0 ≤ u) (hv : 0 ≤ v) :
    log s⁻¹ = log (w₀ / s) + log w₀⁻¹ ∧ (u + v) ^ β₀ ≤ u ^ β₀ + v ^ β₀ := by
  have hw := w₀_mem
  have hw0 : 0 < w₀ := by linarith [hw.1]
  refine ⟨?_, rpow_add_le_add_rpow hu hv (by rw [β₀]; norm_num) (by rw [β₀]; norm_num)⟩
  rw [log_div hw0.ne' hs.ne', log_inv, log_inv]
  ring

/-- [DIR], proof of Lemma 5.13: on the interval $u\in[1200,10^{381}]$, evaluating the decreasing
function $u\mapsto-\log(u)-\log(4\pi)$ at $u=10^{381}$ and the coefficients of other terms, the
left-hand side of (5.12) is $>-1.21u^{1.00057}+2u-0.4u^{0.5}-880$. -/
theorem lemma_5_13_frac_poly_bound (u : ℝ) (hu : u ∈ Icc 1200 ((10 : ℝ) ^ 381)) :
    2 * u - log u - log (4 * π) - (log 2) ^ (-β₀) * u ^ (2⁻¹ : ℝ) * (u ^ β₀ + (log w₀⁻¹) ^ β₀) >
      -1.21 * u ^ (1.00057 : ℝ) + 2 * u - 0.4 * u ^ (0.5 : ℝ) - 880 := by
  have hu0 : 0 < u := by linarith [hu.1]
  have hA := log_two_rpow_neg_β₀_le
  have hAB := log_two_mul_log_w₀_le
  have hA0 : 0 < (log 2) ^ (-β₀) := rpow_pos_of_pos (log_pos one_lt_two) _
  have e : (log 2) ^ (-β₀) * u ^ (2⁻¹ : ℝ) * (u ^ β₀ + (log w₀⁻¹) ^ β₀) =
      (log 2) ^ (-β₀) * u ^ (1.00057 : ℝ) +
        ((log 2) ^ (-β₀) * (log w₀⁻¹) ^ β₀) * u ^ (2⁻¹ : ℝ) := by
    rw [mul_assoc, rpow_half_mul_add hu0]; ring
  have e2 : u ^ (0.5 : ℝ) = u ^ (2⁻¹ : ℝ) := by norm_num
  rw [e, e2]
  have h1 : 0 < u ^ (1.00057 : ℝ) := rpow_pos_of_pos hu0 _
  have h2 : 0 < u ^ (2⁻¹ : ℝ) := rpow_pos_of_pos hu0 _
  have hlog10 := log_mem_of_logIv Checker.P11 10 2.302 2.30259 (by decide +kernel)
  have hlogpi := log_mem_of_logIv Checker.P11 12.6 2.53 2.534 (by decide +kernel)
  have c1 : ((10 : ℚ) : ℝ) = 10 := by norm_num
  have c2 : ((2.30259 : ℚ) : ℝ) = 2.30259 := by norm_num
  have c3 : ((12.6 : ℚ) : ℝ) = 12.6 := by norm_num
  have c4 : ((2.534 : ℚ) : ℝ) = 2.534 := by norm_num
  rw [c1, c2] at hlog10
  rw [c3, c4] at hlogpi
  have hlu : log u ≤ 381 * log 10 := by
    have := log_le_log hu0 hu.2
    rwa [log_pow] at this
  have hl4 : log (4 * π) ≤ log 12.6 :=
    log_le_log (by positivity) (by linarith [pi_lt_d2])
  nlinarith

/-- [DIR], proof of Lemma 5.13: the fractional polynomial
$p(u)=-1.21u^{1.00057}+2u-0.4u^{0.5}-880$ can have at most two roots in $(0,\infty)$ by Descartes'
rule of signs ([Jam06]); evaluating and using the intermediate value theorem then shows that it
has exactly two roots, one in $[1000,1200]$ and one in $[10^{381},10^{390}]$, with positive value
on $[1200,10^{381}]$. -/
theorem lemma_5_13_roots :
    (Set.encard {u : ℝ | 0 < u ∧ -1.21 * u ^ (1.00057 : ℝ) + 2 * u - 0.4 * u ^ (0.5 : ℝ) - 880 =
        0} ≤ 2) ∧
    (∃ u₁ ∈ Icc (1000 : ℝ) 1200, -1.21 * u₁ ^ (1.00057 : ℝ) + 2 * u₁ - 0.4 * u₁ ^ (0.5 : ℝ) -
        880 = 0) ∧
    (∃ u₂ ∈ Icc ((10 : ℝ) ^ 381) ((10 : ℝ) ^ 390),
      -1.21 * u₂ ^ (1.00057 : ℝ) + 2 * u₂ - 0.4 * u₂ ^ (0.5 : ℝ) - 880 = 0) ∧
    ∀ u ∈ Icc 1200 ((10 : ℝ) ^ 381), -1.21 * u ^ (1.00057 : ℝ) + 2 * u - 0.4 * u ^ (0.5 : ℝ) -
        880 > 0 := by
  have hp : ∀ u : ℝ, -1.21 * u ^ (1.00057 : ℝ) + 2 * u - 0.4 * u ^ (0.5 : ℝ) - 880 =
      fracPoly (-880) 0.4 2 1.21 0.00057 u := by
    intro u; unfold fracPoly; norm_num; ring
  simp only [hp]
  have hval : ∀ u : ℚ, fracPoly (-880) 0.4 2 1.21 0.00057 u =
      Checker.denote (Checker.Cert.val []) (fracPolyEx (-880) 0.4 2 1.21 0.00057 u) := by
    intro u; rw [fracPolyEx_denote]; push_cast; norm_num
  have v1000 : fracPoly (-880) 0.4 2 1.21 0.00057 1000 < 0 := by
    have h := Checker.checkUpper_sound Checker.P11 Checker.hw11 []
      (fracPolyEx (-880) 0.4 2 1.21 0.00057 1000) 0 (by decide +kernel)
    have := hval 1000; push_cast at this h; rw [this]; exact_mod_cast h
  have v1200 : 0 < fracPoly (-880) 0.4 2 1.21 0.00057 1200 := by
    have h := Checker.check_sound Checker.P11 Checker.hw11 []
      (fracPolyEx (-880) 0.4 2 1.21 0.00057 1200) 0 (by decide +kernel)
    have := hval 1200; push_cast at this h; rw [this]; exact_mod_cast h
  have v381 : 0 < fracPoly (-880) 0.4 2 1.21 0.00057 ((10 : ℝ) ^ 381) := by
    have h := Checker.check_sound Checker.P11 Checker.hw11 []
      (fracPolyEx (-880) 0.4 2 1.21 0.00057 (10 ^ 381)) 0 (by decide +kernel)
    have := hval (10 ^ 381); push_cast at this h; rw [this]; exact_mod_cast h
  have v390 : fracPoly (-880) 0.4 2 1.21 0.00057 ((10 : ℝ) ^ 390) < 0 := by
    have h := Checker.checkUpper_sound Checker.P11 Checker.hw11 []
      (fracPolyEx (-880) 0.4 2 1.21 0.00057 (10 ^ 390)) 0 (by decide +kernel)
    have := hval (10 ^ 390); push_cast at this h; rw [this]; exact_mod_cast h
  have hc : ∀ p q : ℝ, 0 < p → ContinuousOn (fracPoly (-880) 0.4 2 1.21 0.00057) (Icc p q) :=
    fun p q hp ↦ (continuousOn_fracPoly _ _ _ _ _).mono fun v hv ↦ hp.trans_le hv.1
  refine ⟨fracPoly_encard_roots_le_two (by norm_num) (by norm_num) (by norm_num), ?_, ?_, ?_⟩
  · obtain ⟨r, hr, hr0⟩ := intermediate_value_Icc (by norm_num) (hc 1000 1200 (by norm_num))
      ⟨v1000.le, v1200.le⟩
    exact ⟨r, hr, hr0⟩
  · obtain ⟨r, hr, hr0⟩ := intermediate_value_Icc' (pow_le_pow_right₀ (by norm_num) (by norm_num))
      (hc _ _ (by positivity)) ⟨v390.le, v381.le⟩
    exact ⟨r, hr, hr0⟩
  · intro u hu
    exact fracPoly_pos_of_signs (by norm_num) (by norm_num) (by norm_num)
      (by norm_num : (0 : ℝ) < 1000) (by norm_num : (1000 : ℝ) < 1200)
      (le_trans (by norm_num : (1200 : ℝ) ≤ 10 ^ 4)
        (pow_le_pow_right₀ (by norm_num) (by norm_num)))
      (pow_lt_pow_right₀ (by norm_num) (by norm_num))
      v1000 v1200 v381 v390 u hu

/-- [DIR], proof of Lemma 5.13: showing that (5.12) also holds for $u\in[7,1200]$ follows the same
argument. -/
theorem eqn_5_12_small (u : ℝ) (hu : u ∈ Icc (7 : ℝ) 1200) :
    2 * u - log u - log (4 * π) - (log 2) ^ (-β₀) * u ^ (2⁻¹ : ℝ) * (u ^ β₀ + (log w₀⁻¹) ^ β₀) >
        0 := by
  have hu0 : 0 < u := by linarith [hu.1]
  have hval : ∀ v : ℚ, fracPoly (-3.47694) 0.39815 (13 / 7) 1.2014 0.00057 v =
      Checker.denote (Checker.Cert.val []) (fracPolyEx (-3.47694) 0.39815 (13 / 7) 1.2014
        0.00057 v) := by
    intro v; rw [fracPolyEx_denote]; push_cast; norm_num
  have v1 : fracPoly (-3.47694) 0.39815 (13 / 7) 1.2014 0.00057 1 < 0 := by
    have h := Checker.checkUpper_sound Checker.P11 Checker.hw11 []
      (fracPolyEx (-3.47694) 0.39815 (13 / 7) 1.2014 0.00057 1) 0 (by decide +kernel)
    have := hval 1; push_cast at this h; rw [this]; exact_mod_cast h
  have v7 : 0 < fracPoly (-3.47694) 0.39815 (13 / 7) 1.2014 0.00057 7 := by
    have h := Checker.check_sound Checker.P11 Checker.hw11 []
      (fracPolyEx (-3.47694) 0.39815 (13 / 7) 1.2014 0.00057 7) 0 (by decide +kernel)
    have := hval 7; push_cast at this h; rw [this]; exact_mod_cast h
  have v1200 : 0 < fracPoly (-3.47694) 0.39815 (13 / 7) 1.2014 0.00057 1200 := by
    have h := Checker.check_sound Checker.P11 Checker.hw11 []
      (fracPolyEx (-3.47694) 0.39815 (13 / 7) 1.2014 0.00057 1200) 0 (by decide +kernel)
    have := hval 1200; push_cast at this h; rw [this]; exact_mod_cast h
  have v340 : fracPoly (-3.47694) 0.39815 (13 / 7) 1.2014 0.00057 ((10 : ℝ) ^ 340) < 0 := by
    have h := Checker.checkUpper_sound Checker.P11 Checker.hw11 []
      (fracPolyEx (-3.47694) 0.39815 (13 / 7) 1.2014 0.00057 (10 ^ 340)) 0 (by decide +kernel)
    have := hval (10 ^ 340); push_cast at this h; rw [this]; exact_mod_cast h
  have hF := fracPoly_pos_of_signs (by norm_num) (by norm_num) (by norm_num)
    (by norm_num : (0 : ℝ) < 1) (by norm_num : (1 : ℝ) < 7) (by norm_num : (7 : ℝ) ≤ 1200)
    (lt_of_lt_of_le (by norm_num : (1200 : ℝ) < 10 ^ 4)
      (pow_le_pow_right₀ (by norm_num) (by norm_num))) v1 v7 v1200 v340 u hu
  unfold fracPoly at hF
  have hA := log_two_rpow_neg_β₀_le
  have hAB := log_two_mul_log_w₀_le
  have e : (log 2) ^ (-β₀) * u ^ (2⁻¹ : ℝ) * (u ^ β₀ + (log w₀⁻¹) ^ β₀) =
      (log 2) ^ (-β₀) * u ^ (1.00057 : ℝ) +
        ((log 2) ^ (-β₀) * (log w₀⁻¹) ^ β₀) * u ^ (2⁻¹ : ℝ) := by
    rw [mul_assoc, rpow_half_mul_add hu0]; ring
  rw [e]
  have e2 : u ^ (1 + (0.00057 : ℝ)) = u ^ (1.00057 : ℝ) := by norm_num
  rw [e2] at hF
  have h1 : 0 < u ^ (1.00057 : ℝ) := rpow_pos_of_pos hu0 _
  have h2 : 0 < u ^ (2⁻¹ : ℝ) := rpow_pos_of_pos hu0 _
  have hlog : log u ≤ log 7 + u / 7 - 1 := by
    have := log_le_sub_one_of_pos (div_pos hu0 (by norm_num : (0 : ℝ) < 7))
    rw [log_div hu0.ne' (by norm_num)] at this; linarith
  have h7 := log_mem_of_logIv Checker.P11 7 1.9459 1.945911 (by decide +kernel)
  have h12 := log_mem_of_logIv Checker.P11 12.566372 2.531 2.531025 (by decide +kernel)
  have c1 : ((7 : ℚ) : ℝ) = 7 := by norm_num
  have c2 : ((1.945911 : ℚ) : ℝ) = 1.945911 := by norm_num
  have c3 : ((12.566372 : ℚ) : ℝ) = 12.566372 := by norm_num
  have c4 : ((2.531025 : ℚ) : ℝ) = 2.531025 := by norm_num
  rw [c1, c2] at h7
  rw [c3, c4] at h12
  have hl4 : log (4 * π) ≤ log 12.566372 :=
    log_le_log (by positivity) (by linarith [pi_lt_d20])
  nlinarith

/-- **(5.12)** ([DIR], proof of Lemma 5.13). It suffices to show
$$2u-\log(u)-\log(4\pi)-(\log2)^{-\beta_0}u^{\frac12}(u^{\beta_0}+\log(w_0^{-1})^{\beta_0})>0$$
for all $u\in[7,10^{381}]$. -/
theorem eqn_5_12 (u : ℝ) (hu : u ∈ Icc 7 ((10 : ℝ) ^ 381)) :
    2 * u - log u - log (4 * π) - (log 2) ^ (-β₀) * u ^ (2⁻¹ : ℝ) * (u ^ β₀ + (log w₀⁻¹) ^ β₀) >
        0 := by
  rcases le_total u 1200 with h | h
  · exact eqn_5_12_small u ⟨hu.1, h⟩
  · exact (lemma_5_13_roots.2.2.2 u ⟨h, hu.2⟩).trans (lemma_5_13_frac_poly_bound u ⟨h, hu.2⟩)

end Proof_Lemma_5_13

/-- **Lemma 5.13** ([DIR]). For all $x\in(\frac12,1-10^{-10^{380}})$, $J(x)>L_{\beta_0}(1-x)$. -/
theorem lemma_5_13 (x : ℝ) (hx : x ∈ Ioo 2⁻¹ (1 - (10 : ℝ) ^ (-(10 : ℝ) ^ 380))) :
    J x > L β₀ (1 - x) := by
  rcases le_or_gt x (2047 / 2048) with h | h
  · obtain ⟨hc, h0, h1⟩ := lemma_5_13_case_1
    rcases h.lt_or_eq with h' | h'
    · have hb : (2⁻¹ : ℝ) < 2047 / 2048 := by norm_num
      have ha' : 0 < (2047 / 2048 - x) / (2047 / 2048 - 2⁻¹) := div_pos (by linarith) (by linarith)
      have hb' : 0 < (x - 2⁻¹) / (2047 / 2048 - 2⁻¹) := div_pos (by linarith [hx.1]) (by linarith)
      have hab : (2047 / 2048 - x) / (2047 / 2048 - 2⁻¹) + (x - 2⁻¹) / (2047 / 2048 - 2⁻¹) = 1 := by
        field_simp; ring
      have := hc.2 (⟨le_rfl, hb.le⟩ : (2⁻¹ : ℝ) ∈ Icc 2⁻¹ (2047 / 2048))
        (⟨hb.le, le_rfl⟩ : (2047 / 2048 : ℝ) ∈ Icc 2⁻¹ (2047 / 2048)) hb.ne ha' hb' hab
      simp only [smul_eq_mul] at this
      have hx' : (2047 / 2048 - x) / (2047 / 2048 - 2⁻¹) * 2⁻¹ +
          (x - 2⁻¹) / (2047 / 2048 - 2⁻¹) * (2047 / 2048) = x := by
        field_simp; ring
      rw [hx', h0] at this
      nlinarith [mul_pos hb' (show (0 : ℝ) < 1e-4 by norm_num)]
    · rw [h']; linarith [h1]
  · have hs1 : 1 - x ∈ Ioo ((10 : ℝ) ^ (-(10 : ℝ) ^ 380)) 2048⁻¹ :=
      ⟨by linarith [hx.2], by linarith⟩
    have hs0' : 0 < 1 - x := lt_trans (by positivity) hs1.1
    obtain ⟨-, h2⟩ := lemma_5_13_case_2 (1 - x) ⟨hs0', hs1.2⟩
    have hu := lemma_5_13_u_range (1 - x) hs1
    have h5 := eqn_5_12 _ ⟨hu.1.le, hu.2.le⟩
    obtain ⟨hl, hsub⟩ := lemma_5_13_used (1 - x) hs0' (log (w₀ / (1 - x))) (log w₀⁻¹)
      (by linarith [hu.1]) log_w₀_inv_mem.1
    rw [show J x = J (1 - (1 - x)) by rw [sub_sub_cancel]]
    generalize 1 - x = s at hs1 hs0' h2 hu h5 hl hsub ⊢
    have hs := hs1
    have hs0 : 0 < s := lt_trans (by positivity) hs.1
    set u := log (w₀ / s) with hudef
    have hu0 : 0 < u := by linarith [hu.1]
    have hsq : u ^ (2⁻¹ : ℝ) = √u := by rw [sqrt_eq_rpow, one_div]
    rw [hsq] at h5
    have hsu : 0 < √u := sqrt_pos.2 hu0
    have hsu2 : √u * √u = u := mul_self_sqrt hu0.le
    have hA0 : 0 < (log 2) ^ (-β₀) := rpow_pos_of_pos (log_pos one_lt_two) _
    set c := log (2 * π ^ (2⁻¹ : ℝ)) with hc
    have hεJ : εJ s = (2⁻¹ * log u + c) / u := by
      simp only [εJ]; rw [← hudef, ← hc]; ring
    have hε : 2 * (1 - εJ s) * √u = (2 * u - log u - log (4 * π)) / √u := by
      rw [← two_mul_log_two_mul_sqrt_pi, ← hc, eq_div_iff hsu.ne', hεJ, mul_assoc, hsu2]
      field_simp
      ring
    have hkey : (log 2) ^ (-β₀) * (log s⁻¹) ^ β₀ < 2 * (1 - εJ s) * √u := by
      rw [hε, lt_div_iff₀ hsu, hl]
      calc (log 2) ^ (-β₀) * (u + log w₀⁻¹) ^ β₀ * √u
          ≤ (log 2) ^ (-β₀) * (u ^ β₀ + (log w₀⁻¹) ^ β₀) * √u := by gcongr
        _ < _ := by linarith
    have := mul_pos hs0 (sub_pos.2 hkey)
    linarith

end Auto.DIR
