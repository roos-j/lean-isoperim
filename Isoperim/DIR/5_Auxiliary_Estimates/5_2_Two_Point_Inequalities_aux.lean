module

public import Mathlib

/-!
# [DIR] §5.2 Two-point inequalities: auxiliary lemmas

This file was automatically generated by Claude.

Auxiliary results for the proofs in `5_2_Two_Point_Inequalities.lean`: Taylor's theorem with
Lagrange remainder of order two for $a\mapsto(1+a)^\beta$ (used for Lemma 5.4 of [DIR]).
-/

@[expose] public section

namespace Auto.DIR

open Real Set

/-- Taylor's theorem with Lagrange remainder for $(1+a)^\beta$ at $0$ (any real $\beta$, $a\ge0$):
$(1+a)^\beta=1+\beta a-\frac12\beta(1-\beta)(1+\tilde a)^{\beta-2}a^2$ for some
$\tilde a\in[0,a]$. Proved by applying Rolle's theorem twice to
$t\mapsto(1+t)^\beta-1-\beta t-Kt^2$, with $K$ chosen so that this vanishes at $t=a$. -/
theorem one_add_rpow_taylor (β : ℝ) (a : ℝ) (ha : 0 ≤ a) :
    ∃ ã ∈ Icc 0 a, (1 + a) ^ β = 1 + β * a - 2⁻¹ * β * (1 - β) * (1 + ã) ^ (β - 2) * a ^ 2 := by
  rcases ha.eq_or_lt with rfl | ha
  · exact ⟨0, ⟨le_rfl, le_rfl⟩, by simp⟩
  set K : ℝ := ((1 + a) ^ β - 1 - β * a) / a ^ 2 with hK
  have hd1 : ∀ t : ℝ, -1 < t → HasDerivAt (fun t : ℝ => (1 + t) ^ β - 1 - β * t - K * t ^ 2)
      (β * (1 + t) ^ (β - 1) - β - K * (2 * t)) t := by
    intro t ht
    have h1 : HasDerivAt (fun t : ℝ => (1 + t) ^ β) (1 * β * (1 + t) ^ (β - 1)) t :=
      ((hasDerivAt_id' t).const_add 1).rpow_const (Or.inl (by linarith))
    have h2 := (hasDerivAt_pow 2 t).const_mul K
    have h3 := (hasDerivAt_id' t).const_mul β
    convert ((h1.sub_const 1).sub h3).sub h2 using 1
    simp
  have hd2 : ∀ t : ℝ, -1 < t → HasDerivAt (fun t : ℝ => β * (1 + t) ^ (β - 1) - β - K * (2 * t))
      (β * (β - 1) * (1 + t) ^ (β - 2) - 2 * K) t := by
    intro t ht
    have h1 : HasDerivAt (fun t : ℝ => (1 + t) ^ (β - 1))
        (1 * (β - 1) * (1 + t) ^ (β - 1 - 1)) t :=
      ((hasDerivAt_id' t).const_add 1).rpow_const (Or.inl (by linarith))
    have h3 := ((hasDerivAt_id' t).const_mul 2).const_mul K
    convert ((h1.const_mul β).sub_const β).sub h3 using 1
    rw [show β - 1 - 1 = β - 2 by ring]; ring
  obtain ⟨ξ, hξ, hξ0⟩ := exists_hasDerivAt_eq_zero ha
    (fun t ht => (hd1 t (by linarith [ht.1])).continuousAt.continuousWithinAt)
    (by simp only [hK]; field_simp; simp) (fun t ht => hd1 t (by linarith [ht.1]))
  obtain ⟨η, hη, hη0⟩ := exists_hasDerivAt_eq_zero hξ.1
    (fun t ht => (hd2 t (by linarith [ht.1])).continuousAt.continuousWithinAt)
    (by simp; linarith) (fun t ht => hd2 t (by linarith [ht.1]))
  refine ⟨η, ⟨hη.1.le, (hη.2.trans hξ.2).le⟩, ?_⟩
  have hK' : (1 + a) ^ β = 1 + β * a + K * a ^ 2 := by
    simp only [hK]; field_simp; ring
  rw [hK']
  have : K = 2⁻¹ * β * (β - 1) * (1 + η) ^ (β - 2) := by linarith
  rw [this]; ring

end Auto.DIR
