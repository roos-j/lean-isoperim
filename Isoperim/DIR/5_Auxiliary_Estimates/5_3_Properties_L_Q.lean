theorem eqn_5_2 (β x : ℝ) (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (L β) x = (log 2) ^ (-β) * (log x⁻¹) ^ (-1 + β) * (-β + log x⁻¹) := by
