open Real Set Filter Topology

/-- The right-hand side of (5.2):
$(\log2)^{-\beta}(\log\frac1x)^{-1+\beta}(-\beta+\log\frac1x)$. -/
noncomputable def L1f (β x : ℝ) : ℝ :=
  (log 2) ^ (-β) * (log x⁻¹) ^ (-1 + β) * (-β + log x⁻¹)

/-- The right-hand side of (5.3):
$-\beta(\log2)^{-\beta}x^{-1}(\log\frac1x)^{-2+\beta}(1-\beta+\log\frac1x)$. -/
noncomputable def L2f (β x : ℝ) : ℝ :=
  -β * (log 2) ^ (-β) * x⁻¹ * (log x⁻¹) ^ (-2 + β) * (1 - β + log x⁻¹)

/-- The right-hand side of (5.4):
$\beta(\log2)^{-\beta}x^{-2}(\log\frac1x)^{-3+\beta}(\beta(3-\beta)-2+(\log\frac1x)^2)$. -/
noncomputable def L3f (β x : ℝ) : ℝ :=
  β * (log 2) ^ (-β) * x ^ (-2 : ℤ) * (log x⁻¹) ^ (-3 + β) *
    (β * (3 - β) - 2 + (log x⁻¹) ^ 2)

/-- The formula for $L^{(4)}_\beta(x)$ of the proof of Lemma 5.6 (4):
$x^{-3}\beta(\log2)^{-\beta}(\log\frac1x)^{\beta-4}f_\beta(x)$. -/
noncomputable def L4f (β x : ℝ) : ℝ :=
  x ^ (-3 : ℤ) * β * (log 2) ^ (-β) * (log x⁻¹) ^ (β - 4) *
    (-(3 - β) * (2 - β) * (1 - β) + (1 - β - 2 * log x⁻¹) * (log x⁻¹) ^ 2 +
      2 * (2 - β) * (1 - β) * log x⁻¹)

/-- The derivative of $x\mapsto\log\frac1x$ is $-x^{-1}$ (for $x\ne0$). -/
theorem hasDerivAt_log_inv' {x : ℝ} (hx : x ≠ 0) :
    HasDerivAt (fun x ↦ log x⁻¹) (-x⁻¹) x := by
  have : (fun x : ℝ ↦ log x⁻¹) = fun x ↦ -log x := funext fun x ↦ log_inv x
  rw [this]
  exact (hasDerivAt_log hx).neg

/-- Splitting a real power with exponent $\beta+n$, $n\in\mathbb Z$, for a positive base. -/
theorem rpow_eq_rpow_mul_zpow {u : ℝ} (hu : 0 < u) (e β : ℝ) (n : ℤ) (h : e = β + n) :
    u ^ e = u ^ β * u ^ n := by
  rw [h, rpow_add hu, rpow_intCast]

/-- On $(0,1)$, $L_\beta(x)=(\log2)^{-\beta}x(\log\frac1x)^\beta$. -/
theorem L_eq_of_mem {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    L β x = (log 2) ^ (-β) * (x * (log x⁻¹) ^ β) := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hl : 0 < log 2 := log_pos one_lt_two
  rw [L, logb, div_rpow hu.le hl.le, rpow_neg hl.le]
  ring

/-- $L_\beta'=$ `L1f` on $(0,1)$. -/
theorem hasDerivAt_L {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) : HasDerivAt (L β) (L1f β x) x := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have h := (((hasDerivAt_id' x).mul ((hasDerivAt_log_inv' hx.1.ne').rpow_const
    (p := β) (Or.inl hu.ne'))).const_mul ((log 2) ^ (-β)))
  have heq : (fun y ↦ (log 2) ^ (-β) * (y * (log y⁻¹) ^ β)) =ᶠ[𝓝 x] L β := by
    filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy
    exact (L_eq_of_mem hy).symm
  refine (h.congr_of_eventuallyEq heq.symm).congr_deriv ?_
  rw [L1f, rpow_eq_rpow_mul_zpow hu (-1 + β) β (-1) (by push_cast; ring),
    rpow_eq_rpow_mul_zpow hu (β - 1) β (-1) (by push_cast; ring)]
  have hx0 : x ≠ 0 := hx.1.ne'
  have hu0 : log x⁻¹ ≠ 0 := hu.ne'
  simp only [zpow_neg, zpow_one]
  generalize log x⁻¹ = u at hu0 ⊢
  field_simp
  ring

/-- Splitting a real power with exponent $\beta-n$, $n\in\mathbb N$, for a positive base. -/
theorem rpow_eq_rpow_div_pow {u : ℝ} (hu : 0 < u) (e β : ℝ) (n : ℕ) (h : e = β - n) :
    u ^ e = u ^ β / u ^ n := by
  rw [h, rpow_sub hu, rpow_natCast]

/-- `L1f` has derivative `L2f` on $(0,1)$. -/
theorem hasDerivAt_L1f {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (L1f β) (L2f β x) x := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hd := hasDerivAt_log_inv' hx.1.ne'
  have h := ((hd.rpow_const (p := -1 + β) (Or.inl hu.ne')).const_mul ((log 2) ^ (-β))).mul
    (hd.const_add (-β))
  refine h.congr_deriv ?_
  rw [L2f, rpow_eq_rpow_div_pow hu (-1 + β - 1) β 2 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (-1 + β) β 1 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (-2 + β) β 2 (by push_cast; ring)]
  have hx0 : x ≠ 0 := hx.1.ne'
  have hu0 : log x⁻¹ ≠ 0 := hu.ne'
  generalize log x⁻¹ = u at hu0 ⊢
  field_simp
  ring

/-- `L2f` has derivative `L3f` on $(0,1)$. -/
theorem hasDerivAt_L2f {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (L2f β) (L3f β x) x := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hx0 : x ≠ 0 := hx.1.ne'
  have hd := hasDerivAt_log_inv' hx0
  have h := ((((hasDerivAt_inv hx0).const_mul (-β * (log 2) ^ (-β))).mul
    (hd.rpow_const (p := -2 + β) (Or.inl hu.ne'))).mul (hd.const_add (1 - β)))
  have hf : L2f β = fun y ↦ -β * (log 2) ^ (-β) * y⁻¹ * (log y⁻¹) ^ (-2 + β) *
      (1 - β + log y⁻¹) := rfl
  rw [hf]
  refine h.congr_deriv ?_
  simp only [Pi.mul_apply]
  rw [L3f, rpow_eq_rpow_div_pow hu (-2 + β - 1) β 3 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (-3 + β) β 3 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (-2 + β) β 2 (by push_cast; ring)]
  have hu0 : log x⁻¹ ≠ 0 := hu.ne'
  simp only [zpow_neg, zpow_ofNat]
  generalize log x⁻¹ = u at hu0 ⊢
  field_simp
  ring

/-- `L3f` has derivative `L4f` on $(0,1)$. -/
theorem hasDerivAt_L3f {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (L3f β) (L4f β x) x := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hx0 : x ≠ 0 := hx.1.ne'
  have hd := hasDerivAt_log_inv' hx0
  have h := (((((hasDerivAt_pow 2 x).inv (pow_ne_zero 2 hx0)).const_mul
    (β * (log 2) ^ (-β))).mul (hd.rpow_const (p := -3 + β) (Or.inl hu.ne'))).mul
    ((hd.pow 2).const_add (β * (3 - β) - 2)))
  have hf : L3f β = fun y ↦ β * (log 2) ^ (-β) * (y ^ 2)⁻¹ * (log y⁻¹) ^ (-3 + β) *
      (β * (3 - β) - 2 + (log y⁻¹) ^ 2) := by
    funext y; simp only [L3f, zpow_neg, zpow_ofNat]
  rw [hf]
  refine h.congr_deriv ?_
  simp only [Pi.mul_apply, Pi.pow_apply, Pi.inv_apply]
  rw [L4f, rpow_eq_rpow_div_pow hu (-3 + β - 1) β 4 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (-3 + β) β 3 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (β - 4) β 4 (by push_cast; ring)]
  have hu0 : log x⁻¹ ≠ 0 := hu.ne'
  simp only [zpow_neg, zpow_ofNat]
  generalize log x⁻¹ = u at hu0 ⊢
  field_simp
  ring

/-- $L_\beta'(x)$ is given by (5.2) on $(0,1)$. -/
theorem deriv_L_eq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) : deriv (L β) x = L1f β x :=
  (hasDerivAt_L hx).deriv

/-- `deriv (L β)` agrees with `L1f β` near any point of $(0,1)$. -/
theorem deriv_L_eventuallyEq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (L β) =ᶠ[𝓝 x] L1f β := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using deriv_L_eq hy

/-- $L_\beta''$ has the form (5.3) on $(0,1)$ (as a derivative of $L_\beta'$). -/
theorem hasDerivAt_deriv_L {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (deriv (L β)) (L2f β x) x :=
  (hasDerivAt_L1f hx).congr_of_eventuallyEq (deriv_L_eventuallyEq hx)

/-- $L_\beta''(x)$ is given by (5.3) on $(0,1)$. -/
theorem deriv2_L_eq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (deriv (L β)) x = L2f β x :=
  (hasDerivAt_deriv_L hx).deriv

/-- `deriv (deriv (L β))` agrees with `L2f β` near any point of $(0,1)$. -/
theorem deriv2_L_eventuallyEq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (deriv (L β)) =ᶠ[𝓝 x] L2f β := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using deriv2_L_eq hy

/-- $L_\beta'''$ has the form (5.4) on $(0,1)$ (as a derivative of $L_\beta''$). -/
theorem hasDerivAt_deriv2_L {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (deriv (deriv (L β))) (L3f β x) x :=
  (hasDerivAt_L2f hx).congr_of_eventuallyEq (deriv2_L_eventuallyEq hx)

/-- $L_\beta'''(x)$ is given by (5.4) on $(0,1)$. -/
theorem deriv3_L_eq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (deriv (deriv (L β))) x = L3f β x :=
  (hasDerivAt_deriv2_L hx).deriv

/-- `deriv (deriv (deriv (L β)))` agrees with `L3f β` near any point of $(0,1)$. -/
theorem deriv3_L_eventuallyEq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (deriv (deriv (L β))) =ᶠ[𝓝 x] L3f β := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using deriv3_L_eq hy

/-- $L_\beta^{(4)}$ is `L4f` on $(0,1)$ (as a derivative of $L_\beta'''$). -/
theorem hasDerivAt_deriv3_L {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (deriv (deriv (deriv (L β)))) (L4f β x) x :=
  (hasDerivAt_L3f hx).congr_of_eventuallyEq (deriv3_L_eventuallyEq hx)

/-- $L_\beta^{(4)}(x)$ is given by `L4f` on $(0,1)$. -/
theorem deriv4_L_eq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (deriv (deriv (deriv (L β)))) x = L4f β x :=
  (hasDerivAt_deriv3_L hx).deriv

/-- $L_\beta$ is continuous at every $x\ne0$ (for $\beta>0$). -/
theorem continuousAt_L {β x : ℝ} (hβ : 0 < β) (hx : x ≠ 0) : ContinuousAt (L β) x := by
  have h1 : ContinuousAt (fun y : ℝ ↦ log y⁻¹ / log 2) x :=
    (((continuousAt_inv₀ hx).log (inv_ne_zero hx))).div_const _
  exact continuousAt_id.mul (h1.rpow_const (Or.inr hβ.le))

/-- $L_\beta\ge0$ on $[0,1]$. -/
theorem L_nonneg {β x : ℝ} (hx : x ∈ Icc (0 : ℝ) 1) : 0 ≤ L β x := by
  rcases eq_or_lt_of_le hx.1 with h0 | hpos
  · simp [L, ← h0]
  · refine mul_nonneg hx.1 (rpow_nonneg ?_ _)
    exact logb_nonneg one_lt_two ((one_le_inv₀ hpos).2 hx.2)

/-- $L_\beta(0)=0$. -/
theorem L_zero (β : ℝ) : L β 0 = 0 := by simp [L]

/-- $L_\beta$ is continuous on $[0,1]$ for $0<\beta\le1$. -/
theorem continuousOn_L {β : ℝ} (hβ0 : 0 < β) (hβ1 : β ≤ 1) :
    ContinuousOn (L β) (Icc 0 1) := by
  intro x hx
  rcases eq_or_lt_of_le hx.1 with h0 | hpos
  · subst h0
    have hl : 0 < log 2 := log_pos one_lt_two
    have hg : Tendsto (fun y ↦ y - y * log y / log 2) (𝓝[Icc 0 1] 0) (𝓝 0) := by
      have hc : Continuous (fun y ↦ y - y * log y / log 2) :=
        continuous_id.sub (continuous_mul_log.div_const _)
      simpa using (hc.tendsto 0).mono_left nhdsWithin_le_nhds
    show Tendsto (L β) (𝓝[Icc 0 1] 0) (𝓝 (L β 0))
    rw [L_zero]
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hg ?_ ?_
    · filter_upwards [self_mem_nhdsWithin] with y hy using L_nonneg hy
    · filter_upwards [self_mem_nhdsWithin] with y hy
      rcases eq_or_lt_of_le hy.1 with h0 | hypos
      · simp [L, ← h0]
      have hv : 0 ≤ log y⁻¹ / log 2 :=
        div_nonneg (log_nonneg ((one_le_inv₀ hypos).2 hy.2)) hl.le
      have hb : (log y⁻¹ / log 2) ^ β ≤ 1 + log y⁻¹ / log 2 := by
        rcases le_or_gt 1 (log y⁻¹ / log 2) with h1 | h1
        · calc (log y⁻¹ / log 2) ^ β ≤ (log y⁻¹ / log 2) ^ (1 : ℝ) :=
                rpow_le_rpow_of_exponent_le h1 hβ1
            _ ≤ 1 + log y⁻¹ / log 2 := by rw [rpow_one]; linarith
        · linarith [rpow_le_one hv h1.le hβ0.le]
      have hLy : L β y = y * (log y⁻¹ / log 2) ^ β := rfl
      rw [hLy]
      calc y * (log y⁻¹ / log 2) ^ β ≤ y * (1 + log y⁻¹ / log 2) :=
            mul_le_mul_of_nonneg_left hb hy.1
        _ = y - y * log y / log 2 := by rw [log_inv]; ring
  · exact (continuousAt_L hβ0 hpos.ne').continuousWithinAt

/-- The right-hand side of (5.6) with $\alpha_0,\alpha_1$ written out:
$\frac23(2^{2+\beta}-3)-4(2^{2+\beta}-5)x-8(3-2^{1+\beta})x^2$. -/
noncomputable def Q1f (β x : ℝ) : ℝ :=
  2 / 3 * (2 ^ (2 + β) - 3) - 4 * (2 ^ (2 + β) - 5) * x - 8 * (3 - 2 ^ (1 + β)) * x ^ 2

/-- The right-hand side of (5.7) with $\alpha_0,\alpha_1$ written out:
$-4(2^{2+\beta}-5)-16(3-2^{1+\beta})x$. -/
noncomputable def Q2f (β x : ℝ) : ℝ := -4 * (2 ^ (2 + β) - 5) - 16 * (3 - 2 ^ (1 + β)) * x

/-- $2^{\beta+c}=2^c2^\beta$. -/
theorem two_rpow_add' (β c : ℝ) : (2 : ℝ) ^ (β + c) = 2 ^ c * 2 ^ β := by
  rw [rpow_add two_pos, mul_comm]

/-- $2^{c+\beta}=2^c2^\beta$. -/
theorem two_rpow_add'' (β c : ℝ) : (2 : ℝ) ^ (c + β) = 2 ^ c * 2 ^ β := by
  rw [rpow_add two_pos]

/-- $Q_\beta(x)$ is affine in $2^\beta$. -/
theorem Q_eq_affine (β x : ℝ) :
    Q β x = 2 / 3 * x * (1 - x) * (-3 + 12 * x) + 2 / 3 * x * (1 - x) * (4 - 8 * x) * 2 ^ β := by
  rw [Q, two_rpow_add', two_rpow_add']; norm_num; ring

/-- $Q_\beta'(x)$ (as `Q1f`) is affine in $2^\beta$. -/
theorem Q1f_eq_affine (β x : ℝ) :
    Q1f β x = (-2 + 20 * x - 24 * x ^ 2) + (8 / 3 - 16 * x + 16 * x ^ 2) * 2 ^ β := by
  rw [Q1f, two_rpow_add'', two_rpow_add'']; norm_num; ring

/-- $Q_\beta''(x)$ (as `Q2f`) is affine in $2^\beta$. -/
theorem Q2f_eq_affine (β x : ℝ) :
    Q2f β x = (20 - 48 * x) + (-16 + 32 * x) * 2 ^ β := by
  rw [Q2f, two_rpow_add'', two_rpow_add'']; norm_num; ring

/-- Derivative of $\beta\mapsto p+q2^\beta$. -/
theorem hasDerivAt_two_rpow_affine (p q β : ℝ) :
    HasDerivAt (fun β' ↦ p + q * (2 : ℝ) ^ β') (q * log 2 * 2 ^ β) β := by
  have h := ((hasDerivAt_id' β).const_rpow two_pos).const_mul q |>.const_add p
  convert h using 1; ring

/-- $Q_\beta'=$ `Q1f`. -/
theorem hasDerivAt_Q (β x : ℝ) : HasDerivAt (Q β) (Q1f β x) x := by
  have h := ((((hasDerivAt_id' x).const_mul (2 / 3)).mul ((hasDerivAt_id' x).const_sub 1)).mul
    (((hasDerivAt_id' x).const_mul (4 * (3 - (2 : ℝ) ^ (β + 1)))).const_add
      ((2 : ℝ) ^ (β + 2) - 3)))
  refine h.congr_deriv ?_
  rw [Q1f, two_rpow_add', two_rpow_add', two_rpow_add'', two_rpow_add'']; norm_num; ring

/-- $Q_\beta''=$ `Q2f`. -/
theorem hasDerivAt_Q1f (β x : ℝ) : HasDerivAt (Q1f β) (Q2f β x) x := by
  have h := (((hasDerivAt_id' x).const_mul (4 * ((2 : ℝ) ^ (2 + β) - 5))).const_sub
    (2 / 3 * ((2 : ℝ) ^ (2 + β) - 3))).sub
    ((hasDerivAt_pow 2 x).const_mul (8 * (3 - (2 : ℝ) ^ (1 + β))))
  refine h.congr_deriv ?_
  rw [Q2f]; push_cast; ring

/-- $Q_\beta'''=-16(3-2^{1+\beta})$. -/
theorem hasDerivAt_Q2f (β x : ℝ) : HasDerivAt (Q2f β) (-16 * (3 - 2 ^ (1 + β))) x := by
  have h := ((hasDerivAt_id' x).const_mul (16 * (3 - (2 : ℝ) ^ (1 + β)))).const_sub
    (-4 * ((2 : ℝ) ^ (2 + β) - 5))
  refine h.congr_deriv ?_
  ring

/-- `deriv (Q β) = Q1f β`. -/
theorem deriv_Q_eq (β : ℝ) : deriv (Q β) = Q1f β := funext fun x ↦ (hasDerivAt_Q β x).deriv

/-- `deriv (deriv (Q β)) = Q2f β`. -/
theorem deriv2_Q_eq (β : ℝ) : deriv (deriv (Q β)) = Q2f β := by
  rw [deriv_Q_eq]; exact funext fun x ↦ (hasDerivAt_Q1f β x).deriv

/-- $Q_\beta'''=-16(3-2^{1+\beta})$. -/
theorem deriv3_Q_eq (β : ℝ) :
    deriv (deriv (deriv (Q β))) = fun _ ↦ -16 * (3 - (2 : ℝ) ^ (1 + β)) := by
  rw [deriv2_Q_eq]; exact funext fun x ↦ (hasDerivAt_Q2f β x).deriv

/-- $Q_\beta$ is continuous. -/
theorem continuous_Q (β : ℝ) : Continuous (Q β) := by
  unfold Q; fun_prop

/-- For $x\in(0,e^{-1})$, $\log\frac1x>1$. -/
theorem one_lt_log_inv_of_mem {x : ℝ} (hx : x ∈ Ioo 0 (exp (-1))) : 1 < log x⁻¹ := by
  have := log_lt_log hx.1 hx.2
  rw [log_exp] at this
  rw [log_inv]; linarith

/-- $\log\frac1{\log2}>0$. -/
theorem log_inv_log_two_pos : 0 < log (log 2)⁻¹ := by
  have hl : 0 < log 2 := log_pos one_lt_two
  have hl1 : log 2 < 1 := by linarith [log_two_lt_d9]
  exact log_pos ((one_lt_inv₀ hl).2 hl1)

/-- The $\beta$-derivative of $\log(-L''_\beta(x))$, with $L''_\beta$ written as `L2f`:
$\beta^{-1}-\log\log2+\log\log\frac1x-(1-\beta+\log\frac1x)^{-1}$. -/
theorem hasDerivAt_log_neg_L2f {x β : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (hβ : 0 < β)
    (hβu : 0 < 1 - β + log x⁻¹) :
    HasDerivAt (fun β' ↦ log (-L2f β' x))
      (β⁻¹ - log (log 2) + log (log x⁻¹) - (1 - β + log x⁻¹)⁻¹) β := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hl : 0 < log 2 := log_pos one_lt_two
  have hx0 : x ≠ 0 := hx.1.ne'
  have hf : (fun β' ↦ log (-L2f β' x)) = fun β' ↦
      log (β' * (log 2) ^ (-β') * x⁻¹ * (log x⁻¹) ^ (-2 + β') * (1 - β' + log x⁻¹)) := by
    funext β'; congr 1; simp only [L2f]; ring
  rw [hf]
  have h1 := (hasDerivAt_id' β).neg.const_rpow hl
  have h2 := ((hasDerivAt_id' β).const_add (-2)).const_rpow hu
  have h := (((((hasDerivAt_id' β).mul h1).mul_const x⁻¹).mul h2).mul
    ((hasDerivAt_id' β).const_sub (1 + log x⁻¹)))
  have hP : 0 < β * (log 2) ^ (-β) * x⁻¹ * (log x⁻¹) ^ (-2 + β) * (1 - β + log x⁻¹) := by
    have := rpow_pos_of_pos hl (-β)
    have := rpow_pos_of_pos hu (-2 + β)
    have := inv_pos.2 hx.1
    positivity
  have h' := h.log (by
    simp only [Pi.mul_apply, Pi.neg_apply]
    rw [show 1 + log x⁻¹ - β = 1 - β + log x⁻¹ by ring]; exact hP.ne')
  refine (h'.congr_of_eventuallyEq (Eventually.of_forall fun b ↦ ?_)).congr_deriv ?_
  · simp only [Pi.mul_apply, Pi.neg_apply]; congr 1; ring
  have hA : (log 2) ^ (-β) ≠ 0 := (rpow_pos_of_pos hl _).ne'
  have hB : (log x⁻¹) ^ (-2 + β) ≠ 0 := (rpow_pos_of_pos hu _).ne'
  have hC : 1 + log x⁻¹ - β ≠ 0 := by linarith
  have hC' : 1 - β + log x⁻¹ ≠ 0 := hβu.ne'
  simp only [Pi.mul_apply, Pi.neg_apply]
  generalize (log 2) ^ (-β) = A at hA ⊢
  generalize (log x⁻¹) ^ (-2 + β) = B at hB ⊢
  generalize log x⁻¹ = u at hC hC' ⊢
  have hβ0 : β ≠ 0 := hβ.ne'
  have hD : 1 - β + u = 1 + u - β := by ring
  rw [hD] at hC' ⊢
  field_simp
  ring

/-- $-L''_\beta(x)=\beta(1-\beta+\log\frac1x)\,x^{-1}(\log\frac1x)^{-2}(\log\frac1x/\log2)^\beta$
on $(0,1)$ (with $L''_\beta$ written as `L2f`). -/
theorem neg_L2f_eq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    -L2f β x = β * (1 - β + log x⁻¹) * (x⁻¹ * (log x⁻¹) ^ (-2 : ℝ)) *
      (log x⁻¹ / log 2) ^ β := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hl : 0 < log 2 := log_pos one_lt_two
  rw [L2f, div_rpow hu.le hl.le, rpow_neg hl.le, rpow_add hu]
  ring

/-- $L'''_\beta(x)=\beta(\log\frac1x/\log2)^\beta\,x^{-2}(\log\frac1x)^{-3}
(\beta(3-\beta)-2+(\log\frac1x)^2)$ on $(0,1)$ (with $L'''_\beta$ written as `L3f`). -/
theorem L3f_eq_alt {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    L3f β x = β * (log x⁻¹ / log 2) ^ β * (x ^ (-2 : ℤ) * (log x⁻¹) ^ (-3 : ℝ)) *
      (β * (3 - β) - 2 + (log x⁻¹) ^ 2) := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hl : 0 < log 2 := log_pos one_lt_two
  rw [L3f, div_rpow hu.le hl.le, rpow_neg hl.le, rpow_add hu]
  ring

/-- For $\log2\le\log\frac1x$, $\beta\mapsto(\log\frac1x/\log2)^\beta$ is monotone. -/
theorem ratio_rpow_mono {x b₁ b₂ : ℝ} (hlu : log 2 ≤ log x⁻¹) (hle : b₁ ≤ b₂) :
    (log x⁻¹ / log 2) ^ b₁ ≤ (log x⁻¹ / log 2) ^ b₂ := by
  have hl : 0 < log 2 := log_pos one_lt_two
  exact rpow_le_rpow_of_exponent_le ((one_le_div hl).2 hlu) hle

/-- For $x\in(0,e^{-1})$, $\beta\mapsto L''_\beta(x)$ (as `L2f`) is antitone on $[\frac12,1]$. -/
theorem L2f_antitoneOn {x : ℝ} (hx : x ∈ Ioo 0 (exp (-1))) :
    AntitoneOn (fun β ↦ L2f β x) (Icc 2⁻¹ 1) := by
  have he : exp (-1) < 1 := by rw [exp_lt_one_iff]; norm_num
  have hx1 : x ∈ Ioo (0 : ℝ) 1 := ⟨hx.1, hx.2.trans he⟩
  have hu1 : 1 < log x⁻¹ := one_lt_log_inv_of_mem hx
  have hl1 : log 2 < 1 := by linarith [log_two_lt_d9]
  have hu : 0 < log x⁻¹ := by linarith
  intro b₁ hb₁ b₂ hb₂ hle
  have h1 := neg_L2f_eq (β := b₁) hx1
  have h2 := neg_L2f_eq (β := b₂) hx1
  have hr := ratio_rpow_mono (x := x) (by linarith) hle
  have hK : 0 < x⁻¹ * (log x⁻¹) ^ (-2 : ℝ) :=
    mul_pos (inv_pos.2 hx.1) (rpow_pos_of_pos hu _)
  have hp : b₁ * (1 - b₁ + log x⁻¹) ≤ b₂ * (1 - b₂ + log x⁻¹) := by
    nlinarith [hb₁.1, hb₂.2]
  have hp0 : 0 ≤ b₁ * (1 - b₁ + log x⁻¹) := by
    have : (0 : ℝ) ≤ b₁ := by linarith [hb₁.1]
    have : (0 : ℝ) ≤ 1 - b₁ + log x⁻¹ := by linarith [hb₁.2]
    positivity
  have hr0 : 0 ≤ (log x⁻¹ / log 2) ^ b₁ := rpow_nonneg (by positivity) _
  show L2f b₂ x ≤ L2f b₁ x
  have : b₁ * (1 - b₁ + log x⁻¹) * (x⁻¹ * (log x⁻¹) ^ (-2 : ℝ)) * (log x⁻¹ / log 2) ^ b₁ ≤
      b₂ * (1 - b₂ + log x⁻¹) * (x⁻¹ * (log x⁻¹) ^ (-2 : ℝ)) * (log x⁻¹ / log 2) ^ b₂ := by
    apply mul_le_mul _ hr hr0 (by nlinarith)
    exact mul_le_mul_of_nonneg_right hp hK.le
  linarith

/-- For $x\in(0,1)$ with $\log2\le\log\frac1x$ and $\beta(3-\beta)-2+(\log\frac1x)^2>0$ on
$[\frac12,1]$, $\beta\mapsto L'''_\beta(x)$ (as `L3f`) is monotone on $[\frac12,1]$. -/
theorem L3f_monotoneOn {x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (hlu : log 2 ≤ log x⁻¹)
    (hpos : ∀ β ∈ Icc (2⁻¹ : ℝ) 1, 0 < β * (3 - β) - 2 + (log x⁻¹) ^ 2) :
    MonotoneOn (fun β ↦ L3f β x) (Icc 2⁻¹ 1) := by
  have hl : 0 < log 2 := log_pos one_lt_two
  have hu : 0 < log x⁻¹ := by linarith
  intro b₁ hb₁ b₂ hb₂ hle
  show L3f b₁ x ≤ L3f b₂ x
  rw [L3f_eq_alt hx, L3f_eq_alt hx]
  have hr := ratio_rpow_mono (x := x) hlu hle
  have hK : 0 < x ^ (-2 : ℤ) * (log x⁻¹) ^ (-3 : ℝ) :=
    mul_pos (zpow_pos hx.1 _) (rpow_pos_of_pos hu _)
  have hr0 : 0 ≤ (log x⁻¹ / log 2) ^ b₁ := rpow_nonneg (by positivity) _
  have hk : b₁ * (3 - b₁) - 2 + (log x⁻¹) ^ 2 ≤ b₂ * (3 - b₂) - 2 + (log x⁻¹) ^ 2 := by
    nlinarith [hb₁.1, hb₂.2]
  have hk0 := hpos b₁ hb₁
  have hb0 : (0 : ℝ) ≤ b₁ := by linarith [hb₁.1]
  have h1 : b₁ * (log x⁻¹ / log 2) ^ b₁ ≤ b₂ * (log x⁻¹ / log 2) ^ b₂ :=
    mul_le_mul hle hr hr0 (by linarith)
  have h2 : b₁ * (log x⁻¹ / log 2) ^ b₁ * (x ^ (-2 : ℤ) * (log x⁻¹) ^ (-3 : ℝ)) ≤
      b₂ * (log x⁻¹ / log 2) ^ b₂ * (x ^ (-2 : ℤ) * (log x⁻¹) ^ (-3 : ℝ)) :=
    mul_le_mul_of_nonneg_right h1 hK.le
  exact mul_le_mul h2 hk hk0.le (mul_nonneg (mul_nonneg (by linarith)
    (rpow_nonneg (by positivity) _)) hK.le)

/-- Powers of two: $2^{1+\beta}=2\cdot2^\beta$. -/
theorem two_rpow_one_add (β : ℝ) : (2 : ℝ) ^ (1 + β) = 2 * 2 ^ β := by
  rw [two_rpow_add'']; norm_num

/-- Powers of two: $2^{\beta+1}=2\cdot2^\beta$. -/
theorem two_rpow_add_one' (β : ℝ) : (2 : ℝ) ^ (β + 1) = 2 * 2 ^ β := by
  rw [two_rpow_add']; norm_num

/-- Powers of two: $2^{2+\beta}=4\cdot2^\beta$. -/
theorem two_rpow_two_add (β : ℝ) : (2 : ℝ) ^ (2 + β) = 4 * 2 ^ β := by
  rw [two_rpow_add'']; norm_num

/-- Powers of two: $2^{\beta+2}=4\cdot2^\beta$. -/
theorem two_rpow_add_two (β : ℝ) : (2 : ℝ) ^ (β + 2) = 4 * 2 ^ β := by
  rw [two_rpow_add']; norm_num

/-- Powers of two: $2^{3+\beta}=8\cdot2^\beta$. -/
theorem two_rpow_three_add (β : ℝ) : (2 : ℝ) ^ (3 + β) = 8 * 2 ^ β := by
  rw [two_rpow_add'']; norm_num

/-- Powers of two: $2^{4+\beta}=16\cdot2^\beta$. -/
theorem two_rpow_four_add (β : ℝ) : (2 : ℝ) ^ (4 + β) = 16 * 2 ^ β := by
