/-- For $\beta\ge\frac12$, $2^\beta>1.414$. -/
theorem two_rpow_gt_of_half_le {β : ℝ} (hβ : 2⁻¹ ≤ β) : (1.414 : ℝ) < 2 ^ β := by
  have h1 : (2 : ℝ) ^ (2⁻¹ : ℝ) ≤ 2 ^ β := rpow_le_rpow_of_exponent_le one_le_two hβ
  have h2 : (2 : ℝ) ^ (2⁻¹ : ℝ) = √2 := by rw [sqrt_eq_rpow]; norm_num
  have h3 : (1.414 : ℝ) < √2 := by rw [lt_sqrt (by norm_num)]; norm_num
  linarith

/-- For $\beta\le1$, $2^\beta\le2$. -/
theorem two_rpow_le_two_of_le_one {β : ℝ} (hβ : β ≤ 1) : (2 : ℝ) ^ β ≤ 2 := by
  have := rpow_le_rpow_of_exponent_le one_le_two hβ
  simpa using this

