section Proof_Theorem_1_1
/-- [DIR], §2.2, proof of Theorem 1.1: $b_\beta(x)=Q_\beta(x)\ge L_\beta(x)$ for
$x\in[\frac14,\frac12]$ (here $\beta=\beta_0$). -/
theorem b_eq_Q_ge_L (x : ℝ) (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) :
    b β₀ x = Q β₀ x ∧ Q β₀ x ≥ L β₀ x := by
  have hl : 0 < log 2 := log_pos one_lt_two
  have h1 : (11 / 20 : ℝ) ≤ log₂ (3 / 2) := by
    rw [logb, le_div_iff₀ hl]
    have := log_le_log (by positivity) (by norm_num : (2 : ℝ) ^ 11 ≤ (3 / 2) ^ 20)
    rw [log_pow, log_pow] at this; push_cast at this; linarith
  have hβ : β₀ ∈ Icc (2⁻¹ : ℝ) (log₂ (3 / 2)) := ⟨by norm_num [β₀], by norm_num [β₀]; linarith⟩
  refine ⟨?_, (lemma_5_9 β₀ hβ).2 x hx⟩
  rw [b]
  split_ifs with h h'
  · rw [le_antisymm h hx.1]; linarith [(lemma_5_9_1_endpoints β₀).2]
  · rfl
  · exact absurd hx.2 h'

/-- [DIR], §2.2, proof of Theorem 1.1: for $\beta=\beta_0$, (1.1) follows from (2.6). -/
theorem eqn_1_1_β₀ (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) (hA : ｜A｜ ≤ 2⁻¹) :
    𝐄 h A ^ β₀ ≥ ｜A｜ * (log₂ ｜A｜⁻¹) ^ β₀ := by
  have h1 := cor_2_5.1 ｜A｜ (dens_mem_dyadic n A)
  have h2 := isoProfile_le_expect (β := β₀) hn A
  have h3 : L β₀ ｜A｜ ≤ b β₀ ｜A｜ := by
    rcases le_or_gt ｜A｜ 4⁻¹ with h | h
    · rw [b_of_le_quarter h]
    · obtain ⟨hb, hQ⟩ := b_eq_Q_ge_L ｜A｜ ⟨h.le, hA⟩
      rw [hb]; exact hQ
  exact h3.trans (h1.trans h2)

end Proof_Theorem_1_1

section Proof_Theorem_1_5
/-- [DIR], §2.2, proof of Theorem 1.5 (implicit): $b_{\frac12}(2^{-k})=2^{-k}\sqrt k$ for $k\ge1$,
so that (2.7) gives the lower bound of Theorem 1.5. -/
theorem b_half_two_pow (k : ℕ) (hk : 1 ≤ k) : b 2⁻¹ (2⁻¹ ^ k) = 2⁻¹ ^ k * √k := by
  rcases Nat.lt_or_ge k 2 with hk2 | hk2
  · have : k = 1 := by omega
    subst this
    have h2 : (2 : ℝ) ^ ((2⁻¹ : ℝ) + 2) = 4 * 2 ^ (2⁻¹ : ℝ) := by
      rw [Real.rpow_add two_pos]; norm_num; ring
    have h1 : (2 : ℝ) ^ ((2⁻¹ : ℝ) + 1) = 2 * 2 ^ (2⁻¹ : ℝ) := by
      rw [Real.rpow_add two_pos]; norm_num; ring
    simp only [b, pow_one, Nat.cast_one, Real.sqrt_one, mul_one]
    rw [ite_eq_right (by norm_num), ite_eq_left le_rfl, Q, h2, h1]
    ring
  · have hle : (2⁻¹ : ℝ) ^ k ≤ 4⁻¹ := by
      calc (2⁻¹ : ℝ) ^ k ≤ 2⁻¹ ^ 2 := pow_le_pow_of_le_one (by norm_num) (by norm_num) hk2
        _ = 4⁻¹ := by norm_num
    simp only [b, ite_eq_left hle, L]
    congr 1
    rw [inv_pow, inv_inv, Real.logb_pow, Real.logb_self_eq_one (by norm_num), mul_one,
      Real.sqrt_eq_rpow, one_div]

/-- [DIR], §2.2, proof of Theorem 1.5: the lower bound follows from (2.7). -/
theorem thm_1_5_lower (k : ℕ) (hk : 1 ≤ k) : 𝓑 2⁻¹ (2⁻¹ ^ k) ≥ 0.997 * 2⁻¹ ^ k * √k := by
  have hq : (2⁻¹ : ℝ) ^ k ∈ 𝒬 :=
    ⟨k, 1, Nat.one_le_two_pow, by push_cast; rw [inv_pow, one_div]⟩
  have h := cor_2_5.2 _ hq
  rw [b_half_two_pow k hk] at h
  rw [mul_assoc]
  exact h

/-- [DIR], §2.2, proof of Theorem 1.5: the upper bound follows from letting $A$ be a subcube of
codimension $k$.

**Unused hypothesis.** The paper assumes $k\ge1$; this is not needed for the claim and is omitted
in the Lean statement. -/
theorem thm_1_5_upper (k : ℕ) : 2⁻¹ ^ k * √k ≥ 𝓑 2⁻¹ (2⁻¹ ^ k) := by
  have := isoProfile_two_pow_le 2⁻¹ (by norm_num) k
  rwa [Real.sqrt_eq_rpow, one_div]

end Proof_Theorem_1_5

section Proof_Theorem_1_7
/-- **(2.9)** ([DIR], §2.2, shown in Lemma 5.13).
$$J(x)>L_{\beta_0}(1-x)\quad\text{for}\quad x\in(\tfrac12,1-10^{-10^{380}}).$$ -/
theorem eqn_2_9 (x : ℝ) (hx : x ∈ Ioo 2⁻¹ (1 - (10 : ℝ) ^ (-(10 : ℝ) ^ 380))) :
    J x > L β₀ (1 - x) := lemma_5_13 x hx

/-- [DIR], §2.2: $\tilde b_{\beta_0}(x)=\max(b_{\beta_0}(x),\tilde L(x))$ for $x\in[0,1]$. -/
theorem btilde_eq_max (x : ℝ) (hx : x ∈ Icc (0 : ℝ) 1) : b̃ β₀ x = max (b β₀ x) (L̃ x) := by
  simp only [btilde, b, Ltilde]
  by_cases h4 : x ≤ 4⁻¹
  · rw [ite_eq_left h4, ite_eq_left h4, ite_eq_right (by linarith), max_eq_left]
    have hl : 0 ≤ Real.logb 2 x⁻¹ := by
      rcases hx.1.lt_or_eq with hx0 | hx0
      · exact Real.logb_nonneg (by norm_num) ((one_le_inv₀ hx0).2 (by linarith))
      · simp [← hx0]
    exact mul_nonneg hx.1 (Real.rpow_nonneg hl _)
  · rw [ite_eq_right h4, ite_eq_right h4]
    by_cases h2 : x ≤ 2⁻¹
    · rw [ite_eq_left h2, ite_eq_left h2]
      rcases h2.lt_or_eq with h2' | h2'
      · rw [ite_eq_right (by linarith), max_eq_left]
        have hs : 0 ≤ (2 : ℝ) ^ β₀ := Real.rpow_nonneg (by norm_num) _
        have e2 : (2 : ℝ) ^ (β₀ + 2) = 4 * 2 ^ β₀ := by
          rw [Real.rpow_add two_pos]; norm_num; ring
        have e1 : (2 : ℝ) ^ (β₀ + 1) = 2 * 2 ^ β₀ := by
          rw [Real.rpow_add two_pos]; norm_num; ring
        rw [Q, e2, e1]
        have hlin : 0 ≤ 4 * 2 ^ β₀ - 3 + 4 * (3 - 2 * 2 ^ β₀) * x := by nlinarith
        have : 0 ≤ 2 / 3 * x * (1 - x) := by
          have := hx.1; nlinarith
        exact mul_nonneg this hlin
      · subst h2'
        rw [ite_eq_left le_rfl, (J_half_eq_L_half β₀).2]
        have e2 : (2 : ℝ) ^ (β₀ + 2) = 4 * 2 ^ β₀ := by
          rw [Real.rpow_add two_pos]; norm_num; ring
        have e1 : (2 : ℝ) ^ (β₀ + 1) = 2 * 2 ^ β₀ := by
          rw [Real.rpow_add two_pos]; norm_num; ring
        have hQ : Q β₀ 2⁻¹ = 2⁻¹ := by rw [Q, e2, e1]; ring
        rw [hQ, max_self]
    · rw [ite_eq_right h2, ite_eq_right h2, ite_eq_left (by linarith)]

/-- [DIR], §2.2 (cited from [BIM23, Lemma 2.3]): the function $x\mapsto L_{\beta_0}(1-x)$
satisfies $G_{\beta_0}[\tilde L](x,y)\ge0$ for all $\frac12\le x\le y\le1$. -/
theorem Ltilde_twopt (x y : ℝ) (hx : 2⁻¹ ≤ x) (hxy : x ≤ y) (hy : y ≤ 1) :
    G β₀ (fun t ↦ L β₀ (1 - t)) x y ≥ 0 := by
  have hl := Real.log_two_gt_d9
  have hb := bim_lemma_2_3 β₀ (by norm_num [β₀]) (by norm_num [β₀] at hl ⊢; linarith)
    (1 - y) (1 - x) (by linarith) (by linarith) (by linarith)
  rw [show 1 - x - (1 - y) = y - x by ring,
    show (1 - y + (1 - x)) / 2 = 1 - (x + y) / 2 by ring] at hb
  simp only [G, G₁, ge_iff_le]
  exact le_max_of_le_left (by linarith)

/-- [DIR], §2.2: the estimate (2.9) means that
$b_{\beta_0}(\frac{x+y}2)<\tilde L(\frac{x+y}2)$ can only happen when
$\frac{x+y}2\ge1-10^{-10^{380}}$, which in particular implies
$y\ge x=2\frac{x+y}2-y\ge\frac12$ (for $0\le x\le y\le1$). -/
theorem b_lt_Ltilde_imp (x y : ℝ) (hx : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 1)
    (h : b β₀ ((x + y) / 2) < L̃ ((x + y) / 2)) :
    (x + y) / 2 ≥ 1 - (10 : ℝ) ^ (-(10 : ℝ) ^ 380) ∧ y ≥ x ∧ x ≥ 2⁻¹ := by
  have hε : (10 : ℝ) ^ (-(10 : ℝ) ^ 380) ≤ 10⁻¹ := by
    calc (10 : ℝ) ^ (-(10 : ℝ) ^ 380) ≤ (10 : ℝ) ^ (-1 : ℝ) :=
          rpow_le_rpow_of_exponent_le (by norm_num)
            (by rw [neg_le_neg_iff]; exact one_le_pow₀ (by norm_num))
      _ = 10⁻¹ := rpow_neg_one 10
  have hbnn : 0 ≤ b β₀ ((x + y) / 2) :=
    b_nonneg (mem_Ico_of_caseQ (Or.inr rfl)) ⟨by linarith, by linarith⟩
  have hm2 : 2⁻¹ ≤ (x + y) / 2 := by
    by_contra hlt
    rw [not_le] at hlt
    rw [Ltilde, ite_eq_right (not_le.2 hlt)] at h
    linarith
  have hmε : (x + y) / 2 ≥ 1 - (10 : ℝ) ^ (-(10 : ℝ) ^ 380) := by
    by_contra hlt
    rw [ge_iff_le, not_le] at hlt
    rcases hm2.lt_or_eq with hlt2 | heq
    · have h9 := eqn_2_9 _ ⟨hlt2, hlt⟩
      rw [b_of_half_le hm2, Ltilde, ite_eq_left hm2] at h
      linarith
    · rw [← heq, b_of_half_le le_rfl, Ltilde, ite_eq_left le_rfl, (J_half_eq_L_half β₀).1,
        (J_half_eq_L_half β₀).2] at h
      exact lt_irrefl _ h
  exact ⟨hmε, hxy, by linarith⟩

/-- **(2.8)** ([DIR], §2.2). $\tilde b_{\beta_0}$ also satisfies the two-point inequality
$$G_{\beta_0}[\tilde b_{\beta_0}](x,y)\ge0$$
for all $0\le x\le y\le1$. -/
theorem eqn_2_8 (x y : ℝ) (hx : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 1) :
    G β₀ (b̃ β₀) x y ≥ 0 := by
  have hβ : (0 : ℝ) < β₀ := by norm_num [β₀]
  have hβI : β₀ ∈ Ico (2⁻¹ : ℝ) (log₂ (3 / 2)) := mem_Ico_of_caseQ (Or.inr rfl)
  have key := lemma_5_2 (𝓛G β₀) 0 1 (𝓛G_mono hβ) (b β₀) L̃
    (fun x y hx hxy hy _ ↦
      (G_nonneg_iff_𝓛G (b_nonneg hβI ⟨hx.trans hxy, hy⟩)).1 (thm_2_2 x y hx hxy hy).1)
    (fun x y hx hxy hy hlt ↦ by
      obtain ⟨-, -, hx2⟩ := b_lt_Ltilde_imp x y hx hxy hy hlt
      have hG := Ltilde_twopt x y hx2 hxy hy
      have hyL : 0 ≤ L β₀ (1 - y) := L_nonneg ⟨by linarith, by linarith⟩
      have e : ∀ t, 2⁻¹ ≤ t → L̃ t = L β₀ (1 - t) := fun t ht ↦ by rw [Ltilde, ite_eq_left ht]
      rw [e x hx2, e y (hx2.trans hxy), e _ (by linarith)]
      exact (G_nonneg_iff_𝓛G (B := fun t ↦ L β₀ (1 - t)) hyL).1 hG)
    x y hx hxy hy
  have hm : (x + y) / 2 ∈ Icc (0 : ℝ) 1 := ⟨by linarith, by linarith⟩
  rw [← btilde_eq_max x ⟨hx, hxy.trans hy⟩, ← btilde_eq_max y ⟨hx.trans hxy, hy⟩,
    ← btilde_eq_max _ hm] at key
  have hy' : 0 ≤ b̃ β₀ y := by
    rw [btilde_eq_max y ⟨hx.trans hxy, hy⟩]
    exact (b_nonneg hβI ⟨hx.trans hxy, hy⟩).trans (le_max_left _ _)
  exact (G_nonneg_iff_𝓛G hy').2 key

/-- [DIR], §2.2, proof of Theorem 1.7 (implicit in "it suffices to show" and "Theorem 1.7
follows"): by Proposition 2.1 and (2.8), $\mathcal{B}_{\beta_0}\ge\tilde b_{\beta_0}$ on
$\mathcal{Q}$; since $\tilde b_{\beta_0}(x)=\max(J(x),L_{\beta_0}(1-x))$ for $x\in[\frac12,1]$,
this is (1.6). -/
theorem isoProfile_ge_btilde (x : ℝ) (hx : x ∈ 𝒬) : 𝓑 β₀ x ≥ b̃ β₀ x := by
  have hβI : β₀ ∈ Ico (2⁻¹ : ℝ) (log₂ (3 / 2)) := mem_Ico_of_caseQ (Or.inr rfl)
  refine prop_2_1 β₀ (by norm_num [β₀]) (by norm_num [β₀]) (b̃ β₀) (fun t ht ↦ ?_) btilde_zero
    btilde_one (fun x y hx hxy hy ↦ eqn_2_8 x y hx hxy hy) x hx
  rw [btilde_eq_max t ht]
  exact (b_nonneg hβI ht).trans (le_max_left _ _)

end Proof_Theorem_1_7

