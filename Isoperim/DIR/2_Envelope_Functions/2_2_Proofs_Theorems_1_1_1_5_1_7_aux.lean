namespace Auto.DIR

open Real Set

/-- $\mathcal{L}(x,y,u,v)=\frac12(\max(((y-x)^{1/\beta}+(v^+)^{1/\beta})^\beta,\
y-x+(2^\beta-1)v)+u)$: $G_\beta[B](x,y)\ge0$ is (5.1) for this $\mathcal{L}$ (if $B(y)\ge0$). -/
noncomputable def 𝓛G (β x y u v : ℝ) : ℝ :=
  (max (((y - x) ^ β⁻¹ + max v 0 ^ β⁻¹) ^ β) (y - x + (2 ^ β - 1) * v) + u) / 2

/-- $\mathcal{L}$ of `𝓛G` is monotone increasing in $u,v$ (for $\beta>0$). -/
theorem 𝓛G_mono {β : ℝ} (hβ : 0 < β) : IsMonotoneTwoPoint (𝓛G β) 0 1 := by
  intro x y _ hxy _ u u' v v' hu hv
  have h1 : max v 0 ^ β⁻¹ ≤ max v' 0 ^ β⁻¹ :=
    rpow_le_rpow (le_max_right _ _) (max_le_max hv le_rfl) (inv_nonneg.2 hβ.le)
  have h0 : 0 ≤ (y - x) ^ β⁻¹ + max v 0 ^ β⁻¹ :=
    add_nonneg (rpow_nonneg (by linarith) _) (rpow_nonneg (le_max_right _ _) _)
  have h2 : ((y - x) ^ β⁻¹ + max v 0 ^ β⁻¹) ^ β ≤ ((y - x) ^ β⁻¹ + max v' 0 ^ β⁻¹) ^ β :=
    rpow_le_rpow h0 (by linarith) hβ.le
  have hc : 0 ≤ (2 : ℝ) ^ β - 1 := by
    have : (1 : ℝ) ≤ 2 ^ β := one_le_rpow (by norm_num) hβ.le
    linarith
  have h3 : y - x + (2 ^ β - 1) * v ≤ y - x + (2 ^ β - 1) * v' := by
    nlinarith [mul_le_mul_of_nonneg_left hv hc]
  unfold 𝓛G
  have := max_le_max h2 h3
  linarith

/-- For $B(y)\ge0$: $G_\beta[B](x,y)\ge0$ iff $\mathcal{L}(x,y,B(x),B(y))\ge B(\frac{x+y}2)$. -/
theorem G_nonneg_iff_𝓛G {β : ℝ} {B : ℝ → ℝ} {x y : ℝ} (hB : 0 ≤ B y) :
    G β B x y ≥ 0 ↔ 𝓛G β x y (B x) (B y) ≥ B ((x + y) / 2) := by
  unfold G G₁ G₂ 𝓛G
  rw [max_eq_left hB]
  have e : max (((y - x) ^ β⁻¹ + B y ^ β⁻¹) ^ β + B x - 2 * B ((x + y) / 2))
      (y - x + (2 ^ β - 1) * B y + B x - 2 * B ((x + y) / 2)) =
      max (((y - x) ^ β⁻¹ + B y ^ β⁻¹) ^ β) (y - x + (2 ^ β - 1) * B y) +
        (B x - 2 * B ((x + y) / 2)) := by
    rw [← max_add_add_right]; ring_nf
  rw [e]
  constructor <;> intro h <;> linarith

/-- $\tilde b_{\beta_0}(0)=0$. -/
theorem btilde_zero : b̃ β₀ 0 = 0 := by
  rw [btilde, ite_eq_left (by norm_num), L_zero]

/-- $\tilde b_{\beta_0}(1)=0$. -/
theorem btilde_one : b̃ β₀ 1 = 0 := by
  rw [btilde, ite_eq_right (by norm_num), ite_eq_right (by norm_num), J_one, sub_self, L_zero,
    max_self]

end Auto.DIR
