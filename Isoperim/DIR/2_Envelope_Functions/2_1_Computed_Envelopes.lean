/-
In order to find a good candidate $B$ it is helpful to observe that if $B_1, B_2$ satisfy
\eqref{eqn:twoptineq} [(2.2)], then so does $\max(B_1,B_2)$. This is a consequence of monotonicity
(see Lemma \ref{lem:maxlemma2} [5.2]) and the same holds for the supremum of a families of such
functions $(B_i)_{i\in I}$.
-/

/-- [DIR], §2.1: if $B_1,B_2\ge0$ satisfy (2.2) for all $0\le x\le y\le1$, then so does
$\max(B_1,B_2)$. -/
theorem twopt_max (β : ℝ) (hβ : 1 / 2 ≤ β) (B₁ B₂ : ℝ → ℝ)
    (hB₁ : ∀ x ∈ Icc (0 : ℝ) 1, 0 ≤ B₁ x) (hB₂ : ∀ x ∈ Icc (0 : ℝ) 1, 0 ≤ B₂ x)
    (h₁ : ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G β B₁ x y ≥ 0)
    (h₂ : ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G β B₂ x y ≥ 0) :
    ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G β (fun t ↦ max (B₁ t) (B₂ t)) x y ≥ 0 := by
  sorry

/-- [DIR], §2.1: the same holds for the supremum of a (nonempty, pointwise bounded) family
$(B_i)_{i\in I}$ of nonnegative functions satisfying (2.2) for all $0\le x\le y\le1$. -/
theorem twopt_iSup (β : ℝ) (hβ : 1 / 2 ≤ β) {ι : Type*} [Nonempty ι] (B : ι → ℝ → ℝ)
    (hB : ∀ i, ∀ x ∈ Icc (0 : ℝ) 1, 0 ≤ B i x) (hbdd : ∀ x, BddAbove (range fun i ↦ B i x))
    (h : ∀ i, ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G β (B i) x y ≥ 0) :
    ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G β (fun t ↦ ⨆ i, B i t) x y ≥ 0 := by
  sorry

/-- **Definition 2.7** ([DIR]). The *$\beta$-envelope* $\mathfrak{B}_\beta$ is the supremum of
$B$ over all functions $B:[0,1]\to[0,\infty)$ such that $B(0)=B(1)=0$ and (2.2) holds for all
$0\le x\le y\le1$ with $x,y\in\mathcal{Q}$. (The supremum is meaningful for $x\in\mathcal{Q}$; at
points where the set of values is unbounded, `sSup` returns the junk value $0$.) -/
noncomputable def envelope (β x : ℝ) : ℝ :=
  sSup {v : ℝ | ∃ B : ℝ → ℝ, (∀ t ∈ Icc (0 : ℝ) 1, 0 ≤ B t) ∧ B 0 = 0 ∧ B 1 = 0 ∧
    (∀ s t : ℝ, s ∈ 𝒬 → t ∈ 𝒬 → 0 ≤ s → s ≤ t → t ≤ 1 → G β B s t ≥ 0) ∧ v = B x}

@[inherit_doc] notation "𝔅" => envelope

/-- [DIR], §2.1, after Definition 2.7: by the above observation, the $\beta$-envelope satisfies
(2.2) (for $0\le x\le y\le1$ with $x,y\in\mathcal{Q}$). -/
theorem envelope_twopt (β : ℝ) (hβ : 1 / 2 ≤ β) (x y : ℝ) (hxQ : x ∈ 𝒬) (hyQ : y ∈ 𝒬)
    (hx : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 1) : G β (𝔅 β) x y ≥ 0 := by
  sorry

/-- [DIR], §2.1, after Definition 2.7: Proposition 2.1 implies
$\mathcal{B}_\beta\ge\mathfrak{B}_\beta$ (on $\mathcal{Q}$). -/
theorem isoProfile_ge_envelope (β : ℝ) (hβ : 1 / 2 ≤ β) (x : ℝ) (hx : x ∈ 𝒬) :
