module

public import Isoperim.DIR.«1_Introduction».Thm_1_5
public import Isoperim.DIR.«1_Introduction».Thm_1_7

/-!
# [DIR] §2 Envelope functions (beginning of §2, before §2.1)

This file was automatically generated by Claude.

Source [DIR]: P. Durcik, P. Ivanisvili, J. Roos, *Sharp isoperimetric inequalities on the Hamming
cube near the critical exponent*, arXiv:2407.12674v2.

This file covers the part of §2 preceding §2.1: the two-point functionals (2.1), Proposition 2.1,
the functions $L_\beta$, $Q_\beta$, $b_\beta$ (2.3), Theorem 2.2 (main two-point inequality),
Remarks 2.3, 2.4, Corollary 2.5 and Remark 2.6.

## Notation introduced here

* `G₁ β B x y`, `G₂ β B x y`, `G β B x y` : $G^1_\beta[B](x,y)$, $G^2_\beta[B](x,y)$,
  $G_\beta[B](x,y)$ of (2.1);
* `L β x`, `Q β x`, `b β x` : $L_\beta(x)$, $Q_\beta(x)$, $b_\beta(x)$;
* `c • B` : the function $c\cdot B$ (pointwise scalar multiple).
-/

@[expose] public section

namespace Auto.DIR

open Real Set

/-- **(2.1)** ([DIR], §2). For $B:[0,1]\to[0,\infty)$, $\beta\ge\frac12$, $0\le x\le y\le1$,
$$G^1_\beta[B](x,y)=((y-x)^{1/\beta}+B(y)^{1/\beta})^\beta+B(x)-2B(\tfrac{x+y}2).$$ -/
noncomputable def G₁ (β : ℝ) (B : ℝ → ℝ) (x y : ℝ) : ℝ :=
  ((y - x) ^ (1 / β) + B y ^ (1 / β)) ^ β + B x - 2 * B ((x + y) / 2)

/-- ([DIR], §2, display after (2.1)).
$$G^2_\beta[B](x,y)=y-x+(2^\beta-1)B(y)+B(x)-2B(\tfrac{x+y}2).$$ -/
noncomputable def G₂ (β : ℝ) (B : ℝ → ℝ) (x y : ℝ) : ℝ :=
  y - x + (2 ^ β - 1) * B y + B x - 2 * B ((x + y) / 2)

/-- ([DIR], §2, display after (2.1)).
$$G_\beta[B](x,y)=\max(G^1_\beta[B](x,y),G^2_\beta[B](x,y)).$$ -/
noncomputable def G (β : ℝ) (B : ℝ → ℝ) (x y : ℝ) : ℝ := max (G₁ β B x y) (G₂ β B x y)

/-- **Proposition 2.1** ([DIR], proved by Kahn and Park [KP20]). Let $\beta\ge\frac12$. Suppose
$B:[0,1]\to[0,\infty)$ satisfies $B(0)=B(1)=0$ and that the following two-point inequality
holds:
$$G_\beta[B](x,y)\ge0 \tag{2.2}$$
for all $0\le x\le y\le1$. Then $\mathcal{B}_\beta\ge B$ (on $\mathcal{Q}$, where
$\mathcal{B}_\beta$ is defined). -/
theorem prop_2_1 (β : ℝ) (hβ : 1 / 2 ≤ β) (B : ℝ → ℝ) (hB : ∀ x ∈ Icc (0 : ℝ) 1, 0 ≤ B x)
    (hB0 : B 0 = 0) (hB1 : B 1 = 0)
    (h22 : ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G β B x y ≥ 0) :
    ∀ x ∈ 𝒬, 𝓑 β x ≥ B x := by
  sorry

/-- $L_\beta(x)=x(\log_2(1/x))^\beta$ ([DIR], §2). (At $x=0$ Lean's conventions give
$L_\beta(0)=0$, the continuous extension.) -/
noncomputable def L (β x : ℝ) : ℝ := x * (log₂ (1 / x)) ^ β

/-- The cubic $Q_\beta$ ([DIR], §2): the unique cubic interpolation polynomial with
$Q_\beta(0)=Q_\beta(1)=0$, $Q_\beta(\frac12)=\frac12$ and $Q_\beta(\frac14)=2^{\beta-2}$, i.e.
$Q_\beta(x)=\frac23x(1-x)(2^{\beta+2}-3+4(3-2^{\beta+1})x)$ (see `Auto.DIR.Q_spec` for the
interpolation property). -/
noncomputable def Q (β x : ℝ) : ℝ :=
  2 / 3 * x * (1 - x) * (2 ^ (β + 2) - 3 + 4 * (3 - 2 ^ (β + 1)) * x)

/-- [DIR], §2: $Q_\beta$ is the unique cubic interpolation polynomial such that
$Q_\beta(0)=Q_\beta(1)=0$, $Q_\beta(\frac12)=\frac12$ and $Q_\beta(\frac14)=2^{\beta-2}$; then
$Q_\beta(x)=\frac23x(1-x)(2^{\beta+2}-3+4(3-2^{\beta+1})x)$. -/
theorem Q_spec (β : ℝ) :
    (∃! p : Polynomial ℝ, p.natDegree ≤ 3 ∧ p.eval 0 = 0 ∧ p.eval 1 = 0 ∧
      p.eval (1 / 2) = 1 / 2 ∧ p.eval (1 / 4) = 2 ^ (β - 2)) ∧
    ∀ p : Polynomial ℝ, p.natDegree ≤ 3 → p.eval 0 = 0 → p.eval 1 = 0 →
      p.eval (1 / 2) = 1 / 2 → p.eval (1 / 4) = 2 ^ (β - 2) → ∀ x, p.eval x = Q β x := by
  sorry

/-- **(2.3)** ([DIR], §2).
$$b_\beta(x)=\begin{cases}L_\beta(x)&x\in[0,\frac14],\\ Q_\beta(x)&x\in[\frac14,\frac12],\\
J(x)&x\in[\frac12,1].\end{cases}$$
Only the values on $[0,1]$ are meaningful. -/
noncomputable def b (β x : ℝ) : ℝ :=
  if x ≤ 1 / 4 then L β x else if x ≤ 1 / 2 then Q β x else J x

/-- The constant $c_0=0.997$ ([DIR], Theorem 2.2). -/
noncomputable def c₀ : ℝ := 0.997

/-- **Theorem 2.2** (Main two-point inequality, [DIR]). Let $\beta_0=0.50057$ and $c_0=0.997$.
Then for all $0\le x\le y\le1$:
$$G_{\beta_0}[b_{\beta_0}](x,y)\ge0, \tag{2.4}$$
$$G_{\frac12}[c_0\cdot b_{\frac12}](x,y)\ge0. \tag{2.5}$$ -/
theorem thm_2_2 (x y : ℝ) (hx : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 1) :
    G β₀ (b β₀) x y ≥ 0 ∧ G (1 / 2) (c₀ • b (1 / 2)) x y ≥ 0 := by
  sorry

/-- **Remark 2.3** ([DIR]). (2.4) continues to hold for all $\beta\in[\beta_0,1]$ (this can be
proved by the same methods, not pursued in the paper): $G_\beta[b_\beta](x,y)\ge0$ for
$0\le x\le y\le1$. -/
theorem rem_2_3 (β : ℝ) (hβ : β ∈ Icc β₀ 1) (x y : ℝ) (hx : 0 ≤ x) (hxy : x ≤ y)
    (hy : y ≤ 1) : G β (b β) x y ≥ 0 := by
  sorry

/-! ### Remark 2.4 -/

/-- **Remark 2.4** ([DIR]), first sentence. Failure for smaller values of $\beta_0$ occurs at
$x=\frac12$ and $y>\frac12$. We record the failure at $\beta=\frac12$ (which is why the constant
$c_0<1$ appears in (2.5)): there is $y\in(\frac12,1]$ with
$G_{\frac12}[b_{\frac12}](\frac12,y)<0$.

**Discrepancy with the paper.** The sentence is informal: it does not say for which
$\beta<\beta_0$ the inequality (2.4) (with $\beta_0$ replaced by $\beta$) fails, nor in what
sense the failure "occurs at" $x=\frac12$. Read literally as "for every $\beta<\beta_0$ there is a
failure point, and all failure points have $x=\frac12$" it is not established in the paper
($\beta_0=0.50057$ is only the exponent for which the computer-assisted proof succeeds; the true
threshold may be smaller). The Lean statement records only the (interpreted) failure at
$\beta=\frac12$ at a point $(\frac12,y)$ with $y>\frac12$, where all values of $b_{\frac12}$
involved are values of $J$ ("the failure only involves the function $J$"). Numerically,
$y\approx0.585$ gives $G^1\approx-3.1\cdot10^{-5}$ and $G^2\approx-0.22$. -/
theorem rem_2_4_failure : ∃ y ∈ Ioc (1 / 2 : ℝ) 1, G (1 / 2) (b (1 / 2)) (1 / 2) y < 0 := by
  sorry

/-- [DIR], Remark 2.4: letting $y\to x$ in the inequality $G_{\frac12}[B](x,y)\ge0$ and assuming
that $B$ is $C^2$ gives the differential inequality $B''B\ge-2$. (Stated for $B\ge0$ of class
$C^2$ on an open interval $(a,b)$ on which the two-point inequality holds.) -/
theorem rem_2_4_local (B : ℝ → ℝ) (a c : ℝ) (hB : ContDiffOn ℝ 2 B (Ioo a c))
    (hB0 : ∀ x ∈ Ioo a c, 0 ≤ B x)
    (h : ∀ x y, x ∈ Ioo a c → y ∈ Ioo a c → x ≤ y → G (1 / 2) B x y ≥ 0) :
    ∀ x ∈ Ioo a c, deriv (deriv B) x * B x ≥ -2 := by
  sorry

/-- **Corollary 2.5** ([DIR]). The following isoperimetric inequalities hold (on $\mathcal{Q}$):
$$\mathcal{B}_{\beta_0}\ge b_{\beta_0}, \tag{2.6}$$
$$\mathcal{B}_{\frac12}\ge0.997\cdot b_{\frac12}. \tag{2.7}$$ -/
theorem cor_2_5 :
    (∀ x ∈ 𝒬, 𝓑 β₀ x ≥ b β₀ x) ∧ (∀ x ∈ 𝒬, 𝓑 (1 / 2) x ≥ 0.997 * b (1 / 2) x) := by
  sorry

/-- **Remark 2.6** ([DIR], added in revised version, August 2026). Somewhat counterintuitively,
by slightly relaxing the requirement $B''B=-2$ to $B''B=-\gamma$ for a $\gamma<2$ one may fix this
defect and obtain a Bellman function yielding (1.1) for the conjectured critical exponent
$\beta=\frac12$ [DIRX26]. -/
theorem rem_2_6 (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) (hA : ｜A｜ ≤ 1 / 2) :
    𝐄 h_{A} ^ (1 / 2 : ℝ) ≥ ｜A｜ * (log₂ (1 / ｜A｜)) ^ (1 / 2 : ℝ) := by
  sorry

end Auto.DIR
