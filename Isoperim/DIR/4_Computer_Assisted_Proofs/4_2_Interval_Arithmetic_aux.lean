module

public import Isoperim.DIR.«1_Introduction».Definitions

/-!
# Auxiliary lemmas for [DIR] §4.2 Interval arithmetic

This file was automatically generated by Claude.

Auxiliary material for `4_2_Interval_Arithmetic.lean`: the product of two numbers in intervals
$[a,b]$, $[c,d]$ lies between the minimum and the maximum of the four products of endpoints.
-/

@[expose] public section

namespace Auto.DIR

open Set

/-- If $u\in[a,b]$, then $uv$ lies between $av$ and $bv$. -/
theorem mul_mem_minmax_left {a b u v : ℝ} (hu : u ∈ Icc a b) :
    min (a * v) (b * v) ≤ u * v ∧ u * v ≤ max (a * v) (b * v) := by
  rcases le_total 0 v with h | h
  · exact ⟨(min_le_left _ _).trans (mul_le_mul_of_nonneg_right hu.1 h),
      (mul_le_mul_of_nonneg_right hu.2 h).trans (le_max_right _ _)⟩
  · exact ⟨(min_le_right _ _).trans (mul_le_mul_of_nonpos_right hu.2 h),
      (mul_le_mul_of_nonpos_right hu.1 h).trans (le_max_left _ _)⟩

/-- If $u\in[a,b]$ and $v\in[c,d]$, then $uv$ lies between the minimum and the maximum of
$ac,ad,bc,bd$. -/
theorem mul_mem_minmax {a b c d u v : ℝ} (hu : u ∈ Icc a b) (hv : v ∈ Icc c d) :
    min (min (a * c) (a * d)) (min (b * c) (b * d)) ≤ u * v ∧
      u * v ≤ max (max (a * c) (a * d)) (max (b * c) (b * d)) := by
  have h1 := mul_mem_minmax_left (v := v) hu
  have h2 := mul_mem_minmax_left (v := a) hv
  have h3 := mul_mem_minmax_left (v := b) hv
  simp only [mul_comm _ a, mul_comm _ b] at h2 h3
  exact ⟨(min_le_min h2.1 h3.1).trans h1.1, h1.2.trans (max_le_max h2.2 h3.2)⟩

end Auto.DIR
