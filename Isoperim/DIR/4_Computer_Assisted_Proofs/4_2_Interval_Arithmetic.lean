namespace Auto.DIR

open Set

/-- An *interval enclosure* of $f$ ([DIR], §4.2): an interval-valued map
$\underline{\overline f}(\underline x,\overline x)=[\underline f(\underline x,\overline x),
\overline f(\underline x,\overline x)]$ such that
$f(x)\in\underline{\overline f}(\underline x,\overline x)$ whenever
$x\in[\underline x,\overline x]$, and $\underline{\overline f}(x,x)=[f(x),f(x)]$. -/
def IsIntervalEnclosure (f : ℝ → ℝ) (fl fu : ℝ → ℝ → ℝ) : Prop :=
  (∀ xl xu x, x ∈ Icc xl xu → f x ∈ Icc (fl xl xu) (fu xl xu)) ∧ ∀ x, fl x x = f x ∧ fu x x = f x

/-- [DIR], §4.2: the canonical interval extension of the order relation
($[\underline x,\overline x]>[\underline y,\overline y]$ iff $\underline x>\overline y$, and
$[\underline x,\overline x]\le[\underline y,\overline y]$ iff $\overline x\le\underline y$) is only
a partial order: there are intervals for which neither relation holds. -/
theorem interval_order_partial :
    ∃ xl xu yl yu : ℝ, xl ≤ xu ∧ yl ≤ yu ∧ ¬ (xl > yu) ∧ ¬ (xu ≤ yl) := by
  sorry

end Auto.DIR
