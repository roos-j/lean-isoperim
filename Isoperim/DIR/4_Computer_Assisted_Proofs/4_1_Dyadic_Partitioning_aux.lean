/-!
# Auxiliary lemmas for [DIR] §4.1 Dyadic partitioning

This file was automatically generated by Claude.

Auxiliary material for `4_1_Dyadic_Partitioning.lean`:

* `dyadicChild`, definitionally equal to `Auto.DIR.child` of the main file, and its elementary
  properties (the $2^n$ children of a rectangle partition it);
* `IsBoxPartition`, definitionally equal to `Auto.DIR.IsRectanglePartition` of the main file;
* `DyadicGood`: success of the dyadic bisection procedure within a given number of levels, and a
  Cousin-type lemma (by bisection) showing that it holds for some number of levels if the lower
  bound is locally positive;
* a characterization of `List.mapM` in the `Option` monad.
-/

@[expose] public section

namespace Auto.DIR

open Set Filter Topology

/-- `List.mapM` in the `Option` monad succeeds with result `L` iff `f` succeeds on each entry with
the corresponding entry of `L`. -/
theorem list_mapM_option_eq_some {α β : Type*} (f : α → Option β) :
    ∀ (l : List α) (L : List β), l.mapM f = some L ↔ List.Forall₂ (fun a b ↦ f a = some b) l L
  | [], L => by cases L <;> simp
  | a :: l, L => by
    cases L with
    | nil =>
      simp only [List.mapM_cons, List.forall₂_nil_right_iff, reduceCtorEq, iff_false]
      cases f a <;> simp
      cases l.mapM f <;> simp
    | cons b L =>
      rw [List.forall₂_cons, ← list_mapM_option_eq_some f l L]
      simp only [List.mapM_cons]
      cases f a <;> simp
      cases l.mapM f <;> simp [eq_comm]

/-- If `List.mapM` in the `Option` monad succeeds with result `L`, then `f` succeeds on every entry
and `L` is the list of the results. -/
theorem list_mapM_option_eq_some_map {α β : Type*} (f : α → Option β) (d : β) {l : List α}
    {L : List β} (h : l.mapM f = some L) :
    L = l.map (fun a ↦ (f a).getD d) ∧ ∀ a ∈ l, (f a).isSome := by
  rw [list_mapM_option_eq_some] at h
  induction h with
  | nil => simp
  | cons hab _ ih => exact ⟨by simp [hab, ih.1], by simpa [hab] using ih.2⟩

/-- `List.mapM` in the `Option` monad succeeds if `f` succeeds on every entry. -/
theorem list_mapM_option_isSome {α β : Type*} (f : α → Option β) :
    ∀ (l : List α), (∀ a ∈ l, (f a).isSome) → (l.mapM f).isSome
  | [], _ => by simp
  | a :: l, h => by
    obtain ⟨b, hb⟩ := Option.isSome_iff_exists.mp (h a (by simp))
    obtain ⟨L, hL⟩ := Option.isSome_iff_exists.mp
      (list_mapM_option_isSome f l fun x hx ↦ h x (by simp [hx]))
    simp [List.mapM_cons, hb, hL]

/-- The child of $[a,b]$ indexed by $s\in\{0,1\}^n$ (same formula as `Auto.DIR.child`). -/
noncomputable def dyadicChild {n : ℕ} (a b : Fin n → ℝ) (s : Fin n → Bool) :
    (Fin n → ℝ) × (Fin n → ℝ) :=
  (fun i ↦ if s i then (a i + b i) / 2 else a i, fun i ↦ if s i then b i else (a i + b i) / 2)

/-- The coordinatewise width of a child is half the width of the parent. -/
theorem dyadicChild_width {n : ℕ} (a b : Fin n → ℝ) (s : Fin n → Bool) (i : Fin n) :
    (dyadicChild a b s).2 i - (dyadicChild a b s).1 i = (b i - a i) / 2 := by
  simp only [dyadicChild]; split_ifs <;> ring

/-- A child of $[a,b]$ lies in $[a,b]$ (lower corner). -/
theorem le_dyadicChild_fst {n : ℕ} {a b : Fin n → ℝ} (hab : a ≤ b) (s : Fin n → Bool) :
    a ≤ (dyadicChild a b s).1 := fun i ↦ by
  have := hab i; simp only [dyadicChild]; split_ifs <;> linarith

/-- A child of $[a,b]$ lies in $[a,b]$ (upper corner). -/
theorem dyadicChild_snd_le {n : ℕ} {a b : Fin n → ℝ} (hab : a ≤ b) (s : Fin n → Bool) :
    (dyadicChild a b s).2 ≤ b := fun i ↦ by
  have := hab i; simp only [dyadicChild]; split_ifs <;> linarith

/-- A child of a rectangle is a rectangle. -/
theorem dyadicChild_lt {n : ℕ} {a b : Fin n → ℝ} (hab : ∀ i, a i < b i) (s : Fin n → Bool)
    (i : Fin n) : (dyadicChild a b s).1 i < (dyadicChild a b s).2 i := by
  have := dyadicChild_width a b s i; have := hab i; linarith

/-- The children of $[a,b]$ cover $[a,b]$. -/
theorem iUnion_dyadicChild {n : ℕ} {a b : Fin n → ℝ} (hab : a ≤ b) :
    (⋃ s, Icc (dyadicChild a b s).1 (dyadicChild a b s).2) = Icc a b := by
  apply Subset.antisymm
  · exact iUnion_subset fun s ↦
      Icc_subset_Icc (le_dyadicChild_fst hab s) (dyadicChild_snd_le hab s)
  · intro x hx
    refine mem_iUnion.mpr ⟨fun i ↦ decide ((a i + b i) / 2 ≤ x i), fun i ↦ ?_, fun i ↦ ?_⟩ <;>
    · have h1 := hx.1 i; have h2 := hx.2 i
      by_cases h : (a i + b i) / 2 ≤ x i <;> simp [dyadicChild, h] <;> linarith

/-- Distinct children have disjoint interiors. -/
theorem disjoint_dyadicChild {n : ℕ} (a b : Fin n → ℝ) {s t : Fin n → Bool} (hst : s ≠ t) :
    Disjoint (Set.pi univ fun i ↦ Ioo ((dyadicChild a b s).1 i) ((dyadicChild a b s).2 i))
      (Set.pi univ fun i ↦ Ioo ((dyadicChild a b t).1 i) ((dyadicChild a b t).2 i)) := by
  obtain ⟨i, hi⟩ : ∃ i, s i ≠ t i := Function.ne_iff.mp hst
  rw [Set.disjoint_left]
  intro z hz hz'
  have h1 := hz i (mem_univ _); have h2 := hz' i (mem_univ _)
  simp only [dyadicChild, mem_Ioo] at h1 h2
  cases hs : s i <;> cases ht : t i <;> simp_all <;> linarith

/-- A finite partition of $[a,b]$ into rectangles (same formula as
`Auto.DIR.IsRectanglePartition`). -/
def IsBoxPartition {n : ℕ} (a b : Fin n → ℝ) (P : Finset ((Fin n → ℝ) × (Fin n → ℝ))) : Prop :=
  (∀ p ∈ P, (∀ i, p.1 i < p.2 i) ∧ a ≤ p.1 ∧ p.2 ≤ b) ∧ (⋃ p ∈ P, Icc p.1 p.2) = Icc a b ∧
    (P : Set ((Fin n → ℝ) × (Fin n → ℝ))).PairwiseDisjoint
      (fun p ↦ Set.pi univ fun i ↦ Ioo (p.1 i) (p.2 i))

/-- A rectangle is partitioned by itself. -/
theorem isBoxPartition_singleton {n : ℕ} {a b : Fin n → ℝ} (hab : ∀ i, a i < b i) :
    IsBoxPartition a b {(a, b)} := by
  refine ⟨?_, by simp, by simp⟩
  intro p hp
  rw [Finset.mem_singleton] at hp
  subst hp
  exact ⟨hab, le_rfl, le_rfl⟩

/-- Partitions of the children of a rectangle combine to a partition of the rectangle. -/
theorem isBoxPartition_biUnion {n : ℕ} {a b : Fin n → ℝ} (hab : ∀ i, a i < b i)
    (Q : (Fin n → Bool) → Finset ((Fin n → ℝ) × (Fin n → ℝ)))
    (hQ : ∀ s, IsBoxPartition (dyadicChild a b s).1 (dyadicChild a b s).2 (Q s)) :
    IsBoxPartition a b (Finset.univ.biUnion Q) := by
  have hab' : a ≤ b := fun i ↦ (hab i).le
  refine ⟨?_, ?_, ?_⟩
  · intro p hp
    obtain ⟨s, -, hs⟩ := Finset.mem_biUnion.mp hp
    obtain ⟨h1, h2, h3⟩ := (hQ s).1 p hs
    exact ⟨h1, (le_dyadicChild_fst hab' s).trans h2, h3.trans (dyadicChild_snd_le hab' s)⟩
  · rw [← iUnion_dyadicChild hab']
    ext x
    simp only [mem_iUnion, Finset.mem_biUnion, Finset.mem_univ, true_and, exists_prop]
    constructor
    · rintro ⟨p, ⟨s, hs⟩, hx⟩
      refine ⟨s, ?_⟩
      rw [← (hQ s).2.1]
      exact mem_biUnion hs hx
    · rintro ⟨s, hx⟩
      rw [← (hQ s).2.1] at hx
      obtain ⟨p, hp, hx⟩ := mem_iUnion₂.mp hx
      exact ⟨p, ⟨s, hp⟩, hx⟩
  · intro p hp q hq hpq
    simp only [Finset.coe_biUnion, Finset.coe_univ, mem_univ, iUnion_true, mem_iUnion,
      Finset.mem_coe] at hp hq
    obtain ⟨s, hs⟩ := hp
    obtain ⟨t, ht⟩ := hq
    by_cases hst : s = t
    · subst hst
      exact (hQ s).2.2 hs ht hpq
    · refine (disjoint_dyadicChild a b hst).mono ?_ ?_
      · obtain ⟨-, h2, h3⟩ := (hQ s).1 p hs
        exact Set.pi_mono fun i _ ↦ Ioo_subset_Ioo (h2 i) (h3 i)
      · obtain ⟨-, h2, h3⟩ := (hQ t).1 q ht
        exact Set.pi_mono fun i _ ↦ Ioo_subset_Ioo (h2 i) (h3 i)

/-- Success of dyadic bisection within `K` levels: either $\underline f(a,b)>0$, or `K > 0` and
every child succeeds within `K - 1` levels. -/
def DyadicGood {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) :
    ℕ → (Fin n → ℝ) → (Fin n → ℝ) → Prop
  | 0, a, b => 0 < fl a b
  | K + 1, a, b => 0 < fl a b ∨ ∀ s, DyadicGood fl K (dyadicChild a b s).1 (dyadicChild a b s).2

/-- `DyadicGood` is monotone in the number of levels (one step). -/
theorem DyadicGood.succ {n : ℕ} {fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ} :
    ∀ {K : ℕ} {a b : Fin n → ℝ}, DyadicGood fl K a b → DyadicGood fl (K + 1) a b
  | 0, _, _, h => Or.inl h
  | _ + 1, _, _, h => h.imp_right fun h' s ↦ DyadicGood.succ (h' s)

/-- `DyadicGood` is monotone in the number of levels. -/
theorem DyadicGood.mono {n : ℕ} {fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ} {K L : ℕ} (hKL : K ≤ L)
    {a b : Fin n → ℝ} (h : DyadicGood fl K a b) : DyadicGood fl L a b := by
  induction hKL with
  | refl => exact h
  | step _ ih => exact ih.succ

/-- If bisection does not succeed for any number of levels, then the same holds for some
child. -/
theorem exists_dyadicChild_not_good {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ)
    {a b : Fin n → ℝ} (h : ∀ K, ¬ DyadicGood fl K a b) :
    ∃ s, ∀ K, ¬ DyadicGood fl K (dyadicChild a b s).1 (dyadicChild a b s).2 := by
  by_contra hc
  push Not at hc
  choose K hK using hc
  exact h (Finset.univ.sup K + 1)
    (Or.inr fun s ↦ (hK s).mono (Finset.le_sup (Finset.mem_univ s)))

/-- Cousin-type lemma (by bisection): if $\underline f(\underline x,\overline x)>0$ for all small
boxes around each point of $[a,b]$, then bisection of $[a,b]$ succeeds within finitely many
levels. -/
theorem exists_dyadicGood {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) {a b : Fin n → ℝ}
    (hab : a ≤ b)
    (H : ∀ x ∈ Icc a b, ∃ εx > 0, ∀ xl xu, a ≤ xl → xu ≤ b → x ∈ Icc xl xu →
      dist xl xu ≤ εx → 0 < fl xl xu) :
    ∃ K, DyadicGood fl K a b := by
  by_contra hc
  push Not at hc
  let Bad := {p : (Fin n → ℝ) × (Fin n → ℝ) // ∀ K, ¬ DyadicGood fl K p.1 p.2}
  have step : ∀ p : Bad, ∃ s, ∀ K, ¬ DyadicGood fl K (dyadicChild p.1.1 p.1.2 s).1
      (dyadicChild p.1.1 p.1.2 s).2 := fun p ↦ exists_dyadicChild_not_good fl p.2
  choose g hg using step
  let seq : ℕ → Bad := fun k ↦ Nat.rec ⟨(a, b), hc⟩
    (fun _ p ↦ ⟨dyadicChild p.1.1 p.1.2 (g p), hg p⟩) k
  have seq_zero : (seq 0).1 = (a, b) := rfl
  have seq_succ : ∀ k, (seq (k + 1)).1 = dyadicChild (seq k).1.1 (seq k).1.2 (g (seq k)) :=
    fun _ ↦ rfl
  set lo : ℕ → Fin n → ℝ := fun k ↦ (seq k).1.1 with hlo
  set hi : ℕ → Fin n → ℝ := fun k ↦ (seq k).1.2 with hhi
  have width : ∀ k i, hi k i - lo k i = (b i - a i) / 2 ^ k := by
    intro k i
    induction k with
    | zero => simp [hlo, hhi, seq_zero]
    | succ k ih =>
      simp only [hlo, hhi, seq_succ, dyadicChild_width] at ih ⊢
      rw [ih, pow_succ]; ring
  have lohi : ∀ k, lo k ≤ hi k := fun k i ↦ by
    have := width k i; have := hab i
    have : 0 ≤ (b i - a i) / 2 ^ k := div_nonneg (by linarith) (by positivity)
    linarith
  have lo_mono : Monotone lo := monotone_nat_of_le_succ fun k ↦ by
    simp only [hlo, seq_succ]; exact le_dyadicChild_fst (lohi k) _
  have hi_anti : Antitone hi := antitone_nat_of_succ_le fun k ↦ by
    simp only [hhi, seq_succ]; exact dyadicChild_snd_le (lohi k) _
  have lo_le_hi : ∀ k m, lo k ≤ hi m := fun k m ↦
    (lo_mono (le_max_left k m)).trans ((lohi _).trans (hi_anti (le_max_right k m)))
  let x : Fin n → ℝ := fun i ↦ ⨆ k, lo k i
  have hbdd : ∀ i, BddAbove (range fun k ↦ lo k i) :=
    fun i ↦ ⟨hi 0 i, by rintro _ ⟨k, rfl⟩; exact lo_le_hi k 0 i⟩
  have hx : ∀ k, x ∈ Icc (lo k) (hi k) := fun k ↦
    ⟨fun i ↦ le_ciSup (hbdd i) k, fun i ↦ ciSup_le fun m ↦ lo_le_hi m k i⟩
  have ha : lo 0 = a := rfl
  have hb : hi 0 = b := rfl
  obtain ⟨ε, hε, hH⟩ := H x (by rw [← ha, ← hb]; exact hx 0)
  set D : ℝ := ∑ i, (b i - a i) with hD
  obtain ⟨N, hN⟩ := exists_nat_gt (D / ε)
  have h2N : (N : ℝ) < 2 ^ N := by exact_mod_cast Nat.lt_two_pow_self
  refine (seq N).2 0 (hH (lo N) (hi N) (ha ▸ lo_mono (Nat.zero_le N))
    (hb ▸ hi_anti (Nat.zero_le N)) (hx N) ((dist_pi_le_iff hε.le).mpr fun i ↦ ?_))
  rw [Real.dist_eq, abs_sub_comm, abs_of_nonneg (sub_nonneg.mpr (lohi N i)), width]
  have hDi : b i - a i ≤ D :=
    Finset.single_le_sum (f := fun i ↦ b i - a i) (fun j _ ↦ sub_nonneg.mpr (hab j))
      (Finset.mem_univ i)
  rw [div_le_iff₀ (by positivity)]
  have : D < ε * 2 ^ N := by
    rw [div_lt_iff₀ hε] at hN; nlinarith
  linarith

/-- Successful bisection within `K` levels yields an admissible partition. -/
theorem exists_isBoxPartition_of_dyadicGood {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) :
    ∀ (K : ℕ) {a b : Fin n → ℝ}, (∀ i, a i < b i) → DyadicGood fl K a b →
      ∃ P, IsBoxPartition a b P ∧ ∀ p ∈ P, 0 < fl p.1 p.2
  | 0, a, b, hab, h => ⟨{(a, b)}, isBoxPartition_singleton hab, by
    rintro p hp; rw [Finset.mem_singleton.mp hp]; exact h⟩
  | K + 1, a, b, hab, h => by
    rcases h with h | h
    · exact ⟨{(a, b)}, isBoxPartition_singleton hab, by
    rintro p hp; rw [Finset.mem_singleton.mp hp]; exact h⟩
    · have := fun s ↦ exists_isBoxPartition_of_dyadicGood fl K (dyadicChild_lt hab s) (h s)
      choose Q hQ hQpos using this
      refine ⟨Finset.univ.biUnion Q, isBoxPartition_biUnion hab Q hQ, fun p hp ↦ ?_⟩
      obtain ⟨s, -, hs⟩ := Finset.mem_biUnion.mp hp
      exact hQpos s p hs

/-- The list of the $2^n$ children of $[a,b]$ (same formula as `Auto.DIR.children`). -/
noncomputable def dyadicChildren {n : ℕ} (a b : Fin n → ℝ) : List ((Fin n → ℝ) × (Fin n → ℝ)) :=
  (Finset.univ : Finset (Fin n → Bool)).toList.map (dyadicChild a b)

/-- The members of the list of children of $[a,b]$. -/
theorem mem_dyadicChildren {n : ℕ} {a b : Fin n → ℝ} {c : (Fin n → ℝ) × (Fin n → ℝ)} :
    c ∈ dyadicChildren a b ↔ ∃ s, dyadicChild a b s = c := by
  simp [dyadicChildren]

/-- Let `F` satisfy the recursion of $\textsc{Partition}_n$ (`Auto.DIR.partitionN fl maxDepth`).
If `F a b depth` (with `maxDepth - depth ≤ k`) succeeds on a rectangle, then its result is a
partition of $[a,b]$ into rectangles $[c,d]$ with $\underline f(c,d)>0$. -/
theorem partitionN_spec_aux {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) (maxDepth : ℕ)
    (F : (Fin n → ℝ) → (Fin n → ℝ) → ℕ → Option (List ((Fin n → ℝ) × (Fin n → ℝ))))
    (hF : ∀ a b depth, F a b depth = if 0 < fl a b then some [(a, b)]
      else if maxDepth ≤ depth then none
      else ((dyadicChildren a b).attach.mapM fun c ↦ F c.1.1 c.1.2 (depth + 1)).map
        List.flatten) :
    ∀ (k depth : ℕ) (a b : Fin n → ℝ) (P : List ((Fin n → ℝ) × (Fin n → ℝ))),
      maxDepth - depth ≤ k → (∀ i, a i < b i) → F a b depth = some P →
      IsBoxPartition a b P.toFinset ∧ ∀ p ∈ P, 0 < fl p.1 p.2 := by
  intro k
  induction k with
  | zero =>
    intro depth a b P hk hab h
    rw [hF] at h
    split_ifs at h with h1 h2
    · cases h
      exact ⟨by simpa using isBoxPartition_singleton hab, by simpa using h1⟩
    · omega
  | succ k ih =>
    intro depth a b P hk hab h
    rw [hF] at h
    split_ifs at h with h1 h2
    · cases h
      exact ⟨by simpa using isBoxPartition_singleton hab, by simpa using h1⟩
    · obtain ⟨Ls, hLs, rfl⟩ := Option.map_eq_some_iff.mp h
      obtain ⟨rfl, hsome⟩ := list_mapM_option_eq_some_map _ [] hLs
      set g : (Fin n → ℝ) × (Fin n → ℝ) → Option (List ((Fin n → ℝ) × (Fin n → ℝ))) :=
        fun c ↦ F c.1 c.2 (depth + 1) with hg
      have hchild : ∀ s, g (dyadicChild a b s) = some ((g (dyadicChild a b s)).getD []) :=
        fun s ↦ by
          have := hsome ⟨dyadicChild a b s, mem_dyadicChildren.mpr ⟨s, rfl⟩⟩ (List.mem_attach _ _)
          have this' : (F (dyadicChild a b s).1 (dyadicChild a b s).2
              (depth + 1)).isSome := this
          obtain ⟨v, hv⟩ := Option.isSome_iff_exists.mp this'
          simp [hg, hv]
      have hrec := fun s ↦ ih (depth + 1) _ _ _ (by omega)
        (dyadicChild_lt hab s) (hchild s)
      have hmem : ∀ p, p ∈ ((dyadicChildren a b).attach.map
          (fun c ↦ (F c.1.1 c.1.2 (depth + 1)).getD [])).flatten ↔
          ∃ s, p ∈ (g (dyadicChild a b s)).getD [] := by
        intro p
        simp only [List.mem_flatten, List.mem_map, List.mem_attach, true_and, Subtype.exists]
        constructor
        · rintro ⟨_, ⟨c, hc, rfl⟩, hp⟩
          obtain ⟨s, rfl⟩ := mem_dyadicChildren.mp hc
          exact ⟨s, hp⟩
        · rintro ⟨s, hp⟩
          exact ⟨_, ⟨dyadicChild a b s, mem_dyadicChildren.mpr ⟨s, rfl⟩, rfl⟩, hp⟩
      have hset : ((dyadicChildren a b).attach.map
          (fun c ↦ (F c.1.1 c.1.2 (depth + 1)).getD [])).flatten.toFinset =
          Finset.univ.biUnion fun s ↦ ((g (dyadicChild a b s)).getD []).toFinset := by
        ext p
        simp only [List.mem_toFinset, hmem, Finset.mem_biUnion, Finset.mem_univ, true_and]
      refine ⟨?_, fun p hp ↦ ?_⟩
      · rw [hset]
        exact isBoxPartition_biUnion hab _ fun s ↦ (hrec s).1
      · obtain ⟨s, hs⟩ := (hmem p).mp hp
        exact (hrec s).2 p hs

/-- Let `F` satisfy the recursion of $\textsc{Partition}_n$ (`Auto.DIR.partitionN fl maxDepth`).
If dyadic bisection succeeds within `K` levels and `K ≤ maxDepth - depth`, then `F a b depth`
succeeds. -/
theorem partitionN_isSome_of_dyadicGood_aux {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ)
    (maxDepth : ℕ)
    (F : (Fin n → ℝ) → (Fin n → ℝ) → ℕ → Option (List ((Fin n → ℝ) × (Fin n → ℝ))))
    (hF : ∀ a b depth, F a b depth = if 0 < fl a b then some [(a, b)]
      else if maxDepth ≤ depth then none
      else ((dyadicChildren a b).attach.mapM fun c ↦ F c.1.1 c.1.2 (depth + 1)).map
        List.flatten) :
    ∀ (K depth : ℕ) (a b : Fin n → ℝ), DyadicGood fl K a b → K ≤ maxDepth - depth →
      (F a b depth).isSome := by
  intro K
  induction K with
  | zero =>
    intro depth a b h _
    rw [hF]
    simp [show 0 < fl a b from h]
  | succ K ih =>
    intro depth a b h hK
    by_cases h1 : 0 < fl a b
    · rw [hF]
      simp [h1]
    · rw [hF, ite_eq_right h1, ite_eq_right (by omega), Option.isSome_map]
      refine list_mapM_option_isSome _ _ fun c _ ↦ ?_
      obtain ⟨s, hs⟩ := mem_dyadicChildren.mp c.2
      rw [← hs]
      exact ih (depth + 1) _ _ ((h.resolve_left h1) s) (by omega)

