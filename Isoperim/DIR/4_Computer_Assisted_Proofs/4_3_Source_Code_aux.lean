/-! ### Alternating Taylor bounds for $e^{-v}$ and $\int_0^se^{-u^2}\,du$ -/

/-- If $f'\ge0$ on $[0,\infty)$, then $f(0)\le f(v)$ for $v\ge0$. -/
theorem le_of_hasDerivAt_nonneg_Ici {f f' : ℝ → ℝ} (hf : ∀ x, HasDerivAt f (f' x) x)
    (hf' : ∀ x, 0 ≤ x → 0 ≤ f' x) (v : ℝ) (hv : 0 ≤ v) : f 0 ≤ f v := by
  have hm : MonotoneOn f (Ici 0) := by
    refine monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ici 0)
      (fun x _ ↦ (hf x).continuousAt.continuousWithinAt) (fun x _ ↦ (hf x).hasDerivWithinAt)
      fun x hx ↦ hf' x ?_
    rw [interior_Ici] at hx
    exact le_of_lt hx
  exact hm (mem_Ici.2 le_rfl) (mem_Ici.2 hv) hv

/-- The Taylor polynomial $T_n(v)=\sum_{k<n}(-v)^k/k!$ of $e^{-v}$. -/
noncomputable def expNegTaylor (n : ℕ) (v : ℝ) : ℝ :=
  ∑ k ∈ Finset.range n, (-v) ^ k / (k.factorial : ℝ)

/-- $T_{n+1}'=-T_n$. -/
theorem hasDerivAt_expNegTaylor (n : ℕ) (v : ℝ) :
    HasDerivAt (expNegTaylor (n + 1)) (-expNegTaylor n v) v := by
  induction n with
  | zero =>
    have h : expNegTaylor (0 + 1) = fun _ ↦ 1 := by funext x; simp [expNegTaylor]
    rw [h]
    exact (hasDerivAt_const v (1 : ℝ)).congr_deriv (by simp [expNegTaylor])
  | succ n ih =>
    have h : expNegTaylor (n + 1 + 1) =
        fun x ↦ expNegTaylor (n + 1) x + (-x) ^ (n + 1) / ((n + 1).factorial : ℝ) := by
      funext x; simp [expNegTaylor, Finset.sum_range_succ _ (n + 1)]
    rw [h]
    refine (ih.add (((hasDerivAt_neg v).pow (n + 1)).div_const _)).congr_deriv ?_
    simp only [expNegTaylor, Finset.sum_range_succ, Nat.factorial_succ, Nat.cast_mul,
      Nat.add_sub_cancel]
    have : (n.factorial : ℝ) ≠ 0 := by positivity
    field_simp
    ring

/-- $(-1)^n\bigl(e^{-v}-T_n(v)\bigr)\ge0$ for $v\ge0$ (alternating Taylor bounds). -/
theorem expNegTaylor_alt (n : ℕ) (v : ℝ) (hv : 0 ≤ v) :
    0 ≤ (-1) ^ n * (exp (-v) - expNegTaylor n v) := by
  induction n generalizing v with
  | zero => simp [expNegTaylor, (exp_pos _).le]
  | succ n ih =>
    have hE : ∀ x : ℝ, HasDerivAt (fun x ↦ exp (-x)) (-exp (-x)) x := fun x ↦ by
      simpa using (hasDerivAt_neg x).exp
    have h := le_of_hasDerivAt_nonneg_Ici
      (f := fun x ↦ (-1) ^ (n + 1) * (exp (-x) - expNegTaylor (n + 1) x))
      (f' := fun x ↦ (-1) ^ n * (exp (-x) - expNegTaylor n x))
      (fun x ↦ (((hE x).sub (hasDerivAt_expNegTaylor n x)).const_mul _).congr_deriv
        (by ring)) ih v hv
    have h0 : expNegTaylor (n + 1) 0 = 1 := by
      simp [expNegTaylor, Finset.sum_range_succ']
    simpa [h0] using h

/-- Lower Taylor bound: $T_{2m+2}(v)\le e^{-v}$ for $v\ge0$. -/
theorem expNegTaylor_le_exp_neg (m : ℕ) {v : ℝ} (hv : 0 ≤ v) :
    expNegTaylor (2 * m + 2) v ≤ exp (-v) := by
  have h := expNegTaylor_alt (2 * m + 2) v hv
  rwa [Even.neg_one_pow ⟨m + 1, by ring⟩, one_mul, sub_nonneg] at h

/-- Upper Taylor bound: $e^{-v}\le T_{2m+1}(v)$ for $v\ge0$. -/
theorem exp_neg_le_expNegTaylor (m : ℕ) {v : ℝ} (hv : 0 ≤ v) :
    exp (-v) ≤ expNegTaylor (2 * m + 1) v := by
  have h := expNegTaylor_alt (2 * m + 1) v hv
  rwa [Odd.neg_one_pow ⟨m, rfl⟩, neg_one_mul, neg_nonneg, sub_nonpos] at h

/-- The series $S_N(s)=\sum_{k<N}(-1)^ks^{2k+1}/(k!\,(2k+1))$, the integral of $T_N(u^2)$
over $[0,s]$; it approximates $\int_0^se^{-u^2}\,du$. -/
noncomputable def gaussIntTaylor (N : ℕ) (s : ℝ) : ℝ :=
  ∑ k ∈ Finset.range N, (-1) ^ k * s ^ (2 * k + 1) / ((k.factorial : ℝ) * (2 * k + 1))

/-- $\int_0^sT_N(u^2)\,du=S_N(s)$. -/
theorem integral_expNegTaylor_sq (N : ℕ) (s : ℝ) :
    ∫ u in (0 : ℝ)..s, expNegTaylor N (u ^ 2) = gaussIntTaylor N s := by
  have hF : ∀ x ∈ uIcc (0 : ℝ) s, HasDerivAt (gaussIntTaylor N) (expNegTaylor N (x ^ 2)) x :=
    fun x _ ↦ by
    unfold expNegTaylor
    have : gaussIntTaylor N = fun u : ℝ ↦ ∑ k ∈ Finset.range N,
        (-1) ^ k * u ^ (2 * k + 1) / ((k.factorial : ℝ) * (2 * k + 1)) := rfl
    rw [this]
    refine (HasDerivAt.fun_sum fun k _ ↦
      ((hasDerivAt_pow (2 * k + 1) x).const_mul ((-1 : ℝ) ^ k)).div_const
        ((k.factorial : ℝ) * (2 * k + 1))).congr_deriv (Finset.sum_congr rfl fun k _ ↦ ?_)
    have h1 : (k.factorial : ℝ) ≠ 0 := by positivity
    have h2 : (2 * k + 1 : ℝ) ≠ 0 := by positivity
    rw [neg_pow (x ^ 2), ← pow_mul, Nat.add_sub_cancel]
    field_simp
    push_cast
    ring
  have hcont : Continuous fun u : ℝ ↦ expNegTaylor N (u ^ 2) := by
    unfold expNegTaylor; fun_prop
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hF (hcont.intervalIntegrable _ _)]
  simp [gaussIntTaylor]

/-- $\int_0^se^{-u^2}\,du\ge0$ for $s\ge0$. -/
theorem integral_exp_neg_sq_nonneg {s : ℝ} (hs : 0 ≤ s) :
    0 ≤ ∫ u in (0 : ℝ)..s, exp (-u ^ 2) :=
  intervalIntegral.integral_nonneg hs fun _ _ ↦ (exp_pos _).le

/-- Lower series bound: $S_{2m+2}(s)\le\int_0^se^{-u^2}\,du$ for $s\ge0$. -/
theorem gaussIntTaylor_le_integral (m : ℕ) {s : ℝ} (hs : 0 ≤ s) :
    gaussIntTaylor (2 * m + 2) s ≤ ∫ u in (0 : ℝ)..s, exp (-u ^ 2) := by
  rw [← integral_expNegTaylor_sq]
  exact intervalIntegral.integral_mono_on hs
    ((by unfold expNegTaylor; fun_prop : Continuous fun u : ℝ ↦
      expNegTaylor (2 * m + 2) (u ^ 2)).intervalIntegrable _ _)
    ((continuous_exp.comp (by fun_prop)).intervalIntegrable _ _)
    fun u _ ↦ expNegTaylor_le_exp_neg m (sq_nonneg u)

/-- Upper series bound: $\int_0^se^{-u^2}\,du\le S_{2m+1}(s)$ for $s\ge0$. -/
theorem integral_le_gaussIntTaylor (m : ℕ) {s : ℝ} (hs : 0 ≤ s) :
    ∫ u in (0 : ℝ)..s, exp (-u ^ 2) ≤ gaussIntTaylor (2 * m + 1) s := by
  rw [← integral_expNegTaylor_sq]
  exact intervalIntegral.integral_mono_on hs
    ((continuous_exp.comp (by fun_prop)).intervalIntegrable _ _)
    ((by unfold expNegTaylor; fun_prop : Continuous fun u : ℝ ↦
      expNegTaylor (2 * m + 1) (u ^ 2)).intervalIntegrable _ _)
    fun u _ ↦ exp_neg_le_expNegTaylor m (sq_nonneg u)

/-! ### The Gaussian functions at $\pm\sqrt2 s$ -/

/-- $\varphi(\sqrt2\,s)=e^{-s^2}/\sqrt{2\pi}$. -/
theorem gDens_sqrt_two_mul (s : ℝ) : gDens (√2 * s) = exp (-s ^ 2) / √(2 * π) := by
  rw [gDens_eq, mul_pow, sq_sqrt (by norm_num : (0 : ℝ) ≤ 2),
    show -(2 * s ^ 2) / 2 = -s ^ 2 by ring]

/-- $\sqrt{2\pi}=\sqrt2\sqrt\pi$. -/
theorem sqrt_two_mul_pi : √(2 * π) = √2 * √π := sqrt_mul (by norm_num) π

/-- $\Phi(\sqrt2\,s)=\frac12+\pi^{-1/2}\int_0^se^{-u^2}\,du$. -/
theorem gCDF_sqrt_two_mul (s : ℝ) :
    gCDF (√2 * s) = 2⁻¹ + (∫ u in (0 : ℝ)..s, exp (-u ^ 2)) / √π := by
  have h2 : (√2 : ℝ) ≠ 0 := by positivity
  have hsub := intervalIntegral.integral_comp_mul_left (a := 0) (b := s) gDens h2
  simp only [mul_zero, smul_eq_mul, gDens_sqrt_two_mul, intervalIntegral.integral_div] at hsub
  rw [gCDF_eq_half_add]
  congr 1
  have hp : 0 < √π := sqrt_pos.2 pi_pos
  rw [sqrt_two_mul_pi] at hsub
  field_simp at hsub ⊢
  rw [hsub]

/-- $\Phi(-\sqrt2\,s)=\frac12-\pi^{-1/2}\int_0^se^{-u^2}\,du$. -/
theorem gCDF_neg_sqrt_two_mul (s : ℝ) :
    gCDF (-(√2 * s)) = 2⁻¹ - (∫ u in (0 : ℝ)..s, exp (-u ^ 2)) / √π := by
  rw [gCDF_neg, gCDF_sqrt_two_mul]; ring

/-- Numerical bounds $1.77245385090<\sqrt\pi<1.77245385091$. -/
theorem sqrt_pi_bounds_fine : 1.77245385090 < √π ∧ √π < 1.77245385091 := by
  constructor
  · rw [Real.lt_sqrt (by norm_num)]; norm_num; linarith [pi_gt_d20]
  · rw [Real.sqrt_lt' (by norm_num)]; norm_num; linarith [pi_lt_d20]

/-- Numerical bounds $2.50662827463<\sqrt{2\pi}<2.50662827464$. -/
theorem sqrt_two_pi_bounds_fine : 2.50662827463 < √(2 * π) ∧ √(2 * π) < 2.50662827464 := by
  constructor
  · rw [Real.lt_sqrt (by norm_num)]; norm_num; linarith [pi_gt_d20]
  · rw [Real.sqrt_lt' (by norm_num)]; norm_num; linarith [pi_lt_d20]

/-- Elementary comparison used to pass from exact to rational bounds: if $e\le E$, $E\ge0$ and
$0<p\le r$, then $e/r\le E/p$ (no sign condition on $e$). -/
theorem div_le_div_of_le_of_le {e E p r : ℝ} (he : e ≤ E) (hE : 0 ≤ E) (hp : 0 < p)
    (hpr : p ≤ r) : e / r ≤ E / p := by
  have hr : 0 < r := hp.trans_le hpr
  rcases le_total e 0 with h | h
  · exact (div_nonpos_of_nonpos_of_nonneg h hr.le).trans (div_nonneg hE hp.le)
  · exact (div_le_div_of_nonneg_left h hp hpr).trans (div_le_div_of_nonneg_right he hp.le)

/-- If $c\le\int_0^se^{-u^2}\,du$ ($s\ge0$) and $\sqrt\pi\le r$, then
$\Phi(-\sqrt2\,s)\le\frac12-c/r$. -/
theorem gCDF_neg_sqrt_two_mul_le {s c r : ℝ} (hs : 0 ≤ s)
    (hc : c ≤ ∫ u in (0 : ℝ)..s, exp (-u ^ 2)) (hr : √π ≤ r) :
    gCDF (-(√2 * s)) ≤ 2⁻¹ - c / r := by
  rw [gCDF_neg_sqrt_two_mul]
  have := div_le_div_of_le_of_le hc (integral_exp_neg_sq_nonneg hs) (sqrt_pos.2 pi_pos) hr
  linarith

/-- If $\int_0^se^{-u^2}\,du\le c$ ($s\ge0$) and $0<r\le\sqrt\pi$, then
$\frac12-c/r\le\Phi(-\sqrt2\,s)$. -/
theorem le_gCDF_neg_sqrt_two_mul {s c r : ℝ} (hs : 0 ≤ s)
    (hc : ∫ u in (0 : ℝ)..s, exp (-u ^ 2) ≤ c) (hr0 : 0 < r) (hr : r ≤ √π) :
    2⁻¹ - c / r ≤ gCDF (-(√2 * s)) := by
  rw [gCDF_neg_sqrt_two_mul]
  have := div_le_div_of_le_of_le hc ((integral_exp_neg_sq_nonneg hs).trans hc) hr0 hr
  linarith

/-! ### Bounds for the Gaussian isoperimetric profile $I$ -/

/-- $\varphi(t)=\varphi(|t|)$. -/
theorem gDens_abs (t : ℝ) : gDens |t| = gDens t := by
  rcases abs_choice t with h | h <;> rw [h]; exact gDens_neg t

/-- Lower bound for $I$ on an interval: if $s\ge0$, $\Phi(-\sqrt2\,s)\le t_l$ and
$\Phi(-\sqrt2\,s)\le1-t_u$, then $I(t)\ge e^{-s^2}/\sqrt{2\pi}$ for $t\in[t_l,t_u]$. -/
theorem gProf_ge_of_gCDF_le {tl tu s : ℝ} (hs : 0 ≤ s) (hl : gCDF (-(√2 * s)) ≤ tl)
    (hu : gCDF (-(√2 * s)) ≤ 1 - tu) {t : ℝ} (ht : t ∈ Icc tl tu) :
    exp (-s ^ 2) / √(2 * π) ≤ gProf t := by
  have hP := gCDF_mem_Ioo (-(√2 * s))
  have htI : t ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hP.1, ht.1], by linarith [hP.1, ht.2]⟩
  have h1 : -(√2 * s) ≤ gInv t := (le_gInv_iff htI).2 (hl.trans ht.1)
  have h2 : gInv t ≤ √2 * s := by
    rw [gInv_le_iff htI]
    have := gCDF_neg (√2 * s)
    linarith [ht.2]
  have h2s : 0 ≤ √2 * s := by positivity
  rw [gProf_of_mem htI, ← gDens_abs, ← gDens_sqrt_two_mul]
  exact gDens_antitoneOn (mem_Ici.2 (abs_nonneg _)) (mem_Ici.2 h2s)
    (abs_le.2 ⟨by linarith, h2⟩)

/-- Upper bound for $I$ on an interval: if $s\ge0$ and $t_u\le\Phi(-\sqrt2\,s)$ or
$1-t_l\le\Phi(-\sqrt2\,s)$, then $I(t)\le e^{-s^2}/\sqrt{2\pi}$ for $t\in[t_l,t_u]$. -/
theorem gProf_le_of_le_gCDF {tl tu s : ℝ} (hs : 0 ≤ s)
    (h : tu ≤ gCDF (-(√2 * s)) ∨ 1 - tl ≤ gCDF (-(√2 * s))) {t : ℝ} (ht : t ∈ Icc tl tu) :
    gProf t ≤ exp (-s ^ 2) / √(2 * π) := by
  by_cases htI : t ∈ Ioo (0 : ℝ) 1
  · have h2s : 0 ≤ √2 * s := by positivity
    have habs : √2 * s ≤ |gInv t| := by
      rcases h with h | h
      · have : gInv t ≤ -(√2 * s) := (gInv_le_iff htI).2 (ht.2.trans h)
        rw [abs_of_nonpos (by linarith)]; linarith
      · have : √2 * s ≤ gInv t := by
          rw [le_gInv_iff htI]
          have := gCDF_neg (√2 * s)
          linarith [ht.1]
        rw [abs_of_nonneg (by linarith)]; exact this
    rw [gProf_of_mem htI, ← gDens_abs, ← gDens_sqrt_two_mul]
    exact gDens_antitoneOn (mem_Ici.2 h2s) (mem_Ici.2 (abs_nonneg _)) habs
  · rw [gProf_of_not_mem htI]; positivity

/-- Rational lower bound for $I$ on $[t_l,t_u]$: with $c=S_{2m+2}(s)$ (a lower bound for
$\int_0^se^{-u^2}$), if $\frac12-c/1.77245385091\le t_l$ and $\le1-t_u$, then
$T_{2n+2}(s^2)/2.50662827464\le I(t)$ for $t\in[t_l,t_u]$. -/
theorem gProf_ge_cert (m n : ℕ) {tl tu s : ℝ} (hs : 0 ≤ s)
    (hl : 2⁻¹ - gaussIntTaylor (2 * m + 2) s / 1.77245385091 ≤ tl)
    (hu : 2⁻¹ - gaussIntTaylor (2 * m + 2) s / 1.77245385091 ≤ 1 - tu) {t : ℝ}
    (ht : t ∈ Icc tl tu) :
    expNegTaylor (2 * n + 2) (s ^ 2) / 2.50662827464 ≤ gProf t := by
  have hΦ := gCDF_neg_sqrt_two_mul_le hs (gaussIntTaylor_le_integral m hs)
    sqrt_pi_bounds_fine.2.le
  refine le_trans ?_ (gProf_ge_of_gCDF_le hs (hΦ.trans hl) (hΦ.trans hu) ht)
  exact div_le_div_of_le_of_le (expNegTaylor_le_exp_neg n (sq_nonneg s)) (exp_pos _).le
    (sqrt_pos.2 (by positivity)) sqrt_two_pi_bounds_fine.2.le

/-- Rational upper bound for $I$ on $[t_l,t_u]$: with $c=S_{2m+1}(s)$ (an upper bound for
$\int_0^se^{-u^2}$), if $t_u\le\frac12-c/1.77245385090$ or $1-t_l\le\frac12-c/1.77245385090$,
then $I(t)\le T_{2n+1}(s^2)/2.50662827463$ for $t\in[t_l,t_u]$. -/
theorem gProf_le_cert (m n : ℕ) {tl tu s : ℝ} (hs : 0 ≤ s)
    (h : tu ≤ 2⁻¹ - gaussIntTaylor (2 * m + 1) s / 1.77245385090 ∨
      1 - tl ≤ 2⁻¹ - gaussIntTaylor (2 * m + 1) s / 1.77245385090) {t : ℝ}
    (ht : t ∈ Icc tl tu) :
    gProf t ≤ expNegTaylor (2 * n + 1) (s ^ 2) / 2.50662827463 := by
  have hΦ := le_gCDF_neg_sqrt_two_mul hs (integral_le_gaussIntTaylor m hs) (by norm_num)
    sqrt_pi_bounds_fine.1.le
  refine (gProf_le_of_le_gCDF hs (h.imp (·.trans hΦ) (·.trans hΦ)) ht).trans ?_
  have hE := exp_neg_le_expNegTaylor n (sq_nonneg s)
  exact div_le_div_of_le_of_le hE ((exp_pos _).le.trans hE) (by norm_num)
    sqrt_two_pi_bounds_fine.1.le

/-! ### Bounds for $J_w$ and $J$ -/

/-- Lower bound for $J_w$ on a box: let $0<w_l\le w\le w_u$, $x\in[x_l,x_u]$ and $s\ge0$. If
$\Phi(-\sqrt2\,s)\le(1-x_u)/w_u$ and $\Phi(-\sqrt2\,s)\le1-(1-x_l)/w_l$, then
$J_w(x)\ge w_l\,e^{-s^2}/\sqrt\pi$. (Uses $J_w(x)=\sqrt2\,w\,I((1-x)/w)$.) -/
theorem gJw_ge_of_gCDF_le {wl wu xl xu s : ℝ} (hwl : 0 < wl) (hs : 0 ≤ s)
    (h1 : gCDF (-(√2 * s)) ≤ (1 - xu) / wu) (h2 : gCDF (-(√2 * s)) ≤ 1 - (1 - xl) / wl)
    {w x : ℝ} (hw : w ∈ Icc wl wu) (hx : x ∈ Icc xl xu) :
    wl * exp (-s ^ 2) / √π ≤ gJw w x := by
  obtain ⟨hw1, hw2⟩ := hw
  have hw0 : 0 < w := hwl.trans_le hw1
  have hwu : 0 < wu := hw0.trans_le hw2
  have hP := (gCDF_mem_Ioo (-(√2 * s))).1
  have hxu : 0 < 1 - xu := by
    have := hP.trans_le h1; rwa [div_pos_iff_of_pos_right hwu] at this
  have hx1 : 0 ≤ 1 - x := by linarith [hx.2]
  have htl : (1 - xu) / wu ≤ w⁻¹ * (1 - x) := by
    rw [← div_eq_inv_mul]
    exact (div_le_div_of_nonneg_right (by linarith [hx.2]) hwu.le).trans
      (div_le_div_of_nonneg_left hx1 hw0 hw2)
  have htu : w⁻¹ * (1 - x) ≤ (1 - xl) / wl := by
    rw [← div_eq_inv_mul]
    exact (div_le_div_of_nonneg_left hx1 hwl hw1).trans
      (div_le_div_of_nonneg_right (by linarith [hx.1]) hwl.le)
  have hI := gProf_ge_of_gCDF_le hs h1 h2 ⟨htl, htu⟩
  have hp : 0 < √π := sqrt_pos.2 pi_pos
  have h2' : 0 < √2 := by positivity
  unfold gJw
  calc wl * exp (-s ^ 2) / √π = √2 * wl * (exp (-s ^ 2) / √(2 * π)) := by
        rw [sqrt_two_mul_pi]; field_simp
    _ ≤ √2 * w * gProf (w⁻¹ * (1 - x)) := by gcongr

/-- Upper bound for $J_w$ on a box: let $0<w_l\le w\le w_u$, $x\in[x_l,x_u]$ and $s\ge0$. If
$(1-x_l)/w_l\le\Phi(-\sqrt2\,s)$ or $1-(1-x_u)/w_u\le\Phi(-\sqrt2\,s)$, then
$J_w(x)\le w_u\,e^{-s^2}/\sqrt\pi$. -/
theorem gJw_le_of_le_gCDF {wl wu xl xu s : ℝ} (hwl : 0 < wl) (hs : 0 ≤ s)
    (h : (1 - xl) / wl ≤ gCDF (-(√2 * s)) ∨ 1 - (1 - xu) / wu ≤ gCDF (-(√2 * s)))
    {w x : ℝ} (hw : w ∈ Icc wl wu) (hx : x ∈ Icc xl xu) :
    gJw w x ≤ wu * exp (-s ^ 2) / √π := by
  obtain ⟨hw1, hw2⟩ := hw
  have hw0 : 0 < w := hwl.trans_le hw1
  have hwu : 0 < wu := hw0.trans_le hw2
  have hp : 0 < √π := sqrt_pos.2 pi_pos
  have h2' : 0 < √2 := by positivity
  unfold gJw
  rcases le_or_gt (1 - x) 0 with hx1 | hx1
  · rw [gProf_of_not_mem fun hI ↦ by
      have := hI.1; rw [← div_eq_inv_mul, div_pos_iff_of_pos_right hw0] at this; linarith]
    simp only [mul_zero]; positivity
  have htl : (1 - xu) / wu ≤ w⁻¹ * (1 - x) := by
    rw [← div_eq_inv_mul]
    exact (div_le_div_of_nonneg_right (by linarith [hx.2]) hwu.le).trans
      (div_le_div_of_nonneg_left hx1.le hw0 hw2)
  have htu : w⁻¹ * (1 - x) ≤ (1 - xl) / wl := by
    rw [← div_eq_inv_mul]
    exact (div_le_div_of_nonneg_left hx1.le hwl hw1).trans
      (div_le_div_of_nonneg_right (by linarith [hx.1]) hwl.le)
  have hI := gProf_le_of_le_gCDF hs (tl := (1 - xu) / wu) (tu := (1 - xl) / wl)
    h ⟨htl, htu⟩
  calc √2 * w * gProf (w⁻¹ * (1 - x)) ≤ √2 * wu * (exp (-s ^ 2) / √(2 * π)) := by
        gcongr; exact gProf_nonneg _
    _ = wu * exp (-s ^ 2) / √π := by rw [sqrt_two_mul_pi]; field_simp

/-- Rational lower bound for $J_w$ on a box $[w_l,w_u]\times[x_l,x_u]$, $w_l>0$: with
$c=S_{2m+2}(s)$, if $\frac12-c/1.77245385091\le(1-x_u)/w_u$ and
$\frac12-c/1.77245385091\le1-(1-x_l)/w_l$, then $w_l\,T_{2n+2}(s^2)/1.77245385091\le J_w(x)$. -/
theorem gJw_ge_cert (m n : ℕ) {wl wu xl xu s : ℝ} (hwl : 0 < wl) (hs : 0 ≤ s)
    (h1 : 2⁻¹ - gaussIntTaylor (2 * m + 2) s / 1.77245385091 ≤ (1 - xu) / wu)
    (h2 : 2⁻¹ - gaussIntTaylor (2 * m + 2) s / 1.77245385091 ≤ 1 - (1 - xl) / wl)
    {w x : ℝ} (hw : w ∈ Icc wl wu) (hx : x ∈ Icc xl xu) :
    wl * expNegTaylor (2 * n + 2) (s ^ 2) / 1.77245385091 ≤ gJw w x := by
  have hΦ := gCDF_neg_sqrt_two_mul_le hs (gaussIntTaylor_le_integral m hs)
    sqrt_pi_bounds_fine.2.le
  refine le_trans ?_ (gJw_ge_of_gCDF_le hwl hs (hΦ.trans h1) (hΦ.trans h2) hw hx)
  rw [mul_div_assoc, mul_div_assoc]
  exact mul_le_mul_of_nonneg_left (div_le_div_of_le_of_le
    (expNegTaylor_le_exp_neg n (sq_nonneg s)) (exp_pos _).le (sqrt_pos.2 pi_pos)
    sqrt_pi_bounds_fine.2.le) hwl.le

/-- Rational upper bound for $J_w$ on a box $[w_l,w_u]\times[x_l,x_u]$, $w_l>0$: with
$c=S_{2m+1}(s)$, if $(1-x_l)/w_l\le\frac12-c/1.77245385090$ or
$1-(1-x_u)/w_u\le\frac12-c/1.77245385090$, then $J_w(x)\le w_u\,T_{2n+1}(s^2)/1.77245385090$. -/
theorem gJw_le_cert (m n : ℕ) {wl wu xl xu s : ℝ} (hwl : 0 < wl) (hs : 0 ≤ s)
    (h : (1 - xl) / wl ≤ 2⁻¹ - gaussIntTaylor (2 * m + 1) s / 1.77245385090 ∨
      1 - (1 - xu) / wu ≤ 2⁻¹ - gaussIntTaylor (2 * m + 1) s / 1.77245385090)
    {w x : ℝ} (hw : w ∈ Icc wl wu) (hx : x ∈ Icc xl xu) :
    gJw w x ≤ wu * expNegTaylor (2 * n + 1) (s ^ 2) / 1.77245385090 := by
  have hΦ := le_gCDF_neg_sqrt_two_mul hs (integral_le_gaussIntTaylor m hs) (by norm_num)
    sqrt_pi_bounds_fine.1.le
  refine (gJw_le_of_le_gCDF hwl hs (h.imp (·.trans hΦ) (·.trans hΦ)) hw hx).trans ?_
  have hwu : 0 ≤ wu := hwl.le.trans (hw.1.trans hw.2)
  have hE := exp_neg_le_expNegTaylor n (sq_nonneg s)
  rw [mul_div_assoc, mul_div_assoc]
  exact mul_le_mul_of_nonneg_left (div_le_div_of_le_of_le hE ((exp_pos _).le.trans hE)
    (by norm_num) sqrt_pi_bounds_fine.1.le) hwu

/-- $J(x)=J_{w_0}(x)$ for $x\in[\frac12,1]$ (by (3.4)), in terms of `gJw`. -/
theorem J_eq_gJw {x : ℝ} (hx : x ∈ Icc (2⁻¹ : ℝ) 1) : J x = gJw w₀ x := eqn_3_4 x hx

/-- Rational lower bound for $J$ on $[x_l,x_u]\subseteq[\frac12,1]$, given an enclosure
$w_0\in[w_l,w_u]$, $w_l>0$ (see `gJw_ge_cert`). -/
theorem J_ge_cert (m n : ℕ) {wl wu xl xu s : ℝ} (hw : w₀ ∈ Icc wl wu) (hwl : 0 < wl)
    (hxl : 2⁻¹ ≤ xl) (hxu : xu ≤ 1) (hs : 0 ≤ s)
    (h1 : 2⁻¹ - gaussIntTaylor (2 * m + 2) s / 1.77245385091 ≤ (1 - xu) / wu)
    (h2 : 2⁻¹ - gaussIntTaylor (2 * m + 2) s / 1.77245385091 ≤ 1 - (1 - xl) / wl)
    {x : ℝ} (hx : x ∈ Icc xl xu) :
    wl * expNegTaylor (2 * n + 2) (s ^ 2) / 1.77245385091 ≤ J x := by
  rw [J_eq_gJw ⟨hxl.trans hx.1, hx.2.trans hxu⟩]
  exact gJw_ge_cert m n hwl hs h1 h2 hw hx

/-- Rational upper bound for $J$ on $[x_l,x_u]\subseteq[\frac12,1]$, given an enclosure
$w_0\in[w_l,w_u]$, $w_l>0$ (see `gJw_le_cert`). -/
theorem J_le_cert (m n : ℕ) {wl wu xl xu s : ℝ} (hw : w₀ ∈ Icc wl wu) (hwl : 0 < wl)
    (hxl : 2⁻¹ ≤ xl) (hxu : xu ≤ 1) (hs : 0 ≤ s)
    (h : (1 - xl) / wl ≤ 2⁻¹ - gaussIntTaylor (2 * m + 1) s / 1.77245385090 ∨
      1 - (1 - xu) / wu ≤ 2⁻¹ - gaussIntTaylor (2 * m + 1) s / 1.77245385090)
    {x : ℝ} (hx : x ∈ Icc xl xu) :
    J x ≤ wu * expNegTaylor (2 * n + 1) (s ^ 2) / 1.77245385090 := by
  rw [J_eq_gJw ⟨hxl.trans hx.1, hx.2.trans hxu⟩]
  exact gJw_le_cert m n hwl hs h hw hx

/-! ### A fine enclosure of $w_0$ -/

/-- Numerical bound: $J_{0.89576}(\frac12)<\frac12$ (with $s=0.103499$). -/
theorem gJw_89576_half_lt : gJw 0.89576 2⁻¹ < 2⁻¹ := by
  have := gJw_le_cert 2 2 (wl := 0.89576) (wu := 0.89576) (xl := 2⁻¹) (xu := 2⁻¹)
    (s := 0.103499) (by norm_num) (by norm_num)
    (Or.inr (by norm_num [gaussIntTaylor, Finset.sum_range_succ, Nat.factorial]))
    ⟨le_rfl, le_rfl⟩ ⟨le_rfl, le_rfl⟩
  refine this.trans_lt ?_
  norm_num [expNegTaylor, Finset.sum_range_succ, Nat.factorial]

/-- Numerical bound: $\frac12<J_{0.89577}(\frac12)$ (with $s=0.1034879$). -/
theorem gJw_89577_half_gt : 2⁻¹ < gJw 0.89577 2⁻¹ := by
  have := gJw_ge_cert 2 2 (wl := 0.89577) (wu := 0.89577) (xl := 2⁻¹) (xu := 2⁻¹)
    (s := 0.1034879) (by norm_num) (by norm_num)
    (by norm_num [gaussIntTaylor, Finset.sum_range_succ, Nat.factorial])
    (by norm_num [gaussIntTaylor, Finset.sum_range_succ, Nat.factorial])
    ⟨le_rfl, le_rfl⟩ ⟨le_rfl, le_rfl⟩
  refine lt_of_lt_of_le ?_ this
  norm_num [expNegTaylor, Finset.sum_range_succ, Nat.factorial]

/-- [DIR], §3: the fine enclosure $w_0\in[0.89576,0.89577]$ ($w_0=0.895769326\ldots$), by the
argument of `w₀_mem`: $w\mapsto J_w(\frac12)$ is strictly increasing on $(\frac12,1]$. -/
theorem w₀_mem_fine : w₀ ∈ Icc (0.89576 : ℝ) 0.89577 := by
  have h : ∃ w : ℝ, w ∈ Ioo 0 1 ∧ Jw w 2⁻¹ = 2⁻¹ := existsUnique_w₀.exists
  have hs := h.choose_spec
  have hw₀ : w₀ = h.choose := by rw [w₀, dite_eq_left_of_eq_true (eq_true h)]
  have hval : gJw w₀ 2⁻¹ = 2⁻¹ := by rw [hw₀]; exact hs.2
  have hw01 : w₀ < 1 := by rw [hw₀]; exact hs.1.2
  have hw1 : 2⁻¹ < w₀ := by linarith [w₀_mem.1]
  have hwI : w₀ ∈ Ioc 2⁻¹ 1 := ⟨hw1, hw01.le⟩
  constructor
  · by_contra hlt
    rw [not_le] at hlt
    have := gJw_half_strictMonoOn hwI ⟨by norm_num, by norm_num⟩ hlt
    simp only at this
    linarith [gJw_89576_half_lt]
  · by_contra hlt
    rw [not_le] at hlt
    have := gJw_half_strictMonoOn ⟨by norm_num, by norm_num⟩ hwI hlt
    simp only at this
    linarith [gJw_89577_half_gt]

/-- The fine enclosure $x_0=1-\frac{w_0}2\in[0.552115,0.55212]$. -/
theorem x₀_mem_fine : x₀ ∈ Icc (0.552115 : ℝ) 0.55212 := by
  obtain ⟨h1, h2⟩ := w₀_mem_fine
  exact ⟨by rw [x₀]; linarith, by rw [x₀]; linarith⟩

/-! ### Binary logarithms and powers of $2$ -/

/-- $\log_2m\le n/d$ if $m>0$, $d>0$ and $m^d\le2^n$. -/
theorem logb_two_le_of_pow_le {m : ℝ} {n d : ℕ} (hm : 0 < m) (hd : 0 < d) (h : m ^ d ≤ 2 ^ n) :
    log₂ m ≤ n / d := by
  rw [le_div_iff₀ (by positivity)]
  have := logb_le_logb_of_le (b := 2) (by norm_num) (pow_pos hm d) h
  rw [logb_pow, logb_pow, logb_self_eq_one (by norm_num)] at this
  linarith

/-- $n/d\le\log_2m$ if $d>0$ and $2^n\le m^d$. -/
theorem le_logb_two_of_le_pow {m : ℝ} {n d : ℕ} (hd : 0 < d)
    (h : 2 ^ n ≤ m ^ d) : n / d ≤ log₂ m := by
  rw [div_le_iff₀ (by positivity)]
  have := logb_le_logb_of_le (b := 2) (by norm_num) (by positivity) h
  rw [logb_pow, logb_pow, logb_self_eq_one (by norm_num)] at this
  linarith

/-- $\log_2(q/p)\le n/d$ for natural numbers $p,q>0$ with $q^d\le2^np^d$ (a statement about
natural numbers, decidable by `norm_num` or `decide +kernel`). -/
theorem logb_two_div_le {p q n d : ℕ} (hp : 0 < p) (hq : 0 < q) (hd : 0 < d)
    (h : q ^ d ≤ 2 ^ n * p ^ d) : log₂ ((q : ℝ) / p) ≤ n / d := by
  refine logb_two_le_of_pow_le (by positivity) hd ?_
  rw [div_pow, div_le_iff₀ (by positivity)]
  exact_mod_cast h

/-- $n/d\le\log_2(q/p)$ for natural numbers $p>0$, $q$ with $2^np^d\le q^d$. -/
theorem le_logb_two_div {p q n d : ℕ} (hp : 0 < p) (hd : 0 < d)
    (h : 2 ^ n * p ^ d ≤ q ^ d) : n / d ≤ log₂ ((q : ℝ) / p) := by
  refine le_logb_two_of_le_pow hd ?_
  rw [div_pow, le_div_iff₀ (by positivity)]
  exact_mod_cast h

/-- $2^r\le y$ for $r=k/d$ ($k\in\mathbb Z$, $d\in\mathbb N_{>0}$) if $y>0$ and $2^k\le y^d$. -/
theorem two_rpow_le_of_zpow_le {r y : ℝ} {k : ℤ} {d : ℕ} (hd : 0 < d) (hr : r = k / d)
    (hy : 0 < y) (h : (2 : ℝ) ^ k ≤ y ^ d) : (2 : ℝ) ^ r ≤ y := by
  have he : ((2 : ℝ) ^ r) ^ d = 2 ^ k := by
    rw [← rpow_natCast, ← rpow_mul (by norm_num), hr, div_mul_cancel₀ _ (by positivity),
      rpow_intCast]
  rw [← pow_le_pow_iff_left₀ (by positivity) hy.le hd.ne', he]
  exact h

/-- $y\le2^r$ for $r=k/d$ ($k\in\mathbb Z$, $d\in\mathbb N_{>0}$) if $y\ge0$ and $y^d\le2^k$. -/
theorem le_two_rpow_of_le_zpow {r y : ℝ} {k : ℤ} {d : ℕ} (hd : 0 < d) (hr : r = k / d)
    (hy : 0 ≤ y) (h : y ^ d ≤ (2 : ℝ) ^ k) : y ≤ (2 : ℝ) ^ r := by
  have he : ((2 : ℝ) ^ r) ^ d = 2 ^ k := by
    rw [← rpow_natCast, ← rpow_mul (by norm_num), hr, div_mul_cancel₀ _ (by positivity),
      rpow_intCast]
  rw [← pow_le_pow_iff_left₀ hy (by positivity) hd.ne', he]
  exact h

/-- Lower bound for $2^r$, $r\le0$: $T_{2n+2}(-0.6931471808\,r)\le2^r$ (from
$2^r=e^{r\log2}$ and $\log2<0.6931471808$). -/
theorem expNegTaylor_le_two_rpow (n : ℕ) {r : ℝ} (hr : r ≤ 0) :
    expNegTaylor (2 * n + 2) (-r * 0.6931471808) ≤ (2 : ℝ) ^ r := by
  refine (expNegTaylor_le_exp_neg n (by nlinarith)).trans ?_
  rw [rpow_def_of_pos (by norm_num)]
  exact exp_le_exp.2 (by nlinarith [log_two_lt_d9])

/-- Upper bound for $2^r$, $r\le0$: $2^r\le T_{2n+1}(-0.6931471803\,r)$ (from
$2^r=e^{r\log2}$ and $\log2>0.6931471803$). -/
theorem two_rpow_le_expNegTaylor (n : ℕ) {r : ℝ} (hr : r ≤ 0) :
    (2 : ℝ) ^ r ≤ expNegTaylor (2 * n + 1) (-r * 0.6931471803) := by
  refine le_trans ?_ (exp_neg_le_expNegTaylor n (by nlinarith))
  rw [rpow_def_of_pos (by norm_num)]
  exact exp_le_exp.2 (by nlinarith [log_two_gt_d9])

/-- Lower bound for $2^r$, $r\ge0$: if $T=T_{2n+1}(0.6931471803\,r)>0$, then $T^{-1}\le2^r$. -/
theorem inv_expNegTaylor_le_two_rpow (n : ℕ) {r : ℝ} (hr : 0 ≤ r)
    (hT : 0 < expNegTaylor (2 * n + 1) (r * 0.6931471803)) :
    (expNegTaylor (2 * n + 1) (r * 0.6931471803))⁻¹ ≤ (2 : ℝ) ^ r := by
  have h := two_rpow_le_expNegTaylor n (r := -r) (by linarith)
  rw [neg_neg, rpow_neg (by norm_num)] at h
  exact (inv_le_comm₀ hT (by positivity)).2 h

/-- Upper bound for $2^r$, $r\ge0$: if $T=T_{2n+2}(0.6931471808\,r)>0$, then $2^r\le T^{-1}$. -/
theorem two_rpow_le_inv_expNegTaylor (n : ℕ) {r : ℝ} (hr : 0 ≤ r)
    (hT : 0 < expNegTaylor (2 * n + 2) (r * 0.6931471808)) :
    (2 : ℝ) ^ r ≤ (expNegTaylor (2 * n + 2) (r * 0.6931471808))⁻¹ := by
  have h := expNegTaylor_le_two_rpow n (r := -r) (by linarith)
  rw [neg_neg, rpow_neg (by norm_num)] at h
  exact (le_inv_comm₀ (by positivity) hT).2 h

/-- Numerical bounds $0.49960506\le2^{-2\beta_0}\le0.49960507$ ($\beta_0=0.50057$). -/
theorem two_rpow_neg_two_β₀_mem : (2 : ℝ) ^ (-(2 * β₀)) ∈ Icc (0.49960506 : ℝ) 0.49960507 := by
  have hr : -(2 * β₀) ≤ 0 := by rw [β₀]; norm_num
  refine ⟨le_trans ?_ (expNegTaylor_le_two_rpow 7 hr),
    (two_rpow_le_expNegTaylor 7 hr).trans ?_⟩ <;>
  norm_num [β₀, expNegTaylor, Finset.sum_range_succ, Nat.factorial]

/-! ### Bounds for $L_\beta$ -/

/-- Lower bound for $L_\beta(x)=x(\log_2x^{-1})^\beta$, $\beta\ge\frac12$: if $x>0$,
$1\le l\le\log_2x^{-1}$ and $c^2\le l$, then $xc\le L_\beta(x)$. -/
theorem L_ge_of_le_logb {β x l c : ℝ} (hβ : 2⁻¹ ≤ β) (hx : 0 < x) (hl : 1 ≤ l)
    (hlog : l ≤ log₂ x⁻¹) (hc : c ^ 2 ≤ l) : x * c ≤ L β x := by
  have hl1 : 1 ≤ log₂ x⁻¹ := hl.trans hlog
  have h1 : c ≤ √(log₂ x⁻¹) :=
    (le_abs_self c).trans ((abs_le_sqrt hc).trans (sqrt_le_sqrt hlog))
  have h2 : √(log₂ x⁻¹) ≤ log₂ x⁻¹ ^ β := by
    rw [sqrt_eq_rpow, one_div]; exact rpow_le_rpow_of_exponent_le hl1 hβ
  exact mul_le_mul_of_nonneg_left (h1.trans h2) hx.le

/-- Upper bound for $L_\beta(x)$, $\frac12\le\beta\le\beta_u\le\frac32$: if
$0<x\le\frac12$, $\log_2x^{-1}\le l$, $C\ge0$ and $l\le C^2$, then
$L_\beta(x)\le xC\,(1+(\beta_u-\frac12)(l-1))$ (Bernoulli's inequality for
$(\log_2x^{-1})^{\beta_u-1/2}$). -/
theorem L_le_of_logb_le {β βu x l C : ℝ} (hβ : 2⁻¹ ≤ β) (hββ : β ≤ βu) (hβu : βu ≤ 3 / 2)
    (hx : 0 < x) (hx2 : x ≤ 2⁻¹) (hlog : log₂ x⁻¹ ≤ l) (hC0 : 0 ≤ C) (hC : l ≤ C ^ 2) :
    L β x ≤ x * (C * (1 + (βu - 2⁻¹) * (l - 1))) := by
  set y := log₂ x⁻¹ with hy
  have hy1 : 1 ≤ y := by
    rw [hy, le_logb_iff_rpow_le (by norm_num) (by positivity), rpow_one,
      le_inv_comm₀ (by norm_num) hx]
    linarith
  have hy0 : 0 < y := by linarith
  have h1 : y ^ β ≤ y ^ βu := rpow_le_rpow_of_exponent_le hy1 hββ
  have h2 : y ^ βu = √y * y ^ (βu - 2⁻¹) := by
    rw [sqrt_eq_rpow, ← rpow_add hy0]; congr 1; ring
  have h3 : √y ≤ C := by
    rw [← sqrt_sq hC0]; exact sqrt_le_sqrt (hlog.trans hC)
  have h4 : y ^ (βu - 2⁻¹) ≤ 1 + (βu - 2⁻¹) * (l - 1) := by
    have := rpow_one_add_le_one_add_mul_self (s := y - 1) (by linarith)
      (p := βu - 2⁻¹) (by linarith) (by linarith)
    rw [add_sub_cancel] at this
    refine this.trans ?_
    have := mul_le_mul_of_nonneg_left (by linarith : y - 1 ≤ l - 1)
      (by linarith : (0 : ℝ) ≤ βu - 2⁻¹)
    linarith
  have h5 : y ^ β ≤ C * (1 + (βu - 2⁻¹) * (l - 1)) := by
    rw [h2] at h1
    exact h1.trans (mul_le_mul h3 h4 (by positivity) hC0)
  exact mul_le_mul_of_nonneg_left h5 hx.le

/-- Lower bound for $L_\beta(x)$ at a rational point $x=p/q$, $\beta\ge\frac12$: if
$0<d\le n$, $2^np^d\le q^d$ (natural numbers) and $c^2\le n/d$, then $xc\le L_\beta(x)$. -/
theorem L_ge_cert {β x c : ℝ} {p q n d : ℕ} (hβ : 2⁻¹ ≤ β) (hp : 0 < p) (hq : 0 < q)
    (hxpq : x = p / q) (hd : 0 < d) (hdn : d ≤ n) (h : 2 ^ n * p ^ d ≤ q ^ d)
    (hc : c ^ 2 ≤ n / d) : x * c ≤ L β x := by
  have hx : 0 < x := by rw [hxpq]; positivity
  have hinv : x⁻¹ = q / p := by rw [hxpq, inv_div]
  refine L_ge_of_le_logb hβ hx ?_ (by rw [hinv]; exact le_logb_two_div hp hd h) hc
  rw [le_div_iff₀ (by positivity), one_mul]; exact_mod_cast hdn

/-- Upper bound for $L_\beta(x)$ at a rational point $x=p/q\le\frac12$,
$\frac12\le\beta\le\beta_u\le\frac32$: if $d>0$, $q^d\le2^np^d$ (natural numbers), $C\ge0$ and
$n/d\le C^2$, then $L_\beta(x)\le xC\,(1+(\beta_u-\frac12)(n/d-1))$. -/
theorem L_le_cert {β βu x C : ℝ} {p q n d : ℕ} (hβ : 2⁻¹ ≤ β) (hββ : β ≤ βu)
    (hβu : βu ≤ 3 / 2) (hp : 0 < p) (hq : 0 < q) (hxpq : x = p / q) (hx2 : x ≤ 2⁻¹)
    (hd : 0 < d) (h : q ^ d ≤ 2 ^ n * p ^ d) (hC0 : 0 ≤ C) (hC : (n : ℝ) / d ≤ C ^ 2) :
    L β x ≤ x * (C * (1 + (βu - 2⁻¹) * ((n : ℝ) / d - 1))) := by
  have hx : 0 < x := by rw [hxpq]; positivity
  have hinv : x⁻¹ = q / p := by rw [hxpq, inv_div]
  exact L_le_of_logb_le hβ hββ hβu hx hx2 (by rw [hinv]; exact logb_two_div_le hp hq hd h)
    hC0 hC

end Auto.DIR

/-! ## A verified interval checker

A small verified interval evaluator for the numerical side conditions of the computer-assisted
proofs. A real expression is a term `e : Ex`; its real meaning is `denote ρ e : ℝ`, where `ρ i` is
the value of the variable `var i`. The evaluator `eval P Γ e : Option (ℚ × ℚ)` computes, by exact
rational arithmetic with outward rounding to the denominator $2^{d}$ (`P.prec = d`), an enclosure
of `denote ρ e` from enclosures `Γ[i]` of the variables, or fails (`none`). It is written with
structural recursion only, so that it can be run by the kernel: an inequality
`c < denote (Cert.val cs) e` is proved by

`check_sound P hw cs e c (by decide +kernel)`,

i.e. by one kernel evaluation of the Boolean `check P (Cert.env cs) e c` and the soundness theorem
`eval_sound`. Here `hw : w₀ ∈ Icc (P.wl : ℝ) P.wu` is an enclosure of the constant $w_0$ of (3.4),
used by the nodes involving $J$, and `cs : List Cert` is a list of certified values
$l\le v\le u$ (the kernel only reads the fields `l`, `u`; for closed expressions `cs = []`).
Values used by many checks ($J$, $J'$ at partition points, powers $h^r$) are certified once
(`Cert.ofJ`, `Cert.ofDJ`, `Cert.ofJx0`, `Cert.ofRpow`, each by one `checkMem` and
`decide +kernel`) and passed to the checks as variables.

Nodes:
* variables `var i`;
* rational constants, `+`, `-`, `*`, `/`, negation, natural powers, `min`, `max`, `abs`, and a
  certified branch `ite_lt` (`if a < b then t else f`; a branch is taken only if the comparison
  is decided by the enclosures);
* `J x sl su` ($J(x)$, $x\in[\frac12,1]$ rational), `JwHalf w sl su` ($J_w(\frac12)$), with
  witnesses $s_l,s_u\ge0$ as in `J_ge_cert`/`J_le_cert`: the evaluator checks the conditions
  $\Phi(-\sqrt2 s_l)\le\min(t,1-t)$ and $\Phi(-\sqrt2 s_u)\ge\min(t_u,1-t_l)$ (with
  $t=(1-x)/w$) by series bounds and returns $[w_l T(s_l^2)/\overline{\sqrt\pi},\,
  w_u T(s_u^2)/\underline{\sqrt\pi}]$ (Taylor bounds $T$ of $e^{-s^2}$);
* `DJ x zl zu` ($\sqrt2\,\Phi^{-1}((1-x)/w_0)$, i.e. $J'(x)$): witnesses $z_l,z_u$ of any sign
  with $\Phi(\sqrt2z_l)\le(1-x)/w_u$ and $(1-x)/w_l\le\Phi(\sqrt2z_u)$, giving $[2z_l,2z_u]$;
* `Jx0` ($J(x_0)=w_0/\sqrt\pi$);
* `rpow e r` ($X^r$ for $X>0$, $r\in\mathbb Q$), by $X^r=\exp(r\log X)$, the series of
  $\log(1-x)$ (after range reduction by powers of $2$; $\log2$ from the same series) and of
  $\exp$ (with range reduction by squaring).
-/

namespace Auto.DIR.Checker

open Real Set Auto.DIR

/-! ### Exact rational helpers -/

/-- The Taylor polynomial $\sum_{k<N}(-v)^k/k!$ of $e^{-v}$, in `ℚ` (see `expNegTaylor`). -/
def eNq : ℕ → ℚ → ℚ
  | 0, _ => 0
  | k + 1, v => eNq k v + (-v) ^ k / k.factorial

/-- The series $\sum_{k<N}(-1)^ks^{2k+1}/(k!(2k+1))$, in `ℚ` (see `gaussIntTaylor`). -/
def gIq : ℕ → ℚ → ℚ
  | 0, _ => 0
  | k + 1, s => gIq k s + (-1) ^ k * s ^ (2 * k + 1) / (k.factorial * (2 * k + 1))

/-- Accumulator form of `logSum`: `logGo x k i p s` adds the $k$ terms $p/(i+1)$,
$px/(i+2)$, ... to $s$ (with $p=x^{i+1}$; one multiplication per term). -/
def logGo (x : ℚ) : ℕ → ℕ → ℚ → ℚ → ℚ
  | 0, _, _, s => s
  | k + 1, i, p, s => logGo x k (i + 1) (p * x) (s + p / (i + 1))

/-- The partial sum $\sum_{i<n}x^{i+1}/(i+1)$ of the series of $-\log(1-x)$. -/
def logSum (x : ℚ) (n : ℕ) : ℚ := logGo x n 0 x 0

/-- Accumulator form of `expSum`: `expGo z k m t s` adds the $k$ terms $t$, $tz/(m+1)$, ...
to $s$ (with $t=z^m/m!$). -/
def expGo (z : ℚ) : ℕ → ℕ → ℚ → ℚ → ℚ
  | 0, _, _, s => s
  | k + 1, m, t, s => expGo z k (m + 1) (t * z / (m + 1)) (s + t)

/-- The partial sum $\sum_{m<n}z^m/m!$ of the series of $e^z$. -/
def expSum (z : ℚ) (n : ℕ) : ℚ := expGo z n 0 1 0

/-- `logGo` computes the partial sums of the series of $-\log(1-x)$. -/
theorem logGo_eq (x : ℚ) (k : ℕ) : ∀ (i : ℕ) (s : ℚ),
    logGo x k i (x ^ (i + 1)) s =
      s + ∑ j ∈ Finset.range k, x ^ (i + j + 1) / ((i + j + 1 : ℕ) : ℚ) := by
  induction k with
  | zero => intro i s; simp [logGo]
  | succ k ih =>
    intro i s
    rw [logGo, ← pow_succ, ih, Finset.sum_range_succ']
    have e : ∀ j, i + 1 + j + 1 = i + (j + 1) + 1 := fun j ↦ by omega
    simp only [e, add_zero]
    push_cast
    ring

/-- `expGo` computes the partial sums of the series of $e^z$. -/
theorem expGo_eq (z : ℚ) (k : ℕ) : ∀ (m : ℕ) (s : ℚ),
    expGo z k m (z ^ m / m.factorial) s =
      s + ∑ j ∈ Finset.range k, z ^ (m + j) / ((m + j).factorial : ℚ) := by
  induction k with
  | zero => intro m s; simp [expGo]
  | succ k ih =>
    intro m s
    have ht : z ^ m / m.factorial * z / (m + 1) = z ^ (m + 1) / (m + 1).factorial := by
      rw [Nat.factorial_succ, pow_succ]
      push_cast
      field_simp
    rw [expGo, ht, ih, Finset.sum_range_succ']
    have e : ∀ j, m + 1 + j = m + (j + 1) := fun j ↦ by omega
    simp only [e, add_zero]
    ring

/-- Rounding down to the denominator $2^d$: $\lfloor q2^d\rfloor/2^d$. -/
def rdn (d : ℕ) (q : ℚ) : ℚ := (⌊q * 2 ^ d⌋ : ℚ) / 2 ^ d

/-- Rounding up to the denominator $2^d$: $\lceil q2^d\rceil/2^d$. -/
def rup (d : ℕ) (q : ℚ) : ℚ := (⌈q * 2 ^ d⌉ : ℚ) / 2 ^ d

/-- $q\cdot2^k$ for $k\in\mathbb Z$. -/
def mul2pow (q : ℚ) : ℤ → ℚ
  | .ofNat n => q * 2 ^ n
  | .negSucc n => q / 2 ^ (n + 1)

/-- Iterated squaring with rounding `f` after each step ($j$ steps). -/
def sqIter (f : ℚ → ℚ) : ℕ → ℚ → ℚ
  | 0, a => a
  | j + 1, a => sqIter f j (f (a * a))

/-- `eNq` is `expNegTaylor`. -/
theorem eNq_cast (N : ℕ) (v : ℚ) : ((eNq N v : ℚ) : ℝ) = expNegTaylor N v := by
  induction N with
  | zero => simp [eNq, expNegTaylor]
  | succ k ih =>
    rw [show expNegTaylor (k + 1) (v : ℝ) = expNegTaylor k v + (-(v : ℝ)) ^ k / k.factorial
      by simp [expNegTaylor, Finset.sum_range_succ], ← ih]
    simp [eNq]

/-- `gIq` is `gaussIntTaylor`. -/
theorem gIq_cast (N : ℕ) (s : ℚ) : ((gIq N s : ℚ) : ℝ) = gaussIntTaylor N s := by
  induction N with
  | zero => simp [gIq, gaussIntTaylor]
  | succ k ih =>
    rw [show gaussIntTaylor (k + 1) (s : ℝ) = gaussIntTaylor k s +
        (-1) ^ k * (s : ℝ) ^ (2 * k + 1) / ((k.factorial : ℝ) * (2 * k + 1))
      by simp [gaussIntTaylor, Finset.sum_range_succ], ← ih]
    simp [gIq]

/-- Cast of `logSum` to a `Finset` sum. -/
theorem logSum_cast (x : ℚ) (n : ℕ) :
    ((logSum x n : ℚ) : ℝ) = ∑ i ∈ Finset.range n, (x : ℝ) ^ (i + 1) / (i + 1) := by
  have h := logGo_eq x n 0 0
  rw [zero_add, pow_one] at h
  rw [logSum, h]
  push_cast
  simp

/-- Cast of `expSum` to a `Finset` sum. -/
theorem expSum_cast (z : ℚ) (n : ℕ) :
    ((expSum z n : ℚ) : ℝ) = ∑ m ∈ Finset.range n, (z : ℝ) ^ m / m.factorial := by
  have h := expGo_eq z n 0 0
  rw [pow_zero, Nat.factorial_zero, Nat.cast_one, div_one] at h
  rw [expSum, h]
  push_cast
  simp

/-- Rounding down does not increase. -/
theorem rdn_le (d : ℕ) (q : ℚ) : rdn d q ≤ q := by
  unfold rdn
  rw [div_le_iff₀ (by positivity)]
  exact Int.floor_le _

/-- Rounding up does not decrease. -/
theorem le_rup (d : ℕ) (q : ℚ) : q ≤ rup d q := by
  unfold rup
  rw [le_div_iff₀ (by positivity)]
  exact Int.le_ceil _

/-- Rounding down preserves nonnegativity. -/
theorem rdn_nonneg (d : ℕ) {q : ℚ} (hq : 0 ≤ q) : 0 ≤ rdn d q := by
  unfold rdn
  exact div_nonneg (Int.cast_nonneg_iff.2 (Int.floor_nonneg.2 (by positivity))) (by positivity)

/-- Real form of `rdn_le`. -/
theorem rdn_le_real (d : ℕ) {q : ℚ} {x : ℝ} (h : (q : ℝ) ≤ x) : (rdn d q : ℝ) ≤ x :=
  le_trans (by exact_mod_cast rdn_le d q) h

/-- Real form of `le_rup`. -/
theorem le_rup_real (d : ℕ) {q : ℚ} {x : ℝ} (h : x ≤ q) : x ≤ (rup d q : ℝ) :=
  h.trans (by exact_mod_cast le_rup d q)

/-- `mul2pow q k` is $q\cdot2^k$. -/
theorem mul2pow_cast (q : ℚ) (k : ℤ) : ((mul2pow q k : ℚ) : ℝ) = q * (2 : ℝ) ^ k := by
  cases k with
  | ofNat n => simp [mul2pow]
  | negSucc n => simp [mul2pow, zpow_negSucc, div_eq_mul_inv]

/-! ### Interval arithmetic -/

/-- $x\in[I_1,I_2]$ (real enclosure by a rational interval). -/
def Mem (I : ℚ × ℚ) (x : ℝ) : Prop := (I.1 : ℝ) ≤ x ∧ x ≤ I.2

/-- Outward rounding of an interval to the denominator $2^d$. -/
def ivRound (d : ℕ) (I : ℚ × ℚ) : ℚ × ℚ := (rdn d I.1, rup d I.2)

/-- Interval sum. -/
def ivAdd (I J : ℚ × ℚ) : ℚ × ℚ := (I.1 + J.1, I.2 + J.2)

/-- Interval negation. -/
def ivNeg (I : ℚ × ℚ) : ℚ × ℚ := (-I.2, -I.1)

/-- Interval difference. -/
def ivSub (I J : ℚ × ℚ) : ℚ × ℚ := (I.1 - J.2, I.2 - J.1)

/-- Interval product (minimum and maximum of the four corner products). -/
def ivMul (I J : ℚ × ℚ) : ℚ × ℚ :=
  (min (min (I.1 * J.1) (I.1 * J.2)) (min (I.2 * J.1) (I.2 * J.2)),
    max (max (I.1 * J.1) (I.1 * J.2)) (max (I.2 * J.1) (I.2 * J.2)))

/-- Interval minimum. -/
def ivMin (I J : ℚ × ℚ) : ℚ × ℚ := (min I.1 J.1, min I.2 J.2)

/-- Interval maximum. -/
def ivMax (I J : ℚ × ℚ) : ℚ × ℚ := (max I.1 J.1, max I.2 J.2)

/-- Interval absolute value. -/
def ivAbs (I : ℚ × ℚ) : ℚ × ℚ :=
  if 0 ≤ I.1 then I else if I.2 ≤ 0 then (-I.2, -I.1) else (0, max (-I.1) I.2)

/-- Interval natural power by repeated multiplication. -/
def ivPowMul (I : ℚ × ℚ) : ℕ → ℚ × ℚ
  | 0 => (1, 1)
  | n + 1 => ivMul (ivPowMul I n) I

/-- Interval natural power (exact for nonnegative intervals). -/
def ivPow (I : ℚ × ℚ) (n : ℕ) : ℚ × ℚ :=
  if 0 ≤ I.1 then (I.1 ^ n, I.2 ^ n) else ivPowMul I n

/-- Soundness of outward rounding. -/
theorem mem_ivRound (d : ℕ) {I : ℚ × ℚ} {x : ℝ} (h : Mem I x) : Mem (ivRound d I) x :=
  ⟨rdn_le_real d h.1, le_rup_real d h.2⟩

/-- Soundness of the interval sum. -/
theorem mem_ivAdd {I J : ℚ × ℚ} {x y : ℝ} (hx : Mem I x) (hy : Mem J y) :
    Mem (ivAdd I J) (x + y) := by
  simp only [Mem, ivAdd, Rat.cast_add] at *
  constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

/-- Soundness of the interval negation. -/
theorem mem_ivNeg {I : ℚ × ℚ} {x : ℝ} (hx : Mem I x) : Mem (ivNeg I) (-x) := by
  simp only [Mem, ivNeg, Rat.cast_neg] at *
  constructor <;> linarith [hx.1, hx.2]

/-- Soundness of the interval difference. -/
theorem mem_ivSub {I J : ℚ × ℚ} {x y : ℝ} (hx : Mem I x) (hy : Mem J y) :
    Mem (ivSub I J) (x - y) := by
  simp only [Mem, ivSub, Rat.cast_sub] at *
  constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

/-- Corner bounds for a product of two real intervals. -/
theorem mul_mem_corners {a1 a2 b1 b2 x y : ℝ} (hx : a1 ≤ x ∧ x ≤ a2) (hy : b1 ≤ y ∧ y ≤ b2) :
    min (min (a1 * b1) (a1 * b2)) (min (a2 * b1) (a2 * b2)) ≤ x * y ∧
      x * y ≤ max (max (a1 * b1) (a1 * b2)) (max (a2 * b1) (a2 * b2)) := by
  obtain ⟨hx1, hx2⟩ := hx
  obtain ⟨hy1, hy2⟩ := hy
  have hl : ∀ a : ℝ, min (a * b1) (a * b2) ≤ a * y := fun a ↦ by
    rcases le_total 0 a with h | h
    · exact min_le_of_left_le (mul_le_mul_of_nonneg_left hy1 h)
    · exact min_le_of_right_le (mul_le_mul_of_nonpos_left hy2 h)
  have hu : ∀ a : ℝ, a * y ≤ max (a * b1) (a * b2) := fun a ↦ by
    rcases le_total 0 a with h | h
    · exact le_max_of_le_right (mul_le_mul_of_nonneg_left hy2 h)
    · exact le_max_of_le_left (mul_le_mul_of_nonpos_left hy1 h)
  have hl' : min (a1 * y) (a2 * y) ≤ x * y := by
    rcases le_total 0 y with h | h
    · exact min_le_of_left_le (mul_le_mul_of_nonneg_right hx1 h)
    · exact min_le_of_right_le (mul_le_mul_of_nonpos_right hx2 h)
  have hu' : x * y ≤ max (a1 * y) (a2 * y) := by
    rcases le_total 0 y with h | h
    · exact le_max_of_le_right (mul_le_mul_of_nonneg_right hx2 h)
    · exact le_max_of_le_left (mul_le_mul_of_nonpos_right hx1 h)
  exact ⟨(min_le_min (hl a1) (hl a2)).trans hl', hu'.trans (max_le_max (hu a1) (hu a2))⟩

/-- Soundness of the interval product. -/
theorem mem_ivMul {I J : ℚ × ℚ} {x y : ℝ} (hx : Mem I x) (hy : Mem J y) :
    Mem (ivMul I J) (x * y) := by
  simp only [Mem, ivMul, Rat.cast_min, Rat.cast_max, Rat.cast_mul] at *
  exact mul_mem_corners hx hy

/-- Soundness of the interval minimum. -/
theorem mem_ivMin {I J : ℚ × ℚ} {x y : ℝ} (hx : Mem I x) (hy : Mem J y) :
    Mem (ivMin I J) (min x y) := by
  simp only [Mem, ivMin, Rat.cast_min] at *
  exact ⟨min_le_min hx.1 hy.1, min_le_min hx.2 hy.2⟩

/-- Soundness of the interval maximum. -/
theorem mem_ivMax {I J : ℚ × ℚ} {x y : ℝ} (hx : Mem I x) (hy : Mem J y) :
    Mem (ivMax I J) (max x y) := by
  simp only [Mem, ivMax, Rat.cast_max] at *
  exact ⟨max_le_max hx.1 hy.1, max_le_max hx.2 hy.2⟩

/-- Soundness of the interval absolute value. -/
theorem mem_ivAbs {I : ℚ × ℚ} {x : ℝ} (hx : Mem I x) : Mem (ivAbs I) |x| := by
  obtain ⟨h1, h2⟩ := hx
  unfold ivAbs
  split_ifs with ha hb
  · have : (0 : ℝ) ≤ I.1 := by exact_mod_cast ha
    exact ⟨by rw [abs_of_nonneg (by linarith)]; exact h1,
      by rw [abs_of_nonneg (by linarith)]; exact h2⟩
  · have : (I.2 : ℝ) ≤ 0 := by exact_mod_cast hb
    simp only [Mem, Rat.cast_neg]
    rw [abs_of_nonpos (by linarith)]
    exact ⟨by linarith, by linarith⟩
  · simp only [Mem, Rat.cast_zero, Rat.cast_max, Rat.cast_neg]
    refine ⟨abs_nonneg x, ?_⟩
    rcases abs_cases x with ⟨h, -⟩ | ⟨h, -⟩ <;> rw [h]
    · exact le_max_of_le_right h2
    · exact le_max_of_le_left (by linarith)

/-- Soundness of the interval power by repeated multiplication. -/
theorem mem_ivPowMul {I : ℚ × ℚ} {x : ℝ} (hx : Mem I x) (n : ℕ) : Mem (ivPowMul I n) (x ^ n) := by
  induction n with
  | zero => simp [ivPowMul, Mem]
  | succ n ih => rw [pow_succ]; exact mem_ivMul ih hx

/-- Soundness of the interval power. -/
theorem mem_ivPow {I : ℚ × ℚ} {x : ℝ} (hx : Mem I x) (n : ℕ) : Mem (ivPow I n) (x ^ n) := by
  unfold ivPow
  split_ifs with h
  · have h0 : (0 : ℝ) ≤ I.1 := by exact_mod_cast h
    simp only [Mem, Rat.cast_pow]
    exact ⟨pow_le_pow_left₀ h0 hx.1 n, pow_le_pow_left₀ (h0.trans hx.1) hx.2 n⟩
  · exact mem_ivPowMul hx n

/-- Interval inverse, defined if the interval does not contain $0$. -/
def ivInv (I : ℚ × ℚ) : Option (ℚ × ℚ) :=
  if 0 < I.1 ∨ I.2 < 0 then some (I.2⁻¹, I.1⁻¹) else none

/-- Soundness of the interval inverse. -/
theorem mem_ivInv {I J : ℚ × ℚ} {x : ℝ} (hx : Mem I x) (h : ivInv I = some J) :
    Mem J x⁻¹ := by
  unfold ivInv at h
  split_ifs at h with hc
  cases h
  obtain ⟨h1, h2⟩ := hx
  simp only [Mem, Rat.cast_inv]
  rcases hc with hc | hc
  · have : (0 : ℝ) < I.1 := by exact_mod_cast hc
    exact ⟨inv_anti₀ (by linarith) h2, inv_anti₀ this h1⟩
  · have : (I.2 : ℝ) < 0 := by exact_mod_cast hc
    have hx0 : x < 0 := by linarith
    exact ⟨(inv_le_inv_of_neg this hx0).2 h2,
      (inv_le_inv_of_neg hx0 (by linarith : (I.1 : ℝ) < 0)).2 h1⟩

/-! ### Parameters and the Gaussian functions -/

/-- Parameters of the evaluator: an enclosure $[w_l,w_u]\ni w_0$, the degrees of the series
(`gaussIntTaylor` of degree $2m_I+1$, $2m_I+2$; `expNegTaylor` of degree $2m_E+1$, $2m_E+2$;
`nLog` terms of the series of $\log(1-x)$, $|x|\le\frac13$; `nExp` terms of the series of
$e^z$, $|z|\le1$) and the rounding precision $2^{-\mathrm{prec}}$. -/
structure Params where
  /-- Lower end of the enclosure of $w_0$. -/
  wl : ℚ
  /-- Upper end of the enclosure of $w_0$. -/
  wu : ℚ
  /-- Degree parameter for `gaussIntTaylor`. -/
  mI : ℕ := 20
  /-- Degree parameter for `expNegTaylor`. -/
  mE : ℕ := 20
  /-- Number of terms of the series of $\log(1-x)$. -/
  nLog : ℕ := 40
  /-- Number of terms of the series of $e^z$. -/
  nExp : ℕ := 24
  /-- Rounding precision: results are rounded outward to the denominator $2^{\mathrm{prec}}$. -/
  prec : ℕ := 64

/-- A rational lower bound for $\sqrt\pi=1.77245385090551602729\ldots$. -/
def sqrtPiLo : ℚ := 1.772453850905516027

/-- A rational upper bound for $\sqrt\pi$. -/
def sqrtPiHi : ℚ := 1.772453850905516028

/-- $0<\underline{\sqrt\pi}$. -/
theorem sqrtPiLo_pos : (0 : ℝ) < sqrtPiLo := by norm_num [sqrtPiLo]

/-- $\underline{\sqrt\pi}<\sqrt\pi$ (from `Real.pi_gt_d20`). -/
theorem sqrtPiLo_lt : (sqrtPiLo : ℝ) < √π := by
  rw [show ((sqrtPiLo : ℚ) : ℝ) = 1.772453850905516027 by norm_num [sqrtPiLo],
    Real.lt_sqrt (by norm_num)]
  norm_num
  linarith [pi_gt_d20]

/-- $\sqrt\pi<\overline{\sqrt\pi}$ (from `Real.pi_lt_d20`). -/
theorem sqrt_pi_lt_hi : √π < sqrtPiHi := by
  rw [show ((sqrtPiHi : ℚ) : ℝ) = 1.772453850905516028 by norm_num [sqrtPiHi],
    Real.sqrt_lt' (by norm_num)]
  norm_num
  linarith [pi_lt_d20]

/-- Upper bound for $\Phi(-\sqrt2s)$, $s\ge0$: $\frac12-S_{2m+2}(s)/\overline{\sqrt\pi}$. -/
def phiNegHi (P : Params) (s : ℚ) : ℚ := 2⁻¹ - gIq (2 * P.mI + 2) s / sqrtPiHi

/-- Lower bound for $\Phi(-\sqrt2s)$, $s\ge0$: $\frac12-S_{2m+1}(s)/\underline{\sqrt\pi}$. -/
def phiNegLo (P : Params) (s : ℚ) : ℚ := 2⁻¹ - gIq (2 * P.mI + 1) s / sqrtPiLo

/-- $\Phi(-\sqrt2s)\le$ `phiNegHi P s` for $s\ge0$. -/
theorem gCDF_le_phiNegHi (P : Params) {s : ℚ} (hs : 0 ≤ s) :
    gCDF (-(√2 * s)) ≤ phiNegHi P s := by
  have hs' : (0 : ℝ) ≤ s := by exact_mod_cast hs
  have := gCDF_neg_sqrt_two_mul_le hs' (gaussIntTaylor_le_integral P.mI hs') sqrt_pi_lt_hi.le
  simpa [phiNegHi, gIq_cast] using this

/-- `phiNegLo P s` $\le\Phi(-\sqrt2s)$ for $s\ge0$. -/
theorem phiNegLo_le_gCDF (P : Params) {s : ℚ} (hs : 0 ≤ s) :
    (phiNegLo P s : ℝ) ≤ gCDF (-(√2 * s)) := by
  have hs' : (0 : ℝ) ≤ s := by exact_mod_cast hs
  have := le_gCDF_neg_sqrt_two_mul hs' (integral_le_gaussIntTaylor P.mI hs') sqrtPiLo_pos
    sqrtPiLo_lt.le
  simpa [phiNegLo, gIq_cast] using this

/-- Lower bound for $\Phi(\sqrt2\sigma)$, $\sigma\in\mathbb Q$. -/
def phiLo (P : Params) (σ : ℚ) : ℚ := if σ < 0 then phiNegLo P (-σ) else 1 - phiNegHi P σ

/-- Upper bound for $\Phi(\sqrt2\sigma)$, $\sigma\in\mathbb Q$. -/
def phiHi (P : Params) (σ : ℚ) : ℚ := if σ < 0 then phiNegHi P (-σ) else 1 - phiNegLo P σ

/-- `phiLo P σ` $\le\Phi(\sqrt2\sigma)$. -/
theorem phiLo_le_gCDF (P : Params) (σ : ℚ) : (phiLo P σ : ℝ) ≤ gCDF (√2 * σ) := by
  unfold phiLo
  split_ifs with h
  · have := phiNegLo_le_gCDF P (s := -σ) (by linarith)
    simpa using this
  · have := gCDF_le_phiNegHi P (s := σ) (by linarith)
    rw [gCDF_neg] at this
    push_cast
    linarith

/-- $\Phi(\sqrt2\sigma)\le$ `phiHi P σ`. -/
theorem gCDF_le_phiHi (P : Params) (σ : ℚ) : gCDF (√2 * σ) ≤ phiHi P σ := by
  unfold phiHi
  split_ifs with h
  · have := gCDF_le_phiNegHi P (s := -σ) (by linarith)
    simpa using this
  · have := phiNegLo_le_gCDF P (s := σ) (by linarith)
    rw [gCDF_neg] at this
    push_cast
    linarith

/-- Enclosure of $J_w(x)$ for $w\in[w_l,w_u]$ from witnesses $s_l,s_u\ge0$ (see
`gJw_ge_of_gCDF_le`, `gJw_le_of_le_gCDF`). -/
def gJwIv (P : Params) (wl wu x sl su : ℚ) : Option (ℚ × ℚ) :=
  if 0 < wl ∧ 0 ≤ sl ∧ 0 ≤ su ∧ phiNegHi P sl ≤ (1 - x) / wu ∧
      phiNegHi P sl ≤ 1 - (1 - x) / wl ∧
      ((1 - x) / wl ≤ phiNegLo P su ∨ 1 - (1 - x) / wu ≤ phiNegLo P su) then
    some (rdn P.prec (wl * eNq (2 * P.mE + 2) (sl ^ 2) / sqrtPiHi),
      rup P.prec (wu * eNq (2 * P.mE + 1) (su ^ 2) / sqrtPiLo))
  else none

/-- Soundness of `gJwIv`. -/
theorem gJwIv_sound (P : Params) {wl wu x sl su : ℚ} {I : ℚ × ℚ}
    (h : gJwIv P wl wu x sl su = some I) {w : ℝ} (hw : w ∈ Icc (wl : ℝ) wu) :
    Mem I (gJw w x) := by
  unfold gJwIv at h
  split_ifs at h with hc
  cases h
  obtain ⟨hwl, hsl, hsu, h1, h2, h3⟩ := hc
  have hwl' : (0 : ℝ) < wl := by exact_mod_cast hwl
  have hsl' : (0 : ℝ) ≤ sl := by exact_mod_cast hsl
  have hsu' : (0 : ℝ) ≤ su := by exact_mod_cast hsu
  have hx : (x : ℝ) ∈ Icc (x : ℝ) x := ⟨le_rfl, le_rfl⟩
  refine ⟨rdn_le_real _ ?_, le_rup_real _ ?_⟩
  · have h1' : ((phiNegHi P sl : ℚ) : ℝ) ≤ (1 - x) / wu := by exact_mod_cast h1
    have h2' : ((phiNegHi P sl : ℚ) : ℝ) ≤ 1 - (1 - x) / wl := by exact_mod_cast h2
    have hΦ := gCDF_le_phiNegHi P hsl
    refine le_trans ?_ (gJw_ge_of_gCDF_le hwl' hsl' (hΦ.trans h1') (hΦ.trans h2') hw hx)
    push_cast
    rw [eNq_cast, mul_div_assoc, mul_div_assoc]
    push_cast
    exact mul_le_mul_of_nonneg_left (div_le_div_of_le_of_le
      (expNegTaylor_le_exp_neg _ (sq_nonneg _)) (exp_pos _).le (sqrt_pos.2 pi_pos)
      sqrt_pi_lt_hi.le) hwl'.le
  · have hΦ := phiNegLo_le_gCDF P hsu
    have h3' : ((1 - x) / wl : ℝ) ≤ ((phiNegLo P su : ℚ) : ℝ) ∨
        1 - (1 - x) / wu ≤ ((phiNegLo P su : ℚ) : ℝ) := by
      rcases h3 with h3 | h3
      · left; exact_mod_cast h3
      · right; exact_mod_cast h3
    refine (gJw_le_of_le_gCDF hwl' hsu' (h3'.imp (·.trans hΦ) (·.trans hΦ)) hw hx).trans ?_
    have hwu : (0 : ℝ) ≤ wu := hwl'.le.trans (hw.1.trans hw.2)
    have hE := exp_neg_le_expNegTaylor P.mE (sq_nonneg (su : ℝ))
    push_cast
    rw [eNq_cast, mul_div_assoc, mul_div_assoc]
    push_cast
    exact mul_le_mul_of_nonneg_left (div_le_div_of_le_of_le hE ((exp_pos _).le.trans hE)
      sqrtPiLo_pos sqrtPiLo_lt.le) hwu

/-- $J(x_0)=w_0/\sqrt\pi$. -/
theorem J_x₀_eq : J x₀ = w₀ / √π := by
  obtain ⟨h1, h2⟩ := w₀_mem_fine
  have hw0 : 0 < w₀ := by linarith
  rw [J_eq_gJw ⟨by rw [x₀]; linarith, by rw [x₀]; linarith⟩, gJw, x₀,
    show w₀⁻¹ * (1 - (1 - w₀ / 2)) = 2⁻¹ by field_simp; ring, gProf_half, gConst_eq,
    sqrt_two_mul_pi]
  have : (0 : ℝ) < √2 := by positivity
  have : (0 : ℝ) < √π := sqrt_pos.2 pi_pos
  field_simp

/-- The real meaning of the node `DJ`: $\sqrt2\,\Phi^{-1}((1-x)/w_0)$, which is $J'(x)$ on
$(\frac12,1)$ (`hasDerivAt_J`). -/
noncomputable def DJr (x : ℝ) : ℝ := √2 * gInv ((1 - x) / w₀)

/-- $J'(x)=\sqrt2\,\Phi^{-1}((1-x)/w_0)$ (`DJr x`) on $(\frac12,1)$. -/
theorem hasDerivAt_J {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) : HasDerivAt J (DJr x) x := by
  obtain ⟨h1, h2⟩ := w₀_mem_fine
  have hw0 : 0 < w₀ := by linarith
  have h := hasDerivAt_gJw hw0 (x := x) ⟨by linarith [hx.1], hx.2⟩
  rw [← div_eq_inv_mul] at h
  refine h.congr_of_eventuallyEq ?_
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy
  exact J_eq_gJw ⟨hy.1.le, hy.2.le⟩

/-- $J'(x)=$ `DJr x` on $(\frac12,1)$. -/
theorem deriv_J_eq {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) : deriv J x = DJr x :=
  (hasDerivAt_J hx).deriv

/-! ### Logarithm and exponential -/

/-- $\log(1-x)\in[-S_n(x)-R,-S_n(x)+R]$ with $S_n(x)=\sum_{i<n}x^{i+1}/(i+1)$,
$R=|x|^{n+1}/(1-|x|)$, for rational $|x|<1$. -/
theorem log_one_sub_mem (x : ℚ) (n : ℕ) (hx : |x| < 1) :
    Mem (-logSum x n - |x| ^ (n + 1) / (1 - |x|), -logSum x n + |x| ^ (n + 1) / (1 - |x|))
      (log (1 - x)) := by
  have hx' : abs (x : ℝ) < 1 := by exact_mod_cast hx
  have h := abs_le.1 (abs_log_sub_add_sum_range_le hx' n)
  rw [← logSum_cast] at h
  simp only [Mem]
  push_cast
  constructor <;> linarith [h.1, h.2]

/-- A rational lower bound for $\log2$ ($\lfloor2^{64}\log2\rfloor/2^{64}$). -/
def ln2Lo : ℚ := 12786308645202655659 / 18446744073709551616

/-- A rational upper bound for $\log2$ ($\lceil2^{64}\log2\rceil/2^{64}$). -/
def ln2Hi : ℚ := 12786308645202655660 / 18446744073709551616

/-- The rational inequalities certifying `ln2Lo`, `ln2Hi` (series of $\log(1-\frac12)$ with $70$
terms). -/
theorem ln2_check :
    ln2Lo ≤ logSum 2⁻¹ 70 - abs (2⁻¹ : ℚ) ^ 71 / (1 - abs (2⁻¹ : ℚ)) ∧
      logSum 2⁻¹ 70 + abs (2⁻¹ : ℚ) ^ 71 / (1 - abs (2⁻¹ : ℚ)) ≤ ln2Hi := by
  decide +kernel

/-- $\log2\in[$`ln2Lo`$,$`ln2Hi`$]$. -/
theorem ln2_mem : Mem (ln2Lo, ln2Hi) (log 2) := by
  have h := log_one_sub_mem 2⁻¹ 70 (by norm_num)
  have hl : log (1 - ((2⁻¹ : ℚ) : ℝ)) = -log 2 := by
    rw [show 1 - ((2⁻¹ : ℚ) : ℝ) = 2⁻¹ by norm_num, Real.log_inv]
  rw [hl] at h
  obtain ⟨c1, c2⟩ := ln2_check
  have c1' :
      (ln2Lo : ℝ) ≤ ((logSum 2⁻¹ 70 - abs (2⁻¹ : ℚ) ^ 71 / (1 - abs (2⁻¹ : ℚ)) : ℚ) : ℝ) := by
    exact_mod_cast c1
  have c2' : ((logSum 2⁻¹ 70 + abs (2⁻¹ : ℚ) ^ 71 / (1 - abs (2⁻¹ : ℚ)) : ℚ) : ℝ) ≤ ln2Hi := by
    exact_mod_cast c2
  simp only [Mem] at h ⊢
  push_cast at h c1' c2' ⊢
  constructor <;> linarith [h.1, h.2]

/-- A binary exponent $k$ with $q/2^k$ close to $1$ (in $[\frac23,\frac43]$ for $q>0$). -/
def logK (q : ℚ) : ℤ :=
  let k : ℤ := (Nat.log2 q.num.natAbs : ℤ) - Nat.log2 q.den
  let m := mul2pow q (-k)
  if 4 / 3 < m then k + 1 else if m < 2 / 3 then k - 1 else k

/-- The reduced argument $x=1-q2^{-k}$, $k=$ `logK q`, so that $\log q=\log(1-x)+k\log2$. -/
def logX (q : ℚ) : ℚ := 1 - mul2pow q (-logK q)

/-- The remainder bound $|x|^{n+1}/(1-|x|)$ of the series of $\log(1-x)$. -/
def logR (x : ℚ) (n : ℕ) : ℚ := abs x ^ (n + 1) / (1 - abs x)

/-- Enclosure of $\log q$, $q>0$ rational: $\log q=\log m+k\log2$ with $m=q2^{-k}$. -/
def logIv (P : Params) (q : ℚ) : Option (ℚ × ℚ) :=
  if 0 < q ∧ abs (logX q) < 1 then
    some (rdn P.prec (-logSum (logX q) P.nLog - logR (logX q) P.nLog +
        (if 0 ≤ logK q then (logK q : ℚ) * ln2Lo else (logK q : ℚ) * ln2Hi)),
      rup P.prec (-logSum (logX q) P.nLog + logR (logX q) P.nLog +
        (if 0 ≤ logK q then (logK q : ℚ) * ln2Hi else (logK q : ℚ) * ln2Lo)))
  else none

/-- Soundness of `logIv`. -/
theorem logIv_sound (P : Params) {q : ℚ} {I : ℚ × ℚ} (h : logIv P q = some I) :
    0 < q ∧ Mem I (log q) := by
  unfold logIv at h
  by_cases hc : 0 < q ∧ abs (logX q) < 1
  swap
  · rw [ite_eq_right hc] at h; cases h
  rw [ite_eq_left hc] at h
  cases h
  obtain ⟨hq, hx⟩ := hc
  unfold logX at hx ⊢
  unfold logR
  refine ⟨hq, ?_⟩
  set k := logK q
  set m := mul2pow q (-k) with hm
  have hq' : (0 : ℝ) < q := by exact_mod_cast hq
  have hmc : ((m : ℚ) : ℝ) = q * (2 : ℝ) ^ (-k) := mul2pow_cast q (-k)
  have hm0 : (0 : ℝ) < m := by rw [hmc]; positivity
  have hqm : (q : ℝ) = m * (2 : ℝ) ^ k := by
    rw [hmc, mul_assoc, ← zpow_add₀ two_ne_zero, neg_add_cancel, zpow_zero, mul_one]
  have hlog : log q = log (1 - ((1 - m : ℚ) : ℝ)) + k * log 2 := by
    rw [hqm, Real.log_mul hm0.ne' (by positivity), Real.log_zpow]
    push_cast; ring_nf
  have hL := log_one_sub_mem (1 - m) P.nLog hx
  have h2 := ln2_mem
  simp only [Mem] at hL h2
  have hk : ((if 0 ≤ k then (k : ℚ) * ln2Lo else (k : ℚ) * ln2Hi : ℚ) : ℝ) ≤ k * log 2 ∧
      k * log 2 ≤ ((if 0 ≤ k then (k : ℚ) * ln2Hi else (k : ℚ) * ln2Lo : ℚ) : ℝ) := by
    split_ifs with hk0
    · have : (0 : ℝ) ≤ k := by exact_mod_cast hk0
      push_cast
      exact ⟨mul_le_mul_of_nonneg_left h2.1 this, mul_le_mul_of_nonneg_left h2.2 this⟩
    · have : (k : ℝ) ≤ 0 := by exact_mod_cast (not_le.1 hk0).le
      push_cast
      exact ⟨mul_le_mul_of_nonpos_left h2.2 this, mul_le_mul_of_nonpos_left h2.1 this⟩
  refine ⟨rdn_le_real _ ?_, le_rup_real _ ?_⟩
  · rw [hlog]; push_cast at hL hk ⊢; linarith [hL.1, hk.1]
  · rw [hlog]; push_cast at hL hk ⊢; linarith [hL.2, hk.2]

/-- Squaring with downward rounding preserves lower bounds for $e^t$:
$0\le a\le e^t\Rightarrow\mathrm{sqIter}(a)\le e^{2^jt}$. -/
theorem sqIter_rdn_le (d j : ℕ) : ∀ (a : ℚ) (t : ℝ), 0 ≤ a → (a : ℝ) ≤ exp t →
    (sqIter (rdn d) j a : ℝ) ≤ exp (2 ^ j * t) := by
  induction j with
  | zero => intro a t _ h; simpa [sqIter] using h
  | succ j ih =>
    intro a t ha h
    have ha' : (0 : ℝ) ≤ a := by exact_mod_cast ha
    have h2 : ((rdn d (a * a) : ℚ) : ℝ) ≤ exp (2 * t) := by
      refine rdn_le_real d ?_
      rw [show 2 * t = t + t by ring, Real.exp_add]
      push_cast
      exact mul_le_mul h h ha' (exp_pos _).le
    have := ih (rdn d (a * a)) (2 * t) (rdn_nonneg d (mul_nonneg ha ha)) h2
    rw [sqIter]
    convert this using 2
    ring

/-- Squaring with upward rounding preserves upper bounds for $e^t$. -/
theorem le_sqIter_rup (d j : ℕ) : ∀ (a : ℚ) (t : ℝ), exp t ≤ a →
    exp (2 ^ j * t) ≤ (sqIter (rup d) j a : ℝ) := by
  induction j with
  | zero => intro a t h; simpa [sqIter] using h
  | succ j ih =>
    intro a t h
    have h2 : exp (2 * t) ≤ ((rup d (a * a) : ℚ) : ℝ) := by
      refine le_rup_real d ?_
      rw [show 2 * t = t + t by ring, Real.exp_add]
      push_cast
      exact mul_le_mul h h (exp_pos _).le ((exp_pos _).le.trans h)
    have := ih (rup d (a * a)) (2 * t) h2
    rw [sqIter]
    convert this using 2
    ring

/-- Number of halvings used for $e^y$: $2^j>\lceil|y|\rceil$. -/
def expJ (y : ℚ) : ℕ := Nat.log2 ⌈|y|⌉.toNat + 1

/-- Enclosure of $e^y$, $y$ rational: $z=y/2^j$, $e^z$ from the Taylor series with the remainder
bound of `Real.exp_bound`, then $j$ squarings. -/
def expIv (P : Params) (y : ℚ) : Option (ℚ × ℚ) :=
  if |y / 2 ^ expJ y| ≤ 1 ∧ 0 < P.nExp then
    some (sqIter (rdn P.prec) (expJ y) (max 0 (rdn P.prec (expSum (y / 2 ^ expJ y) P.nExp -
        |y / 2 ^ expJ y| ^ P.nExp * ((P.nExp + 1) / (P.nExp.factorial * P.nExp))))),
      sqIter (rup P.prec) (expJ y) (rup P.prec (expSum (y / 2 ^ expJ y) P.nExp +
        |y / 2 ^ expJ y| ^ P.nExp * ((P.nExp + 1) / (P.nExp.factorial * P.nExp)))))
  else none

/-- Soundness of `expIv`. -/
theorem expIv_sound (P : Params) {y : ℚ} {I : ℚ × ℚ} (h : expIv P y = some I) :
    Mem I (exp y) := by
  unfold expIv at h
  split_ifs at h with hc
  cases h
  obtain ⟨hz, hn⟩ := hc
  set j := expJ y
  set z : ℚ := y / 2 ^ j with hzdef
  have hz' : abs (z : ℝ) ≤ 1 := by exact_mod_cast hz
  have hB := abs_le.1 (Real.exp_bound hz' hn)
  rw [← expSum_cast] at hB
  have hy : (y : ℝ) = 2 ^ j * (z : ℝ) := by
    rw [hzdef]; push_cast; field_simp
  rw [hy]
  constructor
  · refine sqIter_rdn_le _ _ _ _ (le_max_left _ _) ?_
    rcases le_total (rdn P.prec (expSum z P.nExp -
        |z| ^ P.nExp * ((P.nExp + 1) / (P.nExp.factorial * P.nExp)))) 0 with h0 | h0
    · rw [max_eq_left h0]; push_cast; exact (exp_pos _).le
    · rw [max_eq_right h0]
      refine rdn_le_real _ ?_
      push_cast
      have : ((P.nExp.succ : ℕ) : ℝ) = P.nExp + 1 := by push_cast; ring
      rw [this] at hB
      linarith [hB.1]
  · refine le_sqIter_rup _ _ _ _ (le_rup_real _ ?_)
    push_cast
    have : ((P.nExp.succ : ℕ) : ℝ) = P.nExp + 1 := by push_cast; ring
    rw [this] at hB
    linarith [hB.2]

/-- Enclosure of $X^r$ for $X$ in a positive rational interval, $r\in\mathbb Q$:
$X^r=\exp(r\log X)$. -/
def rpowIv (P : Params) (I : ℚ × ℚ) (r : ℚ) : Option (ℚ × ℚ) :=
  match logIv P I.1, logIv P I.2 with
  | some (la, _), some (_, ub) =>
    match expIv P (rdn P.prec (ivMul (la, ub) (r, r)).1),
      expIv P (rup P.prec (ivMul (la, ub) (r, r)).2) with
    | some (lo, _), some (_, hi) => some (lo, hi)
    | _, _ => none
  | _, _ => none

/-- Soundness of `rpowIv`. -/
theorem rpowIv_sound (P : Params) {I J : ℚ × ℚ} {r : ℚ} {x : ℝ} (hx : Mem I x)
    (h : rpowIv P I r = some J) : Mem J (x ^ (r : ℝ)) := by
  unfold rpowIv at h
  rcases ha : logIv P I.1 with _ | ⟨la, la'⟩ <;> rw [ha] at h
  · simp at h
  rcases hb : logIv P I.2 with _ | ⟨ub', ub⟩ <;> rw [hb] at h
  · simp at h
  obtain ⟨hq1, hLa⟩ := logIv_sound P ha
  obtain ⟨hq2, hLb⟩ := logIv_sound P hb
  have hI1 : (0 : ℝ) < I.1 := by exact_mod_cast hq1
  have hx0 : 0 < x := hI1.trans_le hx.1
  have hlogx : Mem (la, ub) (log x) :=
    ⟨hLa.1.trans (Real.log_le_log hI1 hx.1),
      (Real.log_le_log hx0 hx.2).trans hLb.2⟩
  have hy := mem_ivMul hlogx (show Mem (r, r) (r : ℝ) from ⟨le_rfl, le_rfl⟩)
  simp only at h
  rcases he1 : expIv P (rdn P.prec (ivMul (la, ub) (r, r)).1) with _ | ⟨lo, lo'⟩ <;>
    rw [he1] at h
  · simp at h
  rcases he2 : expIv P (rup P.prec (ivMul (la, ub) (r, r)).2) with _ | ⟨hi', hi⟩ <;>
    rw [he2] at h
  · simp at h
  simp only [Option.some.injEq] at h
  subst h
  rw [Real.rpow_def_of_pos hx0]
  exact ⟨(expIv_sound P he1).1.trans (Real.exp_le_exp.2 (rdn_le_real _ hy.1)),
    (Real.exp_le_exp.2 (le_rup_real _ hy.2)).trans (expIv_sound P he2).2⟩

/-! ### Expressions, evaluator and soundness -/

/-- Real expressions with variables: `var i` stands for the $i$-th entry of an environment of
certified enclosures (see `Cert`), so that values used repeatedly are evaluated only once. -/
inductive Ex where
  /-- The $i$-th variable of the environment. -/
  | var (i : ℕ)
  /-- A rational constant. -/
  | const (q : ℚ)
  /-- Sum. -/
  | add (a b : Ex)
  /-- Difference. -/
  | sub (a b : Ex)
  /-- Product. -/
  | mul (a b : Ex)
  /-- Quotient (evaluated only if the enclosure of the denominator excludes $0$). -/
  | div (a b : Ex)
  /-- Negation. -/
  | neg (a : Ex)
  /-- Natural power. -/
  | npow (a : Ex) (n : ℕ)
  /-- Minimum. -/
  | min (a b : Ex)
  /-- Maximum. -/
  | max (a b : Ex)
  /-- Absolute value. -/
  | abs (a : Ex)
  /-- `if a < b then t else f` (a branch is taken only if the comparison is certified). -/
  | ite_lt (a b t f : Ex)
  /-- $J(x)$ for rational $x\in[\frac12,1]$, with witnesses $s_l,s_u\ge0$ for the lower and
  upper bound. -/
  | J (x sl su : ℚ)
  /-- $\sqrt2\,\Phi^{-1}((1-x)/w_0)$ ($=J'(x)$), with witnesses $z_l,z_u$:
  $\Phi(\sqrt2z_l)\le(1-x)/w_u$, $(1-x)/w_l\le\Phi(\sqrt2z_u)$; enclosure $[2z_l,2z_u]$. -/
  | DJ (x zl zu : ℚ)
  /-- $J(x_0)$ ($=w_0/\sqrt\pi$). -/
  | Jx0
  /-- $J_w(\frac12)$ for rational $w>0$, with witnesses $s_l,s_u\ge0$. -/
  | JwHalf (w sl su : ℚ)
  /-- Real power $X^r$ (`Real.rpow`), evaluated only if the enclosure of $X$ is positive. -/
  | rpow (a : Ex) (r : ℚ)

/-- The real meaning of an expression, the variables taking the values `ρ i`. -/
noncomputable def denote (ρ : ℕ → ℝ) : Ex → ℝ
  | .var i => ρ i
  | .const q => q
  | .add a b => denote ρ a + denote ρ b
  | .sub a b => denote ρ a - denote ρ b
  | .mul a b => denote ρ a * denote ρ b
  | .div a b => denote ρ a / denote ρ b
  | .neg a => -denote ρ a
  | .npow a n => denote ρ a ^ n
  | .min a b => Min.min (denote ρ a) (denote ρ b)
  | .max a b => Max.max (denote ρ a) (denote ρ b)
  | .abs a => |denote ρ a|
  | .ite_lt a b t f => if denote ρ a < denote ρ b then denote ρ t else denote ρ f
  | .J x _ _ => Auto.DIR.J x
  | .DJ x _ _ => DJr x
  | .Jx0 => Auto.DIR.J x₀
  | .JwHalf w _ _ => gJw w 2⁻¹
  | .rpow a r => denote ρ a ^ (r : ℝ)

/-- Apply a unary interval operation (with rounding). -/
def lift1 (P : Params) (f : ℚ × ℚ → ℚ × ℚ) : Option (ℚ × ℚ) → Option (ℚ × ℚ)
  | some I => some (ivRound P.prec (f I))
  | none => none

/-- Apply a binary interval operation (with rounding). -/
def lift2 (P : Params) (f : ℚ × ℚ → ℚ × ℚ → ℚ × ℚ) :
    Option (ℚ × ℚ) → Option (ℚ × ℚ) → Option (ℚ × ℚ)
  | some I, some J => some (ivRound P.prec (f I J))
  | _, _ => none

/-- Interval quotient. -/
def ivDivO (P : Params) : Option (ℚ × ℚ) → Option (ℚ × ℚ) → Option (ℚ × ℚ)
  | some I, some J =>
    match ivInv J with
    | some K => some (ivRound P.prec (ivMul I K))
    | none => none
  | _, _ => none

/-- Certified branch. -/
def iteO (A B T F : Option (ℚ × ℚ)) : Option (ℚ × ℚ) :=
  match A, B with
  | some I, some J => if I.2 < J.1 then T else if J.2 ≤ I.1 then F else none
  | _, _ => none

/-- Enclosure of $\sqrt2\,\Phi^{-1}((1-x)/w_0)$ from witnesses $z_l,z_u$. -/
def DJIv (P : Params) (x zl zu : ℚ) : Option (ℚ × ℚ) :=
  if 0 < P.wl ∧ 0 < 1 - x ∧ (1 - x) / P.wl < 1 ∧ phiHi P zl ≤ (1 - x) / P.wu ∧
      (1 - x) / P.wl ≤ phiLo P zu then some (2 * zl, 2 * zu)
  else none

/-- Enclosure of $X^r$ from an optional enclosure of $X$. -/
def rpowO (P : Params) (r : ℚ) : Option (ℚ × ℚ) → Option (ℚ × ℚ)
  | some I => if 0 < I.1 then rpowIv P I r else none
  | none => none

/-- The interval evaluator; `Γ[i]` is the enclosure of the variable `var i`. -/
def eval (P : Params) (Γ : List (ℚ × ℚ)) : Ex → Option (ℚ × ℚ)
  | .var i => Γ[i]?
  | .const q => some (q, q)
  | .add a b => lift2 P ivAdd (eval P Γ a) (eval P Γ b)
  | .sub a b => lift2 P ivSub (eval P Γ a) (eval P Γ b)
  | .mul a b => lift2 P ivMul (eval P Γ a) (eval P Γ b)
  | .div a b => ivDivO P (eval P Γ a) (eval P Γ b)
  | .neg a => lift1 P ivNeg (eval P Γ a)
  | .npow a n => lift1 P (fun I ↦ ivPow I n) (eval P Γ a)
  | .min a b => lift2 P ivMin (eval P Γ a) (eval P Γ b)
  | .max a b => lift2 P ivMax (eval P Γ a) (eval P Γ b)
  | .abs a => lift1 P ivAbs (eval P Γ a)
  | .ite_lt a b t f => iteO (eval P Γ a) (eval P Γ b) (eval P Γ t) (eval P Γ f)
  | .J x sl su => if 2⁻¹ ≤ x ∧ x ≤ 1 then gJwIv P P.wl P.wu x sl su else none
  | .DJ x zl zu => DJIv P x zl zu
  | .Jx0 => if 0 < P.wl then some (rdn P.prec (P.wl / sqrtPiHi), rup P.prec (P.wu / sqrtPiLo))
      else none
  | .JwHalf w sl su => gJwIv P w w 2⁻¹ sl su
  | .rpow a r => rpowO P r (eval P Γ a)

/-- Soundness of an optional enclosure. -/
def OMem (o : Option (ℚ × ℚ)) (x : ℝ) : Prop := ∀ I, o = some I → Mem I x

/-- Soundness of `lift1`. -/
theorem lift1_sound (P : Params) {f : ℚ × ℚ → ℚ × ℚ} {g : ℝ → ℝ}
    (hf : ∀ I x, Mem I x → Mem (f I) (g x)) {o : Option (ℚ × ℚ)} {x : ℝ} (h : OMem o x) :
    OMem (lift1 P f o) (g x) := by
  intro I hI
  cases o with
  | none => cases hI
  | some K =>
    cases hI
    exact mem_ivRound _ (hf K x (h K rfl))

/-- Soundness of `lift2`. -/
theorem lift2_sound (P : Params) {f : ℚ × ℚ → ℚ × ℚ → ℚ × ℚ} {g : ℝ → ℝ → ℝ}
    (hf : ∀ I J x y, Mem I x → Mem J y → Mem (f I J) (g x y)) {o o' : Option (ℚ × ℚ)}
    {x y : ℝ} (h : OMem o x) (h' : OMem o' y) : OMem (lift2 P f o o') (g x y) := by
  intro I hI
  cases o with
  | none => cases hI
  | some K =>
    cases o' with
    | none => cases hI
    | some K' =>
      cases hI
      exact mem_ivRound _ (hf K K' x y (h K rfl) (h' K' rfl))

/-- Soundness of `ivDivO`. -/
theorem ivDivO_sound (P : Params) {o o' : Option (ℚ × ℚ)} {x y : ℝ} (h : OMem o x)
    (h' : OMem o' y) : OMem (ivDivO P o o') (x / y) := by
  intro I hI
  cases o with
  | none => cases hI
  | some K =>
    cases o' with
    | none => cases hI
    | some K' =>
      simp only [ivDivO] at hI
      rcases hK : ivInv K' with _ | L <;> rw [hK] at hI
      · cases hI
      cases hI
      rw [div_eq_mul_inv]
      exact mem_ivRound _ (mem_ivMul (h K rfl) (mem_ivInv (h' K' rfl) hK))

/-- Soundness of `iteO` (certified branch). -/
theorem iteO_sound {A B T F : Option (ℚ × ℚ)} {a b t f : ℝ} (hA : OMem A a) (hB : OMem B b)
    (hT : OMem T t) (hF : OMem F f) : OMem (iteO A B T F) (if a < b then t else f) := by
  intro I hI
  cases A with
  | none => cases hI
  | some K =>
    cases B with
    | none => cases hI
    | some K' =>
      have ha := hA K rfl
      have hb := hB K' rfl
      simp only [iteO] at hI
      split_ifs at hI with h1 h2
      · have : (K.2 : ℝ) < K'.1 := by exact_mod_cast h1
        rw [ite_eq_left (by linarith [ha.2, hb.1])]
        exact hT I hI
      · have : (K'.2 : ℝ) ≤ K.1 := by exact_mod_cast h2
        rw [ite_eq_right (by linarith [ha.1, hb.2])]
        exact hF I hI

/-- Soundness of `DJIv`. -/
theorem DJIv_sound (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) {x zl zu : ℚ} :
    OMem (DJIv P x zl zu) (DJr x) := by
  intro I hI
  unfold DJIv at hI
  split_ifs at hI with hc
  cases hI
  obtain ⟨hwl, hx1, hxw, h1, h2⟩ := hc
  have hwl' : (0 : ℝ) < P.wl := by exact_mod_cast hwl
  have hw0 : (0 : ℝ) < w₀ := hwl'.trans_le hw.1
  have hx1' : (0 : ℝ) < 1 - x := by exact_mod_cast hx1
  have hxw' : (1 - x : ℝ) / P.wl < 1 := by exact_mod_cast hxw
  have h1' : ((phiHi P zl : ℚ) : ℝ) ≤ (1 - x) / P.wu := by exact_mod_cast h1
  have h2' : (1 - x : ℝ) / P.wl ≤ ((phiLo P zu : ℚ) : ℝ) := by exact_mod_cast h2
  have ht1 : (1 - x : ℝ) / P.wu ≤ (1 - x) / w₀ := div_le_div_of_nonneg_left hx1'.le hw0 hw.2
  have ht2 : (1 - x : ℝ) / w₀ ≤ (1 - x) / P.wl := div_le_div_of_nonneg_left hx1'.le hwl' hw.1
  have ht : (1 - x : ℝ) / w₀ ∈ Ioo 0 1 := ⟨by positivity, ht2.trans_lt hxw'⟩
  have hs2 : (0 : ℝ) < √2 := by positivity
  have h22 : √2 * √2 = (2 : ℝ) := Real.mul_self_sqrt (by norm_num)
  constructor
  · have : √2 * zl ≤ gInv ((1 - x) / w₀) :=
      (le_gInv_iff ht).2 (((gCDF_le_phiHi P zl).trans h1').trans ht1)
    have := mul_le_mul_of_nonneg_left this hs2.le
    rw [← mul_assoc, h22] at this
    push_cast
    exact this
  · have : gInv ((1 - x) / w₀) ≤ √2 * zu :=
      (gInv_le_iff ht).2 ((ht2.trans h2').trans (phiLo_le_gCDF P zu))
    have := mul_le_mul_of_nonneg_left this hs2.le
    rw [← mul_assoc, h22] at this
    push_cast
    exact this

/-- Soundness of `rpowO`. -/
theorem rpowO_sound (P : Params) (r : ℚ) {o : Option (ℚ × ℚ)} {x : ℝ} (h : OMem o x) :
    OMem (rpowO P r o) (x ^ (r : ℝ)) := by
  intro I hI
  cases o with
  | none => cases hI
  | some K =>
    simp only [rpowO] at hI
    split_ifs at hI
    exact rpowIv_sound P (h K rfl) hI

/-- An environment `Γ` of enclosures is sound for the values `ρ` if `Γ[i]` encloses `ρ i`
whenever `Γ[i]` exists. -/
def EnvSound (Γ : List (ℚ × ℚ)) (ρ : ℕ → ℝ) : Prop := ∀ i I, Γ[i]? = some I → Mem I (ρ i)

/-- **Soundness of the evaluator.** If `eval P Γ e = some (l, u)`, $w_0\in[w_l,w_u]$ and the
environment `Γ` encloses `ρ`, then $l\le$ `denote ρ e` $\le u$. -/
theorem eval_sound (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) {Γ : List (ℚ × ℚ)}
    {ρ : ℕ → ℝ} (hΓ : EnvSound Γ ρ) (e : Ex) (l u : ℚ) (h : eval P Γ e = some (l, u)) :
    (l : ℝ) ≤ denote ρ e ∧ denote ρ e ≤ u := by
  suffices H : ∀ e, OMem (eval P Γ e) (denote ρ e) from H e (l, u) h
  intro e
  induction e with
  | var i => exact hΓ i
  | const q => intro I hI; cases hI; exact ⟨le_rfl, le_rfl⟩
  | add a b ha hb => exact lift2_sound P (fun _ _ _ _ ↦ mem_ivAdd) ha hb
  | sub a b ha hb => exact lift2_sound P (fun _ _ _ _ ↦ mem_ivSub) ha hb
  | mul a b ha hb => exact lift2_sound P (fun _ _ _ _ ↦ mem_ivMul) ha hb
  | div a b ha hb => exact ivDivO_sound P ha hb
  | neg a ha => exact lift1_sound P (fun _ _ ↦ mem_ivNeg) ha
  | npow a n ha => exact lift1_sound P (g := fun x ↦ x ^ n) (fun _ _ hx ↦ mem_ivPow hx n) ha
  | min a b ha hb => exact lift2_sound P (fun _ _ _ _ ↦ mem_ivMin) ha hb
  | max a b ha hb => exact lift2_sound P (fun _ _ _ _ ↦ mem_ivMax) ha hb
  | abs a ha => exact lift1_sound P (fun _ _ ↦ mem_ivAbs) ha
  | ite_lt a b t f ha hb ht hf => exact iteO_sound ha hb ht hf
  | J x sl su =>
    intro I hI
    simp only [eval] at hI
    split_ifs at hI with hx
    have hx1 : (2⁻¹ : ℝ) ≤ x := by
      have h := (Rat.cast_le (K := ℝ)).2 hx.1
      simpa using h
    have hx2 : (x : ℝ) ≤ 1 := by exact_mod_cast hx.2
    simp only [denote]
    rw [J_eq_gJw ⟨hx1, hx2⟩]
    exact gJwIv_sound P hI hw
  | DJ x zl zu => exact DJIv_sound P hw
  | Jx0 =>
    intro I hI
    simp only [eval] at hI
    split_ifs at hI with hwl
    cases hI
    have hwl' : (0 : ℝ) < P.wl := by exact_mod_cast hwl
    have hw0 : (0 : ℝ) < w₀ := hwl'.trans_le hw.1
    have hp : 0 < √π := sqrt_pos.2 pi_pos
    simp only [denote, J_x₀_eq]
    refine ⟨rdn_le_real _ ?_, le_rup_real _ ?_⟩
    · push_cast
      exact div_le_div₀ hw0.le hw.1 hp sqrt_pi_lt_hi.le
    · push_cast
      exact div_le_div₀ (hwl'.le.trans (hw.1.trans hw.2)) hw.2 sqrtPiLo_pos sqrtPiLo_lt.le
  | JwHalf w sl su =>
    intro I hI
    have := gJwIv_sound P hI (w := w) ⟨le_rfl, le_rfl⟩
    simpa [denote] using this
  | rpow a r ha => exact rpowO_sound P r ha

/-- Boolean check of a strict lower bound: `true` only if the evaluator certifies
$c<$ `denote ρ e` (for every `ρ` enclosed by `Γ`). -/
def check (P : Params) (Γ : List (ℚ × ℚ)) (e : Ex) (c : ℚ) : Bool :=
  match eval P Γ e with
  | some (l, _) => decide (c < l)
  | none => false

/-- Boolean check of a strict upper bound: `true` only if the evaluator certifies
`denote ρ e` $<c$. -/
def checkUpper (P : Params) (Γ : List (ℚ × ℚ)) (e : Ex) (c : ℚ) : Bool :=
  match eval P Γ e with
  | some (_, u) => decide (u < c)
  | none => false

/-- Boolean check of an enclosure: `true` only if the evaluator certifies
$a\le$ `denote ρ e` $\le b$. -/
def checkMem (P : Params) (Γ : List (ℚ × ℚ)) (e : Ex) (a b : ℚ) : Bool :=
  match eval P Γ e with
  | some (l, u) => decide (a ≤ l ∧ u ≤ b)
  | none => false

/-- Soundness of `check` for an environment `Γ` enclosing `ρ`. -/
theorem check_sound_env (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) {Γ : List (ℚ × ℚ)}
    {ρ : ℕ → ℝ} (hΓ : EnvSound Γ ρ) (e : Ex) (c : ℚ) (h : check P Γ e c = true) :
    (c : ℝ) < denote ρ e := by
  unfold check at h
  rcases he : eval P Γ e with _ | ⟨l, u⟩ <;> rw [he] at h
  · cases h
  have hc : (c : ℝ) < l := by exact_mod_cast of_decide_eq_true h
  exact hc.trans_le (eval_sound P hw hΓ e l u he).1

/-- Soundness of `checkUpper` for an environment `Γ` enclosing `ρ`. -/
theorem checkUpper_sound_env (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu)
    {Γ : List (ℚ × ℚ)} {ρ : ℕ → ℝ} (hΓ : EnvSound Γ ρ) (e : Ex) (c : ℚ)
    (h : checkUpper P Γ e c = true) : denote ρ e < c := by
  unfold checkUpper at h
  rcases he : eval P Γ e with _ | ⟨l, u⟩ <;> rw [he] at h
  · cases h
  have hc : (u : ℝ) < c := by exact_mod_cast of_decide_eq_true h
  exact (eval_sound P hw hΓ e l u he).2.trans_lt hc

/-- Soundness of `checkMem` for an environment `Γ` enclosing `ρ`. -/
theorem checkMem_sound_env (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu)
    {Γ : List (ℚ × ℚ)} {ρ : ℕ → ℝ} (hΓ : EnvSound Γ ρ) (e : Ex) (a b : ℚ)
    (h : checkMem P Γ e a b = true) : (a : ℝ) ≤ denote ρ e ∧ denote ρ e ≤ b := by
  unfold checkMem at h
  rcases he : eval P Γ e with _ | ⟨l, u⟩ <;> rw [he] at h
  · cases h
  obtain ⟨h1, h2⟩ := of_decide_eq_true h
  have h1' : (a : ℝ) ≤ l := by exact_mod_cast h1
  have h2' : (u : ℝ) ≤ b := by exact_mod_cast h2
  have := eval_sound P hw hΓ e l u he
  exact ⟨h1'.trans this.1, this.2.trans h2'⟩

/-! ### Environments of certified values -/

/-- A certified enclosure $l\le v\le u$ of a real number $v$ by rationals $l,u$. In an
environment only `l` and `u` are used by the evaluator (and hence by the kernel); `v` and the
proof `h` only enter the soundness theorems. -/
structure Cert where
  /-- Lower end of the enclosure. -/
  l : ℚ
  /-- Upper end of the enclosure. -/
  u : ℚ
  /-- The enclosed real number. -/
  v : ℝ
  /-- The enclosure $l\le v\le u$. -/
  h : (l : ℝ) ≤ v ∧ v ≤ u

/-- The value function of a list of reals: the $i$-th entry, and $0$ beyond the end. -/
noncomputable def envOf (vs : List ℝ) : ℕ → ℝ := fun i ↦ vs.getD i 0

/-- The enclosures of a list of certified values (the environment passed to `eval`). -/
def Cert.env (cs : List Cert) : List (ℚ × ℚ) := cs.map fun c ↦ (c.l, c.u)

/-- The values of a list of certified values (the meaning of the variables), `envOf` of the
list of values `c.v`. -/
noncomputable def Cert.val (cs : List Cert) : ℕ → ℝ := envOf (cs.map Cert.v)

/-- The environment of a list of certified values encloses its values. -/
theorem Cert.envSound (cs : List Cert) : EnvSound (Cert.env cs) (Cert.val cs) := by
  intro i I h
  simp only [Cert.env, List.getElem?_map, Option.map_eq_some_iff] at h
  obtain ⟨c, hc, rfl⟩ := h
  simp only [Cert.val, envOf, List.getD_eq_getElem?_getD, List.getElem?_map, hc,
    Option.map_some, Option.getD_some]
  exact c.h

/-- Soundness of `check` with an environment of certified values: `check P (Cert.env cs) e c`
implies $c<$ `denote (Cert.val cs) e`. For closed expressions take `cs = []`. -/
theorem check_sound (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) (cs : List Cert) (e : Ex)
    (c : ℚ) (h : check P (Cert.env cs) e c = true) : (c : ℝ) < denote (Cert.val cs) e :=
  check_sound_env P hw (Cert.envSound cs) e c h

/-- Soundness of `checkUpper` with an environment of certified values. -/
theorem checkUpper_sound (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) (cs : List Cert)
    (e : Ex) (c : ℚ) (h : checkUpper P (Cert.env cs) e c = true) :
    denote (Cert.val cs) e < c :=
  checkUpper_sound_env P hw (Cert.envSound cs) e c h

/-- Soundness of `checkMem` with an environment of certified values. -/
theorem checkMem_sound (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) (cs : List Cert)
    (e : Ex) (a b : ℚ) (h : checkMem P (Cert.env cs) e a b = true) :
    (a : ℝ) ≤ denote (Cert.val cs) e ∧ denote (Cert.val cs) e ≤ b :=
  checkMem_sound_env P hw (Cert.envSound cs) e a b h

/-- A certified enclosure $[a,b]$ of $J(x)$, $x\in[\frac12,1]$ rational (node `J` with
witnesses $s_l,s_u$; one kernel evaluation of `checkMem`). -/
noncomputable def Cert.ofJ (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) (x a b sl su : ℚ)
    (h : checkMem P [] (.J x sl su) a b = true) : Cert where
  l := a
  u := b
  v := J x
  h := checkMem_sound P hw [] (.J x sl su) a b h

/-- The exact value $J(1)=0$ as a certified value. -/
noncomputable def Cert.ofJOne : Cert where
  l := 0
  u := 0
  v := J ((1 : ℚ) : ℝ)
  h := by
    rw [Rat.cast_one, J_eq_gJw (x := 1) ⟨by norm_num, le_rfl⟩, gJw_one]
    simp

/-- A certified enclosure $[a,b]$ of $J'(x)=\sqrt2\,\Phi^{-1}((1-x)/w_0)$ (`DJr x`, see
`deriv_J_eq`) for rational $x\in(\frac12,1)$ (node `DJ` with witnesses $z_l,z_u$). -/
noncomputable def Cert.ofDJ (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) (x a b zl zu : ℚ)
    (h : checkMem P [] (.DJ x zl zu) a b = true) : Cert where
  l := a
  u := b
  v := DJr x
  h := checkMem_sound P hw [] (.DJ x zl zu) a b h

/-- A certified enclosure $[a,b]$ of $J(x_0)$ (node `Jx0`). -/
noncomputable def Cert.ofJx0 (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) (a b : ℚ)
    (h : checkMem P [] .Jx0 a b = true) : Cert where
  l := a
  u := b
  v := J x₀
  h := checkMem_sound P hw [] .Jx0 a b h

/-- A certified enclosure $[a,b]$ of $h^r$ (`Real.rpow`) for rational $h>0$ and $r$ (node
`rpow`). -/
noncomputable def Cert.ofRpow (P : Params) (hw : w₀ ∈ Icc (P.wl : ℝ) P.wu) (h r a b : ℚ)
    (hc : checkMem P [] (.rpow (.const h) r) a b = true) : Cert where
  l := a
  u := b
  v := (h : ℝ) ^ (r : ℝ)
  h := checkMem_sound P hw [] (.rpow (.const h) r) a b hc

/-- The exact value $0^r=0$ ($r\ne0$) as a certified value. -/
noncomputable def Cert.ofRpowZero (r : ℚ) (hr : r ≠ 0) : Cert where
  l := 0
  u := 0
  v := ((0 : ℚ) : ℝ) ^ (r : ℝ)
  h := by
    rw [Rat.cast_zero, Real.zero_rpow (by exact_mod_cast hr)]
    simp

/-! ### A fine enclosure of $w_0$ (width $9\cdot10^{-12}$) and standard parameters -/

/-- Parameters with the coarse enclosure `w₀_mem_fine` (used for `JwHalf`, which does not depend
on the enclosure). -/
def P0 : Params := { wl := 0.89576, wu := 0.89577 }

/-- The coarse enclosure `w₀_mem_fine` in the form needed for `P0`. -/
theorem hw0 : w₀ ∈ Icc (P0.wl : ℝ) P0.wu := by
  have h := w₀_mem_fine
  simp only [P0]
  norm_num at h ⊢
  exact h

/-- $J_{w_l}(\frac12)<\frac12$ for $w_l=0.895769326048$. -/
theorem gJw_wl_half_lt : gJw 0.895769326048 2⁻¹ < 2⁻¹ := by
  have := checkUpper_sound P0 hw0 []
    (.JwHalf 0.895769326048 0.103488597832974860 0.103488597832972859) 2⁻¹ (by decide +kernel)
  simpa [denote] using this

/-- $\frac12<J_{w_u}(\frac12)$ for $w_u=0.895769326057$. -/
theorem gJw_wu_half_gt : 2⁻¹ < gJw 0.895769326057 2⁻¹ := by
  have := check_sound P0 hw0 []
    (.JwHalf 0.895769326057 0.103488597822927630 0.103488597822925629) 2⁻¹ (by decide +kernel)
  simpa [denote] using this

/-- $w_0\in[0.895769326048,0.895769326057]$ (width $9\cdot10^{-12}$; $w_0=0.8957693260525\ldots$),
by the argument of `w₀_mem_fine`. -/
