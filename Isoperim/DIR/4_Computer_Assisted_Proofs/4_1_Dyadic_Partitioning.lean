/-!
# [DIR] §4 Computer-assisted proofs, §4.1 Dyadic partitioning

This file was automatically generated by Claude.

Source [DIR]: P. Durcik, P. Ivanisvili, J. Roos, *Sharp isoperimetric inequalities on the Hamming
cube near the critical exponent*, arXiv:2407.12674v2, §4 (introductory paragraph) and §4.1.

## Notation

Points of $\mathbb{R}^n$ are functions `Fin n → ℝ` with the coordinatewise order, so that the
rectangle $[a,b]=[a_1,b_1]\times\dots\times[a_n,b_n]$ is `Set.Icc a b`. A rectangle $[c,d]$ is
encoded by the pair `(c, d)`; a tight lower bound $\underline f$ is a function of the two corners,
`fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ`, $\underline f(\underline x,\overline x)$ = `fl xl xu`.
-/

@[expose] public section

namespace Auto.DIR

open Set Filter Topology

/-- A *rectangle* ([DIR], §4.1): $[a,b]=[a_1,b_1]\times\dots\times[a_n,b_n]\subset\mathbb{R}^n$
with $a_i<b_i$ for all $i=1,\dots,n$. -/
def IsRectangle {n : ℕ} (a b : Fin n → ℝ) : Prop := ∀ i, a i < b i

/-- A *tight lower bound* ([DIR], §4.1): a map $\underline f:[a,b]\times[a,b]\to\mathbb{R}$ such that
$f(x)\ge\underline f(\underline x,\overline x)$ for all $x\in[\underline x,\overline x]\subset[a,b]$,
and $\underline f(\underline x,\overline x)\to f(x)$ as $|\overline x-\underline x|\to0$,
$x\in[\underline x,\overline x]$. -/
def IsTightLowerBound {n : ℕ} (a b : Fin n → ℝ) (f : (Fin n → ℝ) → ℝ)
    (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) : Prop :=
  (∀ xl xu, a ≤ xl → xu ≤ b → ∀ x ∈ Icc xl xu, fl xl xu ≤ f x) ∧
  ∀ x ∈ Icc a b, ∀ ε > 0, ∃ δ > 0, ∀ xl xu, a ≤ xl → xu ≤ b → x ∈ Icc xl xu →
    dist xl xu < δ → |fl xl xu - f x| < ε

/-- A finite *partition* of the rectangle $[a,b]$ into rectangles ([DIR], §4.1): a finite set of
rectangles $[c,d]\subset[a,b]$ whose union is $[a,b]$ and whose interiors are pairwise
disjoint. -/
def IsRectanglePartition {n : ℕ} (a b : Fin n → ℝ) (P : Finset ((Fin n → ℝ) × (Fin n → ℝ))) :
    Prop :=
  (∀ p ∈ P, IsRectangle p.1 p.2 ∧ a ≤ p.1 ∧ p.2 ≤ b) ∧ (⋃ p ∈ P, Icc p.1 p.2) = Icc a b ∧
    (P : Set ((Fin n → ℝ) × (Fin n → ℝ))).PairwiseDisjoint
      (fun p ↦ Set.pi univ fun i ↦ Ioo (p.1 i) (p.2 i))

/-- An *admissible* partition ([DIR], §4.1): a finite partition $\mathcal P$ of $[a,b]$ into
rectangles such that $\underline f(c,d)>0$ for all $[c,d]\in\mathcal P$. -/
def IsAdmissiblePartition {n : ℕ} (a b : Fin n → ℝ) (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ)
    (P : Finset ((Fin n → ℝ) × (Fin n → ℝ))) : Prop :=
  IsRectanglePartition a b P ∧ ∀ p ∈ P, 0 < fl p.1 p.2

section Proof_Fact_4_1
/-- [DIR], proof of Fact 4.1: the 'if' part follows from the lower bound property and the
definition of an admissible partition. -/
theorem fact_4_1_if {n : ℕ} (a b : Fin n → ℝ) (f : (Fin n → ℝ) → ℝ)
    (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ)
    (hfl : ∀ xl xu, a ≤ xl → xu ≤ b → ∀ x ∈ Icc xl xu, fl xl xu ≤ f x)
    (P : Finset ((Fin n → ℝ) × (Fin n → ℝ))) (hP : IsAdmissiblePartition a b fl P) :
    ∀ x ∈ Icc a b, 0 < f x := by
  sorry

/-- [DIR], proof of Fact 4.1: for the 'only if' part let $f>0$. Then for every $x\in[a,b]$ there
exists $\varepsilon_x>0$ such that $\underline f(\underline x,\overline x)>0$ for all
$\underline x,\overline x\in[a,b]$ with $x\in[\underline x,\overline x]$ and
$|\overline x-\underline x|\le\varepsilon_x$. -/
theorem fact_4_1_eps {n : ℕ} (a b : Fin n → ℝ) (f : (Fin n → ℝ) → ℝ)
    (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) (hfl : IsTightLowerBound a b f fl)
    (hf : ∀ x ∈ Icc a b, 0 < f x) :
    ∀ x ∈ Icc a b, ∃ εx > 0, ∀ xl xu, a ≤ xl → xu ≤ b → x ∈ Icc xl xu →
      dist xl xu ≤ εx → 0 < fl xl xu := by
  sorry

end Proof_Fact_4_1

/-- **Fact 4.1** ([DIR]). Suppose a function $f$ on $[a,b]$ has a tight lower bound
$\underline f$. Then $f>0$ on $[a,b]$ if and only if there exists an admissible partition. -/
theorem fact_4_1 {n : ℕ} (a b : Fin n → ℝ) (hab : IsRectangle a b) (f : (Fin n → ℝ) → ℝ)
    (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) (hfl : IsTightLowerBound a b f fl) :
    (∀ x ∈ Icc a b, 0 < f x) ↔ ∃ P, IsAdmissiblePartition a b fl P := by
  sorry

/-- **Remark 4.2** ([DIR]). It is not required that $f$ is continuous; however, existence of a
tight lower bound implies lower semicontinuity of $f$ (on $[a,b]$). -/
theorem rem_4_2 {n : ℕ} (a b : Fin n → ℝ) (f : (Fin n → ℝ) → ℝ)
    (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) (hfl : IsTightLowerBound a b f fl) :
    LowerSemicontinuousOn f (Icc a b) := by
  sorry

/-- The *children* of a rectangle $[a,b]$ ([DIR], §4.1): the $2^n$ congruent subrectangles obtained
by cutting along the midpoint in each of the $n$ coordinates; the child indexed by
$s\in\{0,1\}^n$ takes the upper half in the coordinates $i$ with $s_i=1$. -/
noncomputable def child {n : ℕ} (a b : Fin n → ℝ) (s : Fin n → Bool) :
    (Fin n → ℝ) × (Fin n → ℝ) :=
  (fun i ↦ if s i then (a i + b i) / 2 else a i, fun i ↦ if s i then b i else (a i + b i) / 2)

/-- The list of the $2^n$ children of $[a,b]$ ([DIR], §4.1). -/
noncomputable def children {n : ℕ} (a b : Fin n → ℝ) : List ((Fin n → ℝ) × (Fin n → ℝ)) :=
  (Finset.univ : Finset (Fin n → Bool)).toList.map (child a b)

open Classical in
/-- The procedure $\textsc{Partition}_n(\underline f,[a,b],depth)$ of [DIR], §4.1 (recursive dyadic
partitioning, with a finite $maxDepth$): if $\underline f(a,b)>0$ return $\{[a,b]\}$; else if
$depth\ge maxDepth$ fail; else call the procedure on each child rectangle with $depth+1$, fail if
one of the calls fails, and return the union of the results. Failure is `none`; the result is
the list of the rectangles found. -/
noncomputable def partitionN {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) (maxDepth : ℕ)
    (a b : Fin n → ℝ) (depth : ℕ) : Option (List ((Fin n → ℝ) × (Fin n → ℝ))) :=
  if 0 < fl a b then some [(a, b)]
  else if maxDepth ≤ depth then none
  else ((children a b).attach.mapM fun c ↦ partitionN fl maxDepth c.1.1 c.1.2 (depth + 1)).map
    List.flatten
termination_by maxDepth - depth

/-- $\textsc{Partition}_n(\underline f,[a,b]):=\textsc{Partition}_n(\underline f,[a,b],0)$
([DIR], §4.1). -/
noncomputable def partitionN₀ {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) (maxDepth : ℕ)
    (a b : Fin n → ℝ) : Option (List ((Fin n → ℝ) × (Fin n → ℝ))) :=
  partitionN fl maxDepth a b 0

/-- [DIR], §4.1: running $\textsc{Partition}_n(\underline f,[a,b])$ either fails or returns an
admissible partition. -/
theorem partitionN₀_admissible {n : ℕ} (a b : Fin n → ℝ) (hab : IsRectangle a b)
    (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) (maxDepth : ℕ) (P : List ((Fin n → ℝ) × (Fin n → ℝ)))
    (hP : partitionN₀ fl maxDepth a b = some P) : IsAdmissiblePartition a b fl P.toFinset := by
  sorry

/-- [DIR], §4.1: running $\textsc{Partition}_n(\underline f,[a,b])$ either fails or returns an
admissible partition, thus providing a proof that $f>0$ holds on $[a,b]$ (if $\underline f$ is a
lower bound of $f$ as in the definition of a tight lower bound). -/
theorem pos_of_partitionN₀ {n : ℕ} (a b : Fin n → ℝ) (hab : IsRectangle a b)
    (f : (Fin n → ℝ) → ℝ) (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ)
    (hfl : ∀ xl xu, a ≤ xl → xu ≤ b → ∀ x ∈ Icc xl xu, fl xl xu ≤ f x) (maxDepth : ℕ)
    (P : List ((Fin n → ℝ) × (Fin n → ℝ))) (hP : partitionN₀ fl maxDepth a b = some P) :
    ∀ x ∈ Icc a b, 0 < f x := by
  sorry

/-- [DIR], §4.1: moreover, Fact 4.1 implies that if it is true that $f>0$ holds on $[a,b]$, then the
procedure will always succeed in producing a proof of this, provided that $maxDepth$ is chosen
large enough. -/
theorem partitionN₀_succeeds {n : ℕ} (a b : Fin n → ℝ) (hab : IsRectangle a b)
    (f : (Fin n → ℝ) → ℝ) (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ)
    (hfl : IsTightLowerBound a b f fl) (hf : ∀ x ∈ Icc a b, 0 < f x) :
    ∃ M, ∀ maxDepth ≥ M, (partitionN₀ fl maxDepth a b).isSome := by
  sorry

end Auto.DIR
