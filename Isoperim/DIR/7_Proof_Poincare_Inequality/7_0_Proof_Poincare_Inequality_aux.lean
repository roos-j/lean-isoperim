/-! ### Indicator functions on the cube -/

/-- $\#\{0,1\}^n=2^n$. -/
theorem poincare_card_cube (n : ℕ) : (Fintype.card ({0,1}^n) : ℝ) = 2 ^ n := by
  simp [Cube, ZMod.card]

/-- $\mathbf E(fc+(1-f)d)=(\mathbf Ef)c+(1-\mathbf Ef)d$. -/
theorem poincare_expect_affine {n : ℕ} (f : ({0,1}^n) → ℝ) (c d : ℝ) :
    𝐄 (fun x ↦ f x * c + (1 - f x) * d) = 𝐄 f * c + (1 - 𝐄 f) * d := by
  simp only [expect, smul_eq_mul]
  have h1 : ∑ x, (f x * c + (1 - f x) * d) = (∑ x, f x) * (c - d) + ∑ _x : ({0,1}^n), d := by
    rw [Finset.sum_mul, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun x _ ↦ by ring
  rw [h1, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, poincare_card_cube]
  have : (2⁻¹ : ℝ) ^ n * 2 ^ n = 1 := by rw [← mul_pow]; norm_num
  linear_combination d * this

/-- $\mathbf 1_A(x)=1$ if $x\in A$ and $0$ otherwise. -/
theorem poincare_ind_apply {n : ℕ} (A : Set ({0,1}^n)) (x : {0,1}^n) [Decidable (x ∈ A)] :
    𝟏 A x = if x ∈ A then 1 else 0 := by
  simp [ind, Set.indicator_apply]

/-- $|A|=2^{-n}\#A$. -/
theorem poincare_dens_eq_ncard {n : ℕ} (A : Set ({0,1}^n)) :
    ｜A｜ = (2 : ℝ)⁻¹ ^ n * A.ncard := by
  classical
  simp only [dens, expect, smul_eq_mul]
  congr 1
  simp only [poincare_ind_apply]
  rw [Finset.sum_boole, Set.ncard_eq_toFinset_card']
  congr 2
  ext x
  simp

/-- $0\le|A|\le1$. -/
theorem poincare_dens_mem {n : ℕ} (A : Set ({0,1}^n)) : 0 ≤ ｜A｜ ∧ ｜A｜ ≤ 1 := by
  classical
  have hle : ∀ x, 𝟏 A x ≤ 1 := fun x ↦ by rw [poincare_ind_apply]; split_ifs <;> norm_num
  have hge : ∀ x, 0 ≤ 𝟏 A x := fun x ↦ by rw [poincare_ind_apply]; split_ifs <;> norm_num
  simp only [dens, expect, smul_eq_mul]
  refine ⟨mul_nonneg (by positivity) (Finset.sum_nonneg fun x _ ↦ hge x), ?_⟩
  calc (2⁻¹ : ℝ) ^ n * ∑ x, 𝟏 A x ≤ (2⁻¹ : ℝ) ^ n * ∑ _x : ({0,1}^n), (1 : ℝ) :=
        mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun x _ ↦ hle x) (by positivity)
    _ = 1 := by
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, poincare_card_cube, mul_one,
          ← mul_pow]
        norm_num

/-- $|A^c|=1-|A|$. -/
theorem poincare_dens_compl {n : ℕ} (A : Set ({0,1}^n)) : ｜Aᶜ｜ = 1 - ｜A｜ := by
  classical
  have h : 𝟏 Aᶜ = fun x ↦ 𝟏 A x * 0 + (1 - 𝟏 A x) * 1 := by
    funext x
    rw [poincare_ind_apply, poincare_ind_apply]
    by_cases hx : x ∈ A <;> simp [hx]
  simp only [dens]
  rw [h, poincare_expect_affine]
  ring

/-- $\|f\|_p^p=\mathbf E|f|^p$ (for $p\ne0$). -/
theorem poincare_pNorm_rpow {n : ℕ} {M : Type*} [NormedAddCommGroup M] {p : ℝ} (hp : p ≠ 0)
    (f : ({0,1}^n) → M) : pNorm p f ^ p = 𝐄 (fun x ↦ ‖f x‖ ^ p) := by
  unfold pNorm
  refine rpow_inv_rpow ?_ hp
  simp only [expect, smul_eq_mul]
  exact mul_nonneg (by positivity) (Finset.sum_nonneg fun x _ ↦ rpow_nonneg (norm_nonneg _) _)

/-- $\|\mathbf 1_A-|A|\|_p^p=|A|^p(1-|A|)+|A|(1-|A|)^p$ (for $p>0$). -/
theorem poincare_ind_norm_rpow {n : ℕ} (A : Set ({0,1}^n)) {p : ℝ} (hp : 0 < p) :
    pNorm p (𝟏 A - fun _ ↦ 𝐄 𝟏 A) ^ p = ｜A｜ ^ p * (1 - ｜A｜) + ｜A｜ * (1 - ｜A｜) ^ p := by
  classical
  rw [poincare_pNorm_rpow hp.ne']
  obtain ⟨h0, h1⟩ := poincare_dens_mem A
  have hpt : (fun x ↦ ‖((𝟏 A - fun _ ↦ 𝐄 𝟏 A : ({0,1}^n) → ℝ)) x‖ ^ p) =
      fun x ↦ 𝟏 A x * (1 - ｜A｜) ^ p + (1 - 𝟏 A x) * ｜A｜ ^ p := by
    funext x
    simp only [Pi.sub_apply, Real.norm_eq_abs]
    rw [show 𝐄 𝟏 A = ｜A｜ from rfl, poincare_ind_apply]
    by_cases hx : x ∈ A
    · simp [hx, abs_of_nonneg (sub_nonneg.2 h1)]
    · simp [hx, abs_of_nonneg h0]
  rw [hpt, poincare_expect_affine, show 𝐄 𝟏 A = ｜A｜ from rfl]
  ring

/-- $\sum_i\|\frac12(\mathbf 1_A(x)-\mathbf 1_A(x\oplus e_i))\|^2=\frac14(h_A(x)+h_{A^c}(x))$. -/
theorem poincare_grad_sum {n : ℕ} (A : Set ({0,1}^n)) (x : {0,1}^n) :
    ∑ i, ‖(2⁻¹ : ℝ) • (𝟏 A x - 𝟏 A (x + e i))‖ ^ 2 = 4⁻¹ * (h A x + h Aᶜ x) := by
  classical
  have hterm : ∀ i, ‖(2⁻¹ : ℝ) • (𝟏 A x - 𝟏 A (x + e i))‖ ^ 2 =
      4⁻¹ * (if (x ∈ A ↔ x + e i ∈ A) then 0 else 1) := by
    intro i
    rw [norm_smul, mul_pow, Real.norm_eq_abs, Real.norm_eq_abs, sq_abs, sq_abs,
      poincare_ind_apply, poincare_ind_apply]
    by_cases h1 : x ∈ A <;> by_cases h2 : x + e i ∈ A <;> simp [h1, h2] <;> norm_num
  simp only [hterm, ← Finset.mul_sum]
  congr 1
  by_cases hx : x ∈ A
  · have hc : h Aᶜ x = 0 := by simp [h, hx]
    rw [hc, add_zero, h, ite_eq_left hx, Finset.natCast_card_filter]
    exact Finset.sum_congr rfl fun i _ ↦ by by_cases h2 : x + e i ∈ A <;> simp [hx, h2]
  · have hc : h A x = 0 := by simp [h, hx]
    rw [hc, zero_add, h, ite_eq_left (show x ∈ Aᶜ from hx), Finset.natCast_card_filter]
    exact Finset.sum_congr rfl fun i _ ↦ by by_cases h2 : x + e i ∈ A <;> simp [hx, h2]

/-- $h_A\ge0$. -/
theorem poincare_h_nonneg {n : ℕ} (A : Set ({0,1}^n)) (x : {0,1}^n) : 0 ≤ h A x := by
  unfold h
  split_ifs <;> positivity

/-- $|\nabla\mathbf 1_A(x)|^p=2^{-p}(h_A(x)^{p/2}+h_{A^c}(x)^{p/2})$ (for $p>0$). -/
theorem poincare_grad_ind_rpow {n : ℕ} (A : Set ({0,1}^n)) {p : ℝ} (hp : 0 < p)
    (x : {0,1}^n) :
    ‖∇(𝟏 A) x‖ ^ p = 2 ^ (-p) * (h A x ^ (p / 2) + h Aᶜ x ^ (p / 2)) := by
  have hg : ∇(𝟏 A) x = √(4⁻¹ * (h A x + h Aᶜ x)) := by
    simp only [gradNorm]
    rw [poincare_grad_sum]
  have h0 := poincare_h_nonneg A x
  have h0' := poincare_h_nonneg Aᶜ x
  rw [hg, Real.norm_of_nonneg (sqrt_nonneg _), sqrt_eq_rpow, ← rpow_mul (by positivity),
    mul_rpow (by norm_num) (by positivity)]
  have h4 : (4⁻¹ : ℝ) ^ (1 / 2 * p) = 2 ^ (-p) := by
    rw [show (4⁻¹ : ℝ) = 2 ^ (-2 : ℝ) by rw [rpow_neg (by norm_num)]; norm_num,
      ← rpow_mul (by norm_num)]
    congr 1; ring
  have hp2 : p / 2 ≠ 0 := by positivity
  rw [h4, show 1 / 2 * p = p / 2 by ring]
  congr 1
  by_cases hx : x ∈ A
  · have hc : h Aᶜ x = 0 := by simp [h, hx]
    rw [hc, add_zero, zero_rpow hp2, add_zero]
  · have hc : h A x = 0 := by simp [h, hx]
    rw [hc, zero_add, zero_rpow hp2, zero_add]

/-- **(7.1)** in auxiliary form: $\|\nabla\mathbf 1_A\|_p^p=2^{-p}(\mathbf Eh_A^{p/2}+
\mathbf Eh_{A^c}^{p/2})$ (for $p>0$). -/
theorem poincare_eqn_7_1 {n : ℕ} (A : Set ({0,1}^n)) {p : ℝ} (hp : 0 < p) :
    pNorm p (∇(𝟏 A)) ^ p = 2 ^ (-p) * (𝐄 h A ^ (p / 2) + 𝐄 h Aᶜ ^ (p / 2)) := by
  rw [poincare_pNorm_rpow hp.ne']
  simp only [poincare_grad_ind_rpow A hp, expect, smul_eq_mul, Pi.pow_apply]
  rw [← Finset.mul_sum, Finset.sum_add_distrib]
  ring

/-! ### Soundness of one-dimensional partitions given by breakpoints -/

/-- `poincareBoxesOK P [c₀, …, c_N]`: $P(c_i,c_{i+1})$ holds for all consecutive breakpoints. -/
def poincareBoxesOK (P : ℚ → ℚ → Prop) : List ℚ → Prop
  | a :: b :: l => P a b ∧ poincareBoxesOK P (b :: l)
  | _ => True

/-- `poincareSorted [c₀, …, c_N]`: the breakpoints are strictly increasing. -/
def poincareSorted : List ℚ → Bool
  | a :: b :: l => decide (a < b) && poincareSorted (b :: l)
  | _ => true

/-- The rectangles $[c_i,c_{i+1}]\subset\mathbb R^1$ of a list of breakpoints. -/
noncomputable def poincareBoxes : List ℚ → List ((Fin 1 → ℝ) × (Fin 1 → ℝ))
  | a :: b :: l => ((fun _ ↦ (a : ℝ)), (fun _ ↦ (b : ℝ))) :: poincareBoxes (b :: l)
  | _ => []

/-- Membership in a rectangle of $\mathbb R^1$. -/
theorem poincare_mem_Icc_fin1 {x : Fin 1 → ℝ} {a b : ℝ} :
    x ∈ Icc (fun _ ↦ a) (fun _ ↦ b) ↔ a ≤ x 0 ∧ x 0 ≤ b := by
  simp [Pi.le_def, Fin.forall_fin_one]

/-- Adding the rectangle $[a,b]$ to a partition of $[b,c]$ gives a partition of $[a,c]$. -/
theorem poincare_partition_cons {a b c : ℝ} (hab : a < b) (hbc : b ≤ c)
    {P : Finset ((Fin 1 → ℝ) × (Fin 1 → ℝ))}
    (hP : IsRectanglePartition (fun _ ↦ b) (fun _ ↦ c) P) :
    IsRectanglePartition (fun _ ↦ a) (fun _ ↦ c) (insert ((fun _ ↦ a), (fun _ ↦ b)) P) := by
  obtain ⟨h1, h2, h3⟩ := hP
  refine ⟨?_, ?_, ?_⟩
  · intro p hp
    rcases Finset.mem_insert.1 hp with rfl | hp
    · exact ⟨fun _ ↦ hab, le_rfl, fun _ ↦ hbc⟩
    · obtain ⟨r, hl, hu⟩ := h1 p hp
      exact ⟨r, fun i ↦ hab.le.trans (hl i), hu⟩
  · rw [Finset.set_biUnion_insert, h2]
    ext x
    simp only [mem_union, poincare_mem_Icc_fin1]
    constructor
    · rintro (⟨h, h'⟩ | ⟨h, h'⟩) <;> constructor <;> linarith
    · rintro ⟨h, h'⟩
      rcases le_total (x 0) b with hb | hb
      · exact Or.inl ⟨h, hb⟩
      · exact Or.inr ⟨hb, h'⟩
  · rw [Finset.coe_insert]
    refine h3.insert fun q hq _ ↦ ?_
    obtain ⟨-, hl, -⟩ := h1 q hq
    rw [Set.disjoint_left]
    intro x hx hx'
    have e1 := (Set.mem_univ_pi.1 hx 0).2
    have e2 := (Set.mem_univ_pi.1 hx' 0).1
    have e3 := hl 0
    simp only at e1 e2 e3
    linarith

/-- The rectangles of a strictly increasing list of breakpoints $a<c<\dots<b$ form a partition of
$[a,b]$ (in the sense of [DIR], §4.1). -/
theorem poincare_isRectanglePartition_boxes : ∀ (a c : ℚ) (l : List ℚ),
    poincareSorted (a :: c :: l) = true →
    IsRectanglePartition (fun _ ↦ (a : ℝ)) (fun _ ↦ (((c :: l).getLast (by simp) : ℚ) : ℝ))
      (poincareBoxes (a :: c :: l)).toFinset
  | a, c, [], h => by
    simp only [poincareSorted, Bool.and_eq_true, decide_eq_true_eq] at h
    have hac : (a : ℝ) < c := by exact_mod_cast h.1
    simp only [poincareBoxes, List.getLast_singleton, List.toFinset_cons, List.toFinset_nil,
      insert_empty_eq]
    exact isBoxPartition_singleton fun _ ↦ hac
  | a, c, d :: l, h => by
    have h0 := h
    simp only [poincareSorted, Bool.and_eq_true, decide_eq_true_eq] at h0
    obtain ⟨hac, hcd, -⟩ := h0
    have h' : poincareSorted (c :: d :: l) = true := by
      simp only [poincareSorted, Bool.and_eq_true] at h ⊢
      exact h.2
    have hP := poincare_isRectanglePartition_boxes c d l h'
    have hmem : ((fun _ ↦ (c : ℝ)), (fun _ ↦ (d : ℝ))) ∈ (poincareBoxes (c :: d :: l)).toFinset :=
      List.mem_toFinset.2 (by simp [poincareBoxes])
    obtain ⟨-, -, hd⟩ := hP.1 _ hmem
    have hcd : (c : ℝ) < d := by exact_mod_cast hcd
    rw [List.getLast_cons_cons]
    rw [poincareBoxes, List.toFinset_cons]
    exact poincare_partition_cons (by exact_mod_cast hac) (hcd.le.trans (hd 0)) hP

/-- If $P(c_i,c_{i+1})$ for all boxes, then every rectangle $[c,d]$ of `poincareBoxes` satisfies
$P(c,d)$. -/
theorem poincare_boxes_pos (fl : ℝ → ℝ → ℝ) (m : ℝ) :
    ∀ l : List ℚ, poincareBoxesOK (fun p q ↦ m < fl p q) l →
      ∀ p ∈ poincareBoxes l, m < fl (p.1 0) (p.2 0)
  | a :: b :: l, h, p, hp => by
    rcases List.mem_cons.1 hp with rfl | hp
    · exact h.1
    · exact poincare_boxes_pos fl m (b :: l) h.2 p hp
  | [_], _, p, hp => by simp [poincareBoxes] at hp
  | [], _, p, hp => by simp [poincareBoxes] at hp

/-- **Soundness of a one-dimensional partition** (via [DIR], Fact 4.1, 'if' part): let
$\underline f$ be a lower bound of $f$ on $[a,b]$ (i.e. $f(x)\ge\underline f(\underline x,
\overline x)$ for $x\in[\underline x,\overline x]\subset[a,b]$) and let $a=c_0<\dots<c_N=b$ be
breakpoints with $\underline f(c_i,c_{i+1})>m$ for all $i$. Then $f>m$ on $[a,b]$. -/
theorem poincare_pos_of_breakpoints (f : ℝ → ℝ) (fl : ℝ → ℝ → ℝ) (m : ℝ) (cs : List ℚ)
    (a b : ℚ) (hcs : poincareSorted cs = true) (ha : cs.head? = some a) (hb : cs.getLast? = some b)
    (hlen : 2 ≤ cs.length)
    (hfl : ∀ xl xu : ℝ, (a : ℝ) ≤ xl → xu ≤ b → ∀ x ∈ Icc xl xu, fl xl xu ≤ f x)
    (hbox : poincareBoxesOK (fun p q ↦ m < fl p q) cs) :
    ∀ x ∈ Icc (a : ℝ) b, m < f x := by
  match cs, hcs, ha, hb, hlen, hbox with
  | a' :: c :: l, hcs, ha, hb, _, hbox =>
    cases ha
    have hP := poincare_isRectanglePartition_boxes a c l hcs
    have hlast : (c :: l).getLast (by simp) = b := by
      rw [List.getLast?_cons_cons, List.getLast?_eq_some_getLast (by simp)] at hb
      exact Option.some.inj hb
    rw [hlast] at hP
    intro x hx
    have hpos := poincare_boxes_pos fl m _ hbox
    have := fact_4_1_if (n := 1) (fun _ ↦ (a : ℝ)) (fun _ ↦ (b : ℝ)) (fun v ↦ f (v 0) - m)
      (fun u v ↦ fl (u 0) (v 0) - m) ?_ _
      ⟨hP, fun p hp ↦ sub_pos.2 (hpos p (List.mem_toFinset.1 hp))⟩ (fun _ ↦ x)
      ⟨fun _ ↦ hx.1, fun _ ↦ hx.2⟩
    · simpa using this
    · intro xl xu h1 h2 y hy
      exact sub_le_sub_right (hfl _ _ (h1 0) (h2 0) (y 0) ⟨hy.1 0, hy.2 0⟩) m

/-! ### Elementary facts on $J$, $J'$, $L_{1/2}$ and $Q_\beta'$ -/

/-- $w_0>0$. -/
theorem poincare_w₀_pos : 0 < w₀ := by linarith [w₀_mem.1]

/-- $J=J_{w_0}\ge0$ on $[\frac12,1]$. -/
theorem poincare_J_nonneg {y : ℝ} (hy : y ∈ Icc (2⁻¹ : ℝ) 1) : 0 ≤ J y := by
  rw [J_eq_gJw hy, gJw]
  have := poincare_w₀_pos
  have := gProf_nonneg (w₀⁻¹ * (1 - y))
  positivity

/-- $J$ is decreasing on $[x_0,1]$. -/
theorem poincare_J_antitoneOn : AntitoneOn J (Icc x₀ 1) := by
  have hw := w₀_mem
  have hw0 := poincare_w₀_pos
  have hx0 : x₀ = 1 - w₀ / 2 := rfl
  intro y hy z hz hyz
  have hy' : y ∈ Icc (2⁻¹ : ℝ) 1 := ⟨by linarith [hy.1, hw.2], hy.2⟩
  have hz' : z ∈ Icc (2⁻¹ : ℝ) 1 := ⟨by linarith [hz.1, hw.2], hz.2⟩
  rw [J_eq_gJw hy', J_eq_gJw hz', gJw, gJw]
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  have hmem : ∀ t ∈ Icc x₀ (1 : ℝ), w₀⁻¹ * (1 - t) ∈ Icc (0 : ℝ) 2⁻¹ := fun t ht ↦
    ⟨mul_nonneg (inv_nonneg.2 hw0.le) (by linarith [ht.2]), by
      rw [← div_eq_inv_mul, div_le_iff₀ hw0]; linarith [ht.1]⟩
  exact gProf_strictMonoOn.monotoneOn (hmem z hz) (hmem y hy)
    (mul_le_mul_of_nonneg_left (by linarith) (inv_nonneg.2 hw0.le))

/-- $x_0\le\frac34$. -/
theorem poincare_x₀_le : x₀ ≤ 3 / 4 := by
  have := w₀_mem; rw [x₀]; linarith [this.1]

/-- $L_{1/2}$ is increasing on $[0,\frac14]$. -/
theorem poincare_L_half_monotoneOn : MonotoneOn (L 2⁻¹) (Icc 0 4⁻¹) := by
  have hint : interior (Icc (0 : ℝ) 4⁻¹) = Ioo 0 4⁻¹ := interior_Icc
  refine monotoneOn_of_deriv_nonneg (convex_Icc 0 4⁻¹)
    ((continuousOn_L (by norm_num) (by norm_num)).mono (Icc_subset_Icc le_rfl (by norm_num)))
    ?_ ?_
  · intro x hx
    rw [hint] at hx
    exact (hasDerivAt_L ⟨hx.1, by linarith [hx.2]⟩).differentiableAt.differentiableWithinAt
  · intro x hx
    rw [hint] at hx
    rw [(hasDerivAt_L ⟨hx.1, by linarith [hx.2]⟩).deriv, L1f]
    have hl : (2⁻¹ : ℝ) ≤ log x⁻¹ := by
      have h4 : (4 : ℝ) ≤ x⁻¹ := (le_inv_comm₀ (by norm_num) hx.1).2 hx.2.le
      have : log 4 ≤ log x⁻¹ := log_le_log (by norm_num) h4
      have h2 : log (4 : ℝ) = 2 * log 2 := by
        rw [show (4 : ℝ) = 2 ^ 2 by norm_num, log_pow]; norm_num
      linarith [log_two_gt_d9]
    have h1 : 0 ≤ (log 2) ^ (-(2⁻¹ : ℝ)) := rpow_nonneg (log_nonneg one_le_two) _
    have h2 : 0 ≤ (log x⁻¹) ^ (-1 + (2⁻¹ : ℝ)) := rpow_nonneg (by linarith) _
    have h3 : 0 ≤ -(2⁻¹ : ℝ) + log x⁻¹ := by linarith
    positivity

/-- $L_\beta(\frac14)=Q_\beta(\frac14)$ $(=2^{\beta-2})$. -/
theorem poincare_L_quarter (β : ℝ) : L β 4⁻¹ = Q β 4⁻¹ := by
  have h4 : log₂ ((4 : ℝ)⁻¹)⁻¹ = 2 := by
    rw [inv_inv, show (4 : ℝ) = 2 ^ (2 : ℕ) by norm_num, logb_pow,
      logb_self_eq_one one_lt_two]
    norm_num
  rw [L, h4, Q, two_rpow_add_two, two_rpow_add_one']
  ring

/-- $Q_\beta(\frac12)=\frac12$. -/
theorem poincare_Q_half (β : ℝ) : Q β 2⁻¹ = 2⁻¹ := by
  rw [Q, two_rpow_add_two, two_rpow_add_one']
  ring

/-- $2^\beta\le\frac32$ for $\beta\le\beta_0$. -/
theorem poincare_two_rpow_le {β : ℝ} (hβ : β ≤ β₀) : (2 : ℝ) ^ β ≤ 3 / 2 := by
  have h1 : (2 : ℝ) ^ β ≤ 2 ^ ((9 : ℤ) / (16 : ℕ) : ℝ) :=
    rpow_le_rpow_of_exponent_le (by norm_num) (by rw [β₀] at hβ; norm_num; linarith)
  refine h1.trans (two_rpow_le_of_zpow_le (by norm_num) rfl (by norm_num) ?_)
  norm_num

/-- $\sqrt2=2^{1/2}\in[1.414,1.415]$. -/
theorem poincare_two_rpow_half : (1.414 : ℝ) ≤ 2 ^ (2⁻¹ : ℝ) ∧ (2 : ℝ) ^ (2⁻¹ : ℝ) ≤ 1.415 := by
  rw [show (2⁻¹ : ℝ) = 1 / 2 by norm_num, ← sqrt_eq_rpow]
  constructor
  · rw [Real.le_sqrt (by norm_num) (by norm_num)]; norm_num
  · rw [Real.sqrt_le_left (by norm_num)]; norm_num

/-- Properties of $Q_\beta'$ (`Q1f`) on $[\frac14,\frac12]$ used for (7.4): for
$\beta\in[\frac12,\beta_0]$ and $\frac14\le x_l\le x\le\frac12$,
$0\le Q_\beta'(x)\le Q_{1/2}'(x)\le Q_{1/2}'(x_l)$. -/
theorem poincare_Q1f_bounds {β : ℝ} (hβ : β ∈ Icc 2⁻¹ β₀) {xl x : ℝ} (h1 : 4⁻¹ ≤ xl)
    (hxl : xl ≤ x) (h2 : x ≤ 2⁻¹) :
    0 ≤ Q1f β x ∧ Q1f β x ≤ Q1f 2⁻¹ x ∧ Q1f 2⁻¹ x ≤ Q1f 2⁻¹ xl := by
  rw [Q1f_eq_affine, Q1f_eq_affine, Q1f_eq_affine]
  have hs : (2 : ℝ) ^ (2⁻¹ : ℝ) ≤ 2 ^ β := rpow_le_rpow_of_exponent_le (by norm_num) hβ.1
  have hs2 := poincare_two_rpow_le hβ.2
  obtain ⟨h0l, h0u⟩ := poincare_two_rpow_half
  set s := (2 : ℝ) ^ β
  set s₀ := (2 : ℝ) ^ (2⁻¹ : ℝ)
  have hB : 8 / 3 - 16 * x + 16 * x ^ 2 ≤ 0 := by nlinarith
  refine ⟨?_, ?_, ?_⟩
  · nlinarith [mul_nonneg_of_nonpos_of_nonpos hB (by linarith : s - 3 / 2 ≤ 0)]
  · nlinarith [mul_nonneg_of_nonpos_of_nonpos hB (by linarith : s₀ - s ≤ 0)]
  · have hbr : 0 ≤ -((20 - 16 * s₀) + (x + xl) * (16 * s₀ - 24)) := by nlinarith
    nlinarith [mul_nonneg (sub_nonneg.2 hxl) hbr]

/-- The function $y\mapsto J'(y)$ (`DJr`) is decreasing on $(1-w_0,1)$. -/
theorem poincare_DJr_anti {y z : ℝ} (hy : 1 - w₀ < y) (hyz : y ≤ z) (hz : z < 1) :
    DJr z ≤ DJr y := by
  have hw0 := poincare_w₀_pos
  unfold DJr
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  refine gInv_strictMonoOn.monotoneOn ⟨by apply div_pos <;> linarith, ?_⟩
    ⟨by apply div_pos <;> linarith, ?_⟩ (div_le_div_of_nonneg_right (by linarith) hw0.le)
  · rw [div_lt_one hw0]; linarith
  · rw [div_lt_one hw0]; linarith

/-- $J'(y)\ge0$ for $\frac12\le y<x_0$. -/
theorem poincare_DJr_nonneg {y : ℝ} (hy : 2⁻¹ ≤ y) (hyx : y < x₀) : 0 ≤ DJr y := by
  have hw := w₀_mem
  have hw0 := poincare_w₀_pos
  have hx0 : x₀ = 1 - w₀ / 2 := rfl
  unfold DJr
  refine mul_nonneg (by positivity) (gInv_pos ⟨?_, ?_⟩).le
  · rw [lt_div_iff₀ hw0]; linarith
  · rw [div_lt_one hw0]; linarith [hw.1]

/-! ### The function $G_{P,\beta}$ and the lower bound of (7.3) -/

/-- The formula $G_{P,\beta}(x)=2^{-2\beta}(b_\beta(x)+b_\beta(1-x))-x^{2\beta}(1-x)-
x(1-x)^{2\beta}$ ([DIR], Proposition 7.1); definitionally `Auto.DIR.G_P` of the main file. -/
noncomputable def GPf (β x : ℝ) : ℝ :=
  2 ^ (-(2 * β)) * (b β x + b β (1 - x)) - x ^ (2 * β) * (1 - x) - x * (1 - x) ^ (2 * β)

/-- [DIR], proof of Proposition 7.1, Cases I and II: for $x\in(0,\frac14]$ and
$\beta\in[\frac12,\beta_0]$,
$G_{P,\beta}(x)\ge2^{-2\beta_0}(L_{1/2}(x)+J(1-x))-2x(1-x)$. -/
theorem poincare_GPf_ge (β : ℝ) (hβ : β ∈ Icc 2⁻¹ β₀) {x : ℝ} (hx : x ∈ Ioc (0 : ℝ) 4⁻¹) :
    2 ^ (-(2 * β₀)) * (L 2⁻¹ x + J (1 - x)) - 2 * x * (1 - x) ≤ GPf β x := by
  obtain ⟨hβ1, hβ2⟩ := hβ
  obtain ⟨hx0, hx1⟩ := hx
  have hb1 : b β x = L β x := by rw [b, ite_eq_left hx1]
  have hb2 : b β (1 - x) = J (1 - x) := by
    rw [b, ite_eq_right (by norm_num; linarith), ite_eq_right (by norm_num; linarith)]
  have hK : (2 : ℝ) ^ (-(2 * β₀)) ≤ 2 ^ (-(2 * β)) :=
    rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
  have hK0 : 0 ≤ (2 : ℝ) ^ (-(2 * β₀)) := by positivity
  have hlog : 1 ≤ log₂ x⁻¹ := by
    rw [le_logb_iff_rpow_le one_lt_two (by positivity), rpow_one]
    have := (le_inv_comm₀ (by norm_num) hx0).2 hx1
    linarith
  have hL : L 2⁻¹ x ≤ L β x :=
    mul_le_mul_of_nonneg_left (rpow_le_rpow_of_exponent_le hlog hβ1) hx0.le
  have hL0 : 0 ≤ L 2⁻¹ x := L_nonneg ⟨hx0.le, by linarith⟩
  have hJ0 : 0 ≤ J (1 - x) := poincare_J_nonneg ⟨by linarith, by linarith⟩
  have hp1 : x ^ (2 * β) ≤ x := by
    simpa using rpow_le_rpow_of_exponent_ge hx0 (by linarith) (by linarith : (1 : ℝ) ≤ 2 * β)
  have hp2 : (1 - x) ^ (2 * β) ≤ 1 - x := by
    simpa using rpow_le_rpow_of_exponent_ge (by linarith : (0 : ℝ) < 1 - x) (by linarith)
      (by linarith : (1 : ℝ) ≤ 2 * β)
  rw [GPf, hb1, hb2]
  have hA : 2 ^ (-(2 * β₀)) * (L 2⁻¹ x + J (1 - x)) ≤ 2 ^ (-(2 * β)) * (L β x + J (1 - x)) :=
    mul_le_mul hK (by linarith) (by positivity) (by positivity)
  nlinarith [mul_le_mul_of_nonneg_right hp1 (by linarith : 0 ≤ 1 - x),
    mul_le_mul_of_nonneg_left hp2 hx0.le]

/-- The tight lower bound of [DIR], (7.3):
$\underline{g_{P,2}}(\underline x,\overline x)=2^{-2\beta_0}(L_{1/2}(\underline x)+
J(1-\underline x))-2\overline x(1-\underline x)$. -/
noncomputable def gP2lo (xl xu : ℝ) : ℝ :=
  2 ^ (-(2 * β₀)) * (L 2⁻¹ xl + J (1 - xl)) - 2 * xu * (1 - xl)

/-- [DIR], proof of Proposition 7.1, Case II: $\underline{g_{P,2}}$ is a lower bound of
$G_{P,\beta}$ on $[\frac1{64},\frac14]$ for every $\beta\in[\frac12,\beta_0]$ (since
$L_{1/2}$ is increasing and $x\mapsto J(1-x)$ is increasing there, as $x_0<\frac34$). -/
theorem gP2lo_le (β : ℝ) (hβ : β ∈ Icc 2⁻¹ β₀) {xl xu x : ℝ} (h1 : 64⁻¹ ≤ xl) (hxl : xl ≤ x)
    (hxu : x ≤ xu) (h2 : xu ≤ 4⁻¹) : gP2lo xl xu ≤ GPf β x := by
  refine le_trans ?_ (poincare_GPf_ge β hβ ⟨by linarith, by linarith⟩)
  have hLm := poincare_L_half_monotoneOn ⟨by linarith, by linarith⟩ ⟨by linarith, by linarith⟩
    hxl
  have hx0 := poincare_x₀_le
  have hJm : J (1 - xl) ≤ J (1 - x) :=
    poincare_J_antitoneOn ⟨by linarith, by linarith⟩ ⟨by linarith, by linarith⟩ (by linarith)
  have hK0 : 0 ≤ (2 : ℝ) ^ (-(2 * β₀)) := by positivity
  unfold gP2lo
  nlinarith [mul_le_mul_of_nonneg_left (add_le_add hLm hJm) hK0,
    mul_le_mul hxu (by linarith : 1 - x ≤ 1 - xl) (by linarith) (by linarith)]

/-! ### The derivative of $G_{P,\beta}$ on $[\frac14,\frac12]$ and the lower bound of (7.4) -/

/-- The branch $2^{-2\beta}(Q_\beta(t)+J_{w_0}(1-t))-t^{2\beta}(1-t)-t(1-t)^{2\beta}$ of
$G_{P,\beta}$ used on $[\frac14,\frac12]$. -/
noncomputable def GPg (β t : ℝ) : ℝ :=
  2 ^ (-(2 * β)) * (Q β t + gJw w₀ (1 - t)) - t ^ (2 * β) * (1 - t) - t * (1 - t) ^ (2 * β)

/-- The derivative of `GPg β` (see `poincare_hasDerivAt_GPg`). -/
noncomputable def GPd (β t : ℝ) : ℝ :=
  2 ^ (-(2 * β)) * (Q1f β t - DJr (1 - t)) - (2 * β * t ^ (2 * β - 1) * (1 - t) - t ^ (2 * β)) -
    ((1 - t) ^ (2 * β) - t * (2 * β * (1 - t) ^ (2 * β - 1)))

/-- $G_{P,\beta}=$ `GPg β` on $[\frac14,\frac12]$ (using $L_\beta(\frac14)=Q_\beta(\frac14)$,
$Q_\beta(\frac12)=J(\frac12)=\frac12$ and (3.4)). -/
theorem poincare_GPf_eq_GPg (β : ℝ) {t : ℝ} (ht : t ∈ Icc (4⁻¹ : ℝ) 2⁻¹) :
    GPf β t = GPg β t := by
  have hw := w₀_mem
  have hb1 : b β t = Q β t := by
    rw [b]
    split_ifs with h h'
    · rw [le_antisymm h ht.1, poincare_L_quarter]
    · rfl
    · exact absurd ht.2 h'
  have hb2 : b β (1 - t) = gJw w₀ (1 - t) := by
    rw [b, ite_eq_right (by norm_num; linarith [ht.2])]
    split_ifs with h
    · have : t = 2⁻¹ := by linarith [ht.2]
      subst this
      rw [show (1 : ℝ) - 2⁻¹ = 2⁻¹ by norm_num, poincare_Q_half, ← J_eq_gJw ⟨le_rfl, by norm_num⟩,
        (J_half_eq_L_half β).1]
    · exact J_eq_gJw ⟨by linarith [ht.2], by linarith [ht.1]⟩
  rw [GPf, GPg, hb1, hb2]

/-- `GPg β` has derivative `GPd β t` at $t\in(0,w_0)$. -/
theorem poincare_hasDerivAt_GPg (β : ℝ) {t : ℝ} (ht : t ∈ Ioo 0 w₀) :
    HasDerivAt (GPg β) (GPd β t) t := by
  have hw := w₀_mem
  have hw0 := poincare_w₀_pos
  have ht1 : 0 < 1 - t := by linarith [ht.2, hw.2]
  have hJ := (hasDerivAt_gJw hw0 (x := 1 - t) ⟨by linarith [ht.2], by linarith [ht.1]⟩).comp t
    ((hasDerivAt_id t).const_sub 1)
  have hp1 : HasDerivAt (fun x : ℝ ↦ x ^ (2 * β)) (2 * β * t ^ (2 * β - 1)) t :=
    hasDerivAt_rpow_const (Or.inl ht.1.ne')
  have hp2 : HasDerivAt (fun x : ℝ ↦ (1 - x) ^ (2 * β))
      (-1 * (2 * β) * (1 - t) ^ (2 * β - 1)) t := by
    have := ((hasDerivAt_id t).const_sub 1).rpow_const (p := 2 * β) (Or.inl ht1.ne')
    simpa using this
  have h := ((((hasDerivAt_Q β t).add hJ).const_mul ((2 : ℝ) ^ (-(2 * β)))).sub
    (hp1.mul ((hasDerivAt_id t).const_sub 1))).sub ((hasDerivAt_id t).mul hp2)
  refine h.congr_deriv ?_
  simp only [GPd, DJr, id]
  rw [div_eq_inv_mul]
  ring

/-- [DIR], proof of Proposition 7.1, Case III: for $x\in[\frac14,\frac12]$,
$-\partial_xG_{P,\beta}(x)$ (derivative within $[\frac14,\frac12]$) equals
$-2^{-2\beta}Q_\beta'(x)+2^{-2\beta}J'(1-x)+2\beta x^{2\beta-1}(1-x)-x^{2\beta}+(1-x)^{2\beta}
-2\beta x(1-x)^{2\beta-1}$ (`-GPd β x`). -/
theorem poincare_derivWithin_GPf (β : ℝ) {x : ℝ} (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) :
    derivWithin (GPf β) (Icc 4⁻¹ 2⁻¹) x = GPd β x := by
  have hw := w₀_mem
  have hd := poincare_hasDerivAt_GPg β (t := x) ⟨by linarith [hx.1], by linarith [hx.2, hw.1]⟩
  rw [derivWithin_congr (fun t ht ↦ poincare_GPf_eq_GPg β ht) (poincare_GPf_eq_GPg β hx),
    hd.hasDerivWithinAt.derivWithin (uniqueDiffOn_Icc (by norm_num) x hx)]

/-- The tight lower bound of [DIR], (7.4):
$\underline{g_{P,3}}(\underline x,\overline x)=-\frac12Q'_{1/2}(\underline x)
+2^{-2\beta_0}J'(1-\underline x)\mathbf 1_{1-\underline x<x_0}
-\frac12\overline{|J'|}(1-\overline x,1-\underline x)\mathbf 1_{\text{not }1-\underline x<x_0}
+\underline x^{2\beta_0-1}(1-\overline x)-\overline x+(1-\overline x)^{2\beta_0}
-2\beta_0\overline x$, where $\overline{|J'|}(1-\overline x,1-\underline x)=
\max(|J'(1-\underline x)|,|J'(1-\overline x)|)$ bounds $|J'|$ on $[1-\overline x,1-\underline x]$
($J'$ is monotone). -/
noncomputable def gP3lo (xl xu : ℝ) : ℝ :=
  -(2⁻¹ * Q1f 2⁻¹ xl) +
    (if 1 - xl < x₀ then 2 ^ (-(2 * β₀)) * DJr (1 - xl)
      else -(2⁻¹ * max (abs (DJr (1 - xl))) (abs (DJr (1 - xu))))) +
    xl ^ (2 * β₀ - 1) * (1 - xu) + -xu + (1 - xu) ^ (2 * β₀) + -(2 * β₀ * xu)

/-- [DIR], proof of Proposition 7.1, Case III: $\underline{g_{P,3}}$ is a lower bound of
$g_{P,3,\beta}=-\partial_xG_{P,\beta}$ on $[\frac14,\frac12]$ for every
$\beta\in[\frac12,\beta_0]$ ($J'(1-x)$ is increasing in $x$, $Q'_\beta(x)$ is decreasing in $x$,
positive and decreasing in $\beta$, $2^{-2\beta}\in[2^{-2\beta_0},\frac12]$). -/
theorem gP3lo_le (β : ℝ) (hβ : β ∈ Icc 2⁻¹ β₀) {xl xu x : ℝ} (h1 : 4⁻¹ ≤ xl) (hxl : xl ≤ x)
    (hxu : x ≤ xu) (h2 : xu ≤ 2⁻¹) : gP3lo xl xu ≤ -GPd β x := by
  have hw := w₀_mem
  have hβ0 : β₀ = 0.50057 := rfl
  obtain ⟨hQ0, hQ1, hQ2⟩ := poincare_Q1f_bounds hβ h1 hxl (by linarith)
  have hK : (2 : ℝ) ^ (-(2 * β₀)) ≤ 2 ^ (-(2 * β)) :=
    rpow_le_rpow_of_exponent_le (by norm_num) (by linarith [hβ.2])
  have hKh : (2 : ℝ) ^ (-(2 * β)) ≤ 2⁻¹ := by
    have := rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2)
      (by linarith [hβ.1] : -(2 * β) ≤ -1)
    simpa [rpow_neg_one] using this
  have hK0 : 0 ≤ (2 : ℝ) ^ (-(2 * β)) := by positivity
  -- the term with `Q'`
  have hTQ : 2 ^ (-(2 * β)) * Q1f β x ≤ 2⁻¹ * Q1f 2⁻¹ xl :=
    (mul_le_mul_of_nonneg_right hKh hQ0).trans
      (mul_le_mul_of_nonneg_left (hQ1.trans hQ2) (by norm_num))
  -- the term with `J'`
  have hD1 : DJr (1 - xl) ≤ DJr (1 - x) :=
    poincare_DJr_anti (by linarith [hw.1]) (by linarith) (by linarith)
  have hD2 : DJr (1 - x) ≤ DJr (1 - xu) :=
    poincare_DJr_anti (by linarith [hw.1]) (by linarith) (by linarith)
  have hTD : (if 1 - xl < x₀ then 2 ^ (-(2 * β₀)) * DJr (1 - xl)
      else -(2⁻¹ * max (abs (DJr (1 - xl))) (abs (DJr (1 - xu))))) ≤ 2 ^ (-(2 * β)) * DJr (1 - x) := by
    split_ifs with hc
    · have h0 := poincare_DJr_nonneg (by linarith) hc
      exact (mul_le_mul_of_nonneg_right hK h0).trans (mul_le_mul_of_nonneg_left hD1 hK0)
    · have habs := abs_le_max_abs_abs hD1 hD2
      have := neg_abs_le (DJr (1 - x))
      nlinarith [mul_le_mul_of_nonneg_left this hK0,
        mul_le_mul hKh habs (abs_nonneg _) (by norm_num)]
  -- the power terms
  have hx0 : 0 < x := by linarith
  have hx1 : x ≤ 1 := by linarith
  have hy0 : 0 < 1 - x := by linarith
  have hyu : 0 ≤ 1 - xu := by linarith
  have hP1 : xl ^ (2 * β₀ - 1) * (1 - xu) ≤ 2 * β * x ^ (2 * β - 1) * (1 - x) := by
    have e1 : xl ^ (2 * β₀ - 1) ≤ x ^ (2 * β₀ - 1) :=
      rpow_le_rpow (by linarith) hxl (by rw [hβ0]; norm_num)
    have e2 : x ^ (2 * β₀ - 1) ≤ x ^ (2 * β - 1) :=
      rpow_le_rpow_of_exponent_ge hx0 hx1 (by linarith [hβ.2])
    have e3 : 0 ≤ x ^ (2 * β - 1) := rpow_nonneg hx0.le _
    have e4 : 0 ≤ xl ^ (2 * β₀ - 1) := rpow_nonneg (by linarith) _
    have e5 : x ^ (2 * β - 1) * (1 - x) ≤ 2 * β * (x ^ (2 * β - 1) * (1 - x)) :=
      le_mul_of_one_le_left (mul_nonneg e3 hy0.le) (by linarith [hβ.1])
    have e6 : xl ^ (2 * β₀ - 1) * (1 - xu) ≤ x ^ (2 * β - 1) * (1 - x) :=
      mul_le_mul (e1.trans e2) (by linarith) hyu e3
    linarith
  have hP2 : x ^ (2 * β) ≤ xu := by
    have := rpow_le_rpow_of_exponent_ge hx0 hx1 (by linarith [hβ.1] : (1 : ℝ) ≤ 2 * β)
    rw [rpow_one] at this
    linarith
  have hP3 : (1 - xu) ^ (2 * β₀) ≤ (1 - x) ^ (2 * β) :=
    (rpow_le_rpow hyu (by linarith) (by rw [hβ0]; norm_num)).trans
      (rpow_le_rpow_of_exponent_ge hy0 (by linarith) (by linarith [hβ.2]))
  have hP4 : 2 * β * x * (1 - x) ^ (2 * β - 1) ≤ 2 * β₀ * xu := by
    have e1 : (1 - x) ^ (2 * β - 1) ≤ 1 := rpow_le_one hy0.le (by linarith) (by linarith [hβ.1])
    have e2 : 0 ≤ (1 - x) ^ (2 * β - 1) := rpow_nonneg hy0.le _
    have e3 : 0 ≤ 2 * β * x := by nlinarith [hβ.1]
    have e4 : 2 * β * x ≤ 2 * β₀ * xu := by nlinarith [hβ.2, hβ.1]
    nlinarith [mul_le_mul_of_nonneg_left e1 e3]
  unfold gP3lo GPd
  nlinarith

/-- $b_\beta=Q_\beta$ on $[\frac14,\frac12]$ (using $L_\beta(\frac14)=Q_\beta(\frac14)$). -/
theorem poincare_b_eq_Q (β : ℝ) {t : ℝ} (ht : t ∈ Icc (4⁻¹ : ℝ) 2⁻¹) : b β t = Q β t := by
  rw [b]
  split_ifs with h h'
  · rw [le_antisymm h ht.1, poincare_L_quarter]
  · rfl
  · exact absurd ht.2 h'

/-- $b_\beta(1-t)=J(1-t)$ for $t\in[0,\frac12]$ (using $Q_\beta(\frac12)=J(\frac12)=\frac12$). -/
theorem poincare_b_one_sub (β : ℝ) {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 2⁻¹) :
    b β (1 - t) = J (1 - t) := by
  rw [b, ite_eq_right (by norm_num; linarith [ht.2])]
  split_ifs with h
  · have : t = 2⁻¹ := by linarith [ht.2]
    subst this
    rw [show (1 : ℝ) - 2⁻¹ = 2⁻¹ by norm_num, poincare_Q_half, (J_half_eq_L_half β).1]
  · rfl

/-- A function whose derivative within $[a,b]$ satisfies $-f'>0$ at every point of $[a,b]$ is
decreasing on $[a,b]$ (the derivative is nonzero, so $f$ is differentiable within $[a,b]$). -/
theorem poincare_antitoneOn_of_derivWithin {f : ℝ → ℝ} {a b : ℝ}
    (h : ∀ x ∈ Icc a b, 0 < -derivWithin f (Icc a b) x) : AntitoneOn f (Icc a b) := by
  have hd : ∀ x ∈ Icc a b, DifferentiableWithinAt ℝ f (Icc a b) x := fun x hx ↦ by
    by_contra hnd
    have := h x hx
    rw [derivWithin_zero_of_not_differentiableWithinAt hnd] at this
    simp at this
  refine antitoneOn_of_deriv_nonpos (convex_Icc a b) (fun x hx ↦ (hd x hx).continuousWithinAt)
    ?_ ?_
  · rw [interior_Icc]
    intro x hx
    exact ((hd x (Ioo_subset_Icc_self hx)).differentiableAt
      (Icc_mem_nhds hx.1 hx.2)).differentiableWithinAt
  · rw [interior_Icc]
    intro x hx
    have := h x (Ioo_subset_Icc_self hx)
