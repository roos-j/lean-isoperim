/-- [DIR], §1.2, after Theorem 1.6: the upper bound follows from Cauchy–Schwarz,
$\mathbf{E}\sqrt{h_A}\le\sqrt{|A|\,\mathbf{E}h_A}$, which gives
$\mathcal{B}_{\frac12}(x)\le\sqrt{x\,\mathcal{B}_1(x)}$ for $x\in\mathcal{Q}$. -/
theorem isoProfile_half_le_sqrt (x : ℝ) (hx : x ∈ 𝒬) : 𝓑 2⁻¹ x ≤ √(x * 𝓑 1 x) := by
  obtain ⟨m, k, hk, rfl⟩ := hx
  obtain ⟨A0, hA0⟩ := exists_set_dens m k hk
  have hEnn : ∀ (β : ℝ) (n : ℕ) (A : Set ({0,1}^n)), 0 ≤ 𝐄 h A ^ β := by
    intro β n A
    simp only [expect, smul_eq_mul]
    exact mul_nonneg (by positivity) (Finset.sum_nonneg fun z _ ↦ by
      rw [Pi.pow_apply]; exact Real.rpow_nonneg (h_nonneg A z) _)
  have hbdd : ∀ β : ℝ, BddBelow {v : ℝ | ∃ n : ℕ, 1 ≤ n ∧ ∃ A : Set ({0,1}^n),
      ｜A｜ = (k : ℝ) / 2 ^ m ∧ v = 𝐄 h A ^ β} := by
    intro β
    refine ⟨0, ?_⟩
    rintro v ⟨n, -, A, -, rfl⟩
    exact hEnn β n A
  have hB0 : 0 ≤ 𝓑 2⁻¹ ((k : ℝ) / 2 ^ m) := by
    refine Real.sInf_nonneg fun v hv ↦ ?_
    obtain ⟨n, -, A, -, rfl⟩ := hv
    exact hEnn _ n A
  -- Cauchy–Schwarz: $(\mathbf{E}\sqrt{h_A})^2\le|A|\,\mathbf{E}h_A$
  have hCS : ∀ (n : ℕ) (A : Set ({0,1}^n)),
      (𝐄 h A ^ (2⁻¹ : ℝ)) ^ 2 ≤ ｜A｜ * 𝐄 h A ^ (1 : ℝ) := by
    intro n A
    have hcs := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (𝟏 A) (fun z ↦ √(h A z))
    have e1 : ∀ z, 𝟏 A z * √(h A z) = h A z ^ (2⁻¹ : ℝ) := by
      intro z
      rw [Real.sqrt_eq_rpow, one_div]
      by_cases hz : z ∈ A
      · simp [ind, hz]
      · simp [ind, hz, h, Real.zero_rpow (by norm_num : (2⁻¹ : ℝ) ≠ 0)]
    have e2 : ∀ z, 𝟏 A z ^ 2 = 𝟏 A z := by
      intro z; by_cases hz : z ∈ A <;> simp [ind, hz]
    have e3 : ∀ z, √(h A z) ^ 2 = h A z := fun z ↦ Real.sq_sqrt (h_nonneg A z)
    simp only [e1, e2, e3] at hcs
    simp only [dens, expect, smul_eq_mul, Pi.pow_apply, Real.rpow_one]
    calc ((2⁻¹ : ℝ) ^ n * ∑ z, h A z ^ (2⁻¹ : ℝ)) ^ 2
        = ((2⁻¹ : ℝ) ^ n) ^ 2 * (∑ z, h A z ^ (2⁻¹ : ℝ)) ^ 2 := by ring
      _ ≤ ((2⁻¹ : ℝ) ^ n) ^ 2 * ((∑ z, 𝟏 A z) * ∑ z, h A z) :=
          mul_le_mul_of_nonneg_left hcs (by positivity)
      _ = ((2⁻¹ : ℝ) ^ n * ∑ z, 𝟏 A z) * ((2⁻¹ : ℝ) ^ n * ∑ z, h A z) := by ring
  have key : ∀ v ∈ {v : ℝ | ∃ n : ℕ, 1 ≤ n ∧ ∃ A : Set ({0,1}^n),
      ｜A｜ = (k : ℝ) / 2 ^ m ∧ v = 𝐄 h A ^ (1 : ℝ)},
      𝓑 2⁻¹ ((k : ℝ) / 2 ^ m) ^ 2 ≤ (k : ℝ) / 2 ^ m * v := by
    rintro v ⟨n, hn, A, hA, rfl⟩
    have h1 : 𝓑 2⁻¹ ((k : ℝ) / 2 ^ m) ≤ 𝐄 h A ^ (2⁻¹ : ℝ) :=
      csInf_le (hbdd _) ⟨n, hn, A, hA, rfl⟩
    calc 𝓑 2⁻¹ ((k : ℝ) / 2 ^ m) ^ 2 ≤ (𝐄 h A ^ (2⁻¹ : ℝ)) ^ 2 := pow_le_pow_left₀ hB0 h1 2
      _ ≤ ｜A｜ * 𝐄 h A ^ (1 : ℝ) := hCS n A
      _ = _ := by rw [hA]
  have hne : ({v : ℝ | ∃ n : ℕ, 1 ≤ n ∧ ∃ A : Set ({0,1}^n),
      ｜A｜ = (k : ℝ) / 2 ^ m ∧ v = 𝐄 h A ^ (1 : ℝ)}).Nonempty :=
    ⟨_, m + 1, by omega, A0, hA0, rfl⟩
  suffices hsq : 𝓑 2⁻¹ ((k : ℝ) / 2 ^ m) ^ 2 ≤ (k : ℝ) / 2 ^ m * 𝓑 1 ((k : ℝ) / 2 ^ m) by
    calc 𝓑 2⁻¹ ((k : ℝ) / 2 ^ m) = √(𝓑 2⁻¹ ((k : ℝ) / 2 ^ m) ^ 2) := (Real.sqrt_sq hB0).symm
      _ ≤ _ := Real.sqrt_le_sqrt hsq
  rcases Nat.eq_zero_or_pos k with rfl | hk0
  · obtain ⟨v, hv⟩ := hne
    have := key v hv
    simp only [Nat.cast_zero, zero_div, zero_mul] at this ⊢
    exact this
  · have hx0 : (0 : ℝ) < (k : ℝ) / 2 ^ m := by positivity
    have : 𝓑 2⁻¹ ((k : ℝ) / 2 ^ m) ^ 2 / ((k : ℝ) / 2 ^ m) ≤ 𝓑 1 ((k : ℝ) / 2 ^ m) :=
      le_csInf hne fun v hv ↦ by rw [div_le_iff₀ hx0, mul_comm]; exact key v hv
    rwa [div_le_iff₀ hx0, mul_comm] at this

/-- [DIR], §1.2, after Theorem 1.6: the characterization (1.3) of $\mathcal{B}_1$ implies
$\mathcal{B}_1(x)\sim x\log_2(1/x)$ as $x\to0^+$ (along $x\in\mathcal{Q}$). -/
theorem isoProfile_one_asymp :
    Tendsto (fun x ↦ 𝓑 1 x / (x * log₂ x⁻¹)) (𝓝[𝒬 ∩ Set.Ioi 0] 0) (𝓝 1) := by
  have hF : 𝓝[𝒬 ∩ Set.Ioi 0] (0 : ℝ) ≤ 𝓝[>] 0 := nhdsWithin_mono _ Set.inter_subset_right
  have hℓ : Tendsto (fun x : ℝ ↦ log₂ x⁻¹) (𝓝[>] 0) atTop :=
    (tendsto_logb_atTop (by norm_num : (1 : ℝ) < 2)).comp tendsto_inv_nhdsGT_zero
  have hg : Tendsto (fun x : ℝ ↦ 1 + 2 * (log₂ x⁻¹)⁻¹) (𝓝[>] 0) (𝓝 1) := by
    have := ((tendsto_inv_atTop_zero.comp hℓ).const_mul 2).const_add 1
    simpa using this
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds (hg.mono_left hF) ?_ ?_
  · filter_upwards [eventually_dyadic_small] with x ⟨hq, hx0, hx2⟩
    have hpos : 0 < x * log₂ x⁻¹ := mul_pos hx0 (by linarith [one_le_logb_inv hx0 hx2])
    rw [le_div_iff₀ hpos, one_mul]
    exact isoProfile_one_ge x hq hx2
  · filter_upwards [eventually_dyadic_small] with x ⟨hq, hx0, hx2⟩
    have hl := one_le_logb_inv hx0 hx2
    have hpos : 0 < x * log₂ x⁻¹ := mul_pos hx0 (by linarith)
    rw [div_le_iff₀ hpos]
    calc 𝓑 1 x ≤ x * (log₂ x⁻¹ + 2) := isoProfile_one_le x hq hx0
      _ = (1 + 2 * (log₂ x⁻¹)⁻¹) * (x * log₂ x⁻¹) := by
          linear_combination (-2 * x) * inv_mul_cancel₀ (show log₂ x⁻¹ ≠ 0 by linarith)

/-- **Theorem 1.6** ([DIR]). For all $A\subset\{0,1\}^n$,
$$\mathbf{E}\sqrt{h_A}\ge|A|\sqrt{\log_2(1/|A|)+1}-|A| \tag{1.4}$$
and as a consequence,
$$\mathcal{B}_{\frac12}(x)\sim x\sqrt{\log_2(1/x)}\quad\text{as } x\to0^+,$$
where $f(x)\sim g(x)$ as $x\to x_*$ means $\lim_{x\to x_*}\frac{f(x)}{g(x)}=1$ (the limit is taken
along $x\in\mathcal{Q}$, where $\mathcal{B}_{\frac12}$ is defined). -/
theorem thm_1_6 :
    (∀ (n : ℕ), 1 ≤ n → ∀ A : Set ({0,1}^n),
      𝐄 (fun x ↦ √(h A x)) ≥ ｜A｜ * √(log₂ ｜A｜⁻¹ + 1) - ｜A｜) ∧
    Tendsto (fun x ↦ 𝓑 2⁻¹ x / (x * √(log₂ x⁻¹))) (𝓝[𝒬 ∩ Set.Ioi 0] 0) (𝓝 1) := by
  have part1 : ∀ (n : ℕ), 1 ≤ n → ∀ A : Set ({0,1}^n),
      𝐄 (fun x ↦ √(h A x)) ≥ ｜A｜ * √(log₂ ｜A｜⁻¹ + 1) - ｜A｜ := by
    intro n hn A
    obtain ⟨-, h1, h2⟩ := proof_thm_1_6_chain n hn A
    rcases (dens_mem_Icc A).1.eq_or_lt with h0 | hpos
    · rw [← h0]
      have := expect_le_expect (f := fun _ : {0,1}^n ↦ (0 : ℝ)) (g := fun x ↦ √(h A x))
        fun z ↦ Real.sqrt_nonneg _
      simpa [expect] using this
    · have hL : L 2⁻¹ (2⁻¹ * ｜A｜) = 2⁻¹ * ｜A｜ * √(log₂ ｜A｜⁻¹ + 1) := by
        rw [L, mul_inv, inv_inv, Real.logb_mul (by norm_num) (inv_ne_zero hpos.ne'),
          Real.logb_self_eq_one (by norm_num), Real.sqrt_eq_rpow, one_div, add_comm]
      rw [hL] at h1
      linarith
  refine ⟨part1, ?_⟩
  have hlow : ∀ x ∈ 𝒬, x * √(log₂ x⁻¹ + 1) - x ≤ 𝓑 2⁻¹ x := by
    rintro x ⟨m, k, hk, rfl⟩
    obtain ⟨A, hA⟩ := exists_set_dens m k hk
    refine le_csInf ⟨_, m + 1, by omega, A, hA, rfl⟩ ?_
    rintro v ⟨n, hn, A', hA', rfl⟩
    have h1 := part1 n hn A'
    rw [hA'] at h1
    have e : 𝐄 (h A' ^ (2⁻¹ : ℝ)) = 𝐄 (fun x ↦ √(h A' x)) := by
      congr 1; funext z; rw [Pi.pow_apply, Real.sqrt_eq_rpow, one_div]
    rw [e]; exact h1
  have hF : 𝓝[𝒬 ∩ Set.Ioi 0] (0 : ℝ) ≤ 𝓝[>] 0 := nhdsWithin_mono _ Set.inter_subset_right
  have hℓ : Tendsto (fun x : ℝ ↦ log₂ x⁻¹) (𝓝[>] 0) atTop :=
    (tendsto_logb_atTop (by norm_num : (1 : ℝ) < 2)).comp tendsto_inv_nhdsGT_zero
  have hg1 : Tendsto (fun x : ℝ ↦ 1 - (√(log₂ x⁻¹))⁻¹) (𝓝[𝒬 ∩ Set.Ioi 0] 0) (𝓝 1) := by
    have := ((tendsto_inv_atTop_zero.comp (Real.tendsto_sqrt_atTop.comp hℓ)).const_sub 1)
    simpa using this.mono_left hF
  have hg2 : Tendsto (fun x : ℝ ↦ √(𝓑 1 x / (x * log₂ x⁻¹))) (𝓝[𝒬 ∩ Set.Ioi 0] 0) (𝓝 1) := by
    have := (Real.continuous_sqrt.tendsto 1).comp isoProfile_one_asymp
    rw [Real.sqrt_one] at this
    exact this
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' hg1 hg2 ?_ ?_
  · filter_upwards [eventually_dyadic_small] with x ⟨hq, hx0, hx2⟩
    have hl := one_le_logb_inv hx0 hx2
    have hs : 0 < √(log₂ x⁻¹) := Real.sqrt_pos.2 (by linarith)
    have hpos : 0 < x * √(log₂ x⁻¹) := mul_pos hx0 hs
    rw [le_div_iff₀ hpos]
    have h1 := hlow x hq
    have h2 : √(log₂ x⁻¹) ≤ √(log₂ x⁻¹ + 1) := Real.sqrt_le_sqrt (by linarith)
    have e : (1 - (√(log₂ x⁻¹))⁻¹) * (x * √(log₂ x⁻¹)) = x * √(log₂ x⁻¹) - x := by
      linear_combination (-x) * inv_mul_cancel₀ hs.ne'
    rw [e]
    nlinarith
