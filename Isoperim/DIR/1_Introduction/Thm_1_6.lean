      rw [mul_pow, Real.sq_sqrt (by linarith), div_mul_eq_mul_div,
        eq_div_iff (by positivity)]
      ring
    calc 𝓑 2⁻¹ x ≤ √(x * 𝓑 1 x) := isoProfile_half_le_sqrt x hq
