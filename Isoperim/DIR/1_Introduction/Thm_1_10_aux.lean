/-- Concavity of $J$ on $[\frac12,1]$: for $\frac12\le a\le y\le c\le1$, $a<c$,
$J(y)\ge\frac{(c-y)J(a)+(y-a)J(c)}{c-a}$ (since $J=J_{w_0}$ and $I$ is concave). -/
theorem J_ge_chord {a c y : ℝ} (ha : 2⁻¹ ≤ a) (hay : a ≤ y) (hyc : y ≤ c) (hc : c ≤ 1)
    (hac : a < c) : ((c - y) * J a + (y - a) * J c) / (c - a) ≤ J y := by
  have hw := w₀_pos
  have hw2 : (2⁻¹ : ℝ) ≤ w₀ := by linarith [w₀_mem.1]
  have hmem : ∀ t : ℝ, 2⁻¹ ≤ t → t ≤ 1 → w₀⁻¹ * (1 - t) ∈ Icc (0 : ℝ) 1 := fun t h1 h2 ↦ by
    refine ⟨mul_nonneg (inv_nonneg.2 hw.le) (by linarith), ?_⟩
    rw [inv_mul_le_iff₀ hw]
    linarith
  rw [J_eq_gJw_w₀ ⟨ha, by linarith⟩, J_eq_gJw_w₀ ⟨by linarith, hc⟩,
    J_eq_gJw_w₀ ⟨by linarith, by linarith⟩]
  unfold gJw
  have hca : 0 < c - a := sub_pos.2 hac
  set θ := (c - y) / (c - a) with hθ
  have hθ0 : 0 ≤ θ := div_nonneg (by linarith) hca.le
  have hθ1 : 0 ≤ 1 - θ := by
    rw [hθ, one_sub_div hca.ne']; exact div_nonneg (by linarith) hca.le
  have hcon := strictConcaveOn_gProf.concaveOn.2 (hmem a ha (by linarith))
    (hmem c (by linarith) hc) hθ0 hθ1 (by ring)
  simp only [smul_eq_mul] at hcon
  have hm : θ * (w₀⁻¹ * (1 - a)) + (1 - θ) * (w₀⁻¹ * (1 - c)) = w₀⁻¹ * (1 - y) := by
    rw [hθ]; field_simp; ring
  rw [hm] at hcon
  have hpos : 0 < √2 * w₀ := by positivity
  have hc1 : (c - y) = θ * (c - a) := by rw [hθ]; field_simp
  have hc2 : (y - a) = (1 - θ) * (c - a) := by rw [hθ]; field_simp; ring
  rw [div_le_iff₀ hca, hc1, hc2]
  have := mul_le_mul_of_nonneg_left hcon hpos.le
  nlinarith [mul_le_mul_of_nonneg_right this hca.le]

/-- The chord bound with lower bounds $J(a)\ge\ell_a$, $J(c)\ge\ell_c$, in the form
$(c-y)\ell_a+(y-a)\ell_c\le(c-a)J(y)$. -/
theorem J_ge_chord_lb {a c y la lc : ℝ} (ha : 2⁻¹ ≤ a) (hay : a ≤ y) (hyc : y ≤ c) (hc : c ≤ 1)
    (hac : a < c) (hla : la ≤ J a) (hlc : lc ≤ J c) :
    (c - y) * la + (y - a) * lc ≤ (c - a) * J y := by
  have h := J_ge_chord ha hay hyc hc hac
  rw [div_le_iff₀ (sub_pos.2 hac)] at h
  nlinarith [mul_le_mul_of_nonneg_left hla (sub_nonneg.2 hyc),
    mul_le_mul_of_nonneg_left hlc (sub_nonneg.2 hay)]

