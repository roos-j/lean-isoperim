/-- $L_{\beta_0}(x)\ge cx$ for $0\le x\le t\le\frac12$ and $c^2\le\log_2(1/t)$, $c\ge0$. -/
theorem L_β₀_ge_mul {x t c : ℝ} (hx : 0 ≤ x) (hxt : x ≤ t) (ht : t ≤ 2⁻¹) (hc : 0 ≤ c)
