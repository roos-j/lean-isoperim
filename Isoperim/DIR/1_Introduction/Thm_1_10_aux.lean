/-! ### Interpolation in $\beta$ -/

/-- Convexity of $\beta\mapsto r^{2\beta}$: for $r\ge0$ and $t\in[0,1]$,
$r^{2((1-t)\beta_0+t)}\le(1-t)r^{2\beta_0}+tr^2$. -/
theorem rpow_interp_le {r t : ℝ} (hr : 0 ≤ r) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    r ^ (2 * ((1 - t) * β₀ + t)) ≤ (1 - t) * r ^ (2 * β₀) + t * r ^ (2 : ℝ) := by
  have hβ0 : (0 : ℝ) < β₀ := by norm_num [β₀]
  rcases hr.eq_or_lt with rfl | hpos
  · have h1 : (0 : ℝ) < 2 * ((1 - t) * β₀ + t) := by
      have : (0 : ℝ) ≤ t * (1 - β₀) := mul_nonneg ht0 (by norm_num [β₀])
      nlinarith
    rw [zero_rpow h1.ne', zero_rpow (by positivity), zero_rpow two_ne_zero]
    simp
  · rw [rpow_def_of_pos hpos, rpow_def_of_pos hpos, rpow_def_of_pos hpos]
    have := convexOn_exp.2 (Set.mem_univ (log r * (2 * β₀))) (Set.mem_univ (log r * 2))
      (sub_nonneg.2 ht1) ht0 (by ring)
    simp only [smul_eq_mul] at this
    convert this using 2
    ring

/-- $\mathbf{E}h_A^\beta\le\mathbf{E}h_A^{\beta'}$ for $0<\beta\le\beta'$ ($h_A$ is integer
valued). -/
theorem expect_h_rpow_mono {n : ℕ} (A : Set ({0,1}^n)) {β β' : ℝ} (hβ : 0 < β) (hββ' : β ≤ β') :
    𝐄 (h A ^ β) ≤ 𝐄 (h A ^ β') := by
  refine expect_le_expect fun x ↦ ?_
  simp only [Pi.pow_apply]
  obtain ⟨k, hk⟩ := h_eq_natCast A x
  rw [hk]
  rcases Nat.eq_zero_or_pos k with rfl | hk0
  · simp [zero_rpow hβ.ne', zero_rpow (hβ.trans_le hββ').ne']
  · exact rpow_le_rpow_of_exponent_le (by exact_mod_cast hk0) hββ'

/-- For $x\in[0,1]$ and $\beta_0\le\beta\le1$:
$(1-x)(2x)^{2\beta}+x(2(1-x))^{2\beta}\le b_{\beta_0}(x)+b_{\beta_0}(1-x)$ (Proposition 7.1 at
$\beta_0$, the case $\beta=1$, and convexity in $\beta$). -/
theorem interp_le_b_add_b {x β : ℝ} (hx : x ∈ Icc (0 : ℝ) 1) (hβ0 : β₀ ≤ β) (hβ1 : β ≤ 1) :
    (1 - x) * (2 * x) ^ (2 * β) + x * (2 * (1 - x)) ^ (2 * β) ≤ b β₀ x + b β₀ (1 - x) := by
  have hb1 : β₀ < 1 := by norm_num [β₀]
  set t := (β - β₀) / (1 - β₀) with ht
  have ht0 : 0 ≤ t := div_nonneg (by linarith) (by linarith)
  have ht1 : t ≤ 1 := by rw [ht, div_le_one (by linarith)]; linarith
  have hβt : β = (1 - t) * β₀ + t := by rw [ht]; field_simp; ring
  have hP := prop_7_1 x hx β₀ ⟨by norm_num [β₀], le_rfl⟩
  have h4 := four_mul_le_b_add_b hx
  have hx0 := hx.1
  have hx1 : 0 ≤ 1 - x := by linarith [hx.2]
  have i1 := rpow_interp_le (r := 2 * x) (by linarith) ht0 ht1
  have i2 := rpow_interp_le (r := 2 * (1 - x)) (by linarith) ht0 ht1
  rw [← hβt] at i1 i2
  -- the endpoint $\beta_0$
  have hβ₀' : (1 - x) * (2 * x) ^ (2 * β₀) + x * (2 * (1 - x)) ^ (2 * β₀) ≤
      b β₀ x + b β₀ (1 - x) := by
    unfold G_P at hP
    rw [mul_rpow (by norm_num) hx0, mul_rpow (by norm_num) hx1]
    have h2 : (0 : ℝ) < 2 ^ (2 * β₀) := by positivity
    have e : (2 : ℝ) ^ (-(2 * β₀)) * 2 ^ (2 * β₀) = 1 := by
      rw [← rpow_add two_pos]; simp
    nlinarith [mul_le_mul_of_nonneg_left (show (0 : ℝ) ≤ _ from hP) h2.le]
  -- the endpoint $1$
  have h1' : (1 - x) * (2 * x) ^ (2 : ℝ) + x * (2 * (1 - x)) ^ (2 : ℝ) = 4 * x * (1 - x) := by
    rw [rpow_two, rpow_two]; ring
  have A1 := mul_le_mul_of_nonneg_left i1 hx1
  have A2 := mul_le_mul_of_nonneg_left i2 hx0
  have A3 := mul_le_mul_of_nonneg_left hβ₀' (sub_nonneg.2 ht1)
  have A4 := mul_le_mul_of_nonneg_left (h1'.trans_le h4) ht0
  nlinarith [A1, A2, A3, A4]

