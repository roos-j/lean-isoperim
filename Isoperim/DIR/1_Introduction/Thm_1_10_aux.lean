    logb_le_logb_of_le (by norm_num) (inv_pos.2 (hx0.trans_le hxt)) (inv_anti₀ hx0 hxt)
  have h1 : 1 ≤ logb 2 x⁻¹ := by
    have h2 : (2 : ℝ) ≤ x⁻¹ := by simpa using inv_anti₀ hx0 (hxt.trans ht)
    calc (1 : ℝ) = logb 2 2 := (logb_self_eq_one (by norm_num)).symm
      _ ≤ logb 2 x⁻¹ := logb_le_logb_of_le (by norm_num) (by norm_num) h2
  have h3 : (logb 2 x⁻¹) ^ (2⁻¹ : ℝ) ≤ (logb 2 x⁻¹) ^ β₀ :=
    rpow_le_rpow_of_exponent_le h1 (by norm_num [β₀])
  have h4 : c ≤ (logb 2 x⁻¹) ^ (2⁻¹ : ℝ) := by
    rw [show (logb 2 x⁻¹) ^ (2⁻¹ : ℝ) = √(logb 2 x⁻¹) by rw [sqrt_eq_rpow, one_div],
      le_sqrt hc (by linarith)]
    linarith
  rw [L, mul_comm c]
  exact mul_le_mul_of_nonneg_left (h4.trans h3) hx0.le

