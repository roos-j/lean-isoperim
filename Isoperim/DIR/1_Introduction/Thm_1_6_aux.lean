open Real

/-- $2\,\mathrm{fH}(2^m)=m2^m$. -/
theorem fH_two_pow (m : ℕ) : 2 * fH (2 ^ m) = m * 2 ^ m := by
  have h := fH_mul_two_pow 1 m
  rw [one_mul, fH_le_one le_rfl] at h
  rw [h]
  ring

/-- $t\log_2t+t+1\ge0$ for $t\ge0$ (indeed $t\log t\ge2t-2\sqrt t\ge-\frac12$). -/
theorem mul_logb_add_ge {t : ℝ} (ht0 : 0 ≤ t) : 0 ≤ t * logb 2 t + t + 1 := by
  rcases ht0.eq_or_lt with rfl | htpos
  · simp
  have hs : 0 < √t := sqrt_pos.2 htpos
  have hlog : log t ≥ 2 * (1 - (√t)⁻¹) := by
    have h1 := log_le_sub_one_of_pos (inv_pos.2 hs)
    rw [log_inv, log_sqrt ht0] at h1
    linarith
  have hst : √t ^ 2 = t := sq_sqrt ht0
  have hmul : t * log t ≥ -2⁻¹ := by
    have : t * (2 * (1 - (√t)⁻¹)) = 2 * t - 2 * √t := by
      field_simp
      nlinarith [hst]
    have h2 : t * log t ≥ 2 * t - 2 * √t := by
      rw [← this]; exact mul_le_mul_of_nonneg_left hlog htpos.le
    nlinarith [sq_nonneg (√t - 2⁻¹)]
  have hl2 : (0.69 : ℝ) < log 2 := by linarith [log_two_gt_d9]
  have : t * logb 2 t = t * log t / log 2 := by rw [logb, mul_div_assoc]
  rw [this]
  have h1 : t * log t / log 2 ≥ -2⁻¹ / log 2 := div_le_div_of_nonneg_right hmul (by linarith)
  have h2 : -2⁻¹ / log 2 ≥ -1 := by
    rw [ge_iff_le, le_div_iff₀ (by linarith)]
    linarith
  linarith

/-- $k\log_2k-2k\le2\sum_{j<k}s(j)$ for all $k\in\mathbb N$. -/
theorem two_fH_ge (k : ℕ) : (k : ℝ) * logb 2 k - 2 * k ≤ 2 * fH k := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · simp
  set m := Nat.log 2 k with hm
  have hm1 : 2 ^ m ≤ k := Nat.pow_log_le_self 2 hk.ne'
  have hm2 : k < 2 ^ (m + 1) := Nat.lt_pow_succ_log_self (by norm_num) k
  obtain ⟨r, hkr⟩ := Nat.exists_eq_add_of_le hm1
  have hr : r < 2 ^ m := by rw [pow_succ] at hm2; omega
  have hsup := fH_add_ge (2 ^ m) r
  rw [min_eq_right hr.le, ← hkr] at hsup
  have hpow := fH_two_pow m
  have hpowR : (2 : ℝ) * fH (2 ^ m) = m * 2 ^ m := by exact_mod_cast hpow
  have hsupR : (fH (2 ^ m) : ℝ) + fH r + r ≤ fH k := by exact_mod_cast hsup
  have hr' : (r : ℝ) * logb 2 r ≤ 2 * fH r + 2 * r := by
    rcases Nat.eq_zero_or_pos r with h0 | hrpos
    · simp [h0]
    · have := ih r (by omega); linarith
  have hkR : (k : ℝ) = 2 ^ m + r := by exact_mod_cast hkr
  have hlog : logb 2 k ≤ m + 1 := by
    have h2 : (k : ℝ) ≤ 2 ^ (m + 1) := by exact_mod_cast hm2.le
    calc logb 2 k ≤ logb 2 ((2 : ℝ) ^ (m + 1)) :=
          logb_le_logb_of_le (by norm_num) (by exact_mod_cast hk) h2
      _ = m + 1 := by rw [logb_pow, logb_self_eq_one (by norm_num)]; push_cast; ring
  have key : (r : ℝ) * (m - 1) ≤ r * logb 2 r + 2 ^ m := by
    rcases Nat.eq_zero_or_pos r with h0 | hrpos
    · simp [h0]
    · have h2m : (0 : ℝ) < 2 ^ m := by positivity
      set t : ℝ := r / 2 ^ m with ht
      have ht0 : 0 ≤ t := by positivity
      have hrt : (r : ℝ) = t * 2 ^ m := by rw [ht]; field_simp
      have htpos : 0 < t := by rw [ht]; positivity
      have hlr : logb 2 r = logb 2 t + m := by
        rw [hrt, logb_mul htpos.ne' h2m.ne', logb_pow, logb_self_eq_one (by norm_num), mul_one]
      have hb := mul_logb_add_ge ht0
      rw [hlr, hrt]
      nlinarith [mul_nonneg h2m.le hb]
  have hkk : (k : ℝ) * logb 2 k ≤ k * (m + 1) :=
    mul_le_mul_of_nonneg_left hlog (by positivity)
  rw [hkR] at hkk ⊢
  nlinarith

/-- [DIR], §1.2: by Hart's formula (1.3) and `two_fH_ge`,
$\mathcal{B}_1(x)\le x(\log_2(1/x)+2)$ for $x\in\mathcal{Q}$, $x>0$. -/
theorem isoProfile_one_le (x : ℝ) (hx : x ∈ 𝒬) (hx0 : 0 < x) :
    𝓑 1 x ≤ x * (logb 2 x⁻¹ + 2) := by
  obtain ⟨n, k, hkn, rfl⟩ := hx
  have hk : 1 ≤ k := by
    rcases Nat.eq_zero_or_pos k with h0 | h0
    · simp [h0] at hx0
    · exact h0
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  rw [eqn_1_3 n k hk hkn]
  have hsum : ∑ j ∈ Finset.Ico 1 k, (s j : ℝ) = fH k := by
    rw [fH, Nat.cast_sum, Finset.range_eq_Ico, Finset.sum_eq_sum_Ico_succ_bot hk]
    simp [s]
  rw [hsum]
  have hfH := two_fH_ge k
  have hlog : logb 2 ((k : ℝ) / 2 ^ n)⁻¹ = n - logb 2 k := by
    rw [inv_div, logb_div (by positivity) hkR.ne', logb_pow, logb_self_eq_one (by norm_num),
      mul_one]
  rw [hlog]
  have hx0' : (0 : ℝ) ≤ k / 2 ^ n := by positivity
  apply mul_le_mul_of_nonneg_left _ hx0'
  have : logb 2 k - 2 ≤ 2 / k * fH k := by
    rw [div_mul_eq_mul_div, le_div_iff₀ hkR]
    linarith
  linarith

/-- [DIR], §1.2: $\mathcal{B}_1(x)\ge x\log_2(1/x)$ for $x\in\mathcal{Q}$, $x\le\frac12$
(Theorem 1.1 at $\beta=1$). -/
theorem isoProfile_one_ge (x : ℝ) (hx : x ∈ 𝒬) (hx2 : x ≤ 2⁻¹) :
    x * logb 2 x⁻¹ ≤ 𝓑 1 x := by
  obtain ⟨m, k, hk, rfl⟩ := hx
  obtain ⟨A, hA⟩ := exists_set_dens m k hk
  refine le_csInf ⟨_, m + 1, by omega, A, hA, rfl⟩ ?_
  rintro v ⟨n, hn, A', hA', rfl⟩
  have h := (thm_1_1 n hn 1 (by norm_num [β₀])).1 A' (by rw [hA']; exact hx2)
  rw [hA', rpow_one] at h
  exact h

