/-- Eventually along $x\to0^+$, $x\in\mathcal{Q}$: $x\in\mathcal{Q}$, $0<x\le\frac12$. -/
theorem eventually_dyadic_small :
    ∀ᶠ x in 𝓝[𝒬 ∩ Set.Ioi 0] (0 : ℝ), x ∈ 𝒬 ∧ 0 < x ∧ x ≤ 2⁻¹ := by
  have h1 : ∀ᶠ x in 𝓝[𝒬 ∩ Set.Ioi 0] (0 : ℝ), x ∈ 𝒬 ∩ Set.Ioi 0 := self_mem_nhdsWithin
  have h2 : ∀ᶠ x in 𝓝[𝒬 ∩ Set.Ioi 0] (0 : ℝ), x < 2⁻¹ :=
    nhdsWithin_le_nhds (Iio_mem_nhds (by norm_num))
  filter_upwards [h1, h2] with x hx hx2 using ⟨hx.1, hx.2, hx2.le⟩

/-- $\log_2(1/x)\ge1$ for $0<x\le\frac12$. -/
theorem one_le_logb_inv {x : ℝ} (hx0 : 0 < x) (hx2 : x ≤ 2⁻¹) : 1 ≤ logb 2 x⁻¹ := by
  have h2 : (2 : ℝ) ≤ x⁻¹ := by simpa using inv_anti₀ hx0 hx2
  calc (1 : ℝ) = logb 2 2 := (logb_self_eq_one (by norm_num)).symm
    _ ≤ logb 2 x⁻¹ := logb_le_logb_of_le (by norm_num) (by norm_num) h2

