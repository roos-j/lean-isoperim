* the chain of inequalities in the proof of Corollary 1.9, for $0<\beta\le1$ and a partition
  $(A,B,W)$ of $\{0,1\}^n$:
  $$\mathbf{E}h_{B\cup W}^\beta\le\mathbf{E}(h_{B\cup W}\mathbf{1}_B)
  +\mathbf{E}(h_{B\cup W}^\beta\mathbf{1}_W)\le|\nabla(A,B)|+n^\beta|W|.$$
-/

@[expose] public section

namespace Auto.DIR

open Real Finset

/-! ### Elementary facts on the cube -/

/-- $e_i\oplus e_i=0$. -/
theorem e_add_e {n : ℕ} (i : Fin n) : e i + e i = (0 : {0,1}^n) := by
  have h2 : ∀ z : ZMod 2, z + z = 0 := by decide
  funext j
  exact h2 _

/-- $i\mapsto e_i$ is injective. -/
theorem e_injective {n : ℕ} : Function.Injective (e (n := n)) := by
  intro i j hij
  by_contra hne
  have := congr_fun hij i
  simp [e, hne] at this

/-- $h_A$ takes natural number values. -/
theorem h_eq_natCast {n : ℕ} (A : Set ({0,1}^n)) (x : {0,1}^n) : ∃ k : ℕ, h A x = k := by
  unfold h
  split_ifs
  · exact ⟨_, rfl⟩
  · exact ⟨0, by simp⟩

/-- $h_A\le n$. -/
theorem h_le_dim {n : ℕ} (A : Set ({0,1}^n)) (x : {0,1}^n) : h A x ≤ n := by
  classical
  unfold h
  split_ifs
  · exact_mod_cast (card_filter_le _ _).trans (by simp)
  · positivity

/-- For $k\in\mathbb N$ and $0<\beta\le1$: $k^\beta\le k$. -/
theorem natCast_rpow_le_self (k : ℕ) {β : ℝ} (hβ0 : 0 < β) (hβ1 : β ≤ 1) :
    (k : ℝ) ^ β ≤ k := by
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · simp [zero_rpow hβ0.ne']
  · have : (1 : ℝ) ≤ k := by exact_mod_cast hk
    calc (k : ℝ) ^ β ≤ (k : ℝ) ^ (1 : ℝ) := rpow_le_rpow_of_exponent_le this hβ1
      _ = k := rpow_one _

/-- $h_A(x)^\beta\le h_A(x)$ for $0<\beta\le1$. -/
theorem h_rpow_le_self {n : ℕ} (A : Set ({0,1}^n)) (x : {0,1}^n) {β : ℝ} (hβ0 : 0 < β)
    (hβ1 : β ≤ 1) : h A x ^ β ≤ h A x := by
  obtain ⟨k, hk⟩ := h_eq_natCast A x
  rw [hk]
  exact natCast_rpow_le_self k hβ0 hβ1

/-! ### Subcubes -/

/-- For a subcube $A=\{x : x_i=a_i\ (i\in S)\}$ and $x\in A$: $h_A(x)=\#S$ (flipping a bit in
$S$ leaves $A$, flipping a bit outside $S$ does not). -/
theorem h_subcube {n : ℕ} (S : Finset (Fin n)) (a x : {0,1}^n)
    (hx : x ∈ {y : {0,1}^n | ∀ i ∈ S, y i = a i}) :
    h {y : {0,1}^n | ∀ i ∈ S, y i = a i} x = S.card := by
  classical
  have hne : ∀ z : ZMod 2, z + 1 ≠ z := by decide
  unfold h
  rw [ite_eq_left hx]
  congr 2
  ext i
  simp only [mem_filter, mem_univ, true_and, Set.mem_ofPred_eq, not_forall]
  constructor
  · rintro ⟨j, hj, hji⟩
    by_contra hiS
    apply hji
    have hij : j ≠ i := fun h ↦ hiS (h ▸ hj)
    simp only [Pi.add_apply, e, Pi.single_apply, hij, ite_false, add_zero]
    exact hx j hj
  · intro hiS
    refine ⟨i, hiS, ?_⟩
    simp only [Pi.add_apply, e, Pi.single_eq_same, hx i hiS]
    exact hne _

/-- The subcube $\{x : x_i=a_i\ (i\in S)\}$ as a `Fintype.piFinset`. -/
theorem subcube_eq_piFinset {n : ℕ} (S : Finset (Fin n)) (a : {0,1}^n) :
    {y : {0,1}^n | ∀ i ∈ S, y i = a i} =
      ((Fintype.piFinset fun i ↦ if i ∈ S then {a i} else univ : Finset ({0,1}^n)) :
        Set ({0,1}^n)) := by
  classical
  ext y
  simp only [Set.mem_ofPred_eq, mem_coe, Fintype.mem_piFinset]
  constructor
  · intro hy i
    by_cases hi : i ∈ S <;> simp [hi, hy i]
  · intro hy i hi
    simpa [hi] using hy i

/-- $|A|=2^{-\#S}$ for the subcube $A=\{x : x_i=a_i\ (i\in S)\}$. -/
theorem dens_subcube {n : ℕ} (S : Finset (Fin n)) (a : {0,1}^n) :
    ｜{y : {0,1}^n | ∀ i ∈ S, y i = a i}｜ = (2⁻¹ : ℝ) ^ S.card := by
  classical
  rw [subcube_eq_piFinset, dens_coe_finset, Fintype.card_piFinset]
  have hc : ∀ i : Fin n, ((if i ∈ S then {a i} else univ : Finset (ZMod 2))).card =
      if i ∈ S then 1 else 2 := fun i ↦ by split_ifs <;> simp
  simp only [hc, prod_ite, prod_const_one, one_mul, prod_const]
  have hSn : S.card ≤ n := by simpa using card_le_univ S
  obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le hSn
  have hk : (univ.filter (· ∉ S)).card = m := by
    have h1 := card_filter_add_card_filter_not (s := (univ : Finset (Fin n)))
      (fun i ↦ i ∈ S)
    rw [filter_mem_eq_inter, univ_inter, card_univ, Fintype.card_fin] at h1
    omega
  rw [hk, show (2⁻¹ : ℝ) ^ n = 2⁻¹ ^ S.card * 2⁻¹ ^ m by rw [← pow_add, ← hm]]
  push_cast
  rw [mul_assoc, ← mul_pow]
  norm_num

/-- For the subcube $A=\{x : x_i=a_i\ (i\in S)\}$ and $\beta>0$:
$\mathbf{E}h_A^\beta=|A|(\#S)^\beta$. -/
theorem expect_h_rpow_subcube {n : ℕ} (S : Finset (Fin n)) (a : {0,1}^n) {β : ℝ}
    (hβ : 0 < β) :
    𝐄 (h {y : {0,1}^n | ∀ i ∈ S, y i = a i} ^ β) =
      ｜{y : {0,1}^n | ∀ i ∈ S, y i = a i}｜ * (S.card : ℝ) ^ β := by
  have hpt : (h {y : {0,1}^n | ∀ i ∈ S, y i = a i} ^ β) =
      fun x ↦ (S.card : ℝ) ^ β * 𝟏 {y : {0,1}^n | ∀ i ∈ S, y i = a i} x := by
    funext x
    by_cases hx : x ∈ {y : {0,1}^n | ∀ i ∈ S, y i = a i}
    · rw [Pi.pow_apply, h_subcube S a x hx]
      simp [ind, Set.indicator_of_mem hx]
    · have h0 : h {y : {0,1}^n | ∀ i ∈ S, y i = a i} x = 0 := by
        unfold h; rw [ite_eq_right hx]
      rw [Pi.pow_apply, h0, zero_rpow hβ.ne']
      simp [ind, Set.indicator_of_notMem hx]
  rw [hpt, expect_const_mul', dens, mul_comm]

/-- For a half-cube $A=\{x : x_i=a\}$ and $\beta>0$: $|A|=\frac12$ and
$\mathbf{E}h_A^\beta=\mathbf{E}h_{A^c}^\beta=\frac12$ ($A$ and $A^c$ are subcubes of codimension
$1$; used for the equality cases of [DIR] Theorem 1.10 and [DIRX] Theorem 1.3). -/
theorem halfCube_expect {n : ℕ} {A : Set ({0,1}^n)} (hA : IsHalfCube A) {β : ℝ} (hβ : 0 < β) :
    ｜A｜ = 2⁻¹ ∧ 𝐄 (h A ^ β) = 2⁻¹ ∧ 𝐄 (h Aᶜ ^ β) = 2⁻¹ := by
  obtain ⟨i, a, rfl⟩ := hA
  have hset : ∀ c : ZMod 2, {x : {0,1}^n | x i = c} =
      {y : {0,1}^n | ∀ j ∈ ({i} : Finset (Fin n)), y j = (fun _ ↦ c) j} := by
    intro c; ext x; simp
  have hcompl : {x : {0,1}^n | x i = a}ᶜ = {x : {0,1}^n | x i = a + 1} := by
    have h2 : ∀ u v : ZMod 2, u ≠ v ↔ u = v + 1 := by decide
    ext x; simp only [Set.mem_compl_iff, Set.mem_ofPred_eq]; exact h2 _ _
  have hd : ∀ c : ZMod 2, ｜{x : {0,1}^n | x i = c}｜ = 2⁻¹ := fun c ↦ by
    rw [hset, dens_subcube]; simp
  have he : ∀ c : ZMod 2, 𝐄 (h {x : {0,1}^n | x i = c} ^ β) = 2⁻¹ := fun c ↦ by
    rw [hset, expect_h_rpow_subcube _ _ hβ, ← hset, hd]; simp
  exact ⟨hd a, he a, hcompl ▸ he (a + 1)⟩

/-! ### The chain of inequalities of Corollary 1.9 -/

/-- For a partition $(A,B,W)$: $|B\cup W|=1-|A|$. -/
theorem dens_union_of_partition {n : ℕ} (A B W : Set ({0,1}^n)) (hAB : Disjoint A B)
    (hAW : Disjoint A W) (hcover : A ∪ B ∪ W = Set.univ) : ｜B ∪ W｜ = 1 - ｜A｜ := by
  have hpt : 𝟏 (B ∪ W) = fun x ↦ (fun _ ↦ (1 : ℝ)) x - 𝟏 A x := by
    funext x
    by_cases hA : x ∈ A
    · have hB : x ∉ B := Set.disjoint_left.1 hAB hA
      have hW : x ∉ W := Set.disjoint_left.1 hAW hA
      have : x ∉ B ∪ W := by simp [hB, hW]
      simp [ind, Set.indicator_of_notMem this, Set.indicator_of_mem hA]
    · have : x ∈ B ∪ W := by
        have hx : x ∈ A ∪ B ∪ W := hcover ▸ Set.mem_univ x
        rcases hx with (h1 | h1) | h1
        · exact absurd h1 hA
        · exact Or.inl h1
        · exact Or.inr h1
      simp [ind, Set.indicator_of_mem this, Set.indicator_of_notMem hA]
  rw [dens, dens, hpt, expect_sub', expect_one']

/-- [DIR], §1.4: for a partition $(A,B,W)$ of $\{0,1\}^n$,
$\mathbf{E}(h_{B\cup W}\mathbf{1}_B)\le|\nabla(A,B)|$: for $x\in B$, $h_{B\cup W}(x)$ counts the
$i$ with $x\oplus e_i\in A$, and $(x,i)\mapsto(x\oplus e_i,x)$ is injective into the edges from
$A$ to $B$. -/
theorem expect_h_mul_ind_le_edgeMeasure {n : ℕ} (A B W : Set ({0,1}^n))
    (hcover : A ∪ B ∪ W = Set.univ) : 𝐄 (h (B ∪ W) * 𝟏 B) ≤ |∇(A, B)| := by
  classical
  set S : Finset (({0,1}^n) × Fin n) :=
    univ.filter (fun p ↦ p.1 ∈ B ∧ p.1 + e p.2 ∉ B ∪ W) with hS
  have hsum : ∑ x, (h (B ∪ W) * 𝟏 B) x = (S.card : ℝ) := by
    rw [hS, card_filter, Nat.cast_sum, Fintype.sum_prod_type]
    refine sum_congr rfl fun x _ ↦ ?_
    by_cases hx : x ∈ B
    · have hxBW : x ∈ B ∪ W := Or.inl hx
      simp only [Pi.mul_apply, h, ite_eq_left hxBW, ind, Set.indicator_of_mem hx, Pi.one_apply,
        mul_one, hx, true_and, Nat.cast_ite, Nat.cast_one, Nat.cast_zero]
      rw [card_filter, Nat.cast_sum]
      simp only [Nat.cast_ite, Nat.cast_one, Nat.cast_zero]
    · simp [ind, hx]
  have hcard : S.card ≤ Set.ncard {p ∈ edges n | p.1 ∈ A ∧ p.2 ∈ B} := by
    rw [← Set.ncard_coe_finset]
    refine Set.ncard_le_ncard_of_injOn (fun p ↦ (p.1 + e p.2, p.1)) ?_ ?_ (Set.toFinite _)
    · rintro ⟨x, i⟩ hp
      simp only [hS, coe_filter, mem_univ, true_and, Set.mem_ofPred_eq] at hp
      refine ⟨⟨i, ?_⟩, ?_, hp.1⟩
      · show x = x + e i + e i
        rw [add_assoc, e_add_e, add_zero]
      · have hx : x + e i ∈ A ∪ B ∪ W := hcover ▸ Set.mem_univ _
        rcases hx with (h1 | h1) | h1
        · exact h1
        · exact absurd (Or.inl h1) hp.2
        · exact absurd (Or.inr h1) hp.2
    · rintro ⟨x, i⟩ _ ⟨y, j⟩ _ hxy
      simp only [Prod.mk.injEq] at hxy
      obtain ⟨h1, rfl⟩ := hxy
      have : e i = e j := add_left_cancel h1
      rw [e_injective this]
  simp only [expect, smul_eq_mul, edgeMeasure]
  rw [hsum]
  exact mul_le_mul_of_nonneg_left (by exact_mod_cast hcard) (by positivity)

/-- [DIR], §1.4: $\mathbf{E}h_{B\cup W}^\beta\le\mathbf{E}(h_{B\cup W}\mathbf{1}_B)
+\mathbf{E}(h_{B\cup W}^\beta\mathbf{1}_W)$ for $0<\beta\le1$ and disjoint $B,W$ ($h^\beta\le h$
on $B$, since $h$ is a natural number). -/
theorem expect_h_rpow_le_split {n : ℕ} (B W : Set ({0,1}^n)) (hBW : Disjoint B W) {β : ℝ}
    (hβ0 : 0 < β) (hβ1 : β ≤ 1) :
    𝐄 (h (B ∪ W) ^ β) ≤ 𝐄 (h (B ∪ W) * 𝟏 B) + 𝐄 (h (B ∪ W) ^ β * 𝟏 W) := by
  rw [← expect_add']
  refine expect_le_expect fun x ↦ ?_
  simp only [Pi.pow_apply, Pi.mul_apply]
  by_cases hB : x ∈ B
  · have hW : x ∉ W := Set.disjoint_left.1 hBW hB
    simp only [ind, Set.indicator_of_mem hB, Set.indicator_of_notMem hW, Pi.one_apply,
      mul_one, mul_zero, add_zero]
    exact h_rpow_le_self _ x hβ0 hβ1
  · by_cases hW : x ∈ W
    · simp [ind, Set.indicator_of_notMem hB, Set.indicator_of_mem hW]
    · have h0 : h (B ∪ W) x = 0 := by
        unfold h; rw [ite_eq_right (by simp [hB, hW])]
      simp [h0, zero_rpow hβ0.ne', ind, Set.indicator_of_notMem hB, Set.indicator_of_notMem hW]

/-- [DIR], §1.4: $\mathbf{E}(h_{B\cup W}\mathbf{1}_B)+\mathbf{E}(h_{B\cup W}^\beta\mathbf{1}_W)
\le|\nabla(A,B)|+n^\beta|W|$ for a partition $(A,B,W)$ and $\beta>0$. -/
theorem expect_split_le {n : ℕ} (A B W : Set ({0,1}^n)) (hcover : A ∪ B ∪ W = Set.univ)
    {β : ℝ} (hβ0 : 0 < β) :
    𝐄 (h (B ∪ W) * 𝟏 B) + 𝐄 (h (B ∪ W) ^ β * 𝟏 W) ≤ |∇(A, B)| + (n : ℝ) ^ β * ｜W｜ := by
  refine add_le_add (expect_h_mul_ind_le_edgeMeasure A B W hcover) ?_
  rw [dens, ← expect_const_mul']
  refine expect_le_expect fun x ↦ ?_
  simp only [Pi.mul_apply, Pi.pow_apply]
  exact mul_le_mul_of_nonneg_right (rpow_le_rpow (h_nonneg _ _) (h_le_dim _ _) hβ0.le)
    (ind_mem_Icc W x).1

end Auto.DIR
