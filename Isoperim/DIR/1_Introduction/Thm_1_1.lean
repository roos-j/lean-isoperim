module

public import Mathlib

/-!
# [DIR] §1 Introduction: Theorem 1.1

This file was automatically generated by Claude.

Source [DIR]: P. Durcik, P. Ivanisvili, J. Roos, *Sharp isoperimetric inequalities on the Hamming
cube near the critical exponent*, arXiv:2407.12674v2 (revised version, August 2026).

This file covers the opening paragraph of §1, Theorem 1.1 and Remark 1.2. Following the
repository layout (one file per theorem of the introduction, corollaries in the file of the
theorem they follow from), it also contains §1.4 *Towards a conjecture of Kahn and Park* with
Corollary 1.9, which in the paper appears after Remark 1.8.

## Notation introduced here

* `{0,1}^n` : the Hamming cube, realized as `Fin n → ZMod 2`, so that bitwise addition `x ⊕ y`
  of the paper is the addition `x + y` of `(ZMod 2)^n`;
* `e i` : the `i`-th unit vector, so that `x + e i` is `x` with the `i`-th bit flipped;
* `h_{A}` : the function $h_A$;
* `𝐄 f` : the expectation $\mathbf{E} f = 2^{-n}\sum_{x} f(x)$;
* `𝟏_{A}` : the indicator function $\mathbf{1}_A$ (real valued);
* `|A|` : the normalized size $|A| = \mathbf{E}\mathbf{1}_A$ of a set `A ⊆ {0,1}^n`
  (for any other argument `|a|` keeps its usual meaning `abs a`);
* `log₂` : the binary logarithm `Real.logb 2`;
* `|∇(A, B)|` : the edge boundary measure of Corollary 1.9.

Real powers `t ^ β` with `β : ℝ` are `Real.rpow`; for functions, `f ^ β` is the pointwise power.
-/

@[expose] public section

namespace Auto.DIR

open Real Finset

/-
Let $n\ge 1$ be an integer.  For a subset $A$ of the Hamming cube $\{0,1\}^n$ and a vertex
$x\in A$ let $h_A(x)$ be the number of edges connecting $x$ with the complement of $A$ and
let $h_A(x)=0$ if $x\not\in A$.
-/

/-- The Hamming cube $\{0,1\}^n$ ([DIR], §1, first paragraph). We realize it as
`Fin n → ZMod 2`, so that the bitwise addition $x\oplus y$ of [DIR, §3] is `x + y`. -/
abbrev Cube (n : ℕ) : Type := Fin n → ZMod 2

@[inherit_doc] notation "{0,1}^" n => Cube n

/-- The unit vector $e_i\in\{0,1\}^n$; $x\oplus e_i$ (written `x + e i`) is $x$ with the $i$-th
bit flipped ([DIR], §1.5 and §3). Two vertices are joined by an edge iff they differ by some
`e i`. -/
def e {n : ℕ} (i : Fin n) : {0,1}^n := Pi.single i 1

/-- $h_A(x)$ ([DIR], §1, first paragraph): for $x\in A$ the number of edges connecting $x$ with
the complement of $A$, i.e. the number of $i$ with $x\oplus e_i\notin A$; and $h_A(x)=0$ if
$x\notin A$. -/
noncomputable def hA {n : ℕ} (A : Set ({0,1}^n)) (x : {0,1}^n) : ℝ :=
  open Classical in
  if x ∈ A then (#{i : Fin n | x + e i ∉ A} : ℝ) else 0

@[inherit_doc] notation "h_{" A "}" => hA A

/-- The expectation $\mathbf{E}f=2^{-n}\sum_{x\in\{0,1\}^n}f(x)$ ([DIR], §1, after Theorem 1.1),
for functions with values in any real vector space (e.g. `ℝ` or `ℂ`). -/
noncomputable def expect {n : ℕ} {M : Type*} [AddCommGroup M] [Module ℝ M]
    (f : ({0,1}^n) → M) : M :=
  ((2 : ℝ)⁻¹ ^ n) • ∑ x, f x

@[inherit_doc] notation:max "𝐄 " f:75 => expect f

/-- The (real-valued) indicator function $\mathbf{1}_A$. -/
notation "𝟏_{" A "}" => Set.indicator A (fun _ => (1 : ℝ))

/-- The normalized size $|A|=\mathbf{E}\mathbf{1}_A$ of $A\subset\{0,1\}^n$
([DIR], §1, after Theorem 1.1). Written `|A|`. -/
noncomputable def dens {n : ℕ} (A : Set ({0,1}^n)) : ℝ := 𝐄 𝟏_{A}

/-- Auxiliary syntax for the notation `|A|`: elaborates to `Auto.DIR.dens A` when `A` is a set,
and to `abs A` otherwise. -/
syntax (name := absOrDens) "absOrDens% " term:max : term

open Lean Elab Term Meta in
/-- Elaborator for `absOrDens%`, see `Auto.DIR.dens`. -/
@[term_elab absOrDens] meta def elabAbsOrDens : TermElab := fun stx expectedType? => do
  let a : Term := ⟨stx[1]⟩
  let isSet ← observing? (do
    let e ← withoutErrToSorry <| elabTerm a none
    let ty ← whnfR (← instantiateMVars (← inferType e))
    return ty.isAppOf ``Set)
  if isSet == some true then
    elabTerm (← `(Auto.DIR.dens $a)) expectedType?
  else
    elabTerm (← `(abs $a)) expectedType?

macro_rules
  | `(|$a|) => `(absOrDens% $a)

/-- The binary logarithm $\log_2$. -/
notation "log₂" => Real.logb 2

/-- The threshold exponent $\beta_0=0.50057$ ([DIR], Theorem 1.1). -/
noncomputable def β₀ : ℝ := 0.50057

/-- A *subcube* of $\{0,1\}^n$: a set obtained by fixing the values of some coordinates, i.e.
$\{x : x_i=a_i \text{ for } i\in S\}$ (e.g. the codimension $k$ subcube
$\{x\in\{0,1\}^n : x_1=\dots=x_k=0\}$ of [DIR], §1.1). -/
def IsSubcube {n : ℕ} (A : Set ({0,1}^n)) : Prop :=
  ∃ (S : Finset (Fin n)) (a : {0,1}^n), A = {x | ∀ i ∈ S, x i = a i}

/-
One of our main results is the following isoperimetric inequality.
-/

/-- **Theorem 1.1** ([DIR]). For all $\beta\ge\beta_0=0.50057$ and $A\subset\{0,1\}^n$ with
$|A|\le\frac12$,
$$\mathbf{E}h_A^\beta\ge|A|(\log_2(1/|A|))^\beta. \tag{1.1}$$
This is an equality if $A$ is a subcube. -/
theorem thm_1_1 (n : ℕ) (hn : 1 ≤ n) (β : ℝ) (hβ : β₀ ≤ β) :
    (∀ A : Set ({0,1}^n), |A| ≤ 1 / 2 →
      𝐄 h_{A} ^ β ≥ |A| * (log₂ (1 / |A|)) ^ β) ∧
    (∀ A : Set ({0,1}^n), |A| ≤ 1 / 2 → IsSubcube A →
      𝐄 h_{A} ^ β = |A| * (log₂ (1 / |A|)) ^ β) := by
  sorry

/-
Here $\mathbf{E}f=2^{-n} \sum_{x\in \{0,1\}^n} f(x)$ and $|A|=\mathbf{E} \mathbf{1}_A$.
(These definitions are `Auto.DIR.expect` and `Auto.DIR.dens` above.)
-/

/-- [DIR], §1, after Theorem 1.1: if (1.1) holds for some $\beta$, then it follows for all
$\beta'\ge\beta$ (by Hölder's inequality, see Lemma 5.1). -/
theorem eqn_1_1_mono (β : ℝ) (hβ : 0 < β)
    (h : ∀ (n : ℕ), 1 ≤ n → ∀ A : Set ({0,1}^n), |A| ≤ 1 / 2 →
      𝐄 h_{A} ^ β ≥ |A| * (log₂ (1 / |A|)) ^ β)
    (β' : ℝ) (hβ' : β ≤ β') :
    ∀ (n : ℕ), 1 ≤ n → ∀ A : Set ({0,1}^n), |A| ≤ 1 / 2 →
      𝐄 h_{A} ^ β' ≥ |A| * (log₂ (1 / |A|)) ^ β' := by
  sorry

/-
The threshold $\beta_0=0.50057$ is rooted in the failure of a certain variant of Bobkov's
two-point inequality for the Gaussian isoperimetric profile
(see Remark \ref{rem:beta0explanation} [Remark 2.4] and \ref{rem:Jbobkovtwoptfailure}
[Remark 3.6] below).
-/

/-- **Remark 1.2** ([DIR], added in revised version, August 2026). This failure can be overcome
to prove (1.1) in the full conjectured range $\beta\ge 0.5$, see [DIRX26] (Theorem 1.1 there),
also see Remark 2.6. -/
theorem rem_1_2 (n : ℕ) (hn : 1 ≤ n) (β : ℝ) (hβ : 1 / 2 ≤ β) (A : Set ({0,1}^n))
    (hA : |A| ≤ 1 / 2) :
    𝐄 h_{A} ^ β ≥ |A| * (log₂ (1 / |A|)) ^ β := by
  sorry

/-! ### §1.4 Towards a conjecture of Kahn and Park

In the paper this subsection follows Remark 1.8 (§1.3). It is placed here since Corollary 1.9
is a corollary of Theorem 1.1. -/

/-
As an immediate consequence of Theorem \ref{thm:mainisoperim} [Theorem 1.1] we come closer to a
conjecture of Kahn and Park \cite[Conjecture 1.3]{KP20}.
-/

/-- The set $\mathcal{E}$ of edges of $\{0,1\}^n$ ([DIR], Corollary 1.9), as ordered pairs
$(x,y)$ of vertices differing in exactly one bit. -/
def edges (n : ℕ) : Set (({0,1}^n) × ({0,1}^n)) := {p | ∃ i, p.2 = p.1 + e i}

/-- The edge boundary measure
$|\nabla(A,B)|=2^{-n}\#\{(x,y)\in\mathcal{E} : x\in A, y\in B\}$ ([DIR], Corollary 1.9).
Written `|∇(A, B)|`. -/
noncomputable def edgeMeasure {n : ℕ} (A B : Set ({0,1}^n)) : ℝ :=
  (2 : ℝ)⁻¹ ^ n * (Set.ncard {p ∈ edges n | p.1 ∈ A ∧ p.2 ∈ B} : ℝ)

@[inherit_doc] notation "|∇(" A ", " B ")|" => edgeMeasure A B

/-- **Corollary 1.9** ([DIR]). Let $(A,B,W)$ be a partition of $\{0,1\}^n$ and assume
$|A|=\frac12$. Then
$$|\nabla(A,B)|+n^{0.50057}|W|\ge\tfrac12,$$
where $|\nabla(A,B)|=2^{-n}\#\{(x,y)\in\mathcal{E} : x\in A, y\in B\}$,
$|W|=\mathbf{E}\mathbf{1}_W$, and $\mathcal{E}$ is the set of edges of $\{0,1\}^n$. -/
theorem cor_1_9 (n : ℕ) (hn : 1 ≤ n) (A B W : Set ({0,1}^n))
    (hAB : Disjoint A B) (hAW : Disjoint A W) (hBW : Disjoint B W)
    (hcover : A ∪ B ∪ W = Set.univ) (hA : |A| = 1 / 2) :
    |∇(A, B)| + (n : ℝ) ^ (0.50057 : ℝ) * |W| ≥ 1 / 2 := by
  sorry

/-
Kahn and Park proved this with $\log_3(\frac32)\approx 0.585$ in the exponent of $n$ and in
\cite[Cor. 1.6]{BIM23} this was improved to $0.53$, while the conjectured optimal exponent is
$0.5$.
-/

/-- [DIR], §1.4 (cited from Kahn–Park [KP20]): Corollary 1.9 holds with the exponent
$\log_2(\frac32)\approx0.585$ in place of $0.50057$. (The paper writes $\log_3(\frac32)$, a typo
for $\log_2(\frac32)\approx 0.585$; see `automation/ErrorReport.md`.) -/
theorem cor_1_9_kahn_park (n : ℕ) (hn : 1 ≤ n) (A B W : Set ({0,1}^n))
    (hAB : Disjoint A B) (hAW : Disjoint A W) (hBW : Disjoint B W)
    (hcover : A ∪ B ∪ W = Set.univ) (hA : |A| = 1 / 2) :
    |∇(A, B)| + (n : ℝ) ^ (log₂ (3 / 2)) * |W| ≥ 1 / 2 := by
  sorry

/-- [DIR], §1.4 (cited from [BIM23, Cor. 1.6]): Corollary 1.9 holds with the exponent $0.53$
in place of $0.50057$. -/
theorem cor_1_9_bim (n : ℕ) (hn : 1 ≤ n) (A B W : Set ({0,1}^n))
    (hAB : Disjoint A B) (hAW : Disjoint A W) (hBW : Disjoint B W)
    (hcover : A ∪ B ∪ W = Set.univ) (hA : |A| = 1 / 2) :
    |∇(A, B)| + (n : ℝ) ^ (0.53 : ℝ) * |W| ≥ 1 / 2 := by
  sorry

/-- The conjecture of Kahn and Park [KP20, Conjecture 1.3] with the conjectured optimal
exponent $0.5$ ([DIR], §1.4): for every partition $(A,B,W)$ of $\{0,1\}^n$ with $|A|=\frac12$,
$|\nabla(A,B)|+n^{0.5}|W|\ge\frac12$. This is a statement (a `Prop`), not a claim of the
paper; it is proved in [DIRX26, Theorem 1.2]. -/
def KahnParkConjecture : Prop :=
  ∀ (n : ℕ), 1 ≤ n → ∀ A B W : Set ({0,1}^n), Disjoint A B → Disjoint A W → Disjoint B W →
    A ∪ B ∪ W = Set.univ → |A| = 1 / 2 → |∇(A, B)| + (n : ℝ) ^ (0.5 : ℝ) * |W| ≥ 1 / 2

/-
Corollary \ref{cor:kahnpark} follows from Theorem \ref{thm:mainisoperim} because for
$|B\cup W|=|A|=\frac12$, we have
-/

/-- [DIR], §1.4, display after Corollary 1.9: for a partition $(A,B,W)$ of $\{0,1\}^n$ with
$|B\cup W|=|A|=\frac12$,
$$\tfrac12\le\mathbf{E}h_{B\cup W}^{\beta_0}\le\mathbf{E}(h_{B\cup W}\mathbf{1}_B)
+\mathbf{E}(h_{B\cup W}^{\beta_0}\mathbf{1}_W)\le|\nabla(A,B)|+n^{0.50057}|W|.$$ -/
theorem cor_1_9_chain (n : ℕ) (hn : 1 ≤ n) (A B W : Set ({0,1}^n))
    (hAB : Disjoint A B) (hAW : Disjoint A W) (hBW : Disjoint B W)
    (hcover : A ∪ B ∪ W = Set.univ) (hBW' : |B ∪ W| = 1 / 2) (hA : |A| = 1 / 2) :
    1 / 2 ≤ 𝐄 h_{B ∪ W} ^ β₀ ∧
    𝐄 h_{B ∪ W} ^ β₀ ≤ 𝐄 (h_{B ∪ W} * 𝟏_{B}) + 𝐄 (h_{B ∪ W} ^ β₀ * 𝟏_{W}) ∧
    𝐄 (h_{B ∪ W} * 𝟏_{B}) + 𝐄 (h_{B ∪ W} ^ β₀ * 𝟏_{W}) ≤
      |∇(A, B)| + (n : ℝ) ^ (0.50057 : ℝ) * |W| := by
  sorry

end Auto.DIR
