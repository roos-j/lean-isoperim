@[expose] public section

namespace Auto.DIR

open Real Set MeasureTheory Filter Topology

/-- $M_if(x)=(f(x)-f(x\oplus e_i))_+$ ([DIR], §3), where $x\oplus e_i$ is $x$ with the $i$-th bit
flipped. -/
noncomputable def Mi {n : ℕ} (i : Fin n) (f : ({0,1}^n) → ℝ) (x : {0,1}^n) : ℝ :=
  max (f x - f (x + e i)) 0

/-- $Mf=\sqrt{\sum_{i=1}^n(M_if)^2}$ ([DIR], §3). This notation originates in [Tal93], [BG99]. -/
noncomputable def M {n : ℕ} (f : ({0,1}^n) → ℝ) (x : {0,1}^n) : ℝ := √(∑ i, (Mi i f x) ^ 2)

/-- [DIR], §3: observe $M\mathbf{1}_A=\sqrt{h_A}$. -/
theorem M_indicator (n : ℕ) (A : Set ({0,1}^n)) : M 𝟏_{A} = fun x ↦ √(h_{A} x) := by
  sorry

/-- **Lemma 3.1** ([DIR]). Suppose that $\mathcal{I}\subset[0,\infty)$ is an interval and
$B:\mathcal{I}\to\mathbb{R}$. If
$$B(\mathbf{E}f)\le\mathbf{E}\sqrt{B(f)^2+(Mf)^2} \tag{3.1}$$
holds for all $f:\{0,1\}\to\mathcal{I}$, then it holds for all $f:\{0,1\}^n\to\mathcal{I}$ and
$n\ge1$.

**Discrepancy with the paper.** The paper allows any real-valued $B:\mathcal{I}\to\mathbb{R}$.
For sign-changing $B$ the lemma is false: take $\mathcal{I}=[0,1]$, $S=\{0.1,0.2,0.6,0.9,0.45\}$,
$B=0$ on $S\setminus\{0.45\}$, $B(0.45)=1$ and $B=-2$ on $[0,1]\setminus S$. No two points of $S$
have their midpoint in $S$ (apart from $x=y$), so the case $n=1$ holds (if the midpoint is in $S$,
one of $x,y$ is not, and the right-hand side is $\ge1$). But $f$ on $\{0,1\}^2$ with values
$f(0,0)=0.1$, $f(1,0)=0.2$, $f(0,1)=0.6$, $f(1,1)=0.9$ has $\mathbf{E}f=0.45$, $B(\mathbf{E}f)=1$
and $\mathbf{E}\sqrt{B(f)^2+(Mf)^2}=\mathbf{E}Mf\approx0.34$. The induction ([Bob97, Lemma 1],
[BG99, Lemma 2.1]) needs $|B(\mathbf{E}f_j)|\le\mathbf{E}\sqrt{B(f_j)^2+(Mf_j)^2}$ for the
restrictions $f_j$, i.e. $B\ge0$. All applications in the paper ($L_{1/2}$ on $[0,\frac12]$, $J$
on $[x_0,1]$) are non-negative. The Lean statement adds the hypothesis $B\ge0$ on
$\mathcal{I}$. -/
theorem lemma_3_1 (𝓘 : Set ℝ) (h𝓘 : 𝓘.OrdConnected) (h𝓘0 : 𝓘 ⊆ Ici 0) (B : ℝ → ℝ)
    (hB : ∀ t ∈ 𝓘, 0 ≤ B t)
    (h1 : ∀ f : ({0,1}^1) → ℝ, (∀ x, f x ∈ 𝓘) →
      B (𝐄 f) ≤ 𝐄 (fun x ↦ √(B (f x) ^ 2 + (M f x) ^ 2)))
    (n : ℕ) (hn : 1 ≤ n) (f : ({0,1}^n) → ℝ) (hf : ∀ x, f x ∈ 𝓘) :
    B (𝐄 f) ≤ 𝐄 (fun x ↦ √(B (f x) ^ 2 + (M f x) ^ 2)) := by
  sorry

/-- **(3.2)** ([DIR], §3). For $n=1$, (3.1) may be written as
$$B\Big(\frac{x+y}2\Big)\le\frac12\sqrt{(y-x)^2+B(y)^2}+\frac12B(x),$$
where $\max(f(0),f(1))=y\in\mathcal{I}$ and $\min(f(0),f(1))=x\in\mathcal{I}$.

**Discrepancy with the paper.** For $n=1$ the right-hand side of (3.1) equals
$\frac12\sqrt{(y-x)^2+B(y)^2}+\frac12|B(x)|$, so the rewriting as (3.2) needs $B(x)\ge0$
(for $B(x)<0$, (3.2) is strictly stronger than (3.1)). The Lean statement assumes
$B(\min(f(0),f(1)))\ge0$ (cf. the hypothesis $B\ge0$ added to Lemma 3.1). -/
theorem eqn_3_2 (B : ℝ → ℝ) (f : ({0,1}^1) → ℝ) (hB : 0 ≤ B (min (f 0) (f 1))) :
    B (𝐄 f) ≤ 𝐄 (fun x ↦ √(B (f x) ^ 2 + (M f x) ^ 2)) ↔
      B ((min (f 0) (f 1) + max (f 0) (f 1)) / 2) ≤
        1 / 2 * √((max (f 0) (f 1) - min (f 0) (f 1)) ^ 2 + B (max (f 0) (f 1)) ^ 2) +
          1 / 2 * B (min (f 0) (f 1)) := by
  sorry

/-- [DIR], §3: observe that (3.2) is equivalent to $G^1_{\frac12}[B](x,y)\ge0$ with $G^1_\beta$ as
in (2.1) (for $x\le y$ and $B(y)\ge0$). -/
theorem eqn_3_2_iff_G₁ (B : ℝ → ℝ) (x y : ℝ) (hxy : x ≤ y) (hBy : 0 ≤ B y) :
    B ((x + y) / 2) ≤ 1 / 2 * √((y - x) ^ 2 + B y ^ 2) + 1 / 2 * B x ↔
      G₁ (1 / 2) B x y ≥ 0 := by
  sorry

section Proof_Theorem_1_6
/-- [DIR], §3, proof of Theorem 1.6 (cited from [BIM23, Lemma 2.2]): the function
$L(x)=x\sqrt{\log_2(1/x)}$ satisfies (3.2) when $0\le x\le y\le\frac12$. -/
theorem L_half_eqn_3_2 (x y : ℝ) (hx : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 1 / 2) :
    L (1 / 2) ((x + y) / 2) ≤ 1 / 2 * √((y - x) ^ 2 + L (1 / 2) y ^ 2) + 1 / 2 * L (1 / 2) x := by
  sorry

/-- [DIR], §3, proof of Theorem 1.6: applying Lemma 3.1 with $\mathcal{I}=[0,\frac12]$,
$L(\mathbf{E}f)\le\mathbf{E}\sqrt{L(f)^2+(Mf)^2}$ for all $f:\{0,1\}^n\to[0,\frac12]$. -/
theorem L_half_eqn_3_1 (n : ℕ) (hn : 1 ≤ n) (f : ({0,1}^n) → ℝ)
    (hf : ∀ x, f x ∈ Icc (0 : ℝ) (1 / 2)) :
    L (1 / 2) (𝐄 f) ≤ 𝐄 (fun x ↦ √(L (1 / 2) (f x) ^ 2 + (M f x) ^ 2)) := by
  sorry

/-- [DIR], §3, proof of Theorem 1.6: plugging in $f=\frac12\mathbf{1}_A$ we have
$\mathbf{E}f=\frac12|A|$ and the inequality becomes
$$L(\tfrac12|A|)\le\tfrac12\mathbf{E}(\mathbf{1}_A\sqrt{1+h_A})
\le\tfrac12(|A|+\mathbf{E}\sqrt{h_A}).$$ -/
theorem proof_thm_1_6_chain (n : ℕ) (hn : 1 ≤ n) (A : Set ({0,1}^n)) :
    𝐄 (fun x ↦ 1 / 2 * 𝟏_{A} x) = 1 / 2 * ｜A｜ ∧
    L (1 / 2) (1 / 2 * ｜A｜) ≤ 1 / 2 * 𝐄 (fun x ↦ 𝟏_{A} x * √(1 + h_{A} x)) ∧
    1 / 2 * 𝐄 (fun x ↦ 𝟏_{A} x * √(1 + h_{A} x)) ≤ 1 / 2 * (｜A｜ + 𝐄 (fun x ↦ √(h_{A} x))) := by
  sorry

end Proof_Theorem_1_6

/-- The standard Gaussian density $\varphi(t)=(2\pi)^{-1/2}e^{-t^2/2}$ ([DIR], §3). -/
noncomputable def φ (t : ℝ) : ℝ := (2 * π) ^ (-(1 / 2 : ℝ)) * exp (-t ^ 2 / 2)

/-- The standard Gaussian distribution function $\Phi(t)=\int_{-\infty}^t\varphi(s)\,ds$
([DIR], §3). -/
noncomputable def Φ (t : ℝ) : ℝ := ∫ s in Iic t, φ s

/-- The Gaussian isoperimetric profile $I(x)=\varphi(\Phi^{-1}(x))$ ([DIR], §3), for
$x\in(0,1)$, with the continuous extension $I(0)=I(1)=0$ (and junk value $0$ outside $[0,1]$).
Here $\Phi^{-1}$ is the inverse of the bijection $\Phi:\mathbb{R}\to(0,1)$. -/
noncomputable def I (x : ℝ) : ℝ := if 0 < x ∧ x < 1 then φ (Function.invFun Φ x) else 0

/-- [DIR], §3: the function $I$ is also characterized by the conditions $I(0)=I(1)=0$,
$I\cdot I''=-1$: it satisfies them, and it is the unique non-negative continuous function on
$[0,1]$ that is $C^2$ on $(0,1)$ and satisfies them.

**Discrepancy with the paper.** The paper says "$I$ is also characterized by the conditions
$I(0)=I(1)=0$, $I\cdot I''=-1$". Without a sign condition this is false: $-I$ satisfies the same
two conditions, since $(-I)(-I)''=I\,I''=-1$. The Lean statement adds the implicit hypothesis
$g\ge0$ on $[0,1]$ for the competitor $g$ (and the regularity: $g$ continuous on $[0,1]$, $C^2$ on
$(0,1)$). -/
theorem I_characterization :
    (I 0 = 0 ∧ I 1 = 0 ∧ ∀ x ∈ Ioo (0 : ℝ) 1, I x * deriv (deriv I) x = -1) ∧
    ∀ g : ℝ → ℝ, ContinuousOn g (Icc 0 1) → ContDiffOn ℝ 2 g (Ioo 0 1) →
      (∀ x ∈ Icc (0 : ℝ) 1, 0 ≤ g x) → g 0 = 0 → g 1 = 0 →
      (∀ x ∈ Ioo (0 : ℝ) 1, g x * deriv (deriv g) x = -1) → EqOn g I (Icc 0 1) := by
  sorry

/-- $J_w(x)=\sqrt2\cdot wI(w^{-1}(1-x))$ for $w>0$ and $x\in[1-w,1]$ ([DIR], §3). -/
noncomputable def Jw (w x : ℝ) : ℝ := √2 * w * I (w⁻¹ * (1 - x))

/-- [DIR], §3: $J_w(1)=0$ and $J_w''J_w=-2$ (on $(1-w,1)$). -/
theorem Jw_spec (w : ℝ) (hw : 0 < w) :
    Jw w 1 = 0 ∧ ∀ x ∈ Ioo (1 - w) 1, deriv (deriv (Jw w)) x * Jw w x = -2 := by
  sorry

/-- [DIR], §3, (3.4) and Corollary 5.12: there is a unique $w_0\in(0,1)$ with
$J_{w_0}(\frac12)=\frac12$. -/
theorem existsUnique_w₀ : ∃! w : ℝ, w ∈ Ioo 0 1 ∧ Jw w (1 / 2) = 1 / 2 := by
  sorry

open Classical in
/-- The constant $w_0$ ([DIR], (3.4)): the value such that $J_{w_0}(\frac12)=\frac12$ (unique in
$(0,1)$ by `Auto.DIR.existsUnique_w₀`; junk value $0$ if no such value existed). -/
noncomputable def w₀ : ℝ := if h : ∃ w : ℝ, w ∈ Ioo 0 1 ∧ Jw w (1 / 2) = 1 / 2 then h.choose else 0

/-- [DIR], §3: one computes $w_0\in[0.895,0.896]$. -/
theorem w₀_mem : w₀ ∈ Icc (0.895 : ℝ) 0.896 := by
  sorry

/-- [DIR], §1.3: there is a unique smooth function on $(\frac12,1)$, continuous at the endpoints,
satisfying $J''J=-2$, $J(\frac12)=\frac12$, $J(1)=0$ (uniqueness on $[\frac12,1]$). -/
theorem existsUnique_J :
    (∃ f, IsJ f) ∧ ∀ f g, IsJ f → IsJ g → EqOn f g (Icc (1 / 2) 1) := by
  sorry

/-- [DIR], §2.2: $J(x)$ and $L_\beta(1-x)$ are equal to $\frac12$ at $x=\frac12$. -/
theorem J_half_eq_L_half (β : ℝ) : J (1 / 2) = 1 / 2 ∧ L β (1 - 1 / 2) = 1 / 2 := by
  sorry

/-- **(3.4)** ([DIR], §3). With $J$ the function of Theorem 1.7,
$$J(x)=J_{w_0}(x)$$
(for $x\in[\frac12,1]$), where $w_0$ is such that $J_{w_0}(\frac12)=\frac12$. -/
theorem eqn_3_4 (x : ℝ) (hx : x ∈ Icc (1 / 2 : ℝ) 1) : J x = Jw w₀ x := by
  sorry

section Proof_Lemma_3_2

variable (I : ℝ → ℝ) (a b : ℝ) (hI : ContDiffOn ℝ 2 I (Ioo a b))
  (hI0 : ∀ x ∈ Ioo a b, 0 ≤ I x) (hII : ∀ x ∈ Ioo a b, I x * deriv (deriv I) x = -1)

include hI hI0 hII
/-- [DIR], proof of Lemma 3.2: the first claim follows from $I''=-1/I\le0$. -/
theorem lemma_3_2_deriv2 (x : ℝ) (hx : x ∈ Ioo a b) :
    deriv (deriv I) x = -1 / I x ∧ -1 / I x ≤ 0 := by
  sorry

/-- [DIR], proof of Lemma 3.2: $((I')^2)'=2I'I''=-2I'/I$. -/
theorem lemma_3_2_sq_deriv (x : ℝ) (hx : x ∈ Ioo a b) :
    deriv (fun t ↦ deriv I t ^ 2) x = 2 * deriv I x * deriv (deriv I) x ∧
      2 * deriv I x * deriv (deriv I) x = -2 * deriv I x / I x := by
  sorry

/-- [DIR], proof of Lemma 3.2:
$((I')^2)''=-2I''/I+2(I')^2/I^2=2(1+(I')^2)/I^2\ge0$. -/
theorem lemma_3_2_sq_deriv2 (x : ℝ) (hx : x ∈ Ioo a b) :
    deriv (deriv (fun t ↦ deriv I t ^ 2)) x =
        -2 * deriv (deriv I) x / I x + 2 * deriv I x ^ 2 / I x ^ 2 ∧
      -2 * deriv (deriv I) x / I x + 2 * deriv I x ^ 2 / I x ^ 2 =
        2 * (1 + deriv I x ^ 2) / I x ^ 2 ∧
      2 * (1 + deriv I x ^ 2) / I x ^ 2 ≥ 0 := by
  sorry

end Proof_Lemma_3_2

/-- **Lemma 3.2** ([DIR]). If a non-negative function $I$ solves $I\cdot I''=-1$ (on an open
interval $(a,b)$), then $I$ is concave and $(I')^2$ is convex (there). -/
theorem lemma_3_2 (I : ℝ → ℝ) (a b : ℝ) (hI : ContDiffOn ℝ 2 I (Ioo a b))
    (hI0 : ∀ x ∈ Ioo a b, 0 ≤ I x) (hII : ∀ x ∈ Ioo a b, I x * deriv (deriv I) x = -1) :
    ConcaveOn ℝ (Ioo a b) I ∧ ConvexOn ℝ (Ioo a b) (fun x ↦ deriv I x ^ 2) := by
  sorry

section Proof_Proposition_3_3

variable (I : ℝ → ℝ) (a b : ℝ) (hIc : ContinuousOn I (Icc a b))
  (hI : ContDiffOn ℝ 2 I (Ioo a b)) (hI0 : ∀ x ∈ Icc a b, 0 ≤ I x)
  (hII : ∀ x ∈ Ioo a b, deriv (deriv I) x * I x = -1) (hI' : ∀ x ∈ Ioo a b, deriv I x ≤ 0)

include hIc hI hI0 hII hI'
/-- [DIR], proof of Proposition 3.3: with $c=\frac{x+y}2$, $u=\frac{y-x}2$, $c_*=\min(c-a,b-c)$,
(3.5) amounts to $\sqrt{2u^2+I(c+u)^2}\ge2I(c)-I(c-u)$ for all $u\in[0,c_*]$. -/
theorem prop_3_3_reduction (c : ℝ) (hc : c ∈ Icc a b) (u : ℝ) (hu : u ∈ Icc 0 (min (c -
    a) (b - c))) :
    (√(1 / 2 * ((c + u) - (c - u)) ^ 2 + I (c + u) ^ 2) + I (c - u) ≥ 2 * I c ↔
      √(2 * u ^ 2 + I (c + u) ^ 2) ≥ 2 * I c - I (c - u)) := by
  sorry

/-- [DIR], proof of Proposition 3.3: $2I(c)-I(c-u)\ge0$ (by concavity of $I$), so the inequality is
equivalent to $2u^2+I(c+u)^2\ge4I(c)^2+I(c-u)^2-4I(c)I(c-u)$. -/
theorem prop_3_3_squared (c : ℝ) (hc : c ∈ Icc a b) (u : ℝ)
    (hu : u ∈ Icc 0 (min (c - a) (b - c))) :
    2 * I c - I (c - u) ≥ 0 ∧
    (√(2 * u ^ 2 + I (c + u) ^ 2) ≥ 2 * I c - I (c - u) ↔
      2 * u ^ 2 + I (c + u) ^ 2 ≥ 4 * I c ^ 2 + I (c - u) ^ 2 - 4 * I c * I (c - u)) := by
  sorry

omit hIc hI hI0 hII hI' in
/-- The function
$G_c(u)=I(c+u)^2-I(c-u)^2+2u^2-4I(c)^2+4I(c)I(c-u)$ ([DIR], proof of Proposition 3.3). -/
noncomputable def dirGc (c u : ℝ) : ℝ :=
  I (c + u) ^ 2 - I (c - u) ^ 2 + 2 * u ^ 2 - 4 * I c ^ 2 + 4 * I c * I (c - u)

/-- [DIR], proof of Proposition 3.3:
$G_c'(u)=2I'(c+u)I(c+u)+2I'(c-u)I(c-u)+4u-4I(c)I'(c-u)$ (for $c\pm u\in(a,b)$). -/
theorem prop_3_3_Gc_deriv (c u : ℝ) (hcu : c + u ∈ Ioo a b) (hcu' : c - u ∈ Ioo a b) :
    deriv (dirGc I c) u = 2 * deriv I (c + u) * I (c + u) + 2 * deriv I (c - u) * I (c - u) +
      4 * u - 4 * I c * deriv I (c - u) := by
  sorry

/-- [DIR], proof of Proposition 3.3:
$G_c''(u)=2(I'(c+u)^2-I'(c-u)^2)+4(1-\frac{I(c)}{I(c-u)})$, where $I\cdot I''=-1$ was used. -/
theorem prop_3_3_Gc_deriv2 (c u : ℝ) (hcu : c + u ∈ Ioo a b) (hcu' : c - u ∈ Ioo a b) :
    deriv (deriv (dirGc I c)) u =
      2 * (deriv I (c + u) ^ 2 - deriv I (c - u) ^ 2) + 4 * (1 - I c / I (c - u)) := by
  sorry

/-- [DIR], proof of Proposition 3.3: since $I$ is decreasing on $\mathcal{I}$,
$I(c-u)\ge I(c)$, so $G_c''(u)\ge2(I'(c+u)^2-I'(c-u)^2)$. -/
theorem prop_3_3_Gc_deriv2_ge (c u : ℝ) (hu : 0 ≤ u) (hcu : c + u ∈ Ioo a b)
    (hcu' : c - u ∈ Ioo a b) :
    I (c - u) ≥ I c ∧
      deriv (deriv (dirGc I c)) u ≥ 2 * (deriv I (c + u) ^ 2 - deriv I (c - u) ^ 2) := by
  sorry

omit hIc hI hI0 hII hI' in
/-- [DIR], proof of Proposition 3.3: recall that if $f$ is convex, then for all $x\le y$,
$f(y)-f(x)\ge(y-x)f'(x)$ (for $f$ convex on an open interval containing $x,y$ and differentiable
at $x$). -/
theorem convex_sub_ge (f : ℝ → ℝ) (s : Set ℝ) (hs : IsOpen s) (hf : ConvexOn ℝ s f)
    (x y : ℝ) (hx : x ∈ s) (hy : y ∈ s) (hxy : x ≤ y) (hfx : DifferentiableAt ℝ f x) :
    f y - f x ≥ (y - x) * deriv f x := by
  sorry

/-- [DIR], proof of Proposition 3.3: since $(I')^2$ is convex by Lemma 3.2,
$I'(c+u)^2-I'(c-u)^2\ge2u((I')^2)'(c-u)$. -/
theorem prop_3_3_sq_diff (c u : ℝ) (hu : 0 ≤ u) (hcu : c + u ∈ Ioo a b)
    (hcu' : c - u ∈ Ioo a b) :
    deriv I (c + u) ^ 2 - deriv I (c - u) ^ 2 ≥ 2 * u * deriv (fun t ↦ deriv I t ^ 2) (c - u) := by
  sorry

/-- [DIR], proof of Proposition 3.3: observe $((I')^2)'=2I'\cdot I''=-2I'/I\ge0$, since $I'\le0$ on
the interval $\mathcal{I}$. -/
theorem prop_3_3_sq_deriv_nonneg (t : ℝ) (ht : t ∈ Ioo a b) :
    deriv (fun s ↦ deriv I s ^ 2) t = 2 * deriv I t * deriv (deriv I) t ∧
      2 * deriv I t * deriv (deriv I) t = -2 * deriv I t / I t ∧ -2 * deriv I t / I t ≥ 0 := by
  sorry

/-- [DIR], proof of Proposition 3.3: thus $G_c''\ge0$ on $[0,c_*]$ (in the interior); since
$G_c'(0)=0$ we must have $G_c'\ge0$ on $[0,c_*]$; since $G_c(0)=0$, also $G_c\ge0$ on $[0,c_*]$,
as required. -/
theorem prop_3_3_Gc_nonneg (c : ℝ) (hc : c ∈ Ioo a b) :
    (∀ u ∈ Ioo 0 (min (c - a) (b - c)), deriv (deriv (dirGc I c)) u ≥ 0) ∧
    deriv (dirGc I c) 0 = 0 ∧
    (∀ u ∈ Ico 0 (min (c - a) (b - c)), deriv (dirGc I c) u ≥ 0) ∧
    dirGc I c 0 = 0 ∧
    (∀ u ∈ Icc 0 (min (c - a) (b - c)), dirGc I c u ≥ 0) := by
  sorry

end Proof_Proposition_3_3

/-- **Proposition 3.3** ([DIR]). Let $I$ be a non-negative function so that $I''\cdot I=-1$ and
$I'\le0$ hold on an interval $\mathcal{I}=[a,b]$ (we assume $I$ continuous on $[a,b]$ and $C^2$ on
$(a,b)$). Then for all $x,y\in\mathcal{I}$ with $x\le y$,
$$\sqrt{\tfrac12(y-x)^2+I(y)^2}+I(x)\ge2I(\tfrac{x+y}2). \tag{3.5}$$ -/
theorem prop_3_3 (I : ℝ → ℝ) (a b : ℝ) (hIc : ContinuousOn I (Icc a b))
    (hI : ContDiffOn ℝ 2 I (Ioo a b)) (hI0 : ∀ x ∈ Icc a b, 0 ≤ I x)
    (hII : ∀ x ∈ Ioo a b, deriv (deriv I) x * I x = -1) (hI' : ∀ x ∈ Ioo a b, deriv I x ≤ 0)
    (x y : ℝ) (hx : x ∈ Icc a b) (hy : y ∈ Icc a b) (hxy : x ≤ y) :
    √(1 / 2 * (y - x) ^ 2 + I y ^ 2) + I x ≥ 2 * I ((x + y) / 2) := by
  sorry

/-- **Remark 3.6** ([DIR]). The range of $x,y$ is optimal: if $x<1-\frac w2$, the inequality fails,
because $J_w'$ changes sign at $1-\frac w2$, so the necessary condition $I'\le0$ in Proposition
3.3 is not satisfied. (Formalized: $J_w'(1-\frac w2)=0$, $J_w'>0$ on $(1-w,1-\frac w2)$, $J_w'<0$
on $(1-\frac w2,1)$, and for every $x\in[1-w,1-\frac w2)$ the inequality of Corollary 3.5 fails
for some $y\in(x,1]$.) -/
theorem rem_3_6 (w : ℝ) (hw : 0 < w) (hw1 : w ≤ 1) :
    deriv (Jw w) (1 - w / 2) = 0 ∧ (∀ x ∈ Ioo (1 - w) (1 - w / 2), deriv (Jw w) x > 0) ∧
    (∀ x ∈ Ioo (1 - w / 2) 1, deriv (Jw w) x < 0) ∧
    ∀ x ∈ Ico (1 - w) (1 - w / 2), ∃ y ∈ Ioc x 1,
      √((y - x) ^ 2 + Jw w y ^ 2) + Jw w x < 2 * Jw w ((x + y) / 2) := by
  sorry

