/-! ### Calculus helpers -/

/-- A function that is $C^2$ on an open set is differentiable at each point of it, and so is its
derivative. -/
theorem contDiffOn_two_differentiableAt {f : ℝ → ℝ} {s : Set ℝ} (hs : IsOpen s)
    (hf : ContDiffOn ℝ 2 f s) {x : ℝ} (hx : x ∈ s) :
    DifferentiableAt ℝ f x ∧ DifferentiableAt ℝ (deriv f) x := by
  have h := (contDiffOn_succ_iff_deriv_of_isOpen (n := 1) hs).1 hf
  exact ⟨(h.1 x hx).differentiableAt (hs.mem_nhds hx),
    ((h.2.2.differentiableOn one_ne_zero) x hx).differentiableAt (hs.mem_nhds hx)⟩

/-- For a function that is $C^2$ on an open set, the second derivative is continuous there. -/
theorem contDiffOn_two_continuousOn_deriv2 {f : ℝ → ℝ} {s : Set ℝ} (hs : IsOpen s)
    (hf : ContDiffOn ℝ 2 f s) : ContinuousOn (deriv (deriv f)) s := by
  have h := (contDiffOn_succ_iff_deriv_of_isOpen (n := 1) hs).1 hf
  have h2 := (contDiffOn_succ_iff_deriv_of_isOpen (n := 0) hs).1 h.2.2
  exact h2.2.2.continuousOn

/-- Maximum principle: if $h$ is continuous on $[a,b]$, $h(a),h(b)\le0$, and $h''>0$ at every
interior point where $h>0$, then $h\le0$ on $[a,b]$. -/
theorem max_principle_aux {h : ℝ → ℝ} {a b : ℝ} (hc : ContinuousOn h (Icc a b))
    (hd : ∀ x ∈ Ioo a b, 0 < h x → 0 < deriv (deriv h) x) (ha : h a ≤ 0) (hb : h b ≤ 0) :
    ∀ x ∈ Icc a b, h x ≤ 0 := by
  intro x hx
  by_contra hpos
  rw [not_le] at hpos
  obtain ⟨c, hcI, hcmax⟩ := isCompact_Icc.exists_isMaxOn ⟨x, hx⟩ hc
  have hcpos : 0 < h c := hpos.trans_le (hcmax hx)
  have hca : c ≠ a := fun e ↦ by rw [e] at hcpos; linarith
  have hcb : c ≠ b := fun e ↦ by rw [e] at hcpos; linarith
  have hcI' : c ∈ Ioo a b := ⟨lt_of_le_of_ne hcI.1 (Ne.symm hca), lt_of_le_of_ne hcI.2 hcb⟩
  have hev : ∀ᶠ t in 𝓝 c, 0 < h t ∧ t ∈ Ioo a b :=
    ((hc.continuousAt (Icc_mem_nhds hcI'.1 hcI'.2)).eventually (lt_mem_nhds hcpos)).and
      (Ioo_mem_nhds hcI'.1 hcI'.2)
  obtain ⟨ε, hε, hεP⟩ := Metric.eventually_nhds_iff.1 hev
  have hP : ∀ t ∈ Icc (c - ε / 2) (c + ε / 2), 0 < h t ∧ t ∈ Ioo a b := by
    intro t ht
    apply hεP
    rw [Real.dist_eq, abs_lt]
    constructor <;> linarith [ht.1, ht.2]
  have hsub : Icc (c - ε / 2) (c + ε / 2) ⊆ Icc a b := fun t ht ↦ Ioo_subset_Icc_self (hP t ht).2
  have hconv : StrictConvexOn ℝ (Icc (c - ε / 2) (c + ε / 2)) h := by
    refine strictConvexOn_of_deriv2_pos (convex_Icc _ _) (hc.mono hsub) ?_
    intro t ht
    rw [interior_Icc] at ht
    have := hP t (Ioo_subset_Icc_self ht)
    simpa using hd t this.2 this.1
  have h1 : c - ε / 2 ∈ Icc (c - ε / 2) (c + ε / 2) := ⟨le_rfl, by linarith⟩
  have h2 : c + ε / 2 ∈ Icc (c - ε / 2) (c + ε / 2) := ⟨by linarith, le_rfl⟩
  have key := hconv.2 h1 h2 (by linarith) (by norm_num : (0 : ℝ) < 2⁻¹)
    (by norm_num : (0 : ℝ) < 2⁻¹)
    (by norm_num)
  have hmid : (2⁻¹ : ℝ) • (c - ε / 2) + (2⁻¹ : ℝ) • (c + ε / 2) = c := by
    simp only [smul_eq_mul]; ring
  rw [hmid] at key
  have m1 : h (c - ε / 2) ≤ h c := hcmax (hsub h1)
  have m2 : h (c + ε / 2) ≤ h c := hcmax (hsub h2)
  simp only [smul_eq_mul] at key
  linarith

/-! ### The standard Gaussian density and distribution function -/

/-- The standard Gaussian density $\varphi(t)=(2\pi)^{-1/2}e^{-t^2/2}$ (definitionally equal to
`Auto.DIR.φ`). -/
noncomputable def gDens (t : ℝ) : ℝ := (2 * π) ^ (-(2⁻¹ : ℝ)) * exp (-t ^ 2 / 2)

/-- The standard Gaussian distribution function $\Phi(t)=\int_{-\infty}^t\varphi$ (definitionally
equal to `Auto.DIR.Φ`). -/
noncomputable def gCDF (t : ℝ) : ℝ := ∫ s in Iic t, gDens s

/-- The inverse $\Phi^{-1}$ of the Gaussian distribution function (as `Function.invFun`). -/
noncomputable def gInv (x : ℝ) : ℝ := Function.invFun gCDF x

/-- The Gaussian isoperimetric profile $I=\varphi\circ\Phi^{-1}$ on $(0,1)$, $0$ elsewhere
(definitionally equal to `Auto.DIR.I`). -/
noncomputable def gProf (x : ℝ) : ℝ := if 0 < x ∧ x < 1 then gDens (gInv x) else 0

/-- The normalizing constant: $(2\pi)^{-1/2}=1/\sqrt{2\pi}$. -/
theorem gConst_eq : (2 * π) ^ (-(2⁻¹ : ℝ)) = (√(2 * π))⁻¹ := by
  rw [rpow_neg (by positivity), sqrt_eq_rpow, inv_eq_one_div 2]

/-- The normalizing constant is positive. -/
theorem gConst_pos : 0 < (2 * π) ^ (-(2⁻¹ : ℝ)) := by positivity

/-- $\varphi>0$. -/
theorem gDens_pos (t : ℝ) : 0 < gDens t := by unfold gDens; positivity

/-- $\varphi$ is even. -/
theorem gDens_neg (t : ℝ) : gDens (-t) = gDens t := by simp [gDens]

/-- $\varphi(0)=(2\pi)^{-1/2}$. -/
theorem gDens_zero : gDens 0 = (2 * π) ^ (-(2⁻¹ : ℝ)) := by simp [gDens]

/-- $\varphi$ is smooth. -/
theorem contDiff_gDens : ContDiff ℝ ∞ gDens := by
  unfold gDens; fun_prop

/-- $\varphi$ is continuous. -/
theorem continuous_gDens : Continuous gDens := contDiff_gDens.continuous

/-- $\varphi'(t)=-t\varphi(t)$. -/
theorem hasDerivAt_gDens (t : ℝ) : HasDerivAt gDens (-t * gDens t) t := by
  unfold gDens
  have h : HasDerivAt (fun s : ℝ ↦ -s ^ 2 / 2) (-t) t := by
    have := ((hasDerivAt_pow 2 t).neg).div_const 2
    convert this using 1; push_cast; ring
  convert (h.exp).const_mul ((2 * π) ^ (-(2⁻¹ : ℝ))) using 1
  ring

/-- $\varphi$ is antitone on $[0,\infty)$. -/
theorem gDens_antitoneOn : AntitoneOn gDens (Ici 0) := by
  intro a ha b hb hab
  unfold gDens
  gcongr

/-- $\varphi$ is strictly antitone on $[0,\infty)$. -/
theorem gDens_strictAntiOn : StrictAntiOn gDens (Ici 0) := by
  intro a ha b hb hab
  unfold gDens
  have : -b ^ 2 / 2 < -a ^ 2 / 2 := by simp only [mem_Ici] at ha; nlinarith
  exact mul_lt_mul_of_pos_left (exp_lt_exp.2 this) gConst_pos

/-- $\varphi$ is integrable. -/
theorem integrable_gDens : Integrable gDens := by
  have h := (integrable_exp_neg_mul_sq (b := 2⁻¹) (by norm_num)).const_mul
    ((2 * π) ^ (-(2⁻¹ : ℝ)))
  refine h.congr (ae_of_all _ fun t ↦ ?_)
  simp only [gDens]; congr 2; ring

/-- $\int\varphi=1$. -/
theorem integral_gDens : ∫ t, gDens t = 1 := by
  have h : (fun t ↦ gDens t) = fun t ↦ (2 * π) ^ (-(2⁻¹ : ℝ)) * exp (-2⁻¹ * t ^ 2) := by
    funext t; simp only [gDens]; congr 2; ring
  rw [h, integral_const_mul, integral_gaussian, gConst_eq]
  have : π / 2⁻¹ = 2 * π := by ring
  rw [this, inv_mul_cancel₀ (by positivity)]

/-- $\Phi(b)-\Phi(a)=\int_a^b\varphi$. -/
theorem gCDF_sub (a b : ℝ) : gCDF b - gCDF a = ∫ t in a..b, gDens t :=
  intervalIntegral.integral_Iic_sub_Iic integrable_gDens.integrableOn integrable_gDens.integrableOn

/-- $\Phi(t)=\Phi(0)+\int_0^t\varphi$. -/
theorem gCDF_eq (t : ℝ) : gCDF t = gCDF 0 + ∫ s in (0 : ℝ)..t, gDens s := by
  rw [← gCDF_sub]; ring

/-- $\Phi'=\varphi$. -/
theorem hasDerivAt_gCDF (t : ℝ) : HasDerivAt gCDF (gDens t) t := by
  have h := (continuous_gDens.integral_hasStrictDerivAt 0 t).hasDerivAt.const_add (gCDF 0)
  have he : gCDF = fun t ↦ gCDF 0 + ∫ s in (0 : ℝ)..t, gDens s := funext gCDF_eq
  rw [he]; exact h

/-- $\Phi$ is differentiable. -/
theorem differentiable_gCDF : Differentiable ℝ gCDF := fun t ↦ (hasDerivAt_gCDF t).differentiableAt

/-- $\Phi$ is continuous. -/
theorem continuous_gCDF : Continuous gCDF := differentiable_gCDF.continuous

/-- $\Phi'=\varphi$ (with `deriv`). -/
theorem deriv_gCDF : deriv gCDF = gDens := funext fun t ↦ (hasDerivAt_gCDF t).deriv

/-- $\Phi$ is strictly increasing. -/
theorem strictMono_gCDF : StrictMono gCDF :=
  strictMono_of_deriv_pos fun t ↦ by rw [deriv_gCDF]; exact gDens_pos t

/-- $\Phi(-t)=1-\Phi(t)$. -/
theorem gCDF_neg (t : ℝ) : gCDF (-t) = 1 - gCDF t := by
  have h1 : gCDF (-t) = ∫ s in Ioi t, gDens s := by
    rw [gCDF, ← integral_comp_neg_Ioi]; simp only [gDens_neg]
  have h2 := integral_add_compl (measurableSet_Iic (a := t)) integrable_gDens
  rw [compl_Iic, integral_gDens] at h2
  rw [h1, gCDF]; linarith

/-- $\Phi(0)=\frac12$. -/
theorem gCDF_zero : gCDF 0 = 2⁻¹ := by
  have := gCDF_neg 0; rw [neg_zero] at this; linarith

/-- $\Phi(t)\to1$ as $t\to\infty$. -/
theorem tendsto_gCDF_atTop : Tendsto gCDF atTop (𝓝 1) := by
  have h := tendsto_setIntegral_of_monotone (μ := volume) (f := gDens) (s := fun t : ℝ ↦ Iic t)
    (fun _ ↦ measurableSet_Iic) (fun _ _ h ↦ Iic_subset_Iic.2 h)
    (by rw [iUnion_Iic]; exact integrable_gDens.integrableOn)
  rw [iUnion_Iic, setIntegral_univ, integral_gDens] at h
  exact h

/-- $\Phi(t)\to0$ as $t\to-\infty$. -/
theorem tendsto_gCDF_atBot : Tendsto gCDF atBot (𝓝 0) := by
  have h : Tendsto (fun t ↦ 1 - gCDF (-t)) atBot (𝓝 (1 - 1)) :=
    tendsto_const_nhds.sub (tendsto_gCDF_atTop.comp tendsto_neg_atBot_atTop)
  rw [sub_self] at h
  refine h.congr fun t ↦ ?_
  rw [gCDF_neg]; ring

/-- $0<\Phi<1$. -/
theorem gCDF_mem_Ioo (t : ℝ) : gCDF t ∈ Ioo 0 1 := by
  constructor
  · have h := strictMono_gCDF.monotone.le_of_tendsto tendsto_gCDF_atBot (t - 1)
    exact h.trans_lt (strictMono_gCDF (by linarith))
  · have h := strictMono_gCDF.monotone.ge_of_tendsto tendsto_gCDF_atTop (t + 1)
    exact (strictMono_gCDF (by linarith)).trans_le h

/-- $\Phi$ maps onto $(0,1)$. -/
theorem exists_gCDF_eq {x : ℝ} (hx : x ∈ Ioo 0 1) : ∃ t, gCDF t = x := by
  have h1 : ∃ a, gCDF a ≤ x := by
    obtain ⟨a, ha⟩ := (tendsto_gCDF_atBot.eventually (gt_mem_nhds hx.1)).exists
    exact ⟨a, ha.le⟩
  have h2 : ∃ b, x ≤ gCDF b := by
    obtain ⟨b, hb⟩ := (tendsto_gCDF_atTop.eventually (lt_mem_nhds hx.2)).exists
    exact ⟨b, hb.le⟩
  exact mem_range_of_exists_le_of_exists_ge continuous_gCDF h1 h2

/-- $\Phi(\Phi^{-1}(x))=x$ for $x\in(0,1)$. -/
theorem gCDF_gInv {x : ℝ} (hx : x ∈ Ioo 0 1) : gCDF (gInv x) = x :=
  Function.invFun_eq (exists_gCDF_eq hx)

/-- $\Phi^{-1}(\Phi(t))=t$. -/
theorem gInv_gCDF (t : ℝ) : gInv (gCDF t) = t :=
  Function.leftInverse_invFun strictMono_gCDF.injective t

/-- $\Phi^{-1}(x)=t$ iff $\Phi(t)=x$, for $x\in(0,1)$. -/
theorem gInv_eq_iff {x t : ℝ} (hx : x ∈ Ioo 0 1) : gInv x = t ↔ gCDF t = x := by
  constructor
  · rintro rfl; exact gCDF_gInv hx
  · rintro rfl; exact gInv_gCDF t

/-- $\Phi^{-1}$ is strictly increasing on $(0,1)$. -/
theorem gInv_strictMonoOn : StrictMonoOn gInv (Ioo 0 1) := by
  intro x hx y hy hxy
  rw [← strictMono_gCDF.lt_iff_lt, gCDF_gInv hx, gCDF_gInv hy]
  exact hxy

/-- $t\le\Phi^{-1}(x)$ iff $\Phi(t)\le x$, for $x\in(0,1)$. -/
theorem le_gInv_iff {x t : ℝ} (hx : x ∈ Ioo 0 1) : t ≤ gInv x ↔ gCDF t ≤ x := by
  rw [← strictMono_gCDF.le_iff_le, gCDF_gInv hx]

/-- $\Phi^{-1}(x)\le t$ iff $x\le\Phi(t)$, for $x\in(0,1)$. -/
theorem gInv_le_iff {x t : ℝ} (hx : x ∈ Ioo 0 1) : gInv x ≤ t ↔ x ≤ gCDF t := by
  rw [← strictMono_gCDF.le_iff_le, gCDF_gInv hx]

/-- $\Phi^{-1}(\frac12)=0$. -/
theorem gInv_half : gInv 2⁻¹ = 0 := by
  rw [← gCDF_zero, gInv_gCDF]

/-- $\Phi^{-1}(1-x)=-\Phi^{-1}(x)$ for $x\in(0,1)$. -/
theorem gInv_one_sub {x : ℝ} (hx : x ∈ Ioo 0 1) : gInv (1 - x) = -gInv x := by
  rw [gInv_eq_iff ⟨by linarith [hx.2], by linarith [hx.1]⟩, gCDF_neg, gCDF_gInv hx]

/-- $\Phi^{-1}$ is continuous at every point of $(0,1)$. -/
theorem continuousAt_gInv {x : ℝ} (hx : x ∈ Ioo 0 1) : ContinuousAt gInv x := by
  refine gInv_strictMonoOn.continuousAt_of_image_mem_nhds (Ioo_mem_nhds hx.1 hx.2) ?_
  have : gInv '' Ioo 0 1 = univ := by
    refine eq_univ_of_forall fun t ↦ ⟨gCDF t, gCDF_mem_Ioo t, gInv_gCDF t⟩
  rw [this]; exact univ_mem

/-- $(\Phi^{-1})'(x)=1/\varphi(\Phi^{-1}(x))$ for $x\in(0,1)$. -/
theorem hasDerivAt_gInv {x : ℝ} (hx : x ∈ Ioo 0 1) :
    HasDerivAt gInv (gDens (gInv x))⁻¹ x := by
  refine HasDerivAt.of_local_left_inverse (continuousAt_gInv hx) (hasDerivAt_gCDF _)
    (gDens_pos _).ne' ?_
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using gCDF_gInv hy

/-- $\Phi^{-1}$ is differentiable on $(0,1)$. -/
theorem differentiableOn_gInv : DifferentiableOn ℝ gInv (Ioo 0 1) :=
  fun _ hx ↦ (hasDerivAt_gInv hx).differentiableAt.differentiableWithinAt

/-- $\Phi^{-1}$ is continuous on $(0,1)$. -/
theorem continuousOn_gInv : ContinuousOn gInv (Ioo 0 1) := differentiableOn_gInv.continuousOn

/-- $\Phi^{-1}$ is smooth on $(0,1)$. -/
theorem contDiffOn_gInv : ContDiffOn ℝ ∞ gInv (Ioo 0 1) := by
  have hF : ContDiff ℝ ∞ fun t ↦ (gDens t)⁻¹ :=
    contDiff_gDens.inv fun t ↦ (gDens_pos t).ne'
  have hd : EqOn (deriv gInv) (fun x ↦ (gDens (gInv x))⁻¹) (Ioo 0 1) :=
    fun x hx ↦ (hasDerivAt_gInv hx).deriv
  rw [contDiffOn_infty]
  intro n
  induction n with
  | zero => exact contDiffOn_zero.2 continuousOn_gInv
  | succ n ih =>
    rw [Nat.cast_add, Nat.cast_one, contDiffOn_succ_iff_deriv_of_isOpen isOpen_Ioo]
    refine ⟨differentiableOn_gInv, by simp, ?_⟩
    refine ContDiffOn.congr ?_ hd
    exact (hF.of_le (by exact_mod_cast le_top)).comp_contDiffOn ih

/-- $I(x)=\varphi(\Phi^{-1}(x))$ for $x\in(0,1)$. -/
theorem gProf_of_mem {x : ℝ} (hx : x ∈ Ioo 0 1) : gProf x = gDens (gInv x) := by
  simp [gProf, hx.1, hx.2]

/-- $I(x)=0$ for $x\notin(0,1)$. -/
theorem gProf_of_not_mem {x : ℝ} (hx : x ∉ Ioo 0 1) : gProf x = 0 := by
  unfold gProf
  split_ifs with h
  · exact absurd h hx
  · rfl

/-- $I(0)=0$. -/
theorem gProf_zero : gProf 0 = 0 := gProf_of_not_mem (by simp)

/-- $I(1)=0$. -/
theorem gProf_one : gProf 1 = 0 := gProf_of_not_mem (by simp)

/-- $I>0$ on $(0,1)$. -/
theorem gProf_pos {x : ℝ} (hx : x ∈ Ioo 0 1) : 0 < gProf x := by
  rw [gProf_of_mem hx]; exact gDens_pos _

/-- $I\ge0$. -/
theorem gProf_nonneg (x : ℝ) : 0 ≤ gProf x := by
  by_cases hx : x ∈ Ioo 0 1
  · exact (gProf_pos hx).le
  · rw [gProf_of_not_mem hx]

/-- $I(\Phi(t))=\varphi(t)$. -/
theorem gProf_gCDF (t : ℝ) : gProf (gCDF t) = gDens t := by
  rw [gProf_of_mem (gCDF_mem_Ioo t), gInv_gCDF]

/-- $I(\frac12)=(2\pi)^{-1/2}$. -/
theorem gProf_half : gProf 2⁻¹ = (2 * π) ^ (-(2⁻¹ : ℝ)) := by
  have h := gProf_gCDF 0
  rwa [gCDF_zero, gDens_zero] at h

/-- $I(1-x)=I(x)$. -/
theorem gProf_one_sub (x : ℝ) : gProf (1 - x) = gProf x := by
  by_cases hx : x ∈ Ioo 0 1
  · have hx' : 1 - x ∈ Ioo 0 1 := ⟨by linarith [hx.2], by linarith [hx.1]⟩
    rw [gProf_of_mem hx, gProf_of_mem hx', gInv_one_sub hx, gDens_neg]
  · have hx' : 1 - x ∉ Ioo 0 1 := fun h ↦ hx ⟨by linarith [h.2], by linarith [h.1]⟩
    rw [gProf_of_not_mem hx, gProf_of_not_mem hx']

/-- $I$ agrees with $\varphi\circ\Phi^{-1}$ near each point of $(0,1)$. -/
theorem gProf_eventuallyEq {x : ℝ} (hx : x ∈ Ioo 0 1) :
    gProf =ᶠ[𝓝 x] fun y ↦ gDens (gInv y) := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using gProf_of_mem hy

/-- $I'(x)=-\Phi^{-1}(x)$ for $x\in(0,1)$. -/
theorem hasDerivAt_gProf {x : ℝ} (hx : x ∈ Ioo 0 1) : HasDerivAt gProf (-gInv x) x := by
  have h := (hasDerivAt_gDens (gInv x)).comp x (hasDerivAt_gInv hx)
  refine (h.congr_of_eventuallyEq (gProf_eventuallyEq hx)).congr_deriv ?_
  have := (gDens_pos (gInv x)).ne'
  field_simp

/-- $I'=-\Phi^{-1}$ on $(0,1)$. -/
theorem deriv_gProf {x : ℝ} (hx : x ∈ Ioo 0 1) : deriv gProf x = -gInv x :=
  (hasDerivAt_gProf hx).deriv

/-- $I'=-\Phi^{-1}$ near each point of $(0,1)$. -/
theorem deriv_gProf_eventuallyEq {x : ℝ} (hx : x ∈ Ioo 0 1) :
    deriv gProf =ᶠ[𝓝 x] fun y ↦ -gInv y := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using deriv_gProf hy

/-- $I''(x)=-1/I(x)$ for $x\in(0,1)$. -/
theorem hasDerivAt_deriv_gProf {x : ℝ} (hx : x ∈ Ioo 0 1) :
    HasDerivAt (deriv gProf) (-(gProf x)⁻¹) x := by
  rw [gProf_of_mem hx]
  exact (hasDerivAt_gInv hx).neg.congr_of_eventuallyEq (deriv_gProf_eventuallyEq hx)

/-- $I''=-1/I$ on $(0,1)$. -/
theorem deriv2_gProf {x : ℝ} (hx : x ∈ Ioo 0 1) : deriv (deriv gProf) x = -(gProf x)⁻¹ :=
  (hasDerivAt_deriv_gProf hx).deriv

/-- $I\cdot I''=-1$ on $(0,1)$. -/
theorem gProf_mul_deriv2 {x : ℝ} (hx : x ∈ Ioo 0 1) : gProf x * deriv (deriv gProf) x = -1 := by
  rw [deriv2_gProf hx]; have := (gProf_pos hx).ne'; field_simp

/-- $I$ is smooth on $(0,1)$. -/
theorem contDiffOn_gProf : ContDiffOn ℝ ∞ gProf (Ioo 0 1) := by
  refine ContDiffOn.congr ?_ fun x hx ↦ gProf_of_mem hx
  exact contDiff_gDens.comp_contDiffOn contDiffOn_gInv

/-- $\Phi^{-1}(x)\to\infty$ as $x\to1^-$. -/
theorem tendsto_gInv_left_one : Tendsto gInv (𝓝[<] 1) atTop := by
  rw [tendsto_atTop]
  intro M
  have hM := (gCDF_mem_Ioo M).2
  filter_upwards [Ioo_mem_nhdsLT hM] with y hy
  have hy' : y ∈ Ioo 0 1 := ⟨(gCDF_mem_Ioo M).1.trans hy.1, hy.2⟩
  exact (le_gInv_iff hy').2 hy.1.le

/-- $\varphi(t)\to0$ as $t\to\infty$. -/
theorem tendsto_gDens_atTop : Tendsto gDens atTop (𝓝 0) := by
  have h : Tendsto (fun t : ℝ ↦ -t ^ 2 / 2) atTop atBot := by
    have h2 := (tendsto_pow_atTop (α := ℝ) two_ne_zero).atTop_div_const (r := 2) (by norm_num)
    refine (tendsto_neg_atTop_atBot.comp h2).congr fun t ↦ ?_
    simp [neg_div]
  have := (tendsto_exp_atBot.comp h).const_mul ((2 * π) ^ (-(2⁻¹ : ℝ)))
  rw [mul_zero] at this
  exact this

/-- $I$ is continuous on $[0,1]$. -/
theorem continuousOn_gProf : ContinuousOn gProf (Icc 0 1) := by
  have h1 : ContinuousWithinAt gProf (Icc 0 1) 1 := by
    have hI : Icc (0 : ℝ) 1 = insert 1 (Ico 0 1) := (Ico_insert_right zero_le_one).symm
    rw [hI, continuousWithinAt_insert_self, ContinuousWithinAt, gProf_one]
    refine Tendsto.mono_left ?_ (nhdsWithin_mono _ Ico_subset_Iio_self)
    refine (tendsto_gDens_atTop.comp tendsto_gInv_left_one).congr' ?_
    filter_upwards [Ioo_mem_nhdsLT (zero_lt_one' ℝ)] with y hy using (gProf_of_mem hy).symm
  have h0 : ContinuousWithinAt gProf (Icc 0 1) 0 := by
    have he : gProf = fun x ↦ gProf (1 - x) := funext fun x ↦ (gProf_one_sub x).symm
    rw [he]
    have hc : ContinuousWithinAt (fun x : ℝ ↦ 1 - x) (Icc 0 1) 0 := by fun_prop
    have hm : MapsTo (fun x : ℝ ↦ 1 - x) (Icc 0 1) (Icc 0 1) :=
      fun x hx ↦ ⟨by linarith [hx.2], by linarith [hx.1]⟩
    have h1' : ContinuousWithinAt gProf (Icc 0 1) ((fun x : ℝ ↦ 1 - x) 0) := by simpa using h1
    exact h1'.comp hc hm
  intro x hx
  rcases eq_or_lt_of_le hx.1 with h | h
  · rw [← h]; exact h0
  rcases eq_or_lt_of_le hx.2 with h' | h'
  · rw [h']; exact h1
  exact (contDiffOn_gProf.continuousOn x ⟨h, h'⟩).mono_of_mem_nhdsWithin
    (mem_nhdsWithin_of_mem_nhds (Ioo_mem_nhds h h')) |>.mono subset_rfl

/-- $I$ is strictly concave on $[0,1]$. -/
theorem strictConcaveOn_gProf : StrictConcaveOn ℝ (Icc 0 1) gProf := by
  refine strictConcaveOn_of_deriv2_neg (convex_Icc 0 1) continuousOn_gProf fun x hx ↦ ?_
  rw [interior_Icc] at hx
  simp only [Function.iterate_succ, Function.iterate_zero, Function.comp_apply, id]
  rw [deriv2_gProf hx, neg_lt_zero]
  exact inv_pos.2 (gProf_pos hx)

/-- $I(u)/u$ is strictly decreasing: $I(u)/u<I(v)/v$ for $0<v<u\le1$. -/
theorem gProf_div_lt {u v : ℝ} (hv : 0 < v) (hvu : v < u) (hu : u ≤ 1) :
    gProf u / u < gProf v / v := by
  have hu0 : 0 < u := hv.trans hvu
  have hθ : 0 < v / u := div_pos hv hu0
  have hθ1 : 0 < 1 - v / u := by rw [sub_pos, div_lt_one hu0]; exact hvu
  have h := strictConcaveOn_gProf.2 (show u ∈ Icc (0 : ℝ) 1 from ⟨hu0.le, hu⟩)
    (show (0 : ℝ) ∈ Icc (0 : ℝ) 1 from ⟨le_rfl, zero_le_one⟩) hu0.ne' hθ hθ1 (by ring)
  simp only [smul_eq_mul, mul_zero, add_zero, gProf_zero] at h
  rw [div_mul_cancel₀ v hu0.ne'] at h
  rw [div_lt_div_iff₀ hu0 hv]
  have : v / u * gProf u * u = v * gProf u := by field_simp
  nlinarith

/-- $\Phi^{-1}>0$ on $(\frac12,1)$. -/
theorem gInv_pos {x : ℝ} (hx : x ∈ Ioo 2⁻¹ 1) : 0 < gInv x := by
  rw [← gInv_half]
  exact gInv_strictMonoOn ⟨by norm_num, by norm_num⟩ ⟨by linarith [hx.1], hx.2⟩ hx.1

/-- $\Phi^{-1}<0$ on $(0,\frac12)$. -/
theorem gInv_neg {x : ℝ} (hx : x ∈ Ioo 0 2⁻¹) : gInv x < 0 := by
  rw [← gInv_half]
  exact gInv_strictMonoOn ⟨hx.1, by linarith [hx.2]⟩ ⟨by norm_num, by norm_num⟩ hx.2

/-- $I$ is strictly decreasing on $[\frac12,1]$. -/
theorem gProf_strictAntiOn : StrictAntiOn gProf (Icc 2⁻¹ 1) := by
  refine strictAntiOn_of_deriv_neg (convex_Icc _ _)
    (continuousOn_gProf.mono (Icc_subset_Icc (by norm_num) le_rfl)) fun x hx ↦ ?_
  rw [interior_Icc] at hx
  rw [deriv_gProf ⟨by linarith [hx.1], hx.2⟩, neg_lt_zero]
  exact gInv_pos hx

/-- $I$ is strictly increasing on $[0,\frac12]$. -/
theorem gProf_strictMonoOn : StrictMonoOn gProf (Icc 0 2⁻¹) := by
  refine strictMonoOn_of_deriv_pos (convex_Icc _ _)
    (continuousOn_gProf.mono (Icc_subset_Icc le_rfl (by norm_num))) fun x hx ↦ ?_
  rw [interior_Icc] at hx
  rw [deriv_gProf ⟨hx.1, by linarith [hx.2]⟩, neg_pos]
  exact gInv_neg hx

/-- $I\le I(\frac12)$. -/
theorem gProf_le_half (x : ℝ) : gProf x ≤ gProf 2⁻¹ := by
  by_cases hx : x ∈ Ioo 0 1
  · rcases le_total x 2⁻¹ with h | h
    · exact gProf_strictMonoOn.monotoneOn ⟨hx.1.le, h⟩ ⟨by norm_num, le_rfl⟩ h
    · exact gProf_strictAntiOn.antitoneOn ⟨le_rfl, by norm_num⟩ ⟨h, hx.2.le⟩ h
  · rw [gProf_of_not_mem hx]; exact gProf_nonneg _

/-- $I(x)<I(\frac12)$ for $x\ne\frac12$. -/
theorem gProf_lt_half {x : ℝ} (hx : x ≠ 2⁻¹) : gProf x < gProf 2⁻¹ := by
  have hpos : 0 < gProf 2⁻¹ := gProf_pos ⟨by norm_num, by norm_num⟩
  by_cases hx' : x ∈ Ioo 0 1
  · rcases lt_or_gt_of_ne hx with h | h
    · exact gProf_strictMonoOn ⟨hx'.1.le, h.le⟩ ⟨by norm_num, le_rfl⟩ h
    · exact gProf_strictAntiOn ⟨le_rfl, by norm_num⟩ ⟨h.le, hx'.2.le⟩ h
  · rw [gProf_of_not_mem hx']; exact hpos

/-! ### Uniqueness for $f\cdot f''=-k$ -/

/-- For $f,g$ $C^2$ on an open set $s$, $(f-g)''=f''-g''$ on $s$. -/
theorem deriv2_sub_of_contDiffOn {f g : ℝ → ℝ} {s : Set ℝ} (hs : IsOpen s)
    (hf : ContDiffOn ℝ 2 f s) (hg : ContDiffOn ℝ 2 g s) {x : ℝ} (hx : x ∈ s) :
    deriv (deriv (fun y ↦ f y - g y)) x = deriv (deriv f) x - deriv (deriv g) x := by
  have he : deriv (fun y ↦ f y - g y) =ᶠ[𝓝 x] fun y ↦ deriv f y - deriv g y := by
    filter_upwards [hs.mem_nhds hx] with y hy
    exact deriv_sub (contDiffOn_two_differentiableAt hs hf hy).1
      (contDiffOn_two_differentiableAt hs hg hy).1
  rw [he.deriv_eq]
  exact deriv_sub (contDiffOn_two_differentiableAt hs hf hx).2
    (contDiffOn_two_differentiableAt hs hg hx).2

/-- One half of the uniqueness for $f\cdot f''=-k$: if $f,g>0$ on $(a,b)$ solve
$ff''=gg''=-k$ ($k>0$) and $f\le g$ at the endpoints, then $f\le g$ on $[a,b]$. -/
theorem le_of_mul_deriv2_eq {f g : ℝ → ℝ} {a b k : ℝ} (hk : 0 < k)
    (hfc : ContinuousOn f (Icc a b)) (hgc : ContinuousOn g (Icc a b))
    (hf : ContDiffOn ℝ 2 f (Ioo a b)) (hg : ContDiffOn ℝ 2 g (Ioo a b))
    (hfp : ∀ x ∈ Ioo a b, 0 < f x) (hgp : ∀ x ∈ Ioo a b, 0 < g x)
    (hff : ∀ x ∈ Ioo a b, f x * deriv (deriv f) x = -k)
    (hgg : ∀ x ∈ Ioo a b, g x * deriv (deriv g) x = -k)
    (ha : f a ≤ g a) (hb : f b ≤ g b) : ∀ x ∈ Icc a b, f x ≤ g x := by
  have key := max_principle_aux (h := fun y ↦ f y - g y) (a := a) (b := b) (hfc.sub hgc)
    (fun x hx hpos ↦ ?_) (by simpa using ha) (by simpa using hb)
  · intro x hx; have := key x hx; linarith
  · rw [deriv2_sub_of_contDiffOn isOpen_Ioo hf hg hx]
    have h1 := hff x hx; have h2 := hgg x hx
    have hf0 := hfp x hx; have hg0 := hgp x hx
    have e1 : deriv (deriv f) x = -k / f x := by field_simp; linarith
    have e2 : deriv (deriv g) x = -k / g x := by field_simp; linarith
    rw [e1, e2]
    have : -k / f x - -k / g x = k * (f x - g x) / (f x * g x) := by field_simp; ring
    rw [this]; positivity

/-- Uniqueness for $f\cdot f''=-k$ ($k>0$) with positive solutions and equal boundary values. -/
theorem eqOn_of_mul_deriv2_eq {f g : ℝ → ℝ} {a b k : ℝ} (hk : 0 < k)
    (hfc : ContinuousOn f (Icc a b)) (hgc : ContinuousOn g (Icc a b))
    (hf : ContDiffOn ℝ 2 f (Ioo a b)) (hg : ContDiffOn ℝ 2 g (Ioo a b))
    (hfp : ∀ x ∈ Ioo a b, 0 < f x) (hgp : ∀ x ∈ Ioo a b, 0 < g x)
    (hff : ∀ x ∈ Ioo a b, f x * deriv (deriv f) x = -k)
    (hgg : ∀ x ∈ Ioo a b, g x * deriv (deriv g) x = -k)
    (ha : f a = g a) (hb : f b = g b) : EqOn f g (Icc a b) := fun x hx ↦
  le_antisymm (le_of_mul_deriv2_eq hk hfc hgc hf hg hfp hgp hff hgg ha.le hb.le x hx)
    (le_of_mul_deriv2_eq hk hgc hfc hg hf hgp hfp hgg hff ha.ge hb.ge x hx)

/-- A function continuous on $[a,b]$, positive at $a$ and without zeros in $(a,b)$ is positive on
$[a,b)$. -/
theorem pos_of_ne_zero_of_continuousOn {f : ℝ → ℝ} {a b : ℝ} (hfc : ContinuousOn f (Icc a b))
    (ha : 0 < f a) (hne : ∀ x ∈ Ioo a b, f x ≠ 0) : ∀ x ∈ Ico a b, 0 < f x := by
  intro x hx
  by_contra hneg
  rw [not_lt] at hneg
  obtain ⟨c, hc, hfc0⟩ := intermediate_value_Icc' hx.1 (hfc.mono (Icc_subset_Icc le_rfl hx.2.le))
    ⟨hneg, ha.le⟩
  have hca : c ≠ a := fun e ↦ by rw [e] at hfc0; linarith
  exact hne c ⟨lt_of_le_of_ne hc.1 (Ne.symm hca), hc.2.trans_lt hx.2⟩ hfc0

/-! ### The functions $J_w$ -/

/-- $J_w(x)=\sqrt2\,w\,I(w^{-1}(1-x))$ (definitionally equal to `Auto.DIR.Jw`). -/
noncomputable def gJw (w x : ℝ) : ℝ := √2 * w * gProf (w⁻¹ * (1 - x))

/-- $w^{-1}(1-x)\in(0,1)$ for $x\in(1-w,1)$. -/
theorem affine_mem_Ioo {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) :
    w⁻¹ * (1 - x) ∈ Ioo 0 1 := by
  rw [← div_eq_inv_mul]
  exact ⟨div_pos (by linarith [hx.2]) hw, (div_lt_one hw).2 (by linarith [hx.1])⟩

/-- $w^{-1}(1-x)\in[0,1]$ for $x\in[1-w,1]$. -/
theorem affine_mem_Icc {w x : ℝ} (hw : 0 < w) (hx : x ∈ Icc (1 - w) 1) :
    w⁻¹ * (1 - x) ∈ Icc 0 1 := by
  rw [← div_eq_inv_mul]
  exact ⟨div_nonneg (by linarith [hx.2]) hw.le, (div_le_one hw).2 (by linarith [hx.1])⟩

/-- $x\mapsto I(w^{-1}(1-x))$ is smooth on $(1-w,1)$. -/
theorem contDiffOn_gProf_affine {w : ℝ} (hw : 0 < w) :
    ContDiffOn ℝ ∞ (fun x ↦ gProf (w⁻¹ * (1 - x))) (Ioo (1 - w) 1) :=
  contDiffOn_gProf.comp (by fun_prop) fun _ hx ↦ affine_mem_Ioo hw hx

/-- $x\mapsto I(w^{-1}(1-x))$ is continuous on $[1-w,1]$. -/
theorem continuousOn_gProf_affine {w : ℝ} (hw : 0 < w) :
    ContinuousOn (fun x ↦ gProf (w⁻¹ * (1 - x))) (Icc (1 - w) 1) :=
  continuousOn_gProf.comp (by fun_prop) fun _ hx ↦ affine_mem_Icc hw hx

/-- $J_w$ is smooth on $(1-w,1)$. -/
theorem contDiffOn_gJw {w : ℝ} (hw : 0 < w) : ContDiffOn ℝ ∞ (gJw w) (Ioo (1 - w) 1) :=
  (contDiffOn_gProf_affine hw).const_smul (√2 * w) |>.congr fun _ _ ↦ rfl

/-- $J_w$ is continuous on $[1-w,1]$. -/
theorem continuousOn_gJw {w : ℝ} (hw : 0 < w) : ContinuousOn (gJw w) (Icc (1 - w) 1) :=
  (continuousOn_gProf_affine hw).const_smul (√2 * w) |>.congr fun _ _ ↦ rfl

/-- $J_w(1)=0$. -/
theorem gJw_one (w : ℝ) : gJw w 1 = 0 := by simp [gJw, gProf_zero]

/-- $J_w>0$ on $(1-w,1)$. -/
theorem gJw_pos {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) : 0 < gJw w x := by
  unfold gJw
  have := gProf_pos (affine_mem_Ioo hw hx)
  positivity

/-- $J_w$ is symmetric about $1-\frac w2$: $J_w(2-w-x)=J_w(x)$. -/
theorem gJw_reflect {w : ℝ} (hw : 0 < w) (x : ℝ) : gJw w (2 - w - x) = gJw w x := by
  unfold gJw
  rw [← gProf_one_sub (w⁻¹ * (1 - x))]
  congr 2
  field_simp
  ring

/-- $J_w'(x)=\sqrt2\,\Phi^{-1}(w^{-1}(1-x))$ on $(1-w,1)$. -/
theorem hasDerivAt_gJw {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) :
    HasDerivAt (gJw w) (√2 * gInv (w⁻¹ * (1 - x))) x := by
  have ha : HasDerivAt (fun x : ℝ ↦ w⁻¹ * (1 - x)) (-w⁻¹) x := by
    simpa using ((hasDerivAt_id x).const_sub 1).const_mul w⁻¹
  have h := ((hasDerivAt_gProf (affine_mem_Ioo hw hx)).comp x ha).const_mul (√2 * w)
  refine HasDerivAt.congr_deriv (f := gJw w) h ?_
  field_simp

/-- $J_w'(x)=\sqrt2\,\Phi^{-1}(w^{-1}(1-x))$ near each point of $(1-w,1)$. -/
theorem deriv_gJw_eventuallyEq {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) :
    deriv (gJw w) =ᶠ[𝓝 x] fun y ↦ √2 * gInv (w⁻¹ * (1 - y)) := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using (hasDerivAt_gJw hw hy).deriv

/-- $J_w''(x)=-\sqrt2/(w\,I(w^{-1}(1-x)))$ on $(1-w,1)$. -/
theorem hasDerivAt_deriv_gJw {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) :
    HasDerivAt (deriv (gJw w)) (-(√2 * w⁻¹ * (gProf (w⁻¹ * (1 - x)))⁻¹)) x := by
  have hu := affine_mem_Ioo hw hx
  have ha : HasDerivAt (fun x : ℝ ↦ w⁻¹ * (1 - x)) (-w⁻¹) x := by
    simpa using ((hasDerivAt_id x).const_sub 1).const_mul w⁻¹
  have h := ((hasDerivAt_gInv hu).comp x ha).const_mul √2
  refine (h.congr_of_eventuallyEq (deriv_gJw_eventuallyEq hw hx)).congr_deriv ?_
  rw [gProf_of_mem hu]
  ring

/-- $J_w''\cdot J_w=-2$ on $(1-w,1)$. -/
theorem gJw_deriv2_mul {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) :
    deriv (deriv (gJw w)) x * gJw w x = -2 := by
  rw [(hasDerivAt_deriv_gJw hw hx).deriv]
  have hp := (gProf_pos (affine_mem_Ioo hw hx)).ne'
  unfold gJw
  have h2 : √2 * √2 = 2 := Real.mul_self_sqrt (by norm_num)
  set p := gProf (w⁻¹ * (1 - x))
  calc -(√2 * w⁻¹ * p⁻¹) * (√2 * w * p) = -((√2 * √2) * (w⁻¹ * w) * (p⁻¹ * p)) := by ring
    _ = -2 := by rw [h2, inv_mul_cancel₀ hw.ne', inv_mul_cancel₀ hp]; ring

/-- $J_w'(1-\frac w2)=0$, $J_w'>0$ on $(1-w,1-\frac w2)$ and $J_w'<0$ on $(1-\frac w2,1)$. -/
theorem deriv_gJw_sign {w : ℝ} (hw : 0 < w) :
    deriv (gJw w) (1 - w / 2) = 0 ∧ (∀ x ∈ Ioo (1 - w) (1 - w / 2), deriv (gJw w) x > 0) ∧
    (∀ x ∈ Ioo (1 - w / 2) 1, deriv (gJw w) x < 0) := by
  refine ⟨?_, fun x hx ↦ ?_, fun x hx ↦ ?_⟩
  · rw [(hasDerivAt_gJw hw ⟨by linarith, by linarith⟩).deriv]
    have : w⁻¹ * (1 - (1 - w / 2)) = 2⁻¹ := by field_simp; ring
    rw [this, gInv_half, mul_zero]
  · have hx' : x ∈ Ioo (1 - w) 1 := ⟨hx.1, by linarith [hx.2]⟩
    rw [(hasDerivAt_gJw hw hx').deriv]
    have hu := affine_mem_Ioo hw hx'
    have : 2⁻¹ < w⁻¹ * (1 - x) := by
      rw [← div_eq_inv_mul, lt_div_iff₀ hw]; linarith [hx.2]
    have := gInv_pos ⟨this, hu.2⟩
    positivity
  · have hx' : x ∈ Ioo (1 - w) 1 := ⟨by linarith [hx.1], hx.2⟩
    rw [(hasDerivAt_gJw hw hx').deriv]
    have hu := affine_mem_Ioo hw hx'
    have : w⁻¹ * (1 - x) < 2⁻¹ := by
      rw [← div_eq_inv_mul, div_lt_iff₀ hw]; linarith [hx.1]
    have := gInv_neg ⟨hu.1, this⟩
    have h2 : (0 : ℝ) < √2 := by positivity
    nlinarith

/-- Auxiliary for Remark 3.6: $I(\frac12)\,\Phi^{-1}(\frac12+v)>v$ for $v\in(0,\frac12)$. -/
theorem gProf_half_mul_gInv_gt {v : ℝ} (hv : v ∈ Ioo 0 2⁻¹) :
    v < gProf 2⁻¹ * gInv (2⁻¹ + v) := by
  set b := gProf 2⁻¹
  have hmem : ∀ v ∈ Ico (0 : ℝ) 2⁻¹, 2⁻¹ + v ∈ Ioo (0 : ℝ) 1 :=
    fun v hv ↦ ⟨by linarith [hv.1], by linarith [hv.2]⟩
  have hd : ∀ v ∈ Ico (0 : ℝ) 2⁻¹,
      HasDerivAt (fun v ↦ b * gInv (2⁻¹ + v) - v) (b * (gDens (gInv (2⁻¹ + v)))⁻¹ - 1) v := by
    intro v hv
    have h := (hasDerivAt_gInv (hmem v hv)).comp_const_add 2⁻¹ v
    exact ((h.const_mul b).sub (hasDerivAt_id' v)).congr_deriv (by ring)
  have hmono : StrictMonoOn (fun v ↦ b * gInv (2⁻¹ + v) - v) (Ico 0 2⁻¹) := by
    refine strictMonoOn_of_deriv_pos (convex_Ico 0 2⁻¹)
      (fun v hv ↦ (hd v hv).continuousAt.continuousWithinAt) fun v hv ↦ ?_
    rw [interior_Ico] at hv
    rw [(hd v (Ioo_subset_Ico_self hv)).deriv, sub_pos, ← gProf_of_mem (hmem v
      (Ioo_subset_Ico_self hv))]
    have hp := gProf_pos (hmem v (Ioo_subset_Ico_self hv))
    have hlt := gProf_lt_half (x := 2⁻¹ + v) (by linarith [hv.1])
    rw [← div_eq_mul_inv, one_lt_div hp]
    exact hlt
  have := hmono ⟨le_rfl, by norm_num⟩ (Ioo_subset_Ico_self hv) hv.1
  simp only [add_zero, gInv_half, mul_zero, sub_zero] at this
  linarith

/-- Auxiliary for Remark 3.6: $v^2<2I(\frac12)\,(I(\frac12)-I(\frac12+v))$ for
$v\in(0,\frac12]$. -/
theorem sq_lt_gProf_half {v : ℝ} (hv : v ∈ Ioc 0 2⁻¹) :
    v ^ 2 < 2 * gProf 2⁻¹ * (gProf 2⁻¹ - gProf (2⁻¹ + v)) := by
  set b := gProf 2⁻¹
  have hc : ContinuousOn (fun v ↦ 2 * b * (b - gProf (2⁻¹ + v)) - v ^ 2) (Icc 0 2⁻¹) := by
    have : ContinuousOn (fun v ↦ gProf (2⁻¹ + v)) (Icc 0 2⁻¹) :=
      continuousOn_gProf.comp (by fun_prop) fun v hv ↦ ⟨by linarith [hv.1], by linarith [hv.2]⟩
    fun_prop
  have hmono : StrictMonoOn (fun v ↦ 2 * b * (b - gProf (2⁻¹ + v)) - v ^ 2) (Icc 0 2⁻¹) := by
    refine strictMonoOn_of_deriv_pos (convex_Icc 0 2⁻¹) hc fun v hv ↦ ?_
    rw [interior_Icc] at hv
    have hm : 2⁻¹ + v ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hv.1], by linarith [hv.2]⟩
    have h := (hasDerivAt_gProf hm).comp_const_add 2⁻¹ v
    have h2 := ((h.const_sub b).const_mul (2 * b)).fun_sub (hasDerivAt_pow 2 v)
    rw [h2.deriv]
    have : v < b * gInv (2⁻¹ + v) := gProf_half_mul_gInv_gt hv
    norm_num
    linarith
  have := hmono ⟨le_rfl, by norm_num⟩ ⟨hv.1.le, hv.2⟩ hv.1
  simp only [add_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow,
    sub_zero] at this
  rw [show b - gProf 2⁻¹ = 0 from sub_self _, mul_zero] at this
  linarith

/-- Remark 3.6, failure of Corollary 3.5 for $x<1-\frac w2$: with $y=2-w-x$ (the reflection of
$x$ in $1-\frac w2$),
$\sqrt{(y-x)^2+J_w(y)^2}+J_w(x)<2J_w(\frac{x+y}2)$ for $x\in[1-w,1-\frac w2)$. -/
theorem gJw_reflect_fail {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ico (1 - w) (1 - w / 2)) :
    √((2 - w - x - x) ^ 2 + gJw w (2 - w - x) ^ 2) + gJw w x <
      2 * gJw w ((x + (2 - w - x)) / 2) := by
  rw [gJw_reflect hw]
  set v := w⁻¹ * (1 - x) - 2⁻¹ with hvdef
  have hv : v ∈ Ioc 0 2⁻¹ := by
    constructor
    · rw [hvdef, sub_pos, ← div_eq_inv_mul, lt_div_iff₀ hw]; linarith [hx.2]
    · rw [hvdef, sub_le_iff_le_add, ← div_eq_inv_mul, div_le_iff₀ hw]; linarith [hx.1]
  have key := sq_lt_gProf_half hv
  have hxv : gJw w x = √2 * w * gProf (2⁻¹ + v) := by
    rw [hvdef]; unfold gJw; congr 2; ring
  have hmid : gJw w ((x + (2 - w - x)) / 2) = √2 * w * gProf 2⁻¹ := by
    unfold gJw; congr 2; field_simp; ring
  have hyx : 2 - w - x - x = 2 * w * v := by
    rw [hvdef]; field_simp; ring
  rw [hxv, hmid, hyx]
  set a := gProf (2⁻¹ + v)
  set b := gProf 2⁻¹
  have ha : 0 ≤ a := gProf_nonneg _
  have hab : a ≤ b := gProf_le_half _
  have hb : 0 < b := gProf_pos ⟨by norm_num, by norm_num⟩
  have h2 : √2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hs : 0 < √2 := by positivity
  have hpos : 0 < √2 * w * (2 * b - a) := by
    have : 0 < 2 * b - a := by linarith
    positivity
  have hlt : √((2 * w * v) ^ 2 + (√2 * w * a) ^ 2) < √2 * w * (2 * b - a) := by
    rw [Real.sqrt_lt' hpos]
    have e : (√2 * w * (2 * b - a)) ^ 2 - ((2 * w * v) ^ 2 + (√2 * w * a) ^ 2) =
        4 * w ^ 2 * (2 * b * (b - a) - v ^ 2) := by
      ring_nf; rw [h2]; ring
    have : 0 < 4 * w ^ 2 * (2 * b * (b - a) - v ^ 2) := by
      have : 0 < 2 * b * (b - a) - v ^ 2 := by linarith
      positivity
    linarith
  linarith

/-! ### The constant $w_0$: $J_w(\frac12)=\frac12$ -/

/-- $J_w(\frac12)=0$ for $w\le\frac12$ (the argument of $I$ lies outside $(0,1)$). -/
theorem gJw_half_of_le {w : ℝ} (hw : w ≤ 2⁻¹) : gJw w 2⁻¹ = 0 := by
  unfold gJw
  rw [gProf_of_not_mem, mul_zero]
  rintro ⟨h1, h2⟩
  rcases le_or_gt w 0 with h | h
  · have : w⁻¹ ≤ 0 := inv_nonpos.2 h
    nlinarith
  · rw [← div_eq_inv_mul, div_lt_one h] at h2
    linarith

/-- $J_w(\frac12)=\frac{\sqrt2}2\cdot I(u)/u$ with $u=w^{-1}/2$. -/
theorem gJw_half_eq {w : ℝ} (hw : w ≠ 0) :
    gJw w 2⁻¹ = √2 / 2 * (gProf (w⁻¹ * (1 - 2⁻¹)) / (w⁻¹ * (1 - 2⁻¹))) := by
  unfold gJw; field_simp; ring

/-- $w\mapsto J_w(\frac12)$ is strictly increasing on $(\frac12,1]$. -/
theorem gJw_half_strictMonoOn : StrictMonoOn (fun w ↦ gJw w 2⁻¹) (Ioc 2⁻¹ 1) := by
  intro w hw w' hw' hww'
  have hw0 : 0 < w := by linarith [hw.1]
  have hw0' : 0 < w' := by linarith [hw'.1]
  simp only
  rw [gJw_half_eq hw0.ne', gJw_half_eq hw0'.ne']
  refine mul_lt_mul_of_pos_left (gProf_div_lt ?_ ?_ ?_) (by positivity)
  · positivity
  · exact mul_lt_mul_of_pos_right ((inv_lt_inv₀ hw0' hw0).2 hww') (by norm_num)
  · rw [← div_eq_inv_mul, div_le_one hw0]; linarith [hw.1]

/-- $w\mapsto J_w(\frac12)$ is continuous on $[\frac12,1]$. -/
theorem gJw_half_continuousOn : ContinuousOn (fun w ↦ gJw w 2⁻¹) (Icc 2⁻¹ 1) := by
  have hinv : ContinuousOn (fun w : ℝ ↦ w⁻¹ * (1 - 2⁻¹)) (Icc 2⁻¹ 1) :=
    (continuousOn_inv₀.mono fun w hw ↦ ne_of_gt (by linarith [hw.1] : (0 : ℝ) < w)).mul
      continuousOn_const
  have hm : MapsTo (fun w : ℝ ↦ w⁻¹ * (1 - 2⁻¹)) (Icc 2⁻¹ 1) (Icc 0 1) := by
    intro w hw
    have hw0 : 0 < w := by linarith [hw.1]
    simp only [mem_Icc]
    rw [← div_eq_inv_mul]
    exact ⟨by positivity, (div_le_one hw0).2 (by linarith [hw.1])⟩
  have := continuousOn_gProf.comp hinv hm
  unfold gJw
  exact (continuousOn_const.mul continuousOn_id).mul this

/-- $J_1(\frac12)=\sqrt2\,I(\frac12)=\pi^{-1/2}>\frac12$. -/
theorem gJw_one_half_gt : 2⁻¹ < gJw 1 2⁻¹ := by
  unfold gJw
  rw [inv_one, one_mul, mul_one, show (1 : ℝ) - 2⁻¹ = 2⁻¹ by norm_num, gProf_half, gConst_eq,
    Real.sqrt_mul (by norm_num),
    mul_inv, ← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul]
  have : √π < 2 := by rw [Real.sqrt_lt' (by norm_num)]; linarith [pi_lt_d2]
  rw [inv_lt_inv₀ (by norm_num) (by positivity)]
  linarith

/-- [DIR], §3: there is a unique $w\in(0,1)$ with $J_w(\frac12)=\frac12$. -/
theorem existsUnique_gJw_half : ∃! w : ℝ, w ∈ Ioo 0 1 ∧ gJw w 2⁻¹ = 2⁻¹ := by
  obtain ⟨w, hw, hval⟩ := intermediate_value_Icc (by norm_num : (2⁻¹ : ℝ) ≤ 1)
    gJw_half_continuousOn ⟨by rw [gJw_half_of_le le_rfl]; norm_num, gJw_one_half_gt.le⟩
  simp only at hval
  have hw1 : w ≠ 2⁻¹ := fun e ↦ by rw [e, gJw_half_of_le le_rfl] at hval; norm_num at hval
  have hw2 : w ≠ 1 := fun e ↦ by rw [e] at hval; linarith [gJw_one_half_gt]
  have hwI : w ∈ Ioo 0 1 :=
    ⟨by linarith [hw.1], lt_of_le_of_ne hw.2 hw2⟩
  refine ⟨w, ⟨hwI, hval⟩, fun w' ⟨hw', hval'⟩ ↦ ?_⟩
  have hgt : ∀ w'' ∈ Ioo (0 : ℝ) 1, gJw w'' 2⁻¹ = 2⁻¹ → w'' ∈ Ioc 2⁻¹ 1 := by
    intro w'' hw'' h''
    refine ⟨lt_of_not_ge fun hle ↦ ?_, hw''.2.le⟩
    rw [gJw_half_of_le hle] at h''; norm_num at h''
  exact gJw_half_strictMonoOn.injOn (hgt w' hw' hval') (hgt w hwI hval) (hval'.trans hval.symm)

/-- $\varphi(t)=e^{-t^2/2}/\sqrt{2\pi}$. -/
theorem gDens_eq (t : ℝ) : gDens t = exp (-t ^ 2 / 2) / √(2 * π) := by
  simp only [gDens, gConst_eq]; ring

/-- Numerical bounds $2.50658<\sqrt{2\pi}<2.50664$. -/
theorem sqrt_two_pi_bounds : 2.50658 < √(2 * π) ∧ √(2 * π) < 2.50664 := by
  constructor
  · rw [Real.lt_sqrt (by norm_num)]; nlinarith [pi_gt_d4]
  · rw [Real.sqrt_lt' (by norm_num)]; nlinarith [pi_lt_d4]

/-- $\Phi(t)=\frac12+\int_0^t\varphi$. -/
theorem gCDF_eq_half_add (t : ℝ) : gCDF t = 2⁻¹ + ∫ s in (0 : ℝ)..t, gDens s := by
  rw [gCDF_eq, gCDF_zero]

/-- $\Phi(t)\le\frac12+t/\sqrt{2\pi}$ for $t\ge0$. -/
theorem gCDF_le (t : ℝ) (ht : 0 ≤ t) : gCDF t ≤ 2⁻¹ + t / √(2 * π) := by
  rw [gCDF_eq_half_add]
  have h : ∫ s in (0 : ℝ)..t, gDens s ≤ ∫ s in (0 : ℝ)..t, (1 / √(2 * π)) := by
    refine intervalIntegral.integral_mono_on ht (continuous_gDens.intervalIntegrable _ _)
      intervalIntegrable_const fun s _ ↦ ?_
    rw [gDens_eq]
    gcongr
    rw [exp_le_one_iff]; nlinarith
  simp only [intervalIntegral.integral_const, sub_zero, smul_eq_mul] at h
  rw [mul_one_div] at h
  linarith

/-- $\Phi(t)\ge\frac12+(t-t^3/6)/\sqrt{2\pi}$ for $t\ge0$. -/
theorem le_gCDF (t : ℝ) (ht : 0 ≤ t) : 2⁻¹ + (t - t ^ 3 / 6) / √(2 * π) ≤ gCDF t := by
  rw [gCDF_eq_half_add]
  have h : ∫ s in (0 : ℝ)..t, ((1 - s ^ 2 / 2) / √(2 * π)) ≤ ∫ s in (0 : ℝ)..t, gDens s := by
    refine intervalIntegral.integral_mono_on ht
      ((by fun_prop : Continuous fun s : ℝ ↦ (1 - s ^ 2 / 2) / √(2 * π)).intervalIntegrable _ _)
      (continuous_gDens.intervalIntegrable _ _) fun s _ ↦ ?_
    rw [gDens_eq]
    gcongr
    linarith [add_one_le_exp (-s ^ 2 / 2)]
  have e : ∫ s in (0 : ℝ)..t, ((1 - s ^ 2 / 2) / √(2 * π)) = (t - t ^ 3 / 6) / √(2 * π) := by
    rw [intervalIntegral.integral_div, intervalIntegral.integral_sub
      (continuous_const.intervalIntegrable _ _)
      ((by fun_prop : Continuous fun s : ℝ ↦ s ^ 2 / 2).intervalIntegrable _ _),
      intervalIntegral.integral_div]
    simp
    ring
  linarith

/-- Numerical bound: $J_{0.895}(\frac12)<\frac12$. -/
theorem gJw_895_lt : gJw 0.895 2⁻¹ < 2⁻¹ := by
  obtain ⟨hs1, hs2⟩ := sqrt_two_pi_bounds
  have hs0 : 0 < √(2 * π) := by linarith
  set u : ℝ := (0.895 : ℝ)⁻¹ * (1 - 2⁻¹) with hu
  have huI : u ∈ Ioo 0 1 := by rw [hu]; constructor <;> norm_num
  have hcdf : gCDF 0.144 < u := by
    have := gCDF_le 0.144 (by norm_num)
    have h2 : (0.144 : ℝ) / √(2 * π) < 0.0586 := by
      rw [div_lt_iff₀ hs0]; nlinarith
    have h3 : (2⁻¹ : ℝ) + 0.0586 < u := by rw [hu]; norm_num
    linarith
  have hinv : 0.144 < gInv u := by
    by_contra hle
    rw [not_lt, gInv_le_iff huI] at hle
    linarith
  have hprof : gProf u < gDens 0.144 := by
    rw [gProf_of_mem huI]
    exact gDens_strictAntiOn (by norm_num : (0.144 : ℝ) ∈ Ici 0)
      (show (0 : ℝ) ≤ gInv u from le_trans (by norm_num) hinv.le) hinv
  have hdens : gDens 0.144 ≤ 1 / (1.010368 * √(2 * π)) := by
    rw [gDens_eq, div_le_div_iff₀ hs0 (by positivity), one_mul]
    have he : exp (-(0.144 : ℝ) ^ 2 / 2) * 1.010368 ≤ 1 := by
      have := add_one_le_exp ((0.144 : ℝ) ^ 2 / 2)
      rw [show -(0.144 : ℝ) ^ 2 / 2 = -(0.144 ^ 2 / 2) by ring, exp_neg,
        inv_mul_le_iff₀ (exp_pos _)]
      norm_num at this ⊢; linarith
    nlinarith
  have hsq : √2 < 1.41422 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have hsq0 : 0 < √2 := by positivity
  unfold gJw
  rw [← hu]
  have hfin : √2 * 0.895 * (1 / (1.010368 * √(2 * π))) < 2⁻¹ := by
    rw [mul_one_div, div_lt_iff₀ (by positivity)]
    nlinarith
  calc √2 * 0.895 * gProf u < √2 * 0.895 * gDens 0.144 := by gcongr
    _ ≤ √2 * 0.895 * (1 / (1.010368 * √(2 * π))) := by gcongr
    _ < 2⁻¹ := hfin

/-- Numerical bound: $J_{0.896}(\frac12)>\frac12$. -/
theorem gJw_896_gt : 2⁻¹ < gJw 0.896 2⁻¹ := by
  obtain ⟨hs1, hs2⟩ := sqrt_two_pi_bounds
  have hs0 : 0 < √(2 * π) := by linarith
  set u : ℝ := (0.896 : ℝ)⁻¹ * (1 - 2⁻¹) with hu
  have huI : u ∈ Ioo 0 1 := by rw [hu]; constructor <;> norm_num
  have hcdf : u < gCDF 0.147 := by
    have := le_gCDF 0.147 (by norm_num)
    have h2 : (0.0584 : ℝ) < (0.147 - 0.147 ^ 3 / 6) / √(2 * π) := by
      rw [lt_div_iff₀ hs0]; nlinarith
    have h3 : u < (2⁻¹ : ℝ) + 0.0584 := by rw [hu]; norm_num
    linarith
  have hinv : gInv u < 0.147 := by
    by_contra hle
    rw [not_lt, le_gInv_iff huI] at hle
    linarith
  have hinv0 : 0 ≤ gInv u := (gInv_pos ⟨by rw [hu]; norm_num, huI.2⟩).le
  have hprof : gDens 0.147 < gProf u := by
    rw [gProf_of_mem huI]
    exact gDens_strictAntiOn hinv0 (by norm_num : (0.147 : ℝ) ∈ Ici 0) hinv
  have hdens : (1 - 0.0108045) / √(2 * π) ≤ gDens 0.147 := by
    rw [gDens_eq]
    gcongr
    have := add_one_le_exp (-(0.147 : ℝ) ^ 2 / 2)
    norm_num at this ⊢
    linarith
  have hsq : 1.41421 < √2 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  unfold gJw
  rw [← hu]
  have hfin : 2⁻¹ < √2 * 0.896 * ((1 - 0.0108045) / √(2 * π)) := by
    rw [mul_div_assoc', lt_div_iff₀ hs0]
    nlinarith
  calc 2⁻¹ < √2 * 0.896 * ((1 - 0.0108045) / √(2 * π)) := hfin
    _ ≤ √2 * 0.896 * gDens 0.147 := by gcongr
    _ < √2 * 0.896 * gProf u := by gcongr

/-- [DIR], §3: the solution $w\in(0,1)$ of $J_w(\frac12)=\frac12$ lies in $[0.895,0.896]$. -/
theorem mem_Icc_of_gJw_half_eq {w : ℝ} (hw : w ∈ Ioo 0 1) (h : gJw w 2⁻¹ = 2⁻¹) :
    w ∈ Icc (0.895 : ℝ) 0.896 := by
  have hw1 : 2⁻¹ < w := lt_of_not_ge fun hle ↦ by
    rw [gJw_half_of_le hle] at h; norm_num at h
  have hwI : w ∈ Ioc 2⁻¹ 1 := ⟨hw1, hw.2.le⟩
  constructor
  · by_contra hlt
    rw [not_le] at hlt
    have := gJw_half_strictMonoOn hwI ⟨by norm_num, by norm_num⟩ hlt
    simp only at this
    linarith [gJw_895_lt]
  · by_contra hlt
    rw [not_le] at hlt
    have := gJw_half_strictMonoOn ⟨by norm_num, by norm_num⟩ hwI hlt
    simp only at this
    linarith [gJw_896_gt]

/-! ### The function $J$ -/

/-- $C^\infty$ implies $C^2$ (on a set). -/
theorem contDiffOn_two_of_infty {f : ℝ → ℝ} {s : Set ℝ} (hf : ContDiffOn ℝ ∞ f s) :
    ContDiffOn ℝ 2 f s :=
  hf.of_le (by norm_cast)

/-- If $w\in(0,1)$ and $J_w(\frac12)=\frac12$, then $J_w$ satisfies the defining conditions of
$J$ (`Auto.DIR.IsJ`). -/
theorem isJ_gJw {w : ℝ} (hw : w ∈ Ioo 0 1) (h : gJw w 2⁻¹ = 2⁻¹) : IsJ (gJw w) := by
  have hw1 : 2⁻¹ < w := lt_of_not_ge fun hle ↦ by
    rw [gJw_half_of_le hle] at h; norm_num at h
  have hsub : Ioo (2⁻¹ : ℝ) 1 ⊆ Ioo (1 - w) 1 := Ioo_subset_Ioo (by linarith) le_rfl
  refine ⟨(contDiffOn_gJw hw.1).mono hsub,
    (continuousOn_gJw hw.1).mono (Icc_subset_Icc (by linarith) le_rfl),
    fun x hx ↦ gJw_deriv2_mul hw.1 (hsub hx), h, gJw_one w⟩

/-- Uniqueness of $J$: two functions satisfying `Auto.DIR.IsJ` agree on $[\frac12,1]$. -/
theorem isJ_unique {f g : ℝ → ℝ} (hf : IsJ f) (hg : IsJ g) : EqOn f g (Icc 2⁻¹ 1) := by
  have hpos : ∀ f : ℝ → ℝ, IsJ f → ∀ x ∈ Ioo (2⁻¹ : ℝ) 1, 0 < f x := by
    intro f hf x hx
    refine pos_of_ne_zero_of_continuousOn hf.2.1 (by rw [hf.2.2.2.1]; norm_num)
      (fun y hy h0 ↦ ?_) x (Ioo_subset_Ico_self hx)
    have := hf.2.2.1 y hy
    rw [h0, mul_zero] at this; norm_num at this
  have hmul : ∀ f : ℝ → ℝ, IsJ f → ∀ x ∈ Ioo (2⁻¹ : ℝ) 1, f x * deriv (deriv f) x = -2 :=
    fun f hf x hx ↦ by rw [mul_comm]; exact hf.2.2.1 x hx
  exact eqOn_of_mul_deriv2_eq (k := 2) (by norm_num) hf.2.1 hg.2.1 (contDiffOn_two_of_infty hf.1)
    (contDiffOn_two_of_infty hg.1) (hpos f hf) (hpos g hg) (hmul f hf) (hmul g hg)
    (hf.2.2.2.1.trans hg.2.2.2.1.symm) (hf.2.2.2.2.trans hg.2.2.2.2.symm)

end Auto.DIR
