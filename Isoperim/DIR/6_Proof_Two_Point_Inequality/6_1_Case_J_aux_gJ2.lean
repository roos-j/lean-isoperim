open Real Set Checker

/-- $J(x_0)<0.506$. -/
theorem J_x₀_lt : J x₀ < 0.506 := by
  rw [J_x₀_eq]
  have h1 := w₀_mem_fine.2
  have h2 := sqrt_pi_bounds_fine.1
  rw [div_lt_iff₀ (by linarith)]
  nlinarith

/-- $J(\frac{25}{32})>0.39$. -/
theorem J_25_32_gt : (0.39 : ℝ) < J (25 / 32) := by
  have := check_sound P11 hw11 [] (.J (25 / 32) 0.4899152162535830 0.4899152162478544) 0.39 (by decide +kernel)
  simpa [denote] using this

/-- [DIR], §6.1.2: $2J(\frac{x+y}2)-J(x)\ge0$ for $\frac12\le x\le\frac9{16}$,
$\frac{11}{16}\le y\le1$. -/
theorem two_J_mid_sub_J_nonneg {x y : ℝ} (hx : x ∈ Icc (2⁻¹ : ℝ) (9 / 16))
    (hy : y ∈ Icc (11 / 16 : ℝ) 1) : 0 ≤ 2 * J ((x + y) / 2) - J x := by
  have hx₀ := eqn_3_6
  have h1 : J (25 / 32) ≤ J ((x + y) / 2) :=
    J_antitoneOn_Icc_x₀_one ⟨by linarith [hx.1, hy.1, hx₀.2], by linarith [hx.2, hy.2]⟩
      ⟨by linarith [hx₀.2], by norm_num⟩ (by linarith [hx.2, hy.2])
  have h2 : J x ≤ J x₀ := by
    rcases le_total x x₀ with h | h
    · exact J_monotoneOn_Icc_half_x₀ ⟨hx.1, h⟩ ⟨by linarith [hx₀.1], le_rfl⟩ h
    · exact J_antitoneOn_Icc_x₀_one ⟨le_rfl, by linarith [hx₀.2]⟩
        ⟨h, by linarith [hx.2]⟩ h
  linarith [J_x₀_lt, J_25_32_gt]

/-- [DIR], §6.1.2: $2J(\frac{x+y}2)-J(x)$ is decreasing in $y\in[\frac{11}{16},1]$ (for
$x\ge\frac12$), since $\frac{x+y}2\ge\frac12(\frac12+\frac{11}{16})>x_0$. -/
theorem two_J_mid_sub_J_anti_y {x y y' : ℝ} (hx : x ∈ Icc (2⁻¹ : ℝ) (9 / 16))
    (hy : y ∈ Icc (11 / 16 : ℝ) 1) (hy' : y' ∈ Icc (11 / 16 : ℝ) 1) (hyy : y ≤ y') :
    2 * J ((x + y') / 2) - J x ≤ 2 * J ((x + y) / 2) - J x := by
  have hx₀ := eqn_3_6
  have := J_antitoneOn_Icc_x₀_one ⟨by linarith [hx.1, hy.1, hx₀.2], by linarith [hx.2, hy.2]⟩
    ⟨by linarith [hx.1, hy'.1, hx₀.2], by linarith [hx.2, hy'.2]⟩
    (show (x + y) / 2 ≤ (x + y') / 2 by linarith)
  linarith

/-- [DIR], §6.1.2: $2J(\frac{x+y}2)-J(x)$ is decreasing in $x\in[\frac12,\frac9{16}]$ (for
$y\in[\frac{11}{16},1]$): its $x$-derivative is $J'(\frac{x+y}2)-J'(x)<0$ since $J'$ is strictly
decreasing. -/
theorem two_J_mid_sub_J_anti_x {y : ℝ} (hy : y ∈ Icc (11 / 16 : ℝ) 1) :
    AntitoneOn (fun x ↦ 2 * J ((x + y) / 2) - J x) (Icc 2⁻¹ (9 / 16)) := by
  have hx₀ := eqn_3_6
  have hcont : ContinuousOn (fun x ↦ 2 * J ((x + y) / 2) - J x) (Icc 2⁻¹ (9 / 16)) := by
    refine ((continuousOn_J.comp (by fun_prop) ?_).const_smul (2 : ℝ)).sub
      (continuousOn_J.mono (Icc_subset_Icc le_rfl (by norm_num)))
    intro x hx
    exact ⟨by linarith [hx.1, hy.1], by linarith [hx.2, hy.2]⟩
  refine antitoneOn_of_deriv_nonpos (convex_Icc _ _) hcont ?_ ?_
  · intro x hx
    rw [interior_Icc] at hx
    have hm : (x + y) / 2 ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨by linarith [hx.1, hy.1], by linarith [hx.2, hy.2]⟩
    have hd := (hasDerivAt_J_deriv hm).comp x (((hasDerivAt_id x).add_const y).div_const 2)
    exact ((hd.const_mul 2).sub (hasDerivAt_J_deriv ⟨hx.1, by linarith [hx.2]⟩)).differentiableAt
      |>.differentiableWithinAt
  · intro x hx
    rw [interior_Icc] at hx
    have hm : (x + y) / 2 ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨by linarith [hx.1, hy.1], by linarith [hx.2, hy.2]⟩
    have hx1 : x ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨hx.1, by linarith [hx.2]⟩
    have hd := (hasDerivAt_J_deriv hm).comp x (((hasDerivAt_id x).add_const y).div_const 2)
    have h := (hd.const_mul 2).sub (hasDerivAt_J_deriv hx1)
    have h' : HasDerivAt (fun x ↦ 2 * J ((x + y) / 2) - J x) _ x := h
    rw [h'.deriv]
    have hlt := (deriv_J_strictAntiOn hx1 hm (by linarith [hx.2, hy.1]))
    linarith

/-- The tight lower bound of $g_{J,2}$ ([DIR], §6.1.2):
$$\underline{g_{J,2}}(\underline x,\overline x,\underline y,\overline y)
=(\underline y-\overline x)^2+J(\overline y)^2-(2J(\tfrac{\underline x+\underline y}2)
-J(\underline x))^2.$$ -/
noncomputable def g_J_2_lo (xl xu yl yu : ℝ) : ℝ :=
  (yl - xu) ^ 2 + J yu ^ 2 - (2 * J ((xl + yl) / 2) - J xl) ^ 2

/-- [DIR], §6.1.2: $\underline{g_{J,2}}$ is a lower bound of
$g_{J,2}(x,y)=(y-x)^2+J(y)^2-(2J(\frac{x+y}2)-J(x))^2$ on subrectangles of
$[\frac12,\frac9{16}]\times[\frac{11}{16},1]$. -/
theorem g_J_2_lo_le {xl xu yl yu x y : ℝ} (hxl : 2⁻¹ ≤ xl) (hxu : xu ≤ 9 / 16)
    (hyl : 11 / 16 ≤ yl) (hyu : yu ≤ 1) (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    g_J_2_lo xl xu yl yu ≤ (y - x) ^ 2 + J y ^ 2 - (2 * J ((x + y) / 2) - J x) ^ 2 := by
  have hx₀ := eqn_3_6
  have hxI : x ∈ Icc (2⁻¹ : ℝ) (9 / 16) := ⟨hxl.trans hx.1, hx.2.trans hxu⟩
  have hyI : y ∈ Icc (11 / 16 : ℝ) 1 := ⟨hyl.trans hy.1, hy.2.trans hyu⟩
  have hxlI : xl ∈ Icc (2⁻¹ : ℝ) (9 / 16) := ⟨hxl, hx.1.trans hxI.2⟩
  have hylI : yl ∈ Icc (11 / 16 : ℝ) 1 := ⟨hyl, hy.1.trans hyI.2⟩
  have hyuI : yu ∈ Icc (11 / 16 : ℝ) 1 := ⟨hyI.1.trans hy.2, hyu⟩
  -- the first term
  have e1 : (yl - xu) ^ 2 ≤ (y - x) ^ 2 := by
    have : 0 ≤ yl - xu := by linarith
    nlinarith [hx.2, hy.1]
  -- the second term
  have e2 : J yu ^ 2 ≤ J y ^ 2 := by
    have h1 : J yu ≤ J y := J_antitoneOn_Icc_x₀_one ⟨by linarith [hyI.1, hx₀.2], hyI.2⟩
      ⟨by linarith [hyuI.1, hx₀.2], hyuI.2⟩ hy.2
    have h0 : 0 ≤ J yu := J_nonneg ⟨by linarith [hyuI.1], hyuI.2⟩
    nlinarith
  -- the third term
  have e3 : (2 * J ((x + y) / 2) - J x) ^ 2 ≤ (2 * J ((xl + yl) / 2) - J xl) ^ 2 := by
    have h0 := two_J_mid_sub_J_nonneg hxI hyI
    have ha := two_J_mid_sub_J_anti_x hyI hxlI hxI hx.1
    have hb := two_J_mid_sub_J_anti_y hxlI hylI hyI hy.1
    simp only at ha
    nlinarith
  unfold g_J_2_lo
  linarith

/-- The expression of the checker for $\underline{g_{J,2}}$ on the rectangle
$[x_l,x_u]\times[y_l,y_u]$, with the variables `0`, `1`, `2` standing for $J(y_u)$,
$J(\frac{x_l+y_l}2)$, $J(x_l)$. -/
def gJ2Ex (_xl xu yl _yu : ℚ) : Ex :=
  .sub (.add (.npow (.const (yl - xu)) 2) (.npow (.var 0) 2))
    (.npow (.sub (.mul (.const 2) (.var 1)) (.var 2)) 2)

/-- The real meaning of `gJ2Ex`. -/
theorem denote_gJ2Ex (xl xu yl yu : ℚ) (a b c : Cert) :
    denote (Cert.val [a, b, c]) (gJ2Ex xl xu yl yu) =
      ((yl - xu : ℚ) : ℝ) ^ 2 + a.v ^ 2 - (2 * b.v - c.v) ^ 2 := by
  simp [gJ2Ex, denote, Cert.val, envOf]

/-- $\underline{g_{J,2}}-10^{-8}$ as a function of the corners of a rectangle in
$\mathbb R^2$ (the function $\underline f$ of [DIR], §4.1 for (6.5)). -/
noncomputable def gJ2_fl (zl zu : Fin 2 → ℝ) : ℝ :=
  g_J_2_lo (zl 0) (zu 0) (zl 1) (zu 1) - 1 / 10 ^ 8

/-- The Boolean box check for (6.5): the table entries are at the right points
($\overline y$, $\frac{\underline x+\underline y}2$, $\underline x$) and the checker certifies
$\underline{g_{J,2}}>10^{-8}$. -/
def gJ2Check (p : Box) (a b c : JVal) : Bool :=
  a.x == p.2.2.2 && b.x == (p.1 + p.2.2.1) / 2 && c.x == p.1 &&
    check P11 [(a.l, a.u), (b.l, b.u), (c.l, c.u)] (gJ2Ex p.1 p.2.1 p.2.2.1 p.2.2.2) (1 / 10 ^ 8)

/-- **Box certificate for (6.5).** If `gJ2Check` succeeds on the rectangle `p`, then
$\underline{g_{J,2}}>10^{-8}$ on `p`. -/
theorem gJ2_box (p : Box) (a b c : JVal) (h : gJ2Check p a b c = true) :
    0 < gJ2_fl (Box.toR p).1 (Box.toR p).2 := by
  obtain ⟨xl, xu, yl, yu⟩ := p
  simp only [gJ2Check, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨ha, hb⟩, hc⟩, hk⟩ := h
  have := check_sound P11 hw11 [a.cert, b.cert, c.cert] _ _ hk
  rw [denote_gJ2Ex] at this
  simp only [JVal.cert, ha, hb, hc] at this
  simp only [gJ2_fl, g_J_2_lo, Box.toR, Matrix.cons_val_zero, Matrix.cons_val_one]
  push_cast at this ⊢
  linarith

end Auto.DIR
