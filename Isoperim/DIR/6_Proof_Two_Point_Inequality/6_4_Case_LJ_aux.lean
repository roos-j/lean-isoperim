theorem caseLJ_L2f_neg {x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) : L2f 2⁻¹ x < 0 := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have h1 := rpow_pos_of_pos (log_pos one_lt_two) (-2⁻¹ : ℝ)
