  have h3 := inv_pos.2 hx.1
  have h4 : 0 < 1 - 2⁻¹ + log x⁻¹ := by linarith
  have : 0 < 2⁻¹ * (log 2) ^ (-2⁻¹ : ℝ) * x⁻¹ * (log x⁻¹) ^ (-2 + 2⁻¹ : ℝ) *
      (1 - 2⁻¹ + log x⁻¹) := by positivity
  rw [L2f]
  linarith

