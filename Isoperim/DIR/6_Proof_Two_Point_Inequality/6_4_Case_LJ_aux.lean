namespace Auto.DIR

open Real Set Filter Topology

/-! ### Elementary facts on concave and convex functions -/

/-- A continuous function on $[a,b]$ with $f''\le0$ on $(a,b)$ satisfies
$f(z)\ge\min(f(a),f(b))$ for $z\in[a,b]$. -/
theorem caseLJ_min_le_of_deriv2_nonpos {f : ℝ → ℝ} {a b : ℝ} (hc : ContinuousOn f (Icc a b))
    (hd : ∀ x ∈ Ioo a b, DifferentiableAt ℝ f x)
    (hd2 : ∀ x ∈ Ioo a b, DifferentiableAt ℝ (deriv f) x)
    (h2 : ∀ x ∈ Ioo a b, deriv (deriv f) x ≤ 0) {z : ℝ} (hz : z ∈ Icc a b) :
    min (f a) (f b) ≤ f z := by
  have hab : a ≤ b := hz.1.trans hz.2
  have hcc : ConcaveOn ℝ (Icc a b) f := concaveOn_of_deriv2_nonpos (convex_Icc a b) hc
    (fun x hx ↦ (hd x (by rwa [interior_Icc] at hx)).differentiableWithinAt)
    (fun x hx ↦ (hd2 x (by rwa [interior_Icc] at hx)).differentiableWithinAt)
    (fun x hx ↦ by rw [interior_Icc] at hx; exact h2 x hx)
  exact hcc.min_le_of_mem_Icc (left_mem_Icc.2 hab) (right_mem_Icc.2 hab) hz

/-- A convex function on $[a,b]$ with positive (one-sided) derivative at $a$ satisfies
$f(a)\le f(z)$ for $z\in[a,b]$. -/
theorem caseLJ_le_of_convexOn_of_hasDerivWithinAt_pos {f : ℝ → ℝ} {a b d : ℝ}
    (hf : ConvexOn ℝ (Icc a b) f) (hd : HasDerivWithinAt f d (Icc a b) a) (hd0 : 0 < d)
    {z : ℝ} (hz : z ∈ Icc a b) : f a ≤ f z := by
  by_contra hlt
  rw [not_le] at hlt
  have haz : a < z := lt_of_le_of_ne hz.1 (by rintro rfl; exact lt_irrefl _ hlt)
  have hsub : Ioo a z ⊆ Icc a b \ {a} := fun s hs ↦ ⟨⟨hs.1.le, hs.2.le.trans hz.2⟩, hs.1.ne'⟩
  have ht := (hasDerivWithinAt_iff_tendsto_slope.1 hd).mono_left (nhdsWithin_mono _ hsub)
  rw [nhdsWithin_Ioo_eq_nhdsGT haz] at ht
  obtain ⟨s, hs0, hs⟩ := ((ht.eventually (lt_mem_nhds hd0)).and (Ioo_mem_nhdsGT haz)).exists
  rw [slope_def_field] at hs0
  have hsa : 0 < s - a := by linarith [hs.1]
  have hfs : 0 < f s - f a := (div_pos_iff_of_pos_right hsa).1 hs0
  set p := (s - a) / (z - a) with hp
  have hza : 0 < z - a := by linarith
  have hp0 : 0 < p := div_pos hsa hza
  have hp1 : p ≤ 1 := by rw [hp, div_le_one hza]; linarith [hs.2]
  have hconv := hf.2 (left_mem_Icc.2 (haz.le.trans hz.2)) hz (by linarith : (0 : ℝ) ≤ 1 - p)
    hp0.le (by ring : 1 - p + p = 1)
  have hpt : (1 - p) • a + p • z = s := by
    simp only [smul_eq_mul, hp]; field_simp; ring
  rw [hpt, smul_eq_mul, smul_eq_mul] at hconv
  nlinarith [mul_pos hp0 (sub_pos.2 hlt)]

/-! ### Derivatives in $x$ of $g_{LJ}(x,y)$ -/

/-- The open set $\{x\in(0,1):1<x+y<2\}$, on which $x\mapsto g_{LJ}(x,y)$ is smooth. -/
def caseLJ_dom (y : ℝ) : Set ℝ := Ioo 0 1 ∩ Ioo (1 - y) (2 - y)

/-- `caseLJ_dom y` is open. -/
theorem caseLJ_dom_isOpen (y : ℝ) : IsOpen (caseLJ_dom y) := isOpen_Ioo.inter isOpen_Ioo

/-- For $x$ in `caseLJ_dom y`, $\frac{x+y}2\in(\frac12,1)$. -/
theorem caseLJ_mid_mem {x y : ℝ} (hx : x ∈ caseLJ_dom y) : (x + y) / 2 ∈ Ioo (2⁻¹ : ℝ) 1 := by
  obtain ⟨-, h1, h2⟩ := hx
  constructor <;> linarith

/-- A point of the region of Case $LJ$ ($0<x\le\frac14$, $y\le1$, $1<x+y$) lies in
`caseLJ_dom y`. -/
theorem caseLJ_mem_dom {x y : ℝ} (hx : x ∈ Ioc (0 : ℝ) 4⁻¹) (hy : y ≤ 1) (hxy : 1 < x + y) :
    x ∈ caseLJ_dom y :=
  ⟨⟨hx.1, by linarith [hx.2]⟩, ⟨by linarith, by linarith [hx.2]⟩⟩

/-- The derivative of $x\mapsto\frac{x+y}2$. -/
theorem caseLJ_hasDerivAt_mid (x y : ℝ) : HasDerivAt (fun x : ℝ ↦ (x + y) / 2) 2⁻¹ x := by
  simpa using ((hasDerivAt_id x).add_const y).div_const 2

/-- $\partial_x\bigl(y-x+c+L_{\frac12}(x)-2J(\frac{x+y}2)\bigr)
=-1+L_{\frac12}'(x)-J'(\frac{x+y}2)$ on `caseLJ_dom y`. -/
theorem caseLJ_hasDerivAt_G (y c : ℝ) {x : ℝ} (hx : x ∈ caseLJ_dom y) :
    HasDerivAt (fun x ↦ y - x + c + L 2⁻¹ x - 2 * J ((x + y) / 2))
      (-1 + L1f 2⁻¹ x - deriv J ((x + y) / 2)) x := by
  have hJ : HasDerivAt (fun x ↦ J ((x + y) / 2)) (deriv J ((x + y) / 2) * 2⁻¹) x :=
    (hasDerivAt_J_deriv (caseLJ_mid_mem hx)).comp x (caseLJ_hasDerivAt_mid x y)
  have hL := hasDerivAt_L (β := 2⁻¹) hx.1
  have h := ((((hasDerivAt_id x).const_sub y).add_const c).add hL).sub (hJ.const_mul 2)
  exact h.congr_deriv (by ring)

/-- The first derivative in $x$ near a point of `caseLJ_dom y`. -/
theorem caseLJ_deriv_G_eventuallyEq (y c : ℝ) {x : ℝ} (hx : x ∈ caseLJ_dom y) :
    deriv (fun x ↦ y - x + c + L 2⁻¹ x - 2 * J ((x + y) / 2)) =ᶠ[𝓝 x]
      fun x ↦ -1 + L1f 2⁻¹ x - deriv J ((x + y) / 2) := by
  filter_upwards [(caseLJ_dom_isOpen y).mem_nhds hx] with z hz using
    (caseLJ_hasDerivAt_G y c hz).deriv

/-- $\partial_x\bigl(-1+L_{\frac12}'(x)-J'(\frac{x+y}2)\bigr)
=L_{\frac12}''(x)+J(\frac{x+y}2)^{-1}$ on `caseLJ_dom y` (using $JJ''=-2$). -/
theorem caseLJ_hasDerivAt_D1 (y : ℝ) {x : ℝ} (hx : x ∈ caseLJ_dom y) :
    HasDerivAt (fun x ↦ -1 + L1f 2⁻¹ x - deriv J ((x + y) / 2))
      (L2f 2⁻¹ x + (J ((x + y) / 2))⁻¹) x := by
  have hJ0 := (hasDerivAt_deriv_J (caseLJ_mid_mem hx)).comp x (caseLJ_hasDerivAt_mid x y)
  have hJ : HasDerivAt (fun x ↦ deriv J ((x + y) / 2)) (-2 * (J ((x + y) / 2))⁻¹ * 2⁻¹) x :=
    hJ0
  have h := ((hasDerivAt_L1f (β := 2⁻¹) hx.1).const_add (-1)).sub hJ
  exact h.congr_deriv (by ring)

/-- The derivative of $\partial_x g_{LJ}$ at a point of `caseLJ_dom y`. -/
theorem caseLJ_hasDerivAt_deriv_G (y c : ℝ) {x : ℝ} (hx : x ∈ caseLJ_dom y) :
    HasDerivAt (deriv (fun x ↦ y - x + c + L 2⁻¹ x - 2 * J ((x + y) / 2)))
      (L2f 2⁻¹ x + (J ((x + y) / 2))⁻¹) x :=
  (caseLJ_hasDerivAt_D1 y hx).congr_of_eventuallyEq (caseLJ_deriv_G_eventuallyEq y c hx)

/-- The second derivative in $x$ near a point of `caseLJ_dom y`. -/
theorem caseLJ_deriv2_G_eventuallyEq (y c : ℝ) {x : ℝ} (hx : x ∈ caseLJ_dom y) :
    deriv (deriv (fun x ↦ y - x + c + L 2⁻¹ x - 2 * J ((x + y) / 2))) =ᶠ[𝓝 x]
      fun x ↦ L2f 2⁻¹ x + (J ((x + y) / 2))⁻¹ := by
  filter_upwards [(caseLJ_dom_isOpen y).mem_nhds hx] with z hz using
    (caseLJ_hasDerivAt_deriv_G y c hz).deriv

/-- $\partial_x\bigl(L_{\frac12}''(x)+J(\frac{x+y}2)^{-1}\bigr)
=L_{\frac12}'''(x)-\frac12J'(\frac{x+y}2)J(\frac{x+y}2)^{-2}$ on `caseLJ_dom y`. -/
theorem caseLJ_hasDerivAt_D2 (y : ℝ) {x : ℝ} (hx : x ∈ caseLJ_dom y) :
    HasDerivAt (fun x ↦ L2f 2⁻¹ x + (J ((x + y) / 2))⁻¹)
      (L3f 2⁻¹ x - 2⁻¹ * deriv J ((x + y) / 2) * J ((x + y) / 2) ^ (-2 : ℤ)) x := by
  have hJ := (hasDerivAt_J_inv_pow 1 (caseLJ_mid_mem hx)).comp x (caseLJ_hasDerivAt_mid x y)
  have h := (hasDerivAt_L2f (β := 2⁻¹) hx.1).add hJ
  convert h using 1
  · funext z; simp
  · rw [zpow_neg, zpow_ofNat]; push_cast; ring

/-- The derivative of $\partial_x^2g_{LJ}$ at a point of `caseLJ_dom y` is
$\partial_x^3g_{LJ}$. -/
theorem caseLJ_hasDerivAt_deriv2_G (y c : ℝ) {x : ℝ} (hx : x ∈ caseLJ_dom y) :
    HasDerivAt (deriv (deriv (fun x ↦ y - x + c + L 2⁻¹ x - 2 * J ((x + y) / 2))))
      (iteratedDeriv 3 (fun x ↦ y - x + c + L 2⁻¹ x - 2 * J ((x + y) / 2)) x) x := by
  have h := (caseLJ_hasDerivAt_D2 y hx).congr_of_eventuallyEq
    (caseLJ_deriv2_G_eventuallyEq y c hx)
  have e : iteratedDeriv 3 (fun x ↦ y - x + c + L 2⁻¹ x - 2 * J ((x + y) / 2)) x =
      deriv (deriv (deriv (fun x ↦ y - x + c + L 2⁻¹ x - 2 * J ((x + y) / 2)))) x := by
    simp only [iteratedDeriv_succ, iteratedDeriv_zero]
  rw [e, h.deriv]
  exact h

/-- The third derivative in $x$ at a point of `caseLJ_dom y`. -/
theorem caseLJ_iteratedDeriv3_G (y c : ℝ) {x : ℝ} (hx : x ∈ caseLJ_dom y) :
    iteratedDeriv 3 (fun x ↦ y - x + c + L 2⁻¹ x - 2 * J ((x + y) / 2)) x =
      L3f 2⁻¹ x - 2⁻¹ * deriv J ((x + y) / 2) * J ((x + y) / 2) ^ (-2 : ℤ) := by
  have h := (caseLJ_hasDerivAt_D2 y hx).congr_of_eventuallyEq
    (caseLJ_deriv2_G_eventuallyEq y c hx)
  rw [← h.deriv]
  simp only [iteratedDeriv_succ, iteratedDeriv_zero]

/-- $x\mapsto y-x+c+L_{\frac12}(x)-2J(\frac{x+y}2)$ is continuous on $[a,b]$ if
$0\le a$, $b\le1$, $1\le a+y$ and $b+y\le2$. -/
theorem caseLJ_continuousOn_G (y c : ℝ) {a b : ℝ} (ha : 0 ≤ a) (hb : b ≤ 1) (hay : 1 ≤ a + y)
    (hby : b + y ≤ 2) :
    ContinuousOn (fun x ↦ y - x + c + L 2⁻¹ x - 2 * J ((x + y) / 2)) (Icc a b) := by
  have hL : ContinuousOn (L 2⁻¹) (Icc a b) :=
    (continuousOn_L (by norm_num) (by norm_num)).mono (Icc_subset_Icc ha hb)
  have hJ : ContinuousOn (fun x ↦ J ((x + y) / 2)) (Icc a b) :=
    continuousOn_J.comp (by fun_prop)
      (fun z hz ↦ ⟨by linarith [hz.1], by linarith [hz.2]⟩)
  exact (((continuousOn_const.sub continuousOn_id).add continuousOn_const).add hL).sub
    (continuousOn_const.mul hJ)

/-! ### The boundary piece $x+y=1$ -/

/-- The derivative of $y\mapsto2y+cJ(y)+L_{\frac12}(1-y)-2$ on $(\frac12,1)$. -/
theorem caseLJ_hasDerivAt_diag (c : ℝ) {y : ℝ} (hy : y ∈ Ioo (2⁻¹ : ℝ) 1) :
    HasDerivAt (fun y ↦ 2 * y + c * J y + L 2⁻¹ (1 - y) - 2)
      (2 + c * deriv J y - L1f 2⁻¹ (1 - y)) y := by
  have h1 : 1 - y ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hy.2], by linarith [hy.1]⟩
  have hL : HasDerivAt (fun y ↦ L 2⁻¹ (1 - y)) (L1f 2⁻¹ (1 - y) * (-1)) y :=
    (hasDerivAt_L (β := 2⁻¹) h1).comp y ((hasDerivAt_id y).const_sub 1)
  have h := ((((hasDerivAt_id y).const_mul 2).add ((hasDerivAt_J_deriv hy).const_mul c)).add
    hL).sub_const 2
  exact h.congr_deriv (by ring)

/-- The second derivative of $y\mapsto2y+cJ(y)+L_{\frac12}(1-y)-2$ on $(\frac12,1)$:
$cJ''(y)+L_{\frac12}''(1-y)$. -/
theorem caseLJ_hasDerivAt_deriv_diag (c : ℝ) {y : ℝ} (hy : y ∈ Ioo (2⁻¹ : ℝ) 1) :
    HasDerivAt (deriv (fun y ↦ 2 * y + c * J y + L 2⁻¹ (1 - y) - 2))
      (c * deriv (deriv J) y + deriv (deriv (L 2⁻¹)) (1 - y)) y := by
  have h1 : 1 - y ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hy.2], by linarith [hy.1]⟩
  have hL : HasDerivAt (fun y ↦ L1f 2⁻¹ (1 - y)) (L2f 2⁻¹ (1 - y) * (-1)) y :=
    (hasDerivAt_L1f (β := 2⁻¹) h1).comp y ((hasDerivAt_id y).const_sub 1)
  have h := (((hasDerivAt_deriv_J hy).const_mul c).const_add 2).sub hL
  have hev : deriv (fun y ↦ 2 * y + c * J y + L 2⁻¹ (1 - y) - 2) =ᶠ[𝓝 y]
      fun y ↦ 2 + c * deriv J y - L1f 2⁻¹ (1 - y) := by
    filter_upwards [Ioo_mem_nhds hy.1 hy.2] with z hz using (caseLJ_hasDerivAt_diag c hz).deriv
  rw [deriv2_J hy, deriv2_L_eq h1]
  exact (h.congr_of_eventuallyEq hev).congr_deriv (by ring)

/-! ### The boundary piece $x=\frac14$ -/

/-- The derivative of $t(y)=\frac y2+\frac18$. -/
theorem caseLJ_hasDerivAt_t (y : ℝ) : HasDerivAt (fun y : ℝ ↦ y / 2 + 8⁻¹) 2⁻¹ y := by
  simpa using ((hasDerivAt_id y).div_const 2).add_const 8⁻¹

/-- For $y\in(\frac34,1)$, $t(y)=\frac y2+\frac18\in(\frac12,1)$. -/
theorem caseLJ_t_mem {y : ℝ} (hy : y ∈ Ioo (3 / 4 : ℝ) 1) : y / 2 + 8⁻¹ ∈ Ioo (2⁻¹ : ℝ) 1 :=
  ⟨by linarith [hy.1], by linarith [hy.2]⟩

/-- The derivative of $f(y)=y-\frac14+cJ(y)+K-2J(\frac y2+\frac18)$ on $(\frac34,1)$. -/
theorem caseLJ_hasDerivAt_F (c K : ℝ) {y : ℝ} (hy : y ∈ Ioo (3 / 4 : ℝ) 1) :
    HasDerivAt (fun y ↦ y - 4⁻¹ + c * J y + K - 2 * J (y / 2 + 8⁻¹))
      (1 + c * deriv J y - deriv J (y / 2 + 8⁻¹)) y := by
  have hy' : y ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨by linarith [hy.1], hy.2⟩
  have hJt : HasDerivAt (fun y ↦ J (y / 2 + 8⁻¹)) (deriv J (y / 2 + 8⁻¹) * 2⁻¹) y :=
    (hasDerivAt_J_deriv (caseLJ_t_mem hy)).comp y (caseLJ_hasDerivAt_t y)
  have h := ((((hasDerivAt_id y).sub_const 4⁻¹).add
    ((hasDerivAt_J_deriv hy').const_mul c)).add_const K).sub (hJt.const_mul 2)
  exact h.congr_deriv (by ring)

/-- The second derivative of $f$ on $(\frac34,1)$:
$f''(y)=cJ''(y)-\frac12J''(\frac y2+\frac18)$. -/
theorem caseLJ_hasDerivAt_deriv_F (c K : ℝ) {y : ℝ} (hy : y ∈ Ioo (3 / 4 : ℝ) 1) :
    HasDerivAt (deriv (fun y ↦ y - 4⁻¹ + c * J y + K - 2 * J (y / 2 + 8⁻¹)))
      (c * deriv (deriv J) y - 2⁻¹ * deriv (deriv J) (y / 2 + 8⁻¹)) y := by
  have hy' : y ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨by linarith [hy.1], hy.2⟩
  have hJt0 := (hasDerivAt_deriv_J (caseLJ_t_mem hy)).comp y (caseLJ_hasDerivAt_t y)
  have hJt : HasDerivAt (fun y ↦ deriv J (y / 2 + 8⁻¹))
      (-2 * (J (y / 2 + 8⁻¹))⁻¹ * 2⁻¹) y := hJt0
  have h := (((hasDerivAt_deriv_J hy').const_mul c).const_add 1).sub hJt
  have hev : deriv (fun y ↦ y - 4⁻¹ + c * J y + K - 2 * J (y / 2 + 8⁻¹)) =ᶠ[𝓝 y]
      fun y ↦ 1 + c * deriv J y - deriv J (y / 2 + 8⁻¹) := by
    filter_upwards [Ioo_mem_nhds hy.1 hy.2] with z hz using (caseLJ_hasDerivAt_F c K hz).deriv
  rw [deriv2_J hy', deriv2_J (caseLJ_t_mem hy)]
  exact (h.congr_of_eventuallyEq hev).congr_deriv (by ring)

/-- $f(y)=y-\frac14+cJ(y)+K-2J(\frac y2+\frac18)$ is continuous on $[\frac34,1]$. -/
theorem caseLJ_continuousOn_F (c K : ℝ) :
    ContinuousOn (fun y ↦ y - 4⁻¹ + c * J y + K - 2 * J (y / 2 + 8⁻¹)) (Icc (3 / 4) 1) := by
  have hJ : ContinuousOn J (Icc (3 / 4) 1) :=
    continuousOn_J.mono (Icc_subset_Icc (by norm_num) le_rfl)
  have hJt : ContinuousOn (fun y ↦ J (y / 2 + 8⁻¹)) (Icc (3 / 4) 1) :=
    continuousOn_J.comp (by fun_prop)
      (fun z hz ↦ ⟨by linarith [hz.1], by linarith [hz.2]⟩)
  exact ((((continuousOn_id.sub continuousOn_const).add (continuousOn_const.mul hJ)).add
    continuousOn_const)).sub (continuousOn_const.mul hJt)

/-- $J$ has the one-sided derivative $J'(\frac12)=\sqrt2\,\Phi^{-1}(\frac1{2w_0})$
(`Checker.DJr 2⁻¹`) at the endpoint $\frac12$ of $[\frac12,1]$; more precisely $J=J_{w_0}$ on
$[\frac12,1]$ and $J_{w_0}$ is differentiable at $\frac12$. -/
theorem caseLJ_hasDerivAt_gJw_half : HasDerivAt (gJw w₀) (Checker.DJr 2⁻¹) 2⁻¹ := by
  have h := hasDerivAt_gJw w₀_pos (x := 2⁻¹) ⟨one_sub_w₀_lt_half, by norm_num⟩
  rw [← div_eq_inv_mul] at h
  exact h

/-- The one-sided derivative of $J$ at $\frac12$: `derivWithin J (Icc 2⁻¹ 1) 2⁻¹` is
`Checker.DJr 2⁻¹`. -/
theorem caseLJ_derivWithin_J_half : derivWithin J (Icc 2⁻¹ 1) 2⁻¹ = Checker.DJr 2⁻¹ := by
  have h : HasDerivWithinAt J (Checker.DJr 2⁻¹) (Icc 2⁻¹ 1) 2⁻¹ :=
    caseLJ_hasDerivAt_gJw_half.hasDerivWithinAt.congr (fun z hz ↦ J_eq_gJw_w₀ hz)
      (J_eq_gJw_w₀ ⟨le_rfl, by norm_num⟩)
  exact h.derivWithin (uniqueDiffOn_Icc (by norm_num) _ (left_mem_Icc.2 (by norm_num)))

/-- The one-sided derivative of $y\mapsto J(\frac y2+\frac18)$ at $\frac34$ (on $[\frac34,1]$)
is $\frac12J'(\frac12)$ (one-sided). -/
theorem caseLJ_hasDerivWithinAt_J_t :
    HasDerivWithinAt (fun y ↦ J (y / 2 + 8⁻¹)) (Checker.DJr 2⁻¹ * 2⁻¹) (Icc (3 / 4) 1)
      (3 / 4) := by
  have h0 : (3 / 4 : ℝ) / 2 + 8⁻¹ = 2⁻¹ := by norm_num
  have hg : HasDerivAt (gJw w₀) (Checker.DJr 2⁻¹) ((3 / 4 : ℝ) / 2 + 8⁻¹) := by
    rw [h0]; exact caseLJ_hasDerivAt_gJw_half
  have h := (hg.comp (3 / 4 : ℝ) (caseLJ_hasDerivAt_t (3 / 4))).hasDerivWithinAt
    (s := Icc (3 / 4) 1)
  refine h.congr (fun z hz ↦ J_eq_gJw_w₀ ⟨by linarith [hz.1], by linarith [hz.2]⟩) ?_
  exact J_eq_gJw_w₀ ⟨by norm_num, by norm_num⟩

/-! ### The functions $h=J'/J$ and $r(y)=J(y)/J(t(y))$ -/

/-- The derivative of $J'/J$ on $(\frac12,1)$. -/
theorem caseLJ_hasDerivAt_logDeriv_J {u : ℝ} (hu : u ∈ Ioo (2⁻¹ : ℝ) 1) :
    HasDerivAt (fun u ↦ deriv J u / J u)
      ((deriv (deriv J) u * J u - deriv J u ^ 2) / J u ^ 2) u := by
  have hd2 : HasDerivAt (deriv J) (deriv (deriv J) u) u := by
    rw [deriv2_J hu]; exact hasDerivAt_deriv_J hu
  have h := hd2.div (hasDerivAt_J_deriv hu) (J_pos ⟨hu.1.le, hu.2⟩).ne'
  convert h using 1
  ring

/-- The derivative of $r(y)=J(y)/J(\frac y2+\frac18)$ on $(\frac34,1)$. -/
theorem caseLJ_hasDerivAt_ratio {y : ℝ} (hy : y ∈ Ioo (3 / 4 : ℝ) 1) :
    HasDerivAt (fun y ↦ J y / J (y / 2 + 8⁻¹))
      ((deriv J y * J (y / 2 + 8⁻¹) - 2⁻¹ * J y * deriv J (y / 2 + 8⁻¹)) /
        J (y / 2 + 8⁻¹) ^ 2) y := by
  have hy' : y ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨by linarith [hy.1], hy.2⟩
  have ht := caseLJ_t_mem hy
  have hJt : HasDerivAt (fun y ↦ J (y / 2 + 8⁻¹)) (deriv J (y / 2 + 8⁻¹) * 2⁻¹) y :=
    (hasDerivAt_J_deriv ht).comp y (caseLJ_hasDerivAt_t y)
  have h := (hasDerivAt_J_deriv hy').div hJt (J_pos ⟨ht.1.le, ht.2⟩).ne'
  exact h.congr_deriv (by ring)

