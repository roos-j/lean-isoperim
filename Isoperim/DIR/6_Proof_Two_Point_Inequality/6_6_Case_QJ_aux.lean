/-! ## [DIR] §6.6 Case $QJ$: auxiliary lemmas

Auxiliary results for `6_6_Case_QJ.lean`:

* monotonicity of $\beta\mapsto(a^{1/\beta}+b^{1/\beta})^\beta$ (hence of $G^1_\beta[B](x,y)$ in
  $\beta$) and the comparison with the $\ell^2$ expression;
* the values of $b_\beta$ on $[\frac14,\frac12]$ and on $[\frac12,\infty)$;
* the lower bounds $J_{w_0}(m)\ge1-m$ on $[\frac12,1]$ and
  $J_{w_0}(m)\ge\frac{m-(1-w_0)}{2w_0-1}$ on $[1-w_0,\frac12]$ (concavity of $I$), and the upper
  bound $Q_\beta\le\frac56$ on $[0,\frac12]$;
* positivity of $2J_{w_0}(\frac{x+y}2)-Q_\beta(x)$ on $[\frac14,\frac12]\times[\frac12,\frac58]$;
* the $x$-derivative of $g_{QJ,\beta,c}$ (§6.6.1): the formula
  $-\beta\partial_xg_{QJ,\beta,c}=(y-x)^{\frac1\beta-1}+c^{\frac1\beta}
  (2J_{w_0}(\frac{x+y}2)-Q_\beta(x))^{\frac1\beta-1}(J_{w_0}'(\frac{x+y}2)-Q_\beta'(x))$
  and the resulting antitonicity of $x\mapsto g_{QJ,\beta,c}(x,y)$.

Here $g_{QJ,\beta,c}$ is written out explicitly (it is defined in the main file as `g_QJ`):
$(y-x)^{1/\beta}+c^{1/\beta}J(y)^{1/\beta}-c^{1/\beta}(2J_{w_0}(\frac{x+y}2)-Q_\beta(x))^{1/\beta}$.
-/

namespace Auto.DIR

open Real Set

/-- For $a,b\ge0$, $\beta\mapsto(a^{1/\beta}+b^{1/\beta})^\beta$ is increasing on $(0,\infty)$
(the $\ell^p$ norm is decreasing in $p$). -/
theorem rpow_inv_add_rpow_inv_monotoneOn {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    MonotoneOn (fun β : ℝ ↦ (a ^ β⁻¹ + b ^ β⁻¹) ^ β) (Ioi 0) := by
  intro β₁ h₁ β₂ h₂ h12
  have h := Real.rpow_add_rpow_le ha hb (inv_pos.2 h₂) (inv_anti₀ h₁ h12)
  simpa [one_div, inv_inv] using h

/-- $G^1_\beta[B](x,y)$ is increasing in $\beta\in(0,\infty)$ if $x\le y$ and $B(y)\ge0$ (only
the first summand depends on $\beta$). -/
theorem G₁_monotoneOn_beta_of_le (B : ℝ → ℝ) (x y : ℝ) (hxy : x ≤ y) (hB : 0 ≤ B y) :
    MonotoneOn (fun β ↦ G₁ β B x y) (Ioi 0) := by
  intro β₁ h₁ β₂ h₂ h12
  have := rpow_inv_add_rpow_inv_monotoneOn (sub_nonneg.2 hxy) hB h₁ h₂ h12
  simp only [G₁] at this ⊢
  linarith

/-- For $a,b\ge0$ and $\beta\ge\frac12$: $(a^2+b^2)^{1/2}\le(a^{1/\beta}+b^{1/\beta})^\beta$. -/
theorem sq_add_sq_rpow_half_le {a b β : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hβ : 2⁻¹ ≤ β) :
    (a ^ 2 + b ^ 2) ^ (2⁻¹ : ℝ) ≤ (a ^ β⁻¹ + b ^ β⁻¹) ^ β := by
  have hβ0 : 0 < β := lt_of_lt_of_le (by norm_num) hβ
  have hp : β⁻¹ ≤ 2 := by
    rw [inv_le_comm₀ hβ0 two_pos]; exact hβ
  have h := Real.rpow_add_rpow_le ha hb (inv_pos.2 hβ0) hp
  simp only [one_div, inv_inv] at h
  have e : ∀ z : ℝ, z ^ (2 : ℝ) = z ^ (2 : ℕ) := fun z ↦ by exact_mod_cast rpow_natCast z 2
  rwa [e a, e b] at h

/-- The value $Q_\beta(\frac12)=\frac12$. -/
theorem Q_half_QJ (β : ℝ) : Q β 2⁻¹ = 2⁻¹ := by
  rw [Q_eq_affine]; norm_num

/-- $b_\beta(x)=Q_\beta(x)$ for $x\in[\frac14,\frac12]$ (at $x=\frac14$:
$L_\beta(\frac14)=\frac14\cdot2^\beta=Q_\beta(\frac14)$). -/
theorem b_eq_Q_of_mem (β x : ℝ) (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) : b β x = Q β x := by
  unfold b
  rcases hx.1.lt_or_eq with h | h
  · simp [not_le.2 h, hx.2]
  · subst h
    simp only [le_refl, ↓reduceIte]
    rw [L, Q_eq_affine]
    have h4 : logb 2 ((4 : ℝ)⁻¹)⁻¹ = 2 := by
      rw [inv_inv, show (4 : ℝ) = 2 ^ (2 : ℝ) by norm_num, logb_rpow two_pos (by norm_num)]
    rw [h4]; norm_num

/-- $b_\beta(x)=J(x)$ for $x\ge\frac12$ (at $x=\frac12$: $Q_\beta(\frac12)=\frac12=J(\frac12)$). -/
theorem b_eq_J_of_le (β x : ℝ) (hx : 2⁻¹ ≤ x) : b β x = J x := by
  unfold b
  rcases hx.lt_or_eq with h | h
  · have h' : ¬ x ≤ 4⁻¹ := by linarith
    simp [h', not_le.2 h]
  · subst h
    have h' : ¬ (2⁻¹ : ℝ) ≤ 4⁻¹ := by norm_num
    simp only [h', le_refl, ↓reduceIte]
    rw [Q_half_QJ, (J_half_eq_L_half 0).1]

/-- $J_{w_0}(\frac12)=\frac12$. -/
theorem gJw_w₀_half : gJw w₀ 2⁻¹ = 2⁻¹ := by
  rw [← J_eq_gJw_w₀ ⟨le_rfl, by norm_num⟩]; exact (J_half_eq_L_half 0).1

/-- $J_{w_0}(m)\ge1-m$ for $m\in[\frac12,1]$: the chord bound from the concavity of $I$
($I(u)/u$ is decreasing). -/
theorem one_sub_le_gJw_w₀ {m : ℝ} (hm : m ∈ Icc (2⁻¹ : ℝ) 1) : 1 - m ≤ gJw w₀ m := by
  rcases hm.2.lt_or_eq with h1 | h1
  · rcases hm.1.lt_or_eq with h2 | h2
    · have hw := w₀_mem
      have hw0 := w₀_pos
      have hwi := inv_pos.2 hw0
      have hv : 0 < w₀⁻¹ * (1 - m) := mul_pos hwi (by linarith)
      have hvu : w₀⁻¹ * (1 - m) < w₀⁻¹ * (1 - 2⁻¹) :=
        mul_lt_mul_of_pos_left (by linarith) hwi
      have hu : w₀⁻¹ * (1 - 2⁻¹) ≤ 1 := by
        rw [inv_mul_le_iff₀ hw0]; linarith [hw.1]
      have h := gProf_div_lt hv hvu hu
      have hh := gJw_w₀_half
      unfold gJw at hh ⊢
      rw [div_lt_div_iff₀ (by linarith) hv] at h
      set P := gProf (w₀⁻¹ * (1 - 2⁻¹))
      set R := gProf (w₀⁻¹ * (1 - m))
      have key : P * (1 - m) < R * 2⁻¹ := by
        have e1 : w₀ * (P * (w₀⁻¹ * (1 - m))) = P * (1 - m) := by field_simp
        have e2 : w₀ * (R * (w₀⁻¹ * (1 - 2⁻¹))) = R * 2⁻¹ := by field_simp; ring
        rw [← e1, ← e2]; exact mul_lt_mul_of_pos_left h hw0
      have hs : 0 < √2 * w₀ := by positivity
      nlinarith [mul_lt_mul_of_pos_left key hs]
    · subst h2; rw [gJw_w₀_half]; norm_num
  · subst h1; rw [gJw_one]; norm_num

/-- $J(m)\ge1-m$ for $m\in[\frac12,1]$. -/
theorem one_sub_le_J {m : ℝ} (hm : m ∈ Icc (2⁻¹ : ℝ) 1) : 1 - m ≤ J m := by
  rw [J_eq_gJw_w₀ hm]; exact one_sub_le_gJw_w₀ hm

/-- $J_{w_0}(m)\ge\frac{m-(1-w_0)}{2w_0-1}$ for $m\in[1-w_0,\frac12]$: the chord bound between
$1-w_0$ (where $J_{w_0}=0$) and $\frac12$ (where $J_{w_0}=\frac12$), from the concavity of $I$. -/
theorem gJw_w₀_ge_chord {m : ℝ} (hm : m ∈ Icc (1 - w₀) 2⁻¹) :
    (m - (1 - w₀)) / (2 * w₀ - 1) ≤ gJw w₀ m := by
  have hw := w₀_mem
  have hw0 := w₀_pos
  have hwi := inv_pos.2 hw0
  have hd : 0 < 2 * w₀ - 1 := by linarith [hw.1]
  rcases hm.1.lt_or_eq with h1 | h1
  · rcases hm.2.lt_or_eq with h2 | h2
    · -- with $v'=1-w_0^{-1}(1-m)$ and $u'=1-w_0^{-1}/2$: $0<v'<u'\le1$
      have hv : 0 < 1 - w₀⁻¹ * (1 - m) := by
        rw [sub_pos, inv_mul_lt_iff₀ hw0]; linarith
      have hvu : 1 - w₀⁻¹ * (1 - m) < 1 - w₀⁻¹ * (1 - 2⁻¹) := by
        have := mul_lt_mul_of_pos_left (show 1 - 2⁻¹ < 1 - m by linarith) hwi
        linarith
      have hu : 1 - w₀⁻¹ * (1 - 2⁻¹) ≤ 1 := by
        have : 0 ≤ w₀⁻¹ * (1 - 2⁻¹) := by positivity
        linarith
      have h := gProf_div_lt hv hvu hu
      have hh := gJw_w₀_half
      unfold gJw at hh ⊢
      rw [gProf_one_sub, gProf_one_sub, div_lt_div_iff₀ (by linarith) hv] at h
      set P := gProf (w₀⁻¹ * (1 - 2⁻¹))
      set R := gProf (w₀⁻¹ * (1 - m))
      have e1 : 1 - w₀⁻¹ * (1 - m) = (m - (1 - w₀)) / w₀ := by field_simp; ring
      have e2 : 1 - w₀⁻¹ * (1 - 2⁻¹) = (2 * w₀ - 1) / (2 * w₀) := by field_simp; ring
      rw [e1, e2] at h
      have key : P * (m - (1 - w₀)) * 2 < R * (2 * w₀ - 1) := by
        have h' : P * ((m - (1 - w₀)) / w₀) * (2 * w₀) <
            R * ((2 * w₀ - 1) / (2 * w₀)) * (2 * w₀) :=
          mul_lt_mul_of_pos_right h (by positivity)
        have e3 : P * ((m - (1 - w₀)) / w₀) * (2 * w₀) = P * (m - (1 - w₀)) * 2 := by
          field_simp
        have e4 : R * ((2 * w₀ - 1) / (2 * w₀)) * (2 * w₀) = R * (2 * w₀ - 1) := by
          field_simp
        rwa [e3, e4] at h'
      rw [div_le_iff₀ hd]
      have hs : 0 < √2 * w₀ := by positivity
      nlinarith [mul_lt_mul_of_pos_left key hs]
    · subst h2
      rw [gJw_w₀_half, div_le_iff₀ hd]; linarith
  · subst h1
    rw [sub_self, zero_div]
    unfold gJw
    have := gProf_nonneg (w₀⁻¹ * (1 - (1 - w₀)))
    positivity

/-- $Q_\beta(x)\le\frac56$ for $x\in[0,\frac12]$ and $\beta\in[0,1]$. -/
theorem Q_le_five_sixths (β : ℝ) (hβ : β ∈ Icc (0 : ℝ) 1) (x : ℝ) (hx : x ∈ Icc (0 : ℝ) 2⁻¹) :
    Q β x ≤ 5 / 6 := by
  have ht : (2 : ℝ) ^ β ≤ 2 := by
    simpa using rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2) hβ.2
  rw [Q_eq_affine]
  have hc : 0 ≤ 2 / 3 * x * (1 - x) * (4 - 8 * x) := by
    have := hx.1; have := hx.2
    have : 0 ≤ 1 - x := by linarith
    have : 0 ≤ 4 - 8 * x := by linarith
    positivity
  have := mul_le_mul_of_nonneg_left ht hc
  have h1 := hx.1; have h2 := hx.2
  nlinarith [mul_nonneg h1 (show 0 ≤ 2⁻¹ - x by linarith),
    mul_nonneg (mul_nonneg h1 h1) (show 0 ≤ 2⁻¹ - x by linarith)]

/-- $Q_{1/2}(x)\le Q_\beta(x)$ for $x\in[0,\frac12]$ and $\beta\ge\frac12$ ($Q_\beta(x)$ is
increasing in $\beta$ there). -/
theorem Q_half_le_Q (β : ℝ) (hβ : 2⁻¹ ≤ β) (x : ℝ) (hx : x ∈ Icc (0 : ℝ) 2⁻¹) :
    Q 2⁻¹ x ≤ Q β x := by
  have ht : (2 : ℝ) ^ (2⁻¹ : ℝ) ≤ 2 ^ β := rpow_le_rpow_of_exponent_le (by norm_num) hβ
  rw [Q_eq_affine, Q_eq_affine]
  have hc : 0 ≤ 2 / 3 * x * (1 - x) * (4 - 8 * x) := by
    have := hx.1; have := hx.2
    have : 0 ≤ 1 - x := by linarith
    have : 0 ≤ 4 - 8 * x := by linarith
    positivity
  have := mul_le_mul_of_nonneg_left ht hc
  linarith

/-- For $\beta>0$, $S,K\ge0$: $S^\beta-K\ge0\iff S-K^{1/\beta}\ge0$. -/
theorem rpow_sub_nonneg_iff {β S K : ℝ} (hβ : 0 < β) (hS : 0 ≤ S) (hK : 0 ≤ K) :
    S ^ β - K ≥ 0 ↔ S - K ^ β⁻¹ ≥ 0 := by
  rw [ge_iff_le, sub_nonneg, ge_iff_le, sub_nonneg,
    ← rpow_le_rpow_iff hK (rpow_nonneg hS β) (inv_pos.2 hβ), rpow_rpow_inv hS hβ.ne']

/-- $2J(\frac{x+y}2)-Q_\beta(x)\ge\frac1{24}>0$ for $x\in[0,\frac12]$, $y\le\frac58$,
$x+y\ge1$ and $\beta\in[0,1]$ (using $J(m)\ge1-m$ and $Q_\beta\le\frac56$). -/
theorem two_J_sub_Q_pos_aux (x y : ℝ) (hx : x ∈ Icc (0 : ℝ) 2⁻¹) (hy : y ≤ 5 / 8)
    (hxy : 1 ≤ x + y) (β : ℝ) (hβ : β ∈ Icc (0 : ℝ) 1) :
    2 * J ((x + y) / 2) - Q β x ≥ 24⁻¹ := by
  have hJ := one_sub_le_J (m := (x + y) / 2) ⟨by linarith, by linarith [hx.2]⟩
  have hQ := Q_le_five_sixths β hβ x hx
  linarith [hx.2]

/-- $2J_{w_0}(\frac{x+y}2)-Q_\beta(x)>0$ on the rectangle $[\frac14,\frac12]\times[\frac12,\frac58]$
for $\beta\in[0,1]$. (For $\frac{x+y}2\ge\frac12$ use $J_{w_0}(m)\ge1-m$; for $\frac{x+y}2<\frac12$
use the chord bound $J_{w_0}(m)\ge\frac{m-(1-w_0)}{2w_0-1}$, with $w_0\in[0.895,0.896]$, and
$Q_\beta(x)\le\frac23$ for $x\in[\frac14,\frac12]$.) -/
theorem two_Jw_sub_Q_pos_rect (x y : ℝ) (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹)
    (hy : y ∈ Icc (2⁻¹ : ℝ) (5 / 8)) (β : ℝ) (hβ : β ∈ Icc (0 : ℝ) 1) :
    0 < 2 * Jw w₀ ((x + y) / 2) - Q β x := by
  have hJw : Jw w₀ = gJw w₀ := rfl
  rw [hJw]
  rcases le_or_gt 2⁻¹ ((x + y) / 2) with hm | hm
  · have hJ := one_sub_le_gJw_w₀ (m := (x + y) / 2) ⟨hm, by linarith [hx.2, hy.2]⟩
    have hQ := Q_le_five_sixths β hβ x ⟨by linarith [hx.1], hx.2⟩
    linarith [hx.2, hy.2]
  · have hw := w₀_mem
    have hd : 0 < 2 * w₀ - 1 := by linarith [hw.1]
    have hJ := gJw_w₀_ge_chord (m := (x + y) / 2) ⟨by linarith [hx.1, hy.1, hw.1], hm.le⟩
    rw [div_le_iff₀ hd] at hJ
    -- $Q_\beta(x)\le\frac23$ on $[\frac14,\frac12]$
    have ht : (2 : ℝ) ^ β ≤ 2 := by
      simpa using rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2) hβ.2
    have hQ : Q β x ≤ 2 / 3 := by
      rw [Q_eq_affine]
      have h1 := hx.1; have h2 := hx.2
      have hc : 0 ≤ 2 / 3 * x * (1 - x) * (4 - 8 * x) := by
        have : 0 ≤ x := by linarith
        have : 0 ≤ 1 - x := by linarith
        have : 0 ≤ 4 - 8 * x := by linarith
        positivity
      have := mul_le_mul_of_nonneg_left ht hc
      nlinarith [mul_nonneg (show 0 ≤ x - 4⁻¹ by linarith) (show 0 ≤ 2⁻¹ - x by linarith),
        mul_nonneg (mul_nonneg (show 0 ≤ x - 4⁻¹ by linarith) (show 0 ≤ 2⁻¹ - x by linarith))
          (show 0 ≤ x by linarith)]
    -- $2J_{w_0}(m)(2w_0-1)\ge2(m-1+w_0)>\frac23(2w_0-1)$
    have hJpos : 0 ≤ gJw w₀ ((x + y) / 2) := by
      unfold gJw; have := gProf_nonneg (w₀⁻¹ * (1 - (x + y) / 2)); have := w₀_pos; positivity
    nlinarith [hw.1, hw.2, hx.1, hy.1, mul_nonneg hJpos (sub_nonneg.2 hw.2)]

/-- The derivative of $x\mapsto g_{QJ,\beta,c}(x,y)$, written out explicitly ([DIR], §6.6.1): for
$0<\beta\le1$ (so $\frac1\beta\ge1$; $y-x$ may be $0$ or negative), $\frac{x+y}2\in(1-w_0,1)$ (where
$J_{w_0}$ is smooth) and $2J_{w_0}(\frac{x+y}2)-Q_\beta(x)>0$,
$$\partial_x\Big[(y-x)^{\frac1\beta}+c^{\frac1\beta}J(y)^{\frac1\beta}
-c^{\frac1\beta}(2J_{w_0}(\tfrac{x+y}2)-Q_\beta(x))^{\frac1\beta}\Big]
=-\tfrac1\beta\Big[(y-x)^{\frac1\beta-1}
+c^{\frac1\beta}(2J_{w_0}(\tfrac{x+y}2)-Q_\beta(x))^{\frac1\beta-1}
(J_{w_0}'(\tfrac{x+y}2)-Q_\beta'(x))\Big].$$ -/
theorem hasDerivAt_g_QJ_expr (β c x y : ℝ) (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hm : (x + y) / 2 ∈ Ioo (1 - w₀) 1) (hD : 0 < 2 * Jw w₀ ((x + y) / 2) - Q β x) :
    HasDerivAt (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹)
      (-β⁻¹ * ((y - x) ^ (β⁻¹ - 1) + c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ (β⁻¹ - 1) *
        (deriv (Jw w₀) ((x + y) / 2) - deriv (Q β) x))) x := by
  have hp : 1 ≤ β⁻¹ := (one_le_inv₀ hβ).2 hβ1
  have h1 : HasDerivAt (fun x ↦ (y - x) ^ β⁻¹) (-1 * β⁻¹ * (y - x) ^ (β⁻¹ - 1)) x :=
    ((hasDerivAt_id x).const_sub y).rpow_const (Or.inr hp)
  have hm' : HasDerivAt (fun x : ℝ ↦ (x + y) / 2) (1 / 2) x := by
    simpa using ((hasDerivAt_id x).add_const y).div_const 2
  have hJ : HasDerivAt (Jw w₀) (deriv (Jw w₀) ((x + y) / 2)) ((x + y) / 2) :=
    (hasDerivAt_gJw w₀_pos hm).differentiableAt.hasDerivAt
  have hDd := ((hJ.comp x hm').const_mul 2).sub (hasDerivAt_Q β x)
  have h2 := hDd.rpow_const (p := β⁻¹) (Or.inl hD.ne')
  have h := (h1.add_const (c ^ β⁻¹ * J y ^ β⁻¹)).sub (h2.const_mul (c ^ β⁻¹))
  have h' := h.congr_of_eventuallyEq (f₁ := fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
      c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹)
    (Filter.Eventually.of_forall fun z ↦ by simp [Function.comp])
  refine h'.congr_deriv ?_
  rw [deriv_Q_eq]
  simp only [Pi.sub_apply, Function.comp]
  ring

/-- With the hypotheses of `Auto.DIR.hasDerivAt_g_QJ_expr`:
$$-\beta\,\partial_x\Big[\dots\Big]=(y-x)^{\frac1\beta-1}+c^{\frac1\beta}
(2J_{w_0}(\tfrac{x+y}2)-Q_\beta(x))^{\frac1\beta-1}(J_{w_0}'(\tfrac{x+y}2)-Q_\beta'(x)).$$ -/
theorem neg_mul_deriv_g_QJ_expr (β c x y : ℝ) (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hm : (x + y) / 2 ∈ Ioo (1 - w₀) 1) (hD : 0 < 2 * Jw w₀ ((x + y) / 2) - Q β x) :
    -β * deriv (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) x =
      (y - x) ^ (β⁻¹ - 1) + c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ (β⁻¹ - 1) *
        (deriv (Jw w₀) ((x + y) / 2) - deriv (Q β) x) := by
  rw [(hasDerivAt_g_QJ_expr β c x y hβ hβ1 hm hD).deriv, ← mul_assoc, neg_mul_neg,
    mul_inv_cancel₀ hβ.ne', one_mul]

/-- If $x\mapsto g(x)=(y-x)^{1/\beta}+c^{1/\beta}J(y)^{1/\beta}-c^{1/\beta}(2J_{w_0}(\frac{x+y}2)
-Q_\beta(x))^{1/\beta}$ has the derivative of `Auto.DIR.hasDerivAt_g_QJ_expr` on $[a,b]$ (i.e.
$\frac{x+y}2\in(1-w_0,1)$ and $2J_{w_0}(\frac{x+y}2)-Q_\beta(x)>0$ there) and $\partial_xg\le0$ on
$[a,b]$, then $g$ is antitone on $[a,b]$. -/
theorem antitoneOn_g_QJ_expr {β c y a b : ℝ} (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hm : ∀ x ∈ Icc a b, (x + y) / 2 ∈ Ioo (1 - w₀) 1)
    (hD : ∀ x ∈ Icc a b, 0 < 2 * Jw w₀ ((x + y) / 2) - Q β x)
    (h : ∀ x ∈ Icc a b, deriv (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) x ≤ 0) :
    AntitoneOn (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) (Icc a b) := by
  have hd := fun x (hx : x ∈ Icc a b) ↦ hasDerivAt_g_QJ_expr β c x y hβ hβ1 (hm x hx) (hD x hx)
  apply antitoneOn_of_deriv_nonpos (convex_Icc a b)
  · exact fun x hx ↦ (hd x hx).continuousAt.continuousWithinAt
  · intro x hx
    rw [interior_Icc] at hx
    exact (hd x (Ioo_subset_Icc_self hx)).differentiableAt.differentiableWithinAt
  · intro x hx
    rw [interior_Icc] at hx
    exact h x (Ioo_subset_Icc_self hx)

/-- On the rectangle $[\frac14,\frac12]\times[\frac12,\frac58]$ of (6.26), for $\beta\in(0,1]$ the
hypotheses of `Auto.DIR.hasDerivAt_g_QJ_expr` hold, so
$$-\beta\,\partial_xg_{QJ,\beta,c}(x,y)=(y-x)^{\frac1\beta-1}+c^{\frac1\beta}
(2J_{w_0}(\tfrac{x+y}2)-Q_\beta(x))^{\frac1\beta-1}(J_{w_0}'(\tfrac{x+y}2)-Q_\beta'(x))$$
(with $g_{QJ,\beta,c}$ written out), and $x\mapsto g_{QJ,\beta,c}(x,y)$ is differentiable at $x$. -/
theorem neg_mul_deriv_g_QJ_expr_rect (β c x y : ℝ) (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) (hy : y ∈ Icc (2⁻¹ : ℝ) (5 / 8)) :
    DifferentiableAt ℝ (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) x ∧
    -β * deriv (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) x =
      (y - x) ^ (β⁻¹ - 1) + c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ (β⁻¹ - 1) *
        (deriv (Jw w₀) ((x + y) / 2) - deriv (Q β) x) := by
  have hm : (x + y) / 2 ∈ Ioo (1 - w₀) 1 := by
    have := w₀_mem.1
    constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]
  have hD := two_Jw_sub_Q_pos_rect x y hx hy β ⟨hβ.le, hβ1⟩
  exact ⟨(hasDerivAt_g_QJ_expr β c x y hβ hβ1 hm hD).differentiableAt,
    neg_mul_deriv_g_QJ_expr β c x y hβ hβ1 hm hD⟩

/-- On triangle I of §6.6.1 (for fixed $y\in[\frac12,\frac58]$, the $x$-range is
$[\max(\frac38,1-y),\frac12]$), for $\beta\in(0,1]$: if $\partial_xg_{QJ,\beta,c}(x,y)\le0$ there,
then $x\mapsto g_{QJ,\beta,c}(x,y)$ (written out) is antitone there. -/
theorem antitoneOn_g_QJ_expr_triangle {β c y : ℝ} (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hy : y ∈ Icc (2⁻¹ : ℝ) (5 / 8))
    (h : ∀ x ∈ Icc (max (3 / 8) (1 - y)) 2⁻¹,
      deriv (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) x ≤ 0) :
    AntitoneOn (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) (Icc (max (3 / 8) (1 - y)) 2⁻¹) := by
  have hx' : ∀ x ∈ Icc (max (3 / 8) (1 - y)) 2⁻¹, x ∈ Icc (4⁻¹ : ℝ) 2⁻¹ :=
    fun x hx ↦ ⟨by linarith [le_max_left (3 / 8 : ℝ) (1 - y), hx.1], hx.2⟩
  refine antitoneOn_g_QJ_expr hβ hβ1 (fun x hx ↦ ?_) (fun x hx ↦ ?_) h
  · have hw := w₀_mem.1
    have := hx' x hx
    constructor <;> linarith [this.1, this.2, hy.1, hy.2]
  · exact two_Jw_sub_Q_pos_rect x y (hx' x hx) hy β ⟨hβ.le, hβ1⟩

end Auto.DIR

/-! ## [DIR] §6.6 Case $QJ$: the tight lower bounds of $-\beta\partial_xg_{QJ,\beta,c}$ and
$g_{QJ,2}$

Auxiliary file of `6_6_Case_QJ.lean` for the computer-assisted claims (6.26) and (6.27)
([DIR], §6.6). As in the main file, $J$ at the midpoint $\frac{x+y}2$ is read as
$J_{w_0}$ (`gJw w₀`), which is defined and smooth on $(1-w_0,1)$.

* certified values of $J_{w_0}$ and $J_{w_0}'$ at rational points of $(1-w_0,1)$ (`JwVal`,
  `DJwVal`), also below $\frac12$;
* the enclosures (6.2) of [DIR], §6.1.1 for $J_{w_0}$: $J_{w_0}$ is increasing on
  $[1-w_0,x_0]$ and decreasing on $[x_0,1]$, so $\min(J_{w_0}(\underline m),J_{w_0}(\overline m))\le
  J_{w_0}\le\overline J(\underline m,\overline m)$ on $[\underline m,\overline m]$; $J_{w_0}'$ is
  decreasing, so $|J_{w_0}'|\le\max(|J_{w_0}'(\underline m)|,|J_{w_0}'(\overline m)|)$;
* the paper's tight lower bounds $\underline{g_{QJ,1,\beta,c}}$ (6.26) and $\underline{g_{QJ,2}}$
  (6.27), their lower-bound properties, the box certificates and soundness of partitioning.

**Discrepancy with the paper.** In $\underline{g_{QJ,1,\beta,c}}$ the base
$2\underline J-Q_\beta(\overline x)$ of the first $c^{1/\beta}$-term is replaced by its positive
part
$\max(2\underline J-Q_\beta(\overline x),0)$ (equal to it on all rectangles of the partition), so
that the lower-bound property holds on all subrectangles. The rectangle-dependent case distinction
$\overline m<x_0$ (with $\overline m=\frac{\overline x+\overline y}2$) is decided per rectangle by a
rational enclosure of $x_0$ (`x₀_mem_11`).
-/

namespace Auto.DIR

open Real Set Checker

/-! ### Certified values of $J_{w_0}$ and $J_{w_0}'$ -/

/-- $x_0\in[0.5521153369715,0.552115336976]$ (from `w₀_mem_11`). -/
theorem x₀_mem_11 : x₀ ∈ Icc (0.5521153369715 : ℝ) 0.552115336976 := by
  have h := w₀_mem_11
  rw [x₀]; constructor <;> linarith [h.1, h.2]

/-- The Boolean check of an enclosure $l\le J_{w_0}(x)\le u$ by `gJwIv` (witnesses
$s_l,s_u$). -/
def jwCheck (x l u sl su : ℚ) : Bool :=
  match gJwIv P11 P11.wl P11.wu x sl su with
  | some I => decide (l ≤ I.1 ∧ I.2 ≤ u)
  | none => false

/-- Soundness of `jwCheck`. -/
theorem jwCheck_sound {x l u sl su : ℚ} (h : jwCheck x l u sl su = true) :
    (l : ℝ) ≤ gJw w₀ x ∧ gJw w₀ x ≤ u := by
  unfold jwCheck at h
  rcases he : gJwIv P11 P11.wl P11.wu x sl su with _ | ⟨a, b⟩ <;> rw [he] at h
  · cases h
  obtain ⟨h1, h2⟩ := of_decide_eq_true h
  obtain ⟨m1, m2⟩ := gJwIv_sound P11 he hw11
  have h1' : (l : ℝ) ≤ a := by exact_mod_cast h1
  have h2' : (b : ℝ) ≤ u := by exact_mod_cast h2
  exact ⟨h1'.trans m1, m2.trans h2'⟩

/-- A certified enclosure $l\le J_{w_0}(x)\le u$ at a rational point $x$. -/
structure JwVal where
  /-- The point. -/
  x : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The enclosure. -/
  h : (l : ℝ) ≤ gJw w₀ x ∧ gJw w₀ x ≤ u

/-- A `JwVal` from a kernel-checked `jwCheck`. -/
def JwVal.mk' (x l u sl su : ℚ) (h : jwCheck x l u sl su = true) : JwVal :=
  ⟨x, l, u, jwCheck_sound h⟩

/-- A certified enclosure $l\le J_{w_0}'(x)\le u$ (`DJr x`) at a rational point $x$. -/
structure DJwVal where
  /-- The point. -/
  x : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The enclosure. -/
  h : (l : ℝ) ≤ DJr x ∧ DJr x ≤ u

/-- A `DJwVal` from a kernel-checked enclosure by the node `DJ x zl zu`. -/
def DJwVal.mk' (x l u zl zu : ℚ) (h : checkMem P11 [] (.DJ x zl zu) l u = true) : DJwVal :=
  ⟨x, l, u, checkMem_sound P11 hw11 [] (.DJ x zl zu) l u h⟩

/-- A `JwVal` as an entry of the environment of the checker. -/
noncomputable def JwVal.cert (j : JwVal) : Cert := ⟨j.l, j.u, gJw w₀ j.x, j.h⟩

/-- A `DJwVal` as an entry of the environment of the checker. -/
noncomputable def DJwVal.cert (j : DJwVal) : Cert := ⟨j.l, j.u, DJr j.x, j.h⟩

/-- Lower end of the certified enclosure of $J(x_0)$. -/
def jx0L : ℚ := 0.505383723016

/-- Upper end of the certified enclosure of $J(x_0)$. -/
def jx0U : ℚ := 0.505383723024

/-- Certified enclosure of $J(x_0)=J_{w_0}(x_0)$. -/
theorem jx0_h : jx0L ≤ gJw w₀ x₀ ∧ gJw w₀ x₀ ≤ jx0U := by
  have h := checkMem_sound P11 hw11 [] .Jx0 jx0L jx0U (by decide +kernel)
  simp only [denote] at h
  rwa [J_eq_gJw_w₀ ⟨x₀_mem_Ioo.1.le, x₀_mem_Ioo.2.le⟩] at h

/-- $J_{w_0}(x_0)$ as an entry of the environment of the checker. -/
noncomputable def jx0Cert : Cert := ⟨jx0L, jx0U, gJw w₀ x₀, jx0_h⟩

/-! ### Monotonicity of $J_{w_0}$ and $J_{w_0}'$ -/

/-- $J_{w_0}$ is increasing on $[1-w_0,x_0]$. -/
theorem gJw_monotoneOn : MonotoneOn (gJw w₀) (Icc (1 - w₀) x₀) := by
  have hx₀ := x₀_mem_Ioo
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _)
    ((continuousOn_gJw w₀_pos).mono (Icc_subset_Icc le_rfl hx₀.2.le)) ?_ ?_
  · intro y hy
    rw [interior_Icc] at hy
    exact (hasDerivAt_gJw w₀_pos ⟨hy.1, hy.2.trans hx₀.2⟩).differentiableAt.differentiableWithinAt
  · intro y hy
    rw [interior_Icc] at hy
    exact ((deriv_gJw_sign w₀_pos).2.1 y ⟨hy.1, by rw [← x₀]; exact hy.2⟩).le

/-- $J_{w_0}$ is decreasing on $[x_0,1]$. -/
theorem gJw_antitoneOn : AntitoneOn (gJw w₀) (Icc x₀ 1) := by
  have hx₀ := x₀_mem_Ioo
  have hw := one_sub_w₀_lt_half
  refine antitoneOn_of_deriv_nonpos (convex_Icc _ _)
    ((continuousOn_gJw w₀_pos).mono (Icc_subset_Icc (by linarith [hx₀.1]) le_rfl)) ?_ ?_
  · intro y hy
    rw [interior_Icc] at hy
    exact (hasDerivAt_gJw w₀_pos
      ⟨by linarith [hx₀.1, hy.1], hy.2⟩).differentiableAt.differentiableWithinAt
  · intro y hy
    rw [interior_Icc] at hy
    exact ((deriv_gJw_sign w₀_pos).2.2 y ⟨by rw [← x₀]; exact hy.1, hy.2⟩).le

/-- The upper enclosure (6.2) of $J_{w_0}$ on $[a,b]$: $J_{w_0}(b)$ if $b<x_0$, $J_{w_0}(a)$ if
$a>x_0$, $J_{w_0}(x_0)$ otherwise. -/
noncomputable def Jbar (a b : ℝ) : ℝ :=
  if b < x₀ then gJw w₀ b else if x₀ < a then gJw w₀ a else gJw w₀ x₀

/-- $J_{w_0}(m)\le\overline J(a,b)$ for $1-w_0\le a\le m\le b\le1$. -/
theorem gJw_le_Jbar {a m b : ℝ} (ha : 1 - w₀ ≤ a) (ham : a ≤ m) (hmb : m ≤ b) (hb : b ≤ 1) :
    gJw w₀ m ≤ Jbar a b := by
  have hx₀ := x₀_mem_Ioo
  have hw := one_sub_w₀_lt_half
  unfold Jbar
  split_ifs with h1 h2
  · exact gJw_monotoneOn ⟨by linarith, by linarith⟩ ⟨by linarith, h1.le⟩ hmb
  · exact gJw_antitoneOn ⟨h2.le, by linarith⟩ ⟨by linarith, hb.trans' hmb⟩ ham
  · rcases le_total m x₀ with h | h
    · exact gJw_monotoneOn ⟨by linarith, h⟩ ⟨by linarith, le_rfl⟩ h
    · exact gJw_antitoneOn ⟨le_rfl, by linarith⟩ ⟨h, by linarith⟩ h

/-- $\min(J_{w_0}(a),J_{w_0}(b))\le J_{w_0}(m)$ for $1-w_0\le a\le m\le b\le1$. -/
theorem min_gJw_le {a m b : ℝ} (ha : 1 - w₀ ≤ a) (ham : a ≤ m) (hmb : m ≤ b) (hb : b ≤ 1) :
    min (gJw w₀ a) (gJw w₀ b) ≤ gJw w₀ m := by
  have hx₀ := x₀_mem_Ioo
  rcases le_total m x₀ with h | h
  · exact (min_le_left _ _).trans (gJw_monotoneOn ⟨ha, by linarith⟩ ⟨by linarith, h⟩ ham)
  · exact (min_le_right _ _).trans (gJw_antitoneOn ⟨h, by linarith⟩ ⟨by linarith, hb⟩ hmb)

/-- $|J_{w_0}'(m)|\le\max(|J_{w_0}'(a)|,|J_{w_0}'(b)|)$ for $1-w_0<a\le m\le b<1$. -/
theorem abs_DJr_le {a m b : ℝ} (ha : 1 - w₀ < a) (ham : a ≤ m) (hmb : m ≤ b) (hb : b < 1) :
    |DJr m| ≤ max (|DJr a|) (|DJr b|) := by
  have h1 := DJr_antitoneOn_QJ ⟨ha, by linarith⟩ ⟨by linarith, by linarith⟩ ham
  have h2 := DJr_antitoneOn_QJ ⟨by linarith, by linarith⟩ ⟨by linarith, hb⟩ hmb
  rw [abs_le]
  constructor
  · have := neg_abs_le (DJr b); have := le_max_right |DJr a| |DJr b|; linarith
  · have := le_abs_self (DJr a); have := le_max_left |DJr a| |DJr b|; linarith

/-- $J_{w_0}'(b)\ge0$ for $b\in(1-w_0,x_0)$. -/
theorem DJr_nonneg {b : ℝ} (hb : b ∈ Ioo (1 - w₀) x₀) : 0 ≤ DJr b := by
  have hx₀ := x₀_mem_Ioo
  rw [DJr_eq]
  have hu := affine_mem_Ioo w₀_pos (x := b) ⟨hb.1, by linarith [hb.2, hx₀.2]⟩
  have : 2⁻¹ < w₀⁻¹ * (1 - b) := by
    rw [← div_eq_inv_mul, lt_div_iff₀ w₀_pos]
    have := hb.2; rw [x₀] at this; linarith
  have := gInv_pos ⟨this, hu.2⟩
  positivity

/-! ### (6.26): the tight lower bound of $-\beta\partial_xg_{QJ,\beta,c}$ -/

/-- The tight lower bound of $-\beta\partial_xg_{QJ,\beta,c}$ ([DIR], §6.6.1), with
$\underline m=\frac{\underline x+\underline y}2$, $\overline m=\frac{\overline x+\overline y}2$,
$r=\frac1\beta-1$:
$$(\underline y-\overline x)^r+c^{\frac1\beta}(2\underline J-Q_\beta(\overline x))_+^r
J'(\overline m)\mathbf 1_{\overline m<x_0}
-c^{\frac1\beta}(2\overline J-Q_\beta(\underline x))^r\,\overline{|J'|}\,
\mathbf 1_{\text{not }\overline m<x_0}
-c^{\frac1\beta}(2\overline J-Q_\beta(\underline x))^rQ'_\beta(\underline x),$$
with $\underline J=\min(J(\underline m),J(\overline m))$,
$\overline J=\overline J(\underline m,\overline m)$,
$\overline{|J'|}=\max(|J'(\underline m)|,|J'(\overline m)|)$ ($J=J_{w_0}$). -/
noncomputable def g_QJ_1_lo (β c xl xu yl yu : ℝ) : ℝ :=
  (yl - xu) ^ (β⁻¹ - 1) +
    (if (xu + yu) / 2 < x₀ then
      c ^ β⁻¹ * (max (2 * min (gJw w₀ ((xl + yl) / 2)) (gJw w₀ ((xu + yu) / 2)) - Q β xu) 0) ^
        (β⁻¹ - 1) * DJr ((xu + yu) / 2)
    else -(c ^ β⁻¹ * (2 * Jbar ((xl + yl) / 2) ((xu + yu) / 2) - Q β xl) ^ (β⁻¹ - 1) *
      max (abs (DJr ((xl + yl) / 2))) (abs (DJr ((xu + yu) / 2))))) -
    c ^ β⁻¹ * (2 * Jbar ((xl + yl) / 2) ((xu + yu) / 2) - Q β xl) ^ (β⁻¹ - 1) * Q1f β xl

/-- [DIR], §6.6.1: $\underline{g_{QJ,1,\beta,c}}$ is a lower bound of
$-\beta\partial_xg_{QJ,\beta,c}(x,y)=(y-x)^{\frac1\beta-1}+c^{\frac1\beta}
(2J_{w_0}(\frac{x+y}2)-Q_\beta(x))^{\frac1\beta-1}(J_{w_0}'(\frac{x+y}2)-Q_\beta'(x))$ on
subrectangles of $[\frac14,\frac12]\times[\frac12,\frac58]$ (for
$\beta\in[\frac12,\frac12+\frac{31}{1024}]$, $c\ge0$). -/
theorem g_QJ_1_lo_le (β c : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) (hc : 0 ≤ c)
    {xl xu yl yu x y : ℝ} (hxl : 4⁻¹ ≤ xl) (hxu : xu ≤ 2⁻¹) (hyl : 2⁻¹ ≤ yl) (hyu : yu ≤ 5 / 8)
    (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    g_QJ_1_lo β c xl xu yl yu ≤ (y - x) ^ (β⁻¹ - 1) + c ^ β⁻¹ *
      (2 * gJw w₀ ((x + y) / 2) - Q β x) ^ (β⁻¹ - 1) * (DJr ((x + y) / 2) - Q1f β x) := by
  have hx1 := hx.1; have hx2 := hx.2; have hy1 := hy.1; have hy2 := hy.2
  have hw := w₀_mem.1
  have hβ0 : 0 < β := by linarith [hβ.1]
  have hr : 0 < β⁻¹ - 1 := by
    have : β < 1 := by linarith [hβ.2]
    have := (one_lt_inv₀ hβ0).2 this; linarith
  set r := β⁻¹ - 1
  set C := c ^ β⁻¹ with hCdef
  have hC : 0 ≤ C := rpow_nonneg hc _
  set m := (x + y) / 2 with hm
  set ml := (xl + yl) / 2 with hml
  set mu := (xu + yu) / 2 with hmu
  have hD : 0 < 2 * gJw w₀ m - Q β x :=
    two_Jw_sub_Q_pos_rect x y ⟨by linarith, by linarith⟩ ⟨by linarith, by linarith⟩ β
      ⟨hβ0.le, by linarith [hβ.2]⟩
  -- the bound $\overline D$ of $D=2J_{w_0}(m)-Q_\beta(x)$
  have hDbar : 2 * gJw w₀ m - Q β x ≤ 2 * Jbar ml mu - Q β xl := by
    have h1 := gJw_le_Jbar (a := ml) (m := m) (b := mu) (by linarith) (by linarith)
      (by linarith) (by linarith)
    have h2 := Q_mono β hβ (a := xl) (b := x) (by linarith) hx1 (by linarith)
    linarith
  have hDr : (2 * gJw w₀ m - Q β x) ^ r ≤ (2 * Jbar ml mu - Q β xl) ^ r :=
    rpow_le_rpow hD.le hDbar hr.le
  have hDr0 : 0 ≤ (2 * gJw w₀ m - Q β x) ^ r := rpow_nonneg hD.le _
  -- the first term
  have h1 : (yl - xu) ^ r ≤ (y - x) ^ r := rpow_le_rpow (by linarith) (by linarith) hr.le
  -- the third term
  have hQ1 : Q1f β x ≤ Q1f β xl := Q1f_anti β hβ (by linarith) hx1
  have hQ1x : 0 < Q1f β x := Q1f_pos β hβ ⟨by linarith, by linarith⟩
  have h3 : C * (2 * gJw w₀ m - Q β x) ^ r * Q1f β x ≤
      C * (2 * Jbar ml mu - Q β xl) ^ r * Q1f β xl := by
    have := mul_le_mul hDr hQ1 hQ1x.le (hDr0.trans hDr)
    have := mul_le_mul_of_nonneg_left this hC
    simpa only [mul_assoc] using this
  -- the middle term
  have hmI : 1 - w₀ < ml := by linarith
  have h2 : (if mu < x₀ then
      C * (max (2 * min (gJw w₀ ml) (gJw w₀ mu) - Q β xu) 0) ^ r * DJr mu
    else -(C * (2 * Jbar ml mu - Q β xl) ^ r * max (|DJr ml|) (|DJr mu|))) ≤
      C * (2 * gJw w₀ m - Q β x) ^ r * DJr m := by
    split_ifs with hmu
    · have hDl : max (2 * min (gJw w₀ ml) (gJw w₀ mu) - Q β xu) 0 ≤ 2 * gJw w₀ m - Q β x := by
        have h1 := min_gJw_le (a := ml) (m := m) (b := mu) (by linarith) (by linarith)
          (by linarith) (by linarith)
        have h2 := Q_mono β hβ (a := x) (b := xu) (by linarith) hx2 hxu
        exact max_le (by linarith) hD.le
      have hDlr := rpow_le_rpow (le_max_right _ _) hDl hr.le
      have hJ' : DJr mu ≤ DJr m := DJr_antitoneOn_QJ ⟨by linarith, by linarith⟩
        ⟨by linarith, by linarith⟩ (by linarith)
      have hJ0 : 0 ≤ DJr mu := DJr_nonneg ⟨by linarith, hmu⟩
      have := mul_le_mul hDlr hJ' hJ0 hDr0
      have := mul_le_mul_of_nonneg_left this hC
      simpa only [mul_assoc] using this
    · have hM := abs_DJr_le (a := ml) (m := m) (b := mu) hmI (by linarith) (by linarith)
        (by linarith)
      have hM0 : 0 ≤ max (|DJr ml|) (|DJr mu|) := (abs_nonneg _).trans (le_max_left _ _)
      have ha := neg_abs_le (DJr m)
      have e1 : (2 * gJw w₀ m - Q β x) ^ r * (-max (|DJr ml|) (|DJr mu|)) ≤
          (2 * gJw w₀ m - Q β x) ^ r * DJr m :=
        mul_le_mul_of_nonneg_left (by linarith) hDr0
      have e2 : (2 * Jbar ml mu - Q β xl) ^ r * max (|DJr ml|) (|DJr mu|) ≥
          (2 * gJw w₀ m - Q β x) ^ r * max (|DJr ml|) (|DJr mu|) :=
        mul_le_mul_of_nonneg_right hDr hM0
      have := mul_le_mul_of_nonneg_left (show
        -((2 * Jbar ml mu - Q β xl) ^ r * max (|DJr ml|) (|DJr mu|)) ≤
          (2 * gJw w₀ m - Q β x) ^ r * DJr m by linarith) hC
      linarith [this]
  unfold g_QJ_1_lo
  have e : C * (2 * gJw w₀ m - Q β x) ^ r * (DJr m - Q1f β x) =
      C * (2 * gJw w₀ m - Q β x) ^ r * DJr m - C * (2 * gJw w₀ m - Q β x) ^ r * Q1f β x := by
    ring
  rw [e]
  linarith

/-! ### Cases of the enclosure $\overline J$ decided by a rational enclosure of $x_0$ -/

/-- Lower end of the rational enclosure of $x_0$. -/
def x₀L : ℚ := 0.5521153369715

/-- Upper end of the rational enclosure of $x_0$. -/
def x₀U : ℚ := 0.552115336976

/-- The Boolean check that case `k` of the enclosure $\overline J(a,b)$ applies, by the rational
enclosure $[x_{0,L},x_{0,U}]\ni x_0$: `0`: $b<x_0$; `1`: $x_0<a$ and $x_0<b$; otherwise
$a\le x_0\le b$. -/
def caseOK (k : ℕ) (a b : ℚ) : Bool :=
  match k with
  | 0 => decide (b < x₀L)
  | 1 => decide (x₀U < a ∧ x₀U < b)
  | _ => decide (x₀U ≤ b ∧ a ≤ x₀L)

/-- The value of $\overline J(a,b)$ in case `k` (the environment entries `ia`, `ib`, `ix` are
$J_{w_0}(a)$, $J_{w_0}(b)$, $J_{w_0}(x_0)$). -/
def jbarEx (k ia ib ix : ℕ) : Ex :=
  match k with
  | 0 => .var ib
  | 1 => .var ia
  | _ => .var ix

/-- The meaning of `caseOK`: the comparison $b<x_0$ and the value of $\overline J(a,b)$. -/
theorem caseOK_sound {k : ℕ} {a b : ℚ} (h : caseOK k a b = true) (ρ : ℕ → ℝ) (ia ib ix : ℕ)
    (ha : ρ ia = gJw w₀ a) (hb : ρ ib = gJw w₀ b) (hx : ρ ix = gJw w₀ x₀) :
    ((b : ℝ) < x₀ ↔ k = 0) ∧ denote ρ (jbarEx k ia ib ix) = Jbar a b := by
  have h0 := x₀_mem_11
  rcases k with _ | _ | k
  · simp only [caseOK, decide_eq_true_eq] at h
    have h' : (b : ℝ) < (x₀L : ℝ) := by exact_mod_cast h
    have hb' : (b : ℝ) < x₀ := by norm_num [x₀L] at h'; linarith [h0.1]
    simp [jbarEx, denote, Jbar, hb', hb]
  · simp only [caseOK, decide_eq_true_eq] at h
    have h1 : (x₀U : ℝ) < a := by exact_mod_cast h.1
    have h2 : (x₀U : ℝ) < b := by exact_mod_cast h.2
    norm_num [x₀U] at h1 h2
    have ha' : x₀ < (a : ℝ) := by linarith [h0.2]
    have hb' : ¬ (b : ℝ) < x₀ := by linarith [h0.2]
    simp [jbarEx, denote, Jbar, hb', ha', ha]
  · simp only [caseOK, decide_eq_true_eq] at h
    have h1 : (x₀U : ℝ) ≤ b := by exact_mod_cast h.1
    have h2 : (a : ℝ) ≤ x₀L := by exact_mod_cast h.2
    norm_num [x₀U, x₀L] at h1 h2
    have ha' : ¬ x₀ < (a : ℝ) := by linarith [h0.1]
    have hb' : ¬ (b : ℝ) < x₀ := by linarith [h0.2]
    simp [jbarEx, denote, Jbar, hb', ha', hx]

/-! ### (6.26): the box certificate -/

/-- $X^r$ in the checker (the node `rpow`, omitted for $r=1$). -/
def rp (r : ℚ) (e : Ex) : Ex := if r = 1 then e else .rpow e r

/-- The real meaning of `rp`. -/
theorem denote_rp (ρ : ℕ → ℝ) (r : ℚ) (e : Ex) : denote ρ (rp r e) = denote ρ e ^ (r : ℝ) := by
  unfold rp
  split_ifs with h
  · subst h; simp
  · rfl

/-- $a^r$ for a rational $a\ge0$ ($0$ if $a=0$). -/
def powEx (r a : ℚ) : Ex := if a = 0 then .const 0 else rp r (.const a)

/-- The real meaning of `powEx` ($r\ne0$). -/
theorem denote_powEx (ρ : ℕ → ℝ) {r : ℚ} (hr : r ≠ 0) (a : ℚ) :
    denote ρ (powEx r a) = (a : ℝ) ^ (r : ℝ) := by
  unfold powEx
  split_ifs with h
  · subst h; simp [denote, Real.zero_rpow (show (r : ℝ) ≠ 0 by exact_mod_cast hr)]
  · rw [denote_rp]; rfl

/-- $2\overline J-Q_\beta(\underline x)$ in case `k` (environment of (6.26)). -/
def dbarEx (k : ℕ) (xl : ℚ) : Ex := .sub (.mul (.const 2) (jbarEx k 0 1 2)) (qEx_QJ 5 xl)

/-- The expression of the checker for $\underline{g_{QJ,1,\beta,c}}$ on $[x_l,x_u]\times[y_l,y_u]$
in case `k`, with $r=\frac1\beta-1$, $C=c^{1/\beta}$; the variables `0`–`5` stand for
$J_{w_0}(\underline m)$, $J_{w_0}(\overline m)$, $J_{w_0}(x_0)$, $J_{w_0}'(\underline m)$,
$J_{w_0}'(\overline m)$, $2^\beta$. -/
def gQJ1Ex (k : ℕ) (r C xl xu yl _yu : ℚ) : Ex :=
  .sub (.add (powEx r (yl - xu))
      (if k = 0 then
        .mul (.mul (.const C) (rp r (.max (.sub (.mul (.const 2) (.min (.var 0) (.var 1)))
          (qEx_QJ 5 xu)) (.const 0)))) (.var 4)
      else
        .neg (.mul (.mul (.const C) (rp r (dbarEx k xl))) (.max (.abs (.var 3)) (.abs (.var 4))))))
    (.mul (.mul (.const C) (rp r (dbarEx k xl))) (q1Ex_QJ 5 xl))

/-- $\underline{g_{QJ,1,\beta,c}}-10^{-5}$ as a function of the corners of a rectangle in
$\mathbb R^2$ (the function $\underline f$ of [DIR], §4.1 for (6.26)). -/
noncomputable def gQJ1_fl (β c : ℝ) (zl zu : Fin 2 → ℝ) : ℝ :=
  g_QJ_1_lo β c (zl 0) (zu 0) (zl 1) (zu 1) - 1 / 10 ^ 5

/-- The Boolean box check for (6.26): the table entries are at the right points
$\underline m$, $\overline m$, case `k` of the enclosures applies, and the checker certifies
$\underline{g_{QJ,1,\beta,c}}>10^{-5}$. -/
def gQJ1Check (k : ℕ) (r C : ℚ) (t : PowVal) (p : Box) (a b : JwVal) (d e : DJwVal) : Bool :=
  a.x == (p.1 + p.2.2.1) / 2 && b.x == (p.2.1 + p.2.2.2) / 2 && d.x == (p.1 + p.2.2.1) / 2 &&
    e.x == (p.2.1 + p.2.2.2) / 2 &&
    caseOK k ((p.1 + p.2.2.1) / 2) ((p.2.1 + p.2.2.2) / 2) &&
    check P11 [(a.l, a.u), (b.l, b.u), (jx0L, jx0U), (d.l, d.u), (e.l, e.u), (t.l, t.u)]
      (gQJ1Ex k r C p.1 p.2.1 p.2.2.1 p.2.2.2) (1 / 10 ^ 5)

/-- **Box certificate for (6.26).** If `gQJ1Check` succeeds on the rectangle `p` (with
$r=\frac1\beta-1\ne0$, $C=c^{1/\beta}$ and an enclosure `t` of $2^\beta$), then
$\underline{g_{QJ,1,\beta,c}}>10^{-5}$ on `p`. -/
theorem gQJ1_box (β c : ℝ) (r C : ℚ) (hr : (r : ℝ) = β⁻¹ - 1) (hr0 : r ≠ 0)
    (hC : (C : ℝ) = c ^ β⁻¹) (t : PowVal) (ht : t.v = 2 ^ β) (k : ℕ) (p : Box) (a b : JwVal)
    (d e : DJwVal) (h : gQJ1Check k r C t p a b d e = true) :
    0 < gQJ1_fl β c (Box.toR p).1 (Box.toR p).2 := by
  obtain ⟨xl, xu, yl, yu⟩ := p
  simp only [gQJ1Check, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨⟨ha, hb⟩, hd⟩, he⟩, hk⟩, hc⟩ := h
  have hcs := check_sound P11 hw11 [a.cert, b.cert, jx0Cert, d.cert, e.cert, t.cert] _ _ hc
  set ρ := Cert.val [a.cert, b.cert, jx0Cert, d.cert, e.cert, t.cert]
  have h0 : ρ 0 = gJw w₀ (((xl + yl) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, JwVal.cert, ha]
  have h1 : ρ 1 = gJw w₀ (((xu + yu) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, JwVal.cert, hb]
  have h2 : ρ 2 = gJw w₀ x₀ := by simp [ρ, Cert.val, envOf, jx0Cert]
  have h3 : ρ 3 = DJr (((xl + yl) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, DJwVal.cert, hd]
  have h4 : ρ 4 = DJr (((xu + yu) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, DJwVal.cert, he]
  have h5 : ρ 5 = 2 ^ β := by
    rw [← ht]; simp [ρ, Cert.val, envOf, PowVal.cert, PowVal.v]
  obtain ⟨hcase, hJ⟩ := caseOK_sound hk ρ 0 1 2 h0 h1 h2
  have hpow := denote_powEx ρ hr0 (yl - xu)
  have hdb : denote ρ (dbarEx k xl) = 2 * Jbar (((xl + yl) / 2 : ℚ) : ℝ)
      (((xu + yu) / 2 : ℚ) : ℝ) - Q β xl := by
    simp only [dbarEx, denote, hJ, denote_qEx ρ 5 xl β h5]
    push_cast; ring
  have e1 : (((xu + yu) / 2 : ℚ) : ℝ) = ((xu : ℝ) + yu) / 2 := by push_cast; ring
  have e2 : (((xl + yl) / 2 : ℚ) : ℝ) = ((xl : ℝ) + yl) / 2 := by push_cast; ring
  have hval : denote ρ (gQJ1Ex k r C xl xu yl yu) = g_QJ_1_lo β c xl xu yl yu := by
    unfold g_QJ_1_lo
    by_cases hk0 : k = 0
    · have hm : (((xu + yu) / 2 : ℚ) : ℝ) < x₀ := hcase.2 hk0
      rw [e1] at hm
      subst hk0
      simp only [gQJ1Ex, hm, ↓reduceIte, denote, hpow, denote_rp, hdb,
        denote_qEx ρ 5 xu β h5, denote_q1Ex ρ 5 xl β h5, h0, h1, h4, hr, hC, e1, e2]
      push_cast; ring
    · have hm : ¬ (((xu + yu) / 2 : ℚ) : ℝ) < x₀ := fun h ↦ hk0 (hcase.1 h)
      rw [e1] at hm
      simp only [gQJ1Ex, hk0, hm, ↓reduceIte, denote, hpow, denote_rp, hdb,
        denote_q1Ex ρ 5 xl β h5, h3, h4, hr, hC, e1, e2]
      push_cast; ring
  simp only [gQJ1_fl, Box.toR, Matrix.cons_val_zero, Matrix.cons_val_one]
  rw [hval] at hcs
  push_cast at hcs ⊢
  linarith

/-- Certified enclosure of $2^{\beta_0}=2^{0.50057}$. -/
theorem tβ₀_h : checkMem P11 [] (.rpow (.const 2) (50057 / 100000)) 1.41477241990820091
    1.41477241990820292 = true := by
  decide +kernel

/-- Certified value $2^{\beta_0}$. -/
def tβ₀ : PowVal :=
  PowVal.mk' 2 (50057 / 100000) 1.41477241990820091 1.41477241990820292 tβ₀_h

/-- `tβ₀` is $2^{\beta_0}$. -/
theorem tβ₀_v : tβ₀.v = 2 ^ β₀ := by
  simp only [PowVal.v, tβ₀, PowVal.mk', β₀]; norm_num

/-- Box certificate for (6.26) with $(\beta,c)=(\beta_0,1)$ ($r=\frac{49943}{50057}$, $C=1$). -/
theorem gQJ1_box_b0 (k : ℕ) (p : Box) (a b : JwVal) (d e : DJwVal)
    (h : gQJ1Check k (49943 / 50057) 1 tβ₀ p a b d e = true) :
    0 < gQJ1_fl β₀ 1 (Box.toR p).1 (Box.toR p).2 :=
  gQJ1_box β₀ 1 _ _ (by norm_num [β₀]) (by norm_num) (by simp) tβ₀ tβ₀_v k p a b d e h

/-- Box certificate for (6.26) with $(\beta,c)=(\frac12,c_0)$ ($r=1$, $C=c_0^2=0.994009$). -/
theorem gQJ1_box_h (k : ℕ) (p : Box) (a b : JwVal) (d e : DJwVal)
    (h : gQJ1Check k 1 (994009 / 1000000) tHalf p a b d e = true) :
    0 < gQJ1_fl 2⁻¹ c₀ (Box.toR p).1 (Box.toR p).2 :=
  gQJ1_box 2⁻¹ c₀ _ _ (by norm_num) (by norm_num)
    (by rw [inv_inv, show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, rpow_natCast]; norm_num [c₀])
    tHalf tHalf_v k p a b d e h

/-- **Soundness of partitioning for (6.26)** ([DIR], §4.1, via `Auto.DIR.pos_of_dtree`): if
$\underline{g_{QJ,1,\beta,c}}>10^{-5}$ on every rectangle of a dyadic partition tree of
$[\frac14,\frac12]\times[\frac12,\frac58]$, then $-\beta\partial_xg_{QJ,\beta,c}>10^{-5}$ there. -/
theorem gQJ1_of_tree (β c : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) (hc : 0 ≤ c)
    (t : DTree) (ht : ∀ p ∈ t.boxes (1 / 4) (1 / 2) (1 / 2) (5 / 8),
      0 < gQJ1_fl β c (Box.toR p).1 (Box.toR p).2) :
    ∀ x ∈ Icc (4⁻¹ : ℝ) 2⁻¹, ∀ y ∈ Icc (2⁻¹ : ℝ) (5 / 8), 1 / 10 ^ 5 <
      (y - x) ^ (β⁻¹ - 1) + c ^ β⁻¹ * (2 * gJw w₀ ((x + y) / 2) - Q β x) ^ (β⁻¹ - 1) *
        (DJr ((x + y) / 2) - Q1f β x) := by
  intro x hx y hy
  have h := pos_of_dtree t (1 / 4) (1 / 2) (1 / 2) (5 / 8) (by norm_num) (by norm_num)
    (fun z ↦ (z 1 - z 0) ^ (β⁻¹ - 1) + c ^ β⁻¹ *
      (2 * gJw w₀ ((z 0 + z 1) / 2) - Q β (z 0)) ^ (β⁻¹ - 1) *
        (DJr ((z 0 + z 1) / 2) - Q1f β (z 0)) - 1 / 10 ^ 5)
    (gQJ1_fl β c) ?_ ht ![x, y] (mem_Icc_toR.2 ⟨by push_cast; norm_num at hx ⊢; exact hx,
      by push_cast; norm_num at hy ⊢; exact hy⟩)
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h
    linarith
  · intro zl zu hzl hzu z hz
    obtain ⟨⟨h1, h2⟩, h3, h4⟩ := le_toR_iff.1 ⟨hzl, hzu⟩
    push_cast at h1 h2 h3 h4
    have hz0 : z 0 ∈ Icc (zl 0) (zu 0) := ⟨hz.1 0, hz.2 0⟩
    have hz1 : z 1 ∈ Icc (zl 1) (zu 1) := ⟨hz.1 1, hz.2 1⟩
    have := g_QJ_1_lo_le β c hβ hc (by linarith) (by linarith) (by linarith) (by linarith) hz0 hz1
    simp only [gQJ1_fl]
    linarith

/-! ### (6.27): the tight lower bound of $g_{QJ,2}$ and the box certificate -/

/-- The tight lower bound of $g_{QJ,2}$ ([DIR], §6.6.2):
$$\underline{g_{QJ,2}}=((\underline y-\overline x)^2+J(\overline y)^2)^{1/2}
+Q_{\frac12}(\underline x)-2\overline J(\tfrac{\underline x+\underline y}2,
\tfrac{\overline x+\overline y}2)$$ ($\overline J$ for $J_{w_0}$). -/
noncomputable def g_QJ_2_lo (xl xu yl yu : ℝ) : ℝ :=
  ((yl - xu) ^ 2 + J yu ^ 2) ^ (2⁻¹ : ℝ) + Q 2⁻¹ xl - 2 * Jbar ((xl + yl) / 2) ((xu + yu) / 2)

/-- [DIR], §6.6.2: $\underline{g_{QJ,2}}$ is a lower bound of
$g_{QJ,2}(x,y)=((y-x)^2+J(y)^2)^{1/2}+Q_{\frac12}(x)-2J_{w_0}(\frac{x+y}2)$ on subrectangles of
$[\frac14,\frac12]\times[\frac58,1]$. -/
theorem g_QJ_2_lo_le {xl xu yl yu x y : ℝ} (hxl : 4⁻¹ ≤ xl) (hxu : xu ≤ 2⁻¹) (hyl : 5 / 8 ≤ yl)
    (hyu : yu ≤ 1) (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    g_QJ_2_lo xl xu yl yu ≤
      ((y - x) ^ 2 + J y ^ 2) ^ (2⁻¹ : ℝ) + Q 2⁻¹ x - 2 * gJw w₀ ((x + y) / 2) := by
  have hx1 := hx.1; have hx2 := hx.2; have hy1 := hy.1; have hy2 := hy.2
  have hx₀ := x₀_mem_11
  have hw := w₀_mem.1
  have hβ : (2⁻¹ : ℝ) ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024) := ⟨le_rfl, by norm_num⟩
  have hJ : J yu ≤ J y := J_antitoneOn_Icc_x₀_one ⟨by linarith [hx₀.2], by linarith⟩
    ⟨by linarith [hx₀.2], hyu⟩ hy2
  have hJ0 : 0 ≤ J yu := J_nonneg ⟨by linarith, hyu⟩
  have hS : (yl - xu) ^ 2 + J yu ^ 2 ≤ (y - x) ^ 2 + J y ^ 2 := by
    have : 0 ≤ yl - xu := by linarith
    nlinarith
  have h1 := rpow_le_rpow (by positivity) hS (by norm_num : (0 : ℝ) ≤ 2⁻¹)
  have h2 := Q_mono 2⁻¹ hβ (a := xl) (b := x) (by linarith) hx1 (by linarith)
  have h3 := gJw_le_Jbar (a := (xl + yl) / 2) (m := (x + y) / 2) (b := (xu + yu) / 2)
    (by linarith) (by linarith) (by linarith) (by linarith)
  unfold g_QJ_2_lo
  linarith

/-- The expression of the checker for $\underline{g_{QJ,2}}$ on $[x_l,x_u]\times[y_l,y_u]$ in
case `k`; the variables `0`–`4` stand for $J(\overline y)$, $J_{w_0}(\underline m)$,
$J_{w_0}(\overline m)$, $J_{w_0}(x_0)$, $2^{1/2}$. -/
def gQJ2Ex (k : ℕ) (xl xu yl _yu : ℚ) : Ex :=
  .sub (.add (.rpow (.add (.const ((yl - xu) ^ 2)) (.npow (.var 0) 2)) (1 / 2)) (qEx_QJ 4 xl))
    (.mul (.const 2) (jbarEx k 1 2 3))

/-- $\underline{g_{QJ,2}}-10^{-7}$ as a function of the corners of a rectangle in
$\mathbb R^2$ (the function $\underline f$ of [DIR], §4.1 for (6.27)). -/
noncomputable def gQJ2_fl (zl zu : Fin 2 → ℝ) : ℝ :=
  g_QJ_2_lo (zl 0) (zu 0) (zl 1) (zu 1) - 1 / 10 ^ 7

/-- The Boolean box check for (6.27): the table entries are at the right points $\overline y$,
$\underline m$, $\overline m$, case `k` of $\overline J$ applies, and the checker certifies
$\underline{g_{QJ,2}}>10^{-7}$. -/
def gQJ2Check (k : ℕ) (p : Box) (a : JVal) (b c : JwVal) : Bool :=
  a.x == p.2.2.2 && b.x == (p.1 + p.2.2.1) / 2 && c.x == (p.2.1 + p.2.2.2) / 2 &&
    caseOK k ((p.1 + p.2.2.1) / 2) ((p.2.1 + p.2.2.2) / 2) &&
    check P11 [(a.l, a.u), (b.l, b.u), (c.l, c.u), (jx0L, jx0U), (tHalf.l, tHalf.u)]
      (gQJ2Ex k p.1 p.2.1 p.2.2.1 p.2.2.2) (1 / 10 ^ 7)

/-- **Box certificate for (6.27).** If `gQJ2Check` succeeds on the rectangle `p`, then
$\underline{g_{QJ,2}}>10^{-7}$ on `p`. -/
theorem gQJ2_box (k : ℕ) (p : Box) (a : JVal) (b c : JwVal) (h : gQJ2Check k p a b c = true) :
    0 < gQJ2_fl (Box.toR p).1 (Box.toR p).2 := by
  obtain ⟨xl, xu, yl, yu⟩ := p
  simp only [gQJ2Check, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨ha, hb⟩, hc⟩, hk⟩, hch⟩ := h
  have hcs := check_sound P11 hw11 [a.cert, b.cert, c.cert, jx0Cert, tHalf.cert] _ _ hch
  set ρ := Cert.val [a.cert, b.cert, c.cert, jx0Cert, tHalf.cert]
  have h0 : ρ 0 = J yu := by simp [ρ, Cert.val, envOf, JVal.cert, ha]
  have h1 : ρ 1 = gJw w₀ (((xl + yl) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, JwVal.cert, hb]
  have h2 : ρ 2 = gJw w₀ (((xu + yu) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, JwVal.cert, hc]
