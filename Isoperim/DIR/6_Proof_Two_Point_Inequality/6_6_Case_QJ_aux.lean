/-!
# [DIR] §6.6 Case $QJ$: auxiliary lemmas

This file was automatically generated by Claude.

Auxiliary results for `6_6_Case_QJ.lean`:

* monotonicity of $\beta\mapsto(a^{1/\beta}+b^{1/\beta})^\beta$ (hence of $G^1_\beta[B](x,y)$ in
  $\beta$) and the comparison with the $\ell^2$ expression;
* the values of $b_\beta$ on $[\frac14,\frac12]$ and on $[\frac12,\infty)$;
* the lower bounds $J_{w_0}(m)\ge1-m$ on $[\frac12,1]$ and
  $J_{w_0}(m)\ge\frac{m-(1-w_0)}{2w_0-1}$ on $[1-w_0,\frac12]$ (concavity of $I$), and the upper
  bound $Q_\beta\le\frac56$ on $[0,\frac12]$;
* positivity of $2J_{w_0}(\frac{x+y}2)-Q_\beta(x)$ on $[\frac14,\frac12]\times[\frac12,\frac58]$;
* the $x$-derivative of $g_{QJ,\beta,c}$ (§6.6.1): the formula
  $-\beta\partial_xg_{QJ,\beta,c}=(y-x)^{\frac1\beta-1}+c^{\frac1\beta}
  (2J_{w_0}(\frac{x+y}2)-Q_\beta(x))^{\frac1\beta-1}(J_{w_0}'(\frac{x+y}2)-Q_\beta'(x))$
  and the resulting antitonicity of $x\mapsto g_{QJ,\beta,c}(x,y)$.

Here $g_{QJ,\beta,c}$ is written out explicitly (it is defined in the main file as `g_QJ`):
$(y-x)^{1/\beta}+c^{1/\beta}J(y)^{1/\beta}-c^{1/\beta}(2J_{w_0}(\frac{x+y}2)-Q_\beta(x))^{1/\beta}$.
-/

@[expose] public section

namespace Auto.DIR

open Real Set

/-- For $a,b\ge0$, $\beta\mapsto(a^{1/\beta}+b^{1/\beta})^\beta$ is increasing on $(0,\infty)$
(the $\ell^p$ norm is decreasing in $p$). -/
theorem rpow_inv_add_rpow_inv_monotoneOn {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    MonotoneOn (fun β : ℝ ↦ (a ^ β⁻¹ + b ^ β⁻¹) ^ β) (Ioi 0) := by
  intro β₁ h₁ β₂ h₂ h12
  have h := Real.rpow_add_rpow_le ha hb (inv_pos.2 h₂) (inv_anti₀ h₁ h12)
  simpa [one_div, inv_inv] using h

/-- $G^1_\beta[B](x,y)$ is increasing in $\beta\in(0,\infty)$ if $x\le y$ and $B(y)\ge0$ (only
the first summand depends on $\beta$). -/
theorem G₁_monotoneOn_beta_of_le (B : ℝ → ℝ) (x y : ℝ) (hxy : x ≤ y) (hB : 0 ≤ B y) :
    MonotoneOn (fun β ↦ G₁ β B x y) (Ioi 0) := by
  intro β₁ h₁ β₂ h₂ h12
  have := rpow_inv_add_rpow_inv_monotoneOn (sub_nonneg.2 hxy) hB h₁ h₂ h12
  simp only [G₁] at this ⊢
  linarith

/-- For $a,b\ge0$ and $\beta\ge\frac12$: $(a^2+b^2)^{1/2}\le(a^{1/\beta}+b^{1/\beta})^\beta$. -/
theorem sq_add_sq_rpow_half_le {a b β : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hβ : 2⁻¹ ≤ β) :
    (a ^ 2 + b ^ 2) ^ (2⁻¹ : ℝ) ≤ (a ^ β⁻¹ + b ^ β⁻¹) ^ β := by
  have hβ0 : 0 < β := lt_of_lt_of_le (by norm_num) hβ
  have hp : β⁻¹ ≤ 2 := by
    rw [inv_le_comm₀ hβ0 two_pos]; exact hβ
  have h := Real.rpow_add_rpow_le ha hb (inv_pos.2 hβ0) hp
  simp only [one_div, inv_inv] at h
  have e : ∀ z : ℝ, z ^ (2 : ℝ) = z ^ (2 : ℕ) := fun z ↦ by exact_mod_cast rpow_natCast z 2
  rwa [e a, e b] at h

/-- The value $Q_\beta(\frac12)=\frac12$. -/
theorem Q_half_QJ (β : ℝ) : Q β 2⁻¹ = 2⁻¹ := by
  rw [Q_eq_affine]; norm_num

/-- $b_\beta(x)=Q_\beta(x)$ for $x\in[\frac14,\frac12]$ (at $x=\frac14$:
$L_\beta(\frac14)=\frac14\cdot2^\beta=Q_\beta(\frac14)$). -/
theorem b_eq_Q_of_mem (β x : ℝ) (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) : b β x = Q β x := by
  unfold b
  rcases hx.1.lt_or_eq with h | h
  · simp [not_le.2 h, hx.2]
  · subst h
    simp only [le_refl, ↓reduceIte]
    rw [L, Q_eq_affine]
    have h4 : logb 2 ((4 : ℝ)⁻¹)⁻¹ = 2 := by
      rw [inv_inv, show (4 : ℝ) = 2 ^ (2 : ℝ) by norm_num, logb_rpow two_pos (by norm_num)]
    rw [h4]; norm_num

/-- $b_\beta(x)=J(x)$ for $x\ge\frac12$ (at $x=\frac12$: $Q_\beta(\frac12)=\frac12=J(\frac12)$). -/
theorem b_eq_J_of_le (β x : ℝ) (hx : 2⁻¹ ≤ x) : b β x = J x := by
  unfold b
  rcases hx.lt_or_eq with h | h
  · have h' : ¬ x ≤ 4⁻¹ := by linarith
    simp [h', not_le.2 h]
  · subst h
    have h' : ¬ (2⁻¹ : ℝ) ≤ 4⁻¹ := by norm_num
    simp only [h', le_refl, ↓reduceIte]
    rw [Q_half_QJ, (J_half_eq_L_half 0).1]

/-- $J_{w_0}(\frac12)=\frac12$. -/
theorem gJw_w₀_half : gJw w₀ 2⁻¹ = 2⁻¹ := by
  rw [← J_eq_gJw_w₀ ⟨le_rfl, by norm_num⟩]; exact (J_half_eq_L_half 0).1

/-- $J_{w_0}(m)\ge1-m$ for $m\in[\frac12,1]$: the chord bound from the concavity of $I$
($I(u)/u$ is decreasing). -/
theorem one_sub_le_gJw_w₀ {m : ℝ} (hm : m ∈ Icc (2⁻¹ : ℝ) 1) : 1 - m ≤ gJw w₀ m := by
  rcases hm.2.lt_or_eq with h1 | h1
  · rcases hm.1.lt_or_eq with h2 | h2
    · have hw := w₀_mem
      have hw0 := w₀_pos
      have hwi := inv_pos.2 hw0
      have hv : 0 < w₀⁻¹ * (1 - m) := mul_pos hwi (by linarith)
      have hvu : w₀⁻¹ * (1 - m) < w₀⁻¹ * (1 - 2⁻¹) :=
        mul_lt_mul_of_pos_left (by linarith) hwi
      have hu : w₀⁻¹ * (1 - 2⁻¹) ≤ 1 := by
        rw [inv_mul_le_iff₀ hw0]; linarith [hw.1]
      have h := gProf_div_lt hv hvu hu
      have hh := gJw_w₀_half
      unfold gJw at hh ⊢
      rw [div_lt_div_iff₀ (by linarith) hv] at h
      set P := gProf (w₀⁻¹ * (1 - 2⁻¹))
      set R := gProf (w₀⁻¹ * (1 - m))
      have key : P * (1 - m) < R * 2⁻¹ := by
        have e1 : w₀ * (P * (w₀⁻¹ * (1 - m))) = P * (1 - m) := by field_simp
        have e2 : w₀ * (R * (w₀⁻¹ * (1 - 2⁻¹))) = R * 2⁻¹ := by field_simp; ring
        rw [← e1, ← e2]; exact mul_lt_mul_of_pos_left h hw0
      have hs : 0 < √2 * w₀ := by positivity
      nlinarith [mul_lt_mul_of_pos_left key hs]
    · subst h2; rw [gJw_w₀_half]; norm_num
  · subst h1; rw [gJw_one]; norm_num

/-- $J(m)\ge1-m$ for $m\in[\frac12,1]$. -/
theorem one_sub_le_J {m : ℝ} (hm : m ∈ Icc (2⁻¹ : ℝ) 1) : 1 - m ≤ J m := by
  rw [J_eq_gJw_w₀ hm]; exact one_sub_le_gJw_w₀ hm

/-- $J_{w_0}(m)\ge\frac{m-(1-w_0)}{2w_0-1}$ for $m\in[1-w_0,\frac12]$: the chord bound between
$1-w_0$ (where $J_{w_0}=0$) and $\frac12$ (where $J_{w_0}=\frac12$), from the concavity of $I$. -/
theorem gJw_w₀_ge_chord {m : ℝ} (hm : m ∈ Icc (1 - w₀) 2⁻¹) :
    (m - (1 - w₀)) / (2 * w₀ - 1) ≤ gJw w₀ m := by
  have hw := w₀_mem
  have hw0 := w₀_pos
  have hwi := inv_pos.2 hw0
  have hd : 0 < 2 * w₀ - 1 := by linarith [hw.1]
  rcases hm.1.lt_or_eq with h1 | h1
  · rcases hm.2.lt_or_eq with h2 | h2
    · -- with $v'=1-w_0^{-1}(1-m)$ and $u'=1-w_0^{-1}/2$: $0<v'<u'\le1$
      have hv : 0 < 1 - w₀⁻¹ * (1 - m) := by
        rw [sub_pos, inv_mul_lt_iff₀ hw0]; linarith
      have hvu : 1 - w₀⁻¹ * (1 - m) < 1 - w₀⁻¹ * (1 - 2⁻¹) := by
        have := mul_lt_mul_of_pos_left (show 1 - 2⁻¹ < 1 - m by linarith) hwi
        linarith
      have hu : 1 - w₀⁻¹ * (1 - 2⁻¹) ≤ 1 := by
        have : 0 ≤ w₀⁻¹ * (1 - 2⁻¹) := by positivity
        linarith
      have h := gProf_div_lt hv hvu hu
      have hh := gJw_w₀_half
      unfold gJw at hh ⊢
      rw [gProf_one_sub, gProf_one_sub, div_lt_div_iff₀ (by linarith) hv] at h
      set P := gProf (w₀⁻¹ * (1 - 2⁻¹))
      set R := gProf (w₀⁻¹ * (1 - m))
      have e1 : 1 - w₀⁻¹ * (1 - m) = (m - (1 - w₀)) / w₀ := by field_simp; ring
      have e2 : 1 - w₀⁻¹ * (1 - 2⁻¹) = (2 * w₀ - 1) / (2 * w₀) := by field_simp; ring
      rw [e1, e2] at h
      have key : P * (m - (1 - w₀)) * 2 < R * (2 * w₀ - 1) := by
        have h' : P * ((m - (1 - w₀)) / w₀) * (2 * w₀) <
            R * ((2 * w₀ - 1) / (2 * w₀)) * (2 * w₀) :=
          mul_lt_mul_of_pos_right h (by positivity)
        have e3 : P * ((m - (1 - w₀)) / w₀) * (2 * w₀) = P * (m - (1 - w₀)) * 2 := by
          field_simp
        have e4 : R * ((2 * w₀ - 1) / (2 * w₀)) * (2 * w₀) = R * (2 * w₀ - 1) := by
          field_simp
        rwa [e3, e4] at h'
      rw [div_le_iff₀ hd]
      have hs : 0 < √2 * w₀ := by positivity
      nlinarith [mul_lt_mul_of_pos_left key hs]
    · subst h2
      rw [gJw_w₀_half, div_le_iff₀ hd]; linarith
  · subst h1
    rw [sub_self, zero_div]
    unfold gJw
    have := gProf_nonneg (w₀⁻¹ * (1 - (1 - w₀)))
    positivity

/-- $Q_\beta(x)\le\frac56$ for $x\in[0,\frac12]$ and $\beta\in[0,1]$. -/
theorem Q_le_five_sixths (β : ℝ) (hβ : β ∈ Icc (0 : ℝ) 1) (x : ℝ) (hx : x ∈ Icc (0 : ℝ) 2⁻¹) :
    Q β x ≤ 5 / 6 := by
  have ht : (2 : ℝ) ^ β ≤ 2 := by
    simpa using rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2) hβ.2
  rw [Q_eq_affine]
  have hc : 0 ≤ 2 / 3 * x * (1 - x) * (4 - 8 * x) := by
    have := hx.1; have := hx.2
    have : 0 ≤ 1 - x := by linarith
    have : 0 ≤ 4 - 8 * x := by linarith
    positivity
  have := mul_le_mul_of_nonneg_left ht hc
  have h1 := hx.1; have h2 := hx.2
  nlinarith [mul_nonneg h1 (show 0 ≤ 2⁻¹ - x by linarith),
    mul_nonneg (mul_nonneg h1 h1) (show 0 ≤ 2⁻¹ - x by linarith)]

/-- $Q_{1/2}(x)\le Q_\beta(x)$ for $x\in[0,\frac12]$ and $\beta\ge\frac12$ ($Q_\beta(x)$ is
increasing in $\beta$ there). -/
theorem Q_half_le_Q (β : ℝ) (hβ : 2⁻¹ ≤ β) (x : ℝ) (hx : x ∈ Icc (0 : ℝ) 2⁻¹) :
    Q 2⁻¹ x ≤ Q β x := by
  have ht : (2 : ℝ) ^ (2⁻¹ : ℝ) ≤ 2 ^ β := rpow_le_rpow_of_exponent_le (by norm_num) hβ
  rw [Q_eq_affine, Q_eq_affine]
  have hc : 0 ≤ 2 / 3 * x * (1 - x) * (4 - 8 * x) := by
    have := hx.1; have := hx.2
    have : 0 ≤ 1 - x := by linarith
    have : 0 ≤ 4 - 8 * x := by linarith
    positivity
  have := mul_le_mul_of_nonneg_left ht hc
  linarith

/-- For $\beta>0$, $S,K\ge0$: $S^\beta-K\ge0\iff S-K^{1/\beta}\ge0$. -/
theorem rpow_sub_nonneg_iff {β S K : ℝ} (hβ : 0 < β) (hS : 0 ≤ S) (hK : 0 ≤ K) :
    S ^ β - K ≥ 0 ↔ S - K ^ β⁻¹ ≥ 0 := by
  rw [ge_iff_le, sub_nonneg, ge_iff_le, sub_nonneg,
    ← rpow_le_rpow_iff hK (rpow_nonneg hS β) (inv_pos.2 hβ), rpow_rpow_inv hS hβ.ne']

/-- $2J(\frac{x+y}2)-Q_\beta(x)\ge\frac1{24}>0$ for $x\in[0,\frac12]$, $y\le\frac58$,
$x+y\ge1$ and $\beta\in[0,1]$ (using $J(m)\ge1-m$ and $Q_\beta\le\frac56$). -/
theorem two_J_sub_Q_pos_aux (x y : ℝ) (hx : x ∈ Icc (0 : ℝ) 2⁻¹) (hy : y ≤ 5 / 8)
    (hxy : 1 ≤ x + y) (β : ℝ) (hβ : β ∈ Icc (0 : ℝ) 1) :
    2 * J ((x + y) / 2) - Q β x ≥ 24⁻¹ := by
  have hJ := one_sub_le_J (m := (x + y) / 2) ⟨by linarith, by linarith [hx.2]⟩
  have hQ := Q_le_five_sixths β hβ x hx
  linarith [hx.2]

/-- $2J_{w_0}(\frac{x+y}2)-Q_\beta(x)>0$ on the rectangle $[\frac14,\frac12]\times[\frac12,\frac58]$
for $\beta\in[0,1]$. (For $\frac{x+y}2\ge\frac12$ use $J_{w_0}(m)\ge1-m$; for $\frac{x+y}2<\frac12$
use the chord bound $J_{w_0}(m)\ge\frac{m-(1-w_0)}{2w_0-1}$, with $w_0\in[0.895,0.896]$, and
$Q_\beta(x)\le\frac23$ for $x\in[\frac14,\frac12]$.) -/
theorem two_Jw_sub_Q_pos_rect (x y : ℝ) (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹)
    (hy : y ∈ Icc (2⁻¹ : ℝ) (5 / 8)) (β : ℝ) (hβ : β ∈ Icc (0 : ℝ) 1) :
    0 < 2 * Jw w₀ ((x + y) / 2) - Q β x := by
  have hJw : Jw w₀ = gJw w₀ := rfl
  rw [hJw]
  rcases le_or_gt 2⁻¹ ((x + y) / 2) with hm | hm
  · have hJ := one_sub_le_gJw_w₀ (m := (x + y) / 2) ⟨hm, by linarith [hx.2, hy.2]⟩
    have hQ := Q_le_five_sixths β hβ x ⟨by linarith [hx.1], hx.2⟩
    linarith [hx.2, hy.2]
  · have hw := w₀_mem
    have hd : 0 < 2 * w₀ - 1 := by linarith [hw.1]
    have hJ := gJw_w₀_ge_chord (m := (x + y) / 2) ⟨by linarith [hx.1, hy.1, hw.1], hm.le⟩
    rw [div_le_iff₀ hd] at hJ
    -- $Q_\beta(x)\le\frac23$ on $[\frac14,\frac12]$
    have ht : (2 : ℝ) ^ β ≤ 2 := by
      simpa using rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2) hβ.2
    have hQ : Q β x ≤ 2 / 3 := by
      rw [Q_eq_affine]
      have h1 := hx.1; have h2 := hx.2
      have hc : 0 ≤ 2 / 3 * x * (1 - x) * (4 - 8 * x) := by
        have : 0 ≤ x := by linarith
        have : 0 ≤ 1 - x := by linarith
        have : 0 ≤ 4 - 8 * x := by linarith
        positivity
      have := mul_le_mul_of_nonneg_left ht hc
      nlinarith [mul_nonneg (show 0 ≤ x - 4⁻¹ by linarith) (show 0 ≤ 2⁻¹ - x by linarith),
        mul_nonneg (mul_nonneg (show 0 ≤ x - 4⁻¹ by linarith) (show 0 ≤ 2⁻¹ - x by linarith))
          (show 0 ≤ x by linarith)]
    -- $2J_{w_0}(m)(2w_0-1)\ge2(m-1+w_0)>\frac23(2w_0-1)$
    have hJpos : 0 ≤ gJw w₀ ((x + y) / 2) := by
      unfold gJw; have := gProf_nonneg (w₀⁻¹ * (1 - (x + y) / 2)); have := w₀_pos; positivity
    nlinarith [hw.1, hw.2, hx.1, hy.1, mul_nonneg hJpos (sub_nonneg.2 hw.2)]

/-- The derivative of $x\mapsto g_{QJ,\beta,c}(x,y)$, written out explicitly ([DIR], §6.6.1): for
$0<\beta\le1$ (so $\frac1\beta\ge1$; $y-x$ may be $0$ or negative), $\frac{x+y}2\in(1-w_0,1)$ (where
$J_{w_0}$ is smooth) and $2J_{w_0}(\frac{x+y}2)-Q_\beta(x)>0$,
$$\partial_x\Big[(y-x)^{\frac1\beta}+c^{\frac1\beta}J(y)^{\frac1\beta}
-c^{\frac1\beta}(2J_{w_0}(\tfrac{x+y}2)-Q_\beta(x))^{\frac1\beta}\Big]
=-\tfrac1\beta\Big[(y-x)^{\frac1\beta-1}
+c^{\frac1\beta}(2J_{w_0}(\tfrac{x+y}2)-Q_\beta(x))^{\frac1\beta-1}(J_{w_0}'(\tfrac{x+y}2)-Q_\beta'(x))\Big].$$ -/
theorem hasDerivAt_g_QJ_expr (β c x y : ℝ) (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hm : (x + y) / 2 ∈ Ioo (1 - w₀) 1) (hD : 0 < 2 * Jw w₀ ((x + y) / 2) - Q β x) :
    HasDerivAt (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹)
      (-β⁻¹ * ((y - x) ^ (β⁻¹ - 1) + c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ (β⁻¹ - 1) *
        (deriv (Jw w₀) ((x + y) / 2) - deriv (Q β) x))) x := by
  have hp : 1 ≤ β⁻¹ := (one_le_inv₀ hβ).2 hβ1
  have h1 : HasDerivAt (fun x ↦ (y - x) ^ β⁻¹) (-1 * β⁻¹ * (y - x) ^ (β⁻¹ - 1)) x :=
    ((hasDerivAt_id x).const_sub y).rpow_const (Or.inr hp)
  have hm' : HasDerivAt (fun x : ℝ ↦ (x + y) / 2) (1 / 2) x := by
    simpa using ((hasDerivAt_id x).add_const y).div_const 2
  have hJ : HasDerivAt (Jw w₀) (deriv (Jw w₀) ((x + y) / 2)) ((x + y) / 2) :=
    (hasDerivAt_gJw w₀_pos hm).differentiableAt.hasDerivAt
  have hDd := ((hJ.comp x hm').const_mul 2).sub (hasDerivAt_Q β x)
  have h2 := hDd.rpow_const (p := β⁻¹) (Or.inl hD.ne')
  have h := (h1.add_const (c ^ β⁻¹ * J y ^ β⁻¹)).sub (h2.const_mul (c ^ β⁻¹))
  have h' := h.congr_of_eventuallyEq (f₁ := fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
      c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹)
    (Filter.Eventually.of_forall fun z ↦ by simp [Function.comp])
  refine h'.congr_deriv ?_
  rw [deriv_Q_eq]
  simp only [Pi.sub_apply, Function.comp]
  ring

/-- With the hypotheses of `Auto.DIR.hasDerivAt_g_QJ_expr`:
$$-\beta\,\partial_x\Big[\dots\Big]=(y-x)^{\frac1\beta-1}+c^{\frac1\beta}
(2J_{w_0}(\tfrac{x+y}2)-Q_\beta(x))^{\frac1\beta-1}(J_{w_0}'(\tfrac{x+y}2)-Q_\beta'(x)).$$ -/
theorem neg_mul_deriv_g_QJ_expr (β c x y : ℝ) (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hm : (x + y) / 2 ∈ Ioo (1 - w₀) 1) (hD : 0 < 2 * Jw w₀ ((x + y) / 2) - Q β x) :
    -β * deriv (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) x =
      (y - x) ^ (β⁻¹ - 1) + c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ (β⁻¹ - 1) *
        (deriv (Jw w₀) ((x + y) / 2) - deriv (Q β) x) := by
  rw [(hasDerivAt_g_QJ_expr β c x y hβ hβ1 hm hD).deriv, ← mul_assoc, neg_mul_neg,
    mul_inv_cancel₀ hβ.ne', one_mul]

/-- If $x\mapsto g(x)=(y-x)^{1/\beta}+c^{1/\beta}J(y)^{1/\beta}-c^{1/\beta}(2J_{w_0}(\frac{x+y}2)
-Q_\beta(x))^{1/\beta}$ has the derivative of `Auto.DIR.hasDerivAt_g_QJ_expr` on $[a,b]$ (i.e.
$\frac{x+y}2\in(1-w_0,1)$ and $2J_{w_0}(\frac{x+y}2)-Q_\beta(x)>0$ there) and $\partial_xg\le0$ on
$[a,b]$, then $g$ is antitone on $[a,b]$. -/
theorem antitoneOn_g_QJ_expr {β c y a b : ℝ} (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hm : ∀ x ∈ Icc a b, (x + y) / 2 ∈ Ioo (1 - w₀) 1)
    (hD : ∀ x ∈ Icc a b, 0 < 2 * Jw w₀ ((x + y) / 2) - Q β x)
    (h : ∀ x ∈ Icc a b, deriv (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) x ≤ 0) :
    AntitoneOn (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) (Icc a b) := by
  have hd := fun x (hx : x ∈ Icc a b) ↦ hasDerivAt_g_QJ_expr β c x y hβ hβ1 (hm x hx) (hD x hx)
  apply antitoneOn_of_deriv_nonpos (convex_Icc a b)
  · exact fun x hx ↦ (hd x hx).continuousAt.continuousWithinAt
  · intro x hx
    rw [interior_Icc] at hx
    exact (hd x (Ioo_subset_Icc_self hx)).differentiableAt.differentiableWithinAt
  · intro x hx
    rw [interior_Icc] at hx
    exact h x (Ioo_subset_Icc_self hx)

/-- On the rectangle $[\frac14,\frac12]\times[\frac12,\frac58]$ of (6.26), for $\beta\in(0,1]$ the
hypotheses of `Auto.DIR.hasDerivAt_g_QJ_expr` hold, so
$$-\beta\,\partial_xg_{QJ,\beta,c}(x,y)=(y-x)^{\frac1\beta-1}+c^{\frac1\beta}
(2J_{w_0}(\tfrac{x+y}2)-Q_\beta(x))^{\frac1\beta-1}(J_{w_0}'(\tfrac{x+y}2)-Q_\beta'(x))$$
(with $g_{QJ,\beta,c}$ written out), and $x\mapsto g_{QJ,\beta,c}(x,y)$ is differentiable at $x$. -/
theorem neg_mul_deriv_g_QJ_expr_rect (β c x y : ℝ) (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) (hy : y ∈ Icc (2⁻¹ : ℝ) (5 / 8)) :
    DifferentiableAt ℝ (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) x ∧
    -β * deriv (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) x =
      (y - x) ^ (β⁻¹ - 1) + c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ (β⁻¹ - 1) *
        (deriv (Jw w₀) ((x + y) / 2) - deriv (Q β) x) := by
  have hm : (x + y) / 2 ∈ Ioo (1 - w₀) 1 := by
    have := w₀_mem.1
    constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]
  have hD := two_Jw_sub_Q_pos_rect x y hx hy β ⟨hβ.le, hβ1⟩
  exact ⟨(hasDerivAt_g_QJ_expr β c x y hβ hβ1 hm hD).differentiableAt,
    neg_mul_deriv_g_QJ_expr β c x y hβ hβ1 hm hD⟩

/-- On triangle I of §6.6.1 (for fixed $y\in[\frac12,\frac58]$, the $x$-range is
$[\max(\frac38,1-y),\frac12]$), for $\beta\in(0,1]$: if $\partial_xg_{QJ,\beta,c}(x,y)\le0$ there,
then $x\mapsto g_{QJ,\beta,c}(x,y)$ (written out) is antitone there. -/
theorem antitoneOn_g_QJ_expr_triangle {β c y : ℝ} (hβ : 0 < β) (hβ1 : β ≤ 1)
    (hy : y ∈ Icc (2⁻¹ : ℝ) (5 / 8))
    (h : ∀ x ∈ Icc (max (3 / 8) (1 - y)) 2⁻¹,
      deriv (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) x ≤ 0) :
    AntitoneOn (fun x ↦ (y - x) ^ β⁻¹ + c ^ β⁻¹ * J y ^ β⁻¹ -
        c ^ β⁻¹ * (2 * Jw w₀ ((x + y) / 2) - Q β x) ^ β⁻¹) (Icc (max (3 / 8) (1 - y)) 2⁻¹) := by
  have hx' : ∀ x ∈ Icc (max (3 / 8) (1 - y)) 2⁻¹, x ∈ Icc (4⁻¹ : ℝ) 2⁻¹ :=
    fun x hx ↦ ⟨by linarith [le_max_left (3 / 8 : ℝ) (1 - y), hx.1], hx.2⟩
  refine antitoneOn_g_QJ_expr hβ hβ1 (fun x hx ↦ ?_) (fun x hx ↦ ?_) h
  · have hw := w₀_mem.1
    have := hx' x hx
    constructor <;> linarith [this.1, this.2, hy.1, hy.2]
  · exact two_Jw_sub_Q_pos_rect x y (hx' x hx) hy β ⟨hβ.le, hβ1⟩

end Auto.DIR
