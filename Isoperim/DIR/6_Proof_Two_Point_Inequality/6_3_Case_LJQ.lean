/-- [DIR], §6.3.2, claim (3): $G_{LJQ,\beta}(1-y,y)\ge0$ for all $y\in[\frac34,1]$ (and
$\beta\in[\frac12,1]$). -/
theorem caseLJQ_claim_3 (β : ℝ) (hβ : β ∈ Icc (1 / 2 : ℝ) 1) (y : ℝ)
    (hy : y ∈ Icc (3 / 4 : ℝ) 1) : G_LJQ β (1 - y) y ≥ 0 := by
