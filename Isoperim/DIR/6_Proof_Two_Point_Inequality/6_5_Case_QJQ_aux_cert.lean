/-! ### Facts on $Q_\beta$ -/

/-- $Q_\beta'$ is decreasing on $[0,\infty)$ (for $\beta\in[\frac12,\frac12+\frac{31}{1024}]$). -/
theorem Q1f_anti (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) {a b : ℝ} (ha : 0 ≤ a)
    (hab : a ≤ b) : Q1f β b ≤ Q1f β a := by
  obtain ⟨h1, h2⟩ := two_rpow_bounds β hβ
  have e : Q1f β a - Q1f β b =
      (a - b) * (20 - 16 * 2 ^ β + (a + b) * (16 * 2 ^ β - 24)) := by
    rw [Q1f_eq_affine, Q1f_eq_affine]; ring
  have hK : 20 - 16 * (2 : ℝ) ^ β + (a + b) * (16 * 2 ^ β - 24) ≤ 0 := by
    have : 0 ≤ (a + b) * (24 - 16 * (2 : ℝ) ^ β) := mul_nonneg (by linarith) (by linarith)
    nlinarith
  nlinarith [mul_nonneg (sub_nonneg.2 hab) (neg_nonneg.2 hK)]

/-- Concavity of $Q_\beta$ on $[0,1]$: $Q_\beta(m)\le Q_\beta(a)+Q_\beta'(a)(m-a)$. -/
theorem Q_le_tangent (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) {a m : ℝ}
    (ha : a ∈ Icc (0 : ℝ) 1) (hm : m ∈ Icc (0 : ℝ) 1) :
    Q β m ≤ Q β a + Q1f β a * (m - a) := by
  obtain ⟨h1, h2⟩ := two_rpow_bounds β hβ
  have e : Q β m - (Q β a + Q1f β a * (m - a)) = (m - a) ^ 2 *
      (((20 - 48 * a) + (-16 + 32 * a) * 2 ^ β) / 2 + (-8 + 16 / 3 * 2 ^ β) * (m - a)) := by
    rw [Q_eq_affine, Q_eq_affine, Q1f_eq_affine]; ring
  have hK : ((20 - 48 * a) + (-16 + 32 * a) * (2 : ℝ) ^ β) / 2 +
      (-8 + 16 / 3 * 2 ^ β) * (m - a) ≤ 0 := by
    have hz : 0 ≤ (2 * a + m) / 3 := by linarith [ha.1, hm.1]
    have : 0 ≤ (2 * a + m) / 3 * (48 - 32 * (2 : ℝ) ^ β) := mul_nonneg hz (by linarith)
    nlinarith
  nlinarith [mul_nonneg (sq_nonneg (m - a)) (neg_nonneg.2 hK)]

/-- $Q_\beta(m)\ge\min(Q_\beta(a),Q_\beta(b))$ for $0\le a\le m\le b\le1$ (concavity). -/
theorem min_le_Q (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) {a m b : ℝ} (ha : 0 ≤ a)
    (ham : a ≤ m) (hmb : m ≤ b) (hb : b ≤ 1) : min (Q β a) (Q β b) ≤ Q β m := by
  have h1 := Q_le_tangent β hβ (a := m) (m := a) ⟨by linarith, by linarith⟩ ⟨ha, by linarith⟩
  have h2 := Q_le_tangent β hβ (a := m) (m := b) ⟨by linarith, by linarith⟩ ⟨by linarith, hb⟩
  rcases eq_or_lt_of_le (show a ≤ b by linarith) with h | h
  · subst h
    have : m = a := le_antisymm hmb ham
    subst this; exact min_le_left _ _
  have key : (b - m) * Q β a + (m - a) * Q β b ≤ (b - a) * Q β m := by
    nlinarith [mul_le_mul_of_nonneg_left h1 (show 0 ≤ b - m by linarith),
      mul_le_mul_of_nonneg_left h2 (show 0 ≤ m - a by linarith)]
  have hmin1 := min_le_left (Q β a) (Q β b)
  have hmin2 := min_le_right (Q β a) (Q β b)
  nlinarith [mul_le_mul_of_nonneg_left hmin1 (show 0 ≤ b - m by linarith),
    mul_le_mul_of_nonneg_left hmin2 (show 0 ≤ m - a by linarith)]

/-- The upper bound $\overline Q_\beta(a,b)$ of $Q_\beta$ on $[a,b]$: $Q_\beta(b)$ if
$Q_\beta'(b)\ge0$, otherwise $Q_\beta(a)+\max(Q_\beta'(a),0)(b-a)$. -/
noncomputable def Qbar (β a b : ℝ) : ℝ :=
  if Q1f β b < 0 then Q β a + max (Q1f β a) 0 * (b - a) else Q β b

/-- $Q_\beta(m)\le\overline Q_\beta(a,b)$ for $0\le a\le m\le b\le1$. -/
theorem Q_le_Qbar (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) {a m b : ℝ} (ha : 0 ≤ a)
    (ham : a ≤ m) (hmb : m ≤ b) (hb : b ≤ 1) : Q β m ≤ Qbar β a b := by
  unfold Qbar
  split_ifs with h
  · have := Q_le_tangent β hβ (a := a) (m := m) ⟨ha, by linarith⟩ ⟨by linarith, by linarith⟩
    have : Q1f β a * (m - a) ≤ max (Q1f β a) 0 * (b - a) := by
      have h3 : Q1f β a * (m - a) ≤ max (Q1f β a) 0 * (m - a) :=
        mul_le_mul_of_nonneg_right (le_max_left _ _) (by linarith)
      have h4 : max (Q1f β a) 0 * (m - a) ≤ max (Q1f β a) 0 * (b - a) :=
        mul_le_mul_of_nonneg_left (by linarith) (le_max_right _ _)
      linarith
    linarith
  · have := Q_le_tangent β hβ (a := b) (m := m) ⟨by linarith, hb⟩ ⟨by linarith, by linarith⟩
    have : Q1f β b * (m - b) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (not_lt.1 h) (by linarith)
    linarith

/-- $Q_\beta'>0$ on $[0,\frac12]$. -/
theorem Q1f_pos (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) {x : ℝ}
    (hx : x ∈ Icc (0 : ℝ) 2⁻¹) : 0 < Q1f β x := by
  obtain ⟨h1, h2⟩ := two_rpow_bounds β hβ
  have h := Q1f_anti β hβ hx.1 hx.2
  rw [Q1f_eq_affine β 2⁻¹] at h
  norm_num at h
  linarith

/-- $Q_\beta$ is increasing on $[0,\frac12]$. -/
theorem Q_mono (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) {a b : ℝ} (ha : 0 ≤ a)
    (hab : a ≤ b) (hb : b ≤ 2⁻¹) : Q β a ≤ Q β b := by
  have := Q_le_tangent β hβ (a := b) (m := a) ⟨by linarith, by linarith⟩ ⟨ha, by linarith⟩
  have := Q1f_pos β hβ (x := b) ⟨by linarith, hb⟩
  nlinarith

/-- [DIR], §6.5, item 2: $x\mapsto2Q_\beta(\frac{x+y}2)-Q_\beta(x)$ is decreasing on
$[0,y]$ (its derivative is $Q'_\beta(\frac{x+y}2)-Q'_\beta(x)\le0$). -/
theorem two_Q_mid_sub_anti (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) {y : ℝ}
    {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) (hby : b ≤ y) :
    2 * Q β ((b + y) / 2) - Q β b ≤ 2 * Q β ((a + y) / 2) - Q β a := by
  have hd : ∀ x, HasDerivAt (fun x ↦ 2 * Q β ((x + y) / 2) - Q β x)
      (Q1f β ((x + y) / 2) - Q1f β x) x := by
    intro x
    have hm : HasDerivAt (fun x : ℝ ↦ (x + y) / 2) (1 / 2) x := by
      simpa using ((hasDerivAt_id x).add_const y).div_const 2
    have := (((hasDerivAt_Q β ((x + y) / 2)).comp x hm).const_mul 2).sub (hasDerivAt_Q β x)
    convert this using 1
    · ext z; simp [Function.comp]
    · ring
  have hanti : AntitoneOn (fun x ↦ 2 * Q β ((x + y) / 2) - Q β x) (Icc a b) := by
    refine antitoneOn_of_deriv_nonpos (convex_Icc a b)
      (fun x _ ↦ (hd x).continuousAt.continuousWithinAt)
      (fun x _ ↦ (hd x).differentiableAt.differentiableWithinAt) ?_
    intro x hx
    rw [interior_Icc] at hx
    rw [(hd x).deriv]
    have := Q1f_anti β hβ (a := x) (b := (x + y) / 2) (by linarith [hx.1])
      (by linarith [hx.2])
    linarith
  exact hanti ⟨le_rfl, hab⟩ ⟨hab, le_rfl⟩ hab

/-! ### $J'$ and the monotonicity of $JJ'$ -/

/-- `DJr` is $\sqrt2\,\Phi^{-1}(w_0^{-1}(1-x))$. -/
theorem DJr_eq (x : ℝ) : DJr x = √2 * gInv (w₀⁻¹ * (1 - x)) := by
  rw [DJr, div_eq_inv_mul]

/-- $J_{w_0}'=$ `DJr` on $(1-w_0,1)$. -/
theorem hasDerivAt_gJw_DJr {x : ℝ} (hx : x ∈ Ioo (1 - w₀) 1) :
    HasDerivAt (gJw w₀) (DJr x) x := by
  rw [DJr_eq]; exact hasDerivAt_gJw w₀_pos hx

/-- `DJr` is decreasing on $(1-w_0,1)$. -/
theorem DJr_antitoneOn : AntitoneOn DJr (Ioo (1 - w₀) 1) := by
  intro a ha b hb hab
  rw [DJr_eq, DJr_eq]
  have hw := inv_pos.2 w₀_pos
  have h := gInv_strictMonoOn.monotoneOn (affine_mem_Ioo w₀_pos hb) (affine_mem_Ioo w₀_pos ha)
    (mul_le_mul_of_nonneg_left (by linarith) hw.le)
  exact mul_le_mul_of_nonneg_left h (by positivity)

/-- `DJr` has the derivative $V$ with $V\cdot J_{w_0}=-2$ on $(1-w_0,1)$. -/
theorem hasDerivAt_DJr {x : ℝ} (hx : x ∈ Ioo (1 - w₀) 1) :
    ∃ V, HasDerivAt DJr V x ∧ V * gJw w₀ x = -2 := by
  refine ⟨-(√2 * w₀⁻¹ * (gProf (w₀⁻¹ * (1 - x)))⁻¹), ?_, ?_⟩
  · refine (hasDerivAt_deriv_gJw w₀_pos hx).congr_of_eventuallyEq ?_
    filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy
    exact (hasDerivAt_gJw_DJr hy).deriv.symm
  · rw [← (hasDerivAt_deriv_gJw w₀_pos hx).deriv]; exact gJw_deriv2_mul w₀_pos hx

/-- $J'(\frac12)<1$. -/
theorem DJr_half_lt : DJr 2⁻¹ < 1 := by
  have := checkUpper_sound P11 hw11 [] (.DJ (1 / 2) 0.1034885978228266 0.1034885978330739) 1
    (by decide +kernel)
  simpa [denote] using this

/-- $J'(\frac34)>-1$. -/
theorem DJr_three_fourths_gt : -1 < DJr (3 / 4) := by
  have := check_sound P11 hw11 [] (.DJ (3 / 4) (-0.4140448400864266) (-0.4140448400803269)) (-1)
    (by decide +kernel)
  simpa [denote] using this

/-- $|J'|<1$ on $[\frac12,\frac34]$. -/
theorem DJr_sq_lt {y : ℝ} (hy : y ∈ Icc (2⁻¹ : ℝ) (3 / 4)) : DJr y ^ 2 < 1 := by
  have hw := w₀_mem.1
  have hI : ∀ z ∈ Icc (2⁻¹ : ℝ) (3 / 4), z ∈ Ioo (1 - w₀) 1 :=
    fun z hz ↦ ⟨by linarith [hz.1], by linarith [hz.2]⟩
  have h1 := DJr_antitoneOn (hI _ ⟨le_rfl, by norm_num⟩) (hI y hy) hy.1
  have h2 := DJr_antitoneOn (hI y hy) (hI _ ⟨by norm_num, le_rfl⟩) hy.2
  have := DJr_half_lt
  have := DJr_three_fourths_gt
  nlinarith

/-- $J'(y)=$ `DJr y` as the derivative within $[\frac12,1]$ at $y\in[\frac12,1)$ (one-sided at
$y=\frac12$). -/
theorem derivWithin_J_eq {y : ℝ} (hy : y ∈ Ico (2⁻¹ : ℝ) 1) :
    derivWithin J (Icc 2⁻¹ 1) y = DJr y := by
  have hw := w₀_mem.1
  have h := (hasDerivAt_gJw_DJr (x := y) ⟨by linarith [hy.1], hy.2⟩).hasDerivWithinAt
    (s := Icc 2⁻¹ 1)
  have h' : HasDerivWithinAt J (DJr y) (Icc 2⁻¹ 1) y :=
    h.congr (fun z hz ↦ J_eq_gJw_w₀ hz) (J_eq_gJw_w₀ ⟨hy.1, hy.2.le⟩)
  exact h'.derivWithin (uniqueDiffOn_Icc (by norm_num) y ⟨hy.1, hy.2.le⟩)

/-- [DIR], §6.5, item 1: $y\mapsto J(y)J'(y)$ is decreasing on $[\frac12,\frac34]$:
$(JJ')'=(J')^2+JJ''=(J')^2-2<0$. -/
theorem J_mul_DJr_antitoneOn : AntitoneOn (fun y ↦ J y * DJr y) (Icc 2⁻¹ (3 / 4)) := by
  have hw := w₀_mem.1
  have hI : ∀ z ∈ Icc (2⁻¹ : ℝ) (3 / 4), z ∈ Ioo (1 - w₀) 1 :=
    fun z hz ↦ ⟨by linarith [hz.1], by linarith [hz.2]⟩
  have hd : ∀ z ∈ Icc (2⁻¹ : ℝ) (3 / 4), ∃ V, HasDerivAt (fun y ↦ gJw w₀ y * DJr y)
      (DJr z * DJr z + gJw w₀ z * V) z ∧ V * gJw w₀ z = -2 := by
    intro z hz
    obtain ⟨V, hV, hVm⟩ := hasDerivAt_DJr (hI z hz)
    exact ⟨V, (hasDerivAt_gJw_DJr (hI z hz)).mul hV, hVm⟩
  have heq : EqOn (fun y ↦ J y * DJr y) (fun y ↦ gJw w₀ y * DJr y) (Icc 2⁻¹ (3 / 4)) :=
    fun z hz ↦ by simp only [J_eq_gJw_w₀ ⟨hz.1, by linarith [hz.2]⟩]
  refine AntitoneOn.congr ?_ heq.symm
  refine antitoneOn_of_deriv_nonpos (convex_Icc _ _) ?_ ?_ ?_
  · intro z hz
    obtain ⟨V, hV, -⟩ := hd z hz
    exact hV.continuousAt.continuousWithinAt
  · intro z hz
    rw [interior_Icc] at hz
    obtain ⟨V, hV, -⟩ := hd z (Ioo_subset_Icc_self hz)
    exact hV.differentiableAt.differentiableWithinAt
  · intro z hz
    rw [interior_Icc] at hz
    obtain ⟨V, hV, hVm⟩ := hd z (Ioo_subset_Icc_self hz)
    rw [hV.deriv]
    have := DJr_sq_lt (Ioo_subset_Icc_self hz)
    nlinarith

/-! ### The tight lower bound -/

/-- The tight lower bound of $g_{QJQ,\beta}$ ([DIR], §6.5, corrected where $x+y>1$, see the
module docstring): with $m_l=\frac{\underline x+\underline y}2$,
$m_h=\frac{\underline x+\overline y}2$,
$$\underline{g_{QJQ,\beta}}=\underline y-\overline x+J(\overline y)J'(\overline y)
-\max\big((2\overline Q_\beta(m_l,m_h)-Q_\beta(\underline x))Q_\beta'(m_l),
(2\min(Q_\beta(\tfrac{\overline x+\underline y}2),Q_\beta(\tfrac{\overline x+\overline y}2))
-Q_\beta(\overline x))Q_\beta'(m_l)\big).$$ -/
noncomputable def g_QJQ_lo (β xl xu yl yu : ℝ) : ℝ :=
  (yl - xu) + J yu * DJr yu -
    max ((2 * Qbar β ((xl + yl) / 2) ((xl + yu) / 2) - Q β xl) * Q1f β ((xl + yl) / 2))
      ((2 * min (Q β ((xu + yl) / 2)) (Q β ((xu + yu) / 2)) - Q β xu) *
        Q1f β ((xl + yl) / 2))

/-- [DIR], §6.5: $\underline{g_{QJQ,\beta}}$ is a lower bound of
$g_{QJQ,\beta}(x,y)=(y-x)+J(y)J'(y)-(2Q_\beta(\frac{x+y}2)-Q_\beta(x))Q'_\beta(\frac{x+y}2)$ on
subrectangles of $[\frac14,\frac12]\times[\frac12,\frac34]$. -/
theorem g_QJQ_lo_le (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) {xl xu yl yu x y : ℝ}
    (hxl : 4⁻¹ ≤ xl) (hxu : xu ≤ 2⁻¹) (hyl : 2⁻¹ ≤ yl) (hyu : yu ≤ 3 / 4)
    (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    g_QJQ_lo β xl xu yl yu ≤
      (y - x) + J y * DJr y - (2 * Q β ((x + y) / 2) - Q β x) * Q1f β ((x + y) / 2) := by
  have hx1 := hx.1; have hx2 := hx.2; have hy1 := hy.1; have hy2 := hy.2
  -- the factor $B=Q'_\beta(\frac{x+y}2)\le Q'_\beta(m_l)$
  have hB : Q1f β ((x + y) / 2) ≤ Q1f β ((xl + yl) / 2) :=
    Q1f_anti β hβ (by linarith) (by linarith)
  -- the factor $A=2Q_\beta(\frac{x+y}2)-Q_\beta(x)$
  have hA0 : 0 < 2 * Q β ((x + y) / 2) - Q β x := by
    have h1 := two_Q_mid_sub_ge β hβ x y (by linarith) (by linarith)
    have h2 := Q_pos_of_mem β hβ y ⟨by linarith, by linarith⟩
    linarith
  have hAmax : 2 * Q β ((x + y) / 2) - Q β x ≤
      2 * Qbar β ((xl + yl) / 2) ((xl + yu) / 2) - Q β xl := by
    have h1 := two_Q_mid_sub_anti β hβ (y := y) (a := xl) (b := x) (by linarith)
      hx1 (by linarith)
    have h2 := Q_le_Qbar β hβ (a := (xl + yl) / 2) (m := (xl + y) / 2) (b := (xl + yu) / 2)
      (by linarith) (by linarith) (by linarith) (by linarith)
    linarith
  have hAmin : 2 * min (Q β ((xu + yl) / 2)) (Q β ((xu + yu) / 2)) - Q β xu ≤
      2 * Q β ((x + y) / 2) - Q β x := by
    have h1 := two_Q_mid_sub_anti β hβ (y := y) (a := x) (b := xu) (by linarith)
      hx2 (by linarith)
    have h2 := min_le_Q β hβ (a := (xu + yl) / 2) (m := (xu + y) / 2) (b := (xu + yu) / 2)
      (by linarith) (by linarith) (by linarith) (by linarith)
    linarith
  have hT : (2 * Q β ((x + y) / 2) - Q β x) * Q1f β ((x + y) / 2) ≤
      max ((2 * Qbar β ((xl + yl) / 2) ((xl + yu) / 2) - Q β xl) * Q1f β ((xl + yl) / 2))
        ((2 * min (Q β ((xu + yl) / 2)) (Q β ((xu + yu) / 2)) - Q β xu) *
          Q1f β ((xl + yl) / 2)) := by
    have h1 := mul_le_mul_of_nonneg_left hB hA0.le
    rcases le_total 0 (Q1f β ((xl + yl) / 2)) with h | h
    · exact h1.trans ((mul_le_mul_of_nonneg_right hAmax h).trans (le_max_left _ _))
    · exact h1.trans ((mul_le_mul_of_nonpos_right hAmin h).trans (le_max_right _ _))
  have hJ := J_mul_DJr_antitoneOn ⟨by linarith, by linarith⟩ ⟨by linarith, hyu⟩ hy2
  simp only at hJ
  unfold g_QJQ_lo
  linarith

/-! ### The box certificate -/

/-- The polynomial $Q_\beta(m)=a(m)+b(m)2^\beta$: the coefficient
$a(m)=\frac23m(1-m)(-3+12m)$. -/
def qa (m : ℚ) : ℚ := 2 / 3 * m * (1 - m) * (-3 + 12 * m)

/-- The coefficient $b(m)=\frac23m(1-m)(4-8m)$ of $2^\beta$ in $Q_\beta(m)$. -/
def qb (m : ℚ) : ℚ := 2 / 3 * m * (1 - m) * (4 - 8 * m)

/-- The coefficient $-2+20m-24m^2$ in $Q_\beta'(m)$. -/
def q1a (m : ℚ) : ℚ := -2 + 20 * m - 24 * m ^ 2

/-- The coefficient $\frac83-16m+16m^2$ of $2^\beta$ in $Q_\beta'(m)$. -/
def q1b (m : ℚ) : ℚ := 8 / 3 - 16 * m + 16 * m ^ 2

/-- $Q_\beta(m)$ for rational $m$, with $2^\beta$ the variable `i` of the checker. -/
def qEx (i : ℕ) (m : ℚ) : Ex := .add (.const (qa m)) (.mul (.const (qb m)) (.var i))

/-- $Q'_\beta(m)$ for rational $m$, with $2^\beta$ the variable `i` of the checker. -/
def q1Ex (i : ℕ) (m : ℚ) : Ex := .add (.const (q1a m)) (.mul (.const (q1b m)) (.var i))

/-- The real meaning of `qEx`. -/
theorem denote_qEx (ρ : ℕ → ℝ) (i : ℕ) (m : ℚ) (β : ℝ) (h : ρ i = 2 ^ β) :
    denote ρ (qEx i m) = Q β m := by
  simp only [qEx, denote, qa, qb, h, Q_eq_affine]
  push_cast; ring

/-- The real meaning of `q1Ex`. -/
theorem denote_q1Ex (ρ : ℕ → ℝ) (i : ℕ) (m : ℚ) (β : ℝ) (h : ρ i = 2 ^ β) :
    denote ρ (q1Ex i m) = Q1f β m := by
  simp only [q1Ex, denote, q1a, q1b, h, Q1f_eq_affine]
  push_cast; ring

/-- The value $a^r$ of a `PowVal`. -/
noncomputable def PowVal.v (j : PowVal) : ℝ := (j.a : ℝ) ^ (j.r : ℝ)

/-- Certified enclosure of $2^{1/2}$. -/
theorem tHalf_h : checkMem P11 [] (.rpow (.const 2) (1 / 2)) 1.41421356237309404
    1.41421356237309605 = true := by
  decide +kernel

/-- Certified value $2^{1/2}$. -/
def tHalf : PowVal := PowVal.mk' 2 (1 / 2) 1.41421356237309404 1.41421356237309605 tHalf_h

/-- `tHalf` is $2^{1/2}$. -/
theorem tHalf_v : tHalf.v = 2 ^ (2⁻¹ : ℝ) := by
  simp only [PowVal.v, tHalf, PowVal.mk']; norm_num

/-- Certified enclosure of $2^{\beta_1}=2^{543/1024}$. -/
theorem tβ₁_h : checkMem P11 [] (.rpow (.const 2) (543 / 1024)) 1.44420289287126726
    1.44420289287126927 = true := by
  decide +kernel

/-- Certified value $2^{\beta_1}$. -/
def tβ₁ : PowVal := PowVal.mk' 2 (543 / 1024) 1.44420289287126726 1.44420289287126927 tβ₁_h

/-- `tβ₁` is $2^{\beta_1}$, $\beta_1=\frac12+\frac{31}{1024}$. -/
theorem tβ₁_v : tβ₁.v = 2 ^ (2⁻¹ + 31 / 1024 : ℝ) := by
  simp only [PowVal.v, tβ₁, PowVal.mk']; norm_num

/-- The expression of the checker for $\underline{g_{QJQ,\beta}}$ on
$[x_l,x_u]\times[y_l,y_u]$; the variables `0`, `1`, `2` stand for $J(y_u)$, $J'(y_u)$, $2^\beta$. -/
def gQJQEx (xl xu yl yu : ℚ) : Ex :=
  .sub (.add (.const (yl - xu)) (.mul (.var 0) (.var 1)))
    (.max
      (.mul (.sub (.mul (.const 2)
          (.ite_lt (q1Ex 2 ((xl + yu) / 2)) (.const 0)
            (.add (qEx 2 ((xl + yl) / 2))
              (.mul (.max (q1Ex 2 ((xl + yl) / 2)) (.const 0))
                (.const ((xl + yu) / 2 - (xl + yl) / 2))))
            (qEx 2 ((xl + yu) / 2))))
        (qEx 2 xl)) (q1Ex 2 ((xl + yl) / 2)))
      (.mul (.sub (.mul (.const 2) (.min (qEx 2 ((xu + yl) / 2)) (qEx 2 ((xu + yu) / 2))))
        (qEx 2 xu)) (q1Ex 2 ((xl + yl) / 2))))

/-- The real meaning of `gQJQEx`. -/
theorem denote_gQJQEx (β : ℝ) (xl xu yl yu : ℚ) (a b c : Cert) (hc : c.v = 2 ^ β) :
    denote (Cert.val [a, b, c]) (gQJQEx xl xu yl yu) =
      g_QJQ_lo β xl xu yl yu + (J yu * DJr yu - a.v * b.v) * (-1) := by
  have h2 : Cert.val [a, b, c] 2 = 2 ^ β := hc
  simp only [gQJQEx, denote, denote_qEx _ 2 _ β h2, denote_q1Ex _ 2 _ β h2]
  simp only [g_QJQ_lo, Qbar, Cert.val, envOf]
  push_cast
  simp only [List.map_cons, List.map_nil, List.getD_cons_zero, List.getD_cons_succ]
  ring

/-- $\underline{g_{QJQ,\beta}}-10^{-5}$ as a function of the corners of a rectangle in
$\mathbb R^2$ (the function $\underline f$ of [DIR], §4.1 for (6.25)). -/
noncomputable def gQJQ_fl (β : ℝ) (zl zu : Fin 2 → ℝ) : ℝ :=
  g_QJQ_lo β (zl 0) (zu 0) (zl 1) (zu 1) - 1 / 10 ^ 5

/-- The Boolean box check for (6.25): the table entries are at the right point $\overline y$ and
the checker certifies $\underline{g_{QJQ,\beta}}>10^{-5}$ (with the enclosure `t` of
$2^\beta$). -/
def gQJQCheck (t : PowVal) (p : Box) (a : JVal) (b : DJVal) : Bool :=
  a.x == p.2.2.2 && b.x == p.2.2.2 &&
    check P11 [(a.l, a.u), (b.l, b.u), (t.l, t.u)] (gQJQEx p.1 p.2.1 p.2.2.1 p.2.2.2) (1 / 10 ^ 5)

/-- **Box certificate for (6.25).** If `gQJQCheck` succeeds on the rectangle `p` (with an
enclosure `t` of $2^\beta$), then $\underline{g_{QJQ,\beta}}>10^{-5}$ on `p`. -/
theorem gQJQ_box (β : ℝ) (t : PowVal) (ht : t.v = 2 ^ β) (p : Box) (a : JVal) (b : DJVal)
    (h : gQJQCheck t p a b = true) : 0 < gQJQ_fl β (Box.toR p).1 (Box.toR p).2 := by
  obtain ⟨xl, xu, yl, yu⟩ := p
  simp only [gQJQCheck, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨ha, hb⟩, hk⟩ := h
  have := check_sound P11 hw11 [a.cert, b.cert, t.cert] _ _ hk
  rw [denote_gQJQEx β _ _ _ _ _ _ _ ht] at this
  simp only [JVal.cert, DJVal.cert, ha, hb] at this
  simp only [gQJQ_fl, Box.toR, Matrix.cons_val_zero, Matrix.cons_val_one]
  push_cast at this ⊢
  linarith

/-- **Soundness of partitioning for (6.25)** ([DIR], §4.1, via `Auto.DIR.pos_of_dtree`): if
$\underline{g_{QJQ,\beta}}>10^{-5}$ on every rectangle of a dyadic partition tree of
$[\frac14,\frac12]\times[\frac12,\frac34]$, then $g_{QJQ,\beta}>10^{-5}$ there. -/
theorem gQJQ_of_tree (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) (t : DTree)
    (ht : ∀ p ∈ t.boxes (1 / 4) (1 / 2) (1 / 2) (3 / 4),
      0 < gQJQ_fl β (Box.toR p).1 (Box.toR p).2) :
    ∀ x ∈ Icc (4⁻¹ : ℝ) 2⁻¹, ∀ y ∈ Icc (2⁻¹ : ℝ) (3 / 4), 1 / 10 ^ 5 <
      (y - x) + J y * DJr y - (2 * Q β ((x + y) / 2) - Q β x) * Q1f β ((x + y) / 2) := by
  intro x hx y hy
  have h := pos_of_dtree t (1 / 4) (1 / 2) (1 / 2) (3 / 4) (by norm_num) (by norm_num)
    (fun z ↦ (z 1 - z 0) + J (z 1) * DJr (z 1) -
      (2 * Q β ((z 0 + z 1) / 2) - Q β (z 0)) * Q1f β ((z 0 + z 1) / 2) - 1 / 10 ^ 5)
    (gQJQ_fl β) ?_ ht ![x, y] (mem_Icc_toR.2 ⟨by push_cast; norm_num at hx ⊢; exact hx,
      by push_cast; norm_num at hy ⊢; exact hy⟩)
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h
    linarith
  · intro zl zu hzl hzu z hz
    obtain ⟨⟨h1, h2⟩, h3, h4⟩ := le_toR_iff.1 ⟨hzl, hzu⟩
    push_cast at h1 h2 h3 h4
    have hz0 : z 0 ∈ Icc (zl 0) (zu 0) := ⟨hz.1 0, hz.2 0⟩
    have hz1 : z 1 ∈ Icc (zl 1) (zu 1) := ⟨hz.1 1, hz.2 1⟩
    have := g_QJQ_lo_le β hβ (by linarith) (by linarith) (by linarith) (by linarith) hz0 hz1
    simp only [gQJQ_fl]
    linarith

end Auto.DIR
