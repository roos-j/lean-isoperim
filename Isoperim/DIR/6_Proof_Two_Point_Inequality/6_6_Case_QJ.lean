theorem caseQJ_G₁_monotoneOn_beta (x y : ℝ) (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹)
    (hy : y ∈ Icc (2⁻¹ : ℝ) 1) :
    MonotoneOn (fun β ↦ G₁ β J x y) (Icc 2⁻¹ 1) := by
  exact (G₁_monotoneOn_beta_of_le J x y (by linarith [hx.2, hy.1]) (J_nonneg hy)).mono
