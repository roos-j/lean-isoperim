section Case_J_II

/-! ### §6.1.2 Case II: $\frac12\le x\le x_0$, $\frac{11}{16}\le y\le 1$ -/

/-
By monotonicity it suffices to show the stronger conclusion
$G^1_{\frac12}[J](x,y)\ge 0$
or equivalently,
\[g_{J,2}(x,y)=(y-x)^2 +J(y)^2-(2J(\tfrac{x+y}{2})-J(x))^2\ge 0.\]
-/

/-- [DIR], §6.1.2: by monotonicity (in $\beta$ and in $c$) it suffices to show the stronger
conclusion $G^1_{\frac12}[J](x,y)\ge0$: for $\frac12\le x\le y\le1$, it implies
$G^1_{\beta_0}[J](x,y)\ge0$ and $G^1_{\frac12}[c_0J](x,y)\ge0$. -/
theorem caseJ_II_suffices (x y : ℝ) (hx : 1 / 2 ≤ x) (hxy : x ≤ y) (hy : y ≤ 1)
    (h : G₁ (1 / 2) J x y ≥ 0) : G₁ β₀ J x y ≥ 0 ∧ G₁ (1 / 2) (c₀ • J) x y ≥ 0 := by
  sorry

/-- The function $g_{J,2}(x,y)=(y-x)^2+J(y)^2-(2J(\frac{x+y}2)-J(x))^2$ ([DIR], §6.1.2). -/
noncomputable def g_J_2 (x y : ℝ) : ℝ := (y - x) ^ 2 + J y ^ 2 - (2 * J ((x + y) / 2) - J x) ^ 2

/-- [DIR], §6.1.2: for $\frac12\le x\le\frac9{16}$ and $\frac{11}{16}\le y\le1$,
$G^1_{\frac12}[J](x,y)\ge0$ is equivalent to $g_{J,2}(x,y)\ge0$. -/
theorem caseJ_II_iff_g_J_2 (x y : ℝ) (hx : x ∈ Icc (1 / 2 : ℝ) (9 / 16))
    (hy : y ∈ Icc (11 / 16 : ℝ) 1) : G₁ (1 / 2) J x y ≥ 0 ↔ g_J_2 x y ≥ 0 := by
  sorry

/-
The quantity $2J(\frac{x+y}{2})-J(x)\ge 0$ is decreasing in $y$ (since
$\frac{x+y}2\ge \tfrac12(\tfrac12+\tfrac{11}{16})=0.59375>x_0$, so $J'(\frac{x+y}2)<0$) and also
decreasing in $x$, because the $x$-derivative is
\[ J'(\tfrac{x+y}2)-J'(x) = J''(\xi)\tfrac{y-x}2 < 0 \]
by the mean value theorem.
-/

/-- [DIR], §6.1.2: for $\frac12\le x\le\frac9{16}$ and $\frac{11}{16}\le y\le1$,
$2J(\frac{x+y}2)-J(x)\ge0$. -/
theorem caseJ_II_nonneg (x y : ℝ) (hx : x ∈ Icc (1 / 2 : ℝ) (9 / 16))
    (hy : y ∈ Icc (11 / 16 : ℝ) 1) : 2 * J ((x + y) / 2) - J x ≥ 0 := by
  sorry

/-- [DIR], §6.1.2: for $x\ge\frac12$ and $y\ge\frac{11}{16}$,
$\frac{x+y}2\ge\frac12(\frac12+\frac{11}{16})=0.59375>x_0$, so $J'(\frac{x+y}2)<0$ (stated
for $\frac{x+y}2<1$, where $J'$ is meaningful). -/
theorem caseJ_II_midpoint (x y : ℝ) (hx : 1 / 2 ≤ x) (hy : 11 / 16 ≤ y)
    (hxy : (x + y) / 2 < 1) :
    (x + y) / 2 ≥ 1 / 2 * (1 / 2 + 11 / 16) ∧ (1 / 2 * (1 / 2 + 11 / 16) : ℝ) = 0.59375 ∧
      (0.59375 : ℝ) > x₀ ∧ deriv J ((x + y) / 2) < 0 := by
  sorry

/-- [DIR], §6.1.2: $2J(\frac{x+y}2)-J(x)$ is decreasing in $y\in[\frac{11}{16},1]$ for
$x\in[\frac12,\frac9{16}]$. -/
theorem caseJ_II_antitone_y (x : ℝ) (hx : x ∈ Icc (1 / 2 : ℝ) (9 / 16)) :
    AntitoneOn (fun y ↦ 2 * J ((x + y) / 2) - J x) (Icc (11 / 16) 1) := by
  sorry

/-- [DIR], §6.1.2: the $x$-derivative of $2J(\frac{x+y}2)-J(x)$ is
$J'(\frac{x+y}2)-J'(x)=J''(\xi)\frac{y-x}2<0$ for some $\xi\in(x,\frac{x+y}2)$ (mean value
theorem), for $\frac12<x\le\frac9{16}$ and $\frac{11}{16}\le y\le1$. -/
theorem caseJ_II_deriv_x (x y : ℝ) (hx : x ∈ Ioc (1 / 2 : ℝ) (9 / 16))
    (hy : y ∈ Icc (11 / 16 : ℝ) 1) :
    deriv (fun x ↦ 2 * J ((x + y) / 2) - J x) x = deriv J ((x + y) / 2) - deriv J x ∧
      ∃ ξ ∈ Ioo x ((x + y) / 2),
        deriv J ((x + y) / 2) - deriv J x = deriv (deriv J) ξ * ((y - x) / 2) ∧
          deriv (deriv J) ξ * ((y - x) / 2) < 0 := by
  sorry

/-- [DIR], §6.1.2: $2J(\frac{x+y}2)-J(x)$ is decreasing in $x\in[\frac12,\frac9{16}]$ for
$y\in[\frac{11}{16},1]$. -/
theorem caseJ_II_antitone_x (y : ℝ) (hy : y ∈ Icc (11 / 16 : ℝ) 1) :
    AntitoneOn (fun x ↦ 2 * J ((x + y) / 2) - J x) (Icc (1 / 2) (9 / 16)) := by
  sorry

/-
Therefore, a tight lower bound for $g_{J,2}$ is given by
\[ \underline{g_{J,2}}(\underline{x},\overline{x},\underline{y},\overline{y})=(\underline{y}-
\overline{x})^2 +J(\overline{y})^2-(2J(\tfrac{\underline{x}+\underline{y}}{2})-
J(\underline{x}))^2. \]
-/

/-- The lower bound ([DIR], §6.1.2)
$$\underline{g_{J,2}}(\underline x,\overline x,\underline y,\overline y)
=(\underline y-\overline x)^2
+J(\overline y)^2-(2J(\tfrac{\underline x+\underline y}2)-J(\underline x))^2.$$ -/
noncomputable def g_J_2_lo (xl xu yl yu : ℝ) : ℝ :=
  (yl - xu) ^ 2 + J yu ^ 2 - (2 * J ((xl + yl) / 2) - J xl) ^ 2

/-- [DIR], §6.1.2: $\underline{g_{J,2}}$ is a tight lower bound for $g_{J,2}$ on
$[\frac12,\frac9{16}]\times[\frac{11}{16},1]$. -/
theorem g_J_2_lo_tight :
    IsTightLowerBound₂ g_J_2 g_J_2_lo (1 / 2) (9 / 16) (11 / 16) 1 := by
  sorry

/-
Running $\textsc{Partition}_2(\underline{g_{J,2}},[\frac12,\frac9{16}]\times[\frac{11}{16},1])$
shows that
\begin{equation}\label{eqn:g_J_2_auto}\auto
g_{J,2}(x,y)>10^{-8}
\end{equation}
for $(x,y)$ in this rectangle (and note that $\frac{9}{16}=0.5625>x_0$).
-/

/-- **(6.5)** ([DIR], §6.1.2) (🚗). For $(x,y)\in[\frac12,\frac9{16}]\times[\frac{11}{16},1]$:
$$g_{J,2}(x,y)>10^{-8}.$$ (There is no equation (6.4) in [DIR].) -/
theorem eqn_6_5 (x y : ℝ) (hx : x ∈ Icc (1 / 2 : ℝ) (9 / 16))
    (hy : y ∈ Icc (11 / 16 : ℝ) 1) : g_J_2 x y > 10 ^ (-8 : ℤ) := by
  sorry

/-- [DIR], §6.1.2: $\frac9{16}=0.5625>x_0$. -/
theorem nine_div_sixteen_gt_x₀ : (9 / 16 : ℝ) = 0.5625 ∧ (0.5625 : ℝ) > x₀ := by
  sorry

/-- [DIR], §6.1.2 (conclusion of Case II): for $\frac12\le x\le x_0$ and
$\frac{11}{16}\le y\le1$, $G^1_{\frac12}[J](x,y)\ge0$. -/
theorem caseJ_II (x y : ℝ) (hx : x ∈ Icc (1 / 2) x₀) (hy : y ∈ Icc (11 / 16 : ℝ) 1) :
    G₁ (1 / 2) J x y ≥ 0 := by
  sorry

end Case_J_II

