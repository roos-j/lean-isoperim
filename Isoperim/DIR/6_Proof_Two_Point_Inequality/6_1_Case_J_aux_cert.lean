namespace Auto.DIR

open Real Set Checker

/-! ### Dyadic partition trees -/

/-- A dyadic partition tree of a rectangle in $\mathbb R^2$: a leaf is a rectangle of the
partition, `node t₀₀ t₀₁ t₁₀ t₁₁` splits the rectangle into its four dyadic children; in
`tᵢⱼ`, `i = 1` means the upper half in the first coordinate, `j = 1` the upper half in the second
coordinate. -/
inductive DTree where
  /-- A rectangle of the partition. -/
  | leaf
  /-- Split into the four dyadic children. -/
  | node (t₀₀ t₀₁ t₁₀ t₁₁ : DTree)

/-- A rectangle $[x_l,x_u]\times[y_l,y_u]$ with rational corners, as `(xl, xu, yl, yu)`. -/
abbrev Box := ℚ × ℚ × ℚ × ℚ

/-- The list of rectangles of a dyadic partition tree of the rectangle
$[x_l,x_u]\times[y_l,y_u]$. -/
def DTree.boxes : DTree → ℚ → ℚ → ℚ → ℚ → List Box
  | .leaf, xl, xu, yl, yu => [(xl, xu, yl, yu)]
  | .node t₀₀ t₀₁ t₁₀ t₁₁, xl, xu, yl, yu =>
    t₀₀.boxes xl ((xl + xu) / 2) yl ((yl + yu) / 2) ++
      t₀₁.boxes xl ((xl + xu) / 2) ((yl + yu) / 2) yu ++
      t₁₀.boxes ((xl + xu) / 2) xu yl ((yl + yu) / 2) ++
      t₁₁.boxes ((xl + xu) / 2) xu ((yl + yu) / 2) yu

/-- The lower and upper corner of a rectangle, as points of $\mathbb R^2$ (`Fin 2 → ℝ`). -/
noncomputable def Box.toR (p : Box) : (Fin 2 → ℝ) × (Fin 2 → ℝ) :=
  (![(p.1 : ℝ), (p.2.2.1 : ℝ)], ![(p.2.1 : ℝ), (p.2.2.2 : ℝ)])

/-- Existential quantification over $\{0,1\}^2$. -/
theorem exists_fin_two_bool (P : (Fin 2 → Bool) → Prop) :
    (∃ s, P s) ↔ P ![false, false] ∨ P ![false, true] ∨ P ![true, false] ∨ P ![true, true] := by
  constructor
  · rintro ⟨s, hs⟩
    have e : s = ![s 0, s 1] := by ext i; fin_cases i <;> rfl
    rw [e] at hs
    generalize s 0 = a at hs
    generalize s 1 = b at hs
    cases a <;> cases b <;> tauto
  · rintro (h | h | h | h) <;> exact ⟨_, h⟩

/-- The dyadic child of a rectangle with rational corners is the rectangle with the rational
midpoints as corners. -/
theorem dyadicChild_toR (xl xu yl yu : ℚ) (b₀ b₁ : Bool) :
    dyadicChild (Box.toR (xl, xu, yl, yu)).1 (Box.toR (xl, xu, yl, yu)).2 ![b₀, b₁] =
      Box.toR ((if b₀ then (xl + xu) / 2 else xl), (if b₀ then xu else (xl + xu) / 2),
        (if b₁ then (yl + yu) / 2 else yl), (if b₁ then yu else (yl + yu) / 2)) := by
  simp only [dyadicChild, Box.toR]
  ext i <;> fin_cases i <;> cases b₀ <;> cases b₁ <;> simp

/-- The rectangles of a dyadic partition tree of a nondegenerate rectangle form a partition of
it (in the sense of [DIR], §4.1, `IsBoxPartition`). -/
theorem DTree.isBoxPartition (t : DTree) : ∀ (xl xu yl yu : ℚ), xl < xu → yl < yu →
    IsBoxPartition (Box.toR (xl, xu, yl, yu)).1 (Box.toR (xl, xu, yl, yu)).2
      ((t.boxes xl xu yl yu).map Box.toR).toFinset := by
  induction t with
  | leaf =>
    intro xl xu yl yu hx hy
    simp only [DTree.boxes, List.map_cons, List.map_nil, List.toFinset_cons, List.toFinset_nil,
      insert_empty_eq]
    apply isBoxPartition_singleton
    intro i; fin_cases i <;> simp [Box.toR, hx, hy]
  | node t₀₀ t₀₁ t₁₀ t₁₁ ih₀₀ ih₀₁ ih₁₀ ih₁₁ =>
    intro xl xu yl yu hx hy
    have hmx₁ : xl < (xl + xu) / 2 := by linarith
    have hmx₂ : (xl + xu) / 2 < xu := by linarith
    have hmy₁ : yl < (yl + yu) / 2 := by linarith
    have hmy₂ : (yl + yu) / 2 < yu := by linarith
    let Q : (Fin 2 → Bool) → Finset ((Fin 2 → ℝ) × (Fin 2 → ℝ)) := fun s ↦
      (((match s 0, s 1 with
        | false, false => t₀₀ | false, true => t₀₁ | true, false => t₁₀ | true, true => t₁₁).boxes
        (if s 0 then (xl + xu) / 2 else xl) (if s 0 then xu else (xl + xu) / 2)
        (if s 1 then (yl + yu) / 2 else yl) (if s 1 then yu else (yl + yu) / 2)).map
          Box.toR).toFinset
    have hQ : ∀ s, IsBoxPartition
        (dyadicChild (Box.toR (xl, xu, yl, yu)).1 (Box.toR (xl, xu, yl, yu)).2 s).1
        (dyadicChild (Box.toR (xl, xu, yl, yu)).1 (Box.toR (xl, xu, yl, yu)).2 s).2 (Q s) := by
      intro s
      have e : s = ![s 0, s 1] := by ext i; fin_cases i <;> rfl
      rw [e, dyadicChild_toR]
      simp only [Q, Matrix.cons_val_zero, Matrix.cons_val_one]
      cases s 0 <;> cases s 1 <;> simp only [Bool.false_eq_true, ↓reduceIte]
      · exact ih₀₀ _ _ _ _ hmx₁ hmy₁
      · exact ih₀₁ _ _ _ _ hmx₁ hmy₂
      · exact ih₁₀ _ _ _ _ hmx₂ hmy₁
      · exact ih₁₁ _ _ _ _ hmx₂ hmy₂
    have h := isBoxPartition_biUnion (a := (Box.toR (xl, xu, yl, yu)).1)
      (b := (Box.toR (xl, xu, yl, yu)).2)
      (by intro i; fin_cases i <;> simp [Box.toR, hx, hy]) Q hQ
    convert h using 1
    ext p
    simp only [DTree.boxes, List.map_append, List.toFinset_append, Finset.mem_union,
      List.mem_toFinset, Finset.mem_biUnion, Finset.mem_univ, true_and, Q]
    rw [exists_fin_two_bool]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Bool.false_eq_true, ↓reduceIte]
    tauto

/-- **Soundness of partitioning** ([DIR], §4.1, Fact 4.1 'if' part, `Auto.DIR.fact_4_1_if`):
if $\underline f$ is a lower bound of $f$ on $[a,b]=[x_l,x_u]\times[y_l,y_u]$ and
$\underline f>0$ on every rectangle of a dyadic partition tree, then $f>0$ on $[a,b]$. -/
theorem pos_of_dtree (t : DTree) (xl xu yl yu : ℚ) (hx : xl < xu) (hy : yl < yu)
    (f : (Fin 2 → ℝ) → ℝ) (fl : (Fin 2 → ℝ) → (Fin 2 → ℝ) → ℝ)
    (hfl : ∀ zl zu, (Box.toR (xl, xu, yl, yu)).1 ≤ zl → zu ≤ (Box.toR (xl, xu, yl, yu)).2 →
      ∀ z ∈ Icc zl zu, fl zl zu ≤ f z)
    (hbox : ∀ p ∈ t.boxes xl xu yl yu, 0 < fl (Box.toR p).1 (Box.toR p).2) :
    ∀ z ∈ Icc (Box.toR (xl, xu, yl, yu)).1 (Box.toR (xl, xu, yl, yu)).2, 0 < f z := by
  refine fact_4_1_if _ _ f fl hfl _ ⟨t.isBoxPartition xl xu yl yu hx hy, ?_⟩
  intro p hp
  obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hp)
  exact hbox q hq

/-- Membership in a rectangle with rational corners, coordinatewise. -/
theorem mem_Icc_toR {xl xu yl yu : ℚ} {x y : ℝ} :
    ![x, y] ∈ Icc (Box.toR (xl, xu, yl, yu)).1 (Box.toR (xl, xu, yl, yu)).2 ↔
      x ∈ Icc (xl : ℝ) xu ∧ y ∈ Icc (yl : ℝ) yu := by
  simp only [Box.toR, mem_Icc, Pi.le_def, Fin.forall_fin_two, Matrix.cons_val_zero,
    Matrix.cons_val_one]
  tauto

/-- A real rectangle `zl ≤ zu` inside the rectangle with rational corners, coordinatewise. -/
theorem le_toR_iff {xl xu yl yu : ℚ} {zl zu : Fin 2 → ℝ} :
    ((Box.toR (xl, xu, yl, yu)).1 ≤ zl ∧ zu ≤ (Box.toR (xl, xu, yl, yu)).2) ↔
      ((xl : ℝ) ≤ zl 0 ∧ (yl : ℝ) ≤ zl 1) ∧ (zu 0 ≤ (xu : ℝ) ∧ zu 1 ≤ (yu : ℝ)) := by
  simp only [Box.toR, Pi.le_def, Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one]

/-! ### Certified values at rational points -/

/-- A certified enclosure $l\le J(x)\le u$ at a rational point $x$. -/
structure JVal where
  /-- The point. -/
  x : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The enclosure. -/
  h : (l : ℝ) ≤ J x ∧ J x ≤ u

/-- A certified enclosure $l\le J'(x)\le u$ at a rational point $x\in(\frac12,1)$. -/
structure DJVal where
  /-- The point. -/
  x : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The point lies in $(\frac12,1)$. -/
  hx : (2⁻¹ : ℚ) < x ∧ x < 1
  /-- The enclosure. -/
  h : (l : ℝ) ≤ DJr x ∧ DJr x ≤ u

/-- A certified enclosure $l\le a^r\le u$ (`Real.rpow`) for rationals $a\ge0$, $r$. -/
structure PowVal where
  /-- The base. -/
  a : ℚ
  /-- The exponent. -/
  r : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The enclosure. -/
  h : (l : ℝ) ≤ (a : ℝ) ^ (r : ℝ) ∧ (a : ℝ) ^ (r : ℝ) ≤ u

/-- A `JVal` from a kernel-checked enclosure by the node `J x sl su`. -/
def JVal.mk' (x l u sl su : ℚ) (h : checkMem P11 [] (.J x sl su) l u = true) : JVal where
  x := x
  l := l
  u := u
  h := checkMem_sound P11 hw11 [] (.J x sl su) l u h

/-- A `DJVal` from a kernel-checked enclosure by the node `DJ x zl zu`. -/
def DJVal.mk' (x l u zl zu : ℚ) (hx : (2⁻¹ : ℚ) < x ∧ x < 1)
    (h : checkMem P11 [] (.DJ x zl zu) l u = true) : DJVal where
  x := x
  l := l
  u := u
  hx := hx
  h := checkMem_sound P11 hw11 [] (.DJ x zl zu) l u h

/-- A `PowVal` from a kernel-checked enclosure by the node `rpow` (for $a>0$). -/
def PowVal.mk' (a r l u : ℚ) (h : checkMem P11 [] (.rpow (.const a) r) l u = true) : PowVal where
  a := a
  r := r
  l := l
  u := u
  h := checkMem_sound P11 hw11 [] (.rpow (.const a) r) l u h

/-- The exact value $0^r=0$ ($r\ne0$) as a `PowVal`. -/
def PowVal.zero (r : ℚ) (hr : r ≠ 0) : PowVal where
  a := 0
  r := r
  l := 0
  u := 0
  h := by
    rw [Rat.cast_zero, Real.zero_rpow (by exact_mod_cast hr)]
    simp

/-- The exact value $J(1)=0$ as a `JVal`. -/
def JVal.one : JVal where
  x := 1
  l := 0
  u := 0
  h := by rw [Rat.cast_one, J_one]; simp

/-- A `JVal` as an entry of the environment of the checker. -/
noncomputable def JVal.cert (j : JVal) : Cert := ⟨j.l, j.u, J j.x, j.h⟩

/-- A `DJVal` as an entry of the environment of the checker. -/
noncomputable def DJVal.cert (j : DJVal) : Cert := ⟨j.l, j.u, DJr j.x, j.h⟩

/-- A `PowVal` as an entry of the environment of the checker. -/
noncomputable def PowVal.cert (j : PowVal) : Cert := ⟨j.l, j.u, (j.a : ℝ) ^ (j.r : ℝ), j.h⟩

/-- $J'(x)$ at the point of a `DJVal` is its value `DJr x`. -/
theorem DJVal.deriv_eq (j : DJVal) : deriv J j.x = DJr j.x := by
  have h1 : ((2⁻¹ : ℚ) : ℝ) < j.x := by exact_mod_cast j.hx.1
  have h2 : (j.x : ℝ) < ((1 : ℚ) : ℝ) := by exact_mod_cast j.hx.2
  push_cast at h1 h2
  exact deriv_J_eq ⟨h1, h2⟩

/-- The value of the $i$-th variable of an environment of certified values. -/
theorem Cert.val_cons_zero (c : Cert) (cs : List Cert) : Cert.val (c :: cs) 0 = c.v := rfl

/-- The value of the $(i+1)$-th variable of an environment of certified values. -/
theorem Cert.val_cons_succ (c : Cert) (cs : List Cert) (i : ℕ) :
    Cert.val (c :: cs) (i + 1) = Cert.val cs i := rfl

