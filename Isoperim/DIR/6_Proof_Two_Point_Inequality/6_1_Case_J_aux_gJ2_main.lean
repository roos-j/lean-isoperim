/-- The rectangles of the tree are the rectangles of the box certificates. -/
theorem gJ2Tree_boxes : gJ2Tree.boxes (1 / 2 : ℚ) (9 / 16 : ℚ) (11 / 16 : ℚ) (1 : ℚ) =
    gJ2_boxes_0 ++ (gJ2_boxes_1 ++ (gJ2_boxes_2 ++ (gJ2_boxes_3 ++ (gJ2_boxes_4 ++ (gJ2_boxes_5 ++ (gJ2_boxes_6 ++ (gJ2_boxes_7 ++ (gJ2_boxes_8 ++ (gJ2_boxes_9 ++ (gJ2_boxes_10 ++ (gJ2_boxes_11 ++ (gJ2_boxes_12 ++ (gJ2_boxes_13 ++ (gJ2_boxes_14 ++ (gJ2_boxes_15))))))))))))))) := by
  decide +kernel

/-- $\underline{g_{J,2}}>10^{-8}$ on every rectangle of the partition. -/
theorem gJ2Tree_pos : ∀ p ∈ gJ2Tree.boxes (1 / 2 : ℚ) (9 / 16 : ℚ) (11 / 16 : ℚ) (1 : ℚ),
    0 < gJ2_fl (Box.toR p).1 (Box.toR p).2 := by
  rw [gJ2Tree_boxes]
  intro p hp
  simp only [List.mem_append] at hp
  rcases hp with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h
  · exact gJ2_boxes_0_pos p h
  · exact gJ2_boxes_1_pos p h
  · exact gJ2_boxes_2_pos p h
  · exact gJ2_boxes_3_pos p h
  · exact gJ2_boxes_4_pos p h
  · exact gJ2_boxes_5_pos p h
  · exact gJ2_boxes_6_pos p h
  · exact gJ2_boxes_7_pos p h
  · exact gJ2_boxes_8_pos p h
  · exact gJ2_boxes_9_pos p h
  · exact gJ2_boxes_10_pos p h
  · exact gJ2_boxes_11_pos p h
  · exact gJ2_boxes_12_pos p h
  · exact gJ2_boxes_13_pos p h
  · exact gJ2_boxes_14_pos p h
  · exact gJ2_boxes_15_pos p h

/-- **(6.5)** ([DIR], §6.1.2), computer-assisted: $g_{J,2}(x,y)>10^{-8}$ on
$[\frac12,\frac9{16}]\times[\frac{11}{16},1]$, by soundness of partitioning
(`Auto.DIR.pos_of_dtree`, [DIR] Fact 4.1) with the lower bound $\underline{g_{J,2}}$
(`Auto.DIR.g_J_2_lo_le`) and the box certificates. -/
theorem g_J_2_gt (x y : ℝ) (hx : x ∈ Icc (2⁻¹ : ℝ) (9 / 16)) (hy : y ∈ Icc (11 / 16 : ℝ) 1) :
    (1 : ℝ) / 10 ^ 8 < (y - x) ^ 2 + J y ^ 2 - (2 * J ((x + y) / 2) - J x) ^ 2 := by
  have h := pos_of_dtree gJ2Tree (1 / 2) (9 / 16) (11 / 16) 1 (by norm_num) (by norm_num)
    (fun z ↦ (z 1 - z 0) ^ 2 + J (z 1) ^ 2 - (2 * J ((z 0 + z 1) / 2) - J (z 0)) ^ 2 - 1 / 10 ^ 8)
    gJ2_fl ?_ gJ2Tree_pos ![x, y] (mem_Icc_toR.2 ⟨by norm_num; constructor <;> linarith [hx.1, hx.2],
      by norm_num; constructor <;> linarith [hy.1, hy.2]⟩)
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h
    linarith
  · intro zl zu hl hu z hz
    obtain ⟨⟨h1, h2⟩, h3, h4⟩ := le_toR_iff.1 ⟨hl, hu⟩
    norm_num at h1 h2 h3 h4
    have hz0 : z 0 ∈ Icc (zl 0) (zu 0) := ⟨hz.1 0, hz.2 0⟩
    have hz1 : z 1 ∈ Icc (zl 1) (zu 1) := ⟨hz.1 1, hz.2 1⟩
    have := g_J_2_lo_le (by linarith) h3 (by linarith) h4 hz0 hz1
    simp only [gJ2_fl]
    linarith

