/-- The rectangles of the tree are the rectangles of the box certificates. -/
theorem g1hTree_boxes : g1hTree.boxes (1 / 16 : ℚ) (1 / 4 : ℚ) (1 / 2 : ℚ) (3 / 4 : ℚ) =
    g1h_boxes_0 ++ (g1h_boxes_1 ++ (g1h_boxes_2 ++ (g1h_boxes_3 ++ (g1h_boxes_4)))) := by
  decide +kernel

/-- $\underline{g_{LJQ,1,\beta}}>10^{-7}$ on every rectangle of the partition. -/
theorem g1hTree_pos : ∀ p ∈ g1hTree.boxes (1 / 16 : ℚ) (1 / 4 : ℚ) (1 / 2 : ℚ) (3 / 4 : ℚ),
    0 < g1_fl (((1 / 2 : ℚ) : ℚ) : ℝ) (Box.toR p).1 (Box.toR p).2 := by
  rw [g1hTree_boxes]
  intro p hp
  simp only [List.mem_append] at hp
  rcases hp with h | h | h | h | h
  · exact g1h_boxes_0_pos p h
  · exact g1h_boxes_1_pos p h
  · exact g1h_boxes_2_pos p h
  · exact g1h_boxes_3_pos p h
  · exact g1h_boxes_4_pos p h

/-- **(6.13)** ([DIR], §6.3.1), computer-assisted, for $\beta=\frac12$:
$G_\beta[b_\beta](x,y)>10^{-7}$ on $[\frac1{16},\frac14]\times[\frac12,\frac34]$, by soundness
of partitioning (`Auto.DIR.pos_of_dtree`, [DIR] Fact 4.1) with the lower bound
$\underline{g_{LJQ,1,\beta}}$ (`Auto.DIR.g_LJQ_1_lo_le`) and the box certificates. -/
theorem g_LJQ_1_h_gt (x y : ℝ) (hx : x ∈ Icc (16⁻¹ : ℝ) 4⁻¹) (hy : y ∈ Icc (2⁻¹ : ℝ) (3 / 4)) :
    (1 : ℝ) / 10 ^ 7 < G ((1 / 2 : ℚ) : ℝ) (b ((1 / 2 : ℚ) : ℝ)) x y := by
  have hs : (2 : ℝ) ^ ((1 / 2 : ℚ) : ℝ) ≤ ((3 / 2 : ℚ) : ℝ) :=
    two_rpow_le_of_checkUpper (by decide +kernel)
  have h := pos_of_dtree g1hTree (1 / 16) (1 / 4) (1 / 2) (3 / 4) (by norm_num) (by norm_num)
    (fun z ↦ G ((1 / 2 : ℚ) : ℝ) (b ((1 / 2 : ℚ) : ℝ)) (z 0) (z 1) - 1 / 10 ^ 7)
    (g1_fl ((1 / 2 : ℚ) : ℝ)) ?_ g1hTree_pos ![x, y]
    (mem_Icc_toR.2 ⟨by norm_num; constructor <;> linarith [hx.1, hx.2],
      by norm_num; constructor <;> linarith [hy.1, hy.2]⟩)
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h
    push_cast at h
    linarith
  · intro zl zu hl hu z hz
    obtain ⟨⟨h1, h2⟩, h3, h4⟩ := le_toR_iff.1 ⟨hl, hu⟩
    norm_num at h1 h2 h3 h4
    have hz0 : z 0 ∈ Icc (zl 0) (zu 0) := ⟨hz.1 0, hz.2 0⟩
    have hz1 : z 1 ∈ Icc (zl 1) (zu 1) := ⟨hz.1 1, hz.2 1⟩
    have := g_LJQ_1_lo_le (by norm_num) (hs.trans (by norm_num)) (by linarith) (by linarith)
      (by linarith) (by linarith) hz0 hz1
    simp only [g1_fl]
    linarith

