open Real Set Checker

/-! ### Taylor expansion of $J$ -/

/-- $J$ is $C^n$ on every closed interval inside $(\frac12,1)$. -/
theorem contDiffOn_J_uIcc {a b : ℝ} (ha : a ∈ Ioo (2⁻¹ : ℝ) 1) (hb : b ∈ Ioo (2⁻¹ : ℝ) 1)
    (n : ℕ) : ContDiffOn ℝ n J (uIcc a b) :=
  (isJ_J.1.of_le (by exact_mod_cast le_top)).mono
    ((Set.OrdConnected.uIcc_subset (ordConnected_Ioo) ha hb))

/-- Taylor's theorem for $J$ with the Lagrange remainder of order $6$: for
$\frac12<x<x+h<1$ there is $\xi\in(x,x+h)$ with
$J(x+h)=\sum_{k<6}\frac{J^{(k)}(x)}{k!}h^k+\frac{J^{(6)}(\xi)}{6!}h^6$. -/
theorem J_taylor6 {x h : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) (hh : 0 < h) (hxh : x + h < 1) :
    ∃ ξ ∈ Ioo x (x + h), J (x + h) =
      ∑ k ∈ Finset.range 6, iteratedDeriv k J x * h ^ k / k.factorial +
        iteratedDeriv 6 J ξ * h ^ 6 / 720 := by
  have hxh' : x + h ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨by linarith [hx.1], hxh⟩
  have hne : x ≠ x + h := by linarith
  obtain ⟨ξ, hξ, e⟩ := taylor_mean_remainder_lagrange_iteratedDeriv (n := 5) hne
    (contDiffOn_J_uIcc hx hxh' 6)
  have hle : x ≤ x + h := by linarith
  rw [uIoo_of_le hle] at hξ
  refine ⟨ξ, hξ, ?_⟩
  rw [taylor_within_apply] at e
  have hu : UniqueDiffOn ℝ (uIcc x (x + h)) := uniqueDiffOn_Icc (by
    rw [inf_eq_left.2 hle, sup_eq_right.2 hle]; linarith)
  have hcd : ∀ k : ℕ, iteratedDerivWithin k J (uIcc x (x + h)) x = iteratedDeriv k J x := by
    intro k
    refine iteratedDerivWithin_eq_iteratedDeriv hu ?_ left_mem_uIcc
    exact (isJ_J.1.contDiffAt (Ioo_mem_nhds hx.1 hx.2)).of_le (by exact_mod_cast le_top)
  simp only [hcd, smul_eq_mul, add_sub_cancel_left] at e
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.factorial] at e ⊢
  push_cast at e ⊢
  linear_combination e

/-- $1-2^{-k+1}$ for $k=2,3,4,5$. -/
theorem one_sub_two_rpow (k : ℕ) (hk : 1 ≤ k) :
    (1 : ℝ) - 2 ^ (-(k : ℝ) + 1) = 1 - ((2 : ℝ) ^ (k - 1))⁻¹ := by
  rw [show -(k : ℝ) + 1 = -((k - 1 : ℕ) : ℝ) by push_cast [hk]; ring, rpow_neg two_pos.le,
    rpow_natCast]

/-- The Taylor remainder of $J(x)+J(x+h)-2J(x+\frac h2)$ of order $6$ ([DIR], §6.1.1):
$E_6=\frac1{6!}(J^{(6)}(\xi_1)-2^{-5}J^{(6)}(\xi_2))h^6$ with $\xi_1\in(x,x+h)$,
$\xi_2\in(x,x+\frac h2)$ (here for $\frac12<x<x+h<1$). -/
theorem E6_eq {x h : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) (hh : 0 < h) (hxh : x + h < 1) :
    ∃ ξ₁ ∈ Ioo x (x + h), ∃ ξ₂ ∈ Ioo x (x + h / 2),
      J x + J (x + h) - 2 * J (x + h / 2) -
        ∑ k ∈ Finset.Ico (2 : ℕ) 6, (k.factorial : ℝ)⁻¹ * (1 - 2 ^ (-(k : ℝ) + 1)) *
          iteratedDeriv k J x * h ^ k =
      (iteratedDeriv 6 J ξ₁ - iteratedDeriv 6 J ξ₂ / 32) * h ^ 6 / 720 := by
  obtain ⟨ξ₁, h₁, e₁⟩ := J_taylor6 hx hh hxh
  obtain ⟨ξ₂, h₂, e₂⟩ := J_taylor6 hx (half_pos hh) (by linarith)
  refine ⟨ξ₁, h₁, ξ₂, h₂, ?_⟩
  rw [e₁, e₂]
  simp only [Finset.sum_Ico_eq_sum_range, Finset.sum_range_succ, Finset.sum_range_zero,
    Nat.factorial, iteratedDeriv_zero]
  norm_num [one_sub_two_rpow]
  ring

/-! ### Interval enclosures of $J$ and $|J'|$ ((6.2) and the enclosures of $|J'|$) -/

/-- The lower enclosure $\underline J(a,b)=\min(J(a),J(b))$ ([DIR], (6.2)). -/
noncomputable def Jlo (a b : ℝ) : ℝ := min (J a) (J b)

/-- The upper enclosure $\overline J(a,b)$ ([DIR], (6.2)): $J(b)$ if $b<x_0$, $J(a)$ if
$a>x_0$, else $J(x_0)$. -/
noncomputable def Jhi (a b : ℝ) : ℝ := if b < x₀ then J b else if x₀ < a then J a else J x₀

/-- The upper enclosure $\overline{|J'|}(a,b)=\max(|J'(a)|,|J'(b)|)$ ([DIR], §6.1.1), with
$J'$ written as `DJr`. -/
noncomputable def aDJhi (a b : ℝ) : ℝ := max |DJr a| |DJr b|

/-- The lower enclosure $\underline{|J'|}(a,b)$ ([DIR], §6.1.1): $J'(b)$ if $b<x_0$, $-J'(a)$ if
$a>x_0$, else $0$ (with $J'$ written as `DJr`). -/
noncomputable def aDJlo (a b : ℝ) : ℝ := if b < x₀ then DJr b else if x₀ < a then -DJr a else 0

/-- `DJr` is decreasing on $(1-w_0,1)$. -/
theorem DJr_antitoneOn : AntitoneOn DJr (Ioo (1 - w₀) 1) := by
  intro a ha b hb hab
  have hw := w₀_pos
  have h1 : (1 - b) / w₀ ∈ Ioo (0 : ℝ) 1 := by
    rw [div_eq_inv_mul]; exact affine_mem_Ioo hw hb
  have h2 : (1 - a) / w₀ ∈ Ioo (0 : ℝ) 1 := by
    rw [div_eq_inv_mul]; exact affine_mem_Ioo hw ha
  unfold DJr
  have := gInv_strictMonoOn.monotoneOn h1 h2 (div_le_div_of_nonneg_right (by linarith) hw.le)
  have : (0 : ℝ) ≤ √2 := sqrt_nonneg 2
  nlinarith

/-- $J'(x_0)=0$ (as `DJr`). -/
theorem DJr_x₀ : DJr x₀ = 0 := by
  have hw := w₀_pos
  unfold DJr
  rw [x₀, show (1 - (1 - w₀ / 2)) / w₀ = 2⁻¹ by field_simp; ring, gInv_half, mul_zero]

/-- Points of $[\frac12,1)$ lie in $(1-w_0,1)$. -/
theorem mem_Ioo_one_sub_w₀' {t : ℝ} (h1 : 2⁻¹ ≤ t) (h2 : t < 1) : t ∈ Ioo (1 - w₀) 1 :=
  ⟨one_sub_w₀_lt_half.trans_le h1, h2⟩

/-- $\underline J(a,b)\le J(t)$ for $\frac12\le a\le t\le b\le1$. -/
theorem Jlo_le {a b t : ℝ} (ha : 2⁻¹ ≤ a) (hat : a ≤ t) (htb : t ≤ b) (hb : b ≤ 1) :
    Jlo a b ≤ J t := by
  have hx₀ := x₀_mem_Ioo
  unfold Jlo
  rcases le_total t x₀ with h | h
  · exact (min_le_left _ _).trans
      (J_monotoneOn_Icc_half_x₀ ⟨ha, hat.trans h⟩ ⟨ha.trans hat, h⟩ hat)
  · exact (min_le_right _ _).trans
      (J_antitoneOn_Icc_x₀_one ⟨h, htb.trans hb⟩ ⟨h.trans htb, hb⟩ htb)

/-- $J(t)\le J(x_0)$ for $t\in[\frac12,1]$. -/
theorem J_le_J_x₀ {t : ℝ} (h1 : 2⁻¹ ≤ t) (h2 : t ≤ 1) : J t ≤ J x₀ := by
  have hx₀ := x₀_mem_Ioo
  rcases le_total t x₀ with h | h
  · exact J_monotoneOn_Icc_half_x₀ ⟨h1, h⟩ ⟨hx₀.1.le, le_rfl⟩ h
  · exact J_antitoneOn_Icc_x₀_one ⟨le_rfl, hx₀.2.le⟩ ⟨h, h2⟩ h

/-- $J(t)\le\overline J(a,b)$ for $\frac12\le a\le t\le b\le1$. -/
theorem le_Jhi {a b t : ℝ} (ha : 2⁻¹ ≤ a) (hat : a ≤ t) (htb : t ≤ b) (hb : b ≤ 1) :
    J t ≤ Jhi a b := by
  have hx₀ := x₀_mem_Ioo
  unfold Jhi
  split_ifs with h1 h2
  · exact J_monotoneOn_Icc_half_x₀ ⟨ha.trans hat, htb.trans h1.le⟩ ⟨ha.trans (hat.trans htb), h1.le⟩
      htb
  · exact J_antitoneOn_Icc_x₀_one ⟨h2.le, hat.trans htb |>.trans hb⟩ ⟨h2.le.trans hat, htb.trans hb⟩
      hat
  · exact J_le_J_x₀ (ha.trans hat) (htb.trans hb)

/-- $|J'(t)|\le\overline{|J'|}(a,b)$ for $\frac12\le a\le t\le b<1$. -/
theorem abs_DJr_le_aDJhi {a b t : ℝ} (ha : 2⁻¹ ≤ a) (hat : a ≤ t) (htb : t ≤ b) (hb : b < 1) :
    |DJr t| ≤ aDJhi a b := by
  have h1 := DJr_antitoneOn (mem_Ioo_one_sub_w₀' ha (by linarith))
    (mem_Ioo_one_sub_w₀' (ha.trans hat) (by linarith)) hat
  have h2 := DJr_antitoneOn (mem_Ioo_one_sub_w₀' (ha.trans hat) (by linarith))
    (mem_Ioo_one_sub_w₀' (ha.trans (hat.trans htb)) hb) htb
  unfold aDJhi
  rcases le_total 0 (DJr t) with h | h
  · rw [abs_of_nonneg h]
    exact (h1.trans (le_abs_self _)).trans (le_max_left _ _)
  · rw [abs_of_nonpos h]
    exact (le_trans (by linarith) (neg_le_abs _)).trans (le_max_right _ _)

/-- $\underline{|J'|}(a,b)\le|J'(t)|$ for $\frac12\le a\le t\le b<1$. -/
theorem aDJlo_le {a b t : ℝ} (ha : 2⁻¹ ≤ a) (hat : a ≤ t) (htb : t ≤ b) (hb : b < 1) :
    aDJlo a b ≤ |DJr t| := by
  have hx₀ := x₀_mem_Ioo
  have hdom : ∀ s, 2⁻¹ ≤ s → s < 1 → s ∈ Ioo (1 - w₀) 1 := fun s h1 h2 ↦ mem_Ioo_one_sub_w₀' h1 h2
  unfold aDJlo
  split_ifs with h1 h2
  · have e1 := DJr_antitoneOn (hdom t (ha.trans hat) (by linarith)) (hdom b (by linarith) hb) htb
    have e2 := DJr_antitoneOn (hdom b (by linarith) hb) (hdom x₀ hx₀.1.le hx₀.2) h1.le
    rw [DJr_x₀] at e2
    exact e1.trans (le_abs_self _)
  · have e1 := DJr_antitoneOn (hdom a ha (by linarith)) (hdom t (ha.trans hat) (by linarith)) hat
    have e2 := DJr_antitoneOn (hdom x₀ hx₀.1.le hx₀.2) (hdom a ha (by linarith)) h2.le
    rw [DJr_x₀] at e2
    exact (neg_le_neg e1).trans (neg_le_abs _)
  · exact abs_nonneg _

/-- $\underline{|J'|}(a,b)\ge0$ for $\frac12\le a\le b<1$. -/
theorem aDJlo_nonneg {a b : ℝ} (ha : 2⁻¹ ≤ a) (hab : a ≤ b) (hb : b < 1) : 0 ≤ aDJlo a b := by
  have hx₀ := x₀_mem_Ioo
  have hdom : ∀ s, 2⁻¹ ≤ s → s < 1 → s ∈ Ioo (1 - w₀) 1 := fun s h1 h2 ↦ mem_Ioo_one_sub_w₀' h1 h2
  unfold aDJlo
  split_ifs with h1 h2
  · have := DJr_antitoneOn (hdom b (by linarith) hb) (hdom x₀ hx₀.1.le hx₀.2) h1.le
    rwa [DJr_x₀] at this
  · have := DJr_antitoneOn (hdom x₀ hx₀.1.le hx₀.2) (hdom a ha (by linarith)) h2.le
    rw [DJr_x₀] at this
    linarith
  · exact le_rfl

/-- $\underline J(a,b)>0$ for $a,b\in[\frac12,1)$. -/
theorem Jlo_pos {a b : ℝ} (ha : 2⁻¹ ≤ a) (ha' : a < 1) (hb : 2⁻¹ ≤ b) (hb' : b < 1) :
    0 < Jlo a b := lt_min (J_pos ⟨ha, ha'⟩) (J_pos ⟨hb, hb'⟩)

/-! ### The tight lower bound of $g_{J,1,\beta,c}$ -/

/-- The function $g_{J,1,\beta,c}(x,h)$ of [DIR], §6.1.1 with $N=6$, written out (definitionally
equal to `Auto.DIR.g_J_1 6 β c x h`). -/
noncomputable def gJ1expr (β c x h : ℝ) : ℝ :=
  β * c ^ (1 - β⁻¹) * J (x + h) ^ (1 - β⁻¹)
    - 2⁻¹ * β * (1 - β) * c ^ (1 - 2 / β) * J (x + h) ^ (1 - 2 / β) * h ^ β⁻¹
    + c * ∑ k ∈ Finset.Ico (2 : ℕ) 6, (k.factorial : ℝ)⁻¹ * (1 - 2 ^ (-(k : ℝ) + 1))
        * iteratedDeriv k J x * h ^ ((k : ℝ) - β⁻¹)
    + c * (J x + J (x + h) - 2 * J (x + h / 2) -
    ∑ k ∈ Finset.Ico (2 : ℕ) 6, (k.factorial : ℝ)⁻¹ * (1 - 2 ^ (-(k : ℝ) + 1)) * iteratedDeriv k J x
      * h ^ k) * h ^ (-β⁻¹)

/-- The paper's lower bound $\underline{g_{J,1,\beta,c}}(\underline x,\overline x,
\underline h,\overline h)$ ([DIR], §6.1.1), with $J'$ written as `DJr`. -/
noncomputable def gJ1lo (β c xl xu hl hu : ℝ) : ℝ :=
  β * c ^ (1 - β⁻¹) * Jhi (xl + hl) (xu + hu) ^ (1 - β⁻¹)
  - 2⁻¹ * β * (1 - β) * c ^ (1 - 2 / β) * Jlo (xl + hl) (xu + hu) ^ (1 - 2 / β) * hu ^ β⁻¹
  - c / 2 * (Jlo xl xu)⁻¹ * hu ^ ((2 : ℝ) - β⁻¹)
  + (if xu < x₀ then
      c * (4⁻¹ * DJr xu * ((J xu)⁻¹) ^ 2 * hl ^ ((3 : ℝ) - β⁻¹)
        + 32⁻¹ * DJr xu * (7 + 3 * DJr xu ^ 2) * ((J xu)⁻¹) ^ 4 * hl ^ ((5 : ℝ) - β⁻¹))
    else
      -(c * (4⁻¹ * aDJhi xl xu * ((Jlo xl xu)⁻¹) ^ 2 * hu ^ ((3 : ℝ) - β⁻¹)
        + 32⁻¹ * aDJhi xl xu * (7 + 3 * aDJhi xl xu ^ 2) * ((Jlo xl xu)⁻¹) ^ 4
          * hu ^ ((5 : ℝ) - β⁻¹))))
  - 7 * c / 48 * (1 + aDJhi xl xu ^ 2) * ((Jlo xl xu)⁻¹) ^ 3 * hu ^ ((4 : ℝ) - β⁻¹)
  - c / 90 * (7 + 23 * aDJhi xl (xu + hu) ^ 2 + 6 * aDJhi xl (xu + hu) ^ 4)
      * ((Jlo xl (xu + hu))⁻¹) ^ 5 * hu ^ ((6 : ℝ) - β⁻¹)
  + c / 2880 * (7 + 23 * aDJlo xl (xu + hu / 2) ^ 2 + 6 * aDJlo xl (xu + hu / 2) ^ 4)
      * ((Jhi xl (xu + hu / 2))⁻¹) ^ 5 * hl ^ ((6 : ℝ) - β⁻¹)

/-- Monotonicity of $h\mapsto h^r$ ($r\ge0$) on $[h_l,h_u]$, $h_l\ge0$. -/
theorem rpow_mem_of_mem {h hl hu r : ℝ} (hr : 0 ≤ r) (hhl : 0 ≤ hl) (hh : h ∈ Icc hl hu) :
    hl ^ r ≤ h ^ r ∧ h ^ r ≤ hu ^ r :=
  ⟨rpow_le_rpow hhl hh.1 hr, rpow_le_rpow (hhl.trans hh.1) hh.2 hr⟩

/-- Products of three nonnegative factors are monotone. -/
theorem mul3_le {a b c a' b' c' : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (h1 : a ≤ a')
    (h2 : b ≤ b') (h3 : c ≤ c') : a * b * c ≤ a' * b' * c' :=
  mul_le_mul (mul_le_mul h1 h2 hb (ha.trans h1)) h3 hc
    (mul_nonneg (ha.trans h1) (hb.trans h2))

/-- The sum of the Taylor terms $k=2,\dots,5$ of $g_{J,1,\beta,c}$, written with
$J^{(k)}=$ the formulas of [DIR], §6.1.1. -/
theorem gJ1_sum_eq {β x h : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) :
    ∑ k ∈ Finset.Ico (2 : ℕ) 6, (k.factorial : ℝ)⁻¹ * (1 - 2 ^ (-(k : ℝ) + 1))
        * iteratedDeriv k J x * h ^ ((k : ℝ) - β⁻¹) =
      -(2⁻¹ * (J x)⁻¹ * h ^ ((2 : ℝ) - β⁻¹))
      + 4⁻¹ * DJr x * ((J x)⁻¹) ^ 2 * h ^ ((3 : ℝ) - β⁻¹)
      - 7 / 48 * (1 + DJr x ^ 2) * ((J x)⁻¹) ^ 3 * h ^ ((4 : ℝ) - β⁻¹)
      + 32⁻¹ * DJr x * (7 + 3 * DJr x ^ 2) * ((J x)⁻¹) ^ 4 * h ^ ((5 : ℝ) - β⁻¹) := by
  simp only [Finset.sum_Ico_eq_sum_range, Finset.sum_range_succ, Finset.sum_range_zero]
  rw [(iteratedDeriv_two_J_eventuallyEq hx).eq_of_nhds,
    (iteratedDeriv_three_J_eventuallyEq hx).eq_of_nhds,
    (iteratedDeriv_four_J_eventuallyEq hx).eq_of_nhds,
    (iteratedDeriv_five_J_eventuallyEq hx).eq_of_nhds, deriv_J_eq hx]
  norm_num [one_sub_two_rpow, Nat.factorial]
  ring

/-- If $|t|\le B$ then $-B\le t$. -/
theorem neg_le_of_abs_le' {t B : ℝ} (h : |t| ≤ B) : -B ≤ t := (neg_le_neg h).trans (neg_abs_le t)

/-- $|t|^4=t^4$. -/
theorem abs_pow_four (t : ℝ) : |t| ^ 4 = t ^ 4 := by
  rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, sq_abs, ← pow_mul]

/-- The polynomial $7+23t^2+6t^4$ is increasing in $|t|$. -/
theorem poly6_mono {s t : ℝ} (hs : 0 ≤ s) (h : s ≤ t) :
    7 + 23 * s ^ 2 + 6 * s ^ 4 ≤ 7 + 23 * t ^ 2 + 6 * t ^ 4 := by
  have h2 : s ^ 2 ≤ t ^ 2 := pow_le_pow_left₀ hs h 2
  have h4 : s ^ 4 ≤ t ^ 4 := pow_le_pow_left₀ hs h 4
  linarith

/-- $J^{(6)}(\xi)=-8(7+23J'(\xi)^2+6J'(\xi)^4)J(\xi)^{-5}$ (with $J'$ as `DJr`). -/
theorem iteratedDeriv_six_J_eq {ξ : ℝ} (hξ : ξ ∈ Ioo (2⁻¹ : ℝ) 1) :
    iteratedDeriv 6 J ξ = -8 * (7 + 23 * DJr ξ ^ 2 + 6 * DJr ξ ^ 4) * ((J ξ)⁻¹) ^ 5 := by
  rw [(iteratedDeriv_six_J_eventuallyEq hξ).eq_of_nhds, deriv_J_eq hξ]

set_option maxHeartbeats 2000000 in
/-- **The lower-bound property of $\underline{g_{J,1,\beta,c}}$** ([DIR], §6.1.1): for
$\beta\in[\frac12,1)$, $c>0$, $\frac12\le x_l\le x\le x_u\le\frac58$ with $x>\frac12$, and
$0\le h_l\le h\le h_u\le\frac3{16}$:
$\underline{g_{J,1,\beta,c}}(x_l,x_u,h_l,h_u)\le g_{J,1,\beta,c}(x,h)$. (Only the lower-bound
property; see `automation/ErrorReport.md`.) -/
theorem gJ1lo_le {β c xl xu hl hu x h : ℝ} (hβ : β ∈ Ico (2⁻¹ : ℝ) 1) (hc : 0 < c)
    (hxl : 2⁻¹ ≤ xl) (hxu : xu ≤ 5 / 8) (hhl : 0 ≤ hl) (hhu : hu ≤ 3 / 16)
    (hx : x ∈ Icc xl xu) (hx' : 2⁻¹ < x) (hh : h ∈ Icc hl hu) :
    gJ1lo β c xl xu hl hu ≤ gJ1expr β c x h := by
  have hβ0 : 0 < β := by linarith [hβ.1]
  have hbi : 0 < β⁻¹ := inv_pos.2 hβ0
  have hbi1 : 1 ≤ β⁻¹ := by rw [le_inv_comm₀ one_pos hβ0, inv_one]; exact hβ.2.le
  have hbi2 : β⁻¹ ≤ 2 := by
    rw [inv_le_comm₀ hβ0 two_pos]; linarith [hβ.1]
  have he1 : 1 - β⁻¹ ≤ 0 := by linarith
  have he2 : 1 - 2 / β ≤ 0 := by rw [div_eq_mul_inv]; linarith
  have hr : ∀ k : ℝ, 2 ≤ k → 0 ≤ k - β⁻¹ := fun k hk ↦ by linarith
  have h0h : 0 ≤ h := hhl.trans hh.1
  have hx1 := hx.1
  have hx2 := hx.2
  have hh1 := hh.1
  have hh2 := hh.2
  have hxI : x ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨hx', by linarith [hx.2]⟩
  have hxh1 : x + h < 1 := by linarith [hx.2, hh.2]
  have hJx := J_pos ⟨hxI.1.le, hxI.2⟩
  have hJxh := J_pos ⟨by linarith [hxI.1], hxh1⟩
  have hdx : |DJr x| ≤ aDJhi xl xu := abs_DJr_le_aDJhi hxl hx.1 hx.2 (by linarith)
  have hJlo0 : 0 < Jlo xl xu := Jlo_pos hxl (by linarith) (by linarith [hx.1, hx.2]) (by linarith)
  have hJxlo : (J x)⁻¹ ≤ (Jlo xl xu)⁻¹ := inv_anti₀ hJlo0 (Jlo_le hxl hx.1 hx.2 (by linarith))
  have hJxi : 0 ≤ (J x)⁻¹ := (inv_pos.2 hJx).le
  -- the remainder term
  have hE : -(c / 90 * (7 + 23 * aDJhi xl (xu + hu) ^ 2 + 6 * aDJhi xl (xu + hu) ^ 4)
        * ((Jlo xl (xu + hu))⁻¹) ^ 5 * hu ^ ((6 : ℝ) - β⁻¹))
      + c / 2880 * (7 + 23 * aDJlo xl (xu + hu / 2) ^ 2 + 6 * aDJlo xl (xu + hu / 2) ^ 4)
        * ((Jhi xl (xu + hu / 2))⁻¹) ^ 5 * hl ^ ((6 : ℝ) - β⁻¹) ≤
      c * (J x + J (x + h) - 2 * J (x + h / 2) -
        ∑ k ∈ Finset.Ico (2 : ℕ) 6, (k.factorial : ℝ)⁻¹ * (1 - 2 ^ (-(k : ℝ) + 1)) *
          iteratedDeriv k J x * h ^ k) * h ^ (-β⁻¹) := by
    have hlo6 : 0 < Jlo xl (xu + hu) := Jlo_pos hxl (by linarith) (by linarith [hx.1, hx.2])
      (by linarith)
    have hP1 : 0 ≤ c / 90 * (7 + 23 * aDJhi xl (xu + hu) ^ 2 + 6 * aDJhi xl (xu + hu) ^ 4)
        * ((Jlo xl (xu + hu))⁻¹) ^ 5 * hu ^ ((6 : ℝ) - β⁻¹) := by
      have := (inv_pos.2 hlo6).le
      have := rpow_nonneg (h0h.trans hh.2) ((6 : ℝ) - β⁻¹)
      positivity
    rcases h0h.eq_or_lt with h0 | hpos
    · subst h0
      have hl0 : hl = 0 := le_antisymm hh.1 hhl
      subst hl0
      rw [zero_rpow (by linarith : (6 : ℝ) - β⁻¹ ≠ 0), zero_rpow (by linarith : -β⁻¹ ≠ 0)]
      simp only [mul_zero, add_zero]
      linarith
    · obtain ⟨ξ₁, h₁, ξ₂, h₂, e⟩ := E6_eq hxI hpos hxh1
      rw [e]
      have hξ₁ : ξ₁ ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨by linarith [h₁.1, hxI.1], by linarith [h₁.2]⟩
      have hξ₂ : ξ₂ ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨by linarith [h₂.1, hxI.1], by linarith [h₂.2]⟩
      rw [iteratedDeriv_six_J_eq hξ₁, iteratedDeriv_six_J_eq hξ₂]
      have hh6 : h ^ 6 * h ^ (-β⁻¹) = h ^ ((6 : ℝ) - β⁻¹) := by
        rw [← rpow_natCast, ← rpow_add hpos]; norm_num; ring_nf
      have hJ1 := J_pos ⟨hξ₁.1.le, hξ₁.2⟩
      have hJ2 := J_pos ⟨hξ₂.1.le, hξ₂.2⟩
      -- first part
      have hd1 : |DJr ξ₁| ≤ aDJhi xl (xu + hu) := abs_DJr_le_aDJhi hxl
        (by linarith [h₁.1, hx.1]) (by linarith [h₁.2, hx.2, hh.2]) (by linarith)
      have hq1 : 7 + 23 * DJr ξ₁ ^ 2 + 6 * DJr ξ₁ ^ 4 ≤
          7 + 23 * aDJhi xl (xu + hu) ^ 2 + 6 * aDJhi xl (xu + hu) ^ 4 := by
        have := poly6_mono (abs_nonneg _) hd1
        simpa only [sq_abs, abs_pow_four] using this
      have hi1 : (J ξ₁)⁻¹ ≤ (Jlo xl (xu + hu))⁻¹ := inv_anti₀ hlo6
        (Jlo_le hxl (by linarith [h₁.1, hx.1]) (by linarith [h₁.2, hx.2, hh.2]) (by linarith))
      have hJ1i : 0 ≤ (J ξ₁)⁻¹ := (inv_pos.2 hJ1).le
      have hp1 := mul3_le (by positivity) (pow_nonneg hJ1i 5) (rpow_nonneg h0h _) hq1
        (pow_le_pow_left₀ hJ1i hi1 5) (rpow_mem_of_mem (hr 6 (by norm_num)) hhl hh).2
      -- second part
      have hb0 : 0 ≤ aDJlo xl (xu + hu / 2) := aDJlo_nonneg hxl (by linarith [hx.1, hx.2])
        (by linarith)
      have hd2 : aDJlo xl (xu + hu / 2) ≤ |DJr ξ₂| := aDJlo_le hxl
        (by linarith [h₂.1, hx.1]) (by linarith [h₂.2, hx.2, hh.2]) (by linarith)
      have hq2 : 7 + 23 * aDJlo xl (xu + hu / 2) ^ 2 + 6 * aDJlo xl (xu + hu / 2) ^ 4 ≤
          7 + 23 * DJr ξ₂ ^ 2 + 6 * DJr ξ₂ ^ 4 := by
        have := poly6_mono hb0 hd2
        simpa only [sq_abs, abs_pow_four] using this
      have hi2 : (Jhi xl (xu + hu / 2))⁻¹ ≤ (J ξ₂)⁻¹ := inv_anti₀ hJ2
        (le_Jhi hxl (by linarith [h₂.1, hx.1]) (by linarith [h₂.2, hx.2, hh.2]) (by linarith))
      have hJhi : 0 ≤ (Jhi xl (xu + hu / 2))⁻¹ := by
        have : 0 < Jhi xl (xu + hu / 2) := hJ2.trans_le (le_Jhi hxl (by linarith [h₂.1, hx.1])
          (by linarith [h₂.2, hx.2, hh.2]) (by linarith))
        exact (inv_pos.2 this).le
      have hp2 := mul3_le (by positivity) (pow_nonneg hJhi 5) (rpow_nonneg hhl _) hq2
        (pow_le_pow_left₀ hJhi hi2 5) (rpow_mem_of_mem (hr 6 (by norm_num)) hhl hh).1
      have key : c * ((-8 * (7 + 23 * DJr ξ₁ ^ 2 + 6 * DJr ξ₁ ^ 4) * ((J ξ₁)⁻¹) ^ 5 -
          -8 * (7 + 23 * DJr ξ₂ ^ 2 + 6 * DJr ξ₂ ^ 4) * ((J ξ₂)⁻¹) ^ 5 / 32) * h ^ 6 / 720) *
          h ^ (-β⁻¹) =
          -(c / 90 * ((7 + 23 * DJr ξ₁ ^ 2 + 6 * DJr ξ₁ ^ 4) * ((J ξ₁)⁻¹) ^ 5 *
            h ^ ((6 : ℝ) - β⁻¹))) +
          c / 2880 * ((7 + 23 * DJr ξ₂ ^ 2 + 6 * DJr ξ₂ ^ 4) * ((J ξ₂)⁻¹) ^ 5 *
            h ^ ((6 : ℝ) - β⁻¹)) := by
        rw [← hh6]; ring
      rw [key]
      have hc90 : 0 ≤ c / 90 := by positivity
      have hc2880 : 0 ≤ c / 2880 := by positivity
      have := mul_le_mul_of_nonneg_left hp1 hc90
      have := mul_le_mul_of_nonneg_left hp2 hc2880
      linarith
  -- the term with J(x+h)^(1-1/β)
  have hT1 : β * c ^ (1 - β⁻¹) * Jhi (xl + hl) (xu + hu) ^ (1 - β⁻¹) ≤
      β * c ^ (1 - β⁻¹) * J (x + h) ^ (1 - β⁻¹) := by
    refine mul_le_mul_of_nonneg_left ?_ (mul_nonneg hβ0.le (rpow_nonneg hc.le _))
    exact rpow_le_rpow_of_nonpos hJxh (le_Jhi (by linarith) (by linarith [hx.1, hh.1])
      (by linarith [hx.2, hh.2]) (by linarith)) he1
  -- the term with J(x+h)^(1-2/β)
  have hT2 : 2⁻¹ * β * (1 - β) * c ^ (1 - 2 / β) * J (x + h) ^ (1 - 2 / β) * h ^ β⁻¹ ≤
      2⁻¹ * β * (1 - β) * c ^ (1 - 2 / β) * Jlo (xl + hl) (xu + hu) ^ (1 - 2 / β) *
        hu ^ β⁻¹ := by
    have hK : 0 ≤ 2⁻¹ * β * (1 - β) * c ^ (1 - 2 / β) :=
      mul_nonneg (mul_nonneg (by positivity) (by linarith [hβ.2])) (rpow_nonneg hc.le _)
    have hlo : 0 < Jlo (xl + hl) (xu + hu) := Jlo_pos (by linarith) (by linarith)
      (by linarith [hx.1, hx.2]) (by linarith)
    have h1 := rpow_le_rpow_of_nonpos hlo (Jlo_le (t := x + h) (by linarith) (by linarith [hx.1, hh.1])
      (by linarith [hx.2, hh.2]) (by linarith)) he2
    have h2 := (rpow_mem_of_mem hbi.le hhl hh).2
    rw [mul_assoc _ (J (x + h) ^ _), mul_assoc _ (Jlo _ _ ^ _)]
    exact mul_le_mul_of_nonneg_left (mul_le_mul h1 h2 (rpow_nonneg h0h _)
      (rpow_nonneg hlo.le _)) hK
  -- k = 2
  have hS2 : 2⁻¹ * (J x)⁻¹ * h ^ ((2 : ℝ) - β⁻¹) ≤
      2⁻¹ * (Jlo xl xu)⁻¹ * hu ^ ((2 : ℝ) - β⁻¹) := by
    have := (rpow_mem_of_mem (hr 2 le_rfl) hhl hh).2
    rw [mul_assoc, mul_assoc]
    exact mul_le_mul_of_nonneg_left (mul_le_mul hJxlo this (rpow_nonneg h0h _)
      (hJxi.trans hJxlo)) (by norm_num)
  -- k = 4
  have hS4 : 7 / 48 * (1 + DJr x ^ 2) * ((J x)⁻¹) ^ 3 * h ^ ((4 : ℝ) - β⁻¹) ≤
      7 / 48 * (1 + aDJhi xl xu ^ 2) * ((Jlo xl xu)⁻¹) ^ 3 * hu ^ ((4 : ℝ) - β⁻¹) := by
    have hd2 : DJr x ^ 2 ≤ aDJhi xl xu ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hdx 2
    have := mul3_le (by positivity) (pow_nonneg hJxi 3) (rpow_nonneg h0h _)
      (show 1 + DJr x ^ 2 ≤ 1 + aDJhi xl xu ^ 2 by linarith) (pow_le_pow_left₀ hJxi hJxlo 3)
      (rpow_mem_of_mem (hr 4 (by norm_num)) hhl hh).2
    rw [mul_assoc (7 / 48 : ℝ), mul_assoc (7 / 48 : ℝ), mul_assoc (7 / 48 : ℝ),
      mul_assoc (7 / 48 : ℝ)]
    refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
    simpa only [mul_assoc] using this
  -- k = 3, 5
  have hS35 : (if xu < x₀ then
      c * (4⁻¹ * DJr xu * ((J xu)⁻¹) ^ 2 * hl ^ ((3 : ℝ) - β⁻¹)
        + 32⁻¹ * DJr xu * (7 + 3 * DJr xu ^ 2) * ((J xu)⁻¹) ^ 4 * hl ^ ((5 : ℝ) - β⁻¹))
    else
      -(c * (4⁻¹ * aDJhi xl xu * ((Jlo xl xu)⁻¹) ^ 2 * hu ^ ((3 : ℝ) - β⁻¹)
        + 32⁻¹ * aDJhi xl xu * (7 + 3 * aDJhi xl xu ^ 2) * ((Jlo xl xu)⁻¹) ^ 4
          * hu ^ ((5 : ℝ) - β⁻¹)))) ≤
      c * (4⁻¹ * DJr x * ((J x)⁻¹) ^ 2 * h ^ ((3 : ℝ) - β⁻¹)
        + 32⁻¹ * DJr x * (7 + 3 * DJr x ^ 2) * ((J x)⁻¹) ^ 4 * h ^ ((5 : ℝ) - β⁻¹)) := by
    split_ifs with hx0
    · refine mul_le_mul_of_nonneg_left ?_ hc.le
      have hx₀ := x₀_mem_Ioo
      have hdom : ∀ s, 2⁻¹ ≤ s → s < 1 → s ∈ Ioo (1 - w₀) 1 :=
        fun s h1 h2 ↦ mem_Ioo_one_sub_w₀' h1 h2
      have hDx : DJr xu ≤ DJr x :=
        DJr_antitoneOn (hdom x hxI.1.le hxI.2) (hdom xu (by linarith [hx.1]) (by linarith)) hx.2
      have hDu : 0 ≤ DJr xu := by
        have := DJr_antitoneOn (hdom xu (by linarith [hx.1]) (by linarith))
          (hdom x₀ hx₀.1.le hx₀.2) hx0.le
        rwa [DJr_x₀] at this
      have hJu := J_pos ⟨(by linarith [hx.1] : 2⁻¹ ≤ xu), (by linarith : xu < 1)⟩
      have hJle : J x ≤ J xu := J_monotoneOn_Icc_half_x₀ ⟨hxI.1.le, by linarith [hx.2]⟩
        ⟨by linarith [hx.1], hx0.le⟩ hx.2
      have hinv : (J xu)⁻¹ ≤ (J x)⁻¹ := inv_anti₀ hJx hJle
      have hJui : 0 ≤ (J xu)⁻¹ := (inv_pos.2 hJu).le
      have h3 := mul3_le hDu (pow_nonneg hJui 2) (rpow_nonneg hhl _) hDx
        (pow_le_pow_left₀ hJui hinv 2) (rpow_mem_of_mem (hr 3 (by norm_num)) hhl hh).1
      have hP : DJr xu * (7 + 3 * DJr xu ^ 2) ≤ DJr x * (7 + 3 * DJr x ^ 2) := by
        have := pow_le_pow_left₀ hDu hDx 2
        exact mul_le_mul hDx (by linarith) (by positivity) (hDu.trans hDx)
      have h5 := mul3_le (by positivity) (pow_nonneg hJui 4) (rpow_nonneg hhl _) hP
        (pow_le_pow_left₀ hJui hinv 4) (rpow_mem_of_mem (hr 5 (by norm_num)) hhl hh).1
      have e3 : ∀ a b d : ℝ, 4⁻¹ * a * b * d = 4⁻¹ * (a * b * d) := fun a b d ↦ by ring
      have e5 : ∀ a b d f : ℝ, 32⁻¹ * a * b * d * f = 32⁻¹ * (a * b * d * f) := fun a b d f ↦ by
        ring
      rw [e3, e3, e5, e5]
      have : DJr xu * (7 + 3 * DJr xu ^ 2) * ((J xu)⁻¹) ^ 4 * hl ^ ((5 : ℝ) - β⁻¹) ≤
          DJr x * (7 + 3 * DJr x ^ 2) * ((J x)⁻¹) ^ 4 * h ^ ((5 : ℝ) - β⁻¹) := by
        simpa only [mul_assoc] using h5
      linarith
    · have hA0 : 0 ≤ aDJhi xl xu := (abs_nonneg _).trans hdx
      have h3 : abs (4⁻¹ * DJr x * ((J x)⁻¹) ^ 2 * h ^ ((3 : ℝ) - β⁻¹)) ≤
          4⁻¹ * aDJhi xl xu * ((Jlo xl xu)⁻¹) ^ 2 * hu ^ ((3 : ℝ) - β⁻¹) := by
        rw [abs_mul, abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 4⁻¹),
          abs_of_nonneg (pow_nonneg hJxi 2), abs_of_nonneg (rpow_nonneg h0h _)]
        have := mul3_le (abs_nonneg _) (pow_nonneg hJxi 2) (rpow_nonneg h0h _) hdx
          (pow_le_pow_left₀ hJxi hJxlo 2) (rpow_mem_of_mem (hr 3 (by norm_num)) hhl hh).2
        nlinarith
      have h5 : abs (32⁻¹ * DJr x * (7 + 3 * DJr x ^ 2) * ((J x)⁻¹) ^ 4 * h ^ ((5 : ℝ) - β⁻¹)) ≤
          32⁻¹ * aDJhi xl xu * (7 + 3 * aDJhi xl xu ^ 2) * ((Jlo xl xu)⁻¹) ^ 4
            * hu ^ ((5 : ℝ) - β⁻¹) := by
        have hP : abs (DJr x * (7 + 3 * DJr x ^ 2)) ≤ aDJhi xl xu * (7 + 3 * aDJhi xl xu ^ 2) := by
          rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 7 + 3 * DJr x ^ 2)]
          have : DJr x ^ 2 ≤ aDJhi xl xu ^ 2 := by
            rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hdx 2
          exact mul_le_mul hdx (by linarith) (by positivity) hA0
        have := mul3_le (abs_nonneg _) (pow_nonneg hJxi 4) (rpow_nonneg h0h _) hP
          (pow_le_pow_left₀ hJxi hJxlo 4) (rpow_mem_of_mem (hr 5 (by norm_num)) hhl hh).2
        have e : 32⁻¹ * DJr x * (7 + 3 * DJr x ^ 2) * ((J x)⁻¹) ^ 4 * h ^ ((5 : ℝ) - β⁻¹) =
            32⁻¹ * ((DJr x * (7 + 3 * DJr x ^ 2)) * ((J x)⁻¹) ^ 4 * h ^ ((5 : ℝ) - β⁻¹)) := by
          ring
        rw [e, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 32⁻¹), abs_mul, abs_mul,
          abs_of_nonneg (pow_nonneg hJxi 4), abs_of_nonneg (rpow_nonneg h0h _)]
        nlinarith
      have h3' := neg_le_of_abs_le' h3
      have h5' := neg_le_of_abs_le' h5
      have := mul_le_mul_of_nonneg_left (add_le_add h3' h5') hc.le
      linarith
  -- assemble
  have hsum := gJ1_sum_eq (β := β) (h := h) hxI
  have hS2' := mul_le_mul_of_nonneg_left hS2 hc.le
  have hS4' := mul_le_mul_of_nonneg_left hS4 hc.le
  unfold gJ1expr gJ1lo
  rw [hsum]
  linarith

/-! ### The box certificate for (6.3) -/

/-- The certified enclosure $x_0\in[1-\frac{w_u}2,1-\frac{w_l}2]$ (from `hw11`). -/
noncomputable def x0Cert : Cert where
  l := 1 - P11.wu / 2
  u := 1 - P11.wl / 2
  v := x₀
  h := by
    have h := hw11
    simp only [P11] at h ⊢
    push_cast at h ⊢
    rw [x₀]
    constructor <;> linarith [h.1, h.2]

/-- `Jhi` as an expression of the checker: variables `ia`, `ib` stand for $J(a)$, $J(b)$, the
variable `9` for $x_0$. -/
def JhiE (a b : ℚ) (ia ib : Ex) : Ex :=
  .ite_lt (.const b) (.var 9) ib (.ite_lt (.var 9) (.const a) ia .Jx0)

/-- `aDJlo` as an expression of the checker: variables `ia`, `ib` stand for $J'(a)$, $J'(b)$,
the variable `9` for $x_0$. -/
def aDJloE (a b : ℚ) (ia ib : Ex) : Ex :=
  .ite_lt (.const b) (.var 9) ib (.ite_lt (.var 9) (.const a) (.neg ia) (.const 0))

/-- `aDJhi` as an expression of the checker. -/
def aDJhiE (ia ib : Ex) : Ex := .max (.abs ia) (.abs ib)

/-- The reciprocal as an expression of the checker. -/
def invE (e : Ex) : Ex := .div (.const 1) e

/-- The expression of the checker for $\underline{g_{J,1,\beta,c}}(x_l,x_u,h_l,h_u)$.
Variables: `0` $J(x_u)$, `1` $J'(x_u)$, `2` $J(x_l)$, `3` $J'(x_l)$, `4` $J(x_l+h_l)$,
`5` $J(x_u+h_u)$, `6` $J'(x_u+h_u)$, `7` $J(x_u+\frac{h_u}2)$, `8` $J'(x_u+\frac{h_u}2)$,
`9` $x_0$, `10` $h_u^{1/\beta}$, `11` $h_u^{2-1/\beta}$, `12` $h_l^{3-1/\beta}$,
`13` $h_u^{3-1/\beta}$, `14` $h_u^{4-1/\beta}$, `15` $h_l^{5-1/\beta}$, `16` $h_u^{5-1/\beta}$,
`17` $h_u^{6-1/\beta}$, `18` $h_l^{6-1/\beta}$, `19` $c^{1-1/\beta}$, `20` $c^{1-2/\beta}$. -/
def gJ1Ex (β c xl xu hl hu : ℚ) : Ex :=
  let Jlo0 : Ex := .min (.var 2) (.var 0)
  let A0 : Ex := aDJhiE (.var 3) (.var 1)
  let A6 : Ex := aDJhiE (.var 3) (.var 6)
  let B6 : Ex := aDJloE xl (xu + hu / 2) (.var 3) (.var 8)
  .add (.sub (.sub (.add (.sub (.sub
    (.mul (.mul (.const β) (.var 19))
      (.rpow (JhiE (xl + hl) (xu + hu) (.var 4) (.var 5)) (1 - β⁻¹)))
    (.mul (.mul (.mul (.const (2⁻¹ * β * (1 - β))) (.var 20))
      (.rpow (.min (.var 4) (.var 5)) (1 - 2 / β))) (.var 10)))
    (.mul (.mul (.const (c / 2)) (invE Jlo0)) (.var 11)))
    (.ite_lt (.const xu) (.var 9)
      (.mul (.const c) (.add
        (.mul (.mul (.mul (.const 4⁻¹) (.var 1)) (.npow (invE (.var 0)) 2)) (.var 12))
        (.mul (.mul (.mul (.mul (.const 32⁻¹) (.var 1))
          (.add (.const 7) (.mul (.const 3) (.npow (.var 1) 2))))
          (.npow (invE (.var 0)) 4)) (.var 15))))
      (.neg (.mul (.const c) (.add
        (.mul (.mul (.mul (.const 4⁻¹) A0) (.npow (invE Jlo0) 2)) (.var 13))
        (.mul (.mul (.mul (.mul (.const 32⁻¹) A0)
          (.add (.const 7) (.mul (.const 3) (.npow A0 2))))
          (.npow (invE Jlo0) 4)) (.var 16)))))))
    (.mul (.mul (.mul (.const (7 * c / 48)) (.add (.const 1) (.npow A0 2)))
      (.npow (invE Jlo0) 3)) (.var 14)))
    (.mul (.mul (.mul (.const (c / 90))
      (.add (.add (.const 7) (.mul (.const 23) (.npow A6 2))) (.mul (.const 6) (.npow A6 4))))
      (.npow (invE (.min (.var 2) (.var 5))) 5)) (.var 17)))
    (.mul (.mul (.mul (.const (c / 2880))
      (.add (.add (.const 7) (.mul (.const 23) (.npow B6 2))) (.mul (.const 6) (.npow B6 4))))
      (.npow (invE (JhiE xl (xu + hu / 2) (.var 2) (.var 7))) 5)) (.var 18))

/-- The real meaning of `gJ1Ex`: if the variables have the values listed at `gJ1Ex`, then
`gJ1Ex` denotes $\underline{g_{J,1,\beta,c}}(x_l,x_u,h_l,h_u)$. -/
theorem denote_gJ1Ex (β c xl xu hl hu : ℚ) (ρ : ℕ → ℝ) (h0 : ρ 0 = J xu) (h1 : ρ 1 = DJr xu)
    (h2 : ρ 2 = J xl) (h3 : ρ 3 = DJr xl) (h4 : ρ 4 = J ((xl + hl : ℚ) : ℝ))
    (h5 : ρ 5 = J ((xu + hu : ℚ) : ℝ)) (h6 : ρ 6 = DJr ((xu + hu : ℚ) : ℝ))
    (h7 : ρ 7 = J ((xu + hu / 2 : ℚ) : ℝ)) (h8 : ρ 8 = DJr ((xu + hu / 2 : ℚ) : ℝ))
    (h9 : ρ 9 = x₀) (h10 : ρ 10 = (hu : ℝ) ^ ((β⁻¹ : ℚ) : ℝ))
    (h11 : ρ 11 = (hu : ℝ) ^ ((2 - β⁻¹ : ℚ) : ℝ)) (h12 : ρ 12 = (hl : ℝ) ^ ((3 - β⁻¹ : ℚ) : ℝ))
    (h13 : ρ 13 = (hu : ℝ) ^ ((3 - β⁻¹ : ℚ) : ℝ)) (h14 : ρ 14 = (hu : ℝ) ^ ((4 - β⁻¹ : ℚ) : ℝ))
    (h15 : ρ 15 = (hl : ℝ) ^ ((5 - β⁻¹ : ℚ) : ℝ)) (h16 : ρ 16 = (hu : ℝ) ^ ((5 - β⁻¹ : ℚ) : ℝ))
    (h17 : ρ 17 = (hu : ℝ) ^ ((6 - β⁻¹ : ℚ) : ℝ)) (h18 : ρ 18 = (hl : ℝ) ^ ((6 - β⁻¹ : ℚ) : ℝ))
    (h19 : ρ 19 = (c : ℝ) ^ ((1 - β⁻¹ : ℚ) : ℝ)) (h20 : ρ 20 = (c : ℝ) ^ ((1 - 2 / β : ℚ) : ℝ)) :
    denote ρ (gJ1Ex β c xl xu hl hu) = gJ1lo β c xl xu hl hu := by
  simp only [gJ1Ex, JhiE, aDJloE, aDJhiE, invE, denote, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9,
    h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20]
  simp only [gJ1lo, Jhi, Jlo, aDJhi, aDJlo]
  push_cast
  ring_nf

/-- $\underline{g_{J,1,\beta,c}}-10^{-7}$ as a function of the corners of a rectangle in
$\mathbb R^2$ (coordinates $(x,h)$; the function $\underline f$ of [DIR], §4.1 for (6.3)). -/
noncomputable def gJ1_fl (β c : ℚ) (zl zu : Fin 2 → ℝ) : ℝ :=
  gJ1lo β c (zl 0) (zu 0) (zl 1) (zu 1) - 1 / 10 ^ 7

/-- A certified enclosure $l\le$ `DJr x` $\le u$ at a rational point $x$ (here also $x=\frac12$,
where `DJr` is the one-sided derivative of $J$). -/
structure DJrVal where
  /-- The point. -/
  x : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The enclosure. -/
  h : (l : ℝ) ≤ DJr x ∧ DJr x ≤ u

/-- A `DJrVal` from a kernel-checked enclosure by the node `DJ x zl zu`. -/
def DJrVal.mk' (x l u zl zu : ℚ) (h : checkMem P11 [] (.DJ x zl zu) l u = true) : DJrVal where
  x := x
  l := l
  u := u
  h := checkMem_sound P11 hw11 [] (.DJ x zl zu) l u h

/-- A `DJrVal` as an entry of the environment of the checker. -/
noncomputable def DJrVal.cert (j : DJrVal) : Cert := ⟨j.l, j.u, DJr j.x, j.h⟩

/-- The table entries of a box certificate for (6.3): values of $J$, $J'$ at the points of the
rectangle and the powers $h^r$, $c^r$ (see `gJ1Ex`). -/
structure GJ1Tab where
  /-- $J(x_u)$. -/
  j0 : JVal
  /-- $J'(x_u)$. -/
  d0 : DJrVal
  /-- $J(x_l)$. -/
  j2 : JVal
  /-- $J'(x_l)$. -/
  d2 : DJrVal
  /-- $J(x_l+h_l)$. -/
  j4 : JVal
  /-- $J(x_u+h_u)$. -/
  j5 : JVal
  /-- $J'(x_u+h_u)$. -/
  d5 : DJrVal
  /-- $J(x_u+h_u/2)$. -/
  j7 : JVal
  /-- $J'(x_u+h_u/2)$. -/
  d7 : DJrVal
  /-- $h_u^{1/\beta}$. -/
  q10 : PowVal
  /-- $h_u^{2-1/\beta}$. -/
  q11 : PowVal
  /-- $h_l^{3-1/\beta}$. -/
  q12 : PowVal
  /-- $h_u^{3-1/\beta}$. -/
  q13 : PowVal
  /-- $h_u^{4-1/\beta}$. -/
  q14 : PowVal
  /-- $h_l^{5-1/\beta}$. -/
  q15 : PowVal
  /-- $h_u^{5-1/\beta}$. -/
  q16 : PowVal
  /-- $h_u^{6-1/\beta}$. -/
  q17 : PowVal
  /-- $h_l^{6-1/\beta}$. -/
  q18 : PowVal
  /-- $c^{1-1/\beta}$. -/
  q19 : PowVal
  /-- $c^{1-2/\beta}$. -/
  q20 : PowVal

/-- The Boolean box check for (6.3): the table entries are at the right points and the checker
certifies $\underline{g_{J,1,\beta,c}}>10^{-7}$ on the rectangle `p = (xl, xu, hl, hu)`. -/
def gJ1Check (β c : ℚ) (p : Box) (t : GJ1Tab) : Bool :=
  let xl := p.1
  let xu := p.2.1
  let hl := p.2.2.1
  let hu := p.2.2.2
  t.j0.x == xu && t.d0.x == xu && t.j2.x == xl && t.d2.x == xl && t.j4.x == xl + hl &&
  t.j5.x == xu + hu && t.d5.x == xu + hu && t.j7.x == xu + hu / 2 && t.d7.x == xu + hu / 2 &&
  t.q10.a == hu && t.q10.r == β⁻¹ && t.q11.a == hu && t.q11.r == 2 - β⁻¹ &&
  t.q12.a == hl && t.q12.r == 3 - β⁻¹ && t.q13.a == hu && t.q13.r == 3 - β⁻¹ &&
  t.q14.a == hu && t.q14.r == 4 - β⁻¹ && t.q15.a == hl && t.q15.r == 5 - β⁻¹ &&
  t.q16.a == hu && t.q16.r == 5 - β⁻¹ && t.q17.a == hu && t.q17.r == 6 - β⁻¹ &&
  t.q18.a == hl && t.q18.r == 6 - β⁻¹ && t.q19.a == c && t.q19.r == 1 - β⁻¹ &&
  t.q20.a == c && t.q20.r == 1 - 2 / β &&
  check P11 [(t.j0.l, t.j0.u), (t.d0.l, t.d0.u), (t.j2.l, t.j2.u), (t.d2.l, t.d2.u),
    (t.j4.l, t.j4.u), (t.j5.l, t.j5.u), (t.d5.l, t.d5.u), (t.j7.l, t.j7.u), (t.d7.l, t.d7.u),
    (1 - P11.wu / 2, 1 - P11.wl / 2), (t.q10.l, t.q10.u), (t.q11.l, t.q11.u),
    (t.q12.l, t.q12.u), (t.q13.l, t.q13.u), (t.q14.l, t.q14.u), (t.q15.l, t.q15.u),
    (t.q16.l, t.q16.u), (t.q17.l, t.q17.u), (t.q18.l, t.q18.u), (t.q19.l, t.q19.u),
    (t.q20.l, t.q20.u)] (gJ1Ex β c xl xu hl hu) (1 / 10 ^ 7)

/-- **Box certificate for (6.3).** If `gJ1Check` succeeds on the rectangle `p`, then
$\underline{g_{J,1,\beta,c}}>10^{-7}$ on `p`. -/
theorem gJ1_box (β c : ℚ) (p : Box) (t : GJ1Tab) (h : gJ1Check β c p t = true) :
    0 < gJ1_fl β c (Box.toR p).1 (Box.toR p).2 := by
  obtain ⟨xl, xu, hl, hu⟩ := p
  simp only [gJ1Check, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨e0, e1⟩, e2⟩, e3⟩, e4⟩, e5⟩, e6⟩, e7⟩, e8⟩, a10⟩, r10⟩, a11⟩,
    r11⟩, a12⟩, r12⟩, a13⟩, r13⟩, a14⟩, r14⟩, a15⟩, r15⟩, a16⟩, r16⟩, a17⟩, r17⟩, a18⟩,
    r18⟩, a19⟩, r19⟩, a20⟩, r20⟩, hk⟩ := h
  have := check_sound P11 hw11 [t.j0.cert, t.d0.cert, t.j2.cert, t.d2.cert, t.j4.cert,
    t.j5.cert, t.d5.cert, t.j7.cert, t.d7.cert, x0Cert, t.q10.cert, t.q11.cert, t.q12.cert,
    t.q13.cert, t.q14.cert, t.q15.cert, t.q16.cert, t.q17.cert, t.q18.cert, t.q19.cert,
    t.q20.cert] _ _ hk
  rw [denote_gJ1Ex β c xl xu hl hu _
    (by simp [Cert.val, envOf, JVal.cert, e0]) (by simp [Cert.val, envOf, DJrVal.cert, e1])
    (by simp [Cert.val, envOf, JVal.cert, e2]) (by simp [Cert.val, envOf, DJrVal.cert, e3])
    (by simp [Cert.val, envOf, JVal.cert, e4]) (by simp [Cert.val, envOf, JVal.cert, e5])
    (by simp [Cert.val, envOf, DJrVal.cert, e6]) (by simp [Cert.val, envOf, JVal.cert, e7])
    (by simp [Cert.val, envOf, DJrVal.cert, e8]) (by simp [Cert.val, envOf, x0Cert])
    (by simp [Cert.val, envOf, PowVal.cert, a10, r10])
    (by simp [Cert.val, envOf, PowVal.cert, a11, r11])
    (by simp [Cert.val, envOf, PowVal.cert, a12, r12])
    (by simp [Cert.val, envOf, PowVal.cert, a13, r13])
    (by simp [Cert.val, envOf, PowVal.cert, a14, r14])
    (by simp [Cert.val, envOf, PowVal.cert, a15, r15])
    (by simp [Cert.val, envOf, PowVal.cert, a16, r16])
    (by simp [Cert.val, envOf, PowVal.cert, a17, r17])
    (by simp [Cert.val, envOf, PowVal.cert, a18, r18])
    (by simp [Cert.val, envOf, PowVal.cert, a19, r19])
    (by simp [Cert.val, envOf, PowVal.cert, a20, r20])] at this
  simp only [gJ1_fl, Box.toR, Matrix.cons_val_zero, Matrix.cons_val_one]
  push_cast at this ⊢
  linarith

/-- **Soundness of partitioning for (6.3)** ([DIR], §4.1, via `Auto.DIR.pos_of_dtree` and
Fact 4.1): if $\underline{g_{J,1,\beta,c}}>10^{-7}$ on every rectangle of a dyadic partition tree
of $[\frac12,\frac58]\times[0,\frac3{16}]$, then $g_{J,1,\beta,c}(x,h)>10^{-7}$ for
$x\in(\frac12,\frac58]$, $h\in[0,\frac3{16}]$. (At $x=\frac12$ the derivatives of `J` are not
meaningful; Fact 4.1 is applied to $f$ replaced by $1$ there and $\underline f$ by
$\min(\underline f,1)$.) -/
theorem gJ1_gt_of_tree (β c : ℚ) (hβ : (β : ℝ) ∈ Ico (2⁻¹ : ℝ) 1) (hc : (0 : ℝ) < c)
    (t : DTree) (ht : ∀ p ∈ t.boxes (1 / 2) (5 / 8) 0 (3 / 16),
      0 < gJ1_fl β c (Box.toR p).1 (Box.toR p).2)
    (x h : ℝ) (hx : x ∈ Ioc (2⁻¹ : ℝ) (5 / 8)) (hh : h ∈ Icc (0 : ℝ) (3 / 16)) :
    1 / 10 ^ 7 < gJ1expr β c x h := by
  have H := pos_of_dtree t (1 / 2) (5 / 8) 0 (3 / 16) (by norm_num) (by norm_num)
    (fun z ↦ if 2⁻¹ < z 0 then gJ1expr β c (z 0) (z 1) - 1 / 10 ^ 7 else 1)
    (fun zl zu ↦ min (gJ1_fl β c zl zu) 1) ?_ (fun p hp ↦ lt_min (ht p hp) one_pos) ![x, h]
    (mem_Icc_toR.2 ⟨by norm_num; constructor <;> linarith [hx.1, hx.2],
      by norm_num; constructor <;> linarith [hh.1, hh.2]⟩)
  · split_ifs at H with h0 <;> simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at H h0
    · linarith
    · exact absurd hx.1 h0
  · intro zl zu hl hu z hz
    obtain ⟨⟨h1, h2⟩, h3, h4⟩ := le_toR_iff.1 ⟨hl, hu⟩
    norm_num at h1 h2 h3 h4
    split_ifs with hz0
    · refine (min_le_left _ _).trans ?_
      have := gJ1lo_le hβ hc (by linarith) h3 h2 h4 ⟨hz.1 0, hz.2 0⟩ hz0 ⟨hz.1 1, hz.2 1⟩
      simp only [gJ1_fl]
      linarith
    · exact min_le_right _ _

end Auto.DIR
