/-- $\log\frac1{1/4}=2\log2$. -/
theorem log_inv_quarter : log (4⁻¹ : ℝ)⁻¹ = 2 * log 2 := by
  rw [inv_inv, show (4 : ℝ) = 2 ^ 2 by norm_num, log_pow]; norm_num

/-- $L_\beta''(\frac14)=-2^\beta\beta(1-\beta+2\log2)/(\log2)^2$. -/
theorem L2f_quarter (β : ℝ) :
    L2f β 4⁻¹ = -(2 ^ β * β * (1 - β + 2 * log 2)) / (log 2) ^ 2 := by
  have hl : 0 < log 2 := log_pos one_lt_two
  rw [L2f, log_inv_quarter, mul_rpow (by norm_num) hl.le,
    rpow_eq_rpow_div_pow two_pos (-2 + β) β 2 (by push_cast; ring),
    rpow_eq_rpow_div_pow hl (-2 + β) β 2 (by push_cast; ring), rpow_neg hl.le]
  have : (log 2) ^ β ≠ 0 := (rpow_pos_of_pos hl β).ne'
  field_simp
  ring

/-- $L_\beta'''(\frac14)=2^{\beta+1}\beta(\beta(3-\beta)-2+4(\log2)^2)/(\log2)^3$. -/
theorem L3f_quarter (β : ℝ) :
    L3f β 4⁻¹ = 2 * 2 ^ β * β * (β * (3 - β) - 2 + 4 * (log 2) ^ 2) / (log 2) ^ 3 := by
  have hl : 0 < log 2 := log_pos one_lt_two
  rw [L3f, log_inv_quarter, mul_rpow (by norm_num) hl.le,
    rpow_eq_rpow_div_pow two_pos (-3 + β) β 3 (by push_cast; ring),
    rpow_eq_rpow_div_pow hl (-3 + β) β 3 (by push_cast; ring), rpow_neg hl.le]
  have : (log 2) ^ β ≠ 0 := (rpow_pos_of_pos hl β).ne'
  simp only [zpow_neg, zpow_ofNat]
  field_simp
  ring

/-- For $\beta\in[\frac12,1]$, $L_\beta'''$ is antitone on $(0,\frac12]$ (as $L^{(4)}_\beta<0$). -/
theorem deriv3_L_antitoneOn {β : ℝ} (hβ : β ∈ Icc (2⁻¹ : ℝ) 1) :
    AntitoneOn (deriv (deriv (deriv (L β)))) (Ioc 0 2⁻¹) := by
  have hsub : ∀ z ∈ Ioc (0 : ℝ) 2⁻¹, z ∈ Ioo (0 : ℝ) 1 :=
    fun z hz ↦ ⟨hz.1, hz.2.trans_lt (by norm_num)⟩
  refine antitoneOn_of_deriv_nonpos (convex_Ioc 0 2⁻¹)
    (fun z hz ↦ (hasDerivAt_deriv3_L (β := β) (hsub z hz)).continuousAt.continuousWithinAt)
    (fun z hz ↦ ?_) (fun z hz ↦ ?_)
  · rw [interior_Ioc] at hz
    exact (hasDerivAt_deriv3_L (β := β) (hsub z ⟨hz.1, hz.2.le⟩)).differentiableAt
      |>.differentiableWithinAt
  · rw [interior_Ioc] at hz
    have h4 := (lemma_5_6 β hβ).2.2.2 z ⟨hz.1, hz.2.le⟩
    simp only [iteratedDeriv_succ, iteratedDeriv_zero] at h4
    exact h4.le

/-- If $L_\beta'''+c\ge0$ on $(0,\frac14)$, then $x\mapsto L_\beta''(x)+cx$ is monotone on
$(0,\frac14]$. -/
theorem deriv2_L_add_monotoneOn {β c : ℝ}
    (hc : ∀ z ∈ Ioo (0 : ℝ) 4⁻¹, 0 ≤ L3f β z + c) :
    MonotoneOn (fun x ↦ deriv (deriv (L β)) x + c * x) (Ioc 0 4⁻¹) := by
  have hsub : ∀ z ∈ Ioc (0 : ℝ) 4⁻¹, z ∈ Ioo (0 : ℝ) 1 :=
    fun z hz ↦ ⟨hz.1, hz.2.trans_lt (by norm_num)⟩
  have hd : ∀ z ∈ Ioc (0 : ℝ) 4⁻¹, HasDerivAt (fun x ↦ deriv (deriv (L β)) x + c * x)
      (L3f β z + c) z := fun z hz ↦
    ((hasDerivAt_deriv2_L (β := β) (hsub z hz)).add
      ((hasDerivAt_id' z).const_mul c)).congr_deriv (by ring)
  refine monotoneOn_of_deriv_nonneg (convex_Ioc 0 4⁻¹)
    (fun z hz ↦ (hd z hz).continuousAt.continuousWithinAt) (fun z hz ↦ ?_) (fun z hz ↦ ?_)
  · rw [interior_Ioc] at hz
    exact (hd z ⟨hz.1, hz.2.le⟩).differentiableAt.differentiableWithinAt
  · rw [interior_Ioc] at hz
    rw [(hd z ⟨hz.1, hz.2.le⟩).deriv]
    exact hc z hz

/-- Numerical inequality for Lemma 6.7 ($\alpha_1\le0$ case): for $\beta\in[\frac12,1]$,
$L_\beta'''(\frac14)+4\alpha_1>0$, i.e.
$2^{\beta+1}\beta(\beta(3-\beta)-2+4(\log2)^2)/(\log2)^3+4(3-2^{1+\beta})>0$. -/
theorem L3f_quarter_add_pos {β : ℝ} (hβ : β ∈ Icc (2⁻¹ : ℝ) 1) :
    0 < L3f β 4⁻¹ + 4 * (3 - 2 ^ (1 + β)) := by
  have hl1 := log_two_gt_d9
  have hl2 := log_two_lt_d9
  have hl : 0 < log 2 := by linarith
  have ht1 := two_rpow_gt_of_half_le hβ.1
  have ht2 := two_rpow_le_two_of_le_one hβ.2
  rw [L3f_quarter, two_rpow_one_add]
  set t := (2 : ℝ) ^ β
  set l := log 2
  have hm : 0.58 ≤ β * (β * (3 - β) - 2 + 4 * l ^ 2) := by
    nlinarith [hβ.1, hβ.2, mul_nonneg (by linarith [hβ.1] : (0 : ℝ) ≤ β - 2⁻¹)
      (by linarith [hβ.2] : (0 : ℝ) ≤ 1 - β)]
  have hl3 : 0 < l ^ 3 := by positivity
  have key : 0 < 2 * t * β * (β * (3 - β) - 2 + 4 * l ^ 2) + 4 * (3 - 2 * t) * l ^ 3 := by
    have : l ^ 3 < 0.334 := by nlinarith
    have : 0.333 < l ^ 3 := by nlinarith
    nlinarith
  rw [div_add' _ _ _ hl3.ne', lt_div_iff₀ hl3]
  linarith

/-- Numerical inequality for Lemma 6.7 ($\alpha_1\le0$ case): for $\beta\in[\frac12,1]$,
$L_\beta''(\frac14)+2\alpha_0+\alpha_1=2^\beta(6-\beta(1-\beta+2\log2)/(\log2)^2)-7<0$. -/
theorem L2f_quarter_add_neg {β : ℝ} (hβ : β ∈ Icc (2⁻¹ : ℝ) 1) :
    L2f β 4⁻¹ + 2 * (2 ^ (2 + β) - 5) + (3 - 2 ^ (1 + β)) < 0 := by
  have hl1 := log_two_gt_d9
  have hl2 := log_two_lt_d9
  have hl : 0 < log 2 := by linarith
  have ht1 := two_rpow_gt_of_half_le hβ.1
  have hb : (2 : ℝ) ^ β ≤ 1 + β := by
    have := rpow_one_add_le_one_add_mul_self (s := 1) (by norm_num) (p := β)
      (by linarith [hβ.1]) hβ.2
    norm_num at this; linarith
  rw [L2f_quarter, two_rpow_one_add, two_rpow_two_add]
  set t := (2 : ℝ) ^ β
  set l := log 2
  have hl2' : 0 < l ^ 2 := by positivity
  have hbr : 0 ≤ 6 * l ^ 2 - β * (1 - β + 2 * l) := by nlinarith [hβ.1, hβ.2]
  have hcub : (1 + β) * (6 * l ^ 2 - β * (1 - β + 2 * l)) - 7 * l ^ 2 < 0 := by
    nlinarith [hβ.1, hβ.2, mul_nonneg (by linarith [hβ.1] : (0 : ℝ) ≤ β)
      (mul_nonneg (by linarith [hβ.1] : (0 : ℝ) ≤ β) (by linarith [hβ.2] : (0 : ℝ) ≤ 1 - β)),
      sq_nonneg (β - 0.64)]
  have key : -(t * β * (1 - β + 2 * l)) + (2 * (4 * t - 5) + (3 - 2 * t)) * l ^ 2 < 0 := by
    nlinarith [mul_le_mul_of_nonneg_right hb hbr]
  have : -(t * β * (1 - β + 2 * l)) / l ^ 2 + 2 * (4 * t - 5) + (3 - 2 * t) =
      (-(t * β * (1 - β + 2 * l)) + (2 * (4 * t - 5) + (3 - 2 * t)) * l ^ 2) / l ^ 2 := by
    field_simp
    ring
  rw [this]
  exact div_neg_of_neg_of_pos key hl2'

