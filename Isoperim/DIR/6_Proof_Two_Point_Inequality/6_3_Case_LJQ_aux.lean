/-! #### Numerical evaluations for claim (1), $\beta=\frac12$ -/

/-- (6.15), first part: $f_{\frac12}''(\frac9{16})=-2(\sqrt2-1)J(\frac9{16})^{-1}
-\frac12Q_{\frac12}''(\frac9{32})>0.05$. -/
theorem fJQ2_nine_sixteenths : fJQ2 (√2 - 1) 2⁻¹ (9 / 16) > 0.05 := by
  obtain ⟨hj1, hj2⟩ := J_nine_sixteenths_mem
  obtain ⟨hs1, hs2⟩ := sqrt_two_mem
  have hj : 0 < J (9 / 16) := by linarith
  have ht : (J (9 / 16))⁻¹ ≤ 1.97954 := by
    rw [inv_le_comm₀ hj (by norm_num)]; norm_num; linarith
  rw [fJQ2, Q2f_eq_affine, two_rpow_half]
  nlinarith [mul_le_mul_of_nonneg_left ht (by linarith : (0 : ℝ) ≤ √2 - 1)]

/-- (6.15), second part: $f_{\frac12}''(\frac45)<-0.3$. -/
theorem fJQ2_four_fifths : fJQ2 (√2 - 1) 2⁻¹ (4 / 5) < -0.3 := by
  obtain ⟨hj1, hj2⟩ := J_four_fifths_mem
  obtain ⟨hs1, hs2⟩ := sqrt_two_mem
  have hj : 0 < J (4 / 5) := by linarith
  have ht : 2.6435 ≤ (J (4 / 5))⁻¹ := by
    rw [le_inv_comm₀ (by norm_num) hj]; norm_num; linarith
  rw [fJQ2, Q2f_eq_affine, two_rpow_half]
  nlinarith [mul_le_mul_of_nonneg_left ht (by linarith : (0 : ℝ) ≤ √2 - 1)]

/-- (6.16), first part: $f_{\frac12}'(\frac9{16})=1+(\sqrt2-1)J'(\frac9{16})
-Q_{\frac12}'(\frac9{32})>0.05$. -/
theorem fJQ1_nine_sixteenths : fJQ1 (√2 - 1) 2⁻¹ (9 / 16) > 0.05 := by
  obtain ⟨hd1, hd2⟩ := deriv_J_nine_sixteenths_mem
  obtain ⟨hs1, hs2⟩ := sqrt_two_mem
  rw [fJQ1, Q1f_eq_affine, two_rpow_half]
  nlinarith [mul_le_mul_of_nonneg_left hd1 (by linarith : (0 : ℝ) ≤ √2 - 1)]

/-- (6.16), second part: $f_{\frac12}'(\frac{15}{16})<-0.1$. -/
theorem fJQ1_fifteen_sixteenths : fJQ1 (√2 - 1) 2⁻¹ (15 / 16) < -0.1 := by
  obtain ⟨hd1, hd2⟩ := deriv_J_fifteen_sixteenths_mem
  obtain ⟨hs1, hs2⟩ := sqrt_two_mem
  rw [fJQ1, Q1f_eq_affine, two_rpow_half]
  nlinarith [mul_le_mul_of_nonneg_left hd2 (by linarith : (0 : ℝ) ≤ √2 - 1)]

/-- $f_{\frac12}'(\frac12^+)=1+(\sqrt2-1)J'(\frac12^+)-Q_{\frac12}'(\frac14)>0.05$. -/
theorem fJQ1_half_lim_gt : 1 + (√2 - 1) * Checker.DJr 2⁻¹ - Q1f 2⁻¹ (2⁻¹ / 2) > 0.05 := by
  obtain ⟨hd1, hd2⟩ := DJr_half_mem
  obtain ⟨hs1, hs2⟩ := sqrt_two_mem
  rw [Q1f_eq_affine, two_rpow_half]
  nlinarith [mul_le_mul_of_nonneg_left hd1 (by linarith : (0 : ℝ) ≤ √2 - 1)]

/-! #### Claim (1), $\beta=1$ -/

/-- $J(y)\le\frac12+\frac12(y-\frac12)=\frac{1+2y}4$ on $[\frac12,1]$: $J$ lies below the line
through $(\frac12,J(\frac12))$ of slope $\frac12\ge J'(\frac12^+)\ge J'$. -/
theorem J_le_line {y : ℝ} (hy : y ∈ Icc (2⁻¹ : ℝ) 1) : J y ≤ (1 + 2 * y) / 4 := by
  have hD := DJr_half_mem.2
  have ha : AntitoneOn (fun z ↦ J z - z / 2) (Icc 2⁻¹ 1) := by
    refine antitoneOn_of_deriv_nonpos (convex_Icc _ _)
      (continuousOn_J.sub (continuousOn_id.div_const 2)) (fun z hz ↦ ?_) (fun z hz ↦ ?_)
    · rw [interior_Icc] at hz
      exact ((hasDerivAt_J_deriv hz).sub ((hasDerivAt_id' z).div_const 2)).differentiableAt
        |>.differentiableWithinAt
    · rw [interior_Icc] at hz
      have hd : HasDerivAt (fun z ↦ J z - z / 2) _ z :=
        (hasDerivAt_J_deriv hz).sub ((hasDerivAt_id' z).div_const 2)
      rw [hd.deriv]
      linarith [deriv_J_le_DJr_half hz]
  have := ha ⟨le_rfl, by norm_num⟩ hy hy.1
  simp only [J_half] at this
  linarith

/-- [DIR], §6.3.2, proof of (1), case $\beta=1$ (details omitted in the paper): with
$f_1(y)=y+J(y)-2Q_1(\frac y2)$, $f_1''(y)=6-4y-2J(y)^{-1}\le0$ on $(\frac12,1)$ (by
`J_le_line`), so $f_1$ is concave on $[\frac12,1]$; as $f_1(\frac12)=f_1(1)=0$, $f_1\ge0$ on
$[\frac12,1]$. -/
theorem fJQ_one_nonneg {y : ℝ} (hy : y ∈ Icc (2⁻¹ : ℝ) 1) : 0 ≤ fJQ 1 1 y := by
  have hc : ConcaveOn ℝ (Icc 2⁻¹ 1) (fJQ 1 1) := by
    refine concaveOn_of_deriv2_nonpos (convex_Icc _ _) (continuousOn_fJQ 1 1)
      (fun z hz ↦ ?_) (fun z hz ↦ ?_) (fun z hz ↦ ?_)
    · rw [interior_Icc] at hz
      exact (hasDerivAt_fJQ 1 1 hz).differentiableAt.differentiableWithinAt
    · rw [interior_Icc] at hz
      exact (hasDerivAt_derivs_fJQ 1 1 hz).1.differentiableAt.differentiableWithinAt
    · rw [interior_Icc] at hz
      change deriv (deriv (fJQ 1 1)) z ≤ 0
      have hJ := J_pos ⟨hz.1.le, hz.2⟩
      have hl := J_le_line ⟨hz.1.le, hz.2.le⟩
      have hi : (6 - 4 * z) / 2 ≤ 1 / J z := by
        rw [le_div_iff₀ hJ]; nlinarith [hz.1, hz.2]
      rw [(derivs_fJQ 1 1 hz).2.1, fJQ2, Q2f_eq_affine, rpow_one, ← one_div]
      linarith
  have h1 : fJQ 1 1 2⁻¹ = 0 := by
    rw [fJQ, J_half, Q_eq_affine, rpow_one]; ring
  have h2 : fJQ 1 1 1 = 0 := by
    rw [fJQ, J_one, show (1 : ℝ) / 2 = 2⁻¹ by norm_num, Q_half]; ring
  have := hc.min_le_of_mem_Icc ⟨le_rfl, by norm_num⟩ ⟨by norm_num, le_rfl⟩ hy
  rw [h1, h2, min_self] at this
  exact this

/-! #### Claim (3) -/

/-- [DIR], §6.3.2, proof of (3): the function $2y-1+cJ(y)+L_\beta(1-y)-1$ (for $c=2^\beta-1$ this
is $f_\beta(y)=G_{LJQ,\beta}(1-y,y)$). -/
noncomputable def fJL (c β y : ℝ) : ℝ := 2 * y - 1 + c * J y + L β (1 - y) - 1

/-- The first derivative of `fJL` on $(\frac12,1)$: $2+cJ'(y)-L_\beta'(1-y)$. -/
noncomputable def fJL1 (c β y : ℝ) : ℝ := 2 + c * deriv J y - L1f β (1 - y)

/-- The second derivative of `fJL` on $(\frac12,1)$: $-2cJ(y)^{-1}+L_\beta''(1-y)$. -/
noncomputable def fJL2 (c β y : ℝ) : ℝ := c * (-2 * (J y)⁻¹) + L2f β (1 - y)

/-- `fJL1` is the derivative of `fJL` on $(\frac12,1)$. -/
theorem hasDerivAt_fJL (c β : ℝ) {y : ℝ} (hy : y ∈ Ioo (2⁻¹ : ℝ) 1) :
    HasDerivAt (fJL c β) (fJL1 c β y) y := by
  have h1y : 1 - y ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hy.2], by linarith [hy.1]⟩
  have hl := (hasDerivAt_L (β := β) h1y).comp y ((hasDerivAt_id' y).const_sub 1)
  have h : HasDerivAt (fJL c β) _ y :=
    ((((hasDerivAt_id' y).const_mul 2).sub_const 1).add
      ((hasDerivAt_J_deriv hy).const_mul c)).add hl |>.sub_const 1
  exact h.congr_deriv (by rw [fJL1]; ring)

/-- `fJL2` is the derivative of `fJL1` on $(\frac12,1)$. -/
theorem hasDerivAt_fJL1 (c β : ℝ) {y : ℝ} (hy : y ∈ Ioo (2⁻¹ : ℝ) 1) :
    HasDerivAt (fJL1 c β) (fJL2 c β y) y := by
  have h1y : 1 - y ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hy.2], by linarith [hy.1]⟩
  have hl := (hasDerivAt_L1f (β := β) h1y).comp y ((hasDerivAt_id' y).const_sub 1)
  have h : HasDerivAt (fJL1 c β) _ y :=
    (((hasDerivAt_deriv_J hy).const_mul c).const_add 2).sub hl
  exact h.congr_deriv (by rw [fJL2]; ring)

/-- On $(\frac12,1)$: $(\mathtt{fJL})'=\mathtt{fJL1}$, $(\mathtt{fJL})''=\mathtt{fJL2}$, and
$(\mathtt{fJL})'$ has the derivative `fJL2`. -/
theorem derivs_fJL (c β : ℝ) {y : ℝ} (hy : y ∈ Ioo (2⁻¹ : ℝ) 1) :
    deriv (fJL c β) y = fJL1 c β y ∧ deriv (deriv (fJL c β)) y = fJL2 c β y ∧
      HasDerivAt (deriv (fJL c β)) (fJL2 c β y) y := by
  have h1 : ∀ z ∈ Ioo (2⁻¹ : ℝ) 1, deriv (fJL c β) z = fJL1 c β z :=
    fun z hz ↦ (hasDerivAt_fJL c β hz).deriv
  have h2 := deriv_eq_of_eqOn_Ioo h1 (fun _ hw ↦ hasDerivAt_fJL1 c β hw) y hy
  exact ⟨h1 y hy, h2.deriv, h2⟩

/-- `fJL` is continuous on $[\frac12,1]$ (for $0<\beta\le1$). -/
theorem continuousOn_fJL (c : ℝ) {β : ℝ} (hβ0 : 0 < β) (hβ1 : β ≤ 1) :
    ContinuousOn (fJL c β) (Icc 2⁻¹ 1) := by
  have hL : ContinuousOn (fun y ↦ L β (1 - y)) (Icc 2⁻¹ 1) :=
    (continuousOn_L hβ0 hβ1).comp (continuousOn_const.sub continuousOn_id)
      (fun y hy ↦ ⟨by linarith [hy.2], by linarith [hy.1]⟩)
  exact ((((continuousOn_const.mul continuousOn_id).sub continuousOn_const).add
    (continuousOn_J.const_smul c)).add hL).sub continuousOn_const

/-- For $c\ge0$ and $y\in(\frac12,1)$: $-2cJ(y)^{-1}+L_{\frac12}''(1-y)\le0$ ($J>0$ and
$L_{\frac12}''<0$ on $(0,1)$). -/
theorem fJL2_half_nonpos {c : ℝ} (hc : 0 ≤ c) {y : ℝ} (hy : y ∈ Ioo (2⁻¹ : ℝ) 1) :
    c * (-2 * (J y)⁻¹) + L2f 2⁻¹ (1 - y) ≤ 0 := by
  have h1y : 1 - y ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hy.2], by linarith [hy.1]⟩
  have hJ := J_pos ⟨hy.1.le, hy.2⟩
  have hu : 0 < log (1 - y)⁻¹ := log_pos ((one_lt_inv₀ h1y.1).2 h1y.2)
  have hl : 0 < log 2 := log_pos one_lt_two
  have h := neg_L2f_eq (β := 2⁻¹) h1y
  have : 0 ≤ 2⁻¹ * (1 - 2⁻¹ + log (1 - y)⁻¹) * ((1 - y)⁻¹ * (log (1 - y)⁻¹) ^ (-2 : ℝ)) *
      (log (1 - y)⁻¹ / log 2) ^ (2⁻¹ : ℝ) := by
    have := rpow_pos_of_pos hu (-2 : ℝ)
    have := rpow_pos_of_pos (div_pos hu hl) (2⁻¹ : ℝ)
    have := inv_pos.2 h1y.1
    have : 0 < 1 - 2⁻¹ + log (1 - y)⁻¹ := by linarith
    positivity
  have : 0 ≤ c * (2 * (J y)⁻¹) := by positivity
  linarith

/-- (6.18): $f_{\frac12}(\frac34)=\frac12-1+(\sqrt2-1)J(\frac34)+L_{\frac12}(\frac14)
=-\frac12+(\sqrt2-1)J(\frac34)+\frac{\sqrt2}4>0.01$. -/
theorem fJL_three_fourths : fJL (√2 - 1) 2⁻¹ (3 / 4) > 0.01 := by
  obtain ⟨hj1, hj2⟩ := J_three_fourths_mem
  obtain ⟨hs1, hs2⟩ := sqrt_two_mem
  have hL : L 2⁻¹ (1 - 3 / 4) = √2 / 4 := by
    rw [L, show (1 - 3 / 4 : ℝ)⁻¹ = 2 ^ (2 : ℝ) by norm_num,
      logb_rpow (by norm_num) (by norm_num), two_rpow_half]
    ring
  rw [fJL, hL]
  nlinarith [mul_le_mul_of_nonneg_left hj1 (by linarith : (0 : ℝ) ≤ √2 - 1)]

end Prop_6_6_aux

end Auto.DIR

/-! ## [DIR] §6.3.1 Case LJQ, Case I: the tight lower bound of $G_\beta[b_\beta]$

Auxiliary file of `6_3_Case_LJQ.lean` for the computer-assisted claim (6.13) ([DIR], §6.3.1):

* certified values of $J(x)^r$ (`JRVal`) and of $L_\beta(x)$ (`LVal`) at rational points, the
  latter from an enclosure of $\log_2x^{-1}$ (`logbInvIv`);
* the monotonicity facts behind the paper's lower bound: $L_\beta$ is increasing on
  $[\frac1{16},\frac14]$, and $Q_\beta$ is increasing on $[\frac14,\frac12]$ if
  $2^\beta\le\frac32$ (in particular for $\beta\in\{\beta_0,\frac12\}$);
* the paper's tight lower bound $\underline{g_{LJQ,1,\beta}}$ and its lower-bound property
  (`g_LJQ_1_lo_le`);
* the box certificate `g1_box`: $\underline{g_{LJQ,1,\beta}}>10^{-7}$ on a rectangle by one
  kernel evaluation of the verified interval checker, with the recurring values given as
  certified table entries.
-/

namespace Auto.DIR

open Real Set Checker

/-! ### Certified values -/

/-- A certified enclosure $l\le J(x)^r\le u$ at a rational point $x\in[\frac12,1]$. -/
structure JRVal where
  /-- The point. -/
  x : ℚ
  /-- The exponent. -/
  r : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The enclosure. -/
  h : (l : ℝ) ≤ J x ^ (r : ℝ) ∧ J x ^ (r : ℝ) ≤ u

/-- A `JRVal` from a kernel-checked enclosure by the node `rpow (J x sl su) r`. -/
def JRVal.mk' (x r l u sl su : ℚ) (h : checkMem P11 [] (.rpow (.J x sl su) r) l u = true) :
    JRVal where
  x := x
  r := r
  l := l
  u := u
  h := checkMem_sound P11 hw11 [] (.rpow (.J x sl su) r) l u h

/-- A `JRVal` as an entry of the environment of the checker. -/
noncomputable def JRVal.cert (j : JRVal) : Cert := ⟨j.l, j.u, J j.x ^ (j.r : ℝ), j.h⟩

/-- Enclosure of $\log_2x^{-1}=\log(x^{-1})/\log2$ for rational $x>0$ with $x<1$ (from
`logIv` and the enclosure `ln2_mem` of $\log2$). -/
def logbInvIv (P : Params) (x : ℚ) : Option (ℚ × ℚ) :=
  match logIv P x⁻¹ with
  | some (a, b) => if 0 < a then some (rdn P.prec (a / ln2Hi), rup P.prec (b / ln2Lo)) else none
  | none => none

/-- Soundness of `logbInvIv`. -/
theorem logbInvIv_sound (P : Params) {x : ℚ} {I : ℚ × ℚ} (h : logbInvIv P x = some I) :
    Mem I (logb 2 (x : ℝ)⁻¹) := by
  unfold logbInvIv at h
  rcases hl : logIv P x⁻¹ with _ | ⟨a, b⟩ <;> rw [hl] at h
  · cases h
  simp only at h
  split_ifs at h with ha
  cases h
  obtain ⟨-, hm⟩ := logIv_sound P hl
  have h2 := ln2_mem
  simp only [Mem] at hm h2 ⊢
  push_cast at hm
  have hl2 : 0 < log 2 := log_pos one_lt_two
  have ha' : (0 : ℝ) < a := by exact_mod_cast ha
  have hlo : (0 : ℝ) < ln2Lo := by norm_num [ln2Lo]
  rw [logb]
  constructor
  · apply rdn_le_real
    push_cast
    exact div_le_div₀ (ha'.le.trans hm.1) hm.1 hl2 h2.2
  · apply le_rup_real
    push_cast
    exact div_le_div₀ (ha'.le.trans (hm.1.trans hm.2)) hm.2 hlo h2.1

/-- The Boolean check of an enclosure $l\le L_\beta(x)\le u$, $L_\beta(x)=x(\log_2x^{-1})^\beta$,
at rational $x,\beta$. -/
def lCheck (P : Params) (β x l u : ℚ) : Bool :=
  match logbInvIv P x with
  | some I => checkMem P [I] (.mul (.const x) (.rpow (.var 0) β)) l u
  | none => false

/-- Soundness of `lCheck`. -/
theorem lCheck_sound {β x l u : ℚ} (h : lCheck P11 β x l u = true) :
    (l : ℝ) ≤ L β x ∧ L β x ≤ u := by
  unfold lCheck at h
  rcases hI : logbInvIv P11 x with _ | I <;> rw [hI] at h
  · cases h
  have hΓ : EnvSound [I] (fun _ ↦ logb 2 (x : ℝ)⁻¹) := by
    intro i K hK
    cases i with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hK
      subst hK
      exact logbInvIv_sound P11 hI
    | succ i => simp at hK
  have := checkMem_sound_env P11 hw11 hΓ _ l u h
  simpa [denote, L] using this

/-- A certified enclosure $l\le L_\beta(x)\le u$ at rational $\beta$, $x$. -/
structure LVal where
  /-- The exponent $\beta$. -/
  β : ℚ
  /-- The point. -/
  x : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The enclosure. -/
  h : (l : ℝ) ≤ L β x ∧ L β x ≤ u

/-- An `LVal` from a kernel-checked `lCheck`. -/
def LVal.mk' (β x l u : ℚ) (h : lCheck P11 β x l u = true) : LVal where
  β := β
  x := x
  l := l
  u := u
  h := lCheck_sound h

/-- An `LVal` as an entry of the environment of the checker. -/
noncomputable def LVal.cert (j : LVal) : Cert := ⟨j.l, j.u, L j.β j.x, j.h⟩

/-! ### Monotonicity of $L_\beta$ and $Q_\beta$ -/

/-- [DIR], §6.3.1: $L_\beta$ is increasing on $[\frac1{16},\frac14]$ for $0<\beta\le1$ (since
$L_\beta'(x)=(\log2)^{-\beta}(\log\frac1x)^{\beta-1}(\log\frac1x-\beta)$ and
$\log\frac1x\ge\log4>1$). -/
theorem L_monotoneOn_sixteenth_quarter {β : ℝ} (hβ0 : 0 < β) (hβ1 : β ≤ 1) :
    MonotoneOn (L β) (Icc 16⁻¹ 4⁻¹) := by
  have hc : ContinuousOn (L β) (Icc 16⁻¹ 4⁻¹) :=
    (continuousOn_L hβ0 hβ1).mono (Icc_subset_Icc (by norm_num) (by norm_num))
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _) hc ?_ ?_
  · intro x hx
    rw [interior_Icc] at hx
    exact (hasDerivAt_L ⟨by linarith [hx.1], by linarith [hx.2]⟩).differentiableAt
      |>.differentiableWithinAt
  · intro x hx
    rw [interior_Icc] at hx
    have hx0 : 0 < x := by linarith [hx.1]
    rw [deriv_L_eq ⟨hx0, by linarith [hx.2]⟩]
    unfold L1f
    have h4 : (4 : ℝ) ≤ x⁻¹ := by
      rw [le_inv_comm₀ (by norm_num) hx0]; linarith [hx.2]
    have hlog4 : log 4 ≤ log x⁻¹ := log_le_log (by norm_num) h4
    have h4' : log (4 : ℝ) = 2 * log 2 := by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, log_pow]; norm_num
    have hl2 := log_two_gt_d9
    have hpos : 0 < log x⁻¹ := by linarith
    have : 0 < (log 2) ^ (-β) := rpow_pos_of_pos (log_pos one_lt_two) _
    have : 0 < (log x⁻¹) ^ (-1 + β) := rpow_pos_of_pos hpos _
    have : 0 < -β + log x⁻¹ := by linarith
    positivity

/-- [DIR], §6.3.1: if $2^\beta\le\frac32$, then $Q_\beta'(x)\ge2-4x\ge0$ on $[\frac14,\frac12]$,
so $Q_\beta$ is increasing on $[\frac14,\frac12]$. -/
theorem Q_monotoneOn_quarter_half {β : ℝ} (hs : (2 : ℝ) ^ β ≤ 3 / 2) :
    MonotoneOn (Q β) (Icc 4⁻¹ 2⁻¹) := by
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _) (continuous_Q β).continuousOn
    (fun x _ ↦ (hasDerivAt_Q β x).differentiableAt.differentiableWithinAt) ?_
  intro x hx
  rw [interior_Icc] at hx
  rw [deriv_Q_eq, Q1f_eq_affine]
  have hc : 8 / 3 - 16 * x + 16 * x ^ 2 ≤ 0 := by nlinarith [hx.1, hx.2]
  nlinarith [mul_nonneg (neg_nonneg.2 hc) (sub_nonneg.2 hs), hx.2]

/-- $2^\beta\le\frac32$ implies $\beta\le1$. -/
theorem le_one_of_two_rpow_le {β : ℝ} (hs : (2 : ℝ) ^ β ≤ 3 / 2) : β ≤ 1 := by
  by_contra h
  rw [not_le] at h
  have := rpow_lt_rpow_of_exponent_lt one_lt_two h
  rw [rpow_one] at this
  linarith

/-- $2^\beta\le c$ for rational $\beta$, $c$ from a kernel-checked `checkUpper`. -/
theorem two_rpow_le_of_checkUpper {β c : ℚ}
    (h : checkUpper P11 [] (.rpow (.const 2) β) c = true) : (2 : ℝ) ^ (β : ℝ) ≤ c := by
  have := checkUpper_sound P11 hw11 [] _ c h
  simp only [denote] at this
  push_cast at this
  exact this.le

/-! ### The tight lower bound -/

/-- The tight lower bound of $G_\beta[b_\beta]$ on $[\frac1{16},\frac14]\times[\frac12,\frac34]$
([DIR], §6.3.1):
$$\underline{g_{LJQ,1,\beta}}(\underline x,\overline x,\underline y,\overline y)=
\max\bigl(((\underline y-\overline x)^{\frac1\beta}
+\underline J(\underline y,\overline y)^{\frac1\beta})^\beta,
\ \underline y-\overline x+(2^\beta-1)\underline J(\underline y,\overline y)\bigr)
+L_\beta(\underline x)-2Q_\beta(\tfrac{\overline x+\overline y}2),$$
with $\underline J(\underline y,\overline y)=\min(J(\underline y),J(\overline y))$ (`Jlo`), and
$\underline J(\underline y,\overline y)^{1/\beta}$ written as
$\min(J(\underline y)^{1/\beta},J(\overline y)^{1/\beta})$ (equal, as $t\mapsto t^{1/\beta}$ is
increasing on $[0,\infty)$). -/
noncomputable def g_LJQ_1_lo (β xl xu yl yu : ℝ) : ℝ :=
  max (((yl - xu) ^ β⁻¹ + min (J yl ^ β⁻¹) (J yu ^ β⁻¹)) ^ β)
      (yl - xu + (2 ^ β - 1) * min (J yl) (J yu)) + L β xl - 2 * Q β ((xu + yu) / 2)

/-- [DIR], §6.3.1: $\underline{g_{LJQ,1,\beta}}$ is a lower bound of $G_\beta[b_\beta]$ on
subrectangles of $[\frac1{16},\frac14]\times[\frac12,\frac34]$, for $\beta\ge\frac12$ with
$2^\beta\le\frac32$ (in particular for $\beta\in\{\beta_0,\frac12\}$). -/
theorem g_LJQ_1_lo_le {β xl xu yl yu x y : ℝ} (hβ : 2⁻¹ ≤ β) (hs : (2 : ℝ) ^ β ≤ 3 / 2)
    (hxl : 16⁻¹ ≤ xl) (hxu : xu ≤ 4⁻¹) (hyl : 2⁻¹ ≤ yl) (hyu : yu ≤ 3 / 4)
    (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    g_LJQ_1_lo β xl xu yl yu ≤ G β (b β) x y := by
  have hβ0 : 0 < β := by linarith
  have hβ1 := le_one_of_two_rpow_le hs
  have hbx : b β x = L β x := by unfold b; rw [ite_eq_left (by linarith [hx.2])]
  have hby : b β y = J y := by
    unfold b
    rw [ite_eq_right (by linarith [hy.1])]
    split_ifs with h
    · have e : y = 2⁻¹ := le_antisymm h (hyl.trans hy.1)
      rw [e, isJ_J.2.2.2.1, Q_eq_affine]
      norm_num
    · rfl
  have hbm : b β ((x + y) / 2) = Q β ((x + y) / 2) := by
    unfold b
    rw [ite_eq_right (by linarith [hx.1, hy.1]), ite_eq_left (by linarith [hx.2, hy.2])]
  have hJ : min (J yl) (J yu) ≤ J y := Jlo_le hyl hy.1 hy.2 (by linarith)
  have hJl : 0 ≤ J yl := J_nonneg ⟨hyl, by linarith [hy.1, hy.2]⟩
  have hJu : 0 ≤ J yu := J_nonneg ⟨by linarith [hy.1, hy.2], by linarith⟩
  have hJ0 : 0 ≤ min (J yl) (J yu) := le_min hJl hJu
  have hr : 0 < β⁻¹ := inv_pos.2 hβ0
  have hd : (yl - xu) ^ β⁻¹ ≤ (y - x) ^ β⁻¹ :=
    rpow_le_rpow (by linarith) (by linarith [hx.2, hy.1]) hr.le
  have hjr : min (J yl ^ β⁻¹) (J yu ^ β⁻¹) ≤ J y ^ β⁻¹ := by
    rcases le_total (J yl) (J yu) with h | h
    · rw [min_eq_left h] at hJ
      exact (min_le_left _ _).trans (rpow_le_rpow hJl hJ hr.le)
    · rw [min_eq_right h] at hJ
      exact (min_le_right _ _).trans (rpow_le_rpow hJu hJ hr.le)
  have hA : ((yl - xu) ^ β⁻¹ + min (J yl ^ β⁻¹) (J yu ^ β⁻¹)) ^ β ≤
      ((y - x) ^ β⁻¹ + J y ^ β⁻¹) ^ β := by
    refine rpow_le_rpow (add_nonneg (rpow_nonneg (by linarith) _)
      (le_min (rpow_nonneg hJl _) (rpow_nonneg hJu _))) (add_le_add hd hjr) hβ0.le
  have h2 : 1 ≤ (2 : ℝ) ^ β := one_le_rpow one_le_two hβ0.le
  have hB : yl - xu + (2 ^ β - 1) * min (J yl) (J yu) ≤ y - x + (2 ^ β - 1) * J y := by
    nlinarith [hx.2, hy.1]
  have hL : L β xl ≤ L β x :=
    L_monotoneOn_sixteenth_quarter hβ0 hβ1 ⟨hxl, by linarith [hx.1, hx.2]⟩
      ⟨by linarith [hx.1], by linarith [hx.2]⟩ hx.1
  have hQ : Q β ((x + y) / 2) ≤ Q β ((xu + yu) / 2) :=
    Q_monotoneOn_quarter_half hs ⟨by linarith [hx.1, hy.1], by linarith [hx.2, hy.2]⟩
