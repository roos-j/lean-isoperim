/-! ### Certified values -/

/-- A certified enclosure $l\le J(x)^r\le u$ at a rational point $x\in[\frac12,1]$. -/
structure JRVal where
  /-- The point. -/
  x : ℚ
  /-- The exponent. -/
  r : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The enclosure. -/
  h : (l : ℝ) ≤ J x ^ (r : ℝ) ∧ J x ^ (r : ℝ) ≤ u

/-- A `JRVal` from a kernel-checked enclosure by the node `rpow (J x sl su) r`. -/
def JRVal.mk' (x r l u sl su : ℚ) (h : checkMem P11 [] (.rpow (.J x sl su) r) l u = true) :
    JRVal where
  x := x
  r := r
  l := l
  u := u
  h := checkMem_sound P11 hw11 [] (.rpow (.J x sl su) r) l u h

/-- A `JRVal` as an entry of the environment of the checker. -/
noncomputable def JRVal.cert (j : JRVal) : Cert := ⟨j.l, j.u, J j.x ^ (j.r : ℝ), j.h⟩

/-- Enclosure of $\log_2x^{-1}=\log(x^{-1})/\log2$ for rational $x>0$ with $x<1$ (from
`logIv` and the enclosure `ln2_mem` of $\log2$). -/
def logbInvIv (P : Params) (x : ℚ) : Option (ℚ × ℚ) :=
  match logIv P x⁻¹ with
  | some (a, b) => if 0 < a then some (rdn P.prec (a / ln2Hi), rup P.prec (b / ln2Lo)) else none
  | none => none

/-- Soundness of `logbInvIv`. -/
theorem logbInvIv_sound (P : Params) {x : ℚ} {I : ℚ × ℚ} (h : logbInvIv P x = some I) :
    Mem I (logb 2 (x : ℝ)⁻¹) := by
  unfold logbInvIv at h
  rcases hl : logIv P x⁻¹ with _ | ⟨a, b⟩ <;> rw [hl] at h
  · cases h
  simp only at h
  split_ifs at h with ha
  cases h
  obtain ⟨-, hm⟩ := logIv_sound P hl
  have h2 := ln2_mem
  simp only [Mem] at hm h2 ⊢
  push_cast at hm
  have hl2 : 0 < log 2 := log_pos one_lt_two
  have ha' : (0 : ℝ) < a := by exact_mod_cast ha
  have hlo : (0 : ℝ) < ln2Lo := by norm_num [ln2Lo]
  rw [logb]
  constructor
  · apply rdn_le_real
    push_cast
    exact div_le_div₀ (ha'.le.trans hm.1) hm.1 hl2 h2.2
  · apply le_rup_real
    push_cast
    exact div_le_div₀ (ha'.le.trans (hm.1.trans hm.2)) hm.2 hlo h2.1

/-- The Boolean check of an enclosure $l\le L_\beta(x)\le u$, $L_\beta(x)=x(\log_2x^{-1})^\beta$,
at rational $x,\beta$. -/
def lCheck (P : Params) (β x l u : ℚ) : Bool :=
  match logbInvIv P x with
  | some I => checkMem P [I] (.mul (.const x) (.rpow (.var 0) β)) l u
  | none => false

/-- Soundness of `lCheck`. -/
theorem lCheck_sound {β x l u : ℚ} (h : lCheck P11 β x l u = true) :
    (l : ℝ) ≤ L β x ∧ L β x ≤ u := by
  unfold lCheck at h
  rcases hI : logbInvIv P11 x with _ | I <;> rw [hI] at h
  · cases h
  have hΓ : EnvSound [I] (fun _ ↦ logb 2 (x : ℝ)⁻¹) := by
    intro i K hK
    cases i with
    | zero =>
      simp only [List.getElem?_cons_zero, Option.some.injEq] at hK
      subst hK
      exact logbInvIv_sound P11 hI
    | succ i => simp at hK
  have := checkMem_sound_env P11 hw11 hΓ _ l u h
  simpa [denote, L] using this

/-- A certified enclosure $l\le L_\beta(x)\le u$ at rational $\beta$, $x$. -/
structure LVal where
  /-- The exponent $\beta$. -/
  β : ℚ
  /-- The point. -/
  x : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The enclosure. -/
  h : (l : ℝ) ≤ L β x ∧ L β x ≤ u

/-- An `LVal` from a kernel-checked `lCheck`. -/
def LVal.mk' (β x l u : ℚ) (h : lCheck P11 β x l u = true) : LVal where
  β := β
  x := x
  l := l
  u := u
  h := lCheck_sound h

/-- An `LVal` as an entry of the environment of the checker. -/
noncomputable def LVal.cert (j : LVal) : Cert := ⟨j.l, j.u, L j.β j.x, j.h⟩

/-! ### Monotonicity of $L_\beta$ and $Q_\beta$ -/

/-- [DIR], §6.3.1: $L_\beta$ is increasing on $[\frac1{16},\frac14]$ for $0<\beta\le1$ (since
$L_\beta'(x)=(\log2)^{-\beta}(\log\frac1x)^{\beta-1}(\log\frac1x-\beta)$ and
$\log\frac1x\ge\log4>1$). -/
theorem L_monotoneOn_sixteenth_quarter {β : ℝ} (hβ0 : 0 < β) (hβ1 : β ≤ 1) :
    MonotoneOn (L β) (Icc 16⁻¹ 4⁻¹) := by
  have hc : ContinuousOn (L β) (Icc 16⁻¹ 4⁻¹) :=
    (continuousOn_L hβ0 hβ1).mono (Icc_subset_Icc (by norm_num) (by norm_num))
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _) hc ?_ ?_
  · intro x hx
    rw [interior_Icc] at hx
    exact (hasDerivAt_L ⟨by linarith [hx.1], by linarith [hx.2]⟩).differentiableAt
      |>.differentiableWithinAt
  · intro x hx
    rw [interior_Icc] at hx
    have hx0 : 0 < x := by linarith [hx.1]
    rw [deriv_L_eq ⟨hx0, by linarith [hx.2]⟩]
    unfold L1f
    have h4 : (4 : ℝ) ≤ x⁻¹ := by
      rw [le_inv_comm₀ (by norm_num) hx0]; linarith [hx.2]
    have hlog4 : log 4 ≤ log x⁻¹ := log_le_log (by norm_num) h4
    have h4' : log (4 : ℝ) = 2 * log 2 := by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, log_pow]; norm_num
    have hl2 := log_two_gt_d9
    have hpos : 0 < log x⁻¹ := by linarith
    have : 0 < (log 2) ^ (-β) := rpow_pos_of_pos (log_pos one_lt_two) _
    have : 0 < (log x⁻¹) ^ (-1 + β) := rpow_pos_of_pos hpos _
    have : 0 < -β + log x⁻¹ := by linarith
    positivity

/-- [DIR], §6.3.1: if $2^\beta\le\frac32$, then $Q_\beta'(x)\ge2-4x\ge0$ on $[\frac14,\frac12]$,
so $Q_\beta$ is increasing on $[\frac14,\frac12]$. -/
theorem Q_monotoneOn_quarter_half {β : ℝ} (hs : (2 : ℝ) ^ β ≤ 3 / 2) :
    MonotoneOn (Q β) (Icc 4⁻¹ 2⁻¹) := by
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _) (continuous_Q β).continuousOn
    (fun x _ ↦ (hasDerivAt_Q β x).differentiableAt.differentiableWithinAt) ?_
  intro x hx
  rw [interior_Icc] at hx
  rw [deriv_Q_eq, Q1f_eq_affine]
  have hc : 8 / 3 - 16 * x + 16 * x ^ 2 ≤ 0 := by nlinarith [hx.1, hx.2]
  nlinarith [mul_nonneg (neg_nonneg.2 hc) (sub_nonneg.2 hs), hx.2]

/-- $2^\beta\le\frac32$ implies $\beta\le1$. -/
theorem le_one_of_two_rpow_le {β : ℝ} (hs : (2 : ℝ) ^ β ≤ 3 / 2) : β ≤ 1 := by
  by_contra h
  rw [not_le] at h
  have := rpow_lt_rpow_of_exponent_lt one_lt_two h
  rw [rpow_one] at this
  linarith

/-- $2^\beta\le c$ for rational $\beta$, $c$ from a kernel-checked `checkUpper`. -/
theorem two_rpow_le_of_checkUpper {β c : ℚ}
    (h : checkUpper P11 [] (.rpow (.const 2) β) c = true) : (2 : ℝ) ^ (β : ℝ) ≤ c := by
  have := checkUpper_sound P11 hw11 [] _ c h
  simp only [denote] at this
  push_cast at this
  exact this.le

/-! ### The tight lower bound -/

/-- The tight lower bound of $G_\beta[b_\beta]$ on $[\frac1{16},\frac14]\times[\frac12,\frac34]$
([DIR], §6.3.1):
$$\underline{g_{LJQ,1,\beta}}(\underline x,\overline x,\underline y,\overline y)=
\max\bigl(((\underline y-\overline x)^{\frac1\beta}
+\underline J(\underline y,\overline y)^{\frac1\beta})^\beta,
\ \underline y-\overline x+(2^\beta-1)\underline J(\underline y,\overline y)\bigr)
+L_\beta(\underline x)-2Q_\beta(\tfrac{\overline x+\overline y}2),$$
with $\underline J(\underline y,\overline y)=\min(J(\underline y),J(\overline y))$ (`Jlo`), and
$\underline J(\underline y,\overline y)^{1/\beta}$ written as
$\min(J(\underline y)^{1/\beta},J(\overline y)^{1/\beta})$ (equal, as $t\mapsto t^{1/\beta}$ is
increasing on $[0,\infty)$). -/
noncomputable def g_LJQ_1_lo (β xl xu yl yu : ℝ) : ℝ :=
  max (((yl - xu) ^ β⁻¹ + min (J yl ^ β⁻¹) (J yu ^ β⁻¹)) ^ β)
      (yl - xu + (2 ^ β - 1) * min (J yl) (J yu)) + L β xl - 2 * Q β ((xu + yu) / 2)

/-- [DIR], §6.3.1: $\underline{g_{LJQ,1,\beta}}$ is a lower bound of $G_\beta[b_\beta]$ on
subrectangles of $[\frac1{16},\frac14]\times[\frac12,\frac34]$, for $\beta\ge\frac12$ with
$2^\beta\le\frac32$ (in particular for $\beta\in\{\beta_0,\frac12\}$). -/
theorem g_LJQ_1_lo_le {β xl xu yl yu x y : ℝ} (hβ : 2⁻¹ ≤ β) (hs : (2 : ℝ) ^ β ≤ 3 / 2)
    (hxl : 16⁻¹ ≤ xl) (hxu : xu ≤ 4⁻¹) (hyl : 2⁻¹ ≤ yl) (hyu : yu ≤ 3 / 4)
    (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    g_LJQ_1_lo β xl xu yl yu ≤ G β (b β) x y := by
  have hβ0 : 0 < β := by linarith
  have hβ1 := le_one_of_two_rpow_le hs
  have hbx : b β x = L β x := by unfold b; rw [ite_eq_left (by linarith [hx.2])]
  have hby : b β y = J y := by
    unfold b
    rw [ite_eq_right (by linarith [hy.1])]
    split_ifs with h
    · have e : y = 2⁻¹ := le_antisymm h (hyl.trans hy.1)
      rw [e, isJ_J.2.2.2.1, Q_eq_affine]
      norm_num
    · rfl
  have hbm : b β ((x + y) / 2) = Q β ((x + y) / 2) := by
    unfold b
    rw [ite_eq_right (by linarith [hx.1, hy.1]), ite_eq_left (by linarith [hx.2, hy.2])]
  have hJ : min (J yl) (J yu) ≤ J y := Jlo_le hyl hy.1 hy.2 (by linarith)
  have hJl : 0 ≤ J yl := J_nonneg ⟨hyl, by linarith [hy.1, hy.2]⟩
  have hJu : 0 ≤ J yu := J_nonneg ⟨by linarith [hy.1, hy.2], by linarith⟩
  have hJ0 : 0 ≤ min (J yl) (J yu) := le_min hJl hJu
  have hr : 0 < β⁻¹ := inv_pos.2 hβ0
  have hd : (yl - xu) ^ β⁻¹ ≤ (y - x) ^ β⁻¹ :=
    rpow_le_rpow (by linarith) (by linarith [hx.2, hy.1]) hr.le
  have hjr : min (J yl ^ β⁻¹) (J yu ^ β⁻¹) ≤ J y ^ β⁻¹ := by
    rcases le_total (J yl) (J yu) with h | h
    · rw [min_eq_left h] at hJ
      exact (min_le_left _ _).trans (rpow_le_rpow hJl hJ hr.le)
    · rw [min_eq_right h] at hJ
      exact (min_le_right _ _).trans (rpow_le_rpow hJu hJ hr.le)
  have hA : ((yl - xu) ^ β⁻¹ + min (J yl ^ β⁻¹) (J yu ^ β⁻¹)) ^ β ≤
      ((y - x) ^ β⁻¹ + J y ^ β⁻¹) ^ β := by
    refine rpow_le_rpow (add_nonneg (rpow_nonneg (by linarith) _)
      (le_min (rpow_nonneg hJl _) (rpow_nonneg hJu _))) (add_le_add hd hjr) hβ0.le
  have h2 : 1 ≤ (2 : ℝ) ^ β := one_le_rpow one_le_two hβ0.le
  have hB : yl - xu + (2 ^ β - 1) * min (J yl) (J yu) ≤ y - x + (2 ^ β - 1) * J y := by
    nlinarith [hx.2, hy.1]
  have hL : L β xl ≤ L β x :=
    L_monotoneOn_sixteenth_quarter hβ0 hβ1 ⟨hxl, by linarith [hx.1, hx.2]⟩
      ⟨by linarith [hx.1], by linarith [hx.2]⟩ hx.1
  have hQ : Q β ((x + y) / 2) ≤ Q β ((xu + yu) / 2) :=
    Q_monotoneOn_quarter_half hs ⟨by linarith [hx.1, hy.1], by linarith [hx.2, hy.2]⟩
      ⟨by linarith [hx.1, hx.2, hy.1, hy.2], by linarith [hx.2, hy.2]⟩ (by linarith [hx.2, hy.2])
  unfold G G₁ G₂ g_LJQ_1_lo
  rw [hbx, hby, hbm]
  rcases le_total (((yl - xu) ^ β⁻¹ + min (J yl ^ β⁻¹) (J yu ^ β⁻¹)) ^ β)
    (yl - xu + (2 ^ β - 1) * min (J yl) (J yu)) with h | h
  · rw [max_eq_right h]
    exact le_trans (by linarith) (le_max_right _ _)
  · rw [max_eq_left h]
    exact le_trans (by linarith) (le_max_left _ _)

/-! ### The box certificate -/

/-- The expression of the checker for $\underline{g_{LJQ,1,\beta}}$ on the rectangle
$[x_l,x_u]\times[y_l,y_u]$, with the variables `0`–`6` standing for $J(y_l)$, $J(y_u)$,
$J(y_l)^{1/\beta}$, $J(y_u)^{1/\beta}$, $(y_l-x_u)^{1/\beta}$, $L_\beta(x_l)$, $2^\beta$, and
$Q_\beta(m)=\frac23m(1-m)(12m-3)+\frac23m(1-m)(4-8m)2^\beta$, $m=\frac{x_u+y_u}2$. -/
def g1Ex (β : ℚ) (_xl xu yl yu : ℚ) : Ex :=
  .sub (.add (.max (.rpow (.add (.var 4) (.min (.var 2) (.var 3))) β)
      (.add (.const (yl - xu)) (.mul (.sub (.var 6) (.const 1)) (.min (.var 0) (.var 1)))))
      (.var 5))
    (.mul (.const 2) (.add (.const (2 / 3 * ((xu + yu) / 2) * (1 - (xu + yu) / 2) *
        (-3 + 12 * ((xu + yu) / 2))))
      (.mul (.const (2 / 3 * ((xu + yu) / 2) * (1 - (xu + yu) / 2) * (4 - 8 * ((xu + yu) / 2))))
        (.var 6))))

/-- The real meaning of `g1Ex`. -/
theorem denote_g1Ex (β xl xu yl yu : ℚ) (a b c d e f g : Cert) :
    denote (Cert.val [a, b, c, d, e, f, g]) (g1Ex β xl xu yl yu) =
      max ((e.v + min c.v d.v) ^ (β : ℝ)) (((yl - xu : ℚ) : ℝ) + (g.v - 1) * min a.v b.v) + f.v -
        2 * (((2 / 3 * ((xu + yu) / 2) * (1 - (xu + yu) / 2) * (-3 + 12 * ((xu + yu) / 2)) : ℚ) :
          ℝ) + ((2 / 3 * ((xu + yu) / 2) * (1 - (xu + yu) / 2) * (4 - 8 * ((xu + yu) / 2)) : ℚ) :
          ℝ) * g.v) := by
  simp [g1Ex, denote, Cert.val, envOf]

/-- $\underline{g_{LJQ,1,\beta}}-10^{-7}$ as a function of the corners of a rectangle in
$\mathbb R^2$ (the function $\underline f$ of [DIR], §4.1 for (6.13)). -/
noncomputable def g1_fl (β : ℝ) (zl zu : Fin 2 → ℝ) : ℝ :=
  g_LJQ_1_lo β (zl 0) (zu 0) (zl 1) (zu 1) - 1 / 10 ^ 7

/-- The Boolean box check for (6.13): the table entries are at the right points and exponents
($J(\underline y)$, $J(\overline y)$, $J(\underline y)^{1/\beta}$, $J(\overline y)^{1/\beta}$,
$(\underline y-\overline x)^{1/\beta}$, $L_\beta(\underline x)$, $2^\beta$) and the checker
certifies $\underline{g_{LJQ,1,\beta}}>10^{-7}$. -/
def g1Check (β : ℚ) (p : Box) (ja jb : JVal) (ra rb : JRVal) (d : PowVal) (l : LVal)
    (s : PowVal) : Bool :=
  ja.x == p.2.2.1 && jb.x == p.2.2.2 && ra.x == p.2.2.1 && rb.x == p.2.2.2 && ra.r == 1 / β &&
    rb.r == 1 / β && d.a == p.2.2.1 - p.2.1 && d.r == 1 / β && l.β == β && l.x == p.1 &&
    s.a == 2 && s.r == β &&
    check P11 [(ja.l, ja.u), (jb.l, jb.u), (ra.l, ra.u), (rb.l, rb.u), (d.l, d.u), (l.l, l.u),
      (s.l, s.u)] (g1Ex β p.1 p.2.1 p.2.2.1 p.2.2.2) (1 / 10 ^ 7)

/-- **Box certificate for (6.13).** If `g1Check` succeeds on the rectangle `p`, then
$\underline{g_{LJQ,1,\beta}}>10^{-7}$ on `p`. -/
theorem g1_box (β : ℚ) (p : Box) (ja jb : JVal) (ra rb : JRVal) (d : PowVal) (l : LVal)
    (s : PowVal) (h : g1Check β p ja jb ra rb d l s = true) :
    0 < g1_fl β (Box.toR p).1 (Box.toR p).2 := by
  obtain ⟨xl, xu, yl, yu⟩ := p
  simp only [g1Check, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩, h9⟩, h10⟩, h11⟩, h12⟩, hk⟩ := h
  have := check_sound P11 hw11 [ja.cert, jb.cert, ra.cert, rb.cert, d.cert, l.cert, s.cert] _ _ hk
  rw [denote_g1Ex] at this
  simp only [JVal.cert, JRVal.cert, PowVal.cert, LVal.cert, h1, h2, h3, h4, h5, h6, h7, h8, h9,
    h10, h11, h12] at this
  simp only [g1_fl, g_LJQ_1_lo, Box.toR, Matrix.cons_val_zero, Matrix.cons_val_one, Q_eq_affine]
  push_cast at this ⊢
  simp only [one_div] at this
  linarith

