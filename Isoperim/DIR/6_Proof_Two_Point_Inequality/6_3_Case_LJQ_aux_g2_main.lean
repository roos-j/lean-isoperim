/-- **(6.17)** ([DIR], §6.3.2, proof of (2)), computer-assisted:
$G_{LJQ,\beta}(\frac1{16},y)=y-\frac1{16}+(2^\beta-1)J(y)+L_\beta(\frac1{16})
-2Q_\beta(\frac{1/16+y}2)>10^{-5}$ for $(y,\beta)\in[\frac12,\frac34]\times[\frac12,1]$, by
soundness of partitioning (`Auto.DIR.pos_of_dtree`, [DIR] Fact 4.1) with the lower bound
$\underline{g_{LJQ,2}}$ (`Auto.DIR.g_LJQ_2_lo_le`) and the box certificates. -/
theorem g_LJQ_2_gt (y β : ℝ) (hy : y ∈ Icc (2⁻¹ : ℝ) (3 / 4)) (hβ : β ∈ Icc (2⁻¹ : ℝ) 1) :
    (1 : ℝ) / 10 ^ 5 < y - 16⁻¹ + (2 ^ β - 1) * J y + L β 16⁻¹ - 2 * Q β ((16⁻¹ + y) / 2) := by
  have h := pos_of_dtree g2Tree (1 / 2) (3 / 4) (1 / 2) 1 (by norm_num) (by norm_num)
    (fun z ↦ z 0 - 16⁻¹ + (2 ^ (z 1) - 1) * J (z 0) + L (z 1) 16⁻¹ -
      2 * Q (z 1) ((16⁻¹ + z 0) / 2) - 1 / 10 ^ 5)
    g2_fl ?_ g2Tree_pos ![y, β]
    (mem_Icc_toR.2 ⟨by norm_num; constructor <;> linarith [hy.1, hy.2],
      by norm_num; constructor <;> linarith [hβ.1, hβ.2]⟩)
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h
    linarith
  · intro zl zu hl hu z hz
    obtain ⟨⟨h1, h2⟩, h3, h4⟩ := le_toR_iff.1 ⟨hl, hu⟩
    norm_num at h1 h2 h3 h4
    have hz0 : z 0 ∈ Icc (zl 0) (zu 0) := ⟨hz.1 0, hz.2 0⟩
    have hz1 : z 1 ∈ Icc (zl 1) (zu 1) := ⟨hz.1 1, hz.2 1⟩
    have := g_LJQ_2_lo_le (by linarith) h3 (by linarith) h4 hz0 hz1
    simp only [g2_fl]
    linarith

