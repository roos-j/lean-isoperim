/-! ### Certified values of $J_{w_0}$ and $J_{w_0}'$ -/

/-- $x_0\in[0.5521153369715,0.552115336976]$ (from `w₀_mem_11`). -/
theorem x₀_mem_11 : x₀ ∈ Icc (0.5521153369715 : ℝ) 0.552115336976 := by
  have h := w₀_mem_11
  rw [x₀]; constructor <;> linarith [h.1, h.2]

/-- The Boolean check of an enclosure $l\le J_{w_0}(x)\le u$ by `gJwIv` (witnesses
$s_l,s_u$). -/
def jwCheck (x l u sl su : ℚ) : Bool :=
  match gJwIv P11 P11.wl P11.wu x sl su with
  | some I => decide (l ≤ I.1 ∧ I.2 ≤ u)
  | none => false

/-- Soundness of `jwCheck`. -/
theorem jwCheck_sound {x l u sl su : ℚ} (h : jwCheck x l u sl su = true) :
    (l : ℝ) ≤ gJw w₀ x ∧ gJw w₀ x ≤ u := by
  unfold jwCheck at h
  rcases he : gJwIv P11 P11.wl P11.wu x sl su with _ | ⟨a, b⟩ <;> rw [he] at h
  · cases h
  obtain ⟨h1, h2⟩ := of_decide_eq_true h
  obtain ⟨m1, m2⟩ := gJwIv_sound P11 he hw11
  have h1' : (l : ℝ) ≤ a := by exact_mod_cast h1
  have h2' : (b : ℝ) ≤ u := by exact_mod_cast h2
  exact ⟨h1'.trans m1, m2.trans h2'⟩

/-- A certified enclosure $l\le J_{w_0}(x)\le u$ at a rational point $x$. -/
structure JwVal where
  /-- The point. -/
  x : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The enclosure. -/
  h : (l : ℝ) ≤ gJw w₀ x ∧ gJw w₀ x ≤ u

/-- A `JwVal` from a kernel-checked `jwCheck`. -/
def JwVal.mk' (x l u sl su : ℚ) (h : jwCheck x l u sl su = true) : JwVal :=
  ⟨x, l, u, jwCheck_sound h⟩

/-- A certified enclosure $l\le J_{w_0}'(x)\le u$ (`DJr x`) at a rational point $x$. -/
structure DJwVal where
  /-- The point. -/
  x : ℚ
  /-- Lower bound. -/
  l : ℚ
  /-- Upper bound. -/
  u : ℚ
  /-- The enclosure. -/
  h : (l : ℝ) ≤ DJr x ∧ DJr x ≤ u

/-- A `DJwVal` from a kernel-checked enclosure by the node `DJ x zl zu`. -/
def DJwVal.mk' (x l u zl zu : ℚ) (h : checkMem P11 [] (.DJ x zl zu) l u = true) : DJwVal :=
  ⟨x, l, u, checkMem_sound P11 hw11 [] (.DJ x zl zu) l u h⟩

/-- A `JwVal` as an entry of the environment of the checker. -/
noncomputable def JwVal.cert (j : JwVal) : Cert := ⟨j.l, j.u, gJw w₀ j.x, j.h⟩

/-- A `DJwVal` as an entry of the environment of the checker. -/
noncomputable def DJwVal.cert (j : DJwVal) : Cert := ⟨j.l, j.u, DJr j.x, j.h⟩

/-- Lower end of the certified enclosure of $J(x_0)$. -/
def jx0L : ℚ := 0.505383723016

/-- Upper end of the certified enclosure of $J(x_0)$. -/
def jx0U : ℚ := 0.505383723024

/-- Certified enclosure of $J(x_0)=J_{w_0}(x_0)$. -/
theorem jx0_h : jx0L ≤ gJw w₀ x₀ ∧ gJw w₀ x₀ ≤ jx0U := by
