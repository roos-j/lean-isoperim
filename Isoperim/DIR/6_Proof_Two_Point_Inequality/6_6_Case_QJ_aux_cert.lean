/-! ### Monotonicity of $J_{w_0}$ and $J_{w_0}'$ -/

/-- $J_{w_0}$ is increasing on $[1-w_0,x_0]$. -/
theorem gJw_monotoneOn : MonotoneOn (gJw w₀) (Icc (1 - w₀) x₀) := by
  have hx₀ := x₀_mem_Ioo
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _)
    ((continuousOn_gJw w₀_pos).mono (Icc_subset_Icc le_rfl hx₀.2.le)) ?_ ?_
  · intro y hy
    rw [interior_Icc] at hy
    exact (hasDerivAt_gJw w₀_pos ⟨hy.1, hy.2.trans hx₀.2⟩).differentiableAt.differentiableWithinAt
  · intro y hy
    rw [interior_Icc] at hy
    exact ((deriv_gJw_sign w₀_pos).2.1 y ⟨hy.1, by rw [← x₀]; exact hy.2⟩).le

/-- $J_{w_0}$ is decreasing on $[x_0,1]$. -/
theorem gJw_antitoneOn : AntitoneOn (gJw w₀) (Icc x₀ 1) := by
  have hx₀ := x₀_mem_Ioo
  have hw := one_sub_w₀_lt_half
  refine antitoneOn_of_deriv_nonpos (convex_Icc _ _)
    ((continuousOn_gJw w₀_pos).mono (Icc_subset_Icc (by linarith [hx₀.1]) le_rfl)) ?_ ?_
  · intro y hy
    rw [interior_Icc] at hy
    exact (hasDerivAt_gJw w₀_pos
      ⟨by linarith [hx₀.1, hy.1], hy.2⟩).differentiableAt.differentiableWithinAt
  · intro y hy
    rw [interior_Icc] at hy
    exact ((deriv_gJw_sign w₀_pos).2.2 y ⟨by rw [← x₀]; exact hy.1, hy.2⟩).le

/-- The upper enclosure (6.2) of $J_{w_0}$ on $[a,b]$: $J_{w_0}(b)$ if $b<x_0$, $J_{w_0}(a)$ if
$a>x_0$, $J_{w_0}(x_0)$ otherwise. -/
noncomputable def Jbar (a b : ℝ) : ℝ :=
  if b < x₀ then gJw w₀ b else if x₀ < a then gJw w₀ a else gJw w₀ x₀

/-- $J_{w_0}(m)\le\overline J(a,b)$ for $1-w_0\le a\le m\le b\le1$. -/
theorem gJw_le_Jbar {a m b : ℝ} (ha : 1 - w₀ ≤ a) (ham : a ≤ m) (hmb : m ≤ b) (hb : b ≤ 1) :
    gJw w₀ m ≤ Jbar a b := by
  have hx₀ := x₀_mem_Ioo
  have hw := one_sub_w₀_lt_half
  unfold Jbar
  split_ifs with h1 h2
  · exact gJw_monotoneOn ⟨by linarith, by linarith⟩ ⟨by linarith, h1.le⟩ hmb
  · exact gJw_antitoneOn ⟨h2.le, by linarith⟩ ⟨by linarith, hb.trans' hmb⟩ ham
  · rcases le_total m x₀ with h | h
    · exact gJw_monotoneOn ⟨by linarith, h⟩ ⟨by linarith, le_rfl⟩ h
    · exact gJw_antitoneOn ⟨le_rfl, by linarith⟩ ⟨h, by linarith⟩ h

/-- $\min(J_{w_0}(a),J_{w_0}(b))\le J_{w_0}(m)$ for $1-w_0\le a\le m\le b\le1$. -/
theorem min_gJw_le {a m b : ℝ} (ha : 1 - w₀ ≤ a) (ham : a ≤ m) (hmb : m ≤ b) (hb : b ≤ 1) :
    min (gJw w₀ a) (gJw w₀ b) ≤ gJw w₀ m := by
  have hx₀ := x₀_mem_Ioo
  rcases le_total m x₀ with h | h
  · exact (min_le_left _ _).trans (gJw_monotoneOn ⟨ha, by linarith⟩ ⟨by linarith, h⟩ ham)
  · exact (min_le_right _ _).trans (gJw_antitoneOn ⟨h, by linarith⟩ ⟨by linarith, hb⟩ hmb)

/-- $|J_{w_0}'(m)|\le\max(|J_{w_0}'(a)|,|J_{w_0}'(b)|)$ for $1-w_0<a\le m\le b<1$. -/
theorem abs_DJr_le {a m b : ℝ} (ha : 1 - w₀ < a) (ham : a ≤ m) (hmb : m ≤ b) (hb : b < 1) :
    |DJr m| ≤ max (|DJr a|) (|DJr b|) := by
  have h1 := DJr_antitoneOn ⟨ha, by linarith⟩ ⟨by linarith, by linarith⟩ ham
  have h2 := DJr_antitoneOn ⟨by linarith, by linarith⟩ ⟨by linarith, hb⟩ hmb
  rw [abs_le]
  constructor
  · have := neg_abs_le (DJr b); have := le_max_right |DJr a| |DJr b|; linarith
  · have := le_abs_self (DJr a); have := le_max_left |DJr a| |DJr b|; linarith

/-- $J_{w_0}'(b)\ge0$ for $b\in(1-w_0,x_0)$. -/
theorem DJr_nonneg {b : ℝ} (hb : b ∈ Ioo (1 - w₀) x₀) : 0 ≤ DJr b := by
  have hx₀ := x₀_mem_Ioo
  rw [DJr_eq]
  have hu := affine_mem_Ioo w₀_pos (x := b) ⟨hb.1, by linarith [hb.2, hx₀.2]⟩
  have : 2⁻¹ < w₀⁻¹ * (1 - b) := by
    rw [← div_eq_inv_mul, lt_div_iff₀ w₀_pos]
    have := hb.2; rw [x₀] at this; linarith
  have := gInv_pos ⟨this, hu.2⟩
  positivity

/-! ### (6.26): the tight lower bound of $-\beta\partial_xg_{QJ,\beta,c}$ -/

/-- The tight lower bound of $-\beta\partial_xg_{QJ,\beta,c}$ ([DIR], §6.6.1), with
$\underline m=\frac{\underline x+\underline y}2$, $\overline m=\frac{\overline x+\overline y}2$,
$r=\frac1\beta-1$:
$$(\underline y-\overline x)^r+c^{\frac1\beta}(2\underline J-Q_\beta(\overline x))_+^r
J'(\overline m)\mathbf 1_{\overline m<x_0}
-c^{\frac1\beta}(2\overline J-Q_\beta(\underline x))^r\,\overline{|J'|}\,
\mathbf 1_{\text{not }\overline m<x_0}
-c^{\frac1\beta}(2\overline J-Q_\beta(\underline x))^rQ'_\beta(\underline x),$$
with $\underline J=\min(J(\underline m),J(\overline m))$,
$\overline J=\overline J(\underline m,\overline m)$,
$\overline{|J'|}=\max(|J'(\underline m)|,|J'(\overline m)|)$ ($J=J_{w_0}$). -/
noncomputable def g_QJ_1_lo (β c xl xu yl yu : ℝ) : ℝ :=
  (yl - xu) ^ (β⁻¹ - 1) +
    (if (xu + yu) / 2 < x₀ then
      c ^ β⁻¹ * (max (2 * min (gJw w₀ ((xl + yl) / 2)) (gJw w₀ ((xu + yu) / 2)) - Q β xu) 0) ^
        (β⁻¹ - 1) * DJr ((xu + yu) / 2)
    else -(c ^ β⁻¹ * (2 * Jbar ((xl + yl) / 2) ((xu + yu) / 2) - Q β xl) ^ (β⁻¹ - 1) *
      max (abs (DJr ((xl + yl) / 2))) (abs (DJr ((xu + yu) / 2))))) -
    c ^ β⁻¹ * (2 * Jbar ((xl + yl) / 2) ((xu + yu) / 2) - Q β xl) ^ (β⁻¹ - 1) * Q1f β xl

/-- [DIR], §6.6.1: $\underline{g_{QJ,1,\beta,c}}$ is a lower bound of
$-\beta\partial_xg_{QJ,\beta,c}(x,y)=(y-x)^{\frac1\beta-1}+c^{\frac1\beta}
(2J_{w_0}(\frac{x+y}2)-Q_\beta(x))^{\frac1\beta-1}(J_{w_0}'(\frac{x+y}2)-Q_\beta'(x))$ on
subrectangles of $[\frac14,\frac12]\times[\frac12,\frac58]$ (for
$\beta\in[\frac12,\frac12+\frac{31}{1024}]$, $c\ge0$). -/
theorem g_QJ_1_lo_le (β c : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) (hc : 0 ≤ c)
    {xl xu yl yu x y : ℝ} (hxl : 4⁻¹ ≤ xl) (hxu : xu ≤ 2⁻¹) (hyl : 2⁻¹ ≤ yl) (hyu : yu ≤ 5 / 8)
    (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    g_QJ_1_lo β c xl xu yl yu ≤ (y - x) ^ (β⁻¹ - 1) + c ^ β⁻¹ *
      (2 * gJw w₀ ((x + y) / 2) - Q β x) ^ (β⁻¹ - 1) * (DJr ((x + y) / 2) - Q1f β x) := by
  have hx1 := hx.1; have hx2 := hx.2; have hy1 := hy.1; have hy2 := hy.2
  have hw := w₀_mem.1
  have hβ0 : 0 < β := by linarith [hβ.1]
  have hr : 0 < β⁻¹ - 1 := by
    have : β < 1 := by linarith [hβ.2]
    have := (one_lt_inv₀ hβ0).2 this; linarith
  set r := β⁻¹ - 1
  set C := c ^ β⁻¹ with hCdef
  have hC : 0 ≤ C := rpow_nonneg hc _
  set m := (x + y) / 2 with hm
  set ml := (xl + yl) / 2 with hml
  set mu := (xu + yu) / 2 with hmu
  have hD : 0 < 2 * gJw w₀ m - Q β x :=
    two_Jw_sub_Q_pos_rect x y ⟨by linarith, by linarith⟩ ⟨by linarith, by linarith⟩ β
      ⟨hβ0.le, by linarith [hβ.2]⟩
  -- the bound $\overline D$ of $D=2J_{w_0}(m)-Q_\beta(x)$
  have hDbar : 2 * gJw w₀ m - Q β x ≤ 2 * Jbar ml mu - Q β xl := by
    have h1 := gJw_le_Jbar (a := ml) (m := m) (b := mu) (by linarith) (by linarith)
      (by linarith) (by linarith)
    have h2 := Q_mono β hβ (a := xl) (b := x) (by linarith) hx1 (by linarith)
    linarith
  have hDr : (2 * gJw w₀ m - Q β x) ^ r ≤ (2 * Jbar ml mu - Q β xl) ^ r :=
    rpow_le_rpow hD.le hDbar hr.le
  have hDr0 : 0 ≤ (2 * gJw w₀ m - Q β x) ^ r := rpow_nonneg hD.le _
  -- the first term
  have h1 : (yl - xu) ^ r ≤ (y - x) ^ r := rpow_le_rpow (by linarith) (by linarith) hr.le
  -- the third term
  have hQ1 : Q1f β x ≤ Q1f β xl := Q1f_anti β hβ (by linarith) hx1
  have hQ1x : 0 < Q1f β x := Q1f_pos β hβ ⟨by linarith, by linarith⟩
  have h3 : C * (2 * gJw w₀ m - Q β x) ^ r * Q1f β x ≤
      C * (2 * Jbar ml mu - Q β xl) ^ r * Q1f β xl := by
    have := mul_le_mul hDr hQ1 hQ1x.le (hDr0.trans hDr)
    have := mul_le_mul_of_nonneg_left this hC
    simpa only [mul_assoc] using this
  -- the middle term
  have hmI : 1 - w₀ < ml := by linarith
  have h2 : (if mu < x₀ then
      C * (max (2 * min (gJw w₀ ml) (gJw w₀ mu) - Q β xu) 0) ^ r * DJr mu
    else -(C * (2 * Jbar ml mu - Q β xl) ^ r * max (|DJr ml|) (|DJr mu|))) ≤
      C * (2 * gJw w₀ m - Q β x) ^ r * DJr m := by
    split_ifs with hmu
    · have hDl : max (2 * min (gJw w₀ ml) (gJw w₀ mu) - Q β xu) 0 ≤ 2 * gJw w₀ m - Q β x := by
        have h1 := min_gJw_le (a := ml) (m := m) (b := mu) (by linarith) (by linarith)
          (by linarith) (by linarith)
        have h2 := Q_mono β hβ (a := x) (b := xu) (by linarith) hx2 hxu
        exact max_le (by linarith) hD.le
      have hDlr := rpow_le_rpow (le_max_right _ _) hDl hr.le
      have hJ' : DJr mu ≤ DJr m := DJr_antitoneOn ⟨by linarith, by linarith⟩
        ⟨by linarith, by linarith⟩ (by linarith)
      have hJ0 : 0 ≤ DJr mu := DJr_nonneg ⟨by linarith, hmu⟩
      have := mul_le_mul hDlr hJ' hJ0 hDr0
      have := mul_le_mul_of_nonneg_left this hC
      simpa only [mul_assoc] using this
    · have hM := abs_DJr_le (a := ml) (m := m) (b := mu) hmI (by linarith) (by linarith)
        (by linarith)
      have hM0 : 0 ≤ max (|DJr ml|) (|DJr mu|) := (abs_nonneg _).trans (le_max_left _ _)
      have ha := neg_abs_le (DJr m)
      have e1 : (2 * gJw w₀ m - Q β x) ^ r * (-max (|DJr ml|) (|DJr mu|)) ≤
          (2 * gJw w₀ m - Q β x) ^ r * DJr m :=
        mul_le_mul_of_nonneg_left (by linarith) hDr0
      have e2 : (2 * Jbar ml mu - Q β xl) ^ r * max (|DJr ml|) (|DJr mu|) ≥
          (2 * gJw w₀ m - Q β x) ^ r * max (|DJr ml|) (|DJr mu|) :=
        mul_le_mul_of_nonneg_right hDr hM0
      have := mul_le_mul_of_nonneg_left (show
        -((2 * Jbar ml mu - Q β xl) ^ r * max (|DJr ml|) (|DJr mu|)) ≤
          (2 * gJw w₀ m - Q β x) ^ r * DJr m by linarith) hC
      linarith [this]
  unfold g_QJ_1_lo
  have e : C * (2 * gJw w₀ m - Q β x) ^ r * (DJr m - Q1f β x) =
      C * (2 * gJw w₀ m - Q β x) ^ r * DJr m - C * (2 * gJw w₀ m - Q β x) ^ r * Q1f β x := by
    ring
  rw [e]
  linarith

/-! ### Cases of the enclosure $\overline J$ decided by a rational enclosure of $x_0$ -/

/-- Lower end of the rational enclosure of $x_0$. -/
def x₀L : ℚ := 0.5521153369715

/-- Upper end of the rational enclosure of $x_0$. -/
def x₀U : ℚ := 0.552115336976

/-- The Boolean check that case `k` of the enclosure $\overline J(a,b)$ applies, by the rational
enclosure $[x_{0,L},x_{0,U}]\ni x_0$: `0`: $b<x_0$; `1`: $x_0<a$ and $x_0<b$; otherwise
$a\le x_0\le b$. -/
def caseOK (k : ℕ) (a b : ℚ) : Bool :=
  match k with
  | 0 => decide (b < x₀L)
  | 1 => decide (x₀U < a ∧ x₀U < b)
  | _ => decide (x₀U ≤ b ∧ a ≤ x₀L)

/-- The value of $\overline J(a,b)$ in case `k` (the environment entries `ia`, `ib`, `ix` are
$J_{w_0}(a)$, $J_{w_0}(b)$, $J_{w_0}(x_0)$). -/
def jbarEx (k ia ib ix : ℕ) : Ex :=
  match k with
  | 0 => .var ib
  | 1 => .var ia
  | _ => .var ix

/-- The meaning of `caseOK`: the comparison $b<x_0$ and the value of $\overline J(a,b)$. -/
theorem caseOK_sound {k : ℕ} {a b : ℚ} (h : caseOK k a b = true) (ρ : ℕ → ℝ) (ia ib ix : ℕ)
    (ha : ρ ia = gJw w₀ a) (hb : ρ ib = gJw w₀ b) (hx : ρ ix = gJw w₀ x₀) :
    ((b : ℝ) < x₀ ↔ k = 0) ∧ denote ρ (jbarEx k ia ib ix) = Jbar a b := by
  have h0 := x₀_mem_11
  rcases k with _ | _ | k
  · simp only [caseOK, decide_eq_true_eq] at h
    have h' : (b : ℝ) < (x₀L : ℝ) := by exact_mod_cast h
    have hb' : (b : ℝ) < x₀ := by norm_num [x₀L] at h'; linarith [h0.1]
    simp [jbarEx, denote, Jbar, hb', hb]
  · simp only [caseOK, decide_eq_true_eq] at h
    have h1 : (x₀U : ℝ) < a := by exact_mod_cast h.1
    have h2 : (x₀U : ℝ) < b := by exact_mod_cast h.2
    norm_num [x₀U] at h1 h2
    have ha' : x₀ < (a : ℝ) := by linarith [h0.2]
    have hb' : ¬ (b : ℝ) < x₀ := by linarith [h0.2]
    simp [jbarEx, denote, Jbar, hb', ha', ha]
  · simp only [caseOK, decide_eq_true_eq] at h
    have h1 : (x₀U : ℝ) ≤ b := by exact_mod_cast h.1
    have h2 : (a : ℝ) ≤ x₀L := by exact_mod_cast h.2
    norm_num [x₀U, x₀L] at h1 h2
    have ha' : ¬ x₀ < (a : ℝ) := by linarith [h0.1]
    have hb' : ¬ (b : ℝ) < x₀ := by linarith [h0.2]
    simp [jbarEx, denote, Jbar, hb', ha', hx]

/-! ### (6.26): the box certificate -/

/-- $X^r$ in the checker (the node `rpow`, omitted for $r=1$). -/
def rp (r : ℚ) (e : Ex) : Ex := if r = 1 then e else .rpow e r

/-- The real meaning of `rp`. -/
theorem denote_rp (ρ : ℕ → ℝ) (r : ℚ) (e : Ex) : denote ρ (rp r e) = denote ρ e ^ (r : ℝ) := by
  unfold rp
  split_ifs with h
  · subst h; simp
  · rfl

/-- $a^r$ for a rational $a\ge0$ ($0$ if $a=0$). -/
def powEx (r a : ℚ) : Ex := if a = 0 then .const 0 else rp r (.const a)

/-- The real meaning of `powEx` ($r\ne0$). -/
theorem denote_powEx (ρ : ℕ → ℝ) {r : ℚ} (hr : r ≠ 0) (a : ℚ) :
    denote ρ (powEx r a) = (a : ℝ) ^ (r : ℝ) := by
  unfold powEx
  split_ifs with h
  · subst h; simp [denote, Real.zero_rpow (show (r : ℝ) ≠ 0 by exact_mod_cast hr)]
  · rw [denote_rp]; rfl

/-- $2\overline J-Q_\beta(\underline x)$ in case `k` (environment of (6.26)). -/
def dbarEx (k : ℕ) (xl : ℚ) : Ex := .sub (.mul (.const 2) (jbarEx k 0 1 2)) (qEx 5 xl)

/-- The expression of the checker for $\underline{g_{QJ,1,\beta,c}}$ on $[x_l,x_u]\times[y_l,y_u]$
in case `k`, with $r=\frac1\beta-1$, $C=c^{1/\beta}$; the variables `0`–`5` stand for
$J_{w_0}(\underline m)$, $J_{w_0}(\overline m)$, $J_{w_0}(x_0)$, $J_{w_0}'(\underline m)$,
$J_{w_0}'(\overline m)$, $2^\beta$. -/
def gQJ1Ex (k : ℕ) (r C xl xu yl _yu : ℚ) : Ex :=
  .sub (.add (powEx r (yl - xu))
      (if k = 0 then
        .mul (.mul (.const C) (rp r (.max (.sub (.mul (.const 2) (.min (.var 0) (.var 1)))
          (qEx 5 xu)) (.const 0)))) (.var 4)
      else
        .neg (.mul (.mul (.const C) (rp r (dbarEx k xl))) (.max (.abs (.var 3)) (.abs (.var 4))))))
    (.mul (.mul (.const C) (rp r (dbarEx k xl))) (q1Ex 5 xl))

/-- $\underline{g_{QJ,1,\beta,c}}-10^{-5}$ as a function of the corners of a rectangle in
$\mathbb R^2$ (the function $\underline f$ of [DIR], §4.1 for (6.26)). -/
noncomputable def gQJ1_fl (β c : ℝ) (zl zu : Fin 2 → ℝ) : ℝ :=
  g_QJ_1_lo β c (zl 0) (zu 0) (zl 1) (zu 1) - 1 / 10 ^ 5

/-- The Boolean box check for (6.26): the table entries are at the right points
$\underline m$, $\overline m$, case `k` of the enclosures applies, and the checker certifies
$\underline{g_{QJ,1,\beta,c}}>10^{-5}$. -/
def gQJ1Check (k : ℕ) (r C : ℚ) (t : PowVal) (p : Box) (a b : JwVal) (d e : DJwVal) : Bool :=
  a.x == (p.1 + p.2.2.1) / 2 && b.x == (p.2.1 + p.2.2.2) / 2 && d.x == (p.1 + p.2.2.1) / 2 &&
    e.x == (p.2.1 + p.2.2.2) / 2 &&
    caseOK k ((p.1 + p.2.2.1) / 2) ((p.2.1 + p.2.2.2) / 2) &&
    check P11 [(a.l, a.u), (b.l, b.u), (jx0L, jx0U), (d.l, d.u), (e.l, e.u), (t.l, t.u)]
      (gQJ1Ex k r C p.1 p.2.1 p.2.2.1 p.2.2.2) (1 / 10 ^ 5)

/-- **Box certificate for (6.26).** If `gQJ1Check` succeeds on the rectangle `p` (with
$r=\frac1\beta-1\ne0$, $C=c^{1/\beta}$ and an enclosure `t` of $2^\beta$), then
$\underline{g_{QJ,1,\beta,c}}>10^{-5}$ on `p`. -/
theorem gQJ1_box (β c : ℝ) (r C : ℚ) (hr : (r : ℝ) = β⁻¹ - 1) (hr0 : r ≠ 0)
    (hC : (C : ℝ) = c ^ β⁻¹) (t : PowVal) (ht : t.v = 2 ^ β) (k : ℕ) (p : Box) (a b : JwVal)
    (d e : DJwVal) (h : gQJ1Check k r C t p a b d e = true) :
    0 < gQJ1_fl β c (Box.toR p).1 (Box.toR p).2 := by
  obtain ⟨xl, xu, yl, yu⟩ := p
  simp only [gQJ1Check, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨⟨ha, hb⟩, hd⟩, he⟩, hk⟩, hc⟩ := h
  have hcs := check_sound P11 hw11 [a.cert, b.cert, jx0Cert, d.cert, e.cert, t.cert] _ _ hc
  set ρ := Cert.val [a.cert, b.cert, jx0Cert, d.cert, e.cert, t.cert]
  have h0 : ρ 0 = gJw w₀ (((xl + yl) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, JwVal.cert, ha]
  have h1 : ρ 1 = gJw w₀ (((xu + yu) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, JwVal.cert, hb]
  have h2 : ρ 2 = gJw w₀ x₀ := by simp [ρ, Cert.val, envOf, jx0Cert]
  have h3 : ρ 3 = DJr (((xl + yl) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, DJwVal.cert, hd]
  have h4 : ρ 4 = DJr (((xu + yu) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, DJwVal.cert, he]
  have h5 : ρ 5 = 2 ^ β := by
    rw [← ht]; simp [ρ, Cert.val, envOf, PowVal.cert, PowVal.v]
  obtain ⟨hcase, hJ⟩ := caseOK_sound hk ρ 0 1 2 h0 h1 h2
  have hpow := denote_powEx ρ hr0 (yl - xu)
  have hdb : denote ρ (dbarEx k xl) = 2 * Jbar (((xl + yl) / 2 : ℚ) : ℝ)
      (((xu + yu) / 2 : ℚ) : ℝ) - Q β xl := by
    simp only [dbarEx, denote, hJ, denote_qEx ρ 5 xl β h5]
    push_cast; ring
  have e1 : (((xu + yu) / 2 : ℚ) : ℝ) = ((xu : ℝ) + yu) / 2 := by push_cast; ring
  have e2 : (((xl + yl) / 2 : ℚ) : ℝ) = ((xl : ℝ) + yl) / 2 := by push_cast; ring
  have hval : denote ρ (gQJ1Ex k r C xl xu yl yu) = g_QJ_1_lo β c xl xu yl yu := by
    unfold g_QJ_1_lo
    by_cases hk0 : k = 0
    · have hm : (((xu + yu) / 2 : ℚ) : ℝ) < x₀ := hcase.2 hk0
      rw [e1] at hm
      subst hk0
      simp only [gQJ1Ex, hm, ↓reduceIte, denote, hpow, denote_rp, hdb,
        denote_qEx ρ 5 xu β h5, denote_q1Ex ρ 5 xl β h5, h0, h1, h4, hr, hC, e1, e2]
      push_cast; ring
    · have hm : ¬ (((xu + yu) / 2 : ℚ) : ℝ) < x₀ := fun h ↦ hk0 (hcase.1 h)
      rw [e1] at hm
      simp only [gQJ1Ex, hk0, hm, ↓reduceIte, denote, hpow, denote_rp, hdb,
        denote_q1Ex ρ 5 xl β h5, h3, h4, hr, hC, e1, e2]
      push_cast; ring
  simp only [gQJ1_fl, Box.toR, Matrix.cons_val_zero, Matrix.cons_val_one]
  rw [hval] at hcs
  push_cast at hcs ⊢
  linarith

/-- Certified enclosure of $2^{\beta_0}=2^{0.50057}$. -/
theorem tβ₀_h : checkMem P11 [] (.rpow (.const 2) (50057 / 100000)) 1.41477241990820091
    1.41477241990820292 = true := by
  decide +kernel

/-- Certified value $2^{\beta_0}$. -/
def tβ₀ : PowVal :=
  PowVal.mk' 2 (50057 / 100000) 1.41477241990820091 1.41477241990820292 tβ₀_h

/-- `tβ₀` is $2^{\beta_0}$. -/
theorem tβ₀_v : tβ₀.v = 2 ^ β₀ := by
  simp only [PowVal.v, tβ₀, PowVal.mk', β₀]; norm_num

/-- Box certificate for (6.26) with $(\beta,c)=(\beta_0,1)$ ($r=\frac{49943}{50057}$, $C=1$). -/
theorem gQJ1_box_b0 (k : ℕ) (p : Box) (a b : JwVal) (d e : DJwVal)
    (h : gQJ1Check k (49943 / 50057) 1 tβ₀ p a b d e = true) :
    0 < gQJ1_fl β₀ 1 (Box.toR p).1 (Box.toR p).2 :=
  gQJ1_box β₀ 1 _ _ (by norm_num [β₀]) (by norm_num) (by simp) tβ₀ tβ₀_v k p a b d e h

/-- Box certificate for (6.26) with $(\beta,c)=(\frac12,c_0)$ ($r=1$, $C=c_0^2=0.994009$). -/
theorem gQJ1_box_h (k : ℕ) (p : Box) (a b : JwVal) (d e : DJwVal)
    (h : gQJ1Check k 1 (994009 / 1000000) tHalf p a b d e = true) :
    0 < gQJ1_fl 2⁻¹ c₀ (Box.toR p).1 (Box.toR p).2 :=
  gQJ1_box 2⁻¹ c₀ _ _ (by norm_num) (by norm_num)
    (by rw [inv_inv, show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, rpow_natCast]; norm_num [c₀])
    tHalf tHalf_v k p a b d e h

/-- **Soundness of partitioning for (6.26)** ([DIR], §4.1, via `Auto.DIR.pos_of_dtree`): if
$\underline{g_{QJ,1,\beta,c}}>10^{-5}$ on every rectangle of a dyadic partition tree of
$[\frac14,\frac12]\times[\frac12,\frac58]$, then $-\beta\partial_xg_{QJ,\beta,c}>10^{-5}$ there. -/
theorem gQJ1_of_tree (β c : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) (hc : 0 ≤ c)
    (t : DTree) (ht : ∀ p ∈ t.boxes (1 / 4) (1 / 2) (1 / 2) (5 / 8),
      0 < gQJ1_fl β c (Box.toR p).1 (Box.toR p).2) :
    ∀ x ∈ Icc (4⁻¹ : ℝ) 2⁻¹, ∀ y ∈ Icc (2⁻¹ : ℝ) (5 / 8), 1 / 10 ^ 5 <
      (y - x) ^ (β⁻¹ - 1) + c ^ β⁻¹ * (2 * gJw w₀ ((x + y) / 2) - Q β x) ^ (β⁻¹ - 1) *
        (DJr ((x + y) / 2) - Q1f β x) := by
  intro x hx y hy
  have h := pos_of_dtree t (1 / 4) (1 / 2) (1 / 2) (5 / 8) (by norm_num) (by norm_num)
    (fun z ↦ (z 1 - z 0) ^ (β⁻¹ - 1) + c ^ β⁻¹ *
      (2 * gJw w₀ ((z 0 + z 1) / 2) - Q β (z 0)) ^ (β⁻¹ - 1) *
        (DJr ((z 0 + z 1) / 2) - Q1f β (z 0)) - 1 / 10 ^ 5)
    (gQJ1_fl β c) ?_ ht ![x, y] (mem_Icc_toR.2 ⟨by push_cast; norm_num at hx ⊢; exact hx,
      by push_cast; norm_num at hy ⊢; exact hy⟩)
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h
    linarith
  · intro zl zu hzl hzu z hz
    obtain ⟨⟨h1, h2⟩, h3, h4⟩ := le_toR_iff.1 ⟨hzl, hzu⟩
    push_cast at h1 h2 h3 h4
    have hz0 : z 0 ∈ Icc (zl 0) (zu 0) := ⟨hz.1 0, hz.2 0⟩
    have hz1 : z 1 ∈ Icc (zl 1) (zu 1) := ⟨hz.1 1, hz.2 1⟩
    have := g_QJ_1_lo_le β c hβ hc (by linarith) (by linarith) (by linarith) (by linarith) hz0 hz1
    simp only [gQJ1_fl]
    linarith

/-! ### (6.27): the tight lower bound of $g_{QJ,2}$ and the box certificate -/

/-- The tight lower bound of $g_{QJ,2}$ ([DIR], §6.6.2):
$$\underline{g_{QJ,2}}=((\underline y-\overline x)^2+J(\overline y)^2)^{1/2}
+Q_{\frac12}(\underline x)-2\overline J(\tfrac{\underline x+\underline y}2,
\tfrac{\overline x+\overline y}2)$$ ($\overline J$ for $J_{w_0}$). -/
noncomputable def g_QJ_2_lo (xl xu yl yu : ℝ) : ℝ :=
  ((yl - xu) ^ 2 + J yu ^ 2) ^ (2⁻¹ : ℝ) + Q 2⁻¹ xl - 2 * Jbar ((xl + yl) / 2) ((xu + yu) / 2)

/-- [DIR], §6.6.2: $\underline{g_{QJ,2}}$ is a lower bound of
$g_{QJ,2}(x,y)=((y-x)^2+J(y)^2)^{1/2}+Q_{\frac12}(x)-2J_{w_0}(\frac{x+y}2)$ on subrectangles of
$[\frac14,\frac12]\times[\frac58,1]$. -/
theorem g_QJ_2_lo_le {xl xu yl yu x y : ℝ} (hxl : 4⁻¹ ≤ xl) (hxu : xu ≤ 2⁻¹) (hyl : 5 / 8 ≤ yl)
    (hyu : yu ≤ 1) (hx : x ∈ Icc xl xu) (hy : y ∈ Icc yl yu) :
    g_QJ_2_lo xl xu yl yu ≤
      ((y - x) ^ 2 + J y ^ 2) ^ (2⁻¹ : ℝ) + Q 2⁻¹ x - 2 * gJw w₀ ((x + y) / 2) := by
  have hx1 := hx.1; have hx2 := hx.2; have hy1 := hy.1; have hy2 := hy.2
  have hx₀ := x₀_mem_11
  have hw := w₀_mem.1
  have hβ : (2⁻¹ : ℝ) ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024) := ⟨le_rfl, by norm_num⟩
  have hJ : J yu ≤ J y := J_antitoneOn_Icc_x₀_one ⟨by linarith [hx₀.2], by linarith⟩
    ⟨by linarith [hx₀.2], hyu⟩ hy2
  have hJ0 : 0 ≤ J yu := J_nonneg ⟨by linarith, hyu⟩
  have hS : (yl - xu) ^ 2 + J yu ^ 2 ≤ (y - x) ^ 2 + J y ^ 2 := by
    have : 0 ≤ yl - xu := by linarith
    nlinarith
  have h1 := rpow_le_rpow (by positivity) hS (by norm_num : (0 : ℝ) ≤ 2⁻¹)
  have h2 := Q_mono 2⁻¹ hβ (a := xl) (b := x) (by linarith) hx1 (by linarith)
  have h3 := gJw_le_Jbar (a := (xl + yl) / 2) (m := (x + y) / 2) (b := (xu + yu) / 2)
    (by linarith) (by linarith) (by linarith) (by linarith)
  unfold g_QJ_2_lo
  linarith

/-- The expression of the checker for $\underline{g_{QJ,2}}$ on $[x_l,x_u]\times[y_l,y_u]$ in
case `k`; the variables `0`–`4` stand for $J(\overline y)$, $J_{w_0}(\underline m)$,
$J_{w_0}(\overline m)$, $J_{w_0}(x_0)$, $2^{1/2}$. -/
def gQJ2Ex (k : ℕ) (xl xu yl _yu : ℚ) : Ex :=
  .sub (.add (.rpow (.add (.const ((yl - xu) ^ 2)) (.npow (.var 0) 2)) (1 / 2)) (qEx 4 xl))
    (.mul (.const 2) (jbarEx k 1 2 3))

/-- $\underline{g_{QJ,2}}-10^{-7}$ as a function of the corners of a rectangle in
$\mathbb R^2$ (the function $\underline f$ of [DIR], §4.1 for (6.27)). -/
noncomputable def gQJ2_fl (zl zu : Fin 2 → ℝ) : ℝ :=
  g_QJ_2_lo (zl 0) (zu 0) (zl 1) (zu 1) - 1 / 10 ^ 7

/-- The Boolean box check for (6.27): the table entries are at the right points $\overline y$,
$\underline m$, $\overline m$, case `k` of $\overline J$ applies, and the checker certifies
$\underline{g_{QJ,2}}>10^{-7}$. -/
def gQJ2Check (k : ℕ) (p : Box) (a : JVal) (b c : JwVal) : Bool :=
  a.x == p.2.2.2 && b.x == (p.1 + p.2.2.1) / 2 && c.x == (p.2.1 + p.2.2.2) / 2 &&
    caseOK k ((p.1 + p.2.2.1) / 2) ((p.2.1 + p.2.2.2) / 2) &&
    check P11 [(a.l, a.u), (b.l, b.u), (c.l, c.u), (jx0L, jx0U), (tHalf.l, tHalf.u)]
      (gQJ2Ex k p.1 p.2.1 p.2.2.1 p.2.2.2) (1 / 10 ^ 7)

/-- **Box certificate for (6.27).** If `gQJ2Check` succeeds on the rectangle `p`, then
$\underline{g_{QJ,2}}>10^{-7}$ on `p`. -/
theorem gQJ2_box (k : ℕ) (p : Box) (a : JVal) (b c : JwVal) (h : gQJ2Check k p a b c = true) :
    0 < gQJ2_fl (Box.toR p).1 (Box.toR p).2 := by
  obtain ⟨xl, xu, yl, yu⟩ := p
  simp only [gQJ2Check, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨ha, hb⟩, hc⟩, hk⟩, hch⟩ := h
  have hcs := check_sound P11 hw11 [a.cert, b.cert, c.cert, jx0Cert, tHalf.cert] _ _ hch
  set ρ := Cert.val [a.cert, b.cert, c.cert, jx0Cert, tHalf.cert]
  have h0 : ρ 0 = J yu := by simp [ρ, Cert.val, envOf, JVal.cert, ha]
  have h1 : ρ 1 = gJw w₀ (((xl + yl) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, JwVal.cert, hb]
  have h2 : ρ 2 = gJw w₀ (((xu + yu) / 2 : ℚ) : ℝ) := by
    simp [ρ, Cert.val, envOf, JwVal.cert, hc]
  have h3 : ρ 3 = gJw w₀ x₀ := by simp [ρ, Cert.val, envOf, jx0Cert]
  have h4 : ρ 4 = 2 ^ (2⁻¹ : ℝ) := by
    rw [← tHalf_v]; simp [ρ, Cert.val, envOf, PowVal.cert, PowVal.v]
  obtain ⟨-, hJ⟩ := caseOK_sound hk ρ 1 2 3 h1 h2 h3
  have hval : denote ρ (gQJ2Ex k xl xu yl yu) = g_QJ_2_lo xl xu yl yu := by
    simp only [gQJ2Ex, denote, hJ, h0, denote_qEx ρ 4 xl 2⁻¹ h4, g_QJ_2_lo]
    push_cast
    norm_num
  simp only [gQJ2_fl, Box.toR, Matrix.cons_val_zero, Matrix.cons_val_one]
  rw [hval] at hcs
  push_cast at hcs ⊢
  linarith

/-- **Soundness of partitioning for (6.27)** ([DIR], §4.1, via `Auto.DIR.pos_of_dtree`): if
$\underline{g_{QJ,2}}>10^{-7}$ on every rectangle of a dyadic partition tree of
$[\frac14,\frac12]\times[\frac58,1]$, then $g_{QJ,2}>10^{-7}$ there. -/
theorem gQJ2_of_tree (t : DTree) (ht : ∀ p ∈ t.boxes (1 / 4) (1 / 2) (5 / 8) 1,
      0 < gQJ2_fl (Box.toR p).1 (Box.toR p).2) :
    ∀ x ∈ Icc (4⁻¹ : ℝ) 2⁻¹, ∀ y ∈ Icc (5 / 8 : ℝ) 1, 1 / 10 ^ 7 <
      ((y - x) ^ 2 + J y ^ 2) ^ (2⁻¹ : ℝ) + Q 2⁻¹ x - 2 * gJw w₀ ((x + y) / 2) := by
  intro x hx y hy
  have h := pos_of_dtree t (1 / 4) (1 / 2) (5 / 8) 1 (by norm_num) (by norm_num)
    (fun z ↦ ((z 1 - z 0) ^ 2 + J (z 1) ^ 2) ^ (2⁻¹ : ℝ) + Q 2⁻¹ (z 0) -
      2 * gJw w₀ ((z 0 + z 1) / 2) - 1 / 10 ^ 7)
    gQJ2_fl ?_ ht ![x, y] (mem_Icc_toR.2 ⟨by push_cast; norm_num at hx ⊢; exact hx,
      by push_cast; norm_num at hy ⊢; exact hy⟩)
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h
    linarith
  · intro zl zu hzl hzu z hz
    obtain ⟨⟨h1, h2⟩, h3, h4⟩ := le_toR_iff.1 ⟨hzl, hzu⟩
    push_cast at h1 h2 h3 h4
    have hz0 : z 0 ∈ Icc (zl 0) (zu 0) := ⟨hz.1 0, hz.2 0⟩
    have hz1 : z 1 ∈ Icc (zl 1) (zu 1) := ⟨hz.1 1, hz.2 1⟩
    have := g_QJ_2_lo_le (by linarith) (by linarith) (by linarith) (by linarith) hz0 hz1
    simp only [gQJ2_fl]
    linarith

end Auto.DIR
