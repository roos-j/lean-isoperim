/-!
# [DIR] §6.5 Case $QJQ$: auxiliary lemmas

This file was automatically generated by Claude.

Auxiliary results for `6_5_Case_QJQ.lean`: elementary identities for powers of $2$ and
numerical bounds for $2^\beta$, $\beta\in[\frac12,\beta_1]$, used for the polynomial $p_\beta$;
the midpoint concavity inequality and positivity of $Q_\beta$ (proof of item 2 of §6.5), and the
monotonicity in $\beta$ of $C-(A+B2^\beta)^2$ (used for the reduction to
$\beta\in\{\frac12,\beta_1\}$).
-/

@[expose] public section

namespace Auto.DIR

open Real Set

/-- Bounds for $2^\beta$ on $[\frac12,\beta_1]$ (with $\beta_1=\frac12+\frac{31}{1024}$, see
`Auto.DIR.β₁`): $1.414\le2^\beta\le1.44421$. The upper bound uses
$(2^{\beta_1})^{1024}=2^{543}\le1.44421^{1024}$, checked by kernel evaluation of natural
numbers. -/
theorem two_rpow_bounds (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) :
    (1414 / 1000 : ℝ) ≤ 2 ^ β ∧ (2 : ℝ) ^ β ≤ 144421 / 100000 := by
  constructor
  · have h1 : (2 : ℝ) ^ (2⁻¹ : ℝ) ≤ 2 ^ β := rpow_le_rpow_of_exponent_le (by norm_num) hβ.1
    have h2 : ((2 : ℝ) ^ (2⁻¹ : ℝ)) ^ (2 : ℕ) = 2 := by
      rw [← rpow_natCast, ← rpow_mul (by norm_num)]; norm_num
    have h3 : 0 ≤ (2 : ℝ) ^ (2⁻¹ : ℝ) := by positivity
    nlinarith
  · have h1 : (2 : ℝ) ^ β ≤ 2 ^ ((2⁻¹ : ℝ) + 31 / 1024) :=
      rpow_le_rpow_of_exponent_le (by norm_num) hβ.2
    refine h1.trans ?_
    have h : ((2:ℝ) ^ ((2⁻¹ : ℝ) + 31 / 1024)) ^ (1024:ℕ) = 2 ^ (543:ℕ) := by
      rw [← rpow_natCast, ← rpow_mul (by norm_num)]; norm_num
    rw [← pow_le_pow_iff_left₀ (by positivity) (by norm_num) (by norm_num : (1024:ℕ) ≠ 0), h,
      div_pow, le_div_iff₀ (by positivity)]
    have : (2:ℕ) ^ 543 * 100000 ^ 1024 ≤ 144421 ^ 1024 := by decide +kernel
    exact_mod_cast this

/-- $2^{c+\beta}=2^c\,2^\beta$. -/
theorem two_rpow_add (c β : ℝ) : (2 : ℝ) ^ (c + β) = 2 ^ c * 2 ^ β :=
  rpow_add two_pos c β

/-- $2^{2\beta}=(2^\beta)^2$. -/
theorem two_rpow_two_mul (β : ℝ) : (2 : ℝ) ^ (2 * β) = (2 ^ β) ^ 2 := by
  rw [mul_comm 2 β, rpow_mul (by norm_num)]; norm_num

/-- Midpoint concavity of the cubic $Q_\beta$ for $\beta\in[\frac12,\frac12+\frac{31}{1024}]$ and
$0\le x\le y$: $2Q_\beta(\frac{x+y}2)-Q_\beta(x)\ge Q_\beta(y)$. (For a cubic,
$2Q(\frac{x+y}2)-Q(x)-Q(y)=-Q''(\frac{x+y}2)\frac{(y-x)^2}4$, and $Q_\beta''<0$ on $[0,\infty)$.) -/
theorem two_Q_mid_sub_ge (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) (x y : ℝ)
    (hx : 0 ≤ x) (hxy : x ≤ y) : 2 * Q β ((x + y) / 2) - Q β x ≥ Q β y := by
  obtain ⟨h1, h2⟩ := two_rpow_bounds β hβ
  have e : 2 * Q β ((x + y) / 2) - Q β x - Q β y =
      (16 * 2 ^ β - 20 + (x + y) / 2 * (48 - 32 * 2 ^ β)) * (y - x) ^ 2 / 4 := by
    rw [Q_eq_affine, Q_eq_affine, Q_eq_affine]; ring
  have hk : 0 ≤ 16 * (2 : ℝ) ^ β - 20 + (x + y) / 2 * (48 - 32 * 2 ^ β) := by
    have : 0 ≤ (x + y) / 2 * (48 - 32 * (2 : ℝ) ^ β) :=
      mul_nonneg (by linarith) (by linarith)
    linarith
  have : 0 ≤ (16 * (2 : ℝ) ^ β - 20 + (x + y) / 2 * (48 - 32 * 2 ^ β)) * (y - x) ^ 2 / 4 := by
    positivity
  linarith

/-- $Q_\beta(y)>0$ for $y\in(0,1)$ and $\beta\in[\frac12,\frac12+\frac{31}{1024}]$. -/
theorem Q_pos_of_mem (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) (y : ℝ)
    (hy : y ∈ Ioo (0 : ℝ) 1) : Q β y > 0 := by
  obtain ⟨h1, h2⟩ := two_rpow_bounds β hβ
  rw [Q_eq_affine]
  have e : 2 / 3 * y * (1 - y) * (-3 + 12 * y) + 2 / 3 * y * (1 - y) * (4 - 8 * y) * 2 ^ β =
      2 / 3 * (y * (1 - y)) * (4 * 2 ^ β - 3 + y * (12 - 8 * 2 ^ β)) := by ring
  rw [e]
  have hy1 : 0 < y * (1 - y) := mul_pos hy.1 (by linarith [hy.2])
  have : 0 ≤ y * (12 - 8 * (2 : ℝ) ^ β) := mul_nonneg hy.1.le (by linarith)
  have : 0 < 4 * (2 : ℝ) ^ β - 3 + y * (12 - 8 * 2 ^ β) := by linarith
  positivity

/-- If $A+Bt>0$ for all $t\in[t_1,t_2]$, then $t\mapsto C-(A+Bt)^2$ is antitone on $[t_1,t_2]$
when $B\ge0$, and monotone when $B<0$; composed with the increasing map $\beta\mapsto2^\beta$ this
gives: $\beta\mapsto C-(A+B2^\beta)^2$ is monotone or antitone on any set $S$ on which
$A+B2^\beta>0$. -/
theorem monotoneOn_or_antitoneOn_sub_sq (A B C : ℝ) (S : Set ℝ)
    (hpos : ∀ β ∈ S, 0 < A + B * 2 ^ β) :
    MonotoneOn (fun β ↦ C - (A + B * (2 : ℝ) ^ β) ^ 2) S ∨
      AntitoneOn (fun β ↦ C - (A + B * (2 : ℝ) ^ β) ^ 2) S := by
  rcases le_or_gt 0 B with hB | hB
  · right
    intro β₁ h₁ β₂ h₂ h12
    have ht : (2 : ℝ) ^ β₁ ≤ 2 ^ β₂ := rpow_le_rpow_of_exponent_le (by norm_num) h12
    have p₁ := hpos β₁ h₁
    have : A + B * 2 ^ β₁ ≤ A + B * 2 ^ β₂ := by nlinarith
    simp only
    nlinarith
  · left
    intro β₁ h₁ β₂ h₂ h12
    have ht : (2 : ℝ) ^ β₁ ≤ 2 ^ β₂ := rpow_le_rpow_of_exponent_le (by norm_num) h12
    have p₂ := hpos β₂ h₂
    have : A + B * 2 ^ β₂ ≤ A + B * 2 ^ β₁ := by nlinarith
    simp only
    nlinarith

end Auto.DIR
