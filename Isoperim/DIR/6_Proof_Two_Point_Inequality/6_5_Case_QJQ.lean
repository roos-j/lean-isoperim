/-!
# [DIR] §6.5 Case $QJQ$: $\frac14\le x\le\frac12\le y$, $x+y\le1$

This file was automatically generated by Claude.

Source [DIR]: P. Durcik, P. Ivanisvili, J. Roos, *Sharp isoperimetric inequalities on the Hamming
cube near the critical exponent*, arXiv:2407.12674v2 (revised version, August 2026), §6.5.

This file covers Proposition 6.9 (with (6.23)), Remark 6.10, the reduction to
$\beta\in\{\frac12,\beta_1\}$ and to $y=\frac12$ via $g_{QJQ,\beta}$ (6.24), the three
monotonicity claims, the computer-assisted bound (6.25) and the polynomial $p_\beta$.

## Notation and conventions

* `β₁` : the constant $\beta_1=\frac12+\frac{31}{1024}$;
* `G_QJQ β x y`, `g_QJQ β x y`, `g_QJQ_lo β xl xu yl yu`, `p_QJQ β x` : $G_{QJQ,\beta}(x,y)$,
  $g_{QJQ,\beta}(x,y)$, $\underline{g_{QJQ,\beta}}$ and $p_\beta(x)$.
* `J` is only meaningful on $[\frac12,1]$. The derivative $J'(y)$ for $y\in[\frac12,1)$, including
  the endpoint $y=\frac12$ where it is one-sided, is written `derivWithin J (Icc 2⁻¹ 1) y`
  (this equals `deriv J y` for $y\in(\frac12,1)$).
-/

@[expose] public section

namespace Auto.DIR

open Real Set

/-- [DIR], §6.5: the region $QJQ$ ($\frac14\le x\le\frac12\le y$, $x+y\le1$) is contained in the
rectangle $[\frac14,\frac12]\times[\frac12,\frac34]$. -/
theorem caseQJQ_region (x y : ℝ) (hx : 4⁻¹ ≤ x) (hx' : x ≤ 2⁻¹) (hy : 2⁻¹ ≤ y)
    (hxy : x + y ≤ 1) : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹ ∧ y ∈ Icc (2⁻¹ : ℝ) (3 / 4) := by
  exact ⟨⟨hx, hx'⟩, ⟨hy, by linarith⟩⟩

/-- The constant $\beta_1=\frac12+\frac{31}{1024}\approx0.53$ ([DIR], Proposition 6.9). -/
noncomputable def β₁ : ℝ := 2⁻¹ + 31 / 1024

/-- [DIR], Proposition 6.9: $\beta_1\approx0.53$ (precisely, $\beta_1\in[0.53,0.531]$). -/
theorem β₁_approx : β₁ ∈ Icc (0.53 : ℝ) 0.531 := by
  norm_num [β₁]

/-- The function ([DIR], (6.23))
$$G_{QJQ,\beta}(x,y)=(y-x)^2+J(y)^2-(2Q_\beta(\tfrac{x+y}2)-Q_\beta(x))^2.$$ -/
noncomputable def G_QJQ (β x y : ℝ) : ℝ :=
  (y - x) ^ 2 + J y ^ 2 - (2 * Q β ((x + y) / 2) - Q β x) ^ 2

/-- The function ([DIR], (6.24))
$$g_{QJQ,\beta}(x,y)=(y-x)+J(y)J'(y)-(2Q_\beta(\tfrac{x+y}2)-Q_\beta(x))Q_\beta'(\tfrac{x+y}2).$$
(Here $J'(y)$ is `derivWithin J (Icc 2⁻¹ 1) y`, one-sided at $y=\frac12$.) -/
noncomputable def g_QJQ (β x y : ℝ) : ℝ :=
  (y - x) + J y * derivWithin J (Icc 2⁻¹ 1) y -
    (2 * Q β ((x + y) / 2) - Q β x) * deriv (Q β) ((x + y) / 2)

/-- [DIR], §6.5: the $y$-derivative of the left-hand side in (6.23) is $2$ times
$g_{QJQ,\beta}(x,y)$ (6.24). (Stated for $y\in(\frac12,\frac34]$, where the two-sided derivative
of `J` at $y$ is meaningful.) -/
theorem G_QJQ_deriv_y (β x y : ℝ) (hy : y ∈ Ioc (2⁻¹ : ℝ) (3 / 4)) :
    deriv (fun y ↦ G_QJQ β x y) y = 2 * g_QJQ β x y := by
  have hy' : y ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨hy.1, by linarith [hy.2]⟩
  have hJ := hasDerivAt_J_deriv hy'
  have hdw : derivWithin J (Icc 2⁻¹ 1) y = deriv J y :=
    derivWithin_of_mem_nhds (Icc_mem_nhds hy'.1 hy'.2)
  have hm : HasDerivAt (fun y : ℝ ↦ (x + y) / 2) (1 / 2) y := by
    simpa using ((hasDerivAt_id y).const_add x).div_const 2
  have hQ := (hasDerivAt_Q β ((x + y) / 2)).comp y hm
  have h := ((((hasDerivAt_id y).sub_const x).pow 2).add (hJ.pow 2)).sub
    (((hQ.const_mul 2).sub_const (Q β x)).pow 2)
  have h' : HasDerivAt (fun y ↦ G_QJQ β x y) _ y :=
    h.congr_of_eventuallyEq (Filter.Eventually.of_forall fun z ↦ by simp [G_QJQ])
  rw [h'.deriv, g_QJQ, hdw, deriv_Q_eq]
  simp only [Function.comp, id]
  push_cast
  ring

section Proof_Claim_2
/-- [DIR], §6.5, proof of item 2: first, $2Q_\beta(\frac{x+y}2)-Q_\beta(x)\ge Q_\beta(y)>0$
follows since $Q_\beta$ is concave. -/
theorem two_Q_sub_Q_ge (β : ℝ) (hβ : β ∈ Icc 2⁻¹ β₁) (x y : ℝ)
    (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) (hy : y ∈ Icc (2⁻¹ : ℝ) (3 / 4)) :
    2 * Q β ((x + y) / 2) - Q β x ≥ Q β y ∧ Q β y > 0 := by
  have hβ' : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024) := hβ
  exact ⟨two_Q_mid_sub_ge β hβ' x y (by linarith [hx.1]) (by linarith [hx.2, hy.1]),
    Q_pos_of_mem β hβ' y ⟨by linarith [hy.1], by linarith [hy.2]⟩⟩

end Proof_Claim_2

/-- [DIR], §6.5: from (5.9) we see that for each fixed $(x,y)$ the left-hand side in (6.23) is
either monotone increasing or decreasing in $\beta$ (for $\beta\in[\frac12,\beta_1]$). -/
theorem G_QJQ_monotone_or_antitone (x y : ℝ) (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹)
    (hy : y ∈ Icc (2⁻¹ : ℝ) (3 / 4)) :
    MonotoneOn (fun β ↦ G_QJQ β x y) (Icc 2⁻¹ β₁) ∨
      AntitoneOn (fun β ↦ G_QJQ β x y) (Icc 2⁻¹ β₁) := by
  have e : ∀ β, G_QJQ β x y = ((y - x) ^ 2 + J y ^ 2) -
      ((2 * (2 / 3 * ((x + y) / 2) * (1 - (x + y) / 2) * (-3 + 12 * ((x + y) / 2))) -
        2 / 3 * x * (1 - x) * (-3 + 12 * x)) +
       (2 * (2 / 3 * ((x + y) / 2) * (1 - (x + y) / 2) * (4 - 8 * ((x + y) / 2))) -
        2 / 3 * x * (1 - x) * (4 - 8 * x)) * 2 ^ β) ^ 2 := by
    intro β; rw [G_QJQ, Q_eq_affine, Q_eq_affine]; ring
  simp_rw [e]
  apply monotoneOn_or_antitoneOn_sub_sq
  intro β hβ
  obtain ⟨h1, h2⟩ := two_Q_sub_Q_ge β hβ x y hx hy
  have e' := Q_eq_affine β ((x + y) / 2)
  have e'' := Q_eq_affine β x
  linarith

/-- [DIR], §6.5: thus
$G_{QJQ,\beta}(x,y)\ge\min(G_{QJQ,1/2}(x,y),G_{QJQ,\beta_1}(x,y))$ (for $\beta\in[\frac12,\beta_1]$,
$(x,y)\in[\frac14,\frac12]\times[\frac12,\frac34]$). -/
theorem G_QJQ_ge_min (x y : ℝ) (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹)
    (hy : y ∈ Icc (2⁻¹ : ℝ) (3 / 4)) (β : ℝ) (hβ : β ∈ Icc 2⁻¹ β₁) :
    G_QJQ β x y ≥ min (G_QJQ 2⁻¹ x y) (G_QJQ β₁ x y) := by
  have h12 : (2⁻¹ : ℝ) ≤ β₁ := by norm_num [β₁]
  rcases G_QJQ_monotone_or_antitone x y hx hy with h | h
  · exact (min_le_left _ _).trans (h ⟨le_rfl, h12⟩ hβ hβ.1)
  · exact (min_le_right _ _).trans (h hβ ⟨h12, le_rfl⟩ hβ.2)

/-- [DIR], §6.5: it suffices to show the claim (Proposition 6.9) for $\beta=\frac12$ and
$\beta=\beta_1$. -/
theorem prop_6_9_of_endpoints
    (h : ∀ β ∈ ({2⁻¹, β₁} : Set ℝ), ∀ x ∈ Icc (4⁻¹ : ℝ) 2⁻¹, ∀ y ∈ Icc (2⁻¹ : ℝ) (3 / 4),
      G_QJQ β x y ≥ 0)
    (x y : ℝ) (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) (hy : y ∈ Icc (2⁻¹ : ℝ) (3 / 4)) (β : ℝ)
    (hβ : β ∈ Icc 2⁻¹ β₁) : G_QJQ β x y ≥ 0 := by
  have := G_QJQ_ge_min x y hx hy β hβ
  have h1 := h 2⁻¹ (by simp) x hx y hy
  have h2 := h β₁ (by simp) x hx y hy
  exact le_trans (le_min h1 h2) this

/-- **(6.25)** ([DIR], §6.5) (🚗). Calling
$\textsc{Partition}_2(\underline{g_{QJQ,\beta}},[\frac14,\frac12]\times[\frac12,\frac34])$ for
$\beta\in\{\frac12,\beta_1\}$ shows that
$$g_{QJQ,\beta}>10^{-5}$$
on $[\frac14,\frac12]\times[\frac12,\frac34]$.

**Discrepancy with the paper.** Statement as in the paper. Lean: tight lower bound
`Auto.DIR.g_QJQ_lo` (the paper's, corrected where $x+y>1$); partitions `g_QJQ`, `g_QJQh` of
`partitions.py` refined dyadically (340 and 1180 rectangles). -/
theorem eqn_6_25 (β : ℝ) (hβ : β ∈ ({2⁻¹, β₁} : Set ℝ)) (x y : ℝ)
    (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) (hy : y ∈ Icc (2⁻¹ : ℝ) (3 / 4)) :
    g_QJQ β x y > 10 ^ (-5 : ℤ) := by
  have e : g_QJQ β x y =
      (y - x) + J y * Checker.DJr y - (2 * Q β ((x + y) / 2) - Q β x) * Q1f β ((x + y) / 2) := by
    rw [g_QJQ, derivWithin_J_eq ⟨hy.1, by linarith [hy.2]⟩, deriv_Q_eq]
  rw [e, show (10 : ℝ) ^ (-5 : ℤ) = 1 / 10 ^ 5 by norm_num]
  rcases hβ with rfl | rfl
  · exact gQJQ_pos_h x hx y hy
  · exact gQJQ_pos_b1 x hx y hy

/-- [DIR], §6.5: we begin by showing that this quantity is strictly positive for all
$(x,y)\in[\frac14,\frac12]\times[\frac12,\frac34]$, thus reducing to the case $y=\frac12$:
for $\beta\in\{\frac12,\beta_1\}$, $G_{QJQ,\beta}(x,y)\ge G_{QJQ,\beta}(x,\frac12)$. -/
theorem G_QJQ_ge_G_QJQ_half (β : ℝ) (hβ : β ∈ ({2⁻¹, β₁} : Set ℝ)) (x y : ℝ)
    (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) (hy : y ∈ Icc (2⁻¹ : ℝ) (3 / 4)) :
    G_QJQ β x y ≥ G_QJQ β x 2⁻¹ := by
  have hJc : ContinuousOn J (Icc 2⁻¹ (3 / 4)) :=
    continuousOn_J.mono (Icc_subset_Icc le_rfl (by norm_num))
  have hmono : MonotoneOn (fun y ↦ G_QJQ β x y) (Icc 2⁻¹ (3 / 4)) := by
    refine monotoneOn_of_deriv_nonneg (convex_Icc _ _) ?_ ?_ ?_
    · unfold G_QJQ Q
      fun_prop
    · intro z hz
      rw [interior_Icc] at hz
      have hJ := (hasDerivAt_J_deriv (x := z) ⟨hz.1, by linarith [hz.2]⟩).differentiableAt
      refine DifferentiableAt.differentiableWithinAt ?_
      unfold G_QJQ Q
      fun_prop
    · intro z hz
      rw [interior_Icc] at hz
      rw [G_QJQ_deriv_y β x z ⟨hz.1, hz.2.le⟩]
      have := eqn_6_25 β hβ x z hx ⟨hz.1.le, hz.2.le⟩
      have : (0 : ℝ) < 10 ^ (-5 : ℤ) := by positivity
      linarith
  have h12 : (2⁻¹ : ℝ) ∈ Icc (2⁻¹ : ℝ) (3 / 4) := ⟨le_rfl, by norm_num⟩
  exact hmono h12 hy hy.1

/-- [DIR], §6.5: to finish the proof it now suffices to show (6.23) for $y=\frac12$, that is
$$(\tfrac12-x)^2+\tfrac14-(2Q_\beta(\tfrac x2+\tfrac14)-Q_\beta(x))^2\ge0$$
for $x\in[\frac14,\frac12]$ (here $J(\frac12)=\frac12$). -/
theorem G_QJQ_y_half_eq (β x : ℝ) :
    G_QJQ β x 2⁻¹ = (2⁻¹ - x) ^ 2 + 4⁻¹ - (2 * Q β (x / 2 + 4⁻¹) - Q β x) ^ 2 := by
  rw [G_QJQ, (J_half_eq_L_half 0).1, show (x + 2⁻¹) / 2 = x / 2 + 4⁻¹ by ring]
  norm_num

/-- The cubic polynomial ([DIR], §6.5)
$$p_\beta(x)=(18-3\cdot2^{3+\beta}+2^{3+2\beta})x^3+(2^{5+\beta}-3\cdot2^{2+2\beta}-21)x^2
+(8+3\cdot2^{1+2\beta}-7\cdot2^{1+\beta})x+2-2^{2\beta}.$$ -/
noncomputable def p_QJQ (β x : ℝ) : ℝ :=
  (18 - 3 * 2 ^ (3 + β) + 2 ^ (3 + 2 * β)) * x ^ 3 +
    (2 ^ (5 + β) - 3 * 2 ^ (2 + 2 * β) - 21) * x ^ 2 +
    (8 + 3 * 2 ^ (1 + 2 * β) - 7 * 2 ^ (1 + β)) * x + 2 - 2 ^ (2 * β)

/-- [DIR], §6.5: the left-hand side is a polynomial in $x$ that factors as
$\frac14(1-2x)^3p_\beta(x)$. -/
theorem G_QJQ_y_half_factor (β x : ℝ) :
    (2⁻¹ - x) ^ 2 + 4⁻¹ - (2 * Q β (x / 2 + 4⁻¹) - Q β x) ^ 2 =
      4⁻¹ * (1 - 2 * x) ^ 3 * p_QJQ β x := by
  simp only [Q, p_QJQ, add_comm β, two_rpow_add, two_rpow_two_mul]
  norm_num
  ring

/-- [DIR], §6.5: plugging in $\beta=\beta_1,\frac12$ one sees that the coefficients of
$x,x^2,x^3$ (in $p_\beta$) are positive. -/
theorem p_QJQ_coeffs_pos (β : ℝ) (hβ : β ∈ ({β₁, 2⁻¹} : Set ℝ)) :
    (18 : ℝ) - 3 * 2 ^ (3 + β) + 2 ^ (3 + 2 * β) > 0 ∧
      (2 : ℝ) ^ (5 + β) - 3 * 2 ^ (2 + 2 * β) - 21 > 0 ∧
      (8 : ℝ) + 3 * 2 ^ (1 + 2 * β) - 7 * 2 ^ (1 + β) > 0 := by
  have hβ' : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024) := by
    rcases hβ with rfl | rfl <;> norm_num [β₁]
  obtain ⟨h1, h2⟩ := two_rpow_bounds β hβ'
  simp only [two_rpow_add, two_rpow_two_mul]
  norm_num
  refine ⟨?_, ?_, ?_⟩ <;> nlinarith

/-- [DIR], §6.5: so $p_\beta$ is an increasing function (on $[0,\infty)$, for
$\beta\in\{\beta_1,\frac12\}$). -/
theorem p_QJQ_monotoneOn (β : ℝ) (hβ : β ∈ ({β₁, 2⁻¹} : Set ℝ)) :
    MonotoneOn (p_QJQ β) (Ici 0) := by
  obtain ⟨c3, c2, c1⟩ := p_QJQ_coeffs_pos β hβ
  intro x hx y hy hxy
  simp only [mem_Ici] at hx hy
  simp only [p_QJQ]
  have e3 := pow_le_pow_left₀ hx hxy 3
  have e2 := pow_le_pow_left₀ hx hxy 2
  nlinarith [mul_le_mul_of_nonneg_left e3 c3.le, mul_le_mul_of_nonneg_left e2 c2.le,
    mul_le_mul_of_nonneg_left hxy c1.le]

/-- [DIR], §6.5: finally, at $x=\frac14$ one computes $p_\beta(\frac14)>10^{-4}>0$ for
$\beta\in\{\beta_1,\frac12\}$. -/
theorem p_QJQ_quarter (β : ℝ) (hβ : β ∈ ({β₁, 2⁻¹} : Set ℝ)) :
    p_QJQ β 4⁻¹ > 10 ^ (-4 : ℤ) := by
  have hβ' : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024) := by
    rcases hβ with rfl | rfl <;> norm_num [β₁]
  obtain ⟨h1, h2⟩ := two_rpow_bounds β hβ'
  simp only [p_QJQ, two_rpow_add, two_rpow_two_mul]
  norm_num
  nlinarith

/-- [DIR], §6.5: the inequality
$(\frac12-x)^2+\frac14-(2Q_\beta(\frac x2+\frac14)-Q_\beta(x))^2\ge0$ for $x\in[\frac14,\frac12]$
and $\beta\in\{\frac12,\beta_1\}$. -/
theorem G_QJQ_y_half_nonneg (β : ℝ) (hβ : β ∈ ({2⁻¹, β₁} : Set ℝ)) (x : ℝ)
    (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) :
    (2⁻¹ - x) ^ 2 + 4⁻¹ - (2 * Q β (x / 2 + 4⁻¹) - Q β x) ^ 2 ≥ 0 := by
  have hβ' : β ∈ ({β₁, 2⁻¹} : Set ℝ) := by
    rcases hβ with rfl | rfl <;> simp
  have hp := p_QJQ_monotoneOn β hβ' (show (4⁻¹ : ℝ) ∈ Ici 0 by norm_num)
    (show x ∈ Ici 0 from le_trans (by norm_num) hx.1) hx.1
  have hq := p_QJQ_quarter β hβ'
  rw [G_QJQ_y_half_factor]
  have : 0 ≤ 1 - 2 * x := by linarith [hx.2]
  have : (0 : ℝ) < 10 ^ (-4 : ℤ) := by positivity
  have : 0 ≤ p_QJQ β x := by linarith
  positivity

/-- **Proposition 6.9** ([DIR], $QJQ$). Let $\beta_1=\frac12+\frac{31}{1024}\approx0.53$. For all
$(x,y)\in[\frac14,\frac12]\times[\frac12,\frac34]$ and $\beta\in[\frac12,\beta_1]$:
$$G_{QJQ,\beta}(x,y)=(y-x)^2+J(y)^2-(2Q_\beta(\tfrac{x+y}2)-Q_\beta(x))^2\ge0. \tag{6.23}$$ -/
theorem prop_6_9 (x y : ℝ) (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) (hy : y ∈ Icc (2⁻¹ : ℝ) (3 / 4))
    (β : ℝ) (hβ : β ∈ Icc 2⁻¹ β₁) : G_QJQ β x y ≥ 0 := by
  refine prop_6_9_of_endpoints (fun β hβ x hx y hy ↦ ?_) x y hx hy β hβ
  have h1 := G_QJQ_ge_G_QJQ_half β hβ x y hx hy
  have h2 := G_QJQ_y_half_nonneg β hβ x hx
  rw [← G_QJQ_y_half_eq] at h2
  linarith

end Auto.DIR
