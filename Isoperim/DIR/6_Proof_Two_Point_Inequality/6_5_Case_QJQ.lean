public import Isoperim.DIR.«3_Variants_Bobkov_Inequality».«3_0_Variants_Bobkov_Inequality»
public import Isoperim.DIR.«4_Computer_Assisted_Proofs».«4_1_Dyadic_Partitioning»

/-!
# [DIR] §6.5 Case $QJQ$: $\frac14\le x\le\frac12\le y$, $x+y\le1$

This file was automatically generated by Claude.

Source [DIR]: P. Durcik, P. Ivanisvili, J. Roos, *Sharp isoperimetric inequalities on the Hamming
cube near the critical exponent*, arXiv:2407.12674v2 (revised version, August 2026), §6.5.

This file covers Proposition 6.9 (with (6.23)), Remark 6.10, the reduction to
$\beta\in\{\frac12,\beta_1\}$ and to $y=\frac12$ via $g_{QJQ,\beta}$ (6.24), the three
monotonicity claims, the computer-assisted bound (6.25) and the polynomial $p_\beta$.

## Notation and conventions

* `β₁` : the constant $\beta_1=\frac12+\frac{31}{1024}$;
* `G_QJQ β x y`, `g_QJQ β x y`, `g_QJQ_lo β xl xu yl yu`, `p_QJQ β x` : $G_{QJQ,\beta}(x,y)$,
  $g_{QJQ,\beta}(x,y)$, $\underline{g_{QJQ,\beta}}$ and $p_\beta(x)$.
* `J` is only meaningful on $[\frac12,1]$. The derivative $J'(y)$ for $y\in[\frac12,1)$, including
  the endpoint $y=\frac12$ where it is one-sided, is written `derivWithin J (Icc (1 / 2) 1) y`
  (this equals `deriv J y` for $y\in(\frac12,1)$).
-/

@[expose] public section

namespace Auto.DIR

open Real Set

/-
\subsection{\texorpdfstring{Case $QJQ$: $\frac14\leq x\leq \frac12\leq y, x+y\leq 1$}{Case QJQ}}
\label{sec:caseQJQ}
-/

/-- [DIR], §6.5: the region $QJQ$ ($\frac14\le x\le\frac12\le y$, $x+y\le1$) is contained in the
rectangle $[\frac14,\frac12]\times[\frac12,\frac34]$. -/
theorem caseQJQ_region (x y : ℝ) (hx : 1 / 4 ≤ x) (hx' : x ≤ 1 / 2) (hy : 1 / 2 ≤ y)
    (hxy : x + y ≤ 1) : x ∈ Icc (1 / 4 : ℝ) (1 / 2) ∧ y ∈ Icc (1 / 2 : ℝ) (3 / 4) := by
  sorry

/-
See Figure \ref{fig:cases} [Figure 3].
-/

/-- The constant $\beta_1=\frac12+\frac{31}{1024}\approx0.53$ ([DIR], Proposition 6.9). -/
noncomputable def β₁ : ℝ := 1 / 2 + 31 / 1024

/-- [DIR], Proposition 6.9: $\beta_1\approx0.53$ (precisely, $\beta_1\in[0.53,0.531]$). -/
theorem β₁_approx : β₁ ∈ Icc (0.53 : ℝ) 0.531 := by
  sorry

/-- The function ([DIR], (6.23))
$$G_{QJQ,\beta}(x,y)=(y-x)^2+J(y)^2-(2Q_\beta(\tfrac{x+y}2)-Q_\beta(x))^2.$$ -/
noncomputable def G_QJQ (β x y : ℝ) : ℝ :=
  (y - x) ^ 2 + J y ^ 2 - (2 * Q β ((x + y) / 2) - Q β x) ^ 2

/-- **Proposition 6.9** ([DIR], $QJQ$). Let $\beta_1=\frac12+\frac{31}{1024}\approx0.53$. For all
$(x,y)\in[\frac14,\frac12]\times[\frac12,\frac34]$ and $\beta\in[\frac12,\beta_1]$:
$$G_{QJQ,\beta}(x,y)=(y-x)^2+J(y)^2-(2Q_\beta(\tfrac{x+y}2)-Q_\beta(x))^2\ge0. \tag{6.23}$$ -/
theorem prop_6_9 (x y : ℝ) (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2)) (hy : y ∈ Icc (1 / 2 : ℝ) (3 / 4))
    (β : ℝ) (hβ : β ∈ Icc (1 / 2) β₁) : G_QJQ β x y ≥ 0 := by
  sorry

/-- **Remark 6.10** ([DIR]). The conclusion (of Proposition 6.9) fails for
$\beta\ge\beta_1+\frac1{1024}$. (Stated for $\beta\in[\beta_1+\frac1{1024},1]$, the standing
range $\beta\le1$ of the paper.) -/
theorem rem_6_10 (β : ℝ) (hβ : β ∈ Icc (β₁ + 1 / 1024) 1) :
    ∃ x ∈ Icc (1 / 4 : ℝ) (1 / 2), ∃ y ∈ Icc (1 / 2 : ℝ) (3 / 4), G_QJQ β x y < 0 := by
  sorry

/-- [DIR], §6.5: from (5.9) we see that for each fixed $(x,y)$ the left-hand side in (6.23) is
either monotone increasing or decreasing in $\beta$ (for $\beta\in[\frac12,\beta_1]$). -/
theorem G_QJQ_monotone_or_antitone (x y : ℝ) (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2))
    (hy : y ∈ Icc (1 / 2 : ℝ) (3 / 4)) :
    MonotoneOn (fun β ↦ G_QJQ β x y) (Icc (1 / 2) β₁) ∨
      AntitoneOn (fun β ↦ G_QJQ β x y) (Icc (1 / 2) β₁) := by
  sorry

/-- [DIR], §6.5: thus
$G_{QJQ,\beta}(x,y)\ge\min(G_{QJQ,1/2}(x,y),G_{QJQ,\beta_1}(x,y))$ (for $\beta\in[\frac12,\beta_1]$,
$(x,y)\in[\frac14,\frac12]\times[\frac12,\frac34]$). -/
theorem G_QJQ_ge_min (x y : ℝ) (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2))
    (hy : y ∈ Icc (1 / 2 : ℝ) (3 / 4)) (β : ℝ) (hβ : β ∈ Icc (1 / 2) β₁) :
    G_QJQ β x y ≥ min (G_QJQ (1 / 2) x y) (G_QJQ β₁ x y) := by
  sorry

/-- [DIR], §6.5: it suffices to show the claim (Proposition 6.9) for $\beta=\frac12$ and
$\beta=\beta_1$. -/
theorem prop_6_9_of_endpoints
    (h : ∀ β ∈ ({1 / 2, β₁} : Set ℝ), ∀ x ∈ Icc (1 / 4 : ℝ) (1 / 2), ∀ y ∈ Icc (1 / 2 : ℝ) (3 / 4),
      G_QJQ β x y ≥ 0)
    (x y : ℝ) (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2)) (hy : y ∈ Icc (1 / 2 : ℝ) (3 / 4)) (β : ℝ)
    (hβ : β ∈ Icc (1 / 2) β₁) : G_QJQ β x y ≥ 0 := by
  sorry

/-- The function ([DIR], (6.24))
$$g_{QJQ,\beta}(x,y)=(y-x)+J(y)J'(y)-(2Q_\beta(\tfrac{x+y}2)-Q_\beta(x))Q_\beta'(\tfrac{x+y}2).$$
(Here $J'(y)$ is `derivWithin J (Icc (1 / 2) 1) y`, one-sided at $y=\frac12$.) -/
noncomputable def g_QJQ (β x y : ℝ) : ℝ :=
  (y - x) + J y * derivWithin J (Icc (1 / 2) 1) y -
    (2 * Q β ((x + y) / 2) - Q β x) * deriv (Q β) ((x + y) / 2)

/-- [DIR], §6.5: the $y$-derivative of the left-hand side in (6.23) is $2$ times
$g_{QJQ,\beta}(x,y)$ (6.24). (Stated for $y\in(\frac12,\frac34]$, where the two-sided derivative
of `J` at $y$ is meaningful.) -/
theorem G_QJQ_deriv_y (β x y : ℝ) (hy : y ∈ Ioc (1 / 2 : ℝ) (3 / 4)) :
    deriv (fun y ↦ G_QJQ β x y) y = 2 * g_QJQ β x y := by
  sorry

/-- [DIR], §6.5: we begin by showing that this quantity is strictly positive for all
$(x,y)\in[\frac14,\frac12]\times[\frac12,\frac34]$, thus reducing to the case $y=\frac12$:
for $\beta\in\{\frac12,\beta_1\}$, $G_{QJQ,\beta}(x,y)\ge G_{QJQ,\beta}(x,\frac12)$. -/
theorem G_QJQ_ge_G_QJQ_half (β : ℝ) (hβ : β ∈ ({1 / 2, β₁} : Set ℝ)) (x y : ℝ)
    (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2)) (hy : y ∈ Icc (1 / 2 : ℝ) (3 / 4)) :
    G_QJQ β x y ≥ G_QJQ β x (1 / 2) := by
  sorry

/-
This can be done by $\textsc{Partition}_2$. In order to formulate a tight lower bound we record
the monotonicity of the various terms appearing in \eqref{eqn:gQJQdef} [(6.24)]:
-/

/-- [DIR], §6.5, item 1: the function $x\mapsto J(x)J'(x)$ is decreasing on
$x\in[\frac12,\frac34]$ (with the one-sided derivative at $\frac12$). -/
theorem J_mul_deriv_J_antitoneOn :
    AntitoneOn (fun x ↦ J x * derivWithin J (Icc (1 / 2) 1) x) (Icc (1 / 2) (3 / 4)) := by
  sorry

section Proof_Claim_1

/-- [DIR], §6.5, proof of item 1: $(JJ')'=(J')^2-2$ using that $JJ''=-2$ (on $(\frac12,1)$). -/
theorem J_mul_deriv_J_deriv (x : ℝ) (hx : x ∈ Ioo (1 / 2 : ℝ) 1) :
    deriv (fun x ↦ J x * deriv J x) x = deriv J x ^ 2 - 2 := by
  sorry

/-- [DIR], §6.5, proof of item 1: $(J')^2$ is convex (Lemma 3.2) (on $(\frac12,1)$). -/
theorem deriv_J_sq_convexOn : ConvexOn ℝ (Ioo (1 / 2) 1) (fun x ↦ deriv J x ^ 2) := by
  sorry

/-- [DIR], §6.5, proof of item 1: evaluating $(J')^2-2$ at the endpoints $x=\frac12$ (one-sided
derivative) and $x=\frac34$ shows $(J')^2-2<-1<0$. -/
theorem deriv_J_sq_sub_two_endpoints :
    derivWithin J (Icc (1 / 2) 1) (1 / 2) ^ 2 - 2 < -1 ∧ deriv J (3 / 4) ^ 2 - 2 < -1 := by
  sorry

/-- [DIR], §6.5, proof of item 1: so (by convexity it suffices to evaluate at the endpoints)
$(J')^2-2<-1<0$ on $(\frac12,\frac34]$. -/
theorem deriv_J_sq_sub_two_lt (x : ℝ) (hx : x ∈ Ioc (1 / 2 : ℝ) (3 / 4)) :
    deriv J x ^ 2 - 2 < -1 := by
  sorry

end Proof_Claim_1

/-- [DIR], §6.5, item 2: the quantity $2Q_\beta(\frac{x+y}2)-Q_\beta(x)$ is positive, increasing
in $y$ and decreasing in $x$ (for $\beta\in[\frac12,\beta_1]$). Positivity and monotonicity in $x$
are stated on $[\frac14,\frac12]\times[\frac12,\frac34]$; monotonicity in $y$ is stated on the
region $QJQ$, i.e. for $y\in[\frac12,1-x]$, since the proof uses $Q_\beta'(\frac{x+y}2)>0$, which
requires $\frac{x+y}2\le\frac12$ (e.g. $Q_{1/2}'(\frac58)<0$). -/
theorem two_Q_sub_Q_pos_mono (β : ℝ) (hβ : β ∈ Icc (1 / 2) β₁) :
    (∀ x ∈ Icc (1 / 4 : ℝ) (1 / 2), ∀ y ∈ Icc (1 / 2 : ℝ) (3 / 4),
        2 * Q β ((x + y) / 2) - Q β x > 0) ∧
      (∀ x ∈ Icc (1 / 4 : ℝ) (1 / 2),
        MonotoneOn (fun y ↦ 2 * Q β ((x + y) / 2) - Q β x) (Icc (1 / 2) (1 - x))) ∧
      ∀ y ∈ Icc (1 / 2 : ℝ) (3 / 4),
        AntitoneOn (fun x ↦ 2 * Q β ((x + y) / 2) - Q β x) (Icc (1 / 4) (1 / 2)) := by
  sorry

section Proof_Claim_2

/-
Recall Lemma \ref{lem:Qbprop} [5.8].
-/

/-- [DIR], §6.5, proof of item 2: first, $2Q_\beta(\frac{x+y}2)-Q_\beta(x)\ge Q_\beta(y)>0$
follows since $Q_\beta$ is concave. -/
theorem two_Q_sub_Q_ge (β : ℝ) (hβ : β ∈ Icc (1 / 2) β₁) (x y : ℝ)
    (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2)) (hy : y ∈ Icc (1 / 2 : ℝ) (3 / 4)) :
    2 * Q β ((x + y) / 2) - Q β x ≥ Q β y ∧ Q β y > 0 := by
  sorry

/-- [DIR], §6.5, proof of item 2: the quantity is increasing in $y$ since $Q_\beta'>0$ on
$[0,\frac12]$. -/
theorem deriv_Q_pos (β : ℝ) (hβ : β ∈ Icc (1 / 2) β₁) (x : ℝ) (hx : x ∈ Icc (0 : ℝ) (1 / 2)) :
    deriv (Q β) x > 0 := by
  sorry

/-- [DIR], §6.5, proof of item 2: finally, the $x$-derivative is
$$Q_\beta'(\tfrac{x+y}2)-Q_\beta'(x)=Q_\beta''(\xi)\tfrac{y-x}2<0$$
where $\xi$ is a value in $[x,(x+y)/2]$ (for $x<y$). -/
theorem two_Q_sub_Q_deriv_x (β : ℝ) (hβ : β ∈ Icc (1 / 2) β₁) (x y : ℝ)
    (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2)) (hy : y ∈ Icc (1 / 2 : ℝ) (3 / 4)) (hxy : x < y) :
    deriv (fun x ↦ 2 * Q β ((x + y) / 2) - Q β x) x =
        deriv (Q β) ((x + y) / 2) - deriv (Q β) x ∧
      ∃ ξ ∈ Icc x ((x + y) / 2), deriv (Q β) ((x + y) / 2) - deriv (Q β) x =
        deriv (deriv (Q β)) ξ * ((y - x) / 2) ∧ deriv (deriv (Q β)) ξ * ((y - x) / 2) < 0 := by
  sorry

end Proof_Claim_2

/-- [DIR], §6.5, item 3: the function $x\mapsto Q_\beta'(x)$ is decreasing and positive on
$[0,\frac12]$ by Lemma 5.8 (for $\beta\in[\frac12,\beta_1]$). -/
theorem deriv_Q_antitoneOn_pos (β : ℝ) (hβ : β ∈ Icc (1 / 2) β₁) :
    AntitoneOn (deriv (Q β)) (Icc 0 (1 / 2)) ∧ ∀ x ∈ Icc (0 : ℝ) (1 / 2), deriv (Q β) x > 0 := by
  sorry

/-- The lower bound ([DIR], §6.5)
$$\underline{g_{QJQ,\beta}}(\underline x,\overline x,\underline y,\overline y)=\underline y
-\overline x+J(\overline y)J'(\overline y)-(2Q_\beta(\tfrac{\underline x+\overline y}2)
-Q_\beta(\underline x))Q'_\beta(\tfrac{\underline x+\underline y}2).$$ -/
noncomputable def g_QJQ_lo (β xl xu yl yu : ℝ) : ℝ :=
  yl - xu + J yu * derivWithin J (Icc (1 / 2) 1) yu -
    (2 * Q β ((xl + yu) / 2) - Q β xl) * deriv (Q β) ((xl + yl) / 2)

/-- [DIR], §6.5: therefore, a tight lower bound of $g_{QJQ,\beta}$ (on
$[\frac14,\frac12]\times[\frac12,\frac34]$, for $\beta\in[\frac12,\beta_1]$) is given by
$\underline{g_{QJQ,\beta}}$. -/
theorem g_QJQ_tightLowerBound (β : ℝ) (hβ : β ∈ Icc (1 / 2) β₁) :
    IsTightLowerBound₂ (g_QJQ β) (g_QJQ_lo β) (1 / 4) (1 / 2) (1 / 2) (3 / 4) := by
  sorry

/-- **(6.25)** ([DIR], §6.5) (🚗). Calling
$\textsc{Partition}_2(\underline{g_{QJQ,\beta}},[\frac14,\frac12]\times[\frac12,\frac34])$ for
$\beta\in\{\frac12,\beta_1\}$ shows that
$$g_{QJQ,\beta}>10^{-5}$$
on $[\frac14,\frac12]\times[\frac12,\frac34]$. -/
theorem eqn_6_25 (β : ℝ) (hβ : β ∈ ({1 / 2, β₁} : Set ℝ)) (x y : ℝ)
    (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2)) (hy : y ∈ Icc (1 / 2 : ℝ) (3 / 4)) :
    g_QJQ β x y > 10 ^ (-5 : ℤ) := by
  sorry

/-- [DIR], §6.5: to finish the proof it now suffices to show (6.23) for $y=\frac12$, that is
$$(\tfrac12-x)^2+\tfrac14-(2Q_\beta(\tfrac x2+\tfrac14)-Q_\beta(x))^2\ge0$$
for $x\in[\frac14,\frac12]$ (here $J(\frac12)=\frac12$). -/
theorem G_QJQ_y_half_eq (β x : ℝ) :
    G_QJQ β x (1 / 2) = (1 / 2 - x) ^ 2 + 1 / 4 - (2 * Q β (x / 2 + 1 / 4) - Q β x) ^ 2 := by
  sorry

/-- [DIR], §6.5: the inequality
$(\frac12-x)^2+\frac14-(2Q_\beta(\frac x2+\frac14)-Q_\beta(x))^2\ge0$ for $x\in[\frac14,\frac12]$
and $\beta\in\{\frac12,\beta_1\}$. -/
theorem G_QJQ_y_half_nonneg (β : ℝ) (hβ : β ∈ ({1 / 2, β₁} : Set ℝ)) (x : ℝ)
    (hx : x ∈ Icc (1 / 4 : ℝ) (1 / 2)) :
    (1 / 2 - x) ^ 2 + 1 / 4 - (2 * Q β (x / 2 + 1 / 4) - Q β x) ^ 2 ≥ 0 := by
  sorry

/-- The cubic polynomial ([DIR], §6.5)
$$p_\beta(x)=(18-3\cdot2^{3+\beta}+2^{3+2\beta})x^3+(2^{5+\beta}-3\cdot2^{2+2\beta}-21)x^2
+(8+3\cdot2^{1+2\beta}-7\cdot2^{1+\beta})x+2-2^{2\beta}.$$ -/
noncomputable def p_QJQ (β x : ℝ) : ℝ :=
  (18 - 3 * 2 ^ (3 + β) + 2 ^ (3 + 2 * β)) * x ^ 3 +
    (2 ^ (5 + β) - 3 * 2 ^ (2 + 2 * β) - 21) * x ^ 2 +
    (8 + 3 * 2 ^ (1 + 2 * β) - 7 * 2 ^ (1 + β)) * x + 2 - 2 ^ (2 * β)

/-- [DIR], §6.5: the left-hand side is a polynomial in $x$ that factors as
$\frac14(1-2x)^3p_\beta(x)$. -/
theorem G_QJQ_y_half_factor (β x : ℝ) :
    (1 / 2 - x) ^ 2 + 1 / 4 - (2 * Q β (x / 2 + 1 / 4) - Q β x) ^ 2 =
      1 / 4 * (1 - 2 * x) ^ 3 * p_QJQ β x := by
  sorry

/-- [DIR], §6.5: plugging in $\beta=\beta_1,\frac12$ one sees that the coefficients of
$x,x^2,x^3$ (in $p_\beta$) are positive. -/
theorem p_QJQ_coeffs_pos (β : ℝ) (hβ : β ∈ ({β₁, 1 / 2} : Set ℝ)) :
    (18 : ℝ) - 3 * 2 ^ (3 + β) + 2 ^ (3 + 2 * β) > 0 ∧
      (2 : ℝ) ^ (5 + β) - 3 * 2 ^ (2 + 2 * β) - 21 > 0 ∧
      (8 : ℝ) + 3 * 2 ^ (1 + 2 * β) - 7 * 2 ^ (1 + β) > 0 := by
  sorry

/-- [DIR], §6.5: so $p_\beta$ is an increasing function (on $[0,\infty)$, for
$\beta\in\{\beta_1,\frac12\}$). -/
theorem p_QJQ_monotoneOn (β : ℝ) (hβ : β ∈ ({β₁, 1 / 2} : Set ℝ)) :
    MonotoneOn (p_QJQ β) (Ici 0) := by
  sorry

/-- [DIR], §6.5: finally, at $x=\frac14$ one computes $p_\beta(\frac14)>10^{-4}>0$ for
$\beta\in\{\beta_1,\frac12\}$. -/
theorem p_QJQ_quarter (β : ℝ) (hβ : β ∈ ({β₁, 1 / 2} : Set ℝ)) :
    p_QJQ β (1 / 4) > 10 ^ (-4 : ℤ) := by
  sorry

/-- [DIR], §6.5: (actually $p_\beta(\frac14)$ is decreasing in $\beta$) (stated for
$\beta\in[\frac12,\beta_1]$). -/
theorem p_QJQ_quarter_antitoneOn : AntitoneOn (fun β ↦ p_QJQ β (1 / 4)) (Icc (1 / 2) β₁) := by
  sorry

end Auto.DIR
