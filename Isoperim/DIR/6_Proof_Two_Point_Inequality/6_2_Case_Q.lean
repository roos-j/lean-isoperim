/-- [DIR], §6.2.2: for $y\in[\frac14,\frac12]$ and $\beta\in\{\beta_0,\frac12\}$:
$f_{\beta,2}'''=0$ and
$$f_{\beta,0}'''=f_{\beta,1}'''f_{\beta,2}+3f_{\beta,1}''f_{\beta,2}'+3f_{\beta,1}'f_{\beta,2}''.$$
-/
theorem iteratedDeriv_three_f_QIII_0 (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2) (y : ℝ)
    (hy : y ∈ Icc (1 / 4 : ℝ) (1 / 2)) :
