section Case_Q_III
/-! ### §6.2.2 Far from diagonal: $\frac14\le y-x\le\frac12$, $\frac{x+y}2\ge\frac14$ -/

/-- The function ([DIR], §6.2.2)
$$G_{Q,\beta}(h,y)=\log(h^{\frac1\beta}+Q_\beta(y)^{\frac1\beta})
-\tfrac1\beta\log(2Q_\beta(y-\tfrac h2)-Q_\beta(y-h)).$$ -/
noncomputable def G_Q (β h y : ℝ) : ℝ :=
  log (h ^ (1 / β) + Q β y ^ (1 / β)) - 1 / β * log (2 * Q β (y - h / 2) - Q β (y - h))

/-- [DIR], §6.2.2: $G_{Q,\beta}(y,y)=\log(y^{\frac1\beta}+Q_\beta(y)^{\frac1\beta})
-\frac1\beta\log(2Q_\beta(\frac y2))$, and for $y\in[\frac14,\frac12]$,
$\beta\in\{\beta_0,\frac12\}$, $G_{Q,\beta}(y,y)\ge0$ is equivalent to
$y^{\frac1\beta}+Q_\beta(y)^{\frac1\beta}-(2Q_\beta(\frac y2))^{\frac1\beta}\ge0$. -/
theorem caseQ_III_G_Q_diag (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2) (y : ℝ)
    (hy : y ∈ Icc (1 / 4 : ℝ) (1 / 2)) :
    G_Q β y y = log (y ^ (1 / β) + Q β y ^ (1 / β)) - 1 / β * log (2 * Q β (y / 2)) ∧
      (G_Q β y y ≥ 0 ↔ y ^ (1 / β) + Q β y ^ (1 / β) - (2 * Q β (y / 2)) ^ (1 / β) ≥ 0) := by
  sorry

/-- The function $R_\beta(y)=y^{-1}Q_\beta(y)$ ([DIR], §6.2.2). -/
noncomputable def R (β y : ℝ) : ℝ := y⁻¹ * Q β y

/-- [DIR], §6.2.2: $R_\beta(y)=y^{-1}Q_\beta(y)=\frac23(1-y)(2^{\beta+2}-3+4(3-2^{\beta+1})y)$
for $y\ne0$. -/
theorem R_eq (β y : ℝ) (hy : y ≠ 0) :
    R β y = 2 / 3 * (1 - y) * (2 ^ (β + 2) - 3 + 4 * (3 - 2 ^ (β + 1)) * y) := by
  sorry

/-- The function $f_\beta(y)=1+R_\beta(y)^{\frac1\beta}-R_\beta(\frac y2)^{\frac1\beta}$
([DIR], §6.2.2; denoted $f_\beta$ in the paper). -/
noncomputable def f_QIII (β y : ℝ) : ℝ := 1 + R β y ^ (1 / β) - R β (y / 2) ^ (1 / β)

/-- [DIR], §6.2.2: multiplying by $y^{-\frac1\beta}$, for $y\in[\frac14,\frac12]$ and
$\beta\in\{\beta_0,\frac12\}$,
$y^{\frac1\beta}+Q_\beta(y)^{\frac1\beta}-(2Q_\beta(\frac y2))^{\frac1\beta}\ge0$ is equivalent
to $f_\beta(y)\ge0$. -/
theorem caseQ_III_iff_f_QIII (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2) (y : ℝ)
    (hy : y ∈ Icc (1 / 4 : ℝ) (1 / 2)) :
    y ^ (1 / β) + Q β y ^ (1 / β) - (2 * Q β (y / 2)) ^ (1 / β) ≥ 0 ↔ f_QIII β y ≥ 0 := by
  sorry

/-- [DIR], §6.2.2: $f_\beta(\frac12)=0$ (for $\beta\in\{\beta_0,\frac12\}$). -/
theorem f_QIII_half (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2) : f_QIII β (1 / 2) = 0 := by
  sorry

/-- [DIR], §6.2.2: for $y\in[\frac14,\frac12]$ and $\beta\in\{\beta_0,\frac12\}$,
$$f_\beta'(y)=\tfrac1\beta R_\beta(y)^{\frac1\beta-1}R_\beta'(y)
-\tfrac1{2\beta}R_\beta(\tfrac y2)^{\frac1\beta-1}R_\beta'(\tfrac y2).$$ -/
theorem deriv_f_QIII (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2) (y : ℝ)
    (hy : y ∈ Icc (1 / 4 : ℝ) (1 / 2)) :
    deriv (f_QIII β) y = 1 / β * R β y ^ (1 / β - 1) * deriv (R β) y
      - 1 / (2 * β) * R β (y / 2) ^ (1 / β - 1) * deriv (R β) (y / 2) := by
  sorry

/-- [DIR], §6.2.2: $f_\beta'(y)\le0$ is equivalent to $\beta yf_\beta'(y)\le0$ (for $y>0$ and
$\beta\in\{\beta_0,\frac12\}$). -/
theorem deriv_f_QIII_nonpos_iff (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2) (y : ℝ) (hy : 0 < y) :
    deriv (f_QIII β) y ≤ 0 ↔ β * y * deriv (f_QIII β) y ≤ 0 := by
  sorry

/-- The function $f_{\beta,0}(y)=yR_\beta(y)^{\frac1\beta-1}R_\beta'(y)$ ([DIR], §6.2.2; denoted
$f_{\beta,0}$ in the paper). -/
noncomputable def f_QIII_0 (β y : ℝ) : ℝ := y * R β y ^ (1 / β - 1) * deriv (R β) y

/-- [DIR], §6.2.2: $\beta yf_\beta'(y)=f_{\beta,0}(y)-f_{\beta,0}(y/2)$ for
$y\in[\frac14,\frac12]$ and $\beta\in\{\beta_0,\frac12\}$. -/
theorem f_QIII_deriv_eq_sub (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2) (y : ℝ)
    (hy : y ∈ Icc (1 / 4 : ℝ) (1 / 2)) :
    β * y * deriv (f_QIII β) y = f_QIII_0 β y - f_QIII_0 β (y / 2) := by
  sorry

/-- [DIR], §6.2.2: it suffices to show $f_{\beta,0}'\le0$. (Since $y/2\in[\frac18,\frac14]$, this
is needed on $[\frac18,\frac12]$: if $f_{\beta,0}'\le0$ on $[\frac18,\frac12]$, then
$f_\beta'\le0$ on $[\frac14,\frac12]$.)

**Discrepancy with the paper.** For $y\in[\frac14,\frac12]$ the identity
$\beta yf_\beta'(y)=f_{\beta,0}(y)-f_{\beta,0}(y/2)$ compares $f_{\beta,0}$ at $y$ and at
$y/2\in[\frac18,\frac14]$, so $f_\beta'\le0$ on $[\frac14,\frac12]$ needs $f_{\beta,0}$ to be
decreasing on $[\frac18,\frac12]$. The paper only proves $f_{\beta,0}'<0$ on $[\frac14,\frac12]$
(from $f_{\beta,0}'''\ge0$, (6.9) and (6.10)). The gap is easily closed and the needed fact is
true: the sign argument for $f_{\beta,0}'''\ge0$ works verbatim on $[\frac18,\frac12]$ (there
$R_\beta>0$, $R_\beta'<0$, $R_\beta''<0$), and numerically $f_{\beta,0}''(\frac18)\approx1.67$
($\beta=\beta_0$), $\approx1.64$ ($\beta=\frac12$), so $f_{\beta,0}''>0$ and $f_{\beta,0}'<0$ on
$[\frac18,\frac12]$ (numerically $\max_{[\frac18,\frac12]}f_{\beta,0}'=f_{\beta,0}'(\frac12)
\approx-0.66$). The Lean statement states the reduction with the correct interval
$[\frac18,\frac12]$; the missing fact is `Auto.DIR.deriv_f_QIII_0_neg_Icc_eighth` (not in the
paper). -/
theorem caseQ_III_suffices_f_QIII_0 (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2)
    (h : ∀ y ∈ Icc (1 / 8 : ℝ) (1 / 2), deriv (f_QIII_0 β) y ≤ 0) :
    ∀ y ∈ Icc (1 / 4 : ℝ) (1 / 2), deriv (f_QIII β) y ≤ 0 := by
  sorry

/-- The function $f_{\beta,1}(y)=R_\beta(y)^{\frac1\beta-1}$ ([DIR], §6.2.2; denoted
$f_{\beta,1}$ in the paper). -/
noncomputable def f_QIII_1 (β y : ℝ) : ℝ := R β y ^ (1 / β - 1)

/-- The function $f_{\beta,2}(y)=yR_\beta'(y)$ ([DIR], §6.2.2; denoted $f_{\beta,2}$ in the
paper). -/
noncomputable def f_QIII_2 (β y : ℝ) : ℝ := y * deriv (R β) y

/-- [DIR], §6.2.2: $f_{\beta,0}(y)=f_{\beta,1}(y)f_{\beta,2}(y)$. -/
theorem f_QIII_0_eq_mul (β y : ℝ) : f_QIII_0 β y = f_QIII_1 β y * f_QIII_2 β y := by
  sorry

/-- [DIR], §6.2.2: $R_\beta\ge0$ and $R_\beta'\le0$ on $[\frac14,\frac12]$, hence
$f_{\beta,1}\ge0$ and $f_{\beta,2}\le0$ on this interval (for $\beta\in\{\beta_0,\frac12\}$). -/
theorem f_QIII_1_nonneg_f_QIII_2_nonpos (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2) (y : ℝ)
    (hy : y ∈ Icc (1 / 4 : ℝ) (1 / 2)) :
    R β y ≥ 0 ∧ deriv (R β) y ≤ 0 ∧ f_QIII_1 β y ≥ 0 ∧ f_QIII_2 β y ≤ 0 := by
  sorry

/-- [DIR], §6.2.2: for $y\in[\frac14,\frac12]$ and $\beta\in\{\beta_0,\frac12\}$,
$$f_{\beta,1}'=(\tfrac1\beta-1)R_\beta^{\frac1\beta-2}R_\beta',\quad
f_{\beta,1}''=(\tfrac1\beta-1)(\tfrac1\beta-2)R_\beta^{\frac1\beta-3}(R_\beta')^2
+(\tfrac1\beta-1)R_\beta^{\frac1\beta-2}R_\beta'',$$
$$f_{\beta,1}'''=(\tfrac1\beta-1)(\tfrac1\beta-2)\big((\tfrac1\beta-3)R_\beta^{\frac1\beta-4}
(R_\beta')^3+3R_\beta^{\frac1\beta-3}R_\beta'R_\beta''\big).$$ -/
theorem derivs_f_QIII_1 (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2) (y : ℝ)
    (hy : y ∈ Icc (1 / 4 : ℝ) (1 / 2)) :
    deriv (f_QIII_1 β) y = (1 / β - 1) * R β y ^ (1 / β - 2) * deriv (R β) y ∧
    deriv (deriv (f_QIII_1 β)) y =
      (1 / β - 1) * (1 / β - 2) * R β y ^ (1 / β - 3) * (deriv (R β) y) ^ 2
        + (1 / β - 1) * R β y ^ (1 / β - 2) * deriv (deriv (R β)) y ∧
    iteratedDeriv 3 (f_QIII_1 β) y =
      (1 / β - 1) * (1 / β - 2) * ((1 / β - 3) * R β y ^ (1 / β - 4) * (deriv (R β) y) ^ 3
        + 3 * R β y ^ (1 / β - 3) * deriv (R β) y * deriv (deriv (R β)) y) := by
  sorry

/-- [DIR], §6.2.2: for $\beta\in\{\beta_0,\frac12\}$: $R_\beta''\le0$, $R_\beta'''=0$ (on
$(0,\infty)$), and $\frac1\beta>1$, $\frac1\beta\le2$, $\frac1\beta<3$. -/
theorem R_derivs_one_div_β (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2) :
    (∀ y > 0, deriv (deriv (R β)) y ≤ 0 ∧ iteratedDeriv 3 (R β) y = 0) ∧
      1 / β > 1 ∧ 1 / β ≤ 2 ∧ 1 / β < 3 := by
  sorry

/-- [DIR], §6.2.2: $f_{\beta,1}'\le0$, $f_{\beta,1}''\le0$ and $f_{\beta,1}'''\le0$ on
$[\frac14,\frac12]$ (for $\beta\in\{\beta_0,\frac12\}$). -/
theorem derivs_f_QIII_1_nonpos (β : ℝ) (hβ : β = β₀ ∨ β = 1 / 2) (y : ℝ)
    (hy : y ∈ Icc (1 / 4 : ℝ) (1 / 2)) :
