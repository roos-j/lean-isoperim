      MonotoneOn (fun t ↦ 1 - 1 / 3 * (1 - 4 * t ^ 2) * (1 - 4 * α₁ (1 / 2) * t) *
        (3 - 4 * α₁ (1 / 2) * t)) (Icc 0 (1 / 4)) := by
  sorry

