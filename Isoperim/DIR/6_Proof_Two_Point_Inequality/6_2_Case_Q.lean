theorem eqn_6_6 (β : ℝ) (hβ : β = 1 / 2 ∨ β = β₀) (x y : ℝ) (hx : 0 ≤ x) (hxy : x ≤ y)
    (hy : y ≤ 1 / 2) (hxy' : (x + y) / 2 ≥ 1 / 4) : G₁ β (Q β) x y ≥ 0 := by
