/-- **(6.9)** ([DIR], §6.2.2). For $\beta\in\{\beta_0,\frac12\}$: $f_{\beta,0}''(\frac14)>3.2$. -/
theorem eqn_6_9 (β : ℝ) (hβ : β = β₀ ∨ β = 2⁻¹) :
    deriv (deriv (f_QIII_0 β)) 4⁻¹ > 3.2 := by
  have hβ' : β = 2⁻¹ ∨ β = β₀ := hβ.symm
