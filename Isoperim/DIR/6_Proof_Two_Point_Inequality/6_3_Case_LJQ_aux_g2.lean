/-!
# [DIR] §6.3.2 Case LJQ, proof of (2): a tight lower bound of $G_{LJQ,\beta}(\frac1{16},y)$

This file was automatically generated by Claude.

Auxiliary file of `6_3_Case_LJQ.lean` for the computer-assisted claim (6.17) ([DIR], §6.3.2,
proof of (2)):

* $L_\beta(\frac1{16})=\frac{(2^\beta)^2}{16}$, $Q_\beta(t)$ is increasing in $\beta$ for
  $t\in[0,\frac12]$, and $Q_\beta$ lies below its tangents on $[\frac9{32},\frac{13}{32}]$
  ($\frac12\le\beta\le1$);
* the tight lower bound $\underline{g_{LJQ,2}}$ (a corrected version of the paper's, see its
  docstring) and its lower-bound property (`g_LJQ_2_lo_le`);
* the box certificate `g2_box`: $\underline{g_{LJQ,2}}>10^{-5}$ on a rectangle (in the
  coordinates $(y,\beta)$) by one kernel evaluation of the verified interval checker.
-/

@[expose] public section

namespace Auto.DIR

open Real Set Checker

/-- $L_\beta(\frac1{16})=16^{-1}4^\beta=\frac{(2^\beta)^2}{16}$. -/
theorem L_sixteenth (β : ℝ) : L β 16⁻¹ = (2 ^ β) ^ 2 / 16 := by
  have h : logb 2 ((16 : ℝ)⁻¹)⁻¹ = 4 := by
    rw [inv_inv, show (16 : ℝ) = 2 ^ 4 by norm_num, Real.logb_pow,
      Real.logb_self_eq_one one_lt_two]
    norm_num
  rw [L, h, show (4 : ℝ) = 2 * 2 by norm_num, mul_rpow (by norm_num) (by norm_num)]
  ring

/-- For $t\in[0,\frac12]$, $\beta\mapsto Q_\beta(t)$ is increasing ($Q_\beta(t)$ is affine in
$2^\beta$ with coefficient $\frac23t(1-t)(4-8t)\ge0$). -/
theorem Q_mono_β {t β β' : ℝ} (ht : t ∈ Icc (0 : ℝ) 2⁻¹) (h : β ≤ β') : Q β t ≤ Q β' t := by
  rw [Q_eq_affine, Q_eq_affine]
  have h2 : (2 : ℝ) ^ β ≤ 2 ^ β' := rpow_le_rpow_of_exponent_le one_le_two h
  have hc : 0 ≤ 2 / 3 * t * (1 - t) * (4 - 8 * t) := by
    have := ht.1; have := ht.2
    have : 0 ≤ 1 - t := by linarith
    have : 0 ≤ 4 - 8 * t := by linarith
    positivity
  nlinarith

/-- For $\frac12\le\beta\le1$ and $t,m\in[\frac9{32},\frac{13}{32}]$, $Q_\beta$ lies below its
tangent at $m$: $Q_\beta(t)\le Q_\beta(m)+Q_\beta'(m)(t-m)$. -/
theorem Q_le_tangent {β t m : ℝ} (hβ : β ∈ Icc (2⁻¹ : ℝ) 1) (ht : t ∈ Icc (9 / 32 : ℝ) (13 / 32))
    (hm : m ∈ Icc (9 / 32 : ℝ) (13 / 32)) : Q β t ≤ Q β m + Q1f β m * (t - m) := by
  have hs1 := two_rpow_gt_of_half_le hβ.1
  have hs2 := two_rpow_le_two_of_le_one hβ.2
  set s := (2 : ℝ) ^ β with hs
  have key : Q β t - (Q β m + Q1f β m * (t - m)) =
      (t - m) ^ 2 * (2 / 3 * (15 - 12 * s - (12 - 8 * s) * (t + 2 * m))) := by
    rw [Q_eq_affine, Q_eq_affine, Q1f_eq_affine]; ring
  have hK : 2 / 3 * (15 - 12 * s - (12 - 8 * s) * (t + 2 * m)) ≤ 0 := by
    nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ s - 1.414)
      (by linarith [ht.2, hm.2] : (0 : ℝ) ≤ 12 - 8 * (t + 2 * m)), ht.1, hm.1]
  nlinarith [mul_nonpos_of_nonneg_of_nonpos (sq_nonneg (t - m)) hK]

/-- The tight lower bound of $G_{LJQ,\beta}(\frac1{16},y)$ on $[\frac12,\frac34]\times[\frac12,1]$
(coordinates $(y,\beta)$, [DIR], §6.3.2, proof of (2)):
$$\underline{g_{LJQ,2}}(\underline y,\overline y,\underline\beta,\overline\beta)=
\underline y-\tfrac1{16}+(2^{\underline\beta}-1)\underline J(\underline y,\overline y)
+L_{\underline\beta}(\tfrac1{16})-2\bigl(Q_{\overline\beta}(m)+|Q_{\overline\beta}'(m)|
\tfrac{\overline y-\underline y}4\bigr),\qquad m=\tfrac1{32}+\tfrac{\underline y+\overline y}4,$$
with $\underline J(\underline y,\overline y)=\min(J(\underline y),J(\overline y))$ and
$L_{\underline\beta}(\frac1{16})=\frac{(2^{\underline\beta})^2}{16}$.

**Discrepancy with the paper.** Paper: $-2Q_{\overline\beta}(\frac1{32}+\frac{\overline y}2)$.
Lean: $-2(Q_{\overline\beta}(m)+|Q_{\overline\beta}'(m)|\frac{\overline y-\underline y}4)$
(tangent bound at the midpoint $m$ of $[\frac1{32}+\frac{\underline y}2,
\frac1{32}+\frac{\overline y}2]$). -/
noncomputable def g_LJQ_2_lo (yl yu βl βu : ℝ) : ℝ :=
  yl - 16⁻¹ + (2 ^ βl - 1) * min (J yl) (J yu) + (2 ^ βl) ^ 2 / 16 -
    2 * (Q βu (32⁻¹ + (yl + yu) / 4) + abs (Q1f βu (32⁻¹ + (yl + yu) / 4)) * ((yu - yl) / 4))

/-- [DIR], §6.3.2, proof of (2): $\underline{g_{LJQ,2}}$ is a lower bound of
$G_{LJQ,\beta}(\frac1{16},y)=y-\frac1{16}+(2^\beta-1)J(y)+L_\beta(\frac1{16})
-2Q_\beta(\frac{1/16+y}2)$ on subrectangles of $[\frac12,\frac34]\times[\frac12,1]$. -/
theorem g_LJQ_2_lo_le {yl yu βl βu y β : ℝ} (hyl : 2⁻¹ ≤ yl) (hyu : yu ≤ 3 / 4)
    (hβl : 2⁻¹ ≤ βl) (hβu : βu ≤ 1) (hy : y ∈ Icc yl yu) (hβ : β ∈ Icc βl βu) :
    g_LJQ_2_lo yl yu βl βu ≤
      y - 16⁻¹ + (2 ^ β - 1) * J y + L β 16⁻¹ - 2 * Q β ((16⁻¹ + y) / 2) := by
  have hJ : min (J yl) (J yu) ≤ J y := Jlo_le hyl hy.1 hy.2 (by linarith)
  have hJ0 : 0 ≤ min (J yl) (J yu) :=
    le_min (J_nonneg ⟨hyl, by linarith [hy.1, hy.2]⟩)
      (J_nonneg ⟨by linarith [hy.1, hy.2], by linarith⟩)
  have h2 : (2 : ℝ) ^ βl ≤ 2 ^ β := rpow_le_rpow_of_exponent_le one_le_two hβ.1
  have h1 : 1 ≤ (2 : ℝ) ^ βl := one_le_rpow one_le_two (by linarith)
  have hJt : (2 ^ βl - 1) * min (J yl) (J yu) ≤ (2 ^ β - 1) * J y := by nlinarith
  have hL : (2 ^ βl) ^ 2 / 16 ≤ L β 16⁻¹ := by
    rw [L_sixteenth]
    have : (0 : ℝ) ≤ 2 ^ βl := by linarith
    nlinarith
  set t := (16⁻¹ + y) / 2 with ht
  set m := 32⁻¹ + (yl + yu) / 4 with hm
  have htI : t ∈ Icc (9 / 32 : ℝ) (13 / 32) := ⟨by linarith [hy.1], by linarith [hy.2]⟩
  have hmI : m ∈ Icc (9 / 32 : ℝ) (13 / 32) := ⟨by linarith [hy.1, hy.2], by linarith [hy.1, hy.2]⟩
  have hQ1 : Q β t ≤ Q βu t := Q_mono_β ⟨by linarith [htI.1], by linarith [htI.2]⟩ hβ.2
  have hQ2 : Q βu t ≤ Q βu m + Q1f βu m * (t - m) :=
    Q_le_tangent ⟨by linarith [hβ.1, hβ.2], hβu⟩ htI hmI
  have hQ3 : Q1f βu m * (t - m) ≤ |Q1f βu m| * ((yu - yl) / 4) := by
    have : |t - m| ≤ (yu - yl) / 4 := by
      rw [abs_le]; constructor <;> linarith [hy.1, hy.2]
    calc Q1f βu m * (t - m) ≤ abs (Q1f βu m * (t - m)) := le_abs_self _
      _ = |Q1f βu m| * |t - m| := abs_mul _ _
      _ ≤ |Q1f βu m| * ((yu - yl) / 4) := mul_le_mul_of_nonneg_left this (abs_nonneg _)
  unfold g_LJQ_2_lo
  rw [← hm]
  linarith [hy.1]

/-- The expression `Q_β(m)` of the checker for rational $m$, with the variable `i` standing for
$2^\beta$: $\frac23m(1-m)(12m-3)+\frac23m(1-m)(4-8m)\,2^\beta$. -/
def qEx (m : ℚ) (i : ℕ) : Ex :=
  .add (.const (2 / 3 * m * (1 - m) * (-3 + 12 * m)))
    (.mul (.const (2 / 3 * m * (1 - m) * (4 - 8 * m))) (.var i))

/-- The expression `Q_β'(m)` of the checker for rational $m$, with the variable `i` standing for
$2^\beta$: $(-2+20m-24m^2)+(\frac83-16m+16m^2)\,2^\beta$. -/
def q1Ex (m : ℚ) (i : ℕ) : Ex :=
  .add (.const (-2 + 20 * m - 24 * m ^ 2)) (.mul (.const (8 / 3 - 16 * m + 16 * m ^ 2)) (.var i))

/-- The expression of the checker for $\underline{g_{LJQ,2}}$ on the rectangle
$[y_l,y_u]\times[\beta_l,\beta_u]$, with the variables `0`–`3` standing for $J(y_l)$, $J(y_u)$,
$2^{\beta_l}$, $2^{\beta_u}$. -/
def g2Ex (yl yu : ℚ) : Ex :=
  .sub (.add (.add (.const (yl - 1 / 16))
        (.mul (.sub (.var 2) (.const 1)) (.min (.var 0) (.var 1))))
      (.mul (.const (1 / 16)) (.npow (.var 2) 2)))
    (.mul (.const 2) (.add (qEx (1 / 32 + (yl + yu) / 4) 3)
      (.mul (.abs (q1Ex (1 / 32 + (yl + yu) / 4) 3)) (.const ((yu - yl) / 4)))))

/-- The real meaning of `g2Ex`. -/
theorem denote_g2Ex (yl yu : ℚ) (a b c d : Cert) :
    denote (Cert.val [a, b, c, d]) (g2Ex yl yu) =
      ((yl - 1 / 16 : ℚ) : ℝ) + (c.v - 1) * min a.v b.v + ((1 / 16 : ℚ) : ℝ) * c.v ^ 2 -
        2 * ((((2 / 3 * (1 / 32 + (yl + yu) / 4) * (1 - (1 / 32 + (yl + yu) / 4)) *
          (-3 + 12 * (1 / 32 + (yl + yu) / 4))) : ℚ) : ℝ) +
          (((2 / 3 * (1 / 32 + (yl + yu) / 4) * (1 - (1 / 32 + (yl + yu) / 4)) *
          (4 - 8 * (1 / 32 + (yl + yu) / 4))) : ℚ) : ℝ) * d.v +
          |(((-2 + 20 * (1 / 32 + (yl + yu) / 4) - 24 * (1 / 32 + (yl + yu) / 4) ^ 2) : ℚ) : ℝ) +
            (((8 / 3 - 16 * (1 / 32 + (yl + yu) / 4) + 16 * (1 / 32 + (yl + yu) / 4) ^ 2) : ℚ) :
              ℝ) * d.v| * (((yu - yl) / 4 : ℚ) : ℝ)) := by
  simp [g2Ex, qEx, q1Ex, denote, Cert.val, envOf]

/-- $\underline{g_{LJQ,2}}-10^{-5}$ as a function of the corners of a rectangle in
$\mathbb R^2$ (the function $\underline f$ of [DIR], §4.1 for (6.17)). -/
noncomputable def g2_fl (zl zu : Fin 2 → ℝ) : ℝ :=
  g_LJQ_2_lo (zl 0) (zu 0) (zl 1) (zu 1) - 1 / 10 ^ 5

/-- The Boolean box check for (6.17): the table entries are at the right points
($J(\underline y)$, $J(\overline y)$, $2^{\underline\beta}$, $2^{\overline\beta}$) and the checker
certifies $\underline{g_{LJQ,2}}>10^{-5}$. -/
def g2Check (p : Box) (ja jb : JVal) (sl su : PowVal) : Bool :=
  ja.x == p.1 && jb.x == p.2.1 && sl.a == 2 && sl.r == p.2.2.1 && su.a == 2 &&
    su.r == p.2.2.2 &&
    check P11 [(ja.l, ja.u), (jb.l, jb.u), (sl.l, sl.u), (su.l, su.u)] (g2Ex p.1 p.2.1) (1 / 10 ^ 5)

/-- **Box certificate for (6.17).** If `g2Check` succeeds on the rectangle `p`, then
$\underline{g_{LJQ,2}}>10^{-5}$ on `p`. -/
theorem g2_box (p : Box) (ja jb : JVal) (sl su : PowVal) (h : g2Check p ja jb sl su = true) :
    0 < g2_fl (Box.toR p).1 (Box.toR p).2 := by
  obtain ⟨yl, yu, βl, βu⟩ := p
  simp only [g2Check, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, hk⟩ := h
  have := check_sound P11 hw11 [ja.cert, jb.cert, sl.cert, su.cert] _ _ hk
  rw [denote_g2Ex] at this
  simp only [JVal.cert, PowVal.cert, h1, h2, h3, h4, h5, h6] at this
  simp only [g2_fl, g_LJQ_2_lo, Box.toR, Matrix.cons_val_zero, Matrix.cons_val_one, Q_eq_affine,
    Q1f_eq_affine]
  push_cast at this ⊢
  linarith

end Auto.DIR
