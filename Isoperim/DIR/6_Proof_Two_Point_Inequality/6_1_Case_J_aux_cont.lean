/-- A function continuous on $[a,b]$ and nonnegative on $(a,b]$ is nonnegative at $a$. -/
theorem nonneg_left_of_continuousOn {F : ℝ → ℝ} {a b : ℝ} (hab : a < b)
    (hF : ContinuousOn F (Icc a b)) (h : ∀ x ∈ Ioc a b, 0 ≤ F x) : 0 ≤ F a := by
  have hc : ContinuousWithinAt F (Ioc a b) a :=
    (hF a ⟨le_rfl, hab.le⟩).mono Ioc_subset_Icc_self
  have : (𝓝[Ioc a b] a).NeBot := mem_closure_iff_nhdsWithin_neBot.1
    (by rw [closure_Ioc hab.ne]; exact ⟨le_rfl, hab.le⟩)
  exact ge_of_tendsto hc (eventually_nhdsWithin_of_forall h)

/-- For $\beta>0$, $c\ge0$ and $h\in[0,\frac3{16}]$, $x\mapsto G^1_\beta[c\cdot J](x,x+h)$ is
continuous on $[\frac12,\frac58]$. -/
theorem continuousOn_G₁_cJ (β c h : ℝ) (hβ : 0 < β) (hc : 0 ≤ c)
    (hh : h ∈ Icc (0 : ℝ) (3 / 16)) :
    ContinuousOn (fun x ↦ G₁ β (c • J) x (x + h)) (Icc 2⁻¹ (5 / 8)) := by
  have hJ1 : ContinuousOn (fun x ↦ J (x + h)) (Icc 2⁻¹ (5 / 8)) :=
    continuousOn_J.comp (by fun_prop) fun x hx ↦
      ⟨by linarith [hx.1, hh.1], by linarith [hx.2, hh.2]⟩
  have hJ0 : ContinuousOn J (Icc 2⁻¹ (5 / 8)) :=
    continuousOn_J.mono (Icc_subset_Icc le_rfl (by norm_num))
  have hJm : ContinuousOn (fun x ↦ J ((x + (x + h)) / 2)) (Icc 2⁻¹ (5 / 8)) :=
    continuousOn_J.comp (by fun_prop) fun x hx ↦
      ⟨by linarith [hx.1, hh.1], by linarith [hx.2, hh.2]⟩
  have hnn : ∀ x ∈ Icc (2⁻¹ : ℝ) (5 / 8), 0 ≤ c * J (x + h) := fun x hx ↦
    mul_nonneg hc (J_nonneg ⟨by linarith [hx.1, hh.1], by linarith [hx.2, hh.2]⟩)
  simp only [G₁, Pi.smul_apply, smul_eq_mul]
  refine ContinuousOn.sub (ContinuousOn.add (ContinuousOn.rpow_const ?_ ?_) ?_) ?_
  · refine ContinuousOn.add (by fun_prop) ?_
    exact (hJ1.const_smul c).rpow_const fun _ _ ↦ Or.inr (inv_pos.2 hβ).le
  · exact fun _ _ ↦ Or.inr hβ.le
  · exact hJ0.const_smul c
  · exact (hJm.const_smul c).const_smul (2 : ℝ)

