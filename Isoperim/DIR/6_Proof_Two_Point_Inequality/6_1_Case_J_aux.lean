/-!
# [DIR] §6.1 Case J: auxiliary lemmas

This file was automatically generated by Claude.

Auxiliary lemmas for `6_1_Case_J.lean`: positivity, smoothness and the derivatives
$J',\dots,J^{(6)}$ of $J$ on $(\frac12,1)$ (from $JJ''=-2$), and the monotonicity of $J$ on
$[\frac12,x_0]$ and $[x_0,1]$.
-/

@[expose] public section

namespace Auto.DIR

open Real Set Filter Topology

/-- $J$ satisfies the defining properties `IsJ`. -/
theorem isJ_J : IsJ J := by
  have hJ := existsUnique_J.1
  rw [J, dite_eq_left_of_eq_true (eq_true hJ)]
  exact hJ.choose_spec

/-- $1-w_0<\frac12$. -/
theorem one_sub_w₀_lt_half : 1 - w₀ < 2⁻¹ := by
  have := w₀_mem.1; linarith

/-- $w_0>0$. -/
theorem w₀_pos : 0 < w₀ := by
  have := w₀_mem.1; linarith

/-- $x_0=1-\frac{w_0}2$ lies in $(\frac12,1)$. -/
theorem x₀_mem_Ioo : x₀ ∈ Ioo (2⁻¹ : ℝ) 1 := by
  have := w₀_mem; rw [x₀]; constructor <;> linarith [this.1, this.2]

/-- $J=J_{w_0}$ (`gJw w₀`) on $[\frac12,1]$. -/
theorem J_eq_gJw_w₀ {x : ℝ} (hx : x ∈ Icc (2⁻¹ : ℝ) 1) : J x = gJw w₀ x := eqn_3_4 x hx

/-- $J=J_{w_0}$ near each point of $(\frac12,1)$. -/
theorem J_eventuallyEq_gJw {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) : J =ᶠ[𝓝 x] gJw w₀ := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using J_eq_gJw_w₀ ⟨hy.1.le, hy.2.le⟩

/-- A point of $(\frac12,1)$ lies in $(1-w_0,1)$. -/
theorem mem_Ioo_one_sub_w₀ {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) : x ∈ Ioo (1 - w₀) 1 :=
  ⟨one_sub_w₀_lt_half.trans hx.1, hx.2⟩

/-- $J>0$ on $[\frac12,1)$. -/
theorem J_pos {x : ℝ} (hx : x ∈ Ico (2⁻¹ : ℝ) 1) : 0 < J x := by
  rw [J_eq_gJw_w₀ ⟨hx.1, hx.2.le⟩]
  exact gJw_pos w₀_pos ⟨one_sub_w₀_lt_half.trans_le hx.1, hx.2⟩

/-- $J\ge0$ on $[\frac12,1]$. -/
theorem J_nonneg {x : ℝ} (hx : x ∈ Icc (2⁻¹ : ℝ) 1) : 0 ≤ J x := by
  rcases hx.2.lt_or_eq with h | h
  · exact (J_pos ⟨hx.1, h⟩).le
  · rw [h, isJ_J.2.2.2.2]

/-- $J(1)=0$. -/
theorem J_one : J 1 = 0 := isJ_J.2.2.2.2

/-- $J$ is continuous on $[\frac12,1]$. -/
theorem continuousOn_J : ContinuousOn J (Icc 2⁻¹ 1) := isJ_J.2.1

/-- $J$ has the derivative $J'(x)$ at every $x\in(\frac12,1)$. -/
theorem hasDerivAt_J_deriv {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) :
    HasDerivAt J (deriv J x) x := by
  have h := hasDerivAt_gJw w₀_pos (mem_Ioo_one_sub_w₀ hx)
  have h' := h.congr_of_eventuallyEq (J_eventuallyEq_gJw hx)
  rw [h'.deriv]; exact h'

/-- $J'=J_{w_0}'$ near each point of $(\frac12,1)$. -/
theorem deriv_J_eventuallyEq {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) :
    deriv J =ᶠ[𝓝 x] deriv (gJw w₀) := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using
    (J_eventuallyEq_gJw hy).deriv_eq

/-- $J''=-2J^{-1}$: $J'$ has the derivative $-2/J(x)$ at every $x\in(\frac12,1)$. -/
theorem hasDerivAt_deriv_J {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) :
    HasDerivAt (deriv J) (-2 * (J x)⁻¹) x := by
  have hx' := mem_Ioo_one_sub_w₀ hx
  have hJ : J x = gJw w₀ x := J_eq_gJw_w₀ ⟨hx.1.le, hx.2.le⟩
  have hp : gJw w₀ x ≠ 0 := (gJw_pos w₀_pos hx').ne'
  obtain ⟨V, hV, hVm⟩ : ∃ V, HasDerivAt (deriv (gJw w₀)) V x ∧ V * gJw w₀ x = -2 :=
    ⟨_, hasDerivAt_deriv_gJw w₀_pos hx', by
      rw [← (hasDerivAt_deriv_gJw w₀_pos hx').deriv]; exact gJw_deriv2_mul w₀_pos hx'⟩
  have hV' : V = -2 * (J x)⁻¹ := by
    rw [hJ, ← div_eq_mul_inv]; exact eq_div_of_mul_eq hp hVm
  rw [← hV']
  exact hV.congr_of_eventuallyEq (deriv_J_eventuallyEq hx)

/-- $J''(x)=-2/J(x)$ on $(\frac12,1)$. -/
theorem deriv2_J {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) : deriv (deriv J) x = -2 * (J x)⁻¹ :=
  (hasDerivAt_deriv_J hx).deriv

/-- The second derivative of $J$ near a point of $(\frac12,1)$. -/
theorem iteratedDeriv_two_J_eventuallyEq {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) :
    iteratedDeriv 2 J =ᶠ[𝓝 x] fun y ↦ -2 * (J y)⁻¹ := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy
  rw [iteratedDeriv_succ, iteratedDeriv_one, deriv2_J hy]

/-- The derivative of $J^{-k}$ ($k\ge1$) on $(\frac12,1)$. -/
theorem hasDerivAt_J_inv_pow (k : ℕ) {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) :
    HasDerivAt (fun y ↦ ((J y)⁻¹) ^ k) (-(k : ℝ) * deriv J x * ((J x)⁻¹) ^ (k + 1)) x := by
  have hJ := (J_pos ⟨hx.1.le, hx.2⟩).ne'
  have h := ((hasDerivAt_J_deriv hx).inv hJ).pow k
  have h' : HasDerivAt (fun y ↦ ((J y)⁻¹) ^ k) _ x := h
  convert h' using 1
  rcases k with _ | k
  · simp
  · simp only [Pi.inv_apply, Nat.add_sub_cancel, inv_pow]
    push_cast
    field_simp
    ring

/-- $J^{(3)}$ near a point of $(\frac12,1)$: $J^{(3)}=2J'J^{-2}$. -/
theorem iteratedDeriv_three_J_eventuallyEq {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) :
    iteratedDeriv 3 J =ᶠ[𝓝 x] fun y ↦ 2 * deriv J y * ((J y)⁻¹) ^ 2 := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy
  rw [iteratedDeriv_succ, (iteratedDeriv_two_J_eventuallyEq hy).deriv_eq]
  have h := ((hasDerivAt_J_inv_pow 1 hy).const_mul (-2))
  simp only [pow_one] at h
  rw [h.deriv]; push_cast; ring

/-- $J^{(4)}$ near a point of $(\frac12,1)$: $J^{(4)}=-4(1+J'^2)J^{-3}$. -/
theorem iteratedDeriv_four_J_eventuallyEq {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) :
    iteratedDeriv 4 J =ᶠ[𝓝 x] fun y ↦ -4 * (1 + deriv J y ^ 2) * ((J y)⁻¹) ^ 3 := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy
  rw [iteratedDeriv_succ, (iteratedDeriv_three_J_eventuallyEq hy).deriv_eq]
  have h := ((hasDerivAt_deriv_J hy).const_mul 2).mul (hasDerivAt_J_inv_pow 2 hy)
  have h' : HasDerivAt (fun y ↦ 2 * deriv J y * ((J y)⁻¹) ^ 2) _ y := h
  rw [h'.deriv]; push_cast; ring

/-- $J^{(5)}$ near a point of $(\frac12,1)$: $J^{(5)}=4J'(7+3J'^2)J^{-4}$. -/
theorem iteratedDeriv_five_J_eventuallyEq {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) :
    iteratedDeriv 5 J =ᶠ[𝓝 x] fun y ↦ 4 * deriv J y * (7 + 3 * deriv J y ^ 2) * ((J y)⁻¹) ^ 4 := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy
  rw [iteratedDeriv_succ, (iteratedDeriv_four_J_eventuallyEq hy).deriv_eq]
  have h := ((((hasDerivAt_deriv_J hy).pow 2).const_add 1).const_mul (-4)).mul
    (hasDerivAt_J_inv_pow 3 hy)
  have h' : HasDerivAt (fun y ↦ -4 * (1 + deriv J y ^ 2) * ((J y)⁻¹) ^ 3) _ y := h
  rw [h'.deriv]
  have hJ := (J_pos ⟨hy.1.le, hy.2⟩).ne'
  simp only [Pi.pow_apply, inv_pow]
  push_cast
  field_simp
  ring

/-- $J^{(6)}$ near a point of $(\frac12,1)$: $J^{(6)}=-8(7+23J'^2+6J'^4)J^{-5}$. -/
theorem iteratedDeriv_six_J_eventuallyEq {x : ℝ} (hx : x ∈ Ioo (2⁻¹ : ℝ) 1) :
    iteratedDeriv 6 J =ᶠ[𝓝 x]
      fun y ↦ -8 * (7 + 23 * deriv J y ^ 2 + 6 * deriv J y ^ 4) * ((J y)⁻¹) ^ 5 := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy
  rw [iteratedDeriv_succ, (iteratedDeriv_five_J_eventuallyEq hy).deriv_eq]
  have hd := hasDerivAt_deriv_J hy
  have h := (((hd.const_mul 4).mul (((hd.pow 2).const_mul 3).const_add 7)).mul
    (hasDerivAt_J_inv_pow 4 hy))
  have h' : HasDerivAt (fun y ↦ 4 * deriv J y * (7 + 3 * deriv J y ^ 2) * ((J y)⁻¹) ^ 4) _ y :=
    h
  rw [h'.deriv]
  have hJ := (J_pos ⟨hy.1.le, hy.2⟩).ne'
  simp only [Pi.pow_apply, Pi.mul_apply, inv_pow]
  push_cast
  field_simp
  ring

/-- $J$ is increasing on $[\frac12,x_0]$. -/
theorem J_monotoneOn_Icc_half_x₀ : MonotoneOn J (Icc 2⁻¹ x₀) := by
  have hx₀ := x₀_mem_Ioo
  refine monotoneOn_of_deriv_nonneg (convex_Icc _ _)
    (continuousOn_J.mono (Icc_subset_Icc le_rfl hx₀.2.le)) ?_ ?_
  · intro y hy
    rw [interior_Icc] at hy
    exact (hasDerivAt_J_deriv ⟨hy.1, hy.2.trans hx₀.2⟩).differentiableAt.differentiableWithinAt
  · intro y hy
    rw [interior_Icc] at hy
    have hy' : y ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨hy.1, hy.2.trans hx₀.2⟩
    rw [(deriv_J_eventuallyEq hy').eq_of_nhds]
    exact ((deriv_gJw_sign w₀_pos).2.1 y
      ⟨(mem_Ioo_one_sub_w₀ hy').1, by rw [← x₀]; exact hy.2⟩).le

/-- $J$ is decreasing on $[x_0,1]$. -/
theorem J_antitoneOn_Icc_x₀_one : AntitoneOn J (Icc x₀ 1) := by
  have hx₀ := x₀_mem_Ioo
  refine antitoneOn_of_deriv_nonpos (convex_Icc _ _)
    (continuousOn_J.mono (Icc_subset_Icc hx₀.1.le le_rfl)) ?_ ?_
  · intro y hy
    rw [interior_Icc] at hy
    exact (hasDerivAt_J_deriv ⟨hx₀.1.trans hy.1, hy.2⟩).differentiableAt.differentiableWithinAt
  · intro y hy
    rw [interior_Icc] at hy
    have hy' : y ∈ Ioo (2⁻¹ : ℝ) 1 := ⟨hx₀.1.trans hy.1, hy.2⟩
    rw [(deriv_J_eventuallyEq hy').eq_of_nhds]
    exact ((deriv_gJw_sign w₀_pos).2.2 y ⟨by rw [← x₀]; exact hy.1, hy.2⟩).le

end Auto.DIR
